          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivy’ amazahabu, amugereraniriza ukw amazahabu yo kubicurishamwo akwiye kungana, n’uko bikwiye kuzokoreshwa kwose; ivy’ amafeza na vyo, amugereraniriza ukw amafeza yo kubicurishamwo akwiye kungana, n’uko bikwiye kuzokoreshwa kwose; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.14",
            "verseOrgIds": [
              "1CH.28.14"
            ]
          }
        },
        {
