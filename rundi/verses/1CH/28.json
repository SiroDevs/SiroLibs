              "attrs": {
                "loc": "1CH.3.1+1CH.3.2+1CH.3.3+1CH.3.4+1CH.3.5+1CH.3.6+1CH.3.7+1CH.3.8+1CH.3.9"
              },
              "items": [
                {
                  "text": "1 Ngo 3:1-9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.9"
