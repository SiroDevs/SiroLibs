              "items": [
                {
                  "text": "22:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None mu bahungu banje bose (kandi muzi yuk’ Uhoraho yampaye benshi), yatoranijemw’ umuhungu wanje Salomo kuba ari we azovyagira ku ntebe y’ubgami bg’ Uhoraho, akaganza Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.5",
            "verseOrgIds": [
              "1CH.28.5"
            ]
          }
        },
