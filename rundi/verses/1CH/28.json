            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "no ku vy’imbu z’abaherezi n’iz’ Abalewi, n’ibikorwa vyose uko bizokorerwa mu ngoro y’Uhoraho, no ku vy’ibintu vyose vy’imbombovu bizokoreshwa muri yo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.13",
            "verseOrgIds": [
              "1CH.28.13"
            ]
          }
        },
