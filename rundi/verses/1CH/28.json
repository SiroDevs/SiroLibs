        {
          "text": "Maze Dawidi aha umuhungu wiwe Salomo icitegererezo c’urubaraza rw’urusengero, n’ic’ inyubako yarwo, n’ic’ ububīko bgarwo, n’ic’ ivyumba vyarwo vyo hejuru, n’ivyo muri rwo imbere, n’ic’ ikibanza ca wa mutemere wo guhongerako; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.11",
            "verseOrgIds": [
              "1CH.28.11"
            ]
          }
        },
        {
          "name": "verse",
