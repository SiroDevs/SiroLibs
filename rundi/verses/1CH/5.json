            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Bela mwene Azazi, Azazi wa Shema, Shema wa Yoweli; abo aho bāba, bāhēra i Aroweri ukarinda ushitsa i Nebo n’i Bayali‐meyoni; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.8",
            "verseOrgIds": [
              "1CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.22.9"
              },
              "items": [
                {
                  "text": "Yos 22:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bāhēra n’ahahera i burasirazuba, ukarinda ushitsa ku bugaragwa bugarukira ku ruzi Efurate, kukw amasho yabo yagenda agwirirana mu gihugu c’i Gileyadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
            "verseOrgIds": [
              "1CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ku ngoma ya Sauli batera Abahaguri, barabageseza; baraheza binjira ingo zabo mur’ ico gihugu cose ahahera i burasirazuba bg’i Gileyadi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        }
      ]
