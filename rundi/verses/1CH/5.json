                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bose bāraharūwe, uk’ urunganwe rwabo rwagiye rukurikirana; bāharūwe ku ngoma ya Yotamu umwami w’i Buyuda no ku ngoma ya Yerobowamu umwami w’Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.17",
            "verseOrgIds": [
              "1CH.5.17"
            ]
          }
        }
      ]
    },
