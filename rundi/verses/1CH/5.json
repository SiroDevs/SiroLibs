                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’ uruvyaro rwa Gadi bāri babangikanye na bo, aho bāba, bāhēra mu gihugu c’i Bashani, ukarinda ushitsa i Saleka; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.11",
            "verseOrgIds": [
              "1CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoweli ni we yari mukuru muri bo, uwa kabiri ni Shafamu na Yanayi na Shafati aho nyene i Bashani; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.12",
            "verseOrgIds": [
              "1CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’abandi b’i wabo bo mu mazu ya ba sekuruza, ni bo aba: Mikayeli na Meshulamu na Sheba na Yorayi na Yakani na Ziya na Eberi, ukw ar’ indwi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.13",
            "verseOrgIds": [
              "1CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "abo bāri bene Abihayili, Abihayili wa Huri, Huri wa Yarowa, Yarowa wa Gileyadi, Gileyadi wa Mikayeli, Mikayeli wa Yeshishayi, Yeshishayi wa Yahudo, Yahudo wa Buzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.14",
            "verseOrgIds": [
              "1CH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Ahi mwene Abudiyeli, Abudiyeli wa Guni, ni we yari mukuru mu nzu ya ba sekuruza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.15",
            "verseOrgIds": [
              "1CH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bāba i Gileyadi, n’i Bashani, no mu bisagara vyaho, n’ahār’ amaragiro hose i Sharoni gushitsa ah’ agarukira. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.16",
            "verseOrgIds": [
              "1CH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 5:17"
          },
          "items": [
