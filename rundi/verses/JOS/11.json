                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko Yosuwa yanesheje ico gihugu cose: umugamba waho, n’i Negebu hose, n’igihugu cose c’i Gosheni, n’ic’ imisozi iciye bugufi, n’ikiyaya Araba, n’umugamba witwa uwa Isirayeli, n’igihugu c’imisozi iciye bugufi kiwegamiye, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.16",
            "verseOrgIds": [
              "JOS.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
