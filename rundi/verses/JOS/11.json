              "items": [
                {
                  "text": "Abac 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ico gihe Yosuwa arakebanuka, atsinda i Hasori, yicisha umwami waho inkota; kand’ i Hasori ubga mbere ni co cār’ igisagara gikuru mu bihugu vy’abo bami bose. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.10",
            "verseOrgIds": [
              "JOS.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.10.40"
              },
              "items": [
                {
                  "text": "Yos 10:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batōngōza inkota abari muri co bose, barabageseza; ntihasigara n’umwe agihumeka, kandi n’i Hasori bahatōngōza umuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.11",
            "verseOrgIds": [
              "JOS.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa atsinda ibisagara vyose vy’abo bami, abo bami bose abicisha inkota, arabageseza, nk’uko Mose umusavyi w’Uhoraho yageze. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.12",
            "verseOrgIds": [
              "JOS.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ibisagara vyubatswe ku dusozi tunungaraye, Abisirayeli nta na kimwe bāturiye, atar’ i Hasori honyene: aho ho Yosuwa yarahaturiye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.13",
            "verseOrgIds": [
              "JOS.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iminyago yose y’ivyo bisagara, n’inka zose, Abisirayeli bavyijanira kw iminyago; arikw icitwa umuntu wese bamwicisha inkota, gushitsa babaranduye rwose: ntibasigaza n’umwe agihumeka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.14",
            "verseOrgIds": [
              "JOS.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
