            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.2"
              },
              "items": [
                {
                  "text": "Gus 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.7"
              },
              "items": [
                {
                  "text": "Yos 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’ uk’ Uhoraho yageze Mose umusavyi wiwe, ni ko Mose yageze Yosuwa, Yosuwa na we abigenza kuno: nta kintu na kimwe atākoze, mu vy’Uhoraho yageze Mose vyose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.15",
            "verseOrgIds": [
              "JOS.11.15"
            ]
          }
        }
      ]
    },
