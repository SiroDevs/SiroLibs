          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubupfindo bga gatandatu bushika ku Banafutali, nk’ukw amazu y’Abanafutali ari. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.32",
            "verseOrgIds": [
              "JOS.19.32"
            ]
          }
        },
        {
