                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’i Eburoni n’i Rehoba n’i Hamoni n’i Kana, gushika no kuri ca gisagara kinini Sidoni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.28",
            "verseOrgIds": [
              "JOS.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "maz’ urwo rubibe rugakevya rugaca i Rama, rugashika no ku gisagara c’i Tiro kizitijwe uruzitiro rw’amabuye; rugaheza rugakebereza i Hosa, rukagarukira ku kiyaga. Batwara na Mahalabu na Akizibu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.29",
            "verseOrgIds": [
              "JOS.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Uma na Afeka na Rehobu: ibisagara vyose na vyose vyari mirongwibiri na bibiri, bifise imihana ibikūkira. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.30",
            "verseOrgIds": [
              "JOS.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ni yo shamvu y’umuryango w’Abasheri, nk’ukw amazu yabo ari, ivyo bisagara bo n’imihana ibikūkira.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.31",
            "verseOrgIds": [
              "JOS.19.31"
            ]
          }
        }
      ]
    },
