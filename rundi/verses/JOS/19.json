          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urubibe rwabo rwāhēra i Helefu, rugaca ku giti c’umweloni kir’ i Sananimu, n’i Adami‐nekebu n’i Yabuneli, rugashika i Lakumu, rukagarukira kuri Yorodani; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.33",
            "verseOrgIds": [
              "JOS.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "urwo rubibe rugakebereza i burengerazuba rugashika i Azinoti‐tabora, rukavudukaho rugaca i Hukoki, rukagarukira ku gihugu c’Abazebuloni i bumanuko, no ku c’Abasheri i burengerazuba no ku c’Abayuda kuri Yorodani i burasirazuba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.34",
            "verseOrgIds": [
              "JOS.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibisagara bātwaye vyubakiwe inzitiro z’amabuye vyar’ ibi: Sidimu na Sera na Hamati na Rakati na Kinereti, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.35",
            "verseOrgIds": [
              "JOS.19.35"
            ]
          }
        },
