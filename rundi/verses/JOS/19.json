              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Ironi na Migudali‐eli na Horemu na Beti‐anati na Beti‐shemeshi; ivyo bisagara vyose na vyose vyar’ icumi n’icenda, bifise imihana ibikūkira. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.38",
            "verseOrgIds": [
