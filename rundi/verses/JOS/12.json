            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "igihugu c’ umugamba n’igiciye bugufi, n’ikiyaya citwa Araba, n’igihugu cegamiye umugamba, n’ubugaragwa, n’i Negebu; ni vyo bihugu vy’ Abaheti n’Abamori n’Abanyakanani n’Abaferizi n’Abahiwi n’Abayebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.8",
            "verseOrgIds": [
