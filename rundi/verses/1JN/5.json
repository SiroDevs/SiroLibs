                "loc": "1PE.1.22"
              },
              "items": [
                {
                  "text": "1 Pet 1:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
