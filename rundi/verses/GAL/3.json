              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni kw ivyagezwe vyatubereye umurezi aturera akadushikiriza Kristo, ngo dutsindanishirizwe n’ukwizera.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.24",
