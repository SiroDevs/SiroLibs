              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ ukwizera kutaraza, twarindwa n’ivyagezwe, twugaranywe turindiriye ukwizera kwagira kuze guhishurwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.23",
