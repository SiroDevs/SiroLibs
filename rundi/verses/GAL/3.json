          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umushikirwa ntaba uw’ umwe, yamar’ Imana n’imwe.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.20",
            "verseOrgIds": [
