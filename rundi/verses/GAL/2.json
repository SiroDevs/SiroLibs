            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Kefa aje muri Antiyokiya, mmugisha impāri imbonankubone, kuko yari n’ibimutsindishije. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.11",
            "verseOrgIds": [
              "GAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.3"
              },
              "items": [
                {
                  "text": "Ivyak 11:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw abāvuye kwa Yakobo batarashikayo yasangira n’abanyamahanga; ariko bashitseyo, ariyonjorora, arabanēna, kukw atinye abo mu bākebge. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.12",
            "verseOrgIds": [
              "GAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’abandi Bayuda bahumbana na we, bitayeko na Barunaba atwarwa n’ubgo buhumvyi bgabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.13",
            "verseOrgIds": [
              "GAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mbonye badaca mu nzira igororotse, nk’uk’ ukuri kw’ubutumwa bgiza kuri, mbaririra Kefa imbere ya bose, nti Ko wewe witondera ingeso z’abanyamahanga, zitar’ iz’ Abayuda, kand’ ur’ Umuyuda, ugōbēra ute abanyamahanga kuba nk’Abayuda?",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
