              "items": [
                {
                  "text": "Zab 143:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko tuzi yuk’ umuntu adatsindanishirizwa n’ibikorwa bishinzwe n’ivyagezwe, arikw atsindanishirizwa no kwizera Yesu Kristo. Natwe twizeye Kristo Yesu, ngo kwizera Kristo kube ari kwo kudutsindanishiriza, atar’ ibikorwa bishinzwe n’ivyagezwe; kukw ata muntu atsindanishirizwa n’ibikorwa bishinzwe n’ivyagezwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.16",
            "verseOrgIds": [
              "GAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko namba twabonetse ko tur’ abanyavyaha, hamwe twarondera gutsindanishirizwa no kuba muri Kristo, mbega Kristo n’umukozi agabura icaha? Eka na mba! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.17",
            "verseOrgIds": [
              "GAL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokwongera kwubaka ivyo nasambuye noba niseruye ko nd’umuntu acumura. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.18",
            "verseOrgIds": [
              "GAL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
