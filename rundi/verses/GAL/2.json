              },
              "items": [
                {
                  "text": "Ivyak 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze hahise imyaka cumi n’ine, nongera kudūgana na Barunaba, kandi na Tito ndamujana. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.1",
            "verseOrgIds": [
              "GAL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.6"
              },
              "items": [
                {
                  "text": "Gal 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nadūzeyo kubgo guhishurirwa, mbashira imbere ubutumwa bgiza mvuga mu banyamahanga, ariko mbushira imbere y’abashimwa twiherereye, ngo sinirukire ubusa, canke simbe narirukiye ubusa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.2",
            "verseOrgIds": [
              "GAL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.3"
              },
              "items": [
                {
                  "text": "Ivyak 16:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko na Tito twari kumwe ntiyagōberewe ngw akebge, naho yar’ Umugiriki, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.3",
            "verseOrgIds": [
              "GAL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.1"
              },
              "items": [
                {
                  "text": "Ivyak 15:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ ari co coshimishije abīgira bene Data bānyegetejwe mw ishengero, binjiye mu mpisho ngo batate ukwidegemvya kwacu dufise muri Kristo Yesu, kugira ngo badushire mu buja. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.4",
            "verseOrgIds": [
              "GAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.1"
              },
              "items": [
                {
                  "text": "Gal 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ntitwabumviye na gatoya ngo tuganzwe na bo; kugira ng’ ukuri kw’ubutumwa bgiza kugume muri mwebge. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.5",
            "verseOrgIds": [
              "GAL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abashimwa kw ari bakuru — uko bari bameze ubga mbere simbibabaye, kubganje vyose ni bimwe, Imana ntirobanura abantu ku cubahiro — abo bashimwa nta co bānyongerereje. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.6",
            "verseOrgIds": [
              "GAL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.15"
              },
              "items": [
                {
                  "text": "Ivyak 9:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.12"
              },
              "items": [
                {
                  "text": "15:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.21"
              },
              "items": [
                {
                  "text": "22:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko babonye yuko najejwe ubutumwa bgo kwigisha abatākebge, nk’uko Petero yajejwe ubgo kwigisha abākebge. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.7",
            "verseOrgIds": [
              "GAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw Iyashoboje Petero gutumwa ku bākebge, ari yo yanshoboje nanje gutumwa ku banyamahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.8",
            "verseOrgIds": [
              "GAL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.42"
              },
              "items": [
                {
                  "text": "Yoh 1:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bamaze kumenya ubuntu nahāwe, Yakobo na Kefa na Yohana, abashimwa kw ar’inkingi, badukora mu minwe, twe na Barunaba, ngo dufatanye na bo, ngo twebge tuje ku banyamahanga, na bo baje ku bākebge. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.9",
            "verseOrgIds": [
              "GAL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.30"
              },
              "items": [
                {
                  "text": "Ivyak 11:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.25"
              },
              "items": [
                {
                  "text": "12:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ico bāgomvye gusa n’uko twibuka aboro, ari co nyene nanje nari nsanzwe mfitiye umwete.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
