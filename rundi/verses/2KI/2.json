                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava mu gisagara, aja kw iriba, aritereramw’ umunyu, aravuga, at’ Uku ni k’Uhoraho agize, ngw Akijije aya mazi, nta ho azosubira kuzana urupfu canke kurūmvya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw amazi arakira gushitsa na bugingo n’ubu, nk’ukw ijambo Elisa yavuze riri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
            "verseOrgIds": [
              "2KI.2.22"
            ]
          }
        }
