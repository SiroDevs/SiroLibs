          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu bo mur’ ico gisagara babarira Elisa, bati Rāba iki gisagara ingene cubatswe ahantu heza, nk’uko nawe ubibona mugenzi; arikw amazi yaho ni mabi, kand’ atera uburambu mu gihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.19",
            "verseOrgIds": [
              "2KI.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aravuga, ati Ni munzanire akavya gasha, mugashiremw’ umunyu. Nuko barakamuzanira. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.20",
            "verseOrgIds": [
              "2KI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
