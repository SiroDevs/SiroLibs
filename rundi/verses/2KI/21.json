        {
          "text": "Yubaka n’ibicaniro mu ngoro y’Uhoraho, ari ho Uhoraho yari yaravuze, at’ I Yerusalemu ni ho nzoshira izina ryanje. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.4",
            "verseOrgIds": [
              "2KI.21.4"
            ]
          }
        },
        {
