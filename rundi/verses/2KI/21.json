                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzoshiburira hirya amasigarira yo mw ishamvu yanje, mbagabure mu maboko y’abansi babo, bahinduke inyagano n’isahu ku bansi babo bose; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.14",
            "verseOrgIds": [
              "2KI.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
