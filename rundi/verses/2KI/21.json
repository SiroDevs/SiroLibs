          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko bākoze ibibi imbere yanje, bakantera umwikomo bakandatsa, uhereye ku musi ba sekuruza bāviriye muri Egiputa gushitsa na bugingo n’ubu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.15",
            "verseOrgIds": [
              "2KI.21.15"
            ]
          }
        }
