              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyose vyadonzwe kuri Amoni, mbega ntivyanditswe mu gitabo c’ivyo ku ngoma z’abami b’i Buyuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.25",
            "verseOrgIds": [
              "2KI.21.25"
            ]
          }
