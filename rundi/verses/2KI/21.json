            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ivyo Uhoraho abona kw ari bibi, aja mu bizira vy’ubuyobe vy’abanyamahanga, abo Uhoraho yari yarirukanye imbere y’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "name": "verse",
