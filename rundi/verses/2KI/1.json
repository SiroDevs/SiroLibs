            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramubarira, at’ Uku ni k’ Uhoraho abajije, ngo Mbeg’ icatumye utuma abantu kuri Bayali‐zebubi ya mana y’i Ekuroni kuraguza, ngo N’ukw ata Mana yariho mu Bgisirayeli wosiguje? Ngo Nuko rero, ngo Ntuzovyuka ku kirwa uryamyeko, ng’ Uzopfa nta kabuza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        }
      ]
