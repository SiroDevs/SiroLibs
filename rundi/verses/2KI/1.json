                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami araheza atuma umugabisha agaba ingabo mirongwitanu, ari kumwe n’izo ngabo ziwe, ngo bamufate. Nukw adūga iyo Eliya ari, asanga yicaye ku mpinga y’umusozi. Aramubarira, ati Yewe muntu w’Imana, umwami aradutumye, ngo Manuka umwitabe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 1:10"
          },
          "items": [
            {
              "text": "10",
