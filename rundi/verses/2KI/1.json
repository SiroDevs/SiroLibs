            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu amaze gutanga, Abanyamowabu bagarariza Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.1",
            "verseOrgIds": [
              "2KI.1.1"
            ]
          }
