          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.12",
            "verseOrgIds": [
              "2KI.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Ataliya yumvise urwamo rw’abashibamyi n’abantu, aza ah’ abantu bari mu ngoro y’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.13",
            "verseOrgIds": [
              "2KI.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.34"
              },
              "items": [
                {
                  "text": "1 Abam 1:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.3"
              },
              "items": [
                {
                  "text": "2 Abam 23:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yitegereje abona umwami ahagararanye n’inkingi, nk’uk’ umugenzo wabo war’ uri, n’abagabisha n’abavuza inzumbete bamuhagaze i ruhande, n’abantu bose bo mu gihugu banezerewe bavuza inzumbete. Ataliya araheza yitantamurirakw impuzu ziwe, avuza induru, ati N’umugararizo! N’umugararizo! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.14",
            "verseOrgIds": [
              "2KI.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umuherezi Yehoyada abarira abagabisha bagaba amajana, bashiriweho kugaba ingabo zose, ati Ni mumusohore, mumucishe hagati y’imirongo y’ingabo, kandi ni hagira ūmukurikira mumwicishe inkota; kuk’ uwo muherezi yar’ avuze, ngo Ntatsindwe mu ngoro y’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.15",
            "verseOrgIds": [
              "2KI.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko baramukinjurira, ajana inzira amafarasi yatahana aja mu rugo rw’umwami; bamwiciraho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.16",
            "verseOrgIds": [
              "2KI.11.16"
            ]
          }
        }
      ]
    },
