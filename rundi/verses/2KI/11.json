        },
        {
          "text": "Maze Ataliya nyina wa Ahaziya abonye k’umwana wiwe Ahaziya apfuye, arahaguruka ageseza abo mu nda y’ingoma bose. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.1",
            "verseOrgIds": [
              "2KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.11.21"
              },
              "items": [
                {
                  "text": "2 Abam 11:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.1"
              },
              "items": [
                {
                  "text": "12:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yehosheba umukobga w’umwami Yoramu, mushiki wa Ahaziya, afata Yowasi mwene Ahaziya, amukūra mu bana b’ umwami bariko baricwa, amujanana n’umurezi wiwe, amushira mu cumba kibīkwamw’ amariri; nuko bamunyegeza Ataliya, ntiyicwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.2",
            "verseOrgIds": [
              "2KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ amarana na we imyaka itandatu, anyegejwe mu ngoro y’Uhoraho; Ataliya na we aba ari we aganza igihugu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        }
      ]
    },
