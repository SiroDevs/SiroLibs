                "loc": "2KI.11.19"
              },
              "items": [
                {
                  "text": "2 Abam 11:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira indwi, Yehoyada atuma ku bagabisha bagaba ijana‐ijana bo mu Bakariti no mu bashibamyi, avuga ko baza iy’ ari mu ngoro y’Uhoraho; araheza asezerana na bo isezerano, abākira indahiro aho nyene mu ngoro y’ Uhoraho; maz’ abereka uwo mwana w’umwami. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.4",
            "verseOrgIds": [
              "2KI.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababarira, at’ Uko mukwiye kubigenza n’uku: aho muzozira kw isabato ku rubu rwanyu, ikigiragatatu canyu kize gishibame ku ngoro y’umwami, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.5",
            "verseOrgIds": [
              "2KI.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikindi kigiragatatu kize gishibame ku kirimba citwa Suri, ikindi kigiragatatu kize gishibame ku kirimba inyuma y’ abateramyi bahasanzwe. Uko ni ko muzoshibamira iyo ngoro mukumiriye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.6",
            "verseOrgIds": [
              "2KI.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ imice yanyu ibiri y’abazoba bageze gukūrwa kw isabato, iz’ ishibamire ingoro y’Uhoraho ah’ umwami ari; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.7",
            "verseOrgIds": [
              "2KI.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "muze mukikize umwami impande zose, umuntu wese afise ibirwanishwa mu ntoke; ūzopfa kubēgēra aho mutonze imirongo, muze mumwice; muze mugume ku mwami ukw asohotse n’uko yinjiye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.8",
            "verseOrgIds": [
              "2KI.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.8",
            "verseOrgIds": [
              "2KI.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abo bagabisha bagaba amajana babigenza nk’uk’ uwo muherezi Yehoyada yageze kwose; umuntu wese azana abo kuja ku mbu zabo kw isabato, bahitana n’abāri bazirangije kur’ iyo sabato nyene, baja iy’ umuherezi Yehoyada ari. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.9",
            "verseOrgIds": [
              "2KI.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.7"
              },
              "items": [
                {
                  "text": "2 Sam 8:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muherezi aha abo bagabisha amacumu n’inkinzo vyar’ ivy’ umwami Dawidi, bikabīkwa mu ngoro y’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.10",
            "verseOrgIds": [
              "2KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abo bashibamyi bahagarara kur’ iyo ngoro, uhereye ku ruhande rw’i buryo ugashitsa ku rw’i bumoso, bakikuza igicaniro n’iyo ngoro ah’ umwami ari, impande zose, umuntu wese afise ibirwanishwa mu ntoke. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.11",
            "verseOrgIds": [
              "2KI.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.31.18"
              },
              "items": [
                {
                  "text": "Kuv 31:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.1.10"
              },
              "items": [
                {
                  "text": "2 Sam 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.39"
              },
              "items": [
                {
                  "text": "1 Abam 1:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yehoyada asohokana uwo mwana w’umwami, amwambika igitsibo c’ubgami amuha n’Ibishinga intahe. Nuko bamwimikisha amavuta, bamugira umwami; maze bakoma amashi, baravuga, bat’ Umwami n’ahangame!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.12",
            "verseOrgIds": [
              "2KI.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
