              "HOS.4.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.29"
              },
              "items": [
                {
                  "text": "1 Abam 12:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.15"
              },
              "items": [
                {
                  "text": "Hos 9:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.12.11"
              },
              "items": [
                {
                  "text": "12:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.4.4"
              },
              "items": [
                {
                  "text": "Am 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe Isirayeli, naho wīgize maraya, ntucumuze Yuda; kandi ntimukaje i Gilugali, canke ngo mudūge i Betaveni, canke ngo murahire uguhoraho kwanje Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.15",
            "verseOrgIds": [
              "HOS.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HOS 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isirayeli yabaye ikiganda nk’ inka y’ishashi y’ikiganda: non’ Uhoraho yobaragira nk’umwagazi w’intama ahantu h’amaramvya? ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.16",
            "verseOrgIds": [
              "HOS.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HOS 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efurayimu yifatanije n’ibigirwamana: n’umureke! ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.17",
            "verseOrgIds": [
              "HOS.4.17"
            ]
          }
        },
        {
