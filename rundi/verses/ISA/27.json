              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi bazovuga, bati Ni muririmbire uruzabibu rwa vino. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.2",
            "verseOrgIds": [
              "ISA.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jewe Uhoraho, ni jewe ndaruzigama; nzohora ndaruvomera akanya kose: nzoruzigama ku murango no mw ijoro, kugira ngo ntihagire ikirwona. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.3",
            "verseOrgIds": [
              "ISA.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
