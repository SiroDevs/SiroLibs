              "attrs": {
                "loc": "ISA.10.17"
              },
              "items": [
                {
                  "text": "Yes 10:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta burake mfise. Iyaba imikere n’ amahwa vyari bimpagurukiye kuntera, nobirwanije nkabiyigiriza hamwe: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.4",
            "verseOrgIds": [
              "ISA.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "shiti bokwisunga inkomezi zanje, bakuzura nanje, mbere ni buzure nanje. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.5",
            "verseOrgIds": [
              "ISA.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
