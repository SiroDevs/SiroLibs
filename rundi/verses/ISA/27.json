                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu misi izoza Yakobo azoshinga imizi, Isirayeli apfundike, ashurike: azokwama, yuzuze isi yose.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.6",
            "verseOrgIds": [
              "ISA.27.6"
            ]
