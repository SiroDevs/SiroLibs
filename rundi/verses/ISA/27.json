              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega yabakubise nk’uko yakubise abābakubita? Canke bishwe nk’uko hāgeseye abo yishe? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
              "ISA.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.18.17"
              },
              "items": [
                {
                  "text": "Yer 18:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwe wabirukana wabahannye ibitarenze urugero; ku musi w’umuyaga uva i burasirazuba wabavumbuje inkūbi y’umuyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.8",
            "verseOrgIds": [
              "ISA.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.21"
              },
              "items": [
                {
                  "text": "Gus 16:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.4"
