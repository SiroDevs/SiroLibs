              "items": [
                {
                  "text": "2 Abam 18:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo ni vyo bizotuma ukugabitanya kwa Yakobo kuzokwozwa, kumuveko; kand’ imbuto zose zizova mu gukūrwakw icaha ciwe n’izi: n’ukw azohindura amabuye yose y’igicaniro nk’ingwa y’amabuye ihondaguwe, kugira ngw inkingi zari zarashingiwe Ashera n’iz’ izuba ntizize zishingwe ukundi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
