                "loc": "2SA.23.6"
              },
              "items": [
                {
                  "text": "2 Sam 23:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.23.7"
              },
              "items": [
                {
                  "text": "7",
