              "items": [
                {
                  "text": "Ivyak 10:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpwemu w’Uhoraho azoba kuri we, impwemu y’ubgenge n’iy’ ugutahura, impwemu yo kuja inama n’iy’ ubushobozi, impwemu y’ukumenya Uhoraho n’iy’ ukumwubaha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.24"
              },
              "items": [
                {
                  "text": "Yoh 7:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikizomuhimbara n’ukwubaha Uhoraho; ntazocira urubanza ku bipfa kubonekera amaso yiwe, kandi ntazorushinga ku vyo apfa kwumvisha amatwi; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        },
        {
