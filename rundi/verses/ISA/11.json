        },
        {
          "text": "arikw azocira aboro imanza zibereye, kand’ azoshinga urw’ abaciye bugufi bo mw isi mu kuri: azokubitisha isi inkoni ivuye mu kanwa kiwe, kand’ abanyakibi azobīcisha impwemu ziva mu minwa yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
