            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ azoshingira amahanga ibendera, akoranirize hamwe abāri birukanywe bo mu Bisirayeli, akumakumire hamwe Abayuda bagiye isābagire, abakūye ku mfuruka zine z’isi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
