              "attrs": {
                "loc": "1CO.15.54"
              },
              "items": [
                {
                  "text": "1 Kor 15:54",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.17"
              },
              "items": [
                {
                  "text": "Ivyah 7:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urupfu azorumira miyonzwa gushitsa ibihe vyose; kand’ Umwami Uhoraho azohanagura amosozi ku maso ya bose; n’ ubumāramāre bgo ku bantu biwe azobukūra kw isi yose; kuk’ Uhoraho ari we abivuze.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
