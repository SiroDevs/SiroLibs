            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kur’ uyu musozi Uhoraho Nyen’ ingabo azohategurira amahanga yose amazimano y’inyama zinuze, amazimano ya vino y’umukāka, inyama zinuze zuzuye imisokōro, na vino y’umukāka imiminnye neza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.8"
              },
              "items": [
                {
                  "text": "Yes 22:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.15"
              },
              "items": [
                {
                  "text": "2 Kor 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uyu musozi ni ho azoherengetereza icitwikiro c’ukugandara catwikiriye amoko yose, n’icitwikiro gitwikiriye amahanga yose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.7",
            "verseOrgIds": [
              "ISA.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 25:8"
          },
          "items": [
