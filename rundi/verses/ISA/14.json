                  "text": "Yes 34:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzohahindura i wabo w’ibinyogoto, n’ibidengeri vy’amazi; nzohakubūza imyeyerezo yo kugeseza, ni k’Uhoraho Nyen’ ingabo agize.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.23",
