            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntuzohambanwa na bo kuko wagesheje igihugu cawe, ukica abantu bawe; uruvyaro rw’inkozi z’ibibi nta ho ruzokwigera rwibukwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.20",
