          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.2",
            "verseOrgIds": [
              "ISA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ku musi Uhoraho azokuruhura umubabaro n’amagorwa n’ibikorwa abaguhindagiza bagukoresha, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.3",
            "verseOrgIds": [
              "ISA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.19"
              },
              "items": [
                {
                  "text": "Yes 13:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.13"
              },
              "items": [
                {
                  "text": "Yer 51:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ho uzokwitamba ku muvyimba umwami w’i Babuloni, ut’ Eh’ ukuntu umunyagahahazo aherengeteye, n’amanyama yiwe ukuntu aherengeteye! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.4",
            "verseOrgIds": [
              "ISA.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.9.4"
              },
              "items": [
                {
                  "text": "Yes 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho avunnye inkoni y’abanyakibi, ni yo nkoni y’abaganza; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.5",
            "verseOrgIds": [
              "ISA.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bākubita amahanga baratse, bakayashishagura badahumeka, amoko bakayaganzisha amanyama n’akadenderezo ata gitabara. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.6",
            "verseOrgIds": [
              "ISA.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.12"
              },
              "items": [
                {
                  "text": "Yes 55:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isi yose ironse impore, iratekereje; baraturitse bararirimba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.7",
            "verseOrgIds": [
              "ISA.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.24"
              },
              "items": [
                {
                  "text": "Yes 37:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.31.16"
              },
              "items": [
                {
                  "text": "Ezk 31:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mber’ ibiti vy’akajwari birakwishima hejuru, n’ivy’ amasederi vy’i Lebanoni biravuga, bit’ Uhereye aho watsindiwe hasi nta wasubiye kudūga kutwicira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.8",
            "verseOrgIds": [
              "ISA.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.32.21"
              },
              "items": [
                {
                  "text": "Ezk 32:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasi i kuzimu harashwabadutse kugusanganira; hakanguye abāpfuye kubgawe, ni bo bahambaye bose bo mw isi; havyagurukije abami bose b’amahanga ku ntebe zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.9",
            "verseOrgIds": [
              "ISA.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bose bazokubaza, bati Mbega nawe uhindutse umunyantege nke nkatwe? Uhwanye natwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.10",
            "verseOrgIds": [
              "ISA.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icubahiro cawe kimanuwe i kuzimu, bo n’amajwi y’inanga zawe; ugaranzuriwe inyo, kand’ inyo nyene ni zo zikwōrōshe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.11",
            "verseOrgIds": [
              "ISA.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe kuntu ukorotse uvuye kw ijuru, wa nyenyeri yo mu rubungubungu we, wa mwana w’umutwenzi! Ewe ingen’ uciwe ugashika hasi, wewe watsinda amahanga! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.12",
            "verseOrgIds": [
              "ISA.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.53"
              },
              "items": [
                {
                  "text": "Yer 51:53",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.10"
              },
              "items": [
                {
                  "text": "Dan 8:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.23"
              },
              "items": [
                {
                  "text": "Mat 11:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wari warībariye mu mutima, uti Nzodūga nje mw ijuru, nkuze ingoma yanje isumbe inyenyeri z’Imana; uti Nzovyagira ku musozi w’ikoraniro mu ruhande rw’ impera y’i burārūko; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.13",
            "verseOrgIds": [
              "ISA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.4"
              },
              "items": [
                {
                  "text": "2 Tes 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uti Nzodūga ndenge ah’ ibicu bigarukira; nzoba nk’ Īsumba vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.14",
            "verseOrgIds": [
              "ISA.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.32.23"
              },
              "items": [
                {
                  "text": "Ezk 32:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.23"
              },
              "items": [
                {
                  "text": "Mat 11:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamar’ uzomanurwa, ushike i kuzimu, ushike mu bgigobeko bga rwa rwobo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.15",
            "verseOrgIds": [
              "ISA.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazokubona bazoguhanga, bakwitegereze, bati Mbeg’ uyu ni we yahindisha isi agashitsi, agashira ubgami bginshi mu gatengo? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.16",
            "verseOrgIds": [
              "ISA.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.33"
              },
              "items": [
                {
                  "text": "Yer 50:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni we yahindura isi nk’ubugaragwa, agakomvomvora ibisagara vyo muri yo, ntarekure abāfashwe mpiri ngo basubire i wabo? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.17",
            "verseOrgIds": [
              "ISA.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abami b’amahanga bose uko bangana basinzirira itiro ry’urupfu mu cubahiro, umwami wese mu ngoro yiwe bgite; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.18",
            "verseOrgIds": [
              "ISA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko weho bāgushiburiye kure y’imva yawe nk’inda y’urusoro iteye ishishi, uhagatiwe n’abishwe basogōswe n’inkota, bamanuka baja mu mabuye no muri rwa rwobo; weho umeze nk’umuvyimba basiribanga: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.19",
            "verseOrgIds": [
              "ISA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
