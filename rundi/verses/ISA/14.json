                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwitegure gutōtōra abana biwe kubg’ ukugabitanya kwa ba sekuruza; boye kuvyuka ngo bakevye isi, buzuze isi yose ibisagara. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.21",
            "verseOrgIds": [
              "ISA.14.21"
            ]
          }
        },
        {
