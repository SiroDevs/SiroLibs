        {
          "text": "Uhoraho Nyen’ ingabo ararahiye, ati N’ukuri, uko niyumviriye ni ko bizoshika, kand’ uko nagabiye ni ko bizoba: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.24",
            "verseOrgIds": [
