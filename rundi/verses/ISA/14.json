            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nzovunagurira Abashuri mu gihugu canje, kandi nzobasiribangira mu misozi yanje miremire: ni ho ingōgo yiwe izobavako, n’imitwaro yabakorera ibave ku bitugu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.25",
            "verseOrgIds": [
              "ISA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ni yo migabo yagīriwe isi yose, kand’ ukwo ni kwo kuboko kwābānguriwe amahanga yose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.26",
            "verseOrgIds": [
              "ISA.14.26"
            ]
          }
