                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobahagurukira, ni k’Uhoraho Nyen’ ingabo agize, kandi nzohonnya amazina n’amasigarira, umwana n’umwuzukuru, muri Babuloni, ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.22",
            "verseOrgIds": [
              "ISA.14.22"
            ]
          }
        },
        {
