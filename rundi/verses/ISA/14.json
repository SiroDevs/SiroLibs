              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.20.1"
              },
              "items": [
                {
                  "text": "Yes 20:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa rembo we, boroga! Nawe gisagara, urire! Bufilisitiya we, iy’ uva ukagera hose, urayaze nk’amavuta, kukw i burārūko havuye umwotsi, kandi nta wusigara yikwega mu ngabo ziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.31",
            "verseOrgIds": [
              "ISA.14.31"
            ]
          }
        },
        {
