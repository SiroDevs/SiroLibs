            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eh’ Umwami Uhoraho Nyen’ ingabo azocisha amashami ububasha bgiwe bg’agaterabgoba: ibirebire bisumba ibindi bizokwicirwa, n’ivyishize hejuru bizorambikwa hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.33",
            "verseOrgIds": [
