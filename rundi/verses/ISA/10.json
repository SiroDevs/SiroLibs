                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko hasigaye igihe gito cane ubushangashirwe n’uburake bganje bigashitswa mu guhona kwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.25",
