                "loc": "ISA.29.4"
              },
              "items": [
                {
                  "text": "Yes 29:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko jewe Umwami Imana ni namara guheraheza ivyo nzogirira umusozi Siyoni n’i Yerusalemu vyose, nzoca mpana umutima w’ubgibone w’umwami w’i Ashuri, n’ubugabo bgo mu maso hiwe arābana agakēngērwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.12",
            "verseOrgIds": [
              "ISA.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.23+ISA.37.24+ISA.37.25"
              },
              "items": [
                {
                  "text": "Yes 37:23-25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko yavuze, ati Ni jewe nabikoze kubg’ inkomezi z’ukuboko kwanje no kubg’ ubgenge bganje, kuko nd’umuhanga: nakūyeh’ imbibe z’amahanga, nanyaze ubutunzi bgabo, nashubije hasi abahambaye nk’umuhizi: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.13",
            "verseOrgIds": [
              "ISA.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ ukuboko kwanje kwironkeye ubutunzi bg’ amahanga nk’uwironkeye icāri c’ inyoni, kandi nk’uk’ umuntu atoragura amagi inyoni yahevye, ni ko nanje natoraguye ibihugu vyo mw isi yose; nta wakakaje n’ibaba, nta wakūyek’ umunwa, nta wajwigiriye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.14",
            "verseOrgIds": [
              "ISA.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.16"
              },
              "items": [
                {
                  "text": "Yes 29:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.20"
              },
              "items": [
                {
                  "text": "Rom 9:20",
                  "type": "text"
                }
              ]
