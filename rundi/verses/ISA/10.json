                  "text": "Yes 10:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ azoherengeteza ubgiza bg’ikibira ciwe, n’ubg’ indimiro yiwe imera cane, aherengeteze uhereye ku bugingo ugashitsa ku mubiri; bizomera nk’umurwayi yagongoberanye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.18",
            "verseOrgIds": [
              "ISA.10.18"
            ]
          }
        },
        {
