          "type": "text",
          "attrs": {
            "verseId": "ISA.10.4",
            "verseOrgIds": [
              "ISA.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
