              "items": [
                {
                  "text": "Yer 8:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazobona ibara, abashinga ivyagezwe bitabereye, n’abanditsi bandika ibigoramye; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.1",
            "verseOrgIds": [
              "ISA.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo bānzure abakene ngo ntibacirwe imanza, bagakūra urubanza ku bagorwa bo mu bantu banje, bagasahura abapfakazi, bakanyaga n’ impfuvyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.2",
            "verseOrgIds": [
              "ISA.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.26"
              },
              "items": [
                {
                  "text": "Yes 5:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.29"
              },
              "items": [
                {
                  "text": "Yer 5:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None muzogira mute umusi muzoshikīrwa, no mw irandura rivudutse kure? Muzohungira kuri nde ngw abatabare? Kandi muzobītsa hehe ubutunzi bganyu? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.3",
            "verseOrgIds": [
              "ISA.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.9.12"
              },
              "items": [
                {
                  "text": "Yes 9:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta gisigaye atar’ ugucishwa bugufi mu mbohe, canke guhindikiranywa mu bishwe. Yamara na ho nyene uburake bg’Uhoraho ntiburahwama, arik’ ukuboko kwiwe kuracabānguye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.4",
            "verseOrgIds": [
              "ISA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
