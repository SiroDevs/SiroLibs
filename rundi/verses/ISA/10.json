          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baradūze bavuye i Rimoni; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.27",
            "verseOrgIds": [
              "ISA.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "bashitse muri Ayati, baciye i Migironi; i Mikimashi ni ho basize ibintu vyabo vy’intēkera: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.28",
            "verseOrgIds": [
              "ISA.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "baserutse hejuru ku kavōvo, barāye i Geba: ab’ i Rama bafashwe n’agatengo, ab’ i Gibeya ho kwa Sauli barahunze! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.29",
            "verseOrgIds": [
              "ISA.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shira ijwi hejuru utakambe, wa mukobga w’i Galimu! Banga ugutwi, Layisha! Ewe Anatoti uragowe! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.30",
            "verseOrgIds": [
              "ISA.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’ i Madimena bacitse igikuba, ababa i Gebimu bahunganye utwabo! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.31",
            "verseOrgIds": [
              "ISA.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uyu musi wa none barataha i Nobu, babānguriye ukuboko umusozi w’umukobga w’i Siyoni, umurambi w’i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.32",
            "verseOrgIds": [
              "ISA.10.32"
            ]
          }
        }
      ]
