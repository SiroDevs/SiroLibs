            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ incabiti yokwirata k’ūrikw arayisatuza? Cank’ umusumeno wokwihayagiza k’ūrikw arawukereza? Ni nk’ah’ inkoni yozungagiza ūyītwāje, cank’ ikibando coterura ikitar’ igiti!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.15",
            "verseOrgIds": [
              "ISA.10.15"
            ]
          }
        }
      ]
    },
    {
