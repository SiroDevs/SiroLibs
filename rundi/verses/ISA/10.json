          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ amasigarira y’ibiti vyo mu kibira ciwe azoba imparūrwa, nk’ivyo umwana muto yokwandika igitigiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.19",
            "verseOrgIds": [
              "ISA.10.19"
            ]
