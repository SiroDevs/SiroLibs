          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, uku ni k’Umwami Uhoraho Nyen’ ingabo agize: ati Yemwe bantu banje baba i Siyoni, nta co mutinya aba Ashuri, naho bazobakubita inkoni, bakababāngurira ubuhiri, nk’ukw Abanyegiputa bābagiriye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.24",
            "verseOrgIds": [
              "ISA.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
