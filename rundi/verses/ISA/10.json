                {
                  "text": "Yes 9:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasigarira azogaruka, ni yo masigarira y’aba Yakobo, bagaruke ku Mana y’ubushobozi. ",
          "type": "text",
          "attrs": {
