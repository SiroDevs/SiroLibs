              "ISA.10.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.9.4"
              },
              "items": [
                {
                  "text": "Yes 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzobona ibara, Ashuri, wa rugāge rw’uburake bganje! Ubushangashirwe bganje ni bgo nkoni witwaje! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.5",
            "verseOrgIds": [
              "ISA.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzomutuma gutera ihanga rikora ibizira, kand’ ubgoko ndakiye nzomugera kubunyaga, agigimvye inyagano, abasiribangire hasi nk’ivyondo vyo mu nzira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.6",
            "verseOrgIds": [
              "ISA.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.4.12"
              },
              "items": [
                {
                  "text": "Mik 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ivyo si we avyituma ubgiwe, kandi si vyo yiyumvira mu mutima wiwe; arikw ikiri mu mutima wiwe n’uguhonnya, no kumara amahanga atari make. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.7",
            "verseOrgIds": [
              "ISA.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw avuga, ati Mbeg’ abagabisha banje bose s’abami? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.8",
            "verseOrgIds": [
              "ISA.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.16.9"
              },
              "items": [
                {
                  "text": "2 Abam 16:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.6"
              },
              "items": [
                {
                  "text": "17:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.13"
              },
              "items": [
                {
                  "text": "19:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ i Kalino ntihameze nk’i Karikemishi? I Hamati ntihameze nk’i Aripadi, n’i Samariya nk’i Damasiko? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.9",
            "verseOrgIds": [
              "ISA.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.17"
              },
              "items": [
                {
                  "text": "2 Abam 19:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’ uk’ ukuboko kwanje kwashitse ku bihugu vy’ibigirwamana vyari bifise ibishushanyo bibājwe kurusha ivy’ i Yerusalemu n’i Samariya, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.10",
            "verseOrgIds": [
              "ISA.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.34"
              },
              "items": [
                {
                  "text": "2 Abam 18:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.8"
              },
              "items": [
                {
                  "text": "Yes 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "none sinzogirira i Yerusalemu n’ibigirwamana vyaho nk’uko nagiriye i Samariya n’ibigirwamana vyaho?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.11",
            "verseOrgIds": [
              "ISA.10.11"
            ]
          }
        }
      ]
