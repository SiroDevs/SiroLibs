          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ Umwami Uhoraho Nyen’ ingabo azogeseza bikomeye mu gihugu cose, nk’uko yabigabiye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.23",
            "verseOrgIds": [
              "ISA.10.23"
            ]
