            "verseOrgIds": [
              "ISA.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co kizotuma Umwami, Uhoraho Nyen’ ingabo, azorungika ubukonyere mu bavyibushe bo muri Ashuri, kandi mu bgiza bgiwe hazodomekwa hashe nk’ ahaturirwa n’umuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.16",
            "verseOrgIds": [
              "ISA.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
