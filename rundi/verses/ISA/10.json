            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ Uhoraho Nyen’ ingabo azobashongongezakw ikimoko, nka hamwe Abamidiyani bīcirwa ku gitandara ca Orebu: kand’ inkoni yiwe izoba ibānguye hejuru y’ikiyaga, kand’ azoyibāngura nk’uko vyabaye muri Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.26",
            "verseOrgIds": [
              "ISA.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kur’ uwo musi imitwaro bābaremēka izobava ku bitugu, n’ingōgo bābambika mu mazosi zizovunwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.27",
            "verseOrgIds": [
