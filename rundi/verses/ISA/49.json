            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Siyoni ho haravuga, hat’ Uhoraho yarampevye, Umwami Imana yaranyibagiye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.14",
            "verseOrgIds": [
              "ISA.49.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
