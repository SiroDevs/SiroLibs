              "attrs": {
                "loc": "ISA.53.3"
              },
              "items": [
                {
                  "text": "53:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Uhoraho agize, Umucunguzi wa Isirayeli, Uwera wiwe, abgira umwe abantu bakēngēra, uwo ihanga ryanka urunuka, umushumba w’ abaganza, at’ Abami bazobirāba bahaguruke; bo n’abaganwa, bakome amashi; kubg’ Uhoraho umwizigirwa, ni we Wera wa Isirayeli yagutoranije. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.7",
            "verseOrgIds": [
              "ISA.49.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 49:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
