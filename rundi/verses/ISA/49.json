              },
              "items": [
                {
                  "text": "Ind 8:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe ngushushanije mu biganza vyanje; inzitiro zawe ndazihozakw amaso. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.16",
            "verseOrgIds": [
              "ISA.49.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 49:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana bawe baza bihuta; abāguhoneje n’abāguhinduye amatongo bazokuvamwo bagende. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.17",
            "verseOrgIds": [
              "ISA.49.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 49:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
