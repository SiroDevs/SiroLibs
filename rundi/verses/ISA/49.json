                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.12"
              },
              "items": [
                {
                  "text": "Heb 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.16"
              },
              "items": [
                {
                  "text": "Ivyah 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "akanwa kanje yakagize nk’inkota ikarishe, ampisha mu gitūtu c’ukuboko kwiwe; kandi yampinduye umwampi usennye, mu mutana wiwe ni ho anzigamira rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.2",
            "verseOrgIds": [
              "ISA.49.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 49:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.23"
              },
              "items": [
                {
                  "text": "Yes 44:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yarambariye, ati Ni wewe musavyi wanje, Isirayeli, uwo nzoherwamw’ icubahiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.3",
            "verseOrgIds": [
              "ISA.49.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 49:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.50.6+ISA.50.7+ISA.50.8"
              },
              "items": [
                {
                  "text": "Yes 50:6-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.23"
              },
              "items": [
                {
                  "text": "65:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ndavuga, nti Naruhijwe n’ubusa, inkomezi zanje zapfuye ubusa, nazikoresheje ibitagira ikimazi: yamara rer’ urubanza rwanje ruseguwe n’Uhoraho, kand’ Imana yanje ni yo izompēra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.4",
            "verseOrgIds": [
              "ISA.49.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.13"
              },
              "items": [
                {
                  "text": "Yes 52:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero, uku ni k’Uhoraho agize, ni we yambumvye nkiri mu nda ngo mbe umusavyi wiwe, ngo ndamugarukanire Yakobo, Abisirayeli bakoranirizwe kuri we; kuko nd’ umwubahwa mu nyonga z’Uhoraho, kand’ Imana yanje yambereye inkomezi; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.5",
            "verseOrgIds": [
              "ISA.49.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
