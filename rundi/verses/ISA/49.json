        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.1"
              },
              "items": [
                {
                  "text": "Yes 40:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.23"
              },
              "items": [
                {
                  "text": "44:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ririmba, mwa majuru; nezerwa wa si we; turika muririmbe, mwa misozi miremire, kuk’ Uhoraho amaze umubabaro abantu biwe, kand’ atewe akagongwe n’abāhahajwe biwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.13",
            "verseOrgIds": [
              "ISA.49.13"
            ]
          }
        }
      ]
    },
