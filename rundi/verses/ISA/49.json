              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Umwami Uhoraho agize, ati Nzorāmvurira amahanga ukuboko kwanje, nshingire amoko ibendera yanje; nuko bazozana abahungu bawe babakikiye mu gikiriza, n’abakobga bawe babateruye ku bitugu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.22",
            "verseOrgIds": [
              "ISA.49.22"
            ]
          }
        },
