              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.6"
              },
              "items": [
                {
                  "text": "Ivyah 16:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abaguhahaza nzobagaburira inyama zabo ubgabo, bazoborerwa ayabo maraso nk’ūborewe vino novu; kand’ abantu bose bazomenya ko jewe Uhoraho nd’ Umukiza wawe, n’Umucunguzi wawe, Inyenkomezi ya Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.26",
            "verseOrgIds": [
