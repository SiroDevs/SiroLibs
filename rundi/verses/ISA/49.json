                {
                  "text": "Yes 11:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.51.16"
              },
              "items": [
                {
                  "text": "51:16",
