          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.27.10"
              },
              "items": [
                {
                  "text": "Zab 27:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ umugore yokwibagira umwana akiri kw ibere, ngo yoye kugirira akagongwe ubura bgiwe? Ni koko, abo boshobora kwibagira, ariko jeho sinoshobora kukwibagira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.15",
            "verseOrgIds": [
              "ISA.49.15"
            ]
          }
        },
        {
