            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.27"
              },
              "items": [
                {
                  "text": "Mrk 3:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ uku ni k’Uhoraho agize, at’ Abāfashwe mpiri n’abahizi, na bo bazobanyagwa, kand’ iminyago y’abantu b’agaterabgoba izorokorwa: kukw ari jewe nzokurwanira, nkarwanya ūkurwanya, kandi nzokiza abana bawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.25",
            "verseOrgIds": [
              "ISA.49.25"
            ]
          }
        },
        {
          "name": "verse",
