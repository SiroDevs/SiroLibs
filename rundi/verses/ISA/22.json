              "type": "text"
            }
          ]
        },
        {
          "text": "Nzomushimangira nk’umusumari ahantu hagumye, azobera inzu ya se intebe y’icubahiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.23",
