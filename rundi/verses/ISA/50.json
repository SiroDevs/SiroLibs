                "loc": "PHP.2.8"
              },
              "items": [
                {
                  "text": "Flp 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Uhoraho anziburuye ugutwi, nanje sinabaye ikigāba, canke ngo mpindukire nsubire inyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        },
        {
