          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.8"
              },
              "items": [
                {
                  "text": "Ezk 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ Umwami Uhoraho arantabara, ni co gituma ntatētērwa: ni co gituma ndinduka, mu maso hanje hakamera nk’ibuye, kandi nzi yuko ntazomāramāra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 50:8"
          },
          "items": [
