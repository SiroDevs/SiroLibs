            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde muri mwebge yubaha Uhoraho, akumvira ijwi ry’umushumba wiwe? Ūgendera mu mwiza, adafise umuco, ni yizigire izina ry’Uhoraho, kandi yisunge Imana yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.10",
            "verseOrgIds": [
              "ISA.50.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umve mwese abacana umuriro, bakīshira imuri impande zose: ni mugende mumurikiwe n’umuriro wanyu, bo n’imuri mwidomekeye. Ivyo muzoronka mu kuboko kwanje n’ibi: muzoryamana umubabaro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.11",
            "verseOrgIds": [
              "ISA.50.11"
            ]
          }
        }
