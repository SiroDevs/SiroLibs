                "loc": "REV.6.12"
              },
              "items": [
                {
                  "text": "Ivyah 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambika ijuru ukwirabura, ndaryorosa amagunira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.3",
            "verseOrgIds": [
              "ISA.50.3"
            ]
