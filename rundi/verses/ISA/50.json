              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūntsindishiriza ari hafi; non’ uwombūranya ni nde? Ngo tuve hasi duhagararane: umubūranyi wanje ni nde? N’aze tubangikane. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba Umwami Uhoraho ni we azompagarikira; non’ uwontsindisha ni nde? Ereg’ abo bose bazosāza nk’impuzu; inyenzi zizobarya zibamare.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
