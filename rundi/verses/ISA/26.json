                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.5.9"
              },
              "items": [
                {
                  "text": "Mik 5:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho, umanitse ukuboko, yamara ntibabibona; ariko bazobona umwete ugirira abantu, bamāramāre; mber’ umuriro uzorigata abansi bawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.11",
            "verseOrgIds": [
              "ISA.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho, uzoturonsa impore, kukw ivyo dukora vyose ari wewe ubidusohoreza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.12",
            "verseOrgIds": [
              "ISA.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.4+2KI.18.5+2KI.18.6"
              },
              "items": [
                {
                  "text": "2 Abam 18:4-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.8"
              },
              "items": [
                {
                  "text": "Yes 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe Uhoraho Mana yacu, abandi bami batari wewe bamye batuganza; arikw izina ryawe ryonyene ni ryo twatura. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.13",
            "verseOrgIds": [
              "ISA.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bo barapfuye, ntibazokwongera kubaho; barahwereye, ntibazozuka: ni co catumye ubahana, ubarandura, ukazimanganya ukwibukwa kwabo kwose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.14",
            "verseOrgIds": [
              "ISA.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.9.3"
              },
              "items": [
                {
                  "text": "Yes 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.54.2"
              },
              "items": [
                {
                  "text": "54:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.54.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wagwije ihanga, Uhoraho we, wagwije ihanga; urashemagizwa: wunguye imbibe zose z’igihugu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.15",
            "verseOrgIds": [
              "ISA.26.15"
            ]
          }
        }
      ]
    },
