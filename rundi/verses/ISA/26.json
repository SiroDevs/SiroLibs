                "loc": "HOS.5.15"
              },
              "items": [
                {
                  "text": "Hos 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho, aho baboneye amagorwa ni ho bagushengereye; iy’ uguhana kwawe kubashikiriye basuka amajojwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.16",
            "verseOrgIds": [
              "ISA.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.8"
              },
              "items": [
                {
                  "text": "Yes 13:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’uk’ umugore akuriwe amera, iy’ igihe ciwe co kuvyara gishitse, aribga agatakishwa n’ibise vyiwe, uko ni ko twari tumeze imbere yawe, Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.17",
            "verseOrgIds": [
              "ISA.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twari dukuriwe, turaribga, bimera nk’aho twavyaye umuyaga gusa; nta gakiza twazaniye isi, kandi nta bo kuba mw isi bāvutse. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.18",
            "verseOrgIds": [
              "ISA.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
