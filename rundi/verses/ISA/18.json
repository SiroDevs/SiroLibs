                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw iyimbura ritaragera, ishurwe rihunguye, uruzabibu rutanguye kubūndūra, udushami tujondajonda azodukereza urukero,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:5",
              "type": "text"
            },
            {
              "text": "urukero ni rwo nyabuhoro.",
              "type": "text"
            }
          ]
        },
        {
          "text": " n’amashami agasaye azoyaca ayakūreho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazocurikirana hamwe babe ab’ ibisīga vy’amero vyo ku misozi miremire, n’ibikōko vyo mw isi: ivyo bisīga vy’amero bizobamarakw ici, n’ibikōko vyo mw isi bizobamarakw agatāsi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
