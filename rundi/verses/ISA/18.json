              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe wa gihugu c’amababa ahinda, kiri hakurya y’inzūzi za Etiyopiya, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "gituma intumwa zica mu kiyaga zigenda ku mazi ku bitebo vy’inkorogoto, kiti Ni mugende mwa ntumwa z’impayamaguru, muje mw ihanga ry’ abantu barebare b’imibiri iyagayaga, ubgoko bgamye butera ubgoba uhereye ubga mbere ugashitsa n’ubu; ihanga rikomeye risiribanga vyose, ryo mu gihugu kigabanijwe n’inzūzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yemwe ababa mw isi mwese, yemwe abagandagaje mw isi, ni mwabona ibendera imanitswe ku misozi miremire, muze mwiyubare, kand’ inzamba ni yavuga, muze mwumvirize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ukw ari k’Uhoraho yambariye, ati Nzokwinumira, nitegereze ndi mu buruhukiro bganje, mmere nk’indugumba irimw’ ibikēke iy’ izuba ryatse, mmere nk’igipfungu c’urume mu ndugumba yo mw iyimbura. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
