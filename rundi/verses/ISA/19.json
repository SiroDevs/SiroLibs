              "items": [
                {
                  "text": "Nah 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi Egiputa hazocika bga bagore: hazohinda agashitsi hatinye, kubg’ ugushongongeza ukuboko kw’Uhoraho Nyen’ ingabo, ahashongongereza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.16",
            "verseOrgIds": [
              "ISA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ igihugu ca Yuda kizohinduka igiteye ubgoba kuri Egiputa: ūzokibarirwa wese azotinya, kubg’ imigabo Uhoraho Nyen’ ingabo yagabiye kuri Egiputa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
