          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi mu gihugu ca Egiputa hazobamw’ ibisagara bitanu bivuga urunyakanani, birahira Uhoraho Nyen’ ingabo: kimwe muri vyo kizokwitwa Kiri‐haheresi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        }
      ]
    },
    {
