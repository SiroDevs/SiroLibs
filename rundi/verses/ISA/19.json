                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.17"
              },
              "items": [
                {
                  "text": "2 Abam 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi hazoba igicaniro cubakiwe Uhoraho mu gihugu ca Egiputa hagati, kand’ inkingi izoshingirwa Uhoraho ku rubibe rwaco. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.19",
            "verseOrgIds": [
              "ISA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.26"
              },
              "items": [
                {
                  "text": "Yos 24:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "OBA.1.21"
              },
              "items": [
                {
                  "text": "Ob 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bizoba ikimenyetso n’igishingantahe k’Uhoraho Nyen’ ingabo mu gihugu ca Egiputa: kuko bazotakambira Uhoraho kubg’ ababahahaza, na we azobarungikira umukiza n’umuvunyi, azobakiza. ",
          "type": "text",
          "attrs": {
