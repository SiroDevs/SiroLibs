            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko jewe nd’ Uhoraho Imana yawe, ntera ikiyaga gusuriranya, imipfunda yaco ikabomborana: Uhoraho Nyen’ ingabo ni ryo zina ryanje. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.15",
