                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yemwe abazi ivy’ ukugororoka, ihanga rifise ivyagezwe vyanje mu mitima yanyu, ni munyumve: ntimugatinye ibitutsi vy’abantu, canke ngo murandurwe imitima n’ ugucokora kwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.7",
            "verseOrgIds": [
              "ISA.51.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 51:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw inyenzi zizobarya nk’umwambaro, n’ ifukunyi izobarya nk’ubgoya bg’ intama: arik’ ukugororoka kwanje kuzokwamah’ ibihe bidashira, n’ agakiza kanje uk’ urunganwe ruzogenda rukurikirana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.8",
            "verseOrgIds": [
              "ISA.51.8"
            ]
          }
        }
      ]
