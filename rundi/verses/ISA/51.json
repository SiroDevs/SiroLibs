      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 51:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni munyumve, yemwe abakurikirana ukugororoka, yemwe abarondera Uhoraho: mwitegereze igitandara mwasatuweko, n’inganzo mwimbgemwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.1",
            "verseOrgIds": [
              "ISA.51.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 51:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.24"
              },
              "items": [
                {
                  "text": "Ezk 33:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwitegereze Aburahamu sogokuruza, na Sara yabavyaye; kuko hamwe Aburahamu yar’ akir’ umwe rudende namuhamagaye, nkamuha umugisha, nkamugwiza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.2",
            "verseOrgIds": [
              "ISA.51.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 51:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.8"
              },
              "items": [
                {
                  "text": "Ita 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.10"
              },
              "items": [
                {
                  "text": "13:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.35.10"
              },
              "items": [
                {
                  "text": "Yes 35:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko jewe Uhoraho namaze Siyoni umubabaro; namaze umubabaro imisaka yaho yose, kand’ ubugaragwa bgaho nabugize nka Edeni, n’ubgeranyange bgaho nabugize nk’itongo ryanje, jewe Uhoraho; hazobonekamw’ umunezero n’uguhimbarwa, bo n’ishimwe n’ijwi ry’inanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
        }
      ]
    },
