              },
              "items": [
                {
                  "text": "Yes 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu banje, ni munyumvirize; hanga ryanje, muntege ugutwi; kukw icagezwe kizova kuri jewe, kandi nzoshinga amateka yanje ngw abe umuco w’amahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.4",
            "verseOrgIds": [
              "ISA.51.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 51:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.46.13"
              },
              "items": [
                {
                  "text": "Yes 46:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubugororotsi bganje buri hafi, agakiza kanje karaserutse, amaboko yanje azocira amahanga amateka; ababa ku kiyaga bazonyitega, kand’ ukuboko kwanje ni kwo bazokwizigira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 51:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.35"
              },
              "items": [
                {
                  "text": "Mat 24:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.10"
              },
              "items": [
                {
                  "text": "2 Pet 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.1"
              },
              "items": [
                {
                  "text": "Ivyah 21:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwunamurire amaso yanyu mw ijuru, mwitegereze no kw isi hasi: kukw ijuru rizokamangana nk’umwotsi, n’isi izosāza nk’umwambaro, n’abayibako bazopfa nk’isazi: arikw agakiza kanje kazokwamah’ ibihe bidashira, kand’ ukugororoka kwanje ntikuzogira iherezo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
