                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bana wavyaye bose ntiharih’ uwo kukurōngōra; kandi mu bo wareze bose nta wo kugufata ukuboko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.18",
