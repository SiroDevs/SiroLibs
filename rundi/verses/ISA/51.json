            "number": "13",
            "style": "v",
            "sid": "ISA 51:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukibagira Uhoraho Umuremyi wawe, ari we yagaranzuye amajuru, agashirah’ amatanguriro y’isi; maz’ ukīriza umusi utinya uburake bg’ūhahaza, iyo yiteguye guhonnya: non’ uburake bg’ūhahaza buri hehe? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.13",
            "verseOrgIds": [
              "ISA.51.13"
            ]
          }
        },
