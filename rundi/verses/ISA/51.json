              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi vyompi ko bigushitseko, ni nde azokuririra? Ko haje ibitongozi n’ugusangangurwa, bo n’inzara n’inkota, nokuremesha nte? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.19",
            "verseOrgIds": [
              "ISA.51.19"
            ]
          }
        },
