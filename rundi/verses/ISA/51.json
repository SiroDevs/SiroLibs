            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni jewe, ni jewe nyene mbahūmuriza; uri nde utinya umuntu, kand’ azopfa; n’umwana w’ umuntu, kand’ azohinduka nk’ivyatsi? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.12",
            "verseOrgIds": [
              "ISA.51.12"
            ]
          }
        },
        {
