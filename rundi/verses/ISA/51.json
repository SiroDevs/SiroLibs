            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abāfashwe mpiri bakambukanwa bazorekurwa vuba; ntibazopfa ngo baje muri rwa rwobo, kand’ ivyo kurya vyabo ntibizobura. ",
          "type": "text",
          "attrs": {
