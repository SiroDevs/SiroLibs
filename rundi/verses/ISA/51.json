                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikangure, ikangure, wambare inkomezi, ewe wa kuboko kw’ Uhoraho; ikangure nko mu misi ya kera, nko ku runganwe rw’ibihe vyashize, uko rwagenda rukurikirana. Mbega si wewe wahimbaguye Rahabu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.9",
            "verseOrgIds": [
              "ISA.51.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "51:9",
              "type": "text"
            },
            {
              "text": "Rāba",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.7"
              },
              "items": [
                {
                  "text": "Yes 30:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ugasogota ca gisato c’amahēro? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.9",
            "verseOrgIds": [
              "ISA.51.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 51:10"
          },
          "items": [
