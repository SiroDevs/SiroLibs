            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.21"
              },
              "items": [
                {
                  "text": "Kuv 14:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si wewe wakamije ikiyaga, amazi maremare yo mw idamba; ugahindura i bgina bgo mu kiyaga kuba inzira ngw abācunguwe bayicemwo? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.10",
            "verseOrgIds": [
              "ISA.51.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 51:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abācunguwe n’Uhoraho bazogaruka, bashike i Siyoni baririmba; umunezero utazoshira uzohora ku mitwe yabo; bazoronka umunezero n’uguhimbarwa, kand’ umubabaro no gusuhuza umutima bizohunga vyambuke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.11",
            "verseOrgIds": [
              "ISA.51.11"
            ]
          }
        }
      ]
