                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba, uzohamagara ihanga utazi, kandi n’iryari ritakuzi rizokwirukirako, kubg’ Uhoraho Imana yawe, no kubg’ Uwera w’Abisirayeli, kukw azoba aguhaye icubahiro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
