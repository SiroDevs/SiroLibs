                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzovayo muri n’umunezero, muzorōngōra amahoro muvayo: imisozi n’uturambi bizoturika biririmbire imbere yanyu, ibiti vyose vyo mw ishamba bizokoma amashi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.12",
            "verseOrgIds": [
              "ISA.55.12"
            ]
          }
        },
