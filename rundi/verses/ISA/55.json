              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.27"
              },
              "items": [
                {
                  "text": "Yoh 6:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’iki gituma mutanga amahera kugura ibitar’ ivyo kurya nyakuri? N’iki gituma mukorera ibidahāza? Mugire umwete wo kunyumvira, ni ho muzorya ivyiza, ubugingo bganyu bunezererwe ibishashagira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        },
        {
          "name": "verse",
