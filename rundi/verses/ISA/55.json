            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba, ndamutanze ngw abe icabona co gushingira intahe amahanga, ngw abe n’umukuru na segaba w’amahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.4",
            "verseOrgIds": [
              "ISA.55.4"
            ]
          }
        },
