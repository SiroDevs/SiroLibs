            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutege amatwi, muze kuri jewe; munyumve, ni ho ubugingo bganyu buzobaho; nanje nzosezerana namwe isezerano ritazoshira, ni ryo mbabazi Dawidi yasezeraniwe zitazovaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        },
        {
