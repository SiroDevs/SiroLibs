                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.43"
              },
              "items": [
                {
                  "text": "Yer 48:43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.44"
              },
              "items": [
                {
                  "text": "44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe uba mw isi, ibiteye ubgoba n’urusumanyenzi n’umutego bigushitseko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.17",
            "verseOrgIds": [
              "ISA.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ ūhunga induru y’ibiteye ubgoba azogwa mu rusumanyenzi; uwūrira ngw ave mu rusumanyenzi umutego uzomufata: kukw ingomero zo mw ijuru zigomorowe, kand’ amatanguriro y’isi akanyiganyiga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.18",
            "verseOrgIds": [
              "ISA.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isi iravungaguritse, isi irasataguritse, isi irahuzenze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.19",
            "verseOrgIds": [
              "ISA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
