                "loc": "ISA.26.2"
              },
              "items": [
                {
                  "text": "26:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twumvise indirimbo zituruka ku mpera y’isi, zit’ Icubahiro kibe ic’ umugororotsi. Maze nca ndavuga, nti Ndageranywe, ndageranywe! Mbonye ibara! Abaryarukanyi bararyarukanye, mber’ abaryarukanyi bararyarukanye rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.16",
            "verseOrgIds": [
              "ISA.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.11"
              },
              "items": [
                {
                  "text": "Ita 7:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
