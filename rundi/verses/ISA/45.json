              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa majuru, murekure ukugororoka kuve mw ijuru, n’ikirēre kigucuncubure: isi yasame, itengengerekw agakiza, ikamezanye n’ukugororoka: ni jewe Uhoraho nabiremye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.8",
            "verseOrgIds": [
              "ISA.45.8"
            ]
          }
        }
      ]
