          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazotētērwa, bamāramāre bose, bazomāramārira hamwe, abakora ibishushanyo vy’ibigirwamana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.16",
            "verseOrgIds": [
              "ISA.45.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
