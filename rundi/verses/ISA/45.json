        },
        {
          "text": "N’ukuri ur’ Imana yihishije, wewe Mana y’ Abisirayeli, Umukiza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.15",
            "verseOrgIds": [
              "ISA.45.15"
            ]
          }
        },
        {
          "name": "verse",
