                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi ni vyo jewe Uhoraho mbgira uwo narobanuje amavuta, ni we Kuro, uwo mfashe ukuboko kw’i buryo, kugira ngo nsiribange amahanga imbere yiwe, kandi nzokenyurura inkindi z’abami, kugira ngo ndamwugururire inzugi imbere yiwe, kand’ amarembo ntazokwugarirwa: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.1",
            "verseOrgIds": [
              "ISA.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 45:2"
          },
          "items": [
            {
