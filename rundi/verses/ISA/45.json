              "items": [
                {
                  "text": "Yes 54:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw Abisirayeli bazokizwa n’Uhoraho, abakirishe agakiza kadashira: ntimuzotētērwa, canke ngo mumāramāre, no gushitsa ibihe bitazoshira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.17",
            "verseOrgIds": [
              "ISA.45.17"
            ]
          }
        }
