              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.107.16"
              },
              "items": [
                {
                  "text": "Zab 107:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.4"
              },
              "items": [
                {
                  "text": "Yes 40:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nti Nzoja imbere yawe, kand’ ahar’ uduhogoro nzohasena; nzomenagura inzugi z’imiringa, nzovunagura ibihindizo vy’ivyuma: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.2",
            "verseOrgIds": [
              "ISA.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.43.1"
              },
              "items": [
                {
                  "text": "Yes 43:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.13"
              },
              "items": [
                {
                  "text": "Yer 51:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi nzoguha itunga rihishijwe mu mwiza, n’ubutunzi bunyegejwe mu mpisho, kugira ng’ umenye kw ari jewe Uhoraho nguhamagaye mw izina, jewe nyene Imana y’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.3",
            "verseOrgIds": [
              "ISA.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.62.2"
              },
              "items": [
                {
                  "text": "Yes 62:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubga Yakobo umusavyi wanje, Isirayeli uwo natoranije, nguhamagaye mw izina, nakwise iry’ icubahiro, nah’ utaribgammenye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.4",
            "verseOrgIds": [
              "ISA.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni jewe Uhoraho, nta wundi; atari jewe nta yindi Mana iriho. Nzogukenyeza nah’ utigeze kummenya, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.5",
            "verseOrgIds": [
              "ISA.45.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.20"
              },
              "items": [
                {
                  "text": "Yes 37:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.11"
              },
              "items": [
                {
                  "text": "Mal 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo bamenye uhereye i burasirazuba ugashitsa i burengerazuba yukw ata yindi atari jewe: ni jewe Uhoraho, kandi nta wundi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.6",
            "verseOrgIds": [
              "ISA.45.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.23"
              },
              "items": [
                {
                  "text": "Yes 41:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.3.6"
              },
              "items": [
                {
                  "text": "Am 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni jewe nkomoko y’umuco, nd’ umuremyi w’umwiza; nd’ isōko y’impore, nd’umuremyi w’ivyago: ni jewe Uhoraho nkora ivyo vyose.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.7",
            "verseOrgIds": [
              "ISA.45.7"
            ]
          }
        }
      ]
    },
