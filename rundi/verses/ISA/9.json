            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamar’ abantu ntibāhindukiriye uwabakubise, kandi ntibārondeye Uhoraho Nyen’ ingabo. ",
          "type": "text",
          "attrs": {
