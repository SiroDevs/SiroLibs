              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw igiti c’ingōgo bāmuremēka, n’ubuhiri bāmukubita mu butikorwa, n’inkoni y’uwamuhahaza, wabivunaguye nko kuri wa musi w’Abamidiyani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ivyākīngira abafise ibirwanishwa mu ntambara, n’impuzu zivumbagajwe mu maraso, bizoba ivyo gucanwa, bibe inkwi z’umuriro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
