              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasiriya bazomuturuka imbere, Abafilisitiya na bo bamuturuke inyuma: bazokwasamira Isirayeli bamutsontsomere. Yamara na ho nyene uburake bg’Uhoraho ntiburahwama, arik’ ukuboko kwiwe kuracabānguye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.12",
            "verseOrgIds": [
              "ISA.9.12"
            ]
          }
        }
      ]
    },
