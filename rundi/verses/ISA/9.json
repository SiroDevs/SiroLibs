                  "text": "Mik 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uburake bg’Uhoraho Nyen’ ingabo ni bgo butumye igihugu gitongoka: abantu na bo bakamera nk’inkwi z’umuriro; nta wugirira akagongwe mugenzi we. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.19",
            "verseOrgIds": [
              "ISA.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
