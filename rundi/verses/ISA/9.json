          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.15"
              },
              "items": [
                {
                  "text": "Yes 26:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.36"
              },
              "items": [
                {
                  "text": "Yoh 4:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wagwije ihanga, wabongeye umunezero, banezererwa imbere yawe, nk’umunezero wo mw iyimbura, nk’uw’ abantu banezerwa bagabanganye iminyago. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        },
        {
