                {
                  "text": "Yes 8:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu azosahurira i buryo bgiwe, ariko yame ashonje; azorya n’ivy’ i bumoso, na ho nyene ntahāge: umuntu wese azorya mugenzi we kw inyama. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.20",
            "verseOrgIds": [
