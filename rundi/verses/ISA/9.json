            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bāgendera mu mwiza babonye umuco mwinshi, abāba mu gihugu c’igitūtu c’urupfu ni bo bākiwe n’umuco. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        },
        {
