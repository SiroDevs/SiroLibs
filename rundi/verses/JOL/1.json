              "JOL.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.24.11"
              },
              "items": [
                {
                  "text": "Yes 24:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwikangure, yemwe mborerwa, murire; namwe abakāmīra vino, muboroge, muririre vino ziryoshe, kuko zikūwe mu kanwa kanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.9.8"
              },
              "items": [
                {
                  "text": "Ivyah 9:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ihanga rikomeye kandi ry’isinzi riteye igihugu canje; amenyo yabo ni nk’imikāka y’intambge, kandi bafise amajigo nk’ay’ intambge y’ingore. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bononye umuzabibu wanje, kand’ umusukoni wanje barawuvunnye, barawushishuye rwose, bawutsinda hasi; amashami yawo asigaye ar’ igihororo c’imitonore. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boroga nk’inkumi ikenyeye amagunira iririra uwar’ ayikoye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.8",
            "verseOrgIds": [
              "JOL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.41"
              },
              "items": [
                {
                  "text": "Kuv 29:41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.4"
              },
              "items": [
                {
                  "text": "Ezk 45:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amafu y’amashikanwa n’ibiturire vyabuze mu ngoro y’Uhoraho; abaherezi, ari bo basuku b’Uhoraho, basigaye baganya. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.2.9"
              },
              "items": [
                {
                  "text": "Hos 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.4.3"
              },
              "items": [
                {
                  "text": "4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imirima irononekaye, n’igihugu kiraganya; kukw amasaka yononekaye, na vino z’umubira zikamye akagīrīre, kand’ amavuta ya elayo na yo aherengeteye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.14.4"
              },
              "items": [
                {
                  "text": "Yer 14:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mujorerwe, yemwe barimyi, namwe abarimyi b’uruzabibu, ni muboroge, muririre ingano na sayiri; kukw ivyimburwa vyo mu ndimiro bibuze. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.11",
            "verseOrgIds": [
              "JOL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.16.10"
              },
              "items": [
                {
                  "text": "Yes 16:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuzabibu urakabiranye, umusukoni urahondobereye; umukomamanga bo n’ikigazi n’umucungwa, mbere n’ibiti vyose vyo mu ndimiro birakabiranye: kuk’ umunezero uherengeteye mu bantu.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.12",
            "verseOrgIds": [
              "JOL.1.12"
            ]
          }
        }
      ]
    },
