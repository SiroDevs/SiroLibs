              "attrs": {
                "loc": "MIC.1.8"
              },
              "items": [
                {
                  "text": "Mik 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yemwe baherezi, mukenyere amagunira, murire; namwe abasukūra ku gicaniro, ni muboroge; enda ni muze mukēshe ijoro mwubaraye, mwambaye amagunira, yemwe basuku b’Imana yanje: kukw ishikanwa ry’ifu n’ibiturire vyimanywe ngo ntibize mu ngoro y’Imana yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.13",
            "verseOrgIds": [
              "JOL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.3"
              },
              "items": [
                {
                  "text": "2 Ngo 20:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushinge igihe co kwisonzesha, mutāngāze hose habe ikoraniro ry’agahebuza; mwa bashingantahe, ni mukoranye ababa mu gihugu bose, baze mu ngoro y’Uhoraho Imana yanyu, mutakambire Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.14",
            "verseOrgIds": [
              "JOL.1.14"
            ]
          }
        },
