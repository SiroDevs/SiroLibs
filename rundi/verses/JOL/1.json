          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbuto zumiye mu masīze; ibigega birasivye, n’ivya nyamugari birasambuwe; kukw amasaka arumbiranye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.17",
            "verseOrgIds": [
