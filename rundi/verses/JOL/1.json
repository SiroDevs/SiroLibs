            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ ivyo kurya ntivyavumbuwe twirorērera? Mbere n’umunezero n’ibihimbaro ntivyakūwe mu ngoro y’Imana yacu? ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.16",
            "verseOrgIds": [
              "JOL.1.16"
            ]
          }
        },
