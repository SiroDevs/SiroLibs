              "items": [
                {
                  "text": "2 Sam 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi ur’ izina batatu bo muri bamwe mirongwitatu b’abahizi baramanuka, baja iyo Dawidi ari muri rya senga ry’i Adulamu; hāri mu gihe c’iyimbura, kand’ igitero c’Abafilisitiya cari gishagaje ku mwonga Refayimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.13",
            "verseOrgIds": [
              "2SA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.22.4"
              },
              "items": [
                {
                  "text": "1 Sam 22:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.22.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe Dawidi yari mw isenga, kandi har’ insago z’Abafilisitiya i Betelehemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.14",
            "verseOrgIds": [
              "2SA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi yumva akumbuye amazi yaho; aravuga, at’ Icompa nkabona uwompa ku mazi y’iriba ryo kw irembo ry’i Betelehemu, nkayanywa! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.15",
            "verseOrgIds": [
              "2SA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ba bahizi batatu baca mu ngabo z’ Abafilisitiya, bavoma amazi mur’ iryo riba ryo kw irembo ry’i Betelehemu, barayazana, bayaha Dawidi; ariko yanka kuyanywa, ayavyagiza imbere y’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.16",
            "verseOrgIds": [
              "2SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.17.14"
              },
              "items": [
                {
                  "text": "Lew 17:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aravuga, at’ Ewe Uhoraho, biragahera ko nokora ntyo! Ndābe nnywe amaraso y’abantu bahevye amagara yabo? Ni co catumye yanka kuyanywa. Ivyo ni vyo vyakozwe na ba bandi batatu b’ abahizi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.17",
            "verseOrgIds": [
              "2SA.23.17"
            ]
          }
        }
      ]
    },
    {
