        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.25",
            "verseOrgIds": [
              "2SA.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
