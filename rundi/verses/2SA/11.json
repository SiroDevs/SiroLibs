          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze muka Uriya yumvise k’ umugabo wiwe yapfuye, aramuririra. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.26",
            "verseOrgIds": [
              "2SA.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma agandutse, Dawidi atuma kumuzana i we, aramucūra; bavyarana umwana w’umuhungu; arikw ivyo Dawidi yakoze vyababaje Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.27",
            "verseOrgIds": [
              "2SA.11.27"
            ]
          }
