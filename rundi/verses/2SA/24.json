              "items": [
                {
                  "text": "Zab 20:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivyo vyose jewe Arawuna ndabiguhaye, mugenzi. Arawuna arongera abarira umwami, at’ Uhoraho Imana yawe ikwākīrire. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.23",
            "verseOrgIds": [
              "2SA.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umwami yishura Arawuna, ati Na mba: turabigura, nguhe ikiguzi cavyo; sinokwosereza Uhoraho Imana yanje ibimazi ata co binkeheje. Nuko Dawidi agura iyo mbuga n’inka, atanga amashekeli y’ifeza mirongwitanu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.24",
            "verseOrgIds": [
              "2SA.24.24"
            ]
          }
        },
