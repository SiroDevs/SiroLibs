              },
              "items": [
                {
                  "text": "1 Ngo 21:1-28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.26.19"
              },
              "items": [
                {
                  "text": "1 Sam 26:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.13"
              },
              "items": [
                {
                  "text": "Yak 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ uburake bg’Uhoraho bgongera kuziriringira Abisirayeli; asunika Dawidi ngw abakwegere, ati Genda uharūre Abisirayeli n’Abayuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.1",
            "verseOrgIds": [
              "2SA.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.10"
              },
              "items": [
                {
                  "text": "2 Sam 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami abarira Yowabu umugabisha w’ingabo ziwe yari kuri we, ati Nyuragira mu miryango yose y’ Abisirayeli, uhereye i Dani ugashitsa i Beri‐sheba, muharūre abantu, kugira ngo mmenye igitigiri cabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.2",
            "verseOrgIds": [
              "2SA.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.11"
              },
              "items": [
                {
                  "text": "Gus 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabu yishura umwami, at’ Uhoraho Imana yawe n’igwiririkanye abantu, barute uko bari basanzwe bangana ibihetangabo ijana, nawe uz’ uvyibonere mugenzi; ariko mbega n’iki kiguteye gushira umutima ku kintu nk’ico ga mwami wanje nyen’ ingoma? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.3",
            "verseOrgIds": [
              "2SA.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.27.24"
              },
              "items": [
                {
                  "text": "1 Ngo 27:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ijambo ry’umwami rinesha irya Yowabu n’iry’ abagabisha b’ingabo. Nuko Yowabu n’abo bagabisha bava imbere y’umwami, baja guharūra Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.4",
            "verseOrgIds": [
              "2SA.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.1"
              },
              "items": [
                {
                  "text": "Guh 32:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.9"
              },
              "items": [
                {
                  "text": "Yos 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bajabuka Yorodani, bahēra i Aroweri, no ku gisagara kiri hagati mu kiyaya, bagenda berekeye i Gadi kurinda bashika i Yazeri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.5",
            "verseOrgIds": [
              "2SA.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze baja i Gileyadi no mu gihugu c’i Tahatimu‐hodishi, baja n’i Dani‐yani, barazenguka baja i Sidoni, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.6",
            "verseOrgIds": [
              "2SA.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.19.29"
              },
              "items": [
                {
                  "text": "Yos 19:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.3"
              },
              "items": [
                {
                  "text": "Abac 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "baca kw iboma ry’i Tiro no mu bisagara vyose vy’Abahiwi n’ivy’ Abanyakanani, bagarukira i Beri‐sheba i bumanuko bg’i Buyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.7",
            "verseOrgIds": [
              "2SA.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko barangije kugendura igihugu cose basubira i Yerusalemu, bamaze amezi cenda n’imisi mirongwibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.8",
            "verseOrgIds": [
              "2SA.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yowabu ashikiriza umwami igitigiri c’abantu bāharūye: mu Bisirayeli hārimw’ abantu b’abahizi bazi kurwanisha inkota, ibihumbi amajana munani; mu Bayuda na ho hārimw’ ibihumbi amajana atanu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.9",
            "verseOrgIds": [
              "2SA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
