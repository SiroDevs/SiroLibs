              "items": [
                {
                  "text": "1 Abam 19:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arawuna yishura Dawidi, ati Mwami wanje nyen’ ingoma, twara ivy’ ugomba vyose, ubitange: eh’ inka ngizo z’ikimazi co kwosa, n’ibisekuzo zikoresha n’ ingōgo zazo mubigire inkwi: ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.22",
            "verseOrgIds": [
              "2SA.24.22"
            ]
          }
        },
        {
          "name": "verse",
