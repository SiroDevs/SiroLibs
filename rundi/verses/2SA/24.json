              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.48"
              },
              "items": [
                {
                  "text": "Guh 16:48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.50"
              },
              "items": [
                {
                  "text": "50",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arawuna aramubaza, ati Mwami wanje nyen’ ingoma, uzanywe n’iki i wanje jewe umusavyi wawe? Dawidi aramwishura, ati Nzanywe no kugura iyo mbuga yawe, ngo nubakire Uhoraho igicaniro, kugira ngw ikīza kive mu bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.21",
            "verseOrgIds": [
              "2SA.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
