              "items": [
                {
                  "text": "Zab 74:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi abonye uwo mumarayika yageseza abantu, abarira Uhoraho, at’ Erega ni jewe nacumuye, ni jewe nakoze nabi; arikw izi ntama zo zakoze iki? Ndakwinginze, ukuboko kwawe abe ari jewe kurwanya, bo n’inzu ya data.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.17",
            "verseOrgIds": [
              "2SA.24.17"
            ]
          }
        }
