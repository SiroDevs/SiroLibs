            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shewa yar’ umukarani; Sadoki na Abiyatari ni bo bār’ abaherezi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.25",
            "verseOrgIds": [
              "2SA.20.25"
            ]
          }
        },
