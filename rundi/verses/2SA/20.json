              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.26.19"
              },
              "items": [
                {
                  "text": "1 Sam 26:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jewe nd’umwe mu bakunda ivy’ amahoro kandi b’abizigirwa mu Bisirayeli; ariko wewe urondera kugeseza igisagara, ari co muvyeyi mu Bisirayeli. N’iki gituma ugomba kuyongobeza ishamvu y’Uhoraho? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.19",
            "verseOrgIds": [
              "2SA.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabu aramwishura, ati Biragahera! Biragahera ko hogira ico noyongobeza canke nogeseza! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.20",
            "verseOrgIds": [
              "2SA.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si ko biri; ariko harih’ umuntu wo mu mugamba w’Abefurayimu yitwa Sheba mwene Bikuri, yagararije umwami Dawidi; mube ari we mutanga wenyene, mbone kubavira ku gisagara. Nya mugore yishura Yowabu, ati Nuko rero, umutwe wiwe turawurenza uruzitiro tuwugushiburire. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.21",
            "verseOrgIds": [
              "2SA.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.9.14"
              },
              "items": [
                {
                  "text": "Umus 9:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.9.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ uwo mugore aja mu bantu bose ajanye inama y’ubgenge; na bo baragenda baca izosi Sheba mwene Bikuri, bashiburira Yowabu umutwe wiwe. Na we araheza avuza inzamba, abantu bose bava ku gisagara, baratandukana, umuntu wese ataha i we. Yowabu na we atabarukira i Yerusalemu i bgami.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.22",
            "verseOrgIds": [
              "2SA.20.22"
            ]
          }
        }
      ]
