          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aravuga, ati Kera bākunda kuvuga, bati Ni bagīshe inama i Abeli; kandi rero vyaca bihera. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.18",
            "verseOrgIds": [
              "2SA.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 20:19"
          },
          "items": [
