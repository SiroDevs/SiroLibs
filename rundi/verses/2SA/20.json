              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoramu na we yagaba ivy’ ikori; Yehoshafati mwene Ahiludi ni we yar’ umwanditsi w’ivyaja biraba; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.24",
            "verseOrgIds": [
              "2SA.20.24"
            ]
