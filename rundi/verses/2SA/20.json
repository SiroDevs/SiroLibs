                "loc": "2SA.16.21"
              },
              "items": [
                {
                  "text": "16:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.16.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami Dawidi ashitse i we i Yerusalemu, ajana za ncoreke ziwe yagize abagore ukw ar’ icumi, abo yari yasigaranye urugo; abashira mu nzu, abaha ababarinda; abatungiraho, ariko ntiyasubira kubarārira. Nuko baguma ngaho barindwa, barinda bapfa bameze nk’abapfakazi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
