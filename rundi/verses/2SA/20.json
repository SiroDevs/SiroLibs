                {
                  "text": "1 Abam 12:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hār’ umuntu w’umugesera yitwa Sheba, mwene Bikuri Umubenyamini; aca avuza inzamba, aravuga, ati Dawidi nta co tumwegako, nta mugabane dufise kuri mwene Isayi: yemwe Bisirayeli, hogi twitahire, umuntu wese aje i muhira! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw Abisirayeli bose bata Dawidi, bakondorera inyuma ya Sheba mwene Bikuri; arikw Abayuda bo bigumira ku mwami wabo, baramuherekeza kuva kuri Yorodani gushitsa i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        }
      ]
    },
    {
