                {
                  "text": "1 Ngo 19:1-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo umwami w’Abamoni aratanga; maz’ umuhungu wiwe Hanuni asubira ku ngoma yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.1",
            "verseOrgIds": [
              "2SA.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.11.1"
              },
              "items": [
                {
                  "text": "1 Sam 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi avyumvise aravuga, ati Nzogirira neza Hanuni mwene Nahashi, nk’uko se yangiriye neza. Nuko Dawidi arungika abantu bo kumugarukirako kuko yabuze se. Abo bantu ba Dawidi baragenda, bashika mu gihugu c’Abamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.2",
            "verseOrgIds": [
              "2SA.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.25"
              },
              "items": [
                {
                  "text": "2 Sam 3:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abaganwa b’Abamoni babarira umwami wabo Hanuni, bati Mbeg’ ugira ngo Dawidi icamuteye kurungika abo kukugarukirako n’uko yari yubashe so? Ntuzi kw abo bantu yabarungitse gukenguza iki gisagara no kugitata, ngw abone kukigeseza? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.3",
            "verseOrgIds": [
              "2SA.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Hanuni afata abo bantu ba Dawidi, abamwa ubganwa bg’umusaya umwe, akeba impuzu zabo ahereye hagati ku kibuno, araheza arabarungika. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.4",
            "verseOrgIds": [
              "2SA.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi abibariwe, atuma abo guhūra na bo, kukw abo bagabo bāri batēterewe cane. Umwami abatumako, uti Ni mugume i Yeriko kugeza musubiye kumera ubganwa, muheze muze mubone kugaruka.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.5",
            "verseOrgIds": [
              "2SA.10.5"
            ]
          }
        }
      ]
    },
    {
