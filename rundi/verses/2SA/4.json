              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi yishura Rekabu na mwene nyina Bayana, bene Rimona w’i Beroti, ati Ndahiye uguhoraho kw’Uhoraho, yagiye andokora mu vyago vyose; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.9",
            "verseOrgIds": [
              "2SA.4.9"
            ]
          }
        },
