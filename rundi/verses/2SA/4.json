              "items": [
                {
                  "text": "23:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ uwo mutwe wa Ishibosheti bawushīra umwami Dawidi i Heburoni, baramubarira, bati Nguyu umutwe wa Ishibosheti umwana w’ umwansi wawe Sauli, yahora aguhīga; Uhoraho ashubirije Sauli mu nkōko, n’abana biwe, abaguhōye, mwami wacu nyen’ ingoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.8",
            "verseOrgIds": [
              "2SA.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
