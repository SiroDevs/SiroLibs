              },
              "items": [
                {
                  "text": "2 Sam 3:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi abarira imisore yamugendanira, barabīca, babaca ibikonjo n’ibirenge, babamanika i ruhande y’ikidengeri c’i Heburoni. Arik’ umutwe wa Ishibosheti barawābīra, bawuhamba mu mva ya Abuneri i Heburoni nyene.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.12",
            "verseOrgIds": [
              "2SA.4.12"
            ]
