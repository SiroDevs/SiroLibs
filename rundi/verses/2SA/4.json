        },
        {
          "text": "Bukeye Ishibosheti mwene Sauli yumvise ko Abuneri yaguye i Heburoni, arajonjogora, Abisirayeli bose bahagarika imitima. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.1",
            "verseOrgIds": [
              "2SA.4.1"
            ]
          }
