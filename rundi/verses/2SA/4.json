            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None mbega, abantu b’inkozi z’ibibi basanze umuntu w’umugororotsi mu nzu yiwe yiryamiye ku buriri bakamwica, sindushiriza kubahōra amaraso yiwe, nkabarandura nkabakūra mw isi? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.11",
            "verseOrgIds": [
              "2SA.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
