              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye bene Rimona w’i Beroti, Rekabu na Bayana, baraza, bashika kwa Ishibosheti, igihe yar’ avyukiriye mu mashōka. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.5",
            "verseOrgIds": [
              "2SA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ incoreke ikumīra yari yamye aragosora ingano, iterwa n’itiro, irasinzira; nuko Rekabu na Bayana mwene nyina babona akaryo ko kwinjira. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.6",
            "verseOrgIds": [
              "2SA.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.2.29"
              },
              "items": [
                {
                  "text": "2 Sam 2:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bīteye mu ngoro, barenga mw iteka basanga aryamye ku kirwa, baramucumita, baramwica, bamuca izosi; baraheza bajana umutwe wiwe, bagenda ijoro ryose bajanye ikiyaya Araba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.7",
            "verseOrgIds": [
              "2SA.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
