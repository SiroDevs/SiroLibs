                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ ab’ i Beroti bari barahungiye i Gitayimu, bagumayo kugeza na bugingo n’ubu.)",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.3",
            "verseOrgIds": [
              "2SA.4.3"
