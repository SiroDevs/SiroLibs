        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.19.10"
              },
              "items": [
                {
                  "text": "1 Sam 19:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
