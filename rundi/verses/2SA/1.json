          ]
        },
        {
          "text": "Maze Dawidi afata impuzu ziwe, azītantamurirako, n’abantu bose bari kumwe na we bagira kuno; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.11",
            "verseOrgIds": [
              "2SA.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
