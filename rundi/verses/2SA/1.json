              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli amaze gutanga, Dawidi na we atabarutse avuye kugeseza Abamaleki, amaze kabiri i Sikulagi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.1",
            "verseOrgIds": [
              "2SA.1.1"
            ]
          }
        },
