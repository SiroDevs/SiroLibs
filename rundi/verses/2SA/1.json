                "loc": "1SA.31.13"
              },
              "items": [
                {
                  "text": "1 Sam 31:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.35"
              },
              "items": [
                {
                  "text": "2 Sam 3:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "baraboroga, bararira, birirwa ata co batamiye gushitsa ku mugoroba, kubga Sauli n’ umuhungu wiwe Yonatani, no kubg’ abantu b’Uhoraho, n’inzu ya Isirayeli, kuko bicishijwe inkota. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.12",
            "verseOrgIds": [
              "2SA.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi abaza uno muhungu amubikiye, at’ Ur’ uwa hehe? Ati Nd’ umwana w’Umwamaleki yaje ino ar’ inyambukīra. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.13",
            "verseOrgIds": [
              "2SA.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
