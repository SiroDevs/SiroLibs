              "2SA.17.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.35"
              },
              "items": [
                {
                  "text": "2 Sam 15:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Hushayi abarira Sadoki na Abiyatari abaherezi, at’ Inama Ahitofeli yagīriye Abusalomu n’ abakuru b’Abisirayeli n’iyi n’iyi; ariko jeho iyo nabagīriye, nababariye ntya na ntya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.15",
            "verseOrgIds": [
              "2SA.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.28"
              },
              "items": [
                {
                  "text": "2 Sam 15:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero ni mutume kuri Dawidi vuba, mut’ Iri joro nturāre ku majabukiro afata mu bugaragwa, ariko ntihagire ikikubuza kujabuka; muti Kugira ngo ntibakumirane n’abantu bose muri kumwe, mugenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.16",
            "verseOrgIds": [
              "2SA.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.27"
              },
              "items": [
                {
                  "text": "2 Sam 15:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Yonatani na Ahimasi bāri babaye barīkinga i Eni‐rogeli, umuguranokazi akāma aja kubacira agace, na bo bakaja kubibgira umwami Dawidi; kuko batātinyuka gushika ku murwa icese. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.17",
            "verseOrgIds": [
              "2SA.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umwana w’umuhungu arababona, aragenda abibarira Abusalomu; na bo baragenda bihuta bompi, bashika i Bahurimu ku muntu yar’ afise icobo cimbge mu rugo rwiwe co kubīka amazi, bururukirayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.18",
            "verseOrgIds": [
              "2SA.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.2.6"
              },
              "items": [
                {
                  "text": "Yos 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umugore ahitana ikinyambuga, agisasa hejuru ku munwa w’ico cobo, agisanzakw impeke, ntihagira ūbica n’ikanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.19",
            "verseOrgIds": [
              "2SA.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu ba Abusalomu bashikīra nya mugore mu rugo, baramubaza, bati Ahimasi na Yonatani bari hehe? Nya mugore arabishura, ati Bafashe hakurya. Nuko babarondeye, barababura, basubira i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.20",
            "verseOrgIds": [
              "2SA.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamaze kugenda, ba bandi barūrira basokoroka mur’ ico cobo, baragenda babibarira umwami Dawidi; baramubarira, bati Ni muhaguruke mujabuke n’ingoga, kuko Ahitofeli yabagīriye inama izi n’izi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.21",
            "verseOrgIds": [
