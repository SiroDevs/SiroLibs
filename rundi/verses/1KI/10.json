            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni k’umwami Salomo yarusha abami bose bo mw isi ubutunzi n’ubgenge. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.23",
            "verseOrgIds": [
              "1KI.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bihugu vyose vyo mw isi hāhora haza abagomba kubona Salomo, no kwumva ivyo avugishwa n’ubgenge Imana yashize mu mutima wiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese yaza azanye indamukanyo, ar’ ivyakozwe mu mafeza canke mu mazahabu, ar’ ivyambarwa, ar’ ibirwanishwa, ar’ imibavu, ar’ amafarasi, ar’ inyumbu; ni ko vyagenda uk’ umwaka utashe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        }
      ]
