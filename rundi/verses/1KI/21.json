              "items": [
                {
                  "text": "2 Abam 10:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko yandika ivyete mw izina rya Ahabu, abidomakw ikimenyetso ciwe, abirungikira abashingantahe n’abaganwa bābana na Naboti mur’ ico gisagara. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.8",
            "verseOrgIds": [
              "1KI.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yandika mur’ ivyo vyete, aravuga, ati Ni mushinge umusi wo kwisonzesha, mushire Naboti imbere y’abantu; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.9",
            "verseOrgIds": [
              "1KI.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
