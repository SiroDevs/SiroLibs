    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.10",
            "verseOrgIds": [
              "1KI.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abantu bo mur’ ico gisagara, ari bo bashingantahe n’ abaganwa bene ho, babigenza nk’ uko Yezebeli yabatumyeko muri vya vyete yabandikira. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.11",
            "verseOrgIds": [
              "1KI.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.58.4"
              },
              "items": [
                {
                  "text": "Yes 58:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashinga umusi wo kwisonzesha, bashira Naboti imbere y’abantu; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.12",
            "verseOrgIds": [
              "1KI.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.58"
              },
              "items": [
                {
                  "text": "Ivyak 7:58",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "maz’ abo bantu babiri b’inshirukanya baraza bamwicara imbere, bāgiriza Naboti ngaho imbere y’ abantu, bati Naboti yarogose ku Mana no ku mwami. Maze baca bamukūra mu gisagara, bamwicisha amabuye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.13",
            "verseOrgIds": [
              "1KI.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraheza batuma kuri Yezebeli, uti Naboti bamuteye amabuye; yapfuye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.14",
            "verseOrgIds": [
              "1KI.21.14"
            ]
          }
        }
      ]
    },
