                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "riti Va hasi umanuke uje guhūra na Ahabu umwami w’Abisirayeli, aba i Samariya; uramusanga mu ruzabibu rwa Naboti, aramanutse kurushikīra. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.18",
            "verseOrgIds": [
              "1KI.21.18"
            ]
          }
        },
