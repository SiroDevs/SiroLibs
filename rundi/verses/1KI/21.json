          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ijambo ry’Uhoraho riza kuri Eliya w’i Tishubi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.17",
            "verseOrgIds": [
              "1KI.21.17"
            ]
