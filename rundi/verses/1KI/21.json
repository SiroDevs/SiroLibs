              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.14",
            "verseOrgIds": [
              "1KI.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yezebeli yumvise ko Naboti bamuteye amabuye kandi ko yapfuye, abarira Ahabu, ati Haguruka uje gushikīra rwa ruzabibu Naboti w’i Yezireli yanka ko mugura: ntakiriho, yapfuye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.15",
            "verseOrgIds": [
              "1KI.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu yumvise ko Naboti yapfuye, arahaguruka, aramanuka, aja gushikīra rwa ruzabibu rwa Naboti w’i Yezireli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.16",
            "verseOrgIds": [
              "1KI.21.16"
            ]
          }
        }
      ]
    },
