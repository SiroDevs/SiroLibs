            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.6.11"
              },
              "items": [
                {
                  "text": "Ivyak 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.5"
              },
              "items": [
                {
                  "text": "23:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze muzane abantu babiri b’inshirukanya, baje imbere yiwe bamwagirize, bati Warogose ku Mana no ku mwami. Muheze mumujane inyuma y’ igisagara, mumwicishe amabuye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.10",
            "verseOrgIds": [
              "1KI.21.10"
            ]
          }
        }
      ]
