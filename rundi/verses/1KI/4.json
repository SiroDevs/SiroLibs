                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yarusha abandi bantu bose ubgenge, yarusha na Etani Umwezerahi, na Hemani na Kalukoli na Darada, bene Maholi; mbere yaravugangwa mu mahanga yose amukikije. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.31",
            "verseOrgIds": [
              "1KI.4.31"
            ]
          }
        },
