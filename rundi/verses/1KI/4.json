            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko yaganza igihugu cose co hakuno ya rwa ruzi Efurate, uhereye i Tifusa ugashitsa i Gaza, akaganza n’abami bose bo hakuno yarwo, kandi yabana amahoro n’ ibihugu vyose bimukikije; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.24",
            "verseOrgIds": [
              "1KI.4.24"
            ]
          }
        },
