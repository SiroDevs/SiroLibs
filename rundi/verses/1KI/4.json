          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ibimasa cumi vyagaburiwe neza, n’ ibindi mirongwibiri vyirishiriza, n’intama ijana, ukūyemw’ impongo n’ingeregere n’amafumberi, bo n’inkoko zagaburiwe neza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.23",
            "verseOrgIds": [
              "1KI.4.23"
            ]
          }
        },
        {
