                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yigeneye imigani ibihumbi bitatu, n’indirimbo igihumbi na zitanu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.4.32"
            ]
          }
        },
