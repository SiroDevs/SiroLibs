              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyāgaburwa kwa Salomo ku musi ku musi vyar’ ibi: ingero zitwa koro mirongwitatu z’ifu igogōretse, n’ingero mirongwitandatu z’ayandi mafu; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.22",
