            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.8+DEU.3.9+DEU.3.10"
              },
              "items": [
                {
                  "text": "Gus 3:8-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Gebera mwene Uri yatoza ivyo mu gihugu c’i Gileyadi, mu ntāra yar’ iya Sihoni umwami w’Abamori na Ogi umwami w’i Bashani; hār’ umumenyekana umwe gusa yatoza ivyo mur’ ico gihugu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.19",
            "verseOrgIds": [
              "1KI.4.19"
            ]
          }
        }
      ]
    },
