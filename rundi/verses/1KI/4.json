              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Salomo yar’ afise impongore ibihumbi bine z’amafarasi yakwega imikogote yiwe, n’abantu bagendera ku mafarasi ibihumbi cumi na bibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.26",
            "verseOrgIds": [
              "1KI.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
