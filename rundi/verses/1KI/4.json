              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw Imana iha Salomo ubgenge n’ubuhanga bginshi cane, n’ umutima wagutse, nk’ukw isēsero ry’umusenyi wo ku kiyaga ryagutse. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.29",
            "verseOrgIds": [
              "1KI.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
