          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bama bazana na sayiri n’ivyarire vy’amafarasi akwega imikogote n’ayandi yo kwirukako, nk’uko vyashinzwe, bakabizana aho bikwiye kuja.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.28",
            "verseOrgIds": [
