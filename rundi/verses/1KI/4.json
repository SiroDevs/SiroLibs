          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yar’ azi kudondora ivy’ ibiti, uhereye kw isederi y’i Lebanoni ugashitsa kuri ezobu imera ku mazu; yar’ azi no kudondora ivy’ ibikōko n’ ibisīga n’ivyikwega hasi n’amafi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
