                "loc": "JER.28.16"
              },
              "items": [
                {
                  "text": "Yer 28:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.21"
              },
              "items": [
                {
                  "text": "29:21",
                  "type": "text"
                }
              ]
            },
