              "items": [
                {
                  "text": "2 Abam 21:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi ni vyo yanyeretse: ehe rāba, Umwami Imana yar’ ahagaze i ruhande y’uruzitiro rw’ amabuye rwubakishijwe karisho,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.7",
            "verseOrgIds": [
              "AMO.7.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:7",
              "type": "text"
            },
            {
              "text": "karisho n’akagozi karikw akabuye bageresha mu kwubaka nko mu buryo bga nivo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " afise karisho mu ntoke. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.7",
            "verseOrgIds": [
              "AMO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho arambaza, at’ Ubonye iki ga Amosi? Nti Mbonye karisho. Nuk’ Umwami aravuga, ati Rāba, ngira ndekurire karisho hagati mu bantu banje b’Abisirayeli; kandi sinzosubira kwirengagiza ivyabo ukundi: ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.25"
              },
              "items": [
                {
                  "text": "Ita 26:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.8+2KI.15.9+2KI.15.10+2KI.15.11+2KI.15.12"
              },
              "items": [
                {
                  "text": "2 Abam 15:8-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ ibitabo aba Isaka bātavye ku mpinga z’imisozi bizosigara bitamāriwe, n’ahantu hēra h’Abisirayeli hazosangangurwa; kandi nzohagurukira inzu ya Yerobowamu nitwaje inkota.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.9",
            "verseOrgIds": [
              "AMO.7.9"
            ]
          }
        }
      ]
