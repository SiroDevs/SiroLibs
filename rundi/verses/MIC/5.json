        },
        {
          "text": "Ariko wewe, Betelehemu Efurata, nah’ ur’ inkehwa mu bihumbi vy’i Buyuda, muri wewe hazomviramw’ ūzoba segaba mu Bisirayeli; amamo yiwe yahereye kera hose, ibihe n’ibindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 5:3"
