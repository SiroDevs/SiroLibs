              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.17.9"
              },
              "items": [
                {
                  "text": "Yes 17:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.8.14"
              },
              "items": [
                {
                  "text": "Hos 8:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi nzorandura ibisagara vyo mu gihugu cawe, mpomvagurire hasi amaboma yawe yose; ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.11",
            "verseOrgIds": [
              "MIC.5.11"
            ]
          }
        },
        {
