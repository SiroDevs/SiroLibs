            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ igihugu ca Ashuri bazokiririkisha inkota, bo n’igihugu ca Nimurodi uhereye ku mbibe zaco. Nukw azodukiza Umwashuri, ni yaza mu gihugu cacu, akadukandagirira mu rubibe. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ amasigarira ya Yakobo azoba mu moko menshi ababere nk’ikime kivuye k’Uhoraho, nk’urume rutonze ku bgatsi, bitororēra umuntu, canke ngo bitenyenyere abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.5.14"
              },
              "items": [
                {
                  "text": "Hos 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ amasigarira ya Yakobo azoba mu mahanga no mu moko menshi nk’intambge iri mu bikōko vyo mu kibira, canke nk’umugunza wayo uri mu mikuku y’intama: iyo uziciyemwo, urazinyukanyuka, ukazitabagura, ata wo kuzikiza. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.11"
              },
              "items": [
                {
                  "text": "Yes 26:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuboko kwawe n’ukubangurire abarwanizi bawe, kand’ abansi bawe bose ni barandurwe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.9",
            "verseOrgIds": [
              "MIC.5.9"
            ]
          }
        }
      ]
