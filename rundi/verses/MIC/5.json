            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ico gihe, ni k’Uhoraho agize, nzorandura muri wewe amafarasi, mvungavunge imikogote yawe y’intambara; ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.10",
            "verseOrgIds": [
              "MIC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
