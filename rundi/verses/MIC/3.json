              "type": "text"
            }
          ]
        },
        {
          "text": "Ku vy’abavugishwa bazimiza abantu banje, bagasemerera, bati N’amahoro, iyo bagize ico babugunyīra, arik’ ūtagize ico ashira mu kanwa kabo bitegura kumurwanya; ibi ni vyo Uhoraho avuga kuri bo, ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
