              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.18"
              },
              "items": [
                {
                  "text": "Yer 26:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ni co gituma Siyoni hazohinduka ubusīze kubganyu, n’i Yerusalemu hahinduke ibirundo vy’amasakamburira, n’umurwa wubatswekw iyi ngoro uhinduke nk’ ikibira kiri ku mpinga y’umusozi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.12",
            "verseOrgIds": [
              "MIC.3.12"
            ]
          }
