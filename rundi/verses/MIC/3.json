              "items": [
                {
                  "text": "Yer 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ndavuga, nti Ni mwumve se ndabinginze, yemwe bakuru bo mu ba Yakobo, namwe abaganza bo mu b’inzu ya Isirayeli: mbega si mwebge mwari mukwiye kumenya imanza ziroranye? ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.3"
              },
              "items": [
                {
                  "text": "Ezk 34:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yemwe abanka ivyiza mugakunda ibibi; abantu banje mukaborosorako urukoba rwabo, mugaharura inyama ku magufa yabo; ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.14.4"
              },
              "items": [
                {
                  "text": "Zab 14:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi mukarya inyama z’abantu banje, mukababāgak’ urukoba, mukabajanjagura amagufa, mukabatimbagura nk’izo gushira mu nzīhebe, nk’inyama zo gushira mu nkono! ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.17"
              },
              "items": [
                {
                  "text": "Gus 31:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.28"
              },
              "items": [
                {
                  "text": "Imig 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.15"
              },
              "items": [
                {
                  "text": "Yes 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze namwe har’ igihe muzotakambira Uhoraho, ntabishure, mber’ azobahisha mu nyonga hiwe ico gihe, nk’uko namwe mwagize nabi mu vyo mwakoze.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        }
      ]
    },
