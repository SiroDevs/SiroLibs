                {
                  "text": "Hab 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "abubakisha Siyoni amaraso muvishije, n’i Yerusalemu mukahubakisha ibigabitanyo! ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.10",
            "verseOrgIds": [
              "MIC.3.10"
            ]
          }
