          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwumve se ndabinginze, yemwe bakuru bo mu b’inzu ya Yakobo, namwe abaganza bo mu b’inzu ya Isirayeli, mwebge abazinukwa imanza ziroranye, mukagoreka ivyari bibereye vyose; ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.9",
            "verseOrgIds": [
              "MIC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
