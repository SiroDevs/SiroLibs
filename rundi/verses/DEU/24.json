                  "text": "Mrk 1:44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mwitwaririke ivy’ indwara y’imibembe, kugira ngo mugire umwete wo kwitondera no gushitsa ivyo abaherezi ari bo Balewi bazobigisha vyose; nk’ukw abo nabibageze, az’ abe ari ko namwe muvyitondera, mubishitse. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
