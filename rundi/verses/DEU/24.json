            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni hagira uwiba umuntu w’i wabo w’Umwisirayeli, akamujana, akamugira umuja cank’ akamushōra, bakamumufatana; uwo musuma aze yicwe: ukw az’ abe ari ko mukūra ikibi hagati muri mwebge.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.7",
            "verseOrgIds": [
              "DEU.24.7"
            ]
          }
        }
