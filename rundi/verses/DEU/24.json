              "items": [
                {
                  "text": "Mrk 10:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ni yarongora umugeni, hanyuma ntamushime, kuko har’ igiteye isoni yamubonyeko, amwandikire icete co kuvāvānura, akimuhe, amwirukane mu rugo rwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni yamara kuva mur’ urwo rugo, ashobora kwābīrwa n’uwundi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.2",
            "verseOrgIds": [
              "DEU.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uwo mugabo wa kabiri ni yamwanka, akamwandikira icete co kuvāvānura, akamwirukana mu rugo rwiwe, cank’ uwo mugabo wa kabiri yamwābiriye agapfa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.3",
            "verseOrgIds": [
              "DEU.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.1"
              },
              "items": [
                {
                  "text": "Yer 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "umugabo wiwe wa mbere yamwirukanye ntaz’ amugarukane, kuko yamaze kwononekara; kukw ivyo ar’ ikizira k’Uhoraho; ntimuze mukwegere icaha igihugu Uhoraho Imana yanyu ibaha kw ishamvu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        }
      ]
    },
