            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu arongoye vuba ntakwiye kuja mu ntambara, canke ngw akoreshwe igikorwa ic’ ari co cose; ariko bamureke umwaka wose, anezereze umugore wiwe yarongoye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
