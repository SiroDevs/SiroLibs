              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze hagire umuntu atwara urusyo rw’uwundi cank’ ingasire kw ingwati y’umwenda, kuko yoba atwaye amagara y’umuntu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
