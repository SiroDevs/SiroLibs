                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugabo ni yagira abagore babiri, umwe akaba inkundwakazi, uwundi akaba intabga, kandi bompi yabavyayeko, umuhungu w’imfura akaba uw’ intabga; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.15",
            "verseOrgIds": [
              "DEU.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.11.19+2CH.11.20+2CH.11.21+2CH.11.22"
              },
              "items": [
                {
                  "text": "2 Ngo 11:19-22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni yagera kuraga, ntaz’ ahindure umwana w’inkundwakazi kuba uw’ imfura, mu gishingo c’uw’ intabga, kand’ ari we mfura koko. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.16",
            "verseOrgIds": [
              "DEU.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 21:17"
          },
          "items": [
