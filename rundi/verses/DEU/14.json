              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.10"
              },
              "items": [
                {
                  "text": "Gus 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.5+DEU.12.6+DEU.12.7"
              },
              "items": [
                {
                  "text": "12:5-7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikigiracumi c’amasaka yanyu, n’ica vino yanyu, n’ic’ amavuta ya elayo yanyu, n’ivy’ uburiza bgo mu masho yanyu, n’ ivyo mu mikuku yanyu, muze mubirīre imbere y’Uhoraho Imana yanyu, ahantu azoba yaratoranije ngw ahashire izina ryiwe; kugira ngo mwige kwubaha Uhoraho Imana yanyu ibihe vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.23",
            "verseOrgIds": [
              "DEU.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.21"
              },
              "items": [
                {
                  "text": "Gus 12:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ah’ urugendo ruzoba rurerure, rukabananira, ntimushobore kubishikanayo, igihe Uhoraho Imana yanyu azoba abahaye umugisha, kukw aho hantu azoba yaratoranije ngw ahashire izina ryiwe hazoba hababereye kure; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "muze mubigure amahera, muyatekere, mugende aho hantu Uhoraho Imana yanyu azoba yaratoranije: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.25",
            "verseOrgIds": [
              "DEU.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "mushike muyagure ico mwumva mugomba cose, ar’ inka, ar’ intama, ari vino, ar’ inzoga, ar’ ikindi kintu cose mwumva mugomba; muheze mubirīre ngaho nyene imbere y’ Uhoraho Imana yanyu, mubisangire n’abo mu ngo zanyu, munezeranwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.20"
              },
              "items": [
                {
                  "text": "Guh 18:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.19"
              },
              "items": [
                {
                  "text": "Gus 12:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Abalewi baba muri mwebge ntimuze mupfe uko mubafashe, kukw ata mugabane cank’ ishamvu bafise muri mwebge.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.27",
            "verseOrgIds": [
              "DEU.14.27"
            ]
          }
        }
