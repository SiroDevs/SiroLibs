              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku mpera y’umwaka wose ugira gatatu muze mwame mukūra ikigiracumi ku vyo mwejeje vyose mur’ uwo mwaka, mubikoranirize i wanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.28",
            "verseOrgIds": [
              "DEU.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
