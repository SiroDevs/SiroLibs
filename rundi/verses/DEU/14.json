            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze hagire ikintu na kimwe cīpfiriye murya; ariko mushobora kugiha uwo mu nyambukīra aba i wanyu, akaba ari we akirya; canke mushobora kukigura n’umunyamahanga; ariko mweho mur’ ihanga ryera ryarobanuriwe Uhoraho Imana yanyu. Ntimuze mutekeshe umwagazi w’ impene amata ya nyina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        }
      ]
    },
