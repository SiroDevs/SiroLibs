        },
        {
          "text": "Ivyagezwe vyose mbagera uyu musi muze muvyitondere, mubishitse, kugira ngo mubone kubaho, mugwire, kugira ngo mwinjire igihugu Uhoraho yarahiye ba sogokuruza banyu kw azokibaha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.1",
            "verseOrgIds": [
              "DEU.8.1"
            ]
          }
        },
        {
          "name": "verse",
