                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.19"
              },
              "items": [
                {
                  "text": "Ivyah 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwiye kumenya mu mitima yanyu yuk’ Uhoraho Imana yanyu abahana nk’uk’ umuntu ahana umwana wiwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mwitondere ivyagezwe vy’Uhoraho Imana yanyu, mugendere mu nzira ziwe, mumwubahe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.6",
            "verseOrgIds": [
              "DEU.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ Uhoraho Imana yanyu abajanye mu gihugu ciza, n’igihugu kirimw’ imigezi n’amariba n’amasōko, vyatobotse mu myonga no ku misozi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.7",
            "verseOrgIds": [
              "DEU.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’igihugu kibamw’ ingano na sayiri n’imizabibu n’imisukoni n’amakomamanga; n’igihugu kibamw’ imyelayo n’ubūki; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.8",
            "verseOrgIds": [
              "DEU.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’igihugu muzokenukiramw’ ivyo kurya, ntimugire ico mugikeneramwo; n’ igihugu kirimw’ amabuye y’ubutare, n’imisozi mwoshobora kwimbamw’ imiringa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.9",
            "verseOrgIds": [
              "DEU.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzokwama mu gahimbo, mushimire Uhoraho Imana yanyu igihugu ciza yabahaye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
            "verseOrgIds": [
              "DEU.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
