            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muze mwibuke urugendo rwose rwo mu bugaragwa Uhoraho Imana yanyu yabarōngōyemw’ iyi myaka ukw ari mirongwine; kugira ngw abacishe bugufi, abagerageze, amenye ibiri mu mitima yanyu, yuko muzokwitondera ivyagezwe vyiwe canke ko mutazovyitondera. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.2",
            "verseOrgIds": [
              "DEU.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
