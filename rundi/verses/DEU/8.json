                "loc": "2SA.7.14"
              },
              "items": [
                {
                  "text": "2 Sam 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.11"
              },
              "items": [
                {
                  "text": "Imig 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.12"
              },
              "items": [
                {
                  "text": "12",
