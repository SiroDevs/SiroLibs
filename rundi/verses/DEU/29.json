                  "text": "79:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho ntazokwemera kumuharira, arik’ uburake bgiwe n’ifūhe ryiwe bizopfūndūka nk’umwotsi kur’ uyo muntu, imivumo yose yanditswe mur’ iki gitabo imurundaneko, kand’ Uhoraho azozimiriza izina ryiwe musi y’ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.20",
            "verseOrgIds": [
              "DEU.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho azomutandukanya n’ imiryango yose y’Abisirayeli, ngw amutērēre ivyago bihwanye n’ imivumo yose yo mw isezerano ryanditswe mur’ iki gitabo c’ ivyagezwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.21",
            "verseOrgIds": [
              "DEU.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ urunganwe ruzoza hanyuma, ari bo bana banyu bazokura babakurikiye, bo n’ umunyamahanga azova mu gihugu ca kure, ni babona ivyago vyabaye mur’ ico gihugu n’indwara Uhoraho yagiteje, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.22",
            "verseOrgIds": [
              "DEU.29.22"
            ]
          }
        },
