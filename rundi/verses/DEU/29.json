            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’abana banyu, n’abagore banyu, n’abanyamahanga baba mu nsago zanyu, uhereye ku mushenyi wanyu ukageza ku muvomyi; ",
          "type": "text",
          "attrs": {
