          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bazobishura, bati N’uko bāretse isezerano ry’Uhoraho, Imana ya ba sekuruza, iryo yari yasezeranye na bo, igihe yabakūra mu gihugu ca Egiputa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.25",
            "verseOrgIds": [
              "DEU.29.25"
            ]
          }
        },
