              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakagenda bagasaba izindi mana, bakazisenga, ar’ imana batari bigeze kumenya, izo Uhoraho atābashingiye. ",
          "type": "text",
          "attrs": {
