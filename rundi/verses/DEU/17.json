            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuze mugire imasa cank’ intama muzanira Uhoraho Imana yanyu kw ikimazi birikw agasembga cank’ igitosekaye cose, kukw ico ar’ umuziro k’Uhoraho Imana yanyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.1",
            "verseOrgIds": [
              "DEU.17.1"
            ]
          }
        }
