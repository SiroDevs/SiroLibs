              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.19"
              },
              "items": [
                {
                  "text": "Gus 4:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.31"
              },
              "items": [
                {
                  "text": "Yer 7:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "akagenda agasaba izindi mana, akazisenga, ari nk’izuba, cank’ ukwezi, cank’ inyenyeri, ari zo ngabo zose zo kw ijuru, kand’ ar’ ivyo ntabageze; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.3",
            "verseOrgIds": [
              "DEU.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukabibarirwa; mumaze kuvyumva muheze mugire umwete wo kubibariritsa; maze ni mwasanga ar’ ivy’ ukuri bidakekeranywa, yuk’ ubuyobe bungana burtyo bukorerwa mu Bisirayeli, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.4",
            "verseOrgIds": [
              "DEU.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.25"
              },
              "items": [
                {
                  "text": "Yos 7:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "muce muzana uwo mugabo cank’ uwo mugore, yakoze ico kintu kibi, mumushikane kw irembo ry’igisagara canyu, mumwicishe amabuye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.5",
            "verseOrgIds": [
              "DEU.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
