              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaboko y’abamwagīrīje az’ abe ari yo atangura kumwica, maze habone gukurikirako n’ abandi bantu bose. Ukw az’ abe ari ko mukūra ikibi hagati muri mwebge.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.7",
            "verseOrgIds": [
              "DEU.17.7"
            ]
          }
        }
      ]
