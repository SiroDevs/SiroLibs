              "items": [
                {
                  "text": "1 Sam 8:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwamara gushika mu gihugu Uhoraho Imana yanyu abaha, mukacegukira mukakibamwo; mukiyumvira, muti Reka twishirireh’ umwami wo kutuganza, nk’uko bimeze mu yandi mahanga yose adukikije; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.14",
            "verseOrgIds": [
              "DEU.17.14"
            ]
          }
        },
        {
          "name": "verse",
