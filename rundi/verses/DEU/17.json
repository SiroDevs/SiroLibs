                  "text": "Gus 13:6-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri mwebge, mu bisagara vyanyu vyose Uhoraho Imana yanyu azoba yābahaye, ni haboneka umugabo cank’ umugore akora ico Uhoraho Imana yanyu abona kw ari kibi, co kuva mw isezerano ryiwe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.2",
            "verseOrgIds": [
              "DEU.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 17:3"
          },
          "items": [
