              "type": "tag",
              "attrs": {
                "loc": "JHN.8.17"
              },
              "items": [
                {
                  "text": "Yoh 8:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.28"
              },
              "items": [
                {
                  "text": "Heb 10:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu mu kw apfa, aze yicishwe n’ ivyabona bibiri canke bitatu bimwagirije; arikw icabona kimwe ntikize cagirize umuntu ngo yicwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.6",
            "verseOrgIds": [
              "DEU.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.14"
              },
              "items": [
                {
                  "text": "Lew 24:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.13.5"
              },
              "items": [
                {
                  "text": "Gus 13:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
