                  "text": "Yer 30:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "umwami muzoshiraho ntaz’ abure kuba uwo Uhoraho Imana yanyu azotoranya; uwo mwami muzoshiraho wo kubaganza az’ abe uwo mu b’i wanyu; ntimuze mushireh’ umunyamahanga ngw abe ari we abaganza, atar’ uwo mu b’i wanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.15",
            "verseOrgIds": [
              "DEU.17.15"
            ]
          }
        },
