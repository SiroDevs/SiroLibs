              "items": [
                {
                  "text": "Hos 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umuntu ni yibona ku muherezi, ntamwumvire, kand’ ari we ahagarara ngaho nyene imbere y’Uhoraho Imana yanyu ngw amuhereze, canke ntiyumvire uwo mucamanza, uwo muntu baze bamwice; ukw abe ari ko mukūra ikibi muri mwebge Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.12",
            "verseOrgIds": [
              "DEU.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu bose bazovyumva, bace batinya, ntibongere kwibona ben’ ukwo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.13",
            "verseOrgIds": [
              "DEU.17.13"
            ]
          }
        }
      ]
    },
