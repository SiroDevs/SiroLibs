            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uze wibuke yuko nawe wari mu buja mu gihugu ca Egiputa, Uhoraho Imana yawe akakugobōtora: ni co gitumye uyu musi ndakugera ivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.15",
            "verseOrgIds": [
              "DEU.15.15"
            ]
          }
        },
