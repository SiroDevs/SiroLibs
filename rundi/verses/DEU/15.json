            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uw’i wanyu w’Umuheburayo canke w’Umuheburayokazi, ni hagira uwo yibunzako ngw amugure, wewe umuguze az’ akujakarire imyaka itandatu; maze mu w’ugira indwi uz’ umurekure, yībēre mu mwidegemvyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.12",
            "verseOrgIds": [
