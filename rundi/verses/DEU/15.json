              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho Imana yanyu azobaha umugisha nk’uko yabasezeraniye; amahanga menshi azoza kubagurāna, ariko mweho ntimuzoja kuyagurāna; kandi muzotwara amahanga menshi, ariko yo ntazobatwara.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        }
      ]
