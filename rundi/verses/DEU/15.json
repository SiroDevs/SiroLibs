            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uk’ umwaka utashe, muze mubirīre ahantu Uhoraho azotoranya, mur’ imbere yiwe nyene, Uhoraho Imana yanyu, mwe n’ abo mu ngo zanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
