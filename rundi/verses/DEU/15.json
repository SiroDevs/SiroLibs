                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw abakene ata ho bazobura kubaho mu gihugu; ni co gitumye mbabarira, nti Ntimuze mubure kuramvurira ukuboko umukene w’ umworo wo mu b’i wanyu muri mu gihugu canyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.11",
