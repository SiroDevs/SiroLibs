              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuze mubure kumuha, kandi ni mwamuha ntibize bibababaze; kukw ivyo bizotuma Uhoraho Imana yanyu abaha umugisha mu bikorwa vyanyu vyose no ku co muzoba mukoze cose. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.10",
            "verseOrgIds": [
              "DEU.15.10"
            ]
          }
        },
