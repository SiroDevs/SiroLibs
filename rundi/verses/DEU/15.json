                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni hagira ikigira agasembga, ari nko gucumbagira canke guhuma, cank’ akandi gasembga kabi ak’ ari ko kose, ntimuze mugishikanire Uhoraho Imana yanyu kw ikimazi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
