              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni wamurekura ngw agire umwidegemvyo, ntuz’ umurekure imbokoboko; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.13",
            "verseOrgIds": [
              "DEU.15.13"
            ]
