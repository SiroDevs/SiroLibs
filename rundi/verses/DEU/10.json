                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko rero, Uhoraho yarangirije umutima kuri ba sogokuruza, arabakunda, atoranya n’uruvyaro rwabo ruzoza hanyuma, ni rwo mwebge, abasumbisha ayandi mahanga yose, nk’uko biri na bugingo n’ubu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.15",
            "verseOrgIds": [
              "DEU.10.15"
            ]
          }
        },
