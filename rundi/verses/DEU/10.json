        },
        {
          "text": "Ereg’ Uhoraho Imana yanyu ni we Nyen’ ijuru, mbere ni Nyen’ ijuru risumba ayandi, bo n’isi n’ibirimwo vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.14",
            "verseOrgIds": [
