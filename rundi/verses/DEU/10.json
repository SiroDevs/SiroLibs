              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "no kwitondera ivyagezwe vyiwe n’ amabgirizwa yiwe, ivyo mbageze uyu musi kugira ngo mumererwe neza? ",
          "type": "text",
          "attrs": {
