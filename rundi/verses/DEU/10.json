            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.21.5"
              },
              "items": [
                {
                  "text": "Gus 21:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ ico gihe Uhoraho arobanura umuryango w’Abalewi kugira ngo barerure ya sandugu y’ isezerano ryiwe, kandi ngo bahagarare imbere yiwe bamuhereze, bahezagire n’abantu mw izina ryiwe, nk’uko biri na bugingo n’ ubu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 10:9"
          },
          "items": [
