            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero mukunde inyambukīra, kuko namwe mwar’ inyambukīra mu gihugu ca Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.19",
            "verseOrgIds": [
