                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye Abalewi batagira umugabane cank’ ishamvu muri bene wabo; Uhoraho ni we shamvu yabo, nk’uko yababgiye, ari we Uhoraho Imana yanyu.)",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
