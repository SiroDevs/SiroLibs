            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icira imanza impfuvyi n’abapfakazi, ikunda inyambukīra, ikayigaburira, ikayambika. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.18",
