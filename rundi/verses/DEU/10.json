              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko namaze kur’ uwo musozi imisi mirongwine n’amajoro mirongwine, nk’ubga mbere: Uhoraho no mur’ ico gihe na co aranyumvira, ntiyabarandura. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.10",
            "verseOrgIds": [
              "DEU.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
