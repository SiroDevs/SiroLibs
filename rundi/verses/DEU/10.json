              "items": [
                {
                  "text": "Kuv 32:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.33.1"
              },
              "items": [
                {
                  "text": "33:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho arambarira, ati Va hasi, ufate urugendo, uje aba bantu imbere, kugira ngo binjire igihugu narahiye ba sekuruza ko nzokibaha, bacegukire.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.11",
            "verseOrgIds": [
              "DEU.10.11"
            ]
          }
        }
      ]
    },
