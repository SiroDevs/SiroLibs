          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega kuri mwebge ni ho ijambo ry’Imana ryandurutse? Canke ryashitse kuri mwebge mwenyene?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.36",
            "verseOrgIds": [
              "1CO.14.36"
            ]
          }
        }
