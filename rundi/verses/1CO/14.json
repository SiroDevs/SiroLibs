            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni hagira umuntu yiyumvira kw ar’ ūvugishwa n’Imana, canke kw ar’ uw’ impwemu, amenye ivyo mbandikiye yukw ar’ icagezwe c’Umwami wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.37",
            "verseOrgIds": [
              "1CO.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
