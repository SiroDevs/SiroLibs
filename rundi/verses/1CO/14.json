          ]
        },
        {
          "text": "Nuko, bene Data, mwifuze cane kuvugishwa n’Imana, kandi ntimubuze kuvuga indimi zitamenyekana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.39",
