              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "abagore bacereze mw ishengero, kuko batemererwa kuvuga. Ariko baganzwe, nk’ukw ivyagezwe na vyo bivuga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.34",
            "verseOrgIds": [
              "1CO.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni hagira ico bagomba kwiga, babarize abagabo babo i muhira, kuko biteye isoni k’umugore avuga mw ishengero. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.35",
            "verseOrgIds": [
              "1CO.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
