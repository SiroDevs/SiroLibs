                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ubgenge bg’iyi si ar’ ubupfu ku Mana. Kuko handitswe, ngw Itegesha abanyabgenge ubugunge bgabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.19",
            "verseOrgIds": [
              "1CO.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
