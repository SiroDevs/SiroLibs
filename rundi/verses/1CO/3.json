            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihakagire umuntu yihenda; umuntu wo muri mwebge ni yiyumvira kw ar’ umunyabgenge ku vy’iki gihe, abe igipfu, kugira ngw abone kuba umunyabgenge. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.18",
