            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.19"
              },
              "items": [
                {
                  "text": "1 Kor 6:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.16"
              },
              "items": [
                {
                  "text": "2 Kor 6:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega ntimuzi yuko mur’ urusengero rw’Imana, kandi ko Mpwemu w’Imana aba muri mwebge? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.16",
            "verseOrgIds": [
              "1CO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ni yonona urusengero rw’Imana, Imana izomurandura; kuk’ urusengero rw’Imana ar’ urwera, kand’ urwo rusengero ni mwebge.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.17",
            "verseOrgIds": [
              "1CO.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
