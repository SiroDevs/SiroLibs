                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubganje, bene Data, sinashoboye kubabgira nk’ab’ impwemu, ariko nababgiye nk’abaganzwa n’akameremere k’imibiri yabo, nk’abana b’inzoya bo muri Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.1",
            "verseOrgIds": [
              "1CO.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 3:2"
          },
          "items": [
