              "1CO.3.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.10"
              },
              "items": [
                {
                  "text": "1 Kor 15:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.15"
              },
              "items": [
                {
                  "text": "2 Pet 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’uko nahawe ubuntu n’Imana, nashizeh’ itanguriro, nk’umwubakisha mukuru w’ubgenge, uwundi yubakako. Arik’ umuntu wese ni yiyubare uko yubakako. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.10",
            "verseOrgIds": [
              "1CO.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.4+1PE.2.5+1PE.2.6"
              },
              "items": [
                {
                  "text": "1 Pet 2:4-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw irindi tanguriro ata muntu ashobora kurishiraho, atar’ iryashizweho, ni ryo Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.11",
            "verseOrgIds": [
              "1CO.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw iryo tanguriro, umuntu ni yaryubakishakw izahabu, cank’ ifeza, cank’ amabuye y’igiciro kinini, cank’ ibiti, cank’ ubgatsi, cank’ ibishakashaka, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.12",
            "verseOrgIds": [
              "1CO.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.5"
              },
              "items": [
                {
                  "text": "1 Kor 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.1.8"
              },
              "items": [
                {
                  "text": "2 Tes 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "igikorwa c’umuntu wese kizoseruka. Wa musi uzogiserura, kuk’ uzohishuranwa n’umuriro, kand’ igikorwa c’umuntu wese uwo muriro uzokigeza ico kirimwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.13",
            "verseOrgIds": [
              "1CO.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igikorwa c’umuntu, ico yubatse kur’ iryo tanguriro, ni carama, azohabga ingero; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.14",
            "verseOrgIds": [
              "1CO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "igikorwa c’umuntu ni casha, azobura ingero, yamara ubgiwe azokira, ariko nk’uwokowe mu muriro.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.15",
            "verseOrgIds": [
              "1CO.3.15"
            ]
          }
        }
      ]
    },
    {
