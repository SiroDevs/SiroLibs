                  "text": "Zab 94:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ng’Uhoraho arazi ivyiyumviro vy’abanyabgenge, kandi ko bitagira ikimazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.20",
            "verseOrgIds": [
              "1CO.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ntihakagire umuntu yirata abantu. Kuko vyose ar’ ivyanyu: ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.21",
            "verseOrgIds": [
              "1CO.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ari Paulo, canke Apolo, canke Kefa, cank’ isi, cank’ ubugingo, cank’ urupfu, cank’ ibiriho, cank’ ibizoba, vyose n’ivyanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.22",
            "verseOrgIds": [
              "1CO.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
