                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni hagira umuntu ababgira, at’ Ico n’icāterekerejwe: ntimukakirye, kubg’ uyo abiseruye, no kubg’ ijwi ryo mu mutima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.28",
            "verseOrgIds": [
              "1CO.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umutima mvuze s’uwawe, n’uwa wa wundi. N’iki gituma ukwidegemvya kwanje guhinyurwa n’umutima w’uwundi? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.29",
            "verseOrgIds": [
