              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murābe Abisirayeli ku rukoba: abarya ikimazi, mbega ntibasangira n’igicaniro? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.18",
