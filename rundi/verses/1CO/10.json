              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wo mu batizera ni yabahamagara, mukagomba kugenda, ico bazoshira imbere yanyu cose, mube mukirya, ata co mubajije, kubg’ ijwi ryo mu mutima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.27",
            "verseOrgIds": [
