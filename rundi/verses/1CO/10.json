            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw isi ar’iy’ Uhoraho, n’ibiyuzuye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.26",
