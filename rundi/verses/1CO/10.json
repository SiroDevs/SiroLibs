            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vyose turavyemererwa, arikw ibitugirira ikimazi si vyose. Vyose turavyemererwa, arikw ivyubaka si vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.23",
