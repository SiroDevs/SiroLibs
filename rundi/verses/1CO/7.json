                "loc": "ROM.7.2"
              },
              "items": [
                {
                  "text": "Rom 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugore ahambīrirwa ku mugabo wiwe akiriho; arikw iy’ umugabo apfuye, nta kimubuza gucūrwa n’uw’ agomba, mugabo rero, ar’ ūri mu Mwami wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.39",
            "verseOrgIds": [
              "1CO.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw iy’ agumye ukw ari, ni ho arushiriza guhirwa, uko niyumvira kubganje: kandi ngira ngo nanje mfise Mpwemu w’Imana.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.40",
            "verseOrgIds": [
              "1CO.7.40"
            ]
          }
        }
      ]
