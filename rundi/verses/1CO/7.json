              "1CO.7.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.20"
              },
              "items": [
                {
                  "text": "1 Kor 7:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko gusa, uk’ Umwami wacu yagabiye umuntu wese, kand’ ukw Imana yamuhamagaye, abe ari kw amera. Ni ko ngera mu mashengero yose. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.17",
            "verseOrgIds": [
              "1CO.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega harih’ umuntu yahamagawe yarakebge? Ntagacike nk’ūtakebge. Harih’ umuntu yahamagawe atākebge? Ntagakebge. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.18",
            "verseOrgIds": [
              "1CO.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.6"
              },
              "items": [
                {
                  "text": "Gal 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.15"
              },
              "items": [
                {
                  "text": "6:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.25"
              },
              "items": [
                {
                  "text": "Rom 2:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukebga nta co kumaze, no kudakebga nta co kumaze, arikw ikigira ico kimaze n’ukwitondera ivyagezwe n’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.19",
            "verseOrgIds": [
              "1CO.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese, uko yar’ ari mw ihamagarwa ryiwe, abigumemwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.20",
            "verseOrgIds": [
              "1CO.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahamagawe ur’ umugurano? Ntibikubabaze. Ariko, namba bishoboka k’ucika uwidegemvya, ubihitemwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.21",
            "verseOrgIds": [
              "1CO.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.6"
              },
              "items": [
                {
                  "text": "Ef 6:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.16"
              },
              "items": [
                {
                  "text": "Flm 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwahamagawe n’Umwami wacu ar’ umugurano, aba acitse uwidegemvya acunguwe n’Umwami. Ni ko, uwahamagawe n’Umwami ar’ uwidegemvya, aba acitse umugurano wa Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.22",
            "verseOrgIds": [
              "1CO.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaguzwe igiciro, ntimukabe abagurano b’abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.23",
            "verseOrgIds": [
              "1CO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Data, umuntu wese uko yar’ ari aho yahamagarwa, akugumanemwo n’Imana.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.24",
            "verseOrgIds": [
              "1CO.7.24"
            ]
          }
        }
      ]
    },
    {
