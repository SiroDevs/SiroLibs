          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le nto yaba yisono, ngokuba abantu bahamba ukukhuleka phambi kwayo kwaDani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.30",
            "verseOrgIds": [
              "1KI.12.30"
            ]
          }
        }
      ]
