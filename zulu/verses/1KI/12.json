          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJerobowamu wathi enhliziyweni yakhe: “Manje umbuso uzakubuyela endlini kaDavide.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.26",
            "verseOrgIds": [
              "1KI.12.26"
            ]
          }
        }
