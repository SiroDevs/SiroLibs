          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Israyeli wayihlubuka indlu kaDavide kuze kube namuhla.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.19",
            "verseOrgIds": [
              "1KI.12.19"
