          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza nendlu ephakemeyo, wamisa abapristi besizwe esiphansi, ababengesibo abantwana bakwaLevi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.31",
