          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi wonke u-Israyeli esezwile ukuthi uJerobowamu ubuyile, bathumela bambizela ebandleni, bambeka inkosi phezu kuka-Israyeli wonke; akubangakho owalandela indlu kaDavide, kuphela isizwe sakwaJuda sodwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.20",
            "verseOrgIds": [
