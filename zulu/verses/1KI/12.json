          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khuluma kuRehobowamu indodana kaSolomoni, inkosi yakwaJuda, nakuyo yonke indlu yakwaJuda noBenjamini, nakuyo insali yabantu, uthi:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.23",
            "verseOrgIds": [
