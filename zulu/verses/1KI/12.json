          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJerobowamu wakha iShekemi ezintabeni zakwa-Efrayimi, wahlala kulo; waphuma lapho, wakha iPnuweli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.25",
