          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabeka elinye eBethele, nelinye kwaDani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.29",
            "verseOrgIds": [
              "1KI.12.29"
            ]
          }
        }
      ]
