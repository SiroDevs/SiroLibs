          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma laba bantu bekhuphuka ukuyohlabela endlini kaJehova eJerusalema, inhliziyo yalaba bantu iyakubuyela enkosini yabo, kuRehobowamu, inkosi yakwaJuda, bangibulale, bephindelela kuRehobowamu inkosi yaseGibhithe. Juda, hamba. Juda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        }
      ]
    },
