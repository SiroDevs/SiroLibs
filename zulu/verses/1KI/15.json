          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona ukulwa phakathi kukaRehobowamu noJerobowamu zonke izinsuku zokuhamba kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.6",
