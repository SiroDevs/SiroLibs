          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahamba ezonweni zonke zikayise azenza ngaphambi kwakhe; inhliziyo yakhe yayingaphelele kuJehova uNkulunkulu wakhe njengenhliziyo kaDavide uyise.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.3",
            "verseOrgIds": [
              "1KI.15.3"
            ]
          }
        }
      ]
    },
    {
