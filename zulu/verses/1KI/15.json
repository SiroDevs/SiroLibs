              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka weshumi nesishiyagalombili wenkosi uJerobowamu indodana kaNebati u-Abiya waba yinkosi kwaJuda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.1",
