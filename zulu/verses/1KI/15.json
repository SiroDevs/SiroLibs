          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye izindaba zika-Abiya nakho konke akwenzayo angithi kulotshiwe encwadini yezindaba zemihla ngemihla yamakhosi akwaJuda na? Kwakukhona ukulwa phakathi kuka-Abiya noJerobowamu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.7",
            "verseOrgIds": [
              "1KI.15.7"
            ]
          }
        }
      ]
    },
    {
