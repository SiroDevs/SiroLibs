          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukhona isivumelwano phakathi kwami nawe naphakathi kukababa noyihlo; bheka, ngikuthumele isipho sesiliva negolide; woza wephule isivumelwano sakho noBahasha, inkosi yakwa-Israyeli, ukuze asuke kimi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.19",
            "verseOrgIds": [
              "1KI.15.19"
            ]
