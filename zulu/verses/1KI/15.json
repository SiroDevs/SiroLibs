          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.3",
            "verseOrgIds": [
              "1KI.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngenxa kaDavide uJehova uNkulunkulu wakhe wamnika isibani eJerusalema ukuze avuse indodana yakhe ngemva kwakhe futhi aqinise iJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.4",
            "verseOrgIds": [
              "1KI.15.4"
            ]
          }
        }
      ]
    },
    {
