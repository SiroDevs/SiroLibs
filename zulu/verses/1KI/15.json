          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabusa eJerusalema iminyaka emithathu. Igama likanina lalinguMaga, indodakazi ka-Abisalomu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.2",
            "verseOrgIds": [
              "1KI.15.2"
