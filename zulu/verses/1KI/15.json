          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abiya wayeselala koyise; bammbela emzini kaDavide; u-Asa indodana yakhe waba yinkosi esikhundleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.8",
            "verseOrgIds": [
              "1KI.15.8"
