            "number": "5",
            "style": "v",
            "sid": "1KI 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uDavide wenza okulungile emehlweni kaJehova, akaphambukanga kukho konke amyale ngakho zonke izinsuku zokuhamba kwakhe, kuphela endabeni ka-Uriya umHeti.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.5",
            "verseOrgIds": [
              "1KI.15.5"
            ]
          }
        }
      ]
    },
    {
