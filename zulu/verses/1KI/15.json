              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabusa iminyaka engamashumi amane nanye eJerusalema. Igama likanina lalinguMaga, indodakazi ka-Abisalomu.",
          "type": "text",
          "attrs": {
