          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UBeni Hadadi wayilalela inkosi u-Asa, wathuma izinduna zempi ayenazo ukulwa nemizi yakwa-Israyeli, wachitha i-Ijoni, neDani, ne-Abela Beti Mahaga, nayo yonke iShineroti, nalo lonke izwe lakwaNafetali.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.20",
            "verseOrgIds": [
