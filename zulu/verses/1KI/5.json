          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yayala ukuba balethe amatshe amakhulu, amatshe abizayo namatshe abaziweyo ukuze kubekwe isisekelo sendlu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.17",
            "verseOrgIds": [
              "1KI.5.17"
