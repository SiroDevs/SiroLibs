        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinceku zami ziyakwehlisela eLebanoni ziyise olwandle; ngiyowawelisa ulwandle entanta, ngiwayise endaweni oyongibonisa yona, ngiwenze ageleze aphume lapho, wena uwamukele; futhi uzongiqedela. Isifiso, ngokupha abendlu yami ukudla.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.9",
            "verseOrgIds": [
              "1KI.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
