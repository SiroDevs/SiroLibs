            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, ngiqonde ukwakhela igama likaJehova uNkulunkulu wami indlu, njengalokho uJehova wakhuluma kuDavide ubaba ngokuthi: ‘Indodana yakho engiyayibeka esihlalweni sakho sobukhosi esikhundleni sakho iyokwakhela indlu yami igama.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
