            "sid": "1KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHiramu wayesenika uSolomoni imisedari nemisayipuresi njengakho konke ukufisa kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.10",
            "verseOrgIds": [
              "1KI.5.10"
            ]
          }
        }
