          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa manje uJehova uNkulunkulu wami unginikile ukuphumula nxazonke, kangangokuthi akukho sitha noma okubi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.4",
            "verseOrgIds": [
              "1KI.5.4"
            ]
          }
        }
      ]
    },
    {
