          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "USolomoni wayenabagundi abayizinkulungwane ezingamashumi ayisithupha nabagundi bezinwele eziyizinkulungwane ezingamashumi ayisishiyagalombili ezintabeni;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.15",
            "verseOrgIds": [
              "1KI.5.15"
            ]
          }
        }
