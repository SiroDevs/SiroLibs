          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "USolomoni wamnika uHiramu amakhora ayizinkulungwane ezingamashumi amabili kakolweni abe ngukudla kwendlu yakhe namakhora angamashumi amabili amafutha acwengekileyo; kanjalo uSolomoni wanika uHiramu iminyaka ngeminyaka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.11"
            ]
          }
        }
      ]
