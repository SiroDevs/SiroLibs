            "sid": "1KI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyazi nina ukuthi ubaba uDavide wayengenakulakhela igama likaJehova uNkulunkulu wakhe indlu ngenxa yezimpi ezazimzungezile, uJehova waze wayibeka phansi kwamathe ezinyawo zakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.3"
            ]
          }
        }
      ]
    },
    {
