            "number": "13",
            "style": "v",
            "sid": "1KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uSolomoni yasibutha izisebenzi kuIsrayeli wonke; intela yayiyizinkulungwane ezingamashumi amathathu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.13",
            "verseOrgIds": [
              "1KI.5.13"
            ]
          }
        }
      ]
    },
    {
