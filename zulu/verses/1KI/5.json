            "sid": "1KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHiramu esezwile amazwi kaSolomoni wathokoza kakhulu, wathi: “Makabongwe uJehova namuhla omnike uDavide indodana ehlakaniphileyo phezu kwalesi sizwe esikhulu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
