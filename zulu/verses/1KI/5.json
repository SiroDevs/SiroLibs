            "number": "12",
            "style": "v",
            "sid": "1KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wamnika uSolomoni ukuhlakanipha njengokumthembisa kwakhe, kwaba khona ukuthula phakathi kukaHiramu noSolomoni; benza isivumelwano bobabili.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
