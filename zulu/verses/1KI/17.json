          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.4",
            "verseOrgIds": [
              "1KI.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahamba wenza njengezwi likaJehova, ngokuba waya wahlala ngasemfudlaneni iKreti ephambi kweJordani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.5",
            "verseOrgIds": [
              "1KI.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.5",
            "verseOrgIds": [
              "1KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagwababa amlethela isinkwa nenyama ekuseni, nesinkwa nenyama kusihlwa; waphuza emfuleni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.6",
            "verseOrgIds": [
              "1KI.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.6",
            "verseOrgIds": [
              "1KI.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi emva kwesikhashana umfula woma, ngokuba kwakungekho mvula ezweni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.7",
            "verseOrgIds": [
              "1KI.17.7"
            ]
          }
        }
      ]
    },
    {
