              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasebiza uJehova, wathi: “Jehova Nkulunkulu wami, umenzele okubi nomfelokazi engigogobele kuye ngokubulala indodana yakhe na?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.20",
