          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Eliya waseThishibi, owabakhileyo kwaGileyadi, wathi ku-Ahabi: “Kuphila kukaJehova uNkulunkulu ka-Israyeli engimi phambi kwakhe, kule minyaka akuyikuba khona mazolo noma imvula, ngaphandle kwezwi lami.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.1",
            "verseOrgIds": [
              "1KI.17.1"
            ]
          }
        }
      ]
    },
    {
