              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wezwa izwi lika-Eliya; umphefumulo womntwana wabuyela kuye, waphila.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.22",
