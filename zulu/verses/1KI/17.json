              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kuye: “Nginike indodana yakho.” Wayisusa esifubeni sakhe, wayiyisa ehhokweni lapho wayehlala khona, wayilalisa embhedeni wakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.19",
            "verseOrgIds": [
