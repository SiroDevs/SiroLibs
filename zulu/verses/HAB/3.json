            "verseOrgIds": [
              "HAB.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HAB 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noma umkhiwane ungakhahleli, kungabikho sithelo emvinini; umsebenzi womnqumo uyophela, namasimu awayikuthela ukudla; imfuyo encane kufanele iqedwe esibayeni, futhi akufanele kube nezinkomo ezibayeni;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.17",
            "verseOrgIds": [
              "HAB.3.17"
            ]
          }
        }
      ]
    },
