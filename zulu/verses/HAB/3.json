            "style": "v",
            "sid": "HAB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukukhanya kwakhe kwakunjengokukhanya; kwaphuma izimpondo esandleni sakhe, futhi kwakukhona ukufihlakala kwamandla akhe.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
