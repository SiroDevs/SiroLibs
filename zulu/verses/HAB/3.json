          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waphuma ukusindisa abantu bakho, yebo, ukusindisa kanye nogcotshiweyo wakho; Ulimele ikhanda endlini yomubi ngokuvula isisekelo kuze kufike entanyeni. Sela.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.13",
            "verseOrgIds": [
              "HAB.3.13"
            ]
          }
        }
