          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HAB 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho ngizwa lokhu, isisu sami sathuthumela; izindebe zami zathuthumela ngezwi; ukubola kwangena emathanjeni ami, ngaqhaqhazela phakathi kwami, ukuze ngiphumule ngosuku losizi;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.16",
            "verseOrgIds": [
              "HAB.3.16"
            ]
          }
        }
      ]
    },
