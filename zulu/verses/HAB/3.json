          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Washaya inhloko yemizi yakhe ngezinduku zakho; njengesivunguvungu baphuma ukungihlakaza; ukujabula kwabo kwakunjengokudla abampofu ngasese.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.14",
            "verseOrgIds": [
              "HAB.3.14"
            ]
          }
        }
