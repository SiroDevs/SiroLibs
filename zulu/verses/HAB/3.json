          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadabula ulwandle namahhashi akho, inqwaba yamanzi amaningi.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.15",
            "verseOrgIds": [
              "HAB.3.15"
            ]
          }
        }
      ]
