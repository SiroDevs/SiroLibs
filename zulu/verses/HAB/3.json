        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilanga nenyanga kwema endaweni yakho yokuhlala, ngokukhanya kwemicibisholo yakho yadlula ngokubenyezela komkhonto wakho.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.11",
            "verseOrgIds": [
              "HAB.3.11"
            ]
          }
        }
