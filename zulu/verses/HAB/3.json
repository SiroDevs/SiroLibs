        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isifo sahamba phambi kwakhe, namalahle avuthayo aphuma ezinyaweni zakhe.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.5",
            "verseOrgIds": [
              "HAB.3.5"
            ]
          }
        }
      ]
    },
    {
