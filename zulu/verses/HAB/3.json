            "sid": "HAB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova, ngizwile izwi lakho, ngesaba; Jehova, mawuphile umsebenzi wakho phakathi kweminyaka, wazise phakathi kweminyaka; olakeni khumbula umusa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
