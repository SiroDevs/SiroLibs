        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngabona amatende akwaKushani ecindezelwe, nezilenge zezwe lakwaMidiyani zithuthumela.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.7",
            "verseOrgIds": [
              "HAB.3.7"
            ]
          }
        }
      ]
    },
    {
