          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.10",
            "verseOrgIds": [
              "HAB.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba itshe liyokhala odongeni, ugongolo lomuthi luphendule kulo.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.11",
            "verseOrgIds": [
              "HAB.2.11"
            ]
          }
        }
