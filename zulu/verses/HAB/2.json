          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maye kuye ophuzisa umakhelwane wakhe, ombekelayo imbodlela yakho, amdakise naye, ukuze ubone ubunqunu bakhe!",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.15",
            "verseOrgIds": [
              "HAB.2.15"
            ]
          }
        }
      ]
    },
