          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, akuveli kuJehova Sebawoti ukuthi abantu bayakukhandleka emlilweni, abantu bazikhathaze kube yize, na?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        }
      ]
    },
    {
