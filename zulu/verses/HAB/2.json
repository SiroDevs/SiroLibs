        },
        {
          "text": "Ngoba ubudlova baseLebanoni buyosibekela wena nempango yezilwane eziyethusayo ngenxa yegazi labantu nangenxa yobudlova bezwe, bomuzi nabo bonke abahlala kuwo.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
