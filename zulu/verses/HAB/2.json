          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAB 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba umhlaba uyakugcwala ukwazi inkazimulo kaJehova, njengamanzi asibekela ulwandle.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.14",
            "verseOrgIds": [
              "HAB.2.14"
            ]
          }
        }
      ]
    },
    {
