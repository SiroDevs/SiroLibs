          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wo kowakha umuzi ngegazi, amise umuzi ngobubi!",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.12",
            "verseOrgIds": [
              "HAB.2.12"
            ]
          }
        }
