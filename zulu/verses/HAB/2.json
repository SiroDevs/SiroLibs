            "sid": "HAB 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigcwele ihlazo enkazimulweni; Phuza nawe, lembulwe ijwabu lakho; indebe yesandla sokunene sikaJehova iyakuphendulelwa kuwe, nokukhafulelwa okuyihlazo phezu kodumo lwakho.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
