          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.12",
            "verseOrgIds": [
              "HAB.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAB 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unamehlo ahlanzekile kunokuba ubuke okubi, futhi awukwazi ukubona ububi; Ubabhekelani abakhohlisayo, ubambe ulimi lwakho, lapho omubi edla olungile kunaye, na?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.13",
            "verseOrgIds": [
              "HAB.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
