        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.15",
            "verseOrgIds": [
              "HAB.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HAB 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho bayazihlabela bona kuphela, kuqhamuke intuthu ekuhuduleni kwabo; ngokuba isabelo sabo sinonile kanye nokudla kwabo kuchichima.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.16",
            "verseOrgIds": [
              "HAB.1.16"
            ]
          }
        }
      ]
    },
