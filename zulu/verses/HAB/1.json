          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke ingabe bayothulula inetha labo futhi bayeke umzamo wokubulala izizwe?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.17",
            "verseOrgIds": [
              "HAB.1.17"
            ]
          }
        }
