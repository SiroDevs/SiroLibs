          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "yiphe ukudla ehlobo, uyilungisele ukudla ngesikhathi sokuvuna.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.8",
            "verseOrgIds": [
              "PRO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
