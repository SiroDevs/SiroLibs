          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.10",
            "verseOrgIds": [
              "PRO.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho ubumpofu bakho buyofika njengomhambi, nokuswela kwakho njengomuntu ohlomile.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.11",
            "verseOrgIds": [
              "PRO.6.11"
            ]
          }
        }
      ]
    },
    {
