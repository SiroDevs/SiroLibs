            "sid": "PRO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingelamkhokheli, umbonisi, nambusi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.7",
            "verseOrgIds": [
              "PRO.6.7"
            ]
          }
        }
      ]
    },
    {
