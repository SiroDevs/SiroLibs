          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amehlo aziqhenyayo, nolimi lwamanga, nezandla ezichitha igazi elingenacala;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.17",
            "verseOrgIds": [
              "PRO.6.17"
            ]
          }
        }
