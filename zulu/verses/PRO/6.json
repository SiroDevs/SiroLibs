            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkohliso isenhliziyweni yakhe, uceba okubi njalo; utshala ukungezwani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.14",
            "verseOrgIds": [
              "PRO.6.14"
            ]
          }
        }
      ]
