          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu omubi, umuntu omubi, uhamba nomlomo omubi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.12",
            "verseOrgIds": [
              "PRO.6.12"
            ]
          }
        }
      ]
    },
    {
