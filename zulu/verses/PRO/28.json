        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.13",
            "verseOrgIds": [
              "PRO.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyajabula umuntu ohlala esaba, kodwa oyenza lukhuni inhliziyo yakhe uwela ebubini.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.14",
            "verseOrgIds": [
              "PRO.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
