          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohamba ngobuqotho uyakusindiswa; kepha omubi ezindleleni zakhe uyakuwa masinyane.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.18",
            "verseOrgIds": [
              "PRO.28.18"
            ]
          }
        }
      ]
