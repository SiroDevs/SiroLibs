          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.16",
            "verseOrgIds": [
              "PRO.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu owenza ubudlova ngegazi lomuntu kumelwe abalekele emgodini; ungavumeli muntu ukuthi amvimbe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.17",
            "verseOrgIds": [
              "PRO.28.17"
            ]
          }
        }
      ]
    },
