          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izindebe zabahlakaniphileyo zisakaza ukwazi, kepha inhliziyo yeziwula ayikwenzi lokho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.7",
            "verseOrgIds": [
              "PRO.15.7"
            ]
          }
        }
      ]
    },
    {
