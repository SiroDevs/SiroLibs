          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amehlo kaJehova asezindaweni zonke futhi abona ababi nabahle.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.3",
            "verseOrgIds": [
              "PRO.15.3"
            ]
          }
        }
      ]
    },
    {
