            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inhliziyo ethokozayo yenza ubuso bube buhle, kodwa ngokudabuka kwenhliziyo umoya uyachotshozwa.",
          "type": "text",
