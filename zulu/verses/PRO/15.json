              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impendulo ethambileyo ibuyisa ulaka, kepha amazwi alimazayo avusa ulaka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.1",
            "verseOrgIds": [
