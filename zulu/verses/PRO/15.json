          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulimi lwabahlakaniphileyo lusebenzisa ulwazi ngokufanele, kodwa umlomo weziwula uthulula ubuwula.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.2",
            "verseOrgIds": [
              "PRO.15.2"
            ]
          }
        }
      ]
    },
    {
