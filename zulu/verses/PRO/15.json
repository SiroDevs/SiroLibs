          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiwula siyadelela ukulaya kukayise, kodwa oqaphela ukusolwa uhlakaniphile.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.5",
            "verseOrgIds": [
              "PRO.15.5"
            ]
          }
        }
      ]
    },
    {
