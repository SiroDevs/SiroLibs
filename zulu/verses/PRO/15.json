            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indawo yabafileyo nencithakalo kuphambi kukaJehova; kakhulu kangakanani kunezinhliziyo zabantwana babantu?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.11",
            "verseOrgIds": [
              "PRO.15.11"
            ]
