          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uswazi lokusola kuyanika ukuhlakanipha, kodwa umntwana osele yedwa uhlazisa unina.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.15",
            "verseOrgIds": [
