            "sid": "PRO 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esiphambekweni somubi kukhona ugibe, kepha abalungileyo bayathokoza, bajabule.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.6",
            "verseOrgIds": [
              "PRO.29.6"
            ]
          }
        }
      ]
    },
    {
