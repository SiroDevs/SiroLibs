          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiwula siyakukhuluma konke ukuqonda kwaso, kepha ohlakaniphileyo uyakulonda kuze kube sekupheleni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.11",
            "verseOrgIds": [
              "PRO.29.11"
            ]
          }
        }
