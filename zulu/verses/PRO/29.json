          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi eyahlulela abampofu ngeqiniso, isihlalo sayo sobukhosi siyakuma kuze kube phakade.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.14",
            "verseOrgIds": [
              "PRO.29.14"
            ]
          }
