            "sid": "PRO 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu othopha umakhelwane wakhe wenekela izinyawo zakhe inetha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.5",
            "verseOrgIds": [
              "PRO.29.5"
            ]
          }
        }
      ]
    },
    {
