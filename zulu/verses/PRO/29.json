              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lungisa indodana yakho, iyakukuphumuza; yebo, uyakuthokozisa umphefumulo wakho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.17",
            "verseOrgIds": [
