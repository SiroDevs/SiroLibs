            "sid": "PRO 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olungileyo uyayiqaphela indaba yompofu, kepha omubi akayilaleli.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.7",
            "verseOrgIds": [
              "PRO.29.7"
            ]
          }
        }
      ]
    },
    {
