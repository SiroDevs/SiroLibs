          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.5",
            "verseOrgIds": [
              "PRO.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuzuza ingcebo ngolimi lwamanga kuyize elijikijelwa ngapha nangapha ngabafuna ukufa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.6",
            "verseOrgIds": [
              "PRO.21.6"
            ]
          }
        }
      ]
    },
    {
