          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalungileyo babona ngokuhlakanipha indlu yababi, kodwa uNkulunkulu uyabachitha ababi ngenxa yobubi babo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.12",
            "verseOrgIds": [
              "PRO.21.12"
            ]
          }
        }
      ]
    },
    {
