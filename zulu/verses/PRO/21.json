          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.8",
            "verseOrgIds": [
              "PRO.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungcono ukuhlala ekhoneni lophahla kunokuhlala endlini ebanzi nowesifazane oxabanayo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.9",
            "verseOrgIds": [
              "PRO.21.9"
            ]
          }
        }
      ]
    },
    {
