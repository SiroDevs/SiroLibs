          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyinjabulo kolungileyo ukwenza okulungileyo, kodwa abenza okubi bazakuba yimbubhiso.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.15",
            "verseOrgIds": [
              "PRO.21.15"
            ]
