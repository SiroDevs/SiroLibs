          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakukuhle ukwamukela ubuso bomubi, ukuwisa olungileyo ekwahluleleni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.5",
            "verseOrgIds": [
              "PRO.18.5"
            ]
          }
        }
      ]
    },
    {
