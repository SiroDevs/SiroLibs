          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izindebe zesiwula ziyaxabana, nomlomo waso ukhale ngokushaywa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.6",
            "verseOrgIds": [
              "PRO.18.6"
            ]
