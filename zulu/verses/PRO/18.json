            "number": "3",
            "style": "v",
            "sid": "PRO 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho omubi efika, kufika indelelo kanye nehlazo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.3",
            "verseOrgIds": [
              "PRO.18.3"
            ]
          }
        }
      ]
    },
    {
