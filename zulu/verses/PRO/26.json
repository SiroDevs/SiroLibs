          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu omkhulu owenza zonke izinto uyabavuza abayiziwula kanye nabaphambukayo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.10",
            "verseOrgIds": [
              "PRO.26.10"
            ]
          }
