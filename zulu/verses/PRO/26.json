          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivila lifaka isandla esifubeni salo; kwaba buhlungu kuye ukuphinda alibuyisele emlonyeni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.15",
            "verseOrgIds": [
