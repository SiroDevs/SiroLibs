        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.6",
            "verseOrgIds": [
              "PRO.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imilenze yokukhubazeka ayilingani; unjalo umfanekiso emlonyeni weziwula.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.7",
            "verseOrgIds": [
              "PRO.26.7"
            ]
          }
        }
      ]
    },
    {
