          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivila lihlakaniphile emehlweni alo kunabantu abayisikhombisa abanengqondo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.16",
            "verseOrgIds": [
