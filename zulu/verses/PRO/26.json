          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.5",
            "verseOrgIds": [
              "PRO.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Othumela izwi ngesandla sesiwula unquma izinyawo zakhe, anathe okubi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.6",
            "verseOrgIds": [
              "PRO.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
