          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengoba umnyango uphenduka ezintini zawo, kanjalo ivila liphendula embhedeni walo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.14",
            "verseOrgIds": [
              "PRO.26.14"
            ]
