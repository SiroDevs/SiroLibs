        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intamo yakho injengombhoshongo kaDavide owakhiwe njengezikhali, okulenga kuwo izihlangu eziyinkulungwane, zonke izihlangu zamaqhawe.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
