          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izitshalo zakho ziyinsimu yamahalananda, izithelo ezimnandi; i-camphor, ne-spikenard,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.13",
            "verseOrgIds": [
              "SNG.4.13"
            ]
          }
        }
