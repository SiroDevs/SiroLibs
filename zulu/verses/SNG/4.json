        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, umuhle, sithandwa sami; bheka, umuhle; unamehlo ejuba phakathi kwezikhiye zakho; izinwele zakho zinjengomhlambi wezimbuzi ovela entabeni yakwaGileyadi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazinyo akho anjengomhlambi wezimvu ezigundiweyo, ezikhuphuka zigezwa; ngalinye lizala amawele, futhi akekho oyinyumba phakathi kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
