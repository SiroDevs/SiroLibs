          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "umthombo wamasimu, umthombo wamanzi aphilayo, nemifudlana evela eLebanoni.",
          "type": "text",
          "attrs": {
