          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "inadi nesafroni; ukala, nesinamoni, kanye nayo yonke imithi yenhlaka; imure nenhlaba kanye nazo zonke izinongo eziphambili;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.14",
            "verseOrgIds": [
