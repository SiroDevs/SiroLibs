          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuka, moya wasenyakatho! woza wena ningizimu! phephetha phezu kwensimu yami, ukuze amakha ayo aphume. Othandiweyo wami makangene ensimini yakhe, adle isithelo sakhe esimnandi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.16",
