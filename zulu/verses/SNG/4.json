          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uvalelwe ensimini udadewethu, makoti wami; valani umthombo, valani umthombo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.12",
            "verseOrgIds": [
              "SNG.4.12"
            ]
          }
        }
