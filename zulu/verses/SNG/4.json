          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izindebe zakho, makoti wami, ziconsa njengekhekheba lezinyosi; uju nobisi kuphansi kolimi lwakho; iphunga lezingubo zakho linjengephunga laseLebanoni.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        }
      ]
    },
