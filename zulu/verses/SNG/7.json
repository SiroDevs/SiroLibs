          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amamandragora anephunga elimnandi, ngasemasangweni ethu kukhona zonke izinhlobo zezithelo ezinhle, ezintsha nezindala, engizibekele wena, sithandwa sami.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.13",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
