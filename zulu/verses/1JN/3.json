            "number": "17",
            "style": "v",
            "sid": "1JN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha onezinto zaleli zwe, bese ebona umzalwane wakhe eswele, amvalele ububele bakhe kuye, uthando lukaNkulunkulu luhlala kanjani kuye na?",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.17",
            "verseOrgIds": [
              "1JN.3.17"
            ]
          }
        }
      ]
    },
