          "type": "text",
          "attrs": {
            "verseId": "1JN.2.16",
            "verseOrgIds": [
              "1JN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
