          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwe liyadlula kanye nenkanuko yalo, kepha owenza intando kaNkulunkulu uhlala kuze kube phakade.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.17",
            "verseOrgIds": [
              "1JN.2.17"
            ]
          }
        }
      ]
    },
