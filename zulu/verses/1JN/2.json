              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.11",
            "verseOrgIds": [
              "1JN.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyalibhalela, bantwanyana, ngoba izono zenu zithethelelwe ngenxa yebizo lakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.12",
            "verseOrgIds": [
              "1JN.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.12",
            "verseOrgIds": [
              "1JN.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1JN 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyanilobela bobaba, ngokuba nimazile okhona kwasekuqaleni. Ngiyanilobela, zinsizwa, ngokuba nimnqobile omubi. Ngiyanilobela, bantwanyana, ngokuba nimazile uBaba.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
            "verseOrgIds": [
              "1JN.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
