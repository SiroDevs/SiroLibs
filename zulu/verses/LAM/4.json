        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LAM 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha thina, amehlo ethu asalokhu ephelile ukubheka usizo lwethu oluyize; ngokuqapha kwethu sibheke isizwe esingeke sisisindise.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.17",
            "verseOrgIds": [
              "LAM.4.17"
            ]
          }
        }
      ]
