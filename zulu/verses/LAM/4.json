        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.12",
            "verseOrgIds": [
              "LAM.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LAM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenxa yezono zabaprofethi balo nobubi babapristi balo abachitha igazi labalungileyo phakathi kwalo;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.13",
            "verseOrgIds": [
              "LAM.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LAM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.13",
            "verseOrgIds": [
              "LAM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LAM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazulazula njengezimpumputhe ezitaladini, bazingcolisa ngegazi, ukuze abantu bangabe besathinta izingubo zabo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.14",
            "verseOrgIds": [
              "LAM.4.14"
            ]
          }
        }
      ]
    },
    {
