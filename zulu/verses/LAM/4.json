            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LAM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebememeza bathi: Hambani! ingcolile; sukani, sukani, ningathinti; lapho bebaleka bezulazula, bathi phakathi kwabezizwe: Kabayikugogobala khona;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.15",
            "verseOrgIds": [
              "LAM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
