          "type": "text",
          "attrs": {
            "verseId": "LAM.4.15",
            "verseOrgIds": [
              "LAM.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LAM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intukuthelo kaJehova yabahlukanisa; akasayikubanaka; babengahloniphi ubuntu babapristi, babengawathandi amadoda amadala.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.16",
            "verseOrgIds": [
              "LAM.4.16"
            ]
          }
        }
      ]
