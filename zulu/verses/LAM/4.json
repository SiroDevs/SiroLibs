      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LAM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeka indlela igolide elibuthuntu ngayo! igolide elicwengekileyo liguqulwa kanjani! amatshe endlu engcwele achithekile eziqongweni zazo zonke izitaladi.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LAM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LAM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana ayigugu aseSiyoni alingana negolide elihle, yeka ukuthi abhekwa njengezitsha zebumba, umsebenzi wezandla zombumbi!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LAM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LAM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngisho nezilo zasolwandle zikhipha amabele azo, zincelise amazinyane azo; indodakazi yabantu bami isinonya njengezintshe zasogwadule.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LAM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LAM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulimi lomunya lunamathela olwangeni lwakhe ngokoma; abantwana abancane bacela isinkwa, futhi akakho osihlephulayo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LAM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LAM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abadlile kahle bangamaganga ezitaladini;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LAM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LAM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba isijeziso sobubi bendodakazi yabantu bami sikhulu kunesijeziso sesono saseSodoma elachithwa ngokuphazima kweso, kungasalanga zandla phezu kwalo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LAM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LAM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaNaziri alo ayehlanzekile kuneqhwa, ayemhlophe kunobisi, ebomvu ngomzimba kunamarubi, ukucwebeshwa kwawo kwakungokwesafire.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LAM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LAM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubuso babo bumnyama kunelahle; abaziwa ezitaladini; isikhumba sabo sinamathela emathanjeni abo; yabuna, yaba njengenduku.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LAM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LAM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababulewe ngenkemba bangcono kunababulawa yindlala, ngokuba laba bayabavula, benqotshiwe ngenxa yokuswela izithelo zensimu.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LAM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LAM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izandla zabesifazane abanomusa zaphuzisa abantwana babo; babe ngukudla kwabo ekubhujisweni kwendodakazi yabantu bami.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.10",
            "verseOrgIds": [
              "LAM.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LAM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.10",
            "verseOrgIds": [
              "LAM.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LAM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova ulugcwalisile ulaka lwakhe; Wathulula ukufutheka kwakhe, waphemba umlilo eSiyoni, waqeda izisekelo zalo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.11",
            "verseOrgIds": [
              "LAM.4.11"
            ]
          }
        }
      ]
    },
    {
