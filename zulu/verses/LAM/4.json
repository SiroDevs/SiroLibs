          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.11",
            "verseOrgIds": [
              "LAM.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LAM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhosi omhlaba kanye nabo bonke abakhileyo emhlabeni babengeke bakholwe ukuthi isitha nesitha kufanele bangene emasangweni eJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.12",
            "verseOrgIds": [
              "LAM.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LAM 4:12"
          },
          "items": [
