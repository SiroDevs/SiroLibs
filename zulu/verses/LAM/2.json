          "type": "text",
          "attrs": {
            "verseId": "LAM.2.16",
            "verseOrgIds": [
              "LAM.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
