          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi lapha abantu abafayo bamukela okweshumi; kodwa lapho uyawemukela, ofakazelwa ngaye ukuthi uyaphila.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.8",
            "verseOrgIds": [
              "HEB.7.8"
            ]
          }
        }
