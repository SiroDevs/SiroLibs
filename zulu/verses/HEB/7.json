            "sid": "HEB 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njalo kakuphikiswa ukuthi omncinyane ubusiswa ngomkhulu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.7",
            "verseOrgIds": [
              "HEB.7.7"
            ]
