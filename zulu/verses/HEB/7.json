          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.4",
            "verseOrgIds": [
              "HEB.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha labo abangamadodana kaLevi abemukeliswa ubupristi banomyalo wokuba bathathe okweshumi kubantu ngokomthetho, okungukuthi kubafowabo, noma bephuma okhalweni luka-Abrahama;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.5",
            "verseOrgIds": [
              "HEB.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
