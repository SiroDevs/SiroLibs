          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho kwamfanela ukuthi afane labafowabo kukho konke, ukuze abe ngumpristi omkhulu olesihawu lothembekileyo ezintweni ezimayelana loNkulunkulu, ukuze enze inhlawulo yokuthula ngezono zabantu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.17",
            "verseOrgIds": [
              "HEB.2.17"
            ]
          }
        }
      ]
    },
    {
