          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "futhi abakhulule labo ababeboshelwe ebugqilini ukuphila kwabo konke ngokwesaba ukufa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.15",
            "verseOrgIds": [
              "HEB.2.15"
            ]
          }
        }
