      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.1",
            "verseOrgIds": [
              "HEB.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uma izwi elakhulunywa ngezingelosi laqiniseka, nakho konke ukweqa nokungalaleli kuthola umvuzo ofanele;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.2",
            "verseOrgIds": [
              "HEB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
