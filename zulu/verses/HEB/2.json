          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke sifanele ukunakisisa kakhulu lokho esikuzwileyo, funa noma nini sishelele.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.1",
            "verseOrgIds": [
              "HEB.2.1"
            ]
          }
        }
      ]
    },
    {
