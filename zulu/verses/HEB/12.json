          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi sinabobaba benyama yethu abasilayayo, sabahlonipha; kasiyikuzithoba kakhulu kuYise wawomoya, siphile, na?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.9",
            "verseOrgIds": [
              "HEB.12.9"
            ]
          }
        }
