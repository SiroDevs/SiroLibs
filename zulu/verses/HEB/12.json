            "sid": "HEB 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha ukujeziswa okwamanje akubonakali kuthokozisa, kodwa kubuhlungu;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.11",
            "verseOrgIds": [
              "HEB.12.11"
            ]
          }
