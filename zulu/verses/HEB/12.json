          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenzele izinyawo zenu izindlela eziqondileyo, ukuze okuqhugayo kungaphambuki endleleni; kodwa kunalokho kakulaliswe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
