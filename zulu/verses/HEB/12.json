            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba anizanga entabeni ethintwa, eshiswa umlilo, nobumnyama, nobumnyama, nesiphepho,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.18",
