            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibhekisise kungabikho osilela umusa kaNkulunkulu; funa kumile impande yokubaba inikhathaze, kungcoliswe abaningi ngayo;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.15",
            "verseOrgIds": [
              "HEB.12.15"
            ]
