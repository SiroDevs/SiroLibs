          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "funa kube khona isifebe, noma ohlambalazayo, njengo-Esawu owathengisa ubuzibulo bakhe ngokudla kanye.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.16",
