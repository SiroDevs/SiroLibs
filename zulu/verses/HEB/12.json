        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.9",
            "verseOrgIds": [
              "HEB.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
