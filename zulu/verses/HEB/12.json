            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba niyazi ukuthi ngasemuva esethanda ukudla ifa lesibusiso, waliwa, ngokuba akafumananga indawo yokuphenduka, nakuba ekufunisisa ngezinyembezi.",
          "type": "text",
          "attrs": {
