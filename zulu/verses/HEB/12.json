            "sid": "HEB 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba bona basilaya izinsukwana njengokuthanda kwabo; kodwa yena kube yinzuzo yethu, ukuze sihlanganyele ubungcwele bakhe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.10",
            "verseOrgIds": [
              "HEB.12.10"
            ]
          }
        }
      ]
    },
