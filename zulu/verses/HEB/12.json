          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke phakamisani izandla eziwileyo namadolo axegayo;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.12",
            "verseOrgIds": [
              "HEB.12.12"
            ]
