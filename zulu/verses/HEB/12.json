          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Landelani ukuthula nabantu bonke, nokungcweliswa, okungekho muntu oyobona iNkosi ngaphandle kwakho;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.14",
            "verseOrgIds": [
              "HEB.12.14"
            ]
          }
        }
