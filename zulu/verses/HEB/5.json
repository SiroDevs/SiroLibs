          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "futhi esephelelisiwe, waba yinhloko yensindiso ephakade kubo bonke abamlalelayo;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.9",
            "verseOrgIds": [
              "HEB.5.9"
            ]
          }
        }
