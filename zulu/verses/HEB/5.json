          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba yilowo nalowo odla ubisi akahlakaniphile izwi lokulunga, ngokuba uyingane.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.13",
            "verseOrgIds": [
              "HEB.5.13"
            ]
          }
        }
