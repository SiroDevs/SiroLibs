          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebizwa ngokuthi nguNkulunkulu umpristi omkhulu ngokokuma kukaMelkisedeki.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.10",
            "verseOrgIds": [
              "HEB.5.10"
            ]
