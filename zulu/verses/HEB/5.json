          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.7",
            "verseOrgIds": [
              "HEB.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
