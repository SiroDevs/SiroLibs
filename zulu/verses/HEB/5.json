            "number": "12",
            "style": "v",
            "sid": "HEB 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba nakuba benifanele ukuba ngabafundisi, kuze kube manje, nisadinga futhi ukuba kube khona onifundisa iziqalo zamazwi kaNkulunkulu; seniba njengabadinga ubisi, hhayi okokudla okuqinileyo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.12",
            "verseOrgIds": [
              "HEB.5.12"
            ]
          }
        }
