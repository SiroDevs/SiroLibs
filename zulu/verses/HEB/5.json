            "number": "7",
            "style": "v",
            "sid": "HEB 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owathi emihleni yenyama yakhe, lapho enikele imikhuleko nokunxusa ngokukhala okunamandla nezinyembezi kuye onamandla okumsindisa ekufeni, wezwiwa ngokwesaba kwakhe;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.7",
            "verseOrgIds": [
              "HEB.5.7"
            ]
          }
        }
      ]
    },
