            "sid": "HEB 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi wonke umphristi umi insuku ngensuku ekhonza njalo enikela kanengi yona leyomihlatshelo engeke yakwazi ukususa izono.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.11",
            "verseOrgIds": [
              "HEB.10.11"
            ]
          }
        }
