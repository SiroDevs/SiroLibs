          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba abantu bafunga omkhulu kubo, nesifungo sokuqinisekisa singukuphela kwakho konke ukuphikisana.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.16",
            "verseOrgIds": [
              "HEB.6.16"
            ]
          }
        }
      ]
