          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uNkulunkulu, ethanda kakhulu kakhulu ukubonisa izindlalifa zesithembiso ukungaguquleki kwecebo lakhe, wakuqinisa ngesifungo;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.17",
            "verseOrgIds": [
              "HEB.6.17"
            ]
          }
        }
