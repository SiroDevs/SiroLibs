          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.11",
            "verseOrgIds": [
              "HEB.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuze ningavilaphi, kodwa nilingise labo abathi ngokholo nangokubekezela badla ifa lezithembiso.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.12",
            "verseOrgIds": [
              "HEB.6.12"
            ]
          }
        }
      ]
    },
    {
