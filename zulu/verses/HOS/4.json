          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Efrayimi uhlangene nezithombe; makasukume.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.17",
            "verseOrgIds": [
              "HOS.4.17"
            ]
          }
        }
