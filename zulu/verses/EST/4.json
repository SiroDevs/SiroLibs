            "number": "16",
            "style": "v",
            "sid": "EST 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamba uqoqe wonke amaJuda akhona eShushani, ningizilele, ningadli, ningaphuzi izinsuku ezintathu, ubusuku nemini. Mina nezincekukazi zami siyakuzila kanjalo; kanjalo ngiyongena enkosini, okuphambene nomthetho; futhi uma ngibhubha, ngiyabhubha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.16",
            "verseOrgIds": [
              "EST.4.16"
            ]
          }
        }
      ]
