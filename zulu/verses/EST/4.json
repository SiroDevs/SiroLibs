            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Esteri wayesethi kuMoridekayi:",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.15",
            "verseOrgIds": [
              "EST.4.15"
            ]
