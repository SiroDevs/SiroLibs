        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.13",
            "verseOrgIds": [
              "EST.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uma nithula impela ngalesi sikhathi, kuyakuvela ukwandiswa nokusindiswa kwabaJuda kwenye indawo; kepha wena nendlu kayihlo niyakuchithwa; Ngubani owaziyo ukuthi ungene embusweni isikhathi esinjengalesi na?",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.14",
            "verseOrgIds": [
              "EST.4.14"
            ]
          }
        }
      ]
    },
