            "verseId": "EST.4.7",
            "verseOrgIds": [
              "EST.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamnika nekhophi yombhalo womthetho owashiwo eShushani wokuba ababhujiswe, awubonise u-Esteri nokuwumemezela kuye nokumyala ukuba angene enkosini ayocela. Kuye nokunxusela abantu bakubo phambi kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.8",
            "verseOrgIds": [
              "EST.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
