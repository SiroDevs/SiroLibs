          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHathagi wafika wamtshela u-Esteri amazwi kaMoridekayi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.9",
            "verseOrgIds": [
              "EST.4.9"
