        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.9",
            "verseOrgIds": [
              "EST.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Esteri wabuye wakhuluma kuHathagi, wamyala uMoridekayi;",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.10",
            "verseOrgIds": [
              "EST.4.10"
            ]
          }
        }
      ]
