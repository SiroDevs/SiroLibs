        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.6",
            "verseOrgIds": [
              "EST.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMoridekayi wamtshela konke okwamehlele, nenani lemali uHamani athembise ukuyibuyisela endlini yengcebo yenkosi ukuba abaJuda bawabhubhise.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.7",
            "verseOrgIds": [
              "EST.4.7"
            ]
          }
        }
      ]
    },
    {
