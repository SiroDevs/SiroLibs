        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesondla uHadasa, ongu-Esteri, indodakazi kayisekazi; ngokuba yayingenayise noma unina, intombazana yayiyinhle, iyinhle; uMoridekayi wafa uyise nonina wayithatha yaba yindodakazi yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.7",
            "verseOrgIds": [
              "EST.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.7",
            "verseOrgIds": [
              "EST.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho kuzwakala umyalo nomyalo wayo wenkosi, nalapho izintombi eziningi zibuthene esigodlweni uSusan ngaphansi kwesandla sikaHegayi, u-Esteri naye walethwa endlini yenkosi ngaphansi kwesandla sikaHegayi umgcini wabesifazane.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.8",
            "verseOrgIds": [
              "EST.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
