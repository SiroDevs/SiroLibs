          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.14",
            "verseOrgIds": [
              "EST.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho kufika ithuba lika-Esteri, indodakazi ka-Abihayili, uyisekazi kaMoridekayi, owamthatha ukuba abe indodakazi yakhe, wangena enkosini, akafunanga lutho ngaphandle kwalokho uHegayi, inceku yenkosi, umlindi wenkosi. Abesifazane, abamisiwe. U-Esteri wazuza umusa emehlweni abo bonke abambonayo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.15",
            "verseOrgIds": [
              "EST.2.15"
            ]
          }
        }
      ]
    },
