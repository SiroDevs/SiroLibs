            "sid": "EST 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho u-Esteri wayiswa enkosini u-Ahashiveroshi endlini yayo yobukhosi ngenyanga yeshumi, eyinyanga kaThebeti, ngomnyaka wesikhombisa wokubusa kwayo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.16",
            "verseOrgIds": [
              "EST.2.16"
            ]
          }
        }
