          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona esigodlweni saseShushani umJuda othile ogama lakhe linguMoridegayi indodana kaJayire kaSimeyi kaKishi wakwaBenjamini;",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.5",
            "verseOrgIds": [
              "EST.2.5"
            ]
          }
        }
      ]
    },
    {
