          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zase zifika zonke izintombi enkosini kanje; konke ayekufuna wanikwa ukuthi ahambe laye endlini yabesifazana ukuya endlini yenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.13",
            "verseOrgIds": [
              "EST.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
