        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.13",
            "verseOrgIds": [
              "EST.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahamba kusihlwa, ngangomuso yabuyela endlini yesibili yabesifazane, phansi kwesandla sikaSheshahasi, induna yenkosi, egada izancinza; nokuthi wayeshiwo ngegama.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.14",
            "verseOrgIds": [
              "EST.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
