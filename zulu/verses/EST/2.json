          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.1",
            "verseOrgIds": [
              "EST.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinceku zenkosi ezimkhonzayo zathi: “Inkosi mayifunelwe izintombi ezinhle;",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.2",
            "verseOrgIds": [
              "EST.2.2"
            ]
          }
        }
      ]
    },
    {
