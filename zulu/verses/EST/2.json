          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "abathunjwa eJerusalema kanye nokuthunjwa kanye noJekoniya, inkosi yakwaJuda, owathunjwa nguNebukadinesari, inkosi yaseBabele.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.6",
            "verseOrgIds": [
              "EST.2.6"
            ]
          }
        }
