      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.2",
            "verseOrgIds": [
              "EST.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi mayimise izinduna kuzo zonke izifunda zombuso wayo ukuba zibuthe zonke izintombi ezinhle esigodlweni saseSusa, endlini yabesifazane, ngaphansi kwesandla sikaHege, induna yenkosi, umlindi wabesifazane.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.3",
            "verseOrgIds": [
              "EST.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.3",
            "verseOrgIds": [
              "EST.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intombazane enhle enkosini mayibe yindlovukazi esikhundleni sikaVashiti. Le ndaba yaba mnandi enkosini; Futhi wakwenza.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.4",
            "verseOrgIds": [
              "EST.2.4"
            ]
          }
        }
      ]
    },
    {
