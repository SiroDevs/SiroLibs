          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngemva kwalezi zinto, lapho ulaka lwenkosi u-Ahashiveroshi selubohlile, wamkhumbula uVashiti nalokho ayekwenzile nalokho okwakunqunyelwe kuye.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.1",
            "verseOrgIds": [
              "EST.2.1"
            ]
          }
        }
      ]
    },
    {
