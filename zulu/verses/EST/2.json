        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMoridegayi wayehamba zonke izinsuku phambi kwegceke lendlu yabesifazane ukuze azi ukuthi u-Esteri unjani nokuthi kuzokwenzekani kuye.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.11",
            "verseOrgIds": [
              "EST.2.11"
            ]
          }
        }
      ]
    },
    {
