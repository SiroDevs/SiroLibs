              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho izintombi zibuthana ngokwesibili, uMoridekayi wahlala phansi esangweni lenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.19",
