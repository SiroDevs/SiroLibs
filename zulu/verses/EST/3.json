      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokho inkosi u-Ahashiveroshi yamphakamisa uHamani indodana kaHamedatha umAgagi, yamphakamisa, yabeka isihlalo sakhe phezu kwezikhulu zonke ezazinaye.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.1",
            "verseOrgIds": [
              "EST.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.1",
            "verseOrgIds": [
              "EST.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke izinceku zenkosi ezazisesangweni lenkosi zakhothama zakhothamela uHamani, ngokuba inkosi yayiyale kanjalo ngaye. Kodwa uMoridekayi akazange akhothame, futhi akazange amhloniphe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.2",
            "verseOrgIds": [
              "EST.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.2",
            "verseOrgIds": [
              "EST.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinceku zenkosi ezazisesangweni lenkosi zathi kuMoridekayi: Kungani weqa umyalo wenkosi na?",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.3",
            "verseOrgIds": [
              "EST.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.3",
            "verseOrgIds": [
              "EST.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi besakhuluma kuye insuku zonke, engabalalelanga, basebetshela uHamani ukuthi abone ukuthi indaba kaMoridegayi izakuma yini, ngoba wayebatshelile ukuthi yena ungumJuda.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.4",
            "verseOrgIds": [
              "EST.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.4",
            "verseOrgIds": [
              "EST.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho uHamani ebona ukuthi uMoridekayi akakhothama futhi akamhloniphanga, uHamani wathukuthela.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.5",
            "verseOrgIds": [
              "EST.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.5",
            "verseOrgIds": [
              "EST.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadelela ukubeka izandla kuMoridekayi yedwa; ngoba bamvumela ukuthi abone abantu bakaMoridegayi; ngalokho uHamani wazama ukubhubhisa bonke abaJuda ababesembusweni wonke ka-Ahashiveroshi, abantu bakaMoridegayi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.6",
            "verseOrgIds": [
              "EST.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.6",
            "verseOrgIds": [
              "EST.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenyanga yokuqala eyinyanga kaNisani, ngomnyaka weshumi nambili wenkosi u-Ahashiveroshi, benza iPhure eliyinkatho phambi kukaHamani usuku nosuku nenyanga nenyanga, kwaze kwaba yinyanga yeshumi nambili, okungukuthi; inyanga ka-Adari.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.7",
            "verseOrgIds": [
              "EST.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.7",
            "verseOrgIds": [
              "EST.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHamani wayesethi enkosini u-Ahashiveroshi: “Kukhona abantu abathile abahlakazekile, abahlakazekile phakathi kwabantu ezifundeni zonke zombuso wakho; nemithetho yabo ihlukile kubantu bonke; futhi abayigcini imithetho yenkosi; ngakho akusizi inkosi ukuyithwala.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.8",
            "verseOrgIds": [
              "EST.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.8",
            "verseOrgIds": [
              "EST.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma kukuhle enkosini, makulotshwe ukuba babhujiswe, futhi ngiyakunikela amathalenta ayizinkulungwane eziyishumi esiliva ezandleni zalabo abanandaba ukuze bawangenise engcebweni yenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.9",
            "verseOrgIds": [
              "EST.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.9",
            "verseOrgIds": [
              "EST.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yasikhupha indandatho yayo esandleni sayo, yayinika uHamani indodana kaHameda umAgagi, isitha sabaJuda.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.10",
            "verseOrgIds": [
              "EST.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.10",
            "verseOrgIds": [
              "EST.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yathi kuHamani: “Isiliva linikiwe wena nabantu ukuba wenze kubo okuhle emehlweni akho.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.11",
            "verseOrgIds": [
              "EST.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.11",
            "verseOrgIds": [
              "EST.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bebizwa ababhali benkosi ngosuku lweshumi nantathu lwenyanga yokuqala, kulotshiwe njengakho konke uHamani ayekushilo ezikhulwini zenkosi nakubabusi ababephezu kwezifunda zonke, nakubabusi babo bonke abantu abavela emazweni. Isifunda ngasinye ngombhalo waso, nabantu, yileso naleso ngolimi lwaso; kwalotshwa egameni lenkosi u-Ahashiveroshi, kwatywinwa ngendandatho yenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.12",
            "verseOrgIds": [
              "EST.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.12",
            "verseOrgIds": [
              "EST.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izincwadi zathunyelwa kuzo zonke izifunda zenkosi ukuba kubhujiswe, kubulawe futhi kubhujiswe wonke amaJuda, abasha nabadala, izingane nabesifazane, ngalusuku lunye, ngosuku lweshumi nantathu lweshumi nambili. Inyanga, leyo yinyanga ka-Adari, nokuphanga impango yabo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.13",
            "verseOrgIds": [
              "EST.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.13",
            "verseOrgIds": [
              "EST.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikhophi yombhalo womyalo oyakuphuma ezifundeni zonke, yaziswa kubo bonke abantu, ukuthi babe sebelungile ngalolo suku.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.14",
            "verseOrgIds": [
              "EST.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
