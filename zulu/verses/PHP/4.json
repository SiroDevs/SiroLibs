              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabulani eNkosini njalonjalo; ngiyaphinda ngithi: Jabulani.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.4",
            "verseOrgIds": [
              "PHP.4.4"
            ]
          }
        }
      ]
