          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.7",
            "verseOrgIds": [
              "PHP.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elokugcina, bazalwane, konke okuyiqiniso, konke okuhle, konke okulungileyo, konke okuhlanzekileyo, konke okuthandekayo, konke okutusekayo; uma kukhona okuhle, noma kukhona ukubongwa, zindlani ngalezizinto.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.8",
            "verseOrgIds": [
              "PHP.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
