            "sid": "PHP 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningakhathazeki ngalutho; kodwa kukho konke izicelo zenu mazaziwe nguNkulunkulu ngokukhuleka nokunxusa kanye nokubonga.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.6",
            "verseOrgIds": [
              "PHP.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
