            "sid": "PHP 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akusikho ukuthi ngikhuluma ngokuswela, ngokuba mina ngifundile ukwaneliseka kunoma yisiphi isimo engikuso.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.11",
            "verseOrgIds": [
              "PHP.4.11"
