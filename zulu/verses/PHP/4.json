            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.6",
            "verseOrgIds": [
              "PHP.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuthula kukaNkulunkulu okudlula ukuqonda konke kuyakulondoloza izinhliziyo zenu nemicabango yenu kuKristu Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.7",
            "verseOrgIds": [
              "PHP.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
