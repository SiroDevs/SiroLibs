            "sid": "PHP 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakuncenga-ke nawe sithandwa sami esiqotho, ukuthi usize labo besifazane abashikashikeka kanye nami evangelini, kanye noKlemente, nezinye izisebenzi kanye nami, abamagama abo asencwadini yokuphila.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.3",
            "verseOrgIds": [
              "PHP.4.3"
            ]
          }
        }
      ]
    },
    {
