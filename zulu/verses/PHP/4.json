          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakwazi nokuba phansi, ngiyakwazi nokubusa; kukho konke nasezintweni zonke ngifundisiwe kokubili ukusutha nokulamba, nokubusa nokuswela.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.12",
            "verseOrgIds": [
              "PHP.4.12"
            ]
          }
        }
