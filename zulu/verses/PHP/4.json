            "sid": "PHP 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke, bazalwane bami abathandekayo nabalangazelelwayo, intokozo yami nomqhele wami, yimani niqinile kanjalo eNkosini, bathandwa bami.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.1",
            "verseOrgIds": [
              "PHP.4.1"
            ]
          }
        }
      ]
    },
    {
