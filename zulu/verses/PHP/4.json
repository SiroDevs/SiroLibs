          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukulinganisela kwenu makwaziwe yibo bonke abantu. INkosi iseduze.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.5",
            "verseOrgIds": [
              "PHP.4.5"
            ]
          }
        }
      ]
    },
    {
