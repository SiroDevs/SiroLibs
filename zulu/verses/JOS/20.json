              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wakhuluma kuJoshuwa, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.1",
            "verseOrgIds": [
              "JOS.20.1"
            ]
          }
        }
