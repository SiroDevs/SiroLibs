          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke niqalekisiwe, futhi akukho noyedwa kini oyokhululwa esigqileni, nakubagawuli bezinkuni, nemithombo yamanzi yendlu kaNkulunkulu wami.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.23",
            "verseOrgIds": [
              "JOS.9.23"
            ]
          }
        }
      ]
    },
