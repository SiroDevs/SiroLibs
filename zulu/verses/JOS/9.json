          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje bhekani, sisesandleni senu; yenza kithi njengokuhle nokulungile emehlweni akho.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.25",
            "verseOrgIds": [
