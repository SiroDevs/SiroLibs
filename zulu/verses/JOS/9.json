          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokhu sizakwenza kubo; futhi sizobayeka baphile, ukuze ulaka lungasehleleli ngenxa yesifungo esafunga kubo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.20",
