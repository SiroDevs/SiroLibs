          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "basebebuthana ukulwa nganhliziyonye loJoshuwa loIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.2",
            "verseOrgIds": [
              "JOS.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
