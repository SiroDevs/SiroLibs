      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekusithi lapho wonke amakhosi ayengaphetsheya kweJodani, ezintabeni, leezigodini, lakuyo yonke imikhawulo yoLwandle oluKhulu malungana leLebhanoni, amaHethi, lamaAmori, lamaKhanani, lamaPherizi, amaHivi namaJebusi ezwa ngakho;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.1",
            "verseOrgIds": [
              "JOS.9.1"
            ]
          }
        }
      ]
    },
    {
