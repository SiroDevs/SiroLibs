            "sid": "JOS 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawa angamakhosi ezwe uJoshuwa nabantwana bakwa-Israyeli abawahlula ngasempumalanga kweJordani ngasentshonalanga, kusukela eBali Gadi esigodini saseLebanoni kuze kufike ezintabeni zaseHalaki ezikhuphukela eSeyiri; uJoshuwa alinika izizwe zakwa-Israyeli njengefa ngokwezabelo zazo;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.7",
            "verseOrgIds": [
              "JOS.12.7"
            ]
          }
        }
      ]
    },
