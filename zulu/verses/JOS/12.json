          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banqoba uMose inceku kaJehova nabantwana bakwa-Israyeli; uMose, inceku kaJehova, walinika abakwaRubeni, nabakwaGadi, nenxenye yesizwe sakwaManase, laba yifa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.6",
            "verseOrgIds": [
              "JOS.12.6"
            ]
          }
        }
      ]
    },
    {
