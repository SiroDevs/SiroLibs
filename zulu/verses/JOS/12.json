          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezintabeni, nasezigodini, nasemathafeni, nasemithonjeni, nasehlane, naseningizimu; namaHeti, nama-Amori, namaKhanani, namaPherizi, namaHivi, namaJebusi;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.8",
