          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa wayesebasindisa uRahabi isifebe, nendlu kayise, nabo bonke anabo; wahlala kwa-Israyeli kuze kube namuhla; ngoba wafihla izithunywa uJoshuwa azithuma ukuhlola iJeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.25",
            "verseOrgIds": [
              "JOS.6.25"
            ]
          }
        }
