          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa wabaqalekisa ngaleso sikhathi, wathi: “Makaqalekiswe phambi kukaJehova umuntu osuka akhe lo muzi waseJeriko; uyakubeka isisekelo salo ngezibulo lakhe, futhi indodana yakhe encane iyomisa amasango alo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
