          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu basebekhamuluka lapho abapristi bebetha amacilongo; lapho abantu bezwa ukukhala kwecilongo, abantu bekhamuluka ngokukhamuluka okukhulu, ugange lwawa bhusma, kangangokuthi abantu bakhuphuka. Bangena emzini, wonke umuntu ephambi kwakhe, bawuthatha umuzi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.20",
            "verseOrgIds": [
              "JOS.6.20"
            ]
          }
        }
