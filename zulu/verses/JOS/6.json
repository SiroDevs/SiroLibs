          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawushisa umuzi ngomlilo nakho konke okwakukuwo, isiliva kuphela, negolide, nezinto zethusi, nezensimbi, bakubeka endlini yengcebo yendlu kaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.24",
            "verseOrgIds": [
              "JOS.6.24"
            ]
          }
        }
      ]
    },
    {
