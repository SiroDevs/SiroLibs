          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinsizwa ezaziyizinhloli zangena, zamkhipha uRahabi, noyise, nonina, nabafowabo, nakho konke anakho; bakhipha zonke izizukulwane zakhe, bazishiya ngaphandle kwekamu lika-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.23",
            "verseOrgIds": [
              "JOS.6.23"
            ]
