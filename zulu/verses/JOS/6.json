          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha lonke isiliva negolide nezitsha zethusi nezensimbi kungcweliselwe uJehova; kufanele ingene endlini yengcebo kaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.19",
