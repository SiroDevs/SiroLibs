          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje, uthi, susani onkulunkulu bezizweni abaphakathi kwenu, nithambekise inhliziyo yenu kuJehova uNkulunkulu ka-Israyeli.",
          "type": "text",
          "attrs": {
