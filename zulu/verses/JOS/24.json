          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bammbela emkhawulweni wefa lakhe eThimnati Sera ezintabeni zakwa-Efrayimi ngasenyakatho kwentaba iGahashi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
