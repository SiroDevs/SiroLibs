              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa wayesethi kubantu: “Aninakumkhonza uJehova, ngokuba unguNkulunkulu ongcwele; unguNkulunkulu onomhawu; kayikuthethelela iziphambeko zenu lezono zenu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.19",
            "verseOrgIds": [
              "JOS.24.19"
            ]
          }
        }
