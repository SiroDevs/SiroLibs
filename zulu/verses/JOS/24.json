          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Israyeli wamkhonza uJehova zonke izinsuku zikaJoshuwa nazo zonke izinsuku zamalunga asala kuJoshuwa futhi azi wonke usizi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        }
