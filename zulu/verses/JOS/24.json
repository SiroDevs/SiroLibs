              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngemva kwalezi zinto uJoshuwa indodana kaNuni, inceku kaJehova, wafa eneminyaka eyikhulu neshumi.",
          "type": "text",
