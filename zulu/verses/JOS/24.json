              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uJoshuwa wabahambisa abantu, kwaba yilowo nalowo waya efeni lakhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.28",
