          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amathambo kaJosefa abantwana bakwa-Israyeli abakhuphula ngawo eGibithe bawembela eShekemi endaweni uJakobe ayithenga emadodaneni kaHamori uyise kaShekemi ngamashekeli ayikhulu esiliva; ifa labantwana bakwaJosefa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.32",
            "verseOrgIds": [
              "JOS.24.32"
            ]
          }
        }
