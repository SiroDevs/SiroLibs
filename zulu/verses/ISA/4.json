            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi uJehova uyodala phezu kwayo yonke indawo yokuhlala yeNtaba iZiyoni naphezu kwamabandla ayo ifu nomusi emini nokukhanya komlilo ovuthayo ebusuku, ngoba phezu kwayo yonke inkazimulo kuyoba khona indawo yokucasha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
