            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyothi labo abasele eSiyoni, nalabo abasele eJerusalema bayobizwa ngokuthi bangcwele, wonke umuntu olotshwe phakathi kwabaphilayo eJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.3",
            "verseOrgIds": [
