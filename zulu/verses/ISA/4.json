          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolo suku inkatho kaJehova iyakuba yinhle nenkazimulo, nezithelo zomhlaba ziyakuba yinhle, zithandeke kwabaphunyukileyo kwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
