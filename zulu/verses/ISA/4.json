          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho uJehova ehlanza ukungcola kwamadodakazi aseSiyoni futhi ehlanza igazi laseJerusalema kulo ngomoya wokwahlulela nangomoya womlilo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.4",
            "verseOrgIds": [
