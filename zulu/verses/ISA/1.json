          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho usho kanje uJehova, uJehova Sebawoti, uMninimandla ka-Israyeli, uthi: “Ngiyakuzikhulula ezitheni zami, ngiziphindiselele ezitheni zami.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.24",
            "verseOrgIds": [
              "ISA.1.24"
            ]
          }
        }
      ]
    },
    {
