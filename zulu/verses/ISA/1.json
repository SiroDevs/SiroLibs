          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
