          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wozani manje siyilungise indaba, usho uJehova; noma izono zenu zibomvu kakhulu, ziyakuba mhlophe njengeqhwa; noma zibomvu njengokubomvu, ziyakuba njengoboya bezimvu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.18",
            "verseOrgIds": [
              "ISA.1.18"
            ]
          }
        }
      ]
    },
    {
