          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma nivuma, nilalela, niyakudla okuhle kwezwe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.19",
            "verseOrgIds": [
              "ISA.1.19"
            ]
          }
        }
