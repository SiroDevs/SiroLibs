          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba bazakuba lenhloni ngezihlahla ze-okhi enizifisayo, njalo lizakuba lenhloni ngezivande enizikhethileyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.29",
            "verseOrgIds": [
              "ISA.1.29"
            ]
          }
        }
      ]
