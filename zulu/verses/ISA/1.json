          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakubuyisela abahluleli bakho njengasekuqaleni, nabeluleki bakho njengasekuqaleni; emva kwalokho uyakubizwa ngokuthi: Umuzi wokulunga, umuzi othembekileyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.26",
            "verseOrgIds": [
              "ISA.1.26"
            ]
          }
        }
      ]
    },
    {
