          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "IZiyoni lizahlengwa ngokulunga, labaphendukayo balo ngokulunga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.27",
            "verseOrgIds": [
              "ISA.1.27"
            ]
          }
        }
      ]
