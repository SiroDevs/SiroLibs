          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiliva lakho seliyigwebu, iwayini lakho lixutshwe namanzi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.22",
            "verseOrgIds": [
              "ISA.1.22"
