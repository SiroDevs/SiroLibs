            "sid": "ISA 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uma nala, nihlubuka, niyakuqedwa ngenkemba, ngokuba umlomo kaJehova ukhulumile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.20",
            "verseOrgIds": [
              "ISA.1.20"
            ]
          }
        }
      ]
    },
