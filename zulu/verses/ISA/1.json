              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onamandla uyakuba njengentambo nomenzi wakho njengenhlansi, zivuthe zombili kanyekanye, kungabikho ocimayo.",
          "type": "text",
          "attrs": {
