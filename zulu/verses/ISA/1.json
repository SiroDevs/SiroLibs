          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukubhujiswa kwabaphambukayo nezoni kuyakuba kanyekanye, nabamshiyayo uJehova baphele.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.28",
            "verseOrgIds": [
