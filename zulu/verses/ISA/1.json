          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeka ukuthi umuzi othembekile usuphenduke kanjani isifebe! laligcwele ukwahlulela; ukulunga kwahlala khona; kodwa manje bangababulali.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.21",
            "verseOrgIds": [
              "ISA.1.21"
            ]
          }
        }
      ]
    },
