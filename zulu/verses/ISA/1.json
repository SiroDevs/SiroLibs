      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.24",
            "verseOrgIds": [
              "ISA.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngiyobuyisela isandla sami phezu kwakho futhi ngigeze amabibi akho ngisuse wonke amathini akho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.25",
            "verseOrgIds": [
              "ISA.1.25"
            ]
          }
        }
      ]
    },
