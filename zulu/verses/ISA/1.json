              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba lizakuba njengesihlahla se-okhi esibuna amahlamvu awo, lanjengensimu engelamanzi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.30",
            "verseOrgIds": [
