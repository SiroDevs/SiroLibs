          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izikhulu zakho ziyizihlubuki nabangane bamasela; wonke umuntu uthanda izipho futhi ujaha imivuzo; abahluleli izintandane, necala lomfelokazi alifiki kubo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.23",
            "verseOrgIds": [
              "ISA.1.23"
            ]
