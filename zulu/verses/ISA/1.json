          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.18",
            "verseOrgIds": [
              "ISA.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
