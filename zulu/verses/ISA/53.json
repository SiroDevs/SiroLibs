          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngubani owakholwa umbiko wethu? lengalo yeNKOSI yambulelwa bani?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
            ]
          }
        }
      ]
    },
    {
