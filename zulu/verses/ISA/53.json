          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.11",
            "verseOrgIds": [
              "ISA.53.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 53:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho ngiyakuyabela izabelo kanye nabakhulu, yahlukanise impango nabanamandla; ngokuba wawuthulula umphefumulo wakhe ekufeni, wabalelwa kanye nezoni; futhi wathwala izono zabaningi futhi wathandazela aboni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.12",
            "verseOrgIds": [
              "ISA.53.12"
            ]
          }
        }
      ]
