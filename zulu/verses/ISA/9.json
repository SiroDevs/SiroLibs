          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho uJehova uyakunquma kwa-Israyeli ikhanda nomsila, igatsha, nesikela ngalusuku lunye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.14",
            "verseOrgIds": [
              "ISA.9.14"
            ]
          }
        }
      ]
