      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba konke ukulwa kweqhawe kunomsindo ophithizelayo, nezingubo ezigingqelwe egazini; kodwa kuyakuba ngumlilo nezinkuni zomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
