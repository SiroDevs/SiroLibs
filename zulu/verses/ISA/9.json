            "sid": "ISA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ama-Aramu ngaphambili namaFilisti ngasemuva; futhi bayodla u-Israyeli ngemilomo evulekile. Kukho konke lokhu ulaka lwakhe alubuyanga, kodwa isandla sakhe sisaluliwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.12",
            "verseOrgIds": [
              "ISA.9.12"
            ]
          }
        }
      ]
    },
    {
