            "sid": "ISA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izitini ziwile, kepha siyakwakha ngamatshe abaziweyo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.10",
            "verseOrgIds": [
              "ISA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
