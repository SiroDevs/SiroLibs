              "ISA.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abantu bayokwazi, okungukuthi u-Efrayimi nabakhileyo eSamariya, abathi ngenhliziyo ezidlayo nenamandla:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.9"
            ]
          }
        }
      ]
    },
    {
