          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omdala nohloniphekileyo uyinhloko; nomprofethi ofundisa amanga ungumsila.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.15",
            "verseOrgIds": [
              "ISA.9.15"
            ]
          }
        }
