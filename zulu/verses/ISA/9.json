        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba abantu abaphendukeli kuye obashayayo, futhi abamfunanga uJehova Sebawoti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.13",
            "verseOrgIds": [
              "ISA.9.13"
            ]
          }
        }
