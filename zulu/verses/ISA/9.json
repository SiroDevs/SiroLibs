          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho uJehova uyakumvusela abamelene noResini, aqoqele ndawonye izitha zakhe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.11",
            "verseOrgIds": [
              "ISA.9.11"
            ]
          }
        }
