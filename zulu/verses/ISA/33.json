          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amehlo akho ayakubona inkosi ebuhleni bayo; ayakubona izwe elikude kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.17",
            "verseOrgIds": [
              "ISA.33.17"
            ]
          }
        }
