          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.8",
            "verseOrgIds": [
              "ISA.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umhlaba uyalila, udangele, iLebanoni limi ihlazo, ligawuliwe; iSharoni injengehlane; iBashani neKarmeli kuvuthulula izithelo zawo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.9",
            "verseOrgIds": [
              "ISA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.9",
            "verseOrgIds": [
              "ISA.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje ngizovuka, kusho uJehova; manje ngiyakuphakanyiswa; manje ngiyakuziphakamisa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.10",
            "verseOrgIds": [
              "ISA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.10",
            "verseOrgIds": [
              "ISA.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakhulelwa ngamakhoba, uzale amabibi; ukuphefumula kwakho kuyakuqeda njengomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.11",
            "verseOrgIds": [
              "ISA.33.11"
            ]
          }
        }
      ]
    },
    {
