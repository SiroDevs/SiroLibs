            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyakuhlala phezulu; isivikelo sakhe siyakuba yizikhali zamadwala; isinkwa uyakuphiwa; amanzi akhe ayakuqiniseka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.16",
            "verseOrgIds": [
              "ISA.33.16"
            ]
          }
        }
      ]
