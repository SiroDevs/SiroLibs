          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zwanini nina enikude, engikwenzileyo; nina eniseduze, niwazi amandla ami.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.13",
            "verseOrgIds": [
              "ISA.33.13"
            ]
          }
