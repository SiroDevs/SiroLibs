            "sid": "ISA 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izoni eZiyoni ziyesaba; ukwesaba kwabamangaza abazenzisi. Ngubani phakathi kwethu ozohlala emlilweni oqothulayo? ngubani phakathi kwethu oyohlala emlilweni ophakade na?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.14",
            "verseOrgIds": [
              "ISA.33.14"
            ]
          }
        }
      ]
    },
    {
