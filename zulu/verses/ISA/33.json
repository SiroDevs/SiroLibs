          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohamba ngokulunga nokhuluma ngobuqotho; odelela inzuzo yokuhlupheka, oxhawula izandla zakhe ekugodleni isifumbathiso, ovala izindlebe zakhe ukuze ezwe igazi, ovala amehlo akhe ukuba abone okubi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        }
      ]
    },
    {
