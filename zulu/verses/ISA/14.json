          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazibulo abampofu ayakudla, nabampofu bayakulala belondekile; ngiyakubulala impande yakho ngendlala, abulale insali yakho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.30",
            "verseOrgIds": [
              "ISA.14.30"
            ]
