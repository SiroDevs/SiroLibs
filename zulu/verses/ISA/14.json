              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova Sebawoti wafunga wathi: “Impela njengokucabanga kwami kuyakuba njalo; njengalokho ngihlosile, kuyakuma kanjalo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.24",
            "verseOrgIds": [
