          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakubonayo bayakukubheka, bakubuke, bathi: ‘Nguye lo muntu owazamazamisa umhlaba, owenza imibuso ithuthumele na?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.16",
            "verseOrgIds": [
              "ISA.14.16"
            ]
          }
        }
      ]
    },
    {
