              "ISA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakwenyukela ngaphezu kweziqongo zamafu; ngizofana noPhezukonke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.14",
            "verseOrgIds": [
              "ISA.14.14"
            ]
          }
        }
      ]
    },
