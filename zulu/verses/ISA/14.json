          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wokufa kwenkosi u-Ahazi kwaba lomthwalo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.28",
            "verseOrgIds": [
              "ISA.14.28"
