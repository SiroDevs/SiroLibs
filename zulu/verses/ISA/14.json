          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lesi yisinqumo esinqunyiwe emhlabeni wonke; yilesi isandla eselulelwe phezu kwezizwe zonke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.26",
