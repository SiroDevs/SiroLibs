          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngiyakubavukela, usho uJehova Sebawoti, nginqume eBabele igama, nensali, nendodana, nomshana, isho iNkosi.",
          "type": "text",
