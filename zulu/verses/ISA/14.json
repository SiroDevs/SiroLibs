          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hewula wena sango! biza, muzi! wena, lonke iPhalestine, ubhubhile, ngoba kuyovela umusi uvela enyakatho, futhi akekho oyoba yedwa ngezikhathi zakhe ezimisiwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.31",
            "verseOrgIds": [
              "ISA.14.31"
            ]
