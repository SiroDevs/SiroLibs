          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuthi ngiyakwephula umAsiriya ezweni lami, ngimnyathele ezintabeni zami; khona ijoka lakhe liyakumuka kubo, nomthwalo wakhe emahlombe abo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.25",
            "verseOrgIds": [
