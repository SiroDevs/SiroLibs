          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokho uyakwehliselwa endaweni yabafileyo, ekugcineni komgodi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.15",
            "verseOrgIds": [
              "ISA.14.15"
            ]
          }
        }
      ]
    },
