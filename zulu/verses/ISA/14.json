            "number": "15",
            "style": "v",
            "sid": "ISA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.15",
            "verseOrgIds": [
              "ISA.14.15"
            ]
          }
        },
        {
          "name": "verse",
