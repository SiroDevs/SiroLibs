          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhipha inqola, nehhashi, nempi, namandla; bayakulala phansi kanyekanye, abayikuvuka;",
          "type": "text",
          "attrs": {
