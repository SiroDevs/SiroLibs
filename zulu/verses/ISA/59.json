        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.16",
            "verseOrgIds": [
              "ISA.59.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 59:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ugqoke ukulunga njengesivikelo sesifuba nesigqoko sokuzivikela sensindiso ekhanda lakhe; wembatha izingubo zokuphindisela njengengubo, wembatha ukushisekela njengengubo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.17",
            "verseOrgIds": [
              "ISA.59.17"
            ]
          }
        }
      ]
    },
