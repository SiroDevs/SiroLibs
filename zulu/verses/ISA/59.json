        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.15",
            "verseOrgIds": [
              "ISA.59.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 59:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabona ukuthi kwakungekho muntu, wamangala ngokuthi kwakungekho mkhulumeli; ngalokho ingalo yakhe yamlethela insindiso; nokulunga kwakhe kwamsekela.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.16",
            "verseOrgIds": [
              "ISA.59.16"
            ]
          }
        }
      ]
    },
    {
