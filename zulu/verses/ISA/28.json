      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.15",
            "verseOrgIds": [
              "ISA.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho isho kanje iNkosi uJehova, ithi: Bheka, ngibeka eSiyoni itshe, itshe elivivinyiwe, itshe legumbi elinqabileyo, isisekelo esiqinile; okholwayo akayikuxhamazela.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.16",
            "verseOrgIds": [
              "ISA.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 28:16"
          },
          "items": [
