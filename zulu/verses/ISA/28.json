          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.14",
            "verseOrgIds": [
              "ISA.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba nithi: Senzile isivumelwano nokufa, sivumelana nendawo yabafileyo; uma isifo esibi sidlula, asiyikusehlela;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.15",
            "verseOrgIds": [
              "ISA.28.15"
            ]
          }
        }
      ]
    },
    {
