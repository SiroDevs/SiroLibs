        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.16",
            "verseOrgIds": [
              "ISA.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakubeka ukwahlulela umucu wokulinganisa, nokulunga kube intambo yomthofu wokumisa, isichotho sikhukhule isiphephelo samanga, amanzi akhukhule indawo yokucasha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.17",
            "verseOrgIds": [
              "ISA.28.17"
            ]
          }
        }
      ]
    },
    {
