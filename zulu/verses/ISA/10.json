              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhekani, uJehova, uJehova Sebawoti, uyakusiphula igatsha ngokwesabeka, nobude bobude bunqunywe, nabazidlayo bathotshiswe.",
          "type": "text",
          "attrs": {
