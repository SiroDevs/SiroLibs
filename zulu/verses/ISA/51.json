              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana akho anqotshiwe, alala emaphethelweni azo zonke izitaladi, njengenyamazana egajwe inetha; bagcwele ulaka lukaJehova, isijeziso sikaNkulunkulu wakho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.20",
            "verseOrgIds": [
