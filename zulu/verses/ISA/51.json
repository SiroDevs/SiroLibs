          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezizinto ezimbili zikwehlele; ngubani ozokuhawukela? ukubhujiswa nokuchithwa nendlala nenkemba; ngizoniduduza ngobani?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.19",
            "verseOrgIds": [
              "ISA.51.19"
