          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke, yizwani lokhu manje, nina enidakiwe futhi enidakiwe, kodwa kungengewayini!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.21",
            "verseOrgIds": [
