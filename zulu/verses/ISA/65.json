    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 65:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngifunwa yilabo abangangicelanga; Ngatholwa yilabo ababengangifuni; ngathi: Bheka, ngingowesizwe igama lami elingabizwanga phezu kwaso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.1",
            "verseOrgIds": [
              "ISA.65.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 65:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.1",
            "verseOrgIds": [
              "ISA.65.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 65:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngelulé izandla zami usuku lonke kubantu abahlubukayo, abahamba ngendlela engeyinhle, belandela imicabango yabo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.2",
            "verseOrgIds": [
              "ISA.65.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 65:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.2",
            "verseOrgIds": [
              "ISA.65.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 65:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abangiklolodela njalo ebusweni bami; abahlabela emasimini, bashise impepho ema-altare ezitini;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.3",
            "verseOrgIds": [
              "ISA.65.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 65:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.3",
            "verseOrgIds": [
              "ISA.65.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 65:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ababehlala emangcwabeni, belala emangcwabeni, bedla inyama yengulube, lesobho eliyisinengiso lisezintsheni zabo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.4",
            "verseOrgIds": [
              "ISA.65.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 65:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.4",
            "verseOrgIds": [
              "ISA.65.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 65:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "abathi: Yima wena, ungasondeli kimi; ngokuba mina ngingcwele kunawe. Kungumusi emakhaleni ami, umlilo ovutha usuku lonke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.5",
            "verseOrgIds": [
              "ISA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 65:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.5",
            "verseOrgIds": [
              "ISA.65.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 65:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, kulotshiwe phambi kobuso bami ukuthi: Kangiyikuthula, kepha ngiyakubabuyisela esifubeni sabo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.6",
            "verseOrgIds": [
              "ISA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 65:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.6",
            "verseOrgIds": [
              "ISA.65.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 65:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ububi benu nobubi bawoyihlo kanyekanye, usho uJehova, owathunqa umusi ezintabeni, wangihlambalaza emagqumeni; ngalokho ngiyakulinganisa umsebenzi wabo wangaphambili esifubeni sabo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.7",
            "verseOrgIds": [
              "ISA.65.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 65:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.7",
            "verseOrgIds": [
              "ISA.65.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 65:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova, uthi: “Njengalokhu kufunyanwa ulele ehlukuzweni, nokuthi: ‘Ungawubhubhisi; ngokuba isibusiso sikuyo; ngiyakwenza kanjalo ngenxa yezinceku zami, ukuze ngingababhubhisi bonke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.8",
            "verseOrgIds": [
              "ISA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 65:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.8",
            "verseOrgIds": [
              "ISA.65.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 65:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakuveza inzalo kuJakobe, nendlalifa yezintaba zami kuJuda; nabakhethiweyo bami bayakulidla, nezinceku zami ziyakuhlala khona.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.9",
            "verseOrgIds": [
              "ISA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 65:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.9",
            "verseOrgIds": [
              "ISA.65.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 65:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi iSharoni iyoba yizibaya nesigodi sase-Agori sibe yindawo yezinkomo yabantu bami abangifunile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.10",
            "verseOrgIds": [
              "ISA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 65:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.10",
            "verseOrgIds": [
              "ISA.65.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 65:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha nina ningabashiya uJehova, nikhohlwe intaba yami engcwele, nilungisele lelo bhande itafula, ninikele ngomnikelo wokuphuzwa walelo nani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.11",
            "verseOrgIds": [
              "ISA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 65:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.11",
            "verseOrgIds": [
              "ISA.65.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 65:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho ngizalibeka njengenkemba, njalo lizakhothama lonke phambi kokuhlatshwa; ngoba lapho ngibiza, kaliphendulanga; lapho ngikhuluma, anizwanga; kodwa ngenza okubi emehlweni ami, ngakhetha engingathokozi ngakho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.12",
            "verseOrgIds": [
              "ISA.65.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 65:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.12",
            "verseOrgIds": [
              "ISA.65.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 65:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho isho kanje iNkosi uJehova, ithi: Bhekani, izinceku zami ziyakudla, kepha nina niyakulamba; bhekani, izinceku zami ziyakuphuza, kepha nina niyokoma; bhekani, izinceku zami ziyakujabula, kepha nina niyakuba namahloni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.13",
            "verseOrgIds": [
              "ISA.65.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 65:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.13",
            "verseOrgIds": [
              "ISA.65.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 65:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhekani, izinceku zami ziyakuhlabelela ngokuthokoza kwenhliziyo, kepha nina niyokhala ngokudabuka kwenhliziyo, nikhale ngokudabuka komoya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.14",
            "verseOrgIds": [
              "ISA.65.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 65:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.14",
            "verseOrgIds": [
              "ISA.65.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 65:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe nishiye igama lenu njengesiqalekiso kwabakhethiweyo bami, ngoba iNkosi uJehova iyonibulala futhi ibize izinceku zayo ngelinye igama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.15",
            "verseOrgIds": [
              "ISA.65.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 65:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.15",
            "verseOrgIds": [
              "ISA.65.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 65:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuthi ozibusisayo emhlabeni uzakubusiswa kuNkulunkulu weqiniso; lalowo ofunga emhlabeni uzafunga uNkulunkulu weqiniso; ngoba izinhlupheko zakuqala sezikhohliwe, ngoba zisithekile emehlweni ami.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.16",
            "verseOrgIds": [
              "ISA.65.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 65:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.16",
            "verseOrgIds": [
              "ISA.65.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 65:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba bhekani, ngiyadala amazulu amasha nomhlaba omusha, futhi okokuqala ngeke kucatshangwe noma kufike emqondweni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.17",
            "verseOrgIds": [
              "ISA.65.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 65:17"
          },
          "items": [
