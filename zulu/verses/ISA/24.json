              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.12",
            "verseOrgIds": [
              "ISA.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho kunjena phakathi kwezwe phakathi kwabantu, kuyoba njengokuthuthumela kwesihlahla somnqumo nanjengokukhothoza kwezithelo zomvini lapho ukuvuna sekuphelile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.13",
            "verseOrgIds": [
              "ISA.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.13",
            "verseOrgIds": [
              "ISA.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayakuphakamisa izwi labo, bahlabelele ngobukhosi bukaJehova, bamemeze ngokuzwakalayo beselwandle.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.14",
            "verseOrgIds": [
              "ISA.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.14",
            "verseOrgIds": [
              "ISA.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke, dumisani uJehova emlilweni, igama likaJehova, uNkulunkulu ka-Israyeli, eziqhingini zolwandle.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.15",
            "verseOrgIds": [
              "ISA.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.15",
            "verseOrgIds": [
              "ISA.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sizwile amahubo avela emikhawulweni yomhlaba, athi: Udumo malube kolungileyo. Kodwa ngathi: Uzacile wami, uzacile wami, maye kimi! abathengisi abakhohlisayo benza ngokukhohlisa; yebo, abathengisi abakhohlisayo benza ngokukhohlisa okukhulu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.16",
            "verseOrgIds": [
              "ISA.24.16"
            ]
          }
        }
      ]
    },
    {
