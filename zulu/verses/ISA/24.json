        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.16",
            "verseOrgIds": [
              "ISA.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukwesaba nomgodi nogibe kuphezu kwakho wena owakhileyo emhlabeni!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.17",
            "verseOrgIds": [
              "ISA.24.17"
            ]
          }
        }
      ]
