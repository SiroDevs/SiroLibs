            "number": "15",
            "style": "v",
            "sid": "ISA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.15",
            "verseOrgIds": [
              "ISA.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyakuba khona umgwaqo wensali yabantu bakhe abasala e-Asiriya; njengalokho kwaba njalo ku-Israyeli mhla ekhuphuka ephuma ezweni laseGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.16",
            "verseOrgIds": [
              "ISA.11.16"
            ]
          }
        }
      ]
