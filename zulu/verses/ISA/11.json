          "type": "text",
          "attrs": {
            "verseId": "ISA.11.14",
            "verseOrgIds": [
              "ISA.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova uyakushaya ulimi lolwandle lwaseGibithe ngesiqalekiso; futhi ngomoya wakhe onamandla uyoxhawula isandla sakhe phezu komfula futhi awushaye emifuleni eyisikhombisa futhi enze abantu bahambe ngezicathulo ezomile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.15",
            "verseOrgIds": [
              "ISA.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
