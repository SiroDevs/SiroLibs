          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza okubi emehlweni kaJehova njengalokho benza ngakoyise, kasukanga ezonweni zikaJerobowamu indodana kaNebati onisa ngazo u-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.9",
            "verseOrgIds": [
              "2KI.15.9"
            ]
          }
        }
      ]
    },
