      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.7",
            "verseOrgIds": [
              "2KI.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wamashumi amathathu nesishiyagalombili ka-Azariya inkosi yakwaJuda uZakariya indodana kaJerobowamu wabusa kwa-Israyeli eSamariya izinyanga eziyisithupha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.8",
            "verseOrgIds": [
              "2KI.15.8"
            ]
          }
        }
      ]
    },
    {
