        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.6",
            "verseOrgIds": [
              "2KI.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Azariya wayeselala koyise; bammbela koyise emzini kaDavide; uJothamu indodana yakhe waba yinkosi esikhundleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.7",
            "verseOrgIds": [
              "2KI.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
