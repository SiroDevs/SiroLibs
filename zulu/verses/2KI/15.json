        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.5",
            "verseOrgIds": [
              "2KI.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye izindaba zika-Azariya nakho konke akwenzayo angithi kulotshiwe encwadini yezindaba zemihla ngemihla yamakhosi akwaJuda na?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.6",
            "verseOrgIds": [
              "2KI.15.6"
            ]
          }
        }
      ]
    },
    {
