        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.1",
            "verseOrgIds": [
              "2KI.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayeleminyaka elitshumi lesithupha lapho esiba yinkosi, wabusa iminyaka engamatshumi amahlanu lambili eJerusalema. Igama likanina lalinguJoliya waseJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.2",
            "verseOrgIds": [
              "2KI.15.2"
            ]
          }
        }
      ]
    },
    {
