            "sid": "2KI 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye izindaba zikaZakariya, bheka, zilotshiwe encwadini yezindaba zemihla ngemihla yamakhosi akwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.11",
