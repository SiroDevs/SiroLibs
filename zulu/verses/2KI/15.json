          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leli yizwi likaJehova alikhuluma kuJehu ngokuthi: “Amadodana akho ayakuhlala esihlalweni sobukhosi sika-Israyeli kuze kube isizukulwane sesine. Futhi kwenzeka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
            "verseOrgIds": [
              "2KI.15.12"
            ]
          }
        }
