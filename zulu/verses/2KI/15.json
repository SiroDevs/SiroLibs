          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza okulungile emehlweni kaJehova njengalokho enzile uyise u-Amasiya;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.3",
            "verseOrgIds": [
              "2KI.15.3"
            ]
          }
        }
