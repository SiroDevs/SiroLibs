            "number": "4",
            "style": "v",
            "sid": "2KI 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngaphandle kokuthi izindawo eziphakemeyo azisuswanga; abantu babesahlaba ezindaweni eziphakemeyo, benyusa impepho.",
          "type": "text",
          "attrs": {
