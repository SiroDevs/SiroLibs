          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wamashumi amabili nesikhombisa kaJerobowamu inkosi yakwa-Israyeli, u-Azariya indodana ka-Amasiya, inkosi yakwaJuda, waba yinkosi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.1",
            "verseOrgIds": [
              "2KI.15.1"
            ]
          }
        }
      ]
    },
    {
