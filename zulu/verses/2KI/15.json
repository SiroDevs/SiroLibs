          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMenahemu indodana kaGadi wakhuphuka eTirisa, weza eSamariya, wanqoba uShalumi indodana kaJabeshi eSamariya, wambulala, waba yinkosi esikhundleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.14",
            "verseOrgIds": [
              "2KI.15.14"
            ]
          }
        }
