          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UShalumi indodana kaJabeshi waba yinkosi ngomnyaka wamashumi amathathu nesishiyagalolunye ka-Uziya inkosi yakwaJuda; wabusa inyanga yonke eSamariya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.13",
            "verseOrgIds": [
              "2KI.15.13"
            ]
          }
        }
