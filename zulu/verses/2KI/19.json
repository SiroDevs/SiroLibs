            "style": "v",
            "sid": "2KI 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.27",
            "verseOrgIds": [
              "2KI.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba intukuthelo yakho ikhuphukele kimi, nokuxokozela kwakho ezindlebeni zami, ngiyakufaka ingwegwe yami ekhaleni lakho netomu lami emlonyeni wakho, ngikubuyisele endleleni oweza ngayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.28",
            "verseOrgIds": [
              "2KI.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.28",
            "verseOrgIds": [
              "2KI.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokhu kuyakuba-yisibonakaliso kuwe: Niyakudla izimilile zodwa kulo nyaka, nangomnyaka wesibili okumilile kukho; ngomnyaka wesithathu nihlwanyele, nivune, nitshale izivini, nidle izithelo zazo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.29",
            "verseOrgIds": [
              "2KI.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.29",
            "verseOrgIds": [
              "2KI.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Insali ephunyukileyo yendlu yakwaJuda iyobuye ibe nezimpande ngaphansi, ithele izithelo phezulu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.30",
            "verseOrgIds": [
              "2KI.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.30",
            "verseOrgIds": [
              "2KI.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba kuyakuphuma eJerusalema insali, nababalekayo entabeni yaseSiyoni; ukushisekela kukaJehova Sebawoti kuyakukwenza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.31",
            "verseOrgIds": [
              "2KI.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.31",
            "verseOrgIds": [
              "2KI.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho usho kanje uJehova ngenkosi yase-Asiriya, uthi: “Ayiyikungena kulo muzi, ingacibisheli imicibisholo khona, ingafiki phambi kwawo ngesihlangu, ingajikijeli igoqo kuwo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.32",
            "verseOrgIds": [
              "2KI.19.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.32",
            "verseOrgIds": [
              "2KI.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngendlela aweza ngayo, uyophindela emuva futhi angangeni kulo muzi, kusho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.33",
            "verseOrgIds": [
              "2KI.19.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.33",
            "verseOrgIds": [
              "2KI.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngiyakuwuvikela lo muzi ukuba ngiwusindise ngenxa yami nangenxa kaDavide inceku yami.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.34",
            "verseOrgIds": [
              "2KI.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
