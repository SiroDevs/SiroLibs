            "verseOrgIds": [
              "2KI.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke, Jehova Nkulunkulu wethu, sikhulule esandleni sakhe, ukuze yonke imibuso yomhlaba yazi ukuthi wena wedwa unguJehova uNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.19",
            "verseOrgIds": [
              "2KI.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.19",
            "verseOrgIds": [
              "2KI.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Isaya, indodana ka-Amose, wathumela kuHezekiya, wathi: “Usho kanje uJehova uNkulunkulu ka-Israyeli, uthi: Ngikuzwile lokho owakhuleka kimi ngoSaneheribi inkosi yase-Asiriya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.20",
            "verseOrgIds": [
              "2KI.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.20",
            "verseOrgIds": [
              "2KI.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yileli izwi uJehova alikhuluma ngaye; Intombi emsulwa, indodakazi yaseSiyoni, iyakudelela, yakuhleka; indodakazi yaseJerusalema yanikina ikhanda phezu kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.21",
            "verseOrgIds": [
              "2KI.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
