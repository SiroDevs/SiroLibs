              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.23",
            "verseOrgIds": [
              "2KI.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngemba ngaphuza amanzi angaziwayo, ngomisa ngamathe ezinyawo zami yonke imifula yezindawo ezivinjezelweyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.24",
            "verseOrgIds": [
              "2KI.19.24"
            ]
          }
        }
      ]
    },
    {
