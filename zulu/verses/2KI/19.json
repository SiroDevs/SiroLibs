            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anizwanga yini endulo ukuthi ngakwenza kanjani lokhu nokuthi ezikhathini zasendulo ngakubumba na? manje ngikwenzile ukuba uchithe imizi ebiyelweyo ibe yincithakalo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.25",
            "verseOrgIds": [
              "2KI.19.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
