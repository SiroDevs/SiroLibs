          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.25",
            "verseOrgIds": [
              "2KI.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho abakhileyo kuyo babeyingcosana, banqotshwa, bajabha; babenjengotshani basendle, nezitshalo eziluhlaza, notshani ophahleni, nokolweni opheshulwayo ungakakhuli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.26",
            "verseOrgIds": [
              "2KI.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 19:26"
          },
          "items": [
