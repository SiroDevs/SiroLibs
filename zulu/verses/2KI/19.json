        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.26",
            "verseOrgIds": [
              "2KI.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngiyakwazi ukuhlala kwakho lokuphuma kwakho lokungena kwakho lokungithukuthelela kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.27",
            "verseOrgIds": [
              "2KI.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
