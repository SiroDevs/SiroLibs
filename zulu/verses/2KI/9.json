          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekuhlangana laye umgadi wehhashi, wathi: Itsho njalo inkosi: Yikuthula yini? Wayesethi uJehu: “Unamsebenzi muni ngokuthula na? jikela emva kwami Umlindi wabika, wathi: “Isithunywa sifikile kubo, kepha asibuyi;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.18",
            "verseOrgIds": [
              "2KI.9.18"
            ]
          }
        }
      ]
