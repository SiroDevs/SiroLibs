          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.18",
            "verseOrgIds": [
              "2KI.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethuma owehhashi wesibili, weza kubo, wathi: “Isho kanje inkosi, ithi: Kuthula na? UJehu wasesithi: Ulani lokuthula? jikela emva kwami.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.19",
            "verseOrgIds": [
              "2KI.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 9:19"
          },
          "items": [
