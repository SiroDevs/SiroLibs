      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngomnyaka wesishiyagalolunye wokubusa kwakhe, ngenyanga yeshumi, ngolweshumi lwenyanga, uNebukadinesari, inkosi yaseBabele, yena nayo yonke impi yakhe, wafika eJerusalema, wamisa ngakulo; akha izinqaba ngakulo nxazonke.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.1",
            "verseOrgIds": [
              "2KI.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.1",
            "verseOrgIds": [
              "2KI.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuzi wavinjezelwa kwaze kwaba ngumnyaka weshumi nanye wenkosi uSedekiya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.2",
            "verseOrgIds": [
              "2KI.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.2",
            "verseOrgIds": [
              "2KI.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesishiyagalolunye lwenyanga yesine indlala yaba namandla emzini, kwakungekho sinkwa kubantu bezwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.3",
            "verseOrgIds": [
              "2KI.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.3",
            "verseOrgIds": [
              "2KI.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuzi wabhodlozwa, wonke amadoda empi abaleka ebusuku ngesango eliphakathi kwezingange ezimbili ezingasensimini yenkosi; amaKaledi ayemelene nomuzi nxazonke, inkosi yahamba yaya ethafeni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.4",
            "verseOrgIds": [
              "2KI.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.4",
            "verseOrgIds": [
              "2KI.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibutho lempi lamaKaledi layixosha inkosi, layifica emathafeni aseJeriko, yonke impi yayo yahlakazeka, yasuka kuyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.5",
            "verseOrgIds": [
              "2KI.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.5",
            "verseOrgIds": [
              "2KI.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayibamba inkosi, bayiyisa enkosini yaseBabele eRibila; basebemahlulela.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.6",
            "verseOrgIds": [
              "2KI.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.6",
            "verseOrgIds": [
              "2KI.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abulala amadodana kaZedekiya phambi kwamehlo akhe, amkhipha amehlo kaSedekiya, ambopha ngamaketanga ethusi, amyisa eBabele.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenyanga yesihlanu, ngosuku lwesikhombisa lwenyanga, okungukuthi, ngonyaka weshumi nesishiyagalolunye wenkosi uNebukadinesari, inkosi yaseBhabhiloni, uNebuzaradani, induna yemilindankosi, inceku yenkosi yaseBhabhiloni, wafika eJerusalema;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.8",
            "verseOrgIds": [
              "2KI.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.8",
            "verseOrgIds": [
              "2KI.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Washisa indlu kaJehova nendlu yenkosi nazo zonke izindlu zaseJerusalema nendlu yabo bonke abakhulu ngomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.9",
            "verseOrgIds": [
              "2KI.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.9",
            "verseOrgIds": [
              "2KI.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonke impi yamaKaledi eyayinenduna yemilindankosi yadiliza izingange zaseJerusalema nxazonke.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.10",
            "verseOrgIds": [
              "2KI.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
