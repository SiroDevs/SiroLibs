              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.27",
            "verseOrgIds": [
              "2KI.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakhuluma kahle kuye, wabeka isihlalo sakhe sobukhosi ngaphezu kwezihlalo zobukhosi zamakhosi ayenaye eBabele;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.28",
            "verseOrgIds": [
              "2KI.25.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.28",
            "verseOrgIds": [
              "2KI.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakhumula izingubo zakhe zasetilongweni, wadla isinkwa phambi kobuso bakhe zonke izinsuku zokuhamba kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.29",
            "verseOrgIds": [
              "2KI.25.29"
            ]
          }
        }
      ]
    },
    {
