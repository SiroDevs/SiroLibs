          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.18",
            "verseOrgIds": [
              "2KI.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emzini yathatha induna eyayimiswe phezu kwamadoda empi, lamadoda amahlanu ayesebusweni benkosi afunyanwa emzini, kanye lombhali webutho, owayeyinkosi. Abantu bezwe namadoda angamashumi ayisithupha kubantu bezwe abafunyanwa emzini;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.19",
            "verseOrgIds": [
              "2KI.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
