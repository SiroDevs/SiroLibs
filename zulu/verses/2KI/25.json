          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.13",
            "verseOrgIds": [
              "2KI.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhanzi, namafosholo, nezinkezo, nezinkezo, nezitsha zonke zethusi ababekhonza ngazo akuthatha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.14",
            "verseOrgIds": [
              "2KI.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 25:14"
          },
          "items": [
            {
              "text": "14",
