            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.16",
            "verseOrgIds": [
              "2KI.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuphakama kwenye insika kwakuyizingalo eziyishumi nesishiyagalombili, isihloko phezu kwayo sasiyithusi, nokuphakama kwesihloko kwakuyizingalo ezintathu; amabele nezinsingo nxazonke phezu kwesihloko, konke kwakungokwethusi;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
