            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.14",
            "verseOrgIds": [
              "2KI.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Induna yemilindankosi yazithatha imicengezi yomlilo nezitsha nakho konke okwakungokwegolide, igolide nesiliva, okuyisiliva.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.15",
            "verseOrgIds": [
              "2KI.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.15",
            "verseOrgIds": [
              "2KI.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinsika ezimbili, nolwandle olulodwa, nezinqola zokuwasha uSolomoni azenzela indlu kaJehova; ithusi lazo zonke lezi zinto lalingenakulinganiswa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.16",
            "verseOrgIds": [
              "2KI.25.16"
            ]
          }
        }
      ]
    },
    {
