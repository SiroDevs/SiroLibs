          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Induna yabalindi yathatha uSeraya umpristi omkhulu, noZefaniya, umpristi wesibili, nabalindisango abathathu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.18",
            "verseOrgIds": [
              "2KI.25.18"
            ]
          }
        }
