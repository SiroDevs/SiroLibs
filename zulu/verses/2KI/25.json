      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.20",
            "verseOrgIds": [
              "2KI.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yaseBabele yabashaya, yababulala eRibila ezweni laseHamati. Ngalokho uJuda wasuswa ezweni lakubo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha abantu abasala ezweni lakwaJuda, uNebukadinesari, inkosi yaseBabele, abashiyile, wabeka phezu kwabo uGedaliya, indodana ka-Ahikamu, indodana kaShafani, ukuba abe yisikhulu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.22",
            "verseOrgIds": [
              "2KI.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.22",
            "verseOrgIds": [
              "2KI.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho zonke izinduna zamabutho, zona namadoda azo, sezizwile ukuthi inkosi yaseBhabhiloni imise uGedaliya umbusi, zafika kuGedaliya eMispa: u-Ishmayeli indodana kaNethaniya, noJohanani, indodana kaKhareya, noSeraya, Indodana. KaThanhumethi umNethofa, noJahazaniya indodana yomMahagathi, bona namadoda abo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.23",
            "verseOrgIds": [
              "2KI.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
