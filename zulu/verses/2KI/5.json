        },
        {
          "text": "Wayesethi uNahamani: “Inceku yakho ayiyikunikwa iminyuzi emibili yomhlaba na? ngoba inceku yakho ayisayikunikela umnikelo wokutshiswa lomhlatshelo kwabanye onkulunkulu ngaphandle kweNKOSI.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.17",
            "verseOrgIds": [
              "2KI.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
