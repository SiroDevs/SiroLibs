      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.15",
            "verseOrgIds": [
              "2KI.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa wathi: Kuphila kukaJehova engimi phambi kwakhe, kangiyikwamukela muntu. Wamncenga ukuba asamukele; kodwa wala.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.16",
            "verseOrgIds": [
              "2KI.5.16"
            ]
          }
        }
      ]
    },
