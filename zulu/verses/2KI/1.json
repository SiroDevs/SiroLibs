        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathuma kuye enye induna yamashumi ayisihlanu inamashumi ayisihlanu ayo. Wasephendula wathi kuye: O muntu kaNkulunkulu, itsho njalo inkosi: Yehla masinyane;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        }
      ]
    },
