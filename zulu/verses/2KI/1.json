          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, kwehla umlilo ezulwini, washisa izinduna ezimbili zamashumi ayisihlanu zokuqala kanye namashumi ayisihlanu azo; ngalokho ukuphila kwami kumelwe kube yigugu manje emehlweni akho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.14",
            "verseOrgIds": [
              "2KI.1.14"
            ]
          }
        }
