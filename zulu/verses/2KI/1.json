          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Eliya waphendula wathi kubo: “Uma ngingumuntu kaNkulunkulu, makwehle umlilo ezulwini, ukudle wena namashumi omahlanu akho. Wehla umlilo kaNkulunkulu ezulwini, wayiqeda yena namashumi ayisihlanu akhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.12",
            "verseOrgIds": [
              "2KI.1.12"
            ]
          }
        }
