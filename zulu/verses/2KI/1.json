          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingelosi kaJehova yathi ku-Eliya: “Yehla naye; ningamesabi. Wasukuma wehla naye waya enkosini.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
