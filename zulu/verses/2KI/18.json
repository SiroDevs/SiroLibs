          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uthi, (kepha lawa ngamazwi ayize): Ngilamacebo lamandla okulwa. Pho nithemba bani ukuthi nihlubuke Kimi?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.20",
            "verseOrgIds": [
