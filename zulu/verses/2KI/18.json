          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngize ngifike nginiyise ezweni elinjengezwe lakini, izwe likakolweni nelewayini, izwe lesinkwa nezivini, izwe lamafutha omnqumo nezinyosi, ukuze niphile, ningafi; kuHezekiya, uma eniyenga ngokuthi: ‘UJehova uyakusisindisa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.32",
            "verseOrgIds": [
              "2KI.18.32"
            ]
          }
        }
      ]
    },
    {
