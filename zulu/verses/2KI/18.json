            "sid": "2KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi uHezekiya angalenzi nethembe uJehova ngokuthi: ‘UJehova uyakusophula nokusophula, nalo muzi awuyikunikelwa esandleni senkosi yase-Asiriya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.30",
            "verseOrgIds": [
              "2KI.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 18:30"
          },
          "items": [
