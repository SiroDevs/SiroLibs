            "sid": "2KI 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pho, ungabubuyisela kanjani emuva ubuso besinye sezikhulu zezinceku ezincane zenkosi yami, uthembele eGibithe ukuze uthole izinqola nabamahhashi?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.24",
            "verseOrgIds": [
              "2KI.18.24"
            ]
          }
        }
