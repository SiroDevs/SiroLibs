          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke u-Eliyakimi, indodana kaHilikiya, noShebina noJowaki bathi kumaRabi: “Khulumani ezincekwini zenu e-Aramu; ngoba siyakuzwa, kawukhulumi lathi ngolimi lwesiJuda ezindlebeni zabantu abasodongeni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.26",
            "verseOrgIds": [
              "2KI.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
