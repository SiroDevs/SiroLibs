          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khathesi yenza isibambiso enkosini yami, inkosi yeAsiriya, njalo ngizakunika amabhiza azinkulungwane ezimbili, uba ungabeka abagadi bamabhiza phezu kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.23",
