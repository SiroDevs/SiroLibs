          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukhona yini onkulunkulu bezizwe owasindisa izwe lakhe lonke esandleni senkosi yase-Asiriya na?",
          "type": "text",
