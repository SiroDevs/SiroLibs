        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningamlaleli uHezekiya, ngokuba isho kanje inkosi yase-Asiriya, ithi: Yenzani isivumelwano nami ngesipho, niphumele kimi, nidle, kube yilowo nalowo umvini wakhe, kube yilowo nalowo emkhiwaneni wakhe, niphuze, kube yilowo nalowo umvini wakhe. Wena amanzi omthombo wakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.31",
            "verseOrgIds": [
              "2KI.18.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
