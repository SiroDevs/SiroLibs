          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uma nithi kimi: ‘Simethemba uJehova uNkulunkulu wethu, akusiye ozindawo zakhe eziphakemeyo nama-altare akhe uHezekiya akudilizile, wathi kuJuda neJerusalema: “Niyakukhuleka phambi kwaleli altare eJerusalema na?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.22",
            "verseOrgIds": [
              "2KI.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
