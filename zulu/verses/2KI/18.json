            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itsho njalo inkosi: Kangalikhohlisi uHezekhiya, ngoba kayikuba namandla okulikhulula esandleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.29",
            "verseOrgIds": [
              "2KI.18.29"
            ]
          }
        }
      ]
    },
    {
