          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje mina ngaphandle kukaJehova ngimilé ukulwa nale ndawo ukuba ngiyichithe na? UJehova wathi kimi: ‘Khuphukela leli zwe, ulichithe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.25",
            "verseOrgIds": [
              "2KI.18.25"
            ]
          }
        }
