            "verseOrgIds": [
              "2KI.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesesukuma uRabishake, wamemeza ngezwi elikhulu ngolimi lwesiJuda, wakhuluma wathi: “Zwanini izwi lenkosi enkulu, inkosi yase-Asiriya!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.28",
            "verseOrgIds": [
              "2KI.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
