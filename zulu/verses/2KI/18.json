          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka-ke, wethemba udondolo lwalo mhlanga owaphukileyo waseGibithe, okuthi, uma umuntu encika kulo, luzakungena esandleni sakhe, lusihlabe; unjalo uFaro, inkosi yaseGibithe, nabo bonke abamethembayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.21",
            "verseOrgIds": [
              "2KI.18.21"
            ]
          }
        }
