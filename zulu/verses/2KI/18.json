            "number": "19",
            "style": "v",
            "sid": "2KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababhali bathi kubo: “Ake nisho kuHezekiya, nithi: ‘Isho kanje inkosi enkulu, inkosi yase-Asiriya, ithi: Yithemba lini leli olethembayo na?",
          "type": "text",
          "attrs": {
