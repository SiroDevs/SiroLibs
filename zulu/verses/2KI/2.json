          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waphuma, waya emthonjeni wamanzi, wathela usawoti kuwo, wathi: “Usho kanje uJehova, uthi: Ngenzile lawa manzi ukuba aphile; kusukela lapho akusayikuba khona indawo efileyo leyinkangala.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
        }
      ]
    },
