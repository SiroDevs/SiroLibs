            }
          ]
        },
        {
          "text": "Sebefikile kuye, ngokuba ehlezi eJeriko, wathi kubo: “Angishongo yini kini ukuthi: Ningahambi na?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
