          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.10",
            "verseOrgIds": [
              "HAG.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngabiza isomiso phezu kwezwe, naphezu kwezintaba, naphezu kukakolweni, naphezu kothuli, naphezu kwamafutha, naphezu kwalokho okuvezwa ngumhlabathi, naphezu kwabantu, naphezu kwezinkomo, naphezu kwawo wonke umsebenzi wezandla.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.11",
            "verseOrgIds": [
              "HAG.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
