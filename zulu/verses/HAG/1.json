          "type": "text",
          "attrs": {
            "verseId": "HAG.1.11",
            "verseOrgIds": [
              "HAG.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona uZerubhabhele indodana kaSheyalitiyeli, noJoshuwa indodana kaJehosadeki, umpristi omkhulu, nayo yonke insali yabantu balilalela izwi likaJehova uNkulunkulu wabo namazwi kaHagayi umprofethi, njengeNkosi uNkulunkulu wabo. Wamthuma, abantu besaba phambi kukaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.12",
            "verseOrgIds": [
              "HAG.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
