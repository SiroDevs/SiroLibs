          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.12",
            "verseOrgIds": [
              "HAG.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAG 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHagayi, isithunywa seNkosi, wakhuluma ebantwini ngelizwi leNkosi, wathi: Ngilani, kutsho i Nkosi.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
            "verseOrgIds": [
              "HAG.1.13"
            ]
          }
        }
      ]
    },
    {
