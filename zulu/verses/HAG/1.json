          "type": "text",
          "attrs": {
            "verseId": "HAG.1.14",
            "verseOrgIds": [
              "HAG.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAG 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwamashumi amabili nane lwenyanga yesithupha, ngomnyaka wesibili wenkosi uDariyu.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.15",
            "verseOrgIds": [
              "HAG.1.15"
            ]
          }
