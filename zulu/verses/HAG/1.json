        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
            "verseOrgIds": [
              "HAG.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAG 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wawuvusa umoya kaZerubabele indodana kaSheyalitiyeli, umbusi wakwaJuda, nomoya kaJoshuwa, indodana kaJehosadeki, umpristi omkhulu, nomoya wayo yonke insali yabantu; beza, basebenza endlini kaJehova Sebawoti, uNkulunkulu wabo;",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.14",
            "verseOrgIds": [
              "HAG.1.14"
            ]
          }
        }
      ]
    },
