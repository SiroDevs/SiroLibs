            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova Sebawoti, uthi: “Bhekani izindlela zenu.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.7",
            "verseOrgIds": [
              "HAG.1.7"
            ]
          }
        }
