          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza isihlalo somusa ngegolide elicwengekileyo, ubude baso buyizingalo ezimbili nenxenye, nobubanzi baso buyingalo nenxenye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.6",
            "verseOrgIds": [
              "EXO.37.6"
            ]
          }
        }
      ]
    },
    {
