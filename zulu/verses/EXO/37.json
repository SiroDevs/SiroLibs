          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza izinti ngomuthi womtholo, wazinameka ngegolide.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.4",
            "verseOrgIds": [
              "EXO.37.4"
