          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza itafula ngomuthi womtholo: ubude balo babuyizingalo ezimbili, ububanzi balo buyingalo, nokuphakama kwalo kwakuyingalo nenxenye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.10",
