          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UBesaleli wenza umphongolo ngomuthi womtholo; ubude bawo babuyizingalo ezimbili nenxenye, ububanzi bawo buyingalo nenxenye, nokuphakama kwawo kwakuyingalo nenxenye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.1",
            "verseOrgIds": [
              "EXO.37.1"
            ]
          }
        }
      ]
    },
    {
