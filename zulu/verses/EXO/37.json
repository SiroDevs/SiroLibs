          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakherubi awelula amaphiko awo phezulu, asibekela isihlalo somusa ngamaphiko awo, ubuso bawo bubhekene; ubuso bamakherubi babukhuphukela esihlalweni somusa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.9",
            "verseOrgIds": [
              "EXO.37.9"
