          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elinye ikherubi ekugcineni ngalapha nelinye ikherubi ngalapha nangalapha; wawenza esihlalweni somusa amakherubi emikhawulweni yaso yomibili.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.8",
            "verseOrgIds": [
              "EXO.37.8"
            ]
