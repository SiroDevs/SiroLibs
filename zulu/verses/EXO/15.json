          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebefikile eMara, babengelakuphuza amanzi aseMara, ngoba ayebaba; ngalokho igama layo lathiwa iMara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.23",
