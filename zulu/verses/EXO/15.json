          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova ungamandla ami nehubo lami, waba yinsindiso yami; unguNkulunkulu wami, ngiyakumlungisela indawo yokuhlala; uNkulunkulu kababa, ngiyakumphakamisa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        }
