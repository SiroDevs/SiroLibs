          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waphephetha ngomoya wakho, ulwandle lwabasibekela; bacwila emanzini anamandla njengomthofu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.10",
            "verseOrgIds": [
              "EXO.15.10"
            ]
