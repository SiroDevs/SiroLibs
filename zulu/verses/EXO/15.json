          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isandla sakho sokunene, Nkosi, sikhazimula ngamandla; Isandla sakho sokunene, Nkosi, sachoboza izitha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.6",
