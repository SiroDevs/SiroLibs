              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMozisi labantwana bakoIsrayeli basebehlabela lelihubo ekudumiseni iN, bakhuluma bathi: Ngizahlabelela iNKOSI, ngoba uphakeme kakhulu; Waphonsa ihhashi nomgibeli walo olwandle.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
