          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngobukhulu bobukhosi bakho wabachitha abakuvukelayo; Wathuma ulaka lwakho, lwabaqeda njengezinhlanga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.7",
            "verseOrgIds": [
              "EXO.15.7"
