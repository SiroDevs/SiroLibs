              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinqola zikaFaro lempi yakhe wakuphosela elwandle; nababusi bakhe abakhethiwe baminza eSchelfsee.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.4",
