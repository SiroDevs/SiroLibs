              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuphephetha kwamakhala akho amanzi abuthana ndawonye, imifula yema yaqondana njengenqwaba, notwa lwaqina enhliziyweni yolwandle.",
          "type": "text",
