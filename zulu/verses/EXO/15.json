              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukwesaba nokwesaba kuyakwehlela phezu kwabo; ngobukhulu bengalo yakho bayakuthula njengetshe; kuze kudlule abantu bakho, Nkosi, baze badlule abantu kulokho okuthengayo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.16",
            "verseOrgIds": [
