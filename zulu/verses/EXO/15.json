          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayibiza iNkosi; uJehova wambonisa umuthi awuphonsa emanzini; wabamisela khona isimiso nesimiso, wabavivinya khona.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
