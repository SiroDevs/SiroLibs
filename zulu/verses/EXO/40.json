        {
          "text": "Ubeke i-altare lomnikelo wokushiswa phambi komnyango wetende lokuhlangana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.6",
            "verseOrgIds": [
              "EXO.40.6"
