              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe ungenise itafula, uhlele izinto okufanele zihlelwe phezu kwalo; ungenise uthi lwesibani, ukhanyise izibani zalo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.4",
            "verseOrgIds": [
              "EXO.40.4"
