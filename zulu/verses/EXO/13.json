          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.16",
            "verseOrgIds": [
              "EXO.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uFaro esebayekele abantu bahambe, uNkulunkulu kabaholanga ngendlela yelizwe lamaFilisti, lanxa yayiseduze; ngoba uNkulunkulu wathi: Ukuze abantu bangaphenduki nxa bebona impi babuyele eGibhithe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.17",
            "verseOrgIds": [
              "EXO.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
