          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wakhuluma kuMose, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.11",
            "verseOrgIds": [
              "EXO.30.11"
            ]
          }
        }
