        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.15",
            "verseOrgIds": [
              "EXO.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe uthathe imali yokubuyisana kubantwana bakwa-Israyeli, uyihlukanisele inkonzo yetende lokuhlangana; ukuze kube yisikhumbuzo phambi kweNkosi kubantwana bakoIsrayeli, ukwenzela imiphefumulo yenu inhlawulo yokuthula.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.16",
            "verseOrgIds": [
              "EXO.30.16"
            ]
          }
        }
      ]
    },
