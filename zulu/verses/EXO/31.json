          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngamgcwalisa ngomoya kaNkulunkulu, ekuhlakanipheni, nasekuqondeni, nangokwazi, nangobungcweti bonke;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.3",
            "verseOrgIds": [
              "EXO.31.3"
            ]
          }
        }
