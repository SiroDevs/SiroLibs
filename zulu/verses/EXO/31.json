        {
          "text": "nasekuqopheni amatshe, awafake, nokubaze ngokhuni, enze yonke imisebenzi yobuciko.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.5",
            "verseOrgIds": [
              "EXO.31.5"
            ]
