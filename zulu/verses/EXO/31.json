          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "itende lokuhlangana, nomphongolo wobufakazi, nesihlalo somusa esiphezu kwawo, nempahla yonke yetabernakele;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.7",
            "verseOrgIds": [
              "EXO.31.7"
            ]
