            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke abantwana bakwa-Israyeli kumelwe bagcine isabatha ukuze bagcine isabatha ezizukulwaneni zabo njengesivumelwano esiphakade.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        }
      ]
    },
