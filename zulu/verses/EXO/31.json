              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "netafula nempahla yalo, nothi lwezibani oluhlanzekile, nempahla yalo yonke, ne-altare lempepho,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.8",
