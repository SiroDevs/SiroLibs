        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Khuluma futhi kubantwana bakwa-Israyeli, uthi: ‘Niyawagcina amasabatha ami, ngokuba ayisibonakaliso phakathi kwami nani ezizukulwaneni zenu; ukuze nazi ukuthi nginguJehova oningcwelisayo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.13",
            "verseOrgIds": [
              "EXO.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
