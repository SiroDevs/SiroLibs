        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kubo: “Isho kanje iNkosi uJehova uNkulunkulu ka-Israyeli, ithi: ‘Bekani, kube yilowo nalowo inkemba yakhe eceleni kwakhe, ningene, niphume esangweni, niye esangweni, phakathi kwekamu lonke, nibulale, kube yilowo nalowo umfowabo, kube yilowo nalowo umfowabo. Umngane, ngulowo lalowo umakhelwane wakhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.27",
            "verseOrgIds": [
              "EXO.32.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
