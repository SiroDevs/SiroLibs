              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.27",
            "verseOrgIds": [
              "EXO.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakwaLevi benza njengezwi likaMose; kwawa ngalolo suku kubantu kungathi izinkulungwane ezintathu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.28",
            "verseOrgIds": [
              "EXO.32.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
