          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho uMose ebona ukuthi abantu babenqunu; ngokuba u-Aroni wabanqunula, kwaba yihlazo phakathi kwezitha zabo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.25",
