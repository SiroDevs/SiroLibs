          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wema esangweni lekamu, wathi: “Ngubani ongakuJehova na? akeze kimi. Wonke amadodana kaLevi abuthana kuye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.26",
            "verseOrgIds": [
