          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamba manje, uhole abantu, ubayise endaweni engakhuluma ngayo kuwe; bheka, iNgelosi yami ihamba phambi kwakho; kepha mhla ngibahambela, ngiyakubahambela ngesono sabo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.34",
            "verseOrgIds": [
