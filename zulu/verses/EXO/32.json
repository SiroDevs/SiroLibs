          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMozisi wasesithi kuAroni: Lababantu benzeni kuwe ukuthi uzehlisele phezu kwabo isono esikhulu kangaka?",
          "type": "text",
