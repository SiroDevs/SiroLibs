          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyazi ukuthi inkosi yaseGibithe ayiyikunivumela ukuba nihambe, cha, kungengasandla esinamandla.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.19",
