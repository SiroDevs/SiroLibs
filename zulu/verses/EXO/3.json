        },
        {
          "text": "Ngathi: Ngiyakunikhuphula ekuhluphekeni kwaseGibithe, nginiyise ezweni lamaKhanani, namaHeti, nama-Amori, namaPherizi, namaHivi, namaJebusi, ezweni elichichima ubisi nezinyosi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.17",
            "verseOrgIds": [
              "EXO.3.17"
            ]
          }
        }
