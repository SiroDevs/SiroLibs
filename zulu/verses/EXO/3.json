            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe ufike, wena namadoda amadala akwa-Israyeli, enkosini yaseGibhithe, nithi kuyo: ‘INkosi, uNkulunkulu wamaHebheru, isihlangabeze; manje masihambe, uhambo lwezinsuku ezintathu siye ehlane, sihlabele uJehova uNkulunkulu wethu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.18",
            "verseOrgIds": [
              "EXO.3.18"
            ]
          }
        }
      ]
