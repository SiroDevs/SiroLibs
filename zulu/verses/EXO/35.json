            "sid": "EXO 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinsuku eziyisithupha kumelwe kusetshenzwe, kepha ngosuku lwesikhombisa kuyakuba kini usuku olungcwele, isabatha lokuphumula elivela kuJehova; wonke umuntu osebenza kulo kumele abulawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.2",
            "verseOrgIds": [
              "EXO.35.2"
            ]
          }
        }
      ]
    },
