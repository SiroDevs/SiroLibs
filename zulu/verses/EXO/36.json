            "sid": "EXO 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wazenza izihibe ezingamashumi ayisihlanu ekugcineni kwesilenge ekuhlanganeni, wazenza izihibe ezingamashumi ayisihlanu ekugcineni kwesilenge ekuhlanganeni kwesibili.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.17",
            "verseOrgIds": [
              "EXO.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
