          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomkhosi wokuvuna, ulibo lwezisebenzi zenu enizihlwanyele ezweni, nomkhosi wokubutha osekupheleni konyaka, lapho nibutha umshikashika wenu ezweni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
