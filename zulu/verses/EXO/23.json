          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe ugubhe umkhosi wesinkwa esingenamvubelo (izinsuku eziyisikhombisa uyakudla isinkwa esingenamvubelo, njengoba nje ngakuyala, ngesikhathi esimisiwe senyanga ka-Abibi, ngoba waphuma ngayo eGibhithe, futhi akekho oyolala phambi kwami ayiveli).",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.15",
            "verseOrgIds": [
              "EXO.23.15"
            ]
          }
        }
      ]
    },
    {
