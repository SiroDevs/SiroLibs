          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niqaphele kukho konke enginitshele khona; igama labanye onkulunkulu ningaliphathi, lingazwakala emlonyeni wenu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
            "verseOrgIds": [
              "EXO.23.13"
            ]
          }
        }
