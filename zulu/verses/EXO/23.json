        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungasakazi amahemuhemu; ungahlanganisi izandla nomubi ukuba ube ngufakazi ongalungile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
          }
        }
      ]
    },
    {
