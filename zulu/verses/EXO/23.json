              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuyikulahli amazinyane azo, kumbe oyinyumba elizweni lakini; inani lezinsuku zakho ngiyakuligcwalisa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.26",
