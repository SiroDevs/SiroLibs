          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungalethi igazi lesinkwa sami kanye lesinkwa esivutshelweyo; namanoni omhlatshelo wami akayikusala kuze kuse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
