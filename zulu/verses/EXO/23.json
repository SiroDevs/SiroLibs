              "type": "text"
            }
          ]
        },
        {
          "text": "Bangahlali ezweni lakini, funa bakwenze wone kimi; ngoba uma ukhonza onkulunkulu babo, kuzakuba lugibe kuwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.33",
