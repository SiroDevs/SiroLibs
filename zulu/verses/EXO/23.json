          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnakekele futhi ulalele izwi lakhe, ungamgconi; ngoba kayikuthethelela iziphambeko zenu, ngoba ibizo lami likuyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.21",
