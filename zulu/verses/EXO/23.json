          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba lilalela ilizwi lakhe, lenze konke engikutshoyo; khona ngiyakuba yisitha sezitha zakho, ngibe yisitha sabamelene nawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.22",
