          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngonyaka wesikhombisa kumelwe uwuyeke uphumule futhi uthule; ukuze abampofu babantu bakho badle; futhi ezikushiyayo, kumelwe kudliwe yizilwane zasendle. Kumelwe wenze ngendlela efanayo ngesivini sakho nangeminqumo yakho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
      ]
    },
    {
