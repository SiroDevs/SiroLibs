          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, ngiyathuma ingelosi phambi kwakho ukuba ikugcine endleleni, ikuyise endaweni engiyilungisileyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.20",
