          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyakumkhonza uJehova uNkulunkulu wenu, abusise ukudla kwenu namanzi enu; ngiyakususa ukugula phakathi kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.25",
