              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kangiyikubaxotsha phambi kwakho ngomnyaka owodwa; funa izwe libe yihlane, izilo zasendle zande phezu kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.29",
