              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakubaxosha kancane kancane phambi kwakho, uze wande, ulidle izwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.30",
