          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onendlebe makezwe lokho akushoyo uMoya emabandleni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.13",
            "verseOrgIds": [
              "REV.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
