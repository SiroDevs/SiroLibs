          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufanele, Nkosi, ukwamukela inkazimulo nodumo namandla, ngokuba wena wadala zonke izinto, nangokwentando yakho zikhona, zadalwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.11",
            "verseOrgIds": [
