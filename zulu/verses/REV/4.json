          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phambi kwesihlalo sobukhosi kwakukhona ulwandle lwengilazi lufana nekristalu, naphakathi kwesihlalo sobukhosi nasekuzungezeni isihlalo sobukhosi kukhona izidalwa ezine ezigcwele amehlo ngaphambili nangasemuva.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        }
      ]
    },
    {
