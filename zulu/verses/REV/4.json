            "sid": "REV 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi lapho lezo zilwane zinika inkazimulo nodumo nokubonga kuye ohlezi esihlalweni sobukhosi, ophilayo kuze kube phakade naphakade.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.9",
            "verseOrgIds": [
              "REV.4.9"
            ]
          }
        }
      ]
