          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.9",
            "verseOrgIds": [
              "REV.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalunga angamashumi amabili nane awa phansi phambi kwalowo ohlezi esihlalweni sobukhosi, akhuleka kuye ophilayo kuze kube phakade naphakade, ephonsa imiqhele yawo phambi kwesihlalo sobukhosi, ethi:",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.10",
            "verseOrgIds": [
              "REV.4.10"
            ]
          }
        }
      ]
    },
