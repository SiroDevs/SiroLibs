            "number": "4",
            "style": "v",
            "sid": "REV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.4",
            "verseOrgIds": [
              "REV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esihlalweni sobukhosi kuphuma imibani, nokuduma, namazwi, nezibani zomlilo eziyisikhombisa zivutha phambi kwesihlalo sobukhosi, ezingoMoya abayisikhombisa bakaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
