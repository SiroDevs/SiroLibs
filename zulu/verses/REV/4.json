        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.7",
            "verseOrgIds": [
              "REV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nezidalwa ezine, yileso naleso kuzo, zinamaphiko ayisithupha nxazonke; zazigcwele amehlo ngaphakathi, futhi aziphumuli imini nobusuku, zithi: Ingcwele, ingcwele, ingcwele, iNkosi uNkulunkulu uMninimandla onke, owayekhona, nokhona, nozayo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
