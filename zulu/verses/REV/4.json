          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokho ngabona, bheka, umnyango uvuliwe ezulwini, nezwi lokuqala engalizwayo lalinjengelecilongo likhuluma nami; lathi: Yenyukela lapha, ngizakutshengisa okuzakwenzeka emva kwalokhu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.1",
            "verseOrgIds": [
              "REV.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.1",
            "verseOrgIds": [
              "REV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njalo masinyane ngaba kuMoya; khangela-ke, isihlalo sobukhosi simisiwe ezulwini, lohlezi esihlalweni sobukhosi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        }
      ]
    },
    {
