          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base behamba bobabili baze bafika eBetlehema. Futhi lapho befika eBhetlehema, umuzi wonke waxokozela, wathi: Ingabe lo uNawomi?",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.19",
            "verseOrgIds": [
              "RUT.1.19"
            ]
