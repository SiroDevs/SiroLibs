              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kubo: “Ningangibizi ngokuthi uNawomi; ngibizeni ngokuthi uMara, ngokuba uSomandla ungiphathe kumunyu kakhulu.”",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.20",
