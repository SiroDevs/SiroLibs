          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.23",
            "verseOrgIds": [
              "EZK.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uma olungileyo ephenduka ekulungeni kwakhe, enze ukungalungi, enze izinengiso zonke omubi azenzayo, uyakuphila na? “Konke ukulunga kwakhe akwenzileyo akuyikubizwa;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.24",
            "verseOrgIds": [
              "EZK.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
