          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "lalowo ongenzi lezo mfanelo, kodwa wadla ezintabeni, wangcolisa umkamakhelwane wakhe;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.11",
            "verseOrgIds": [
              "EZK.18.11"
            ]
          }
        }
