          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasebenzisa inzuzo, wathatha inzuzo; uzophila ngaleso sikhathi? akayikuphila; zonke lezi zinengiso wazenza; uyakufa nokufa; igazi lakhe liyakuba phezu kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.13",
            "verseOrgIds": [
              "EZK.18.13"
            ]
          }
        }
      ]
    },
