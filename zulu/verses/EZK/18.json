        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma ezala indodana engumphangi, engumbulali, enze into enjalo kwenye yalezi zinto,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.10",
            "verseOrgIds": [
              "EZK.18.10"
            ]
          }
        }
      ]
    },
