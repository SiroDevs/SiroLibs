              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "owabamba isandla sakhe kompofu, owayengamukeli nzuzo nenzuzo, wagcina izimiso zami, wahamba ngezimiso zami; akayikufa ngenxa yobubi bukayise, uyakuphila impela.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
