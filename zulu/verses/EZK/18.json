          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka-ke, uma izala indodana ebona zonke izono zikayise azenzile, iqaphele, ingenzi okunjalo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.14",
            "verseOrgIds": [
              "EZK.18.14"
            ]
          }
        }
