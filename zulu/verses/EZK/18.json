              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ongadli ezintabeni, engaphakamiseli amehlo akhe ezithombeni zendlu kaIsrayeli, ongangcolisanga umkamakhelwane wakhe;",
          "type": "text",
          "attrs": {
