              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kimi: “Ndodana yomuntu, isho kanje iNkosi uJehova; Lezi ziyizimiso ze-altare ngosuku abalenza ngalo ukuba banikele ngomnikelo wokushiswa phezu kwalo, kufafazwe ngegazi phezu kwalo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.18",
            "verseOrgIds": [
              "EZK.43.18"
            ]
          }
        }
