          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe uthathe elinye igazi lawo uligcobe ezimpondweni zalo ezine nasemagumbini omane omuzi nasonqenqemeni nxazonke; ngakho kufanele uyihlanze futhi uyihlanze.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.20",
            "verseOrgIds": [
