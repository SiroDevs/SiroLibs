          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinsuku eziyisikhombisa kumelwe bahlanze i-altare futhi balihlanze; futhi kumelwe bazingcwelise.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.26",
