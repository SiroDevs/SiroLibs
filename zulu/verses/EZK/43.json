          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwunikele phambi kukaJehova, abapristi bathele usawoti kuwo, bawunikele njengomnikelo wokushiswa kuJehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.24",
            "verseOrgIds": [
              "EZK.43.24"
            ]
          }
        }
