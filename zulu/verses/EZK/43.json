        },
        {
          "text": "Isethi kumelwe ibe yizingalo eziyishumi nane ubude nezingalo eziyishumi nane ububanzi ezinhlangothini zayo ezine; udini nxazonke zalo uyakuba yingxenye yengalo; isinqe sawo sibe yingalo nxazonke; nezitebhisi zalo ziyobheka empumalanga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        }
