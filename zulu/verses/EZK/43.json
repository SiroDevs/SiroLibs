          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe uthathe inkunzi yomnikelo wesono, uyishise endaweni emisiwe yendlu, ngaphandle kwendlu engcwele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.21",
