          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho usuqedile ukulihlanza, kumelwe ulethe iduna elingenasici nenqama ephuma emhlanjini engenasici.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.23",
