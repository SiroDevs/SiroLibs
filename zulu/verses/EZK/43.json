          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesibili kumelwe ulungise impongo engenasici njengomnikelo wesono; bayakulihlambulula i-altare, njengalokho belihlambulule ngenkunzi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.22",
            "verseOrgIds": [
              "EZK.43.22"
