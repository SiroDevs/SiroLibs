              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyakulidla ifa lakho phambi kwamehlo ezizwe, nazi ukuthi nginguJehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.16",
