              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bezwe babecindezela futhi baphanga futhi bahlupha ompofu nompofu, yebo, bacindezela umfokazi ngokungafanele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.29",
