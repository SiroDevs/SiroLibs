            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inhliziyo yakho ingama yini, noma izandla zakho zibe namandla ezinsukwini engiyakuphathana nawe ngazo? Mina Jehova ngikukhulumile, futhi ngiyakukwenza.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.14",
            "verseOrgIds": [
              "EZK.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
