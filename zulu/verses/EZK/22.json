          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yebo, ngiyonibuthela ndawonye futhi nginivuthele ngomlilo wolaka lwami, futhi niyoncibilika phakathi kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.21",
