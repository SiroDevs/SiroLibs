              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi izwi likaJehova lafika kimi, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.1",
            "verseOrgIds": [
              "EZK.22.1"
            ]
          }
        }
