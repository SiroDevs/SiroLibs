          "attrs": {
            "verseId": "EZK.22.14",
            "verseOrgIds": [
              "EZK.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyokuhlakaza phakathi kwezizwe ngikuhlakaze emazweni ngichithe ukungcola kwakho kuwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.15",
            "verseOrgIds": [
              "EZK.22.15"
            ]
          }
        }
      ]
    },
