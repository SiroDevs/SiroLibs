              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndodana yomuntu, indlu ka-Israyeli isiphenduke igwebu kimi; konke kuyithusi nethini nensimbi nomthofu phakathi kwesithando; bangamagwala esiliva.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.18",
