          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakwakhiwe uhla nxazonke kuwo omane, lwenziwe ngezindawo zokupheka ngaphansi kwezinhla nxazonke.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.23",
