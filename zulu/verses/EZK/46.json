          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.15",
            "verseOrgIds": [
              "EZK.46.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 46:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isho kanje iNkosi uJehova, ithi: Uma isikhulu sinika enye yamadodana aso isipho, ifa layo kumelwe libe ngamadodana ayo; lizakuba yilifa labo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.16",
            "verseOrgIds": [
              "EZK.46.16"
            ]
          }
        }
      ]
    },
