          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 46:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uma sinika enye yezinceku zaso isipho efeni laso, siyoba ngesaso kuze kube unyaka wenkululeko; emva kwalokho liyakubuyela esikhulu, kepha ifa laso liyakuba ngelamadodana aso.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.17",
            "verseOrgIds": [
              "EZK.46.17"
            ]
          }
        }
      ]
    },
    {
