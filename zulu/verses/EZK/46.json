            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 46:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isikhulu asiyikuthatha ifa labantu ngokubacindezela ukubaxosha empahleni yabo; kodwa kumelwe inike amadodana ayo ifa empahleni yaso, ukuze abantu bami bangahlakazwa, yilowo nalowo asuke empahleni yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.18",
            "verseOrgIds": [
              "EZK.46.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
