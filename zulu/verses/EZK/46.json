        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emagumbini omane egceke kwakukhona amagceke ahlangeneyo, ayizingalo ezingamashumi amane ubude, nezingalo ezingamashumi amathathu ububanzi; lawa amagumbi omane ayeyisilinganiso sinye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.22",
            "verseOrgIds": [
              "EZK.46.22"
            ]
          }
        }
      ]
