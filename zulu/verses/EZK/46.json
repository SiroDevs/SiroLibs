          "type": "text",
          "attrs": {
            "verseId": "EZK.46.18",
            "verseOrgIds": [
              "EZK.46.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 46:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngemva kokuba ingingenise ngomnyango owawusohlangothini lwesango, emakamelweni angcwele abapristi abheke enyakatho;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.19",
            "verseOrgIds": [
              "EZK.46.19"
            ]
          }
        }
