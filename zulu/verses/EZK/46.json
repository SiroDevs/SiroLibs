          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.19",
            "verseOrgIds": [
              "EZK.46.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 46:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethi kimi: “Nansi indawo lapho abapristi bayakupheka khona umnikelo wecala nomnikelo wesono, lapho abayakuphekela khona umnikelo wokudla; ukuze bangalikhipheli egcekeni elingaphandle ukuze bangcwelise abantu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.20",
            "verseOrgIds": [
              "EZK.46.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
