            "number": "21",
            "style": "v",
            "sid": "EZK 46:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesengiyisa egcekeni elingaphandle, wangidlulisa emagumbini omane egceke; bheka, emagumbini onke egceke kwakukhona igceke.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.21",
            "verseOrgIds": [
              "EZK.46.21"
            ]
          }
        }
      ]
    },
    {
