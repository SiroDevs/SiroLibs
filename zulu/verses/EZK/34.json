            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.1",
            "verseOrgIds": [
              "EZK.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndodana yomuntu, profetha ngabelusi bakwa-Israyeli, profetha uthi kubo: ‘Isho kanje iNkosi uJehova kubelusi, uthi: Maye kubelusi bakwa-Israyeli abaziphakelayo! Akufanele yini abelusi baluse umhlambi?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.2",
            "verseOrgIds": [
              "EZK.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.2",
            "verseOrgIds": [
              "EZK.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nidla amanoni, nembatha uboya, nibulala akhuluphalisiweyo; kodwa awuwalusi umhlambi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.3",
            "verseOrgIds": [
              "EZK.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.3",
            "verseOrgIds": [
              "EZK.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezigulayo aniziqinisanga, nezigulayo aniziphilisanga, neziphukileyo anizibophanga, nezixoshiweyo anizibuyisanga, nezilahlekile anizifunanga; kepha wababusa ngobudlova nangonya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.4",
            "verseOrgIds": [
              "EZK.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.4",
            "verseOrgIds": [
              "EZK.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zahlakazeka ngenxa yokuthi zazingekho umalusi, zaba ukudla kwazo zonke izilwane zasendle lapho zihlakazekile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.5",
            "verseOrgIds": [
              "EZK.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.5",
            "verseOrgIds": [
              "EZK.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izimvu zami zazulazula kuzo zonke izintaba nakuwo wonke amagquma aphakemeyo, yebo, izimvu zami zazihlakazekile emhlabeni wonke, kungekho ozifunayo noma ozifunayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.6",
            "verseOrgIds": [
              "EZK.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
