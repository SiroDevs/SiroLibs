              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.15",
            "verseOrgIds": [
              "EZK.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyofuna elahlekile, futhi exoshiwe, ngizoyibuyisa, futhi ephukile, ngizoyibopha futhi egulayo ngizoyiqinisa; kepha okunonileyo nokunamandla ngiyakuchitha; ngizazondla ngokwahlulela.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.16",
            "verseOrgIds": [
              "EZK.34.16"
            ]
          }
        }
      ]
    },
