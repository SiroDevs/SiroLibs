          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakwenza isivumelwano sokuthula nabo, ngenze ukuba izilo ezimbi ziphele ezweni, zihlale ehlane ngokulondeka, zilale ehlathini;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.25",
