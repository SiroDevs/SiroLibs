            "number": "26",
            "style": "v",
            "sid": "EZK 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakuzenza zona nezindawo ezizungeza intaba yami zibe yisibusiso; ngiyakuwisa imvula ngesikhathi sayo; kuyakuba khona izihlambi zesibusiso.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.26",
