          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyinto encane kini ukuba nidle amadlelo amahle, nize ninyathele okuseleyo kwedlelo lenu ngezinyawo? waphuza emanzini ajulileyo, kepha uyakungcolisa insali ngezinyawo zakho na?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.18",
            "verseOrgIds": [
              "EZK.34.18"
            ]
          }
        }
      ]
    },
    {
