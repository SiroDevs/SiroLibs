      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
