            "number": "21",
            "style": "v",
            "sid": "EZK 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba washaya ngohlangothi nangehlombe, washaya zonke ezigulayo ngezimpondo zakho, waze wazihlakaza;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.21",
            "verseOrgIds": [
              "EZK.34.21"
            ]
          }
        }
