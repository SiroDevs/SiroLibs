          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho ngiyozisindisa izimvu zami, futhi ngeke zisaba yimpango; ngiyakwahlulela phakathi kwezinkomo nezinkomo.",
          "type": "text",
          "attrs": {
