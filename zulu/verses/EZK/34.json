          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngeke zisaba yimpango yezizwe, nezilwane zezwe aziyikuzidla; kodwa bayohlala ngokulondeka, futhi akekho oyobesabisa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.28",
