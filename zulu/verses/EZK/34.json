      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.18",
            "verseOrgIds": [
              "EZK.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umhlambi wami wona udla enikunyathele ngezinyawo zenu; baphuze lokho enikungcolisile ngezinyawo zenu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.19",
            "verseOrgIds": [
              "EZK.34.19"
            ]
          }
        }
      ]
