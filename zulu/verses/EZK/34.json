          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngiyobavusela isitshalo segama, futhi ngeke besaqedwa yindlala ezweni futhi ngeke besalithwala ihlazo lezizwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.29",
            "verseOrgIds": [
              "EZK.34.29"
            ]
