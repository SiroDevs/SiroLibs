          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayakwazi ukuthi mina, Jehova uNkulunkulu wabo, nginabo, nokuthi bona, indlu ka-Israyeli, bangabantu bami, isho iNkosi uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.30",
            "verseOrgIds": [
