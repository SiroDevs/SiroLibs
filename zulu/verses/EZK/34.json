          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke, belusi, yizwani izwi likaJehova;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.9",
            "verseOrgIds": [
              "EZK.34.9"
            ]
          }
        }
      ]
