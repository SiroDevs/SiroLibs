        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.6",
            "verseOrgIds": [
              "EZK.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke, belusi, yizwani izwi likaJehova;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.7",
            "verseOrgIds": [
              "EZK.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.7",
            "verseOrgIds": [
              "EZK.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuphila kwami, isho iNkosi uJehova, ngenxa yokuthi izimvu zami zibe yimpango, nezimvu zami zibe ngukudla kwazo zonke izilwane zasendle, ngokuba umalusi wayengekho, nabelusi bami bengazibhekanga izimvu zami, kepha abelusi bazidlisa bona, izimvu zami abazivumanga;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.8",
            "verseOrgIds": [
              "EZK.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.8",
            "verseOrgIds": [
              "EZK.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
