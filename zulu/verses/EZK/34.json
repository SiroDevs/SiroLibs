              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nina, zimvu zami, zimvu zedlelo lami, ningabantu, mina nginguNkulunkulu wenu, isho iNkosi uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.31",
