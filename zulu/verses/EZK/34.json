          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina, Jehova, ngiyoba nguNkulunkulu wazo, nenceku yami uDavide ibe yisikhulu phakathi kwazo; mina Jehova ngikukhulumile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.24",
            "verseOrgIds": [
              "EZK.34.24"
            ]
          }
        }
      ]
    },
