          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakumisa phezu kwazo umalusi oyedwa, azoluse, inceku yami uDavide; uyakuzondla, abe ngumalusi wazo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.23",
            "verseOrgIds": [
