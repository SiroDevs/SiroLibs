              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.19",
            "verseOrgIds": [
              "EZK.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho isho kanje iNkosi uJehova kubo; Bheka, ngiyakwahlulela phakathi kwezimvu ezikhulupheleyo nezimvu ezondile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.20",
            "verseOrgIds": [
              "EZK.34.20"
            ]
          }
        }
