          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isihlahla sasendle siyakuthela isithelo saso, nomhlabathi uthele izithelo zawo, balondeke ezweni labo, bazi ukuthi nginguJehova, lapho ngephula izibopho zejoka labo, ngibakhulule. Isandla sabazisebenzelayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.27",
            "verseOrgIds": [
              "EZK.34.27"
            ]
          }
        }
      ]
    },
