              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi likaJehova lafika kimi, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.1",
            "verseOrgIds": [
              "EZK.34.1"
            ]
