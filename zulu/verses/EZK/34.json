          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.12",
            "verseOrgIds": [
              "EZK.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyozihola ngizikhiphe ezizweni ngiziqoqe emazweni ngiziyise ezweni lazo futhi ngizenze ziklabe ezintabeni zakwa-Israyeli ngasemifuleni nakuzo zonke izindawo ezakhiweyo zezwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.13",
            "verseOrgIds": [
              "EZK.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.13",
            "verseOrgIds": [
              "EZK.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakuzalusela edlelweni elihle, nasezintabeni eziphakeme zakwa-Israyeli ayakuba yizibaya; ziyakulala khona edlelweni elihle, ziklabe edlelweni elivundile ezintabeni zakwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.14",
            "verseOrgIds": [
              "EZK.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
