              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.14",
            "verseOrgIds": [
              "EZK.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina ngiyakwelusa izimvu zami, ngizenze zibuthise, isho iNkosi uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.15",
            "verseOrgIds": [
              "EZK.34.15"
            ]
          }
        }
      ]
    },
