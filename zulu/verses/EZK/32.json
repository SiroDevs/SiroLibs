          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngomnyaka weshumi nambili, ngosuku lweshumi nanhlanu lwenyanga, izwi likaJehova lafika kimi, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.17",
            "verseOrgIds": [
              "EZK.32.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
