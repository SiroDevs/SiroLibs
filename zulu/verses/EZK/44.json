          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe kube yifa labo: Mina ngiyifa labo; aniyikubanika mpahla kwa-Israyeli; Mina ngiyimpahla yabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.28",
            "verseOrgIds": [
              "EZK.44.28"
            ]
          }
        }
