          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho bengena emasangweni egceke elingaphakathi, bayakwembatha ilineni; uboya bezimvu abuyikuba phezu kwabo, lapho bekhonza emasangweni egceke elingaphakathi nangaphakathi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.17",
            "verseOrgIds": [
              "EZK.44.17"
            ]
          }
        }
