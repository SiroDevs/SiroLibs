              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe badle umnikelo womlilo nomnikelo wesono nomnikelo wecala; futhi konke okungcwelisiwe kwa-Israyeli kuyakuba ngokwakho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.29",
