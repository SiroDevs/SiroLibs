          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayikuphuca amakhanda abo, bangavumeli izihluthu zabo zibe zide; bayolinganisa amakhanda abo kuphela.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.20",
