          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe babe namabhande elineni emakhanda abo namabhulukwe elineni okhalweni; bangase bangabhinci noma yini ebangela umjuluko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.18",
            "verseOrgIds": [
              "EZK.44.18"
            ]
