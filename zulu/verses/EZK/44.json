          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho bephumela egcekeni elingaphandle, egcekeni elingaphandle kubantu, kumelwe bakhumule izingubo zabo ababekhonza benazo, bazibeke phansi emakamelweni angcwele, bagqoke ezinye izingubo; futhi ngeke bangcwelise abantu ngezingubo zabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.19",
            "verseOrgIds": [
              "EZK.44.19"
            ]
          }
        }
