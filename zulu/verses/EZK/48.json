            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasemdeni kaJuda, kusukela ohlangothini lwasempumalanga kuze kube sohlangothini lwasentshonalanga, umnikelo oyakuletha uyakuba yizinhlanga eziyizinkulungwane ezingamashumi amabili nanhlanu ububanzi nobude njengesinye sezinye, kusukela ohlangothini lwasempumalanga kuze kube sentshonalanga nendlu engcwele kumelwe ibe kuyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
