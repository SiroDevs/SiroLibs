            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinkulungwane ezinhlanu ezisele ebubanzini ngokumelene nezinkulungwane ezingamashumi amabili nanhlanu ziyakuba yindawo eyinqambi yomuzi, indawo yokuhlala nedlelo; umuzi kumelwe ube phakathi kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        }
      ]
    },
    {
