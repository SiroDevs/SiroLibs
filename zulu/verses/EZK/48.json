            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe kube ngeyabapristi abangcwelisiwe emadodaneni kaSadoki; abagcina inkonzo yami, abangadukanga ekudukeni kwabantwana bakwa-Israyeli njengokuduka kwamaLevi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        }
