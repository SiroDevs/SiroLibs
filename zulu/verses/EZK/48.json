            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasemdeni ka-Efrayimi, kusukela ohlangothini lwasempumalanga kuze kube sohlangothini lwasentshonalanga uRubeni, libe linye.",
          "type": "text",
          "attrs": {
