          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umnikelo womlilo oyowuletha kuJehova kumelwe ube yizinkulungwane ezingamashumi amabili nanhlanu ubude nezinkulungwane eziyishumi ububanzi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
