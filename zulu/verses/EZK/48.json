          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasemkhawulweni wakwa-Asheri, kusukela ohlangothini lwasempumalanga kuze kube sohlangothini lwasentshonalanga, uNafetali, uyakuba nesabelo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        }
