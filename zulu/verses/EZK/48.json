          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasemdeni kaNafetali, kusukela ohlangothini lwasempumalanga kuze kube sohlangothini lwasentshonalanga uManase, libe linye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
