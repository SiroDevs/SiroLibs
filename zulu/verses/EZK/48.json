          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eceleni komkhawulo kaManase, kusukela ohlangothini lwasempumalanga kuze kube sohlangothini lwasentshonalanga, u-Efrayimi abe nesabelo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
