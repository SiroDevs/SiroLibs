            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngaphezu komkhawulo wabapristi amaLevi ayakuba nezinkulungwane ezingamashumi amabili nanhlanu ubude nezinkulungwane eziyishumi ububanzi; bonke ubude bube ngamashumi amabini anamahlanu amawaka, nobubanzi bube lishumi lamawaka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        }
      ]
    },
