            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezi ziyakuba yizilinganiso zakhe; icala lasenyakatho ngamawaka amane anamakhulu amahlanu, icala langasezantsi libe ngamawaka amane anamakhulu amahlanu, icala lasempumalanga libe ngamawaka amane anamakhulu amahlanu, icala lasentshonalanga libe ngamawaka amane anamakhulu amahlanu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        }
      ]
    },
