          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ekuseni izwi likaJehova lafika kimi, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.8",
            "verseOrgIds": [
              "EZK.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
