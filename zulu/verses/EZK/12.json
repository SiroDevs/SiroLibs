          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.10",
            "verseOrgIds": [
              "EZK.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yithi: Mina ngiyisibonakaliso senu; njengalokho ngenzile, kuyakwenziwa kanjalo kubo; bayakumuka, baye ekuthunjweni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.11",
            "verseOrgIds": [
              "EZK.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.11",
            "verseOrgIds": [
              "EZK.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isikhulu esiphakathi kwabo siyakuthwala ehlombe, sihambe kuhwalala; bayobhoboza udonga ukuze balikhiphe; uyosibekela ubuso, ukuze angawuboni umhlaba ngamehlo akhe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.12",
            "verseOrgIds": [
              "EZK.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 12:12"
