            "number": "8",
            "style": "v",
            "sid": "EZK 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.8",
            "verseOrgIds": [
              "EZK.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndodana yomuntu, indlu ka-Israyeli, indlu ehlubukayo, ayishongo yini kuwe ukuthi: ‘Wenzani na?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.9",
            "verseOrgIds": [
              "EZK.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.9",
            "verseOrgIds": [
              "EZK.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakuthi kibo: Itsho njalo iNkosi uJehova; Lo mthwalo ungowesikhulu saseJerusalema nayo yonke indlu yakwa-Israyeli ephakathi kwayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.10",
            "verseOrgIds": [
              "EZK.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
