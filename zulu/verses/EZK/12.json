        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.7",
            "verseOrgIds": [
              "EZK.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
