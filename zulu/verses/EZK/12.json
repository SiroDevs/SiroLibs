          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngizayekela amadoda ambalwa kubo asale enkembeni, endlaleni lesifo; ukuze bashumayele zonke izinengiso zabo phakathi kwezizwe lapho beza khona; bazakwazi ukuthi nginguJehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.16",
            "verseOrgIds": [
              "EZK.12.16"
            ]
          }
        }
