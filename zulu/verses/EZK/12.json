        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.12",
            "verseOrgIds": [
              "EZK.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngiyozendlala phezu kwayo, futhi iyobanjwa ngenetha lami; ngiyakumyisa eBabele ezweni lamaKaledi; nokho akayikuyibona, noma efela khona.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.13",
            "verseOrgIds": [
              "EZK.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
