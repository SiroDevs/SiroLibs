          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyakuba kubo njengokubhula kwamanga phambi kwamehlo abo, kulabo abafunga isifungo;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.23",
            "verseOrgIds": [
              "EZK.21.23"
            ]
