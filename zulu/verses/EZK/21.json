        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakuhlehlisa, ngikuhlehlise, ngikuhlehlise; futhi ngeke kusaba khona aze afike lowo okungelungelo lakhe; futhi ngizomnika yona.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.27",
            "verseOrgIds": [
              "EZK.21.27"
            ]
          }
        }
      ]
    },
