        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wena-ke, ndodana yomuntu, profetha uthi: ‘Isho kanje iNkosi uJehova ngokuphathelene nabantwana bakwa-Amoni nangesihlamba sabo; ngisho nani nithi: ‘Inkemba, inkemba ihoshiwe; ngenxa yokuhlatshwa kwephulwa ukuze kugaywe ngenxa yokubenyezela.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
