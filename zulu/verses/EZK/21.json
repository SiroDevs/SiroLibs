              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi likaJehova lafika kimi, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.1",
            "verseOrgIds": [
              "EZK.21.1"
            ]
          }
        }
