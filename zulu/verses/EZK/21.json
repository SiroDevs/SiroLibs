            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho bekubona ngeze, bekhuluma amanga kuwe, ukuze bakwehlisele phezu kwezintamo zalabo abanqotshiweyo, ababi abalusuku lwabo lufikile lokuthi ububi babo buphele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.29",
            "verseOrgIds": [
              "EZK.21.29"
            ]
          }
        }
      ]
    },
