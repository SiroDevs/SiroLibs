          "attrs": {
            "verseId": "EZK.21.31",
            "verseOrgIds": [
              "EZK.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakuba yinkuni yomlilo; igazi lakho liyakuba phakathi kwezwe; awusayikukhunjulwa, ngokuba mina Jehova ngikukhulumile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.32",
