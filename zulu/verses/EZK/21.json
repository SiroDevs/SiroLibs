        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.24",
            "verseOrgIds": [
              "EZK.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nawe, sikhulu esibi sakwa-Israyeli, osuku lwakho lufikile, lapho ububi buphela,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.25",
            "verseOrgIds": [
              "EZK.21.25"
            ]
          }
        }
      ]
    },
