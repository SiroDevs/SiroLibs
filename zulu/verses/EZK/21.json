          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.19",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misa indlela, ukuze inkemba ifike eRabbati labantwana bakwa-Amoni nakwaJuda eJerusalema, umuzi oyisivikelo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.20",
            "verseOrgIds": [
              "EZK.21.20"
            ]
          }
        }
      ]
    },
