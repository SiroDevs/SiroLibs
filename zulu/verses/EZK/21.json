            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakwesokunene sakhe kwakukhona ukubhula ngeJerusalema, ukumisa ababusi, ukuvula umlomo ekubulaweni, ukuphakamisa izwi ngokumemeza, ukubeka izinhlaka emasangweni, ukuphonsa intaba nokwakha inqaba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.22",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        }
      ]
    },
