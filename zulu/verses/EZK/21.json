          "attrs": {
            "verseId": "EZK.21.25",
            "verseOrgIds": [
              "EZK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isho kanje iNkosi uJehova, ithi: Susa isigqoko, ukhumule umqhele; akuyi kufana: phakamisani ophansi, nehlise ophakeme.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.26",
            "verseOrgIds": [
              "EZK.21.26"
            ]
          }
        }
      ]
    },
