          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho isho kanje iNkosi uJehova, ithi: Ngokuba nikhumbulile ububi benu, ngokuba iziphambeko zenu zambulwa, ukuze izono zenu zibonakale kuzo zonke izenzo zenu; ngokuba, ngithi, senikhunjulwe, niyobanjwa ngesandla.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.24",
            "verseOrgIds": [
              "EZK.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
