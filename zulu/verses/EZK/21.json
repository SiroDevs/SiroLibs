            "verseOrgIds": [
              "EZK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakuthulula phezu kwakho ukufutheka kwami, ngikuvuthele ngomlilo wokufutheka kwami, ngikunikele esandleni sabantu abayizihlakaniphi nabanekhono lokubhubhisa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.31",
            "verseOrgIds": [
              "EZK.21.31"
            ]
          }
        }
      ]
    },
