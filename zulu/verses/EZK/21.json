        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wena ndodana yomuntu, zibeke ezindleleni ezimbili, ukuze kufike inkemba yenkosi yaseBabele, ziphume ezweni elilodwa zombili; futhi uzikhethele indawo, uyikhethe ekuqaleni komgwaqo oya edolobheni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.19",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
