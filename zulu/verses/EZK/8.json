          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesithi kimi: Phenduka futhi, njalo uzabona izinengiso ezinkulu abazenzayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.13",
            "verseOrgIds": [
              "EZK.8.13"
            ]
          }
        }
      ]
    },
