      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.15",
            "verseOrgIds": [
              "EZK.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangingenisa egcekeni elingaphakathi lendlu kaJehova; bheka, ekungeneni kwethempeli likaJehova phakathi kompheme ne-altare, kwakukhona amadoda kungathi angamashumi amabili nanhlanu, efulathele ithempeli. Evela kuJehova, nobuso babo bubheke empumalanga; bakhuleka elangeni ngasempumalanga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.16",
            "verseOrgIds": [
              "EZK.8.16"
            ]
          }
        }
      ]
    },
