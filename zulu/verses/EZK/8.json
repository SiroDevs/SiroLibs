          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.13",
            "verseOrgIds": [
              "EZK.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesengiyisa ekungeneni kwesango lendlu kaJehova elingasenyakatho; bheka, kwakuhlezi abesifazane belilela uTamuzi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.14",
            "verseOrgIds": [
              "EZK.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 8:14"
          },
          "items": [
