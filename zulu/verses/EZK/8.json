          "type": "text",
          "attrs": {
            "verseId": "EZK.8.12",
            "verseOrgIds": [
              "EZK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
