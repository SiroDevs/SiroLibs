              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.14",
            "verseOrgIds": [
              "EZK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethi kimi: “Uyakubona lokhu, ndodana yomuntu na? Phenduka, njalo uzabona izinto ezesabekayo ezinkulu kulalezi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.15",
            "verseOrgIds": [
              "EZK.8.15"
            ]
          }
        }
      ]
    },
    {
