            "style": "v",
            "sid": "EZK 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.16",
            "verseOrgIds": [
              "EZK.31.16"
            ]
          }
        },
