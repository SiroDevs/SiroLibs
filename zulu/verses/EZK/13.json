          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyakungingcolisa yini phakathi kwabantu bami ngenxa yezandla ezigcwele zebhali nangezingcezu zesinkwa, ukuze nibulale imiphefumulo ebingayikufa, nisindise imiphefumulo ebingafuni ukuphila, ngokuqambela amanga kubantu bami abezwa amanga enu, na?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.19",
            "verseOrgIds": [
              "EZK.13.19"
            ]
          }
        }
      ]
    },
