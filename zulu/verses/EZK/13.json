          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngalokho isho kanje iNkosi uJehova, ithi: Bhekani, ngimelene nezicamelo zenu enizingela ngazo imiphefumulo ukuba ziyindiza, ngiyakubahlwitha ezingalweni zenu, ngikhulule imiphefumulo eniyizingelayo ukuba niyibulale. Ndiza.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.20",
            "verseOrgIds": [
              "EZK.13.20"
            ]
          }
        }
      ]
    },
