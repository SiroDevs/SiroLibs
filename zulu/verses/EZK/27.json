          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idlelo liyothuthumela ngokuzwakala kokumemeza kwabashayeli bakho bezindiza.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.28",
            "verseOrgIds": [
