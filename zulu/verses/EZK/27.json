          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abaphatha izigwedlo, amatilosi nabo bonke abashayeli basolwandle bayakwehla emikhunjini yabo, beme emhlabathini;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.29",
