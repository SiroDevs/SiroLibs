          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekukhaleni kwabo bayakunenzela isililo, balilele, bathi: ‘Ngumuphi umuzi onjengeTire, onjengencithakalo phakathi kolwandle, na?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.32",
            "verseOrgIds": [
              "EZK.27.32"
            ]
          }
        }
      ]
    },
