          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "izwi labo lizwakale ngokumelene nawe, bakhale kamunyu, bathele uthuli emakhanda abo, babhuquze emlotheni;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.30",
            "verseOrgIds": [
              "EZK.27.30"
            ]
          }
        }
