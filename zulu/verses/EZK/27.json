          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esikhathini lapho uyakwaphulwa khona ulwandle ekujuleni kwamanzi, impahla yakho ethengiswayo nesixuku sakho sonke kuyakuwa phakathi kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.34",
            "verseOrgIds": [
