          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingcebo yakho, nempahla yakho, nempahla yakho, namatilosi akho, nabashayeli bakho, nezindlu zakho zokulala, nabathengi bakho bempahla yakho, nawo onke amadoda akho empi aphakathi kwakho, naso sonke isixuku sakho esiphakathi kwakho. Wena, uyowela phakathi kolwandle ngosuku lokubhujiswa kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.27",
            "verseOrgIds": [
              "EZK.27.27"
            ]
          }
        }
      ]
    },
    {
