          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba babengabathengi bakho ngazo zonke izinhlobo zezinto, izingubo eziluhlaza nezilukiweyo namabhokisi endwangu enothileko eboshwe ngezintambo ngokhuni lomsedari phakathi kwempahla yakho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.24",
            "verseOrgIds": [
