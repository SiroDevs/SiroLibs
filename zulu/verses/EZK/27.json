          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "IHarana, neKhane, ne-Edene, abathengisi baseSheba, nase-Ashuri, naseKilimadi, babe ngabathengi bakho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.23",
