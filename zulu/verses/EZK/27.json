        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho impahla yakho iphuma elwandle, wasuthisa abantu abanengi; Wanothisa amakhosi omhlaba ngobuningi bengcebo yakho nempahla yakho ethengiswayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.33",
            "verseOrgIds": [
              "EZK.27.33"
            ]
          }
        }
      ]
    },
    {
