          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izigwedlo zakho zakungenisa emanzini amakhulu; umoya wasempumalanga wakuphula phakathi kolwandle.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.26",
