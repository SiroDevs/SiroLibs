            "verseId": "EZK.27.24",
            "verseOrgIds": [
              "EZK.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imikhumbi yaseTharishishi yacula ngawe esigcawini sakho, wasuthiswa wakhazimula kakhulu phakathi kolwandle.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.25",
            "verseOrgIds": [
              "EZK.27.25"
            ]
          }
        }
