          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayozihlubula ngokuphelele ngenxa yakho, babhince indwangu yesaka, bakukhalele ngomunyu wenhliziyo nangokukhala okumunyu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.31",
            "verseOrgIds": [
              "EZK.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
