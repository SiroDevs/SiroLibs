          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhlangothi lwaseningizimu ngaseningizimu, lusukela eTamari, luye emanzini eMeribha eKadeshi, nomfula, kuze kube seLwandle Olukhulu. Lolu yilo uhlangothi lwaseningizimu ngaseningizimu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.19",
            "verseOrgIds": [
              "EZK.47.19"
            ]
          }
        }
