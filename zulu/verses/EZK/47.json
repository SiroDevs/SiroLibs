            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umngcele osuka olwandle uyakuba yiHasarenani, umkhawulo waseDamaseku, nenyakatho ukuya ngasenyakatho, nomngcele waseHamati. Lolu wuhlangothi lwasenyakatho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.17",
            "verseOrgIds": [
              "EZK.47.17"
            ]
          }
        }
      ]
