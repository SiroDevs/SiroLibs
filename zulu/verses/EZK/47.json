            "sid": "EZK 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehlangothini lwasempumalanga liyakulinganisa kusukela eHaurani naseDamaseku naseGileyadi nasezweni lakwa-Israyeli ngaseJordani, kusukela emngceleni kuze kufike oLwandle LwaseBaltiki. Lolu wuhlangothi lwasempumalanga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.18",
            "verseOrgIds": [
              "EZK.47.18"
            ]
          }
        }
      ]
    },
