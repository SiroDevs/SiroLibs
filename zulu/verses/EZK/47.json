          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho kumelwe nihlukanisele leli zwe ngokwezizwe zakwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.21",
