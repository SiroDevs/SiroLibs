          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.19",
            "verseOrgIds": [
              "ROM.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yebo; ngenxa yokungakholwa aphulwa, wena umi ngokukholwa. Ungazikhukhumezi, kodwa yesaba;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.20",
            "verseOrgIds": [
              "ROM.11.20"
            ]
          }
        }
      ]
    },
    {
