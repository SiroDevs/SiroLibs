          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.21",
            "verseOrgIds": [
              "ROM.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho bheka ububele nobukhali bukaNkulunkulu: ubukhali kulabo abawayo; kodwa kuwe ububele, uma uqhubeka ebuhleni bakhe;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.22",
            "verseOrgIds": [
              "ROM.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.22",
            "verseOrgIds": [
              "ROM.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo-ke, uma bengahlali ekungakholweni, bayakufakelwa, ngokuba uNkulunkulu unamandla okubuye abaxhume.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.23",
            "verseOrgIds": [
              "ROM.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.23",
            "verseOrgIds": [
              "ROM.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uma wena wanqunywa emnqumweni wasendle ngokwemvelo, waxhunyelelwa esihlahleni somnqumo omuhle ngokuphambene nemvelo, kakhulu kangakanani labo abangabemvelo bayakuxhunyelelwa esihlahleni sabo somnqumo na?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.24",
            "verseOrgIds": [
              "ROM.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.24",
            "verseOrgIds": [
              "ROM.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba angithandi, bazalwane, ukuba ningayazi le mfihlakalo, funa nizishaye abahlakaniphileyo; ukuthi ukuphuphutheka kwehlele uIsrayeli ngokwengxenye, kuze kungene ukugcwala kwabezizwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.25",
            "verseOrgIds": [
              "ROM.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.25",
            "verseOrgIds": [
              "ROM.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
