          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngubani owazi umqondo weNkosi na? Ngubani obe ngumeluleki wakhe na?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.34",
            "verseOrgIds": [
              "ROM.11.34"
            ]
          }
        }
      ]
