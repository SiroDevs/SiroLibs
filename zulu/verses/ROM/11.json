          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwevangeli bayizitha ngenxa yenu;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.28",
            "verseOrgIds": [
              "ROM.11.28"
            ]
          }
        }
      ]
