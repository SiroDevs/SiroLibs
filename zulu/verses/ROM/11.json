          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba njengalokhu lani kade lingamkholwa uNkulunkulu, kodwa khathesi selihawukelwe ngenxa yokungakholwa kwabo;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.30",
            "verseOrgIds": [
              "ROM.11.30"
            ]
          }
        }
      ]
    },
