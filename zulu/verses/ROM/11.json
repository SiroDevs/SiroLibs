          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba lesi yisivumelwano sami nabo, lapho ngisusa izono zabo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.27",
            "verseOrgIds": [
              "ROM.11.27"
            ]
          }
        }
      ]
    },
