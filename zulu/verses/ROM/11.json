          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokunjalo wonke uIsrayeli uyakusindiswa, njengokulotshiweyo ukuthi: Kuzavela eSiyoni uMkhululi, asuse ukungahloniphi uNkulunkulu kuJakobe;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.26",
            "verseOrgIds": [
              "ROM.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
