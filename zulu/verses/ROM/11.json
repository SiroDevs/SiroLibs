          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyakuthi-ke: Amagatsha aphulwa, ukuze mina ngixhunyelelwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.19",
            "verseOrgIds": [
              "ROM.11.19"
            ]
          }
        }
      ]
    },
