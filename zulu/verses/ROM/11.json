          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uNkulunkulu ubavalele bonke ekungakholweni, ukuze abe lesihawu kibo bonke.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.32",
            "verseOrgIds": [
              "ROM.11.32"
            ]
          }
        }
