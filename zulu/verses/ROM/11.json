          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokunjalo nalaba manje abakholwanga, ukuze ngesihawu sakho nabo bahawukelwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.31",
            "verseOrgIds": [
              "ROM.11.31"
            ]
          }
        }
