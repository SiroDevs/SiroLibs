          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeka ukujula kwengcebo nokuhlakanipha nokwazi kukaNkulunkulu! Yeka ukuthi aziphenyeki kanjani izahlulelo zakhe, nezindlela zakhe aziphenyeki!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.33",
            "verseOrgIds": [
              "ROM.11.33"
            ]
          }
        }
      ]
    },
