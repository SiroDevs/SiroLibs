          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uma ngesiphambeko somuntu oyedwa ukufa kwabusa ngalowo munye; kakhulukazi abemukela ukuvama komusa nokwesipho sokulunga bayakubusa ekuphileni ngalowo munye, uJesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.17",
            "verseOrgIds": [
              "ROM.5.17"
            ]
          }
        }
      ]
    },
