            "sid": "ROM 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho lokhu sesilungisisiwe ngokukholwa, sinokuthula kuNkulunkulu ngeNkosi yethu uJesu Kristu;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.1",
            "verseOrgIds": [
              "ROM.5.1"
            ]
          }
        }
      ]
    },
    {
