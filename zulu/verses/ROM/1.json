              "type": "text"
            }
          ]
        },
        {
          "text": "esamukele ngaye umusa nobuphostoli, kube ngukulalela ekukholweni phakathi kwezizwe zonke ngenxa yegama lakhe;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.5",
            "verseOrgIds": [
              "ROM.1.5"
            ]
