            "style": "v",
            "sid": "ROM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuqala, ngibonga uNkulunkulu wami ngoJesu Kristu ngani nonke, ngokuba ukukholwa kwenu kukhulunywa ngakho emhlabeni wonke.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.8",
            "verseOrgIds": [
              "ROM.1.8"
            ]
          }
        }
