          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaguqule iqiniso likaNkulunkulu libe ngamanga, bakhuleka, bakhonza okudaliweyo kunoMdali obongekayo kuze kube phakade. Amen.",
          "type": "text",
