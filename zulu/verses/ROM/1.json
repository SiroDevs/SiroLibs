          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uNkulunkulu engimkhonza ngomoya wami evangelini leNdodana yakhe ungufakazi wami wokuthi angiphezi ukunikhumbula emikhulekweni yami;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.9",
            "verseOrgIds": [
              "ROM.1.9"
            ]
          }
        }
      ]
