              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ukulunga kukaNkulunkulu kwembulwa kulo, kuvela ekukholweni kuye ekukholweni, njengokulotshiweyo ukuthi: Olungileyo uyakuphila ngokukholwa.",
          "type": "text",
          "attrs": {
