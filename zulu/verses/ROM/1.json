              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanjengalokho bengathandanga ukuba nokwazi uNkulunkulu, uNkulunkulu wabanikela engqondweni eyonakeleyo, ukuba benze okungafanele;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
