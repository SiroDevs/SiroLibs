          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho uNkulunkulu wabanikela ekuhuhukeni okuyichilo, ngokuba nabesifazane babo baguqula ukwenza kwemvelo kwaba ngokuphambene nemvelo;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.26",
