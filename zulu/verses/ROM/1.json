        },
        {
          "text": "UPawulu, inceku kaJesu Kristu, owabizelwa ukuba ngumphostoli, owahlukaniselwa ivangeli likaNkulunkulu,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.1",
            "verseOrgIds": [
