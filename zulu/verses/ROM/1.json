          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba lokho okwaziwayo ngoNkulunkulu kusobala kubo; ngoba uNkulunkulu ukubonakalisile kubo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.19",
