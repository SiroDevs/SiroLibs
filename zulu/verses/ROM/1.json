          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayelana neNdodana yakhe uJesu Kristu iNkosi yethu, owavela enzalweni kaDavide ngokwenyama;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.3",
            "verseOrgIds": [
              "ROM.1.3"
            ]
          }
