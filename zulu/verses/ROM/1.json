              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba anginamahloni ngevangeli likaKristu, ngokuba lingamandla kaNkulunkulu kube yinsindiso kulowo nalowo okholwayo; kumJuda kuqala, nakumGreki futhi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.16",
            "verseOrgIds": [
              "ROM.1.16"
            ]
          }
        }
