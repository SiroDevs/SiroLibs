              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngilangazelela ukunibona, ukuze nginabele isipho esithile somoya, ukuze niqiniswe;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.11",
            "verseOrgIds": [
