          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba okungabonwayo kwakhe, amandla akhe aphakade nobuNkulunkulu bakhe kubonakala kwasekudalweni kwezwe, kuqondakala ngezenzo zakhe; ukuze bangabi lezaba;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.20",
            "verseOrgIds": [
              "ROM.1.20"
            ]
