          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngincenga ukuthi, mhlawumbe mhlawumbe khathesi ngiphumelele uhambo oluphumelelayo ngentando kaNkulunkulu, lokuza kini.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.10",
            "verseOrgIds": [
              "ROM.1.10"
            ]
          }
        }
      ]
    },
