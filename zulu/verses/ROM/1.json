              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "futhi yabonakaliswa ukuthi iyiNdodana kaNkulunkulu ngamandla, ngomoya wobungcwele, ngokuvuka kwabafileyo;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.4",
            "verseOrgIds": [
              "ROM.1.4"
            ]
