              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke uNkulunkulu wabanikela ezinkanukweni zezinhliziyo zabo ekungcoleni, bahlazisane imizimba yabo phakathi kwabo;",
          "type": "text",
          "attrs": {
