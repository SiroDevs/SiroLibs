              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "begcwele konke ukungalungi, ukukhohlakala, ukufisa, ububi; begcwele umona, ukubulala, ukuphikisana, inkohliso, ubuxhwanguxhwangu; abahlebezi,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
              "ROM.1.29"
            ]
          }
