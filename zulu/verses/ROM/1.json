          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba sebemazi uNkulunkulu, kabamdumisanga njengoNkulunkulu, kababonganga; kodwa baba yize emicabangweni yabo, nenhliziyo yabo ewubuwula yaba mnyama.",
          "type": "text",
