              "type": "text"
            }
          ]
        },
        {
          "text": "Yebo, ngokunjalo ngazama ukushumayela ivangeli, kungeyisikho lapho uKristu abizwa khona, ukuze ngingakhi phezu kwesisekelo somunye;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.20",
            "verseOrgIds": [
