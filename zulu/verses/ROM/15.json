          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke thina esinamandla sifanele ukuthwala ubuthakathaka bababuthakathaka, singazithokozisi thina.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.1",
            "verseOrgIds": [
              "ROM.15.1"
            ]
          }
        }
      ]
    },
    {
