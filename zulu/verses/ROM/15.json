        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.15",
            "verseOrgIds": [
              "ROM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze ngibe yisikhonzi sikaJesu Kristu kwabezizwe, ngikhonze ivangeli likaNkulunkulu, ukuze umnikelo kwabezizwe wamukeleke, ungcwelisiwe ngoMoya oNgcwele.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.16",
            "verseOrgIds": [
              "ROM.15.16"
            ]
          }
        }
      ]
    },
