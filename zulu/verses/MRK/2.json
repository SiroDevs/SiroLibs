        },
        {
          "text": "Kepha abafundi bakaJohane nabafundi babaFarisi babezila ukudla, beza bathi kuye: “Kungani abafundi bakaJohane nabafundi babaFarisi bezila ukudla, kepha abafundi bakho abazili na?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.18",
            "verseOrgIds": [
              "MRK.2.18"
            ]
          }
        }
