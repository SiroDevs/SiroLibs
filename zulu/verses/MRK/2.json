          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakho othungela isiziba esingakashukeki engutsheni endala, funa okusha okubekelwayo kuklebhule kwendala, kwande ukuklebhuka.",
          "type": "text",
          "attrs": {
