          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wathi kubo: “Abendlu yomyeni bangazila yini ukudla, umyeni esenabo na? inqobo nje uma umyeni ekanye nabo, abanakuzila ukudla.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.19",
            "verseOrgIds": [
