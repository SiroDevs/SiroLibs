          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa zizakufika izinsuku, lapho umyeni ezakususwa kubo; yikhona-ke bezakuzila ngalolo suku.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.20",
            "verseOrgIds": [
              "MRK.2.20"
