          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamsusa esixukwini, wafaka iminwe yakhe ezindlebeni zakhe, wafela amathe, wathinta ulimi lwakhe;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.33",
            "verseOrgIds": [
              "MRK.7.33"
            ]
