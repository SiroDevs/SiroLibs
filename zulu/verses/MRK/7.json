        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasuka lapho, waya emikhawulweni yaseTire neSidoni, wangena endlini, ethanda ukuba kungaziwa muntu, kepha akakwazanga ukucasha.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.24",
            "verseOrgIds": [
              "MRK.7.24"
            ]
          }
        }
      ]
    },
    {
