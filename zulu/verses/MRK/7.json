          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngaphakathi, enhliziyweni yomuntu kuphuma imicabango emibi, ukuphinga, ubufebe, ukubulala,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.21",
            "verseOrgIds": [
              "MRK.7.21"
            ]
          }
        }
      ]
    },
