          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesefika endlini yakhe, wafumana idemoni liphumile, nendodakazi ilele embhedeni.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.30",
            "verseOrgIds": [
              "MRK.7.30"
            ]
          }
        }
