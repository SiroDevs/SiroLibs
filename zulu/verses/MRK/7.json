            "sid": "MRK 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba akungeni enhliziyweni yakhe, kodwa kungena esiswini, kuphumele obala, ehlambulula konke ukudla na?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.19",
            "verseOrgIds": [
              "MRK.7.19"
            ]
          }
        }
