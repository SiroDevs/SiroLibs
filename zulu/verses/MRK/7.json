          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke lezi zinto ezimbi ziphuma ngaphakathi, zimngcolise umuntu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.23",
            "verseOrgIds": [
              "MRK.7.23"
            ]
          }
        }
