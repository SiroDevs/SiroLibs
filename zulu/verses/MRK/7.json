          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubusela, ukufisa, ububi, inkohliso, ukuxhwala, ilihlo elibi, inhlamba, ukuzigqaja, ubuthutha;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.22",
