            "sid": "MRK 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uJesu wathi kuye: “Vuma abantwana kuqala, ngokuba akukuhle ukuthatha isinkwa sabantwana, siphonse ezinjaneni.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.27",
            "verseOrgIds": [
              "MRK.7.27"
            ]
          }
        }
      ]
    },
