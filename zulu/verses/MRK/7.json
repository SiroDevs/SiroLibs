          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesithi: Okuphumayo kumuntu yikho okungcolisayo umuntu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.20",
            "verseOrgIds": [
              "MRK.7.20"
            ]
          }
        }
