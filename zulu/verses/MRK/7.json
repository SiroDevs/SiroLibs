          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baletha kuye isithulu, eyisilima; bamncenga ukuthi abeke isandla sakhe phezu kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.32",
