          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesemuka futhi emikhawulweni yaseTire naseSidoni, weza olwandle lwaseGalile edabula phakathi kwezifunda zaseDekapholi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.31",
            "verseOrgIds": [
              "MRK.7.31"
            ]
