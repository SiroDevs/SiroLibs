          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesifazane wayengumGreki, engumSirofenike ngokuzalwa; wamncenga ukuba akhiphe idemoni endodakazini yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.26",
            "verseOrgIds": [
              "MRK.7.26"
            ]
          }
        }
      ]
    },
