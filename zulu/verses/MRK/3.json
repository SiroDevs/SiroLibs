              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi omoya abangcolileyo bembona, baziwise phansi phambi kwakhe, bakhale, bathi: “Wena uyiNdodana kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.11",
