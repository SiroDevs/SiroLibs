          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabuye wangena esinagogeni; kwakukhona lapho umuntu onesandla esishwabene.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.1",
            "verseOrgIds": [
              "MRK.3.1"
            ]
          }
        }
      ]
    },
    {
