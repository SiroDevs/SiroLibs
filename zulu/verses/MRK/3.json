      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.3",
            "verseOrgIds": [
              "MRK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kubo: Kuvunyelwe yini ngesabatha ukwenza okuhle kumbe okubi? ukusindisa impilo, kumbe ukubulala? Kodwa bathula.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.4",
            "verseOrgIds": [
              "MRK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
