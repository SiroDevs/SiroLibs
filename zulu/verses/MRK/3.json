        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.5",
            "verseOrgIds": [
              "MRK.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
