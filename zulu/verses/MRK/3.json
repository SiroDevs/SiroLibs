          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasekhuluma kubafundi bakhe ukuthi umkhunjana umlinde ngenxa yexuku, hlezi bammpitshe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.9",
            "verseOrgIds": [
