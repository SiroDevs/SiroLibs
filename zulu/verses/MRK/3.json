            "sid": "MRK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bephuma abaFarisi, bahle bacebisana nabakaHerode ukuthi bangambulala kanjani.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.6",
            "verseOrgIds": [
              "MRK.3.6"
            ]
          }
        }
