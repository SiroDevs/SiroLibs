          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "naseJerusalema, nase-Idumiya, nangaphesheya kweJordani; nangaseTire naseSidoni, isixuku esikhulu, sesizwile ukuthi kukhulu akwenzayo, seza kuye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.8",
            "verseOrgIds": [
              "MRK.3.8"
            ]
          }
        }
