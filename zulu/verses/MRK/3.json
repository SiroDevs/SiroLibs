              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.1",
            "verseOrgIds": [
              "MRK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebemqaphela ukuthi uzamsilisa yini ngesabatha; ukuze bambeke icala.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.2",
            "verseOrgIds": [
              "MRK.3.2"
            ]
          }
        }
      ]
    },
    {
