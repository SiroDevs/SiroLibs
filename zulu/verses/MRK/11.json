            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu waphendula, wathi kubo: “Nami ngizakunibuza umbuzo ube munye, ningiphendule, nami ngizakunitshela ukuthi ngenza lokhu ngagunya lini.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.29",
            "verseOrgIds": [
              "MRK.11.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
