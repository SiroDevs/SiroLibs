      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.24",
            "verseOrgIds": [
              "MRK.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nxa nimi nikhuleka, thethelelani, uma ninamagqubu nomunye, ukuze noYihlo osezulwini anithethelele iziphambeko zenu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.25",
            "verseOrgIds": [
              "MRK.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
