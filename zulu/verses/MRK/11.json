            "sid": "MRK 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba sisithi: Kubantu; besaba abantu, ngokuba bonke bathi uJohane ungumprofethi impela.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.32",
            "verseOrgIds": [
              "MRK.11.32"
            ]
          }
        }
      ]
    },
