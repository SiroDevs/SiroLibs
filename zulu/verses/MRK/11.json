            "number": "23",
            "style": "v",
            "sid": "MRK 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngiqinisile ngithi kini: Yilowo nalowo oyakuthi kule ntaba: ‘Suka, uphonseke elwandle;’ engangabazi enhliziyweni yakhe, kodwa ekholwa ukuthi lokho akutshoyo kuyenzeka; uzakuba lalokho akutshoyo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.23",
            "verseOrgIds": [
              "MRK.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.23",
            "verseOrgIds": [
              "MRK.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke ngithi kini: Konke enikucelayo nikhuleka, kholwani ukuthi nikutholile, niyakuba nakho.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.24",
            "verseOrgIds": [
              "MRK.11.24"
            ]
          }
        }
      ]
    },
    {
