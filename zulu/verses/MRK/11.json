          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.29",
            "verseOrgIds": [
              "MRK.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubhapathizo lukaJohane lwaluvela ezulwini noma kubantu na? ngiphendule.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.30",
            "verseOrgIds": [
              "MRK.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
