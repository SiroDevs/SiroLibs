        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebekhulumisana bodwa, besithi: Uba sisithi: Ezulwini; uzakuthi: Pho, anikholwanga nguye ngani na?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.31",
            "verseOrgIds": [
              "MRK.11.31"
            ]
          }
        }
      ]
    },
