          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathi kuye: “Lokhu uzenza ngagunya lini na? njalo ngubani okunike leligunya lokwenza lezizinto?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.28",
            "verseOrgIds": [
              "MRK.11.28"
            ]
          }
        }
      ]
    },
