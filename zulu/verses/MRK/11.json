          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPetru ekhumbula wathi kuye: “Rabi, bheka, umkhiwane owuqalekisileyo ubunile.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.21",
