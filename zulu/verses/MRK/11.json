          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base befika eJerusalema; kwathi ehamba ethempelini, kwafika kuye abapristi abakhulu, nababhali, namalunga;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.27",
            "verseOrgIds": [
              "MRK.11.27"
            ]
          }
        }
      ]
    },
    {
