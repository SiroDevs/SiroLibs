          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokho wabonakala kwabayishumi nanye behlezi ekudleni, wabasola ngokungakholwa kwabo nobulukhuni benhliziyo, ngokuba bengakholwanga yilabo ababembonile esevusiwe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.14",
            "verseOrgIds": [
              "MRK.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
