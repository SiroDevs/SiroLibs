          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.7",
            "verseOrgIds": [
              "MRK.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bephuma masinyane, babaleka ethuneni; ngokuba babethuthumela, bamangala; ngoba babesaba.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.8",
            "verseOrgIds": [
              "MRK.16.8"
            ]
          }
        }
      ]
    },
    {
