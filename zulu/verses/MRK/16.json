          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okholwayo abhapathizwe uyakusindiswa; kodwa ongakholwayo uyakulahlwa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.16",
            "verseOrgIds": [
              "MRK.16.16"
            ]
          }
        }
      ]
