          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lalezizibonakaliso zizakubalandela abakholwayo; Ngegama lami bayokhipha amademoni; bayakukhuluma ngezilimi ezintsha;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.17",
            "verseOrgIds": [
              "MRK.16.17"
            ]
          }
        }
