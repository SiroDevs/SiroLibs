              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha ubufebe, nakho konke ukungcola, noma isangabe, makungaphathwa nakanye phakathi kwenu, njengokuba kufanele abangcwele;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.3",
            "verseOrgIds": [
              "EPH.5.3"
            ]
