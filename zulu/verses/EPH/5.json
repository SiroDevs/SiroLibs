        {
          "text": "Makungabikho onikhohlisayo ngamazwi ayize, ngokuba ngenxa yalezo zinto ulaka lukaNkulunkulu lwehlela phezu kwabantwana bokungalaleli.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.6",
