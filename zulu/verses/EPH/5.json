        {
          "text": "Ngokuba niyakwazi lokhu, ukuthi akukho sifebe, noma ongcolileyo, noma onesangabe ongokhonza izithombe, onefa embusweni kaKristu noNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.5",
