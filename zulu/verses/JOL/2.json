        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.2",
            "verseOrgIds": [
              "JOL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umlilo udla phambi kwabo; futhi emva kwabo ilangabi liyavutha; izwe linjengensimu yase-Edene phambi kwabo, futhi emva kwabo ugwadule lwasendle; yebo, futhi akukho lutho oluyophunyuka kubo.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.3",
            "verseOrgIds": [
              "JOL.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.3",
            "verseOrgIds": [
              "JOL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukubonakala kwabo kunjengokubonakala kwamahhashi; nanjengabagibeli bamahhashi, kanjalo bayakugijima.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.4",
            "verseOrgIds": [
              "JOL.2.4"
            ]
          }
        }
      ]
    },
    {
