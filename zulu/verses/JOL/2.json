          "attrs": {
            "verseId": "JOL.2.8",
            "verseOrgIds": [
              "JOL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayogijima baye ngapha nangapha emzini; bagijima odongeni, bakhwela ezindlini; bayakungena ngamafasitela njengesela.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.9",
            "verseOrgIds": [
              "JOL.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
