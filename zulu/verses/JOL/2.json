              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungesabi, zwe; jabula ujabule, ngokuba uJehova uyakwenza izinto ezinkulu.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.21",
