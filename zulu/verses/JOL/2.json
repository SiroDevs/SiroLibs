        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phambi kobuso babo abantu bayakuba nobuhlungu obukhulu; bonke ubuso buyakuba mnyama.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.6",
            "verseOrgIds": [
              "JOL.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
