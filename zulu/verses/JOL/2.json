        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.6",
            "verseOrgIds": [
              "JOL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazagijima njengamaqhawe; bayokhuphuka ugange njengamadoda empi; futhi bayohamba, kube yilowo nalowo ngendlela yakhe, bangahlukani.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.7",
            "verseOrgIds": [
              "JOL.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
