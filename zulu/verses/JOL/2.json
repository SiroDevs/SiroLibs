          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.4",
            "verseOrgIds": [
              "JOL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengomsindo wezinqola eziqongweni zezintaba bayogxuma, njengomsindo welangabi lomlilo liqothula izinhlanga, njengabantu abanamandla abami ngokulandelana kwempi.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.5",
            "verseOrgIds": [
              "JOL.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
