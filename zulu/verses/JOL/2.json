            "verseOrgIds": [
              "JOL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngubani owaziyo uma eyobuya futhi aphenduke futhi ashiye isibusiso ngemva kwakhe; umnikelo wokudla nomnikelo wokuphuzwayo kuJehova uNkulunkulu wenu na?",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.14",
            "verseOrgIds": [
              "JOL.2.14"
            ]
          }
        }
      ]
    },
