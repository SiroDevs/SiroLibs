        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova uyakuphakamisa izwi lakhe phambi kwebutho lakhe, ngokuba ikamu lakhe likhulu kakhulu, ngokuba unamandla owenza izwi lakhe; ngoba usuku lukaJehova lukhulu, luyesabeka kakhulu; ngubani ongakuthwala na?",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.11",
            "verseOrgIds": [
              "JOL.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
