          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuthelani icilongo eSiyoni, nihlabe umkhosi entabeni yami engcwele; mabathuthumele bonke abakhileyo ezweni, ngokuba usuku lukaJehova luyeza, ngokuba luseduze;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.1",
            "verseOrgIds": [
              "JOL.2.1"
            ]
          }
        }
      ]
    },
    {
