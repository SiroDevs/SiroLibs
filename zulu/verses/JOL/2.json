          "attrs": {
            "verseId": "JOL.2.11",
            "verseOrgIds": [
              "JOL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke, manje, kusho uJehova, phendukani kimi ngenhliziyo yenu yonke nangokuzila ukudla nangokukhala nangokulila.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.12",
            "verseOrgIds": [
              "JOL.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
