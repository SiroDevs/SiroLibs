          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buthani abantu, ningcwelise ibandla, amalunga aqoqe, abuthe abantwana nabamunya amabele; akaphume umyeni ekamelweni lakhe, nomakoti aphume engutsheni yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.16",
            "verseOrgIds": [
              "JOL.2.16"
            ]
          }
        }
      ]
