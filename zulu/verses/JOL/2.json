          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.7",
            "verseOrgIds": [
              "JOL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akekho ongasunduza omunye; bayakuhamba, kube yilowo nalowo ngendlela yakhe, uma bewa ngenkemba, abayikulinyazwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.8",
            "verseOrgIds": [
              "JOL.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
