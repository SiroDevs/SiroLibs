          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuthelani icilongo eSiyoni, ningcwelise usuku lokuzila, nibize umhlangano ozothileyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.15",
            "verseOrgIds": [
              "JOL.2.15"
            ]
          }
        }
