              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke uJehova uyakuba nomhawu ngezwe lakhe, abe nesihe kubantu bakhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.18",
