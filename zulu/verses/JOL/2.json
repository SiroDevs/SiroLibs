            "sid": "JOL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umhlaba uyazamazama phambi kwabo; izulu liyakuthuthumela, ilanga nenyanga kube mnyama, nezinkanyezi zisuse ukukhanya kwazo.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.10",
            "verseOrgIds": [
              "JOL.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
