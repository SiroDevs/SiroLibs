              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi likaJehova lafika kuJona ngokwesibili, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.1",
            "verseOrgIds": [
              "JON.3.1"
            ]
