              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi likaJehova lafika kuJona indodana ka-Amithayi, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.1",
            "verseOrgIds": [
              "JON.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.1",
            "verseOrgIds": [
              "JON.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suka uye eNineve, umuzi omkhulu, umemeze ngawo; ngoba ububi babo bukhuphukele phambi kwami.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.2",
            "verseOrgIds": [
              "JON.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.2",
            "verseOrgIds": [
              "JON.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uJona wasuka ukuba abalekele eTharishishi ebusweni bukaJehova, wehlela eJopha; wathola umkhumbi owawuya eTharishishi, wakhokha imali yokugibela, wangena kuwo, ukuze ahambe nawo, aye eTharishishi, asuke ebusweni bukaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.3",
            "verseOrgIds": [
              "JON.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.3",
            "verseOrgIds": [
              "JON.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uJehova wathumela umoya omkhulu elwandle, kwavela isiphepho esikhulu elwandle, umkhumbi waze waphuka.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.4",
            "verseOrgIds": [
              "JON.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.4",
            "verseOrgIds": [
              "JON.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke amatilosi esaba futhi abiza yilowo nalowo kunkulunkulu wakhe futhi aphonsa olwandle impahla eyayisemkhunjini ukuze enze kube lula kuwo. Kepha uJona wehlela ezinhlangothini zomkhumbi; walala ubuthongo.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.5",
            "verseOrgIds": [
              "JON.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.5",
            "verseOrgIds": [
              "JON.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Induna yasondela kuye, yathi kuye: “Uthini wena olele ubuthongo na?” sukuma, ubize uNkulunkulu wakho, uma uNkulunkulu esikhumbula, ukuze singalahleki.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.6",
            "verseOrgIds": [
              "JON.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.6",
            "verseOrgIds": [
              "JON.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebesithi, ngulowo kumngane wakhe: Wozani senze inkatho, ukuze sazi ukuthi kungenxa kabani lobu bubi buphezu kwethu. Benza inkatho, inkatho yawela uJona.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.7",
            "verseOrgIds": [
              "JON.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.7",
            "verseOrgIds": [
              "JON.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bethi kuye: “Sitshele ukuthi kungenxa kabani lobu bubi buphezu kwethu; uyini umsebenzi wakho futhi uvelaphi? iliphi izwe lakini ungowasiphi isizwe?",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.8",
            "verseOrgIds": [
              "JON.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.8",
            "verseOrgIds": [
              "JON.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kubo: “NgingumHeberu; ngiyamesaba uJehova uNkulunkulu wezulu, owenza ulwandle nomhlabathi owomileyo.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.9",
            "verseOrgIds": [
              "JON.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.9",
            "verseOrgIds": [
              "JON.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke amadoda esaba kakhulu athi kuye: “Ukwenzeleni lokhu? Ngokuba amadoda azi ukuthi ubalekile ebusweni bukaJehova, ngokuba wayeshilo kuwo.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.10",
            "verseOrgIds": [
              "JON.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.10",
            "verseOrgIds": [
              "JON.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bethi kuye: “Sikwenzeni kuwe, ukuze ulwandle luthule kithi na?” ngoba ulwandle lwalugeleza futhi lugubha.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.11",
            "verseOrgIds": [
              "JON.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.11",
            "verseOrgIds": [
              "JON.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JON 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kubo: “Ngiphakamiseni, ningiphonse olwandle; ukuze ulwandle luzole kini, ngokuba ngiyazi ukuthi lesi siphepho esikhulu siphezu kwenu ngenxa Yami.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.12",
            "verseOrgIds": [
              "JON.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JON 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.12",
            "verseOrgIds": [
              "JON.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JON 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa amadoda agwedla ngamandla ukuyibuyisela emhlabathini; kepha behluleka, ngokuba ulwandle lwase luvunguzela, lubavunguzela.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.13",
            "verseOrgIds": [
              "JON.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JON 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.13",
            "verseOrgIds": [
              "JON.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JON 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bebiza uJehova, bathi: “Siyakuncenga, Jehova, ukuba ungabhubhi ngenxa yokuphila kwalo muntu, ungachithi igazi elingenacala phezu kwethu; ngoba wena Jehova wenzile okuhle emehlweni akho.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.14",
            "verseOrgIds": [
              "JON.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JON 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.14",
            "verseOrgIds": [
              "JON.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JON 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebemfukula uJona bamjikijela elwandle, ulwandle lwathula ekuthukutheleni kwalo.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.15",
            "verseOrgIds": [
              "JON.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JON 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.15",
            "verseOrgIds": [
              "JON.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JON 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadoda ayesesaba uJehova ngokwesaba okukhulu, aletha umhlatshelo kuJehova, enza izithembiso.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.16",
            "verseOrgIds": [
              "JON.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JON 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.16",
            "verseOrgIds": [
              "JON.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JON 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova walungisa inhlanzi enkulu ukuba imginye uJona. UJona wayesesiswini senhlanzi izinsuku ezintathu nobusuku obuthathu.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
            "verseOrgIds": [
              "JON.1.17"
            ]
          }
        }
      ]
    }
