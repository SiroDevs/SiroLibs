            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho umphefumulo wami uphela amandla phakathi kwami, ngacabanga ngoJehova, umkhuleko wami wafika kuwe ethempelini lakho elingcwele.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        }
      ]
