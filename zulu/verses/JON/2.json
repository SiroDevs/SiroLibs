            "number": "6",
            "style": "v",
            "sid": "JON 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngehlela phansi kwezintaba; umhlaba nemigoqo yawo wawungizungeza kuze kube phakade; Nokho ukuphakamisile ukuphila kwami ekonakaleni, Jehova Nkulunkulu wami.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        }
      ]
    },
