            "sid": "JON 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanzi angihaqa, kwaze kwafika emphefumulweni; utwa lwangizungeza, ukhula lwahaqa ikhanda lami.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.5",
            "verseOrgIds": [
              "JON.2.5"
            ]
          }
        }
      ]
    },
    {
