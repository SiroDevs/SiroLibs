          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha mina ngiyakuhlabela kuwe ngezwi lokubonga; Ngizokhokha engikuthembisile. Insindiso ivela kuJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.9",
            "verseOrgIds": [
              "JON.2.9"
            ]
          }
        }
