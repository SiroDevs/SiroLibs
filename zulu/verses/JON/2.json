        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wakhuluma enhlanzini, yamkhafulela uJona emhlabathini owomileyo.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.10",
            "verseOrgIds": [
              "JON.2.10"
            ]
