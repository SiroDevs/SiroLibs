        },
        {
          "text": "UJona wakhuleka kuJehova uNkulunkulu wakhe esesiswini senhlanzi:",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.1",
            "verseOrgIds": [
              "JON.2.1"
            ]
          }
        }
