          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamlaya ukuthi angatsheli muntu, kodwa hamba uziveze kumpristi, unikele ngokuhlanjululwa kwakho, njengokulaya kukaMozisi, kube ngubufakazi kubo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.14",
            "verseOrgIds": [
              "LUK.5.14"
            ]
          }
        }
      ]
    },
    {
