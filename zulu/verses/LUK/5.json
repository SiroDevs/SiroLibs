            "sid": "LUK 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi isixuku simcindezela ukuba sizwe izwi likaNkulunkulu, wayemi ngaselwandle lwaseGenesaretha.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.1",
            "verseOrgIds": [
              "LUK.5.1"
            ]
          }
        }
      ]
    },
    {
