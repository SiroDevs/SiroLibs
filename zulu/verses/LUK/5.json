          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waseselula isandla, wamphatha, wathi: Ngiyathanda, hlambuluka. Masinyane uchoko lwasuka kuye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.13",
            "verseOrgIds": [
              "LUK.5.13"
            ]
          }
        }
      ]
    },
