          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.1",
            "verseOrgIds": [
              "LUK.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabona imikhumbi emibili imi ngaselwandle, kepha abadobi babephumile kuyo, begeza amanetha abo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.2",
            "verseOrgIds": [
              "LUK.5.2"
            ]
          }
        }
      ]
    },
    {
