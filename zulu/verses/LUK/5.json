          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kwayikhona udumo lwakhe lwanda, kwabuthana izixuku ukuzolalela nokuphulukiswa nguye ezifweni zazo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.15",
            "verseOrgIds": [
              "LUK.5.15"
            ]
          }
        }
