          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma umuntu eza kimi, engazondi uyise, nonina, nomkakhe, nabantwana, nabafowabo, nawodadewabo, yebo, nokuphila kwakhe futhi, angebe ngumfundi wami.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.26",
            "verseOrgIds": [
              "LUK.14.26"
            ]
