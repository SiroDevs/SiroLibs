          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma kungenjalo, esekude lowo, uthuma amanxusa, acele imibandela yokuthula.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.32",
            "verseOrgIds": [
              "LUK.14.32"
            ]
          }
        }
