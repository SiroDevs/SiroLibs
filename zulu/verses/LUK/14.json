        },
        {
          "text": "Basebeqala ukuzilandulela bonke nganhliziyonye. Owokuqala wathi kuye: Ngithenge isiqephu sensimu, ngimelwe ukuyosibona;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.18",
            "verseOrgIds": [
              "LUK.14.18"
            ]
          }
        }
      ]
    },
