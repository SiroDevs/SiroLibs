              "LUK.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena uyakubusiswa; ngokuba abanakukubuyisela, ngokuba uyakuvuzwa ekuvukeni kwabalungileyo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.14",
            "verseOrgIds": [
              "LUK.14.14"
            ]
          }
        }
      ]
    },
    {
