          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lomunye wathi: Ngithethe umfazi, ngakho ngingeze.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.20",
            "verseOrgIds": [
              "LUK.14.20"
            ]
          }
        }
