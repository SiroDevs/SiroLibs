          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omunye wathi: ‘Ngithenge izinkabi ezingaba yisihlanu, ngisaya ukuzivivinya; ngicela ungixolele.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.19",
            "verseOrgIds": [
              "LUK.14.19"
            ]
          }
        }
      ]
    },
