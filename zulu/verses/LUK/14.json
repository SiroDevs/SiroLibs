          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathuma inceku yakhe ngesikhathi sokudla ukuba ithi kwabamenyiweyo: Wozani; ngoba konke sekulungile.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.17",
