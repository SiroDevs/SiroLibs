          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noma iyiphi inkosi, ethi iyakulwa nenye inkosi, ingahlali phansi kuqala, ibuze ukuthi inamandla yini ngezinkulungwane eziyishumi ukuhlangabeza oza kuyo enezinkulungwane ezingamashumi amabili na?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.31",
            "verseOrgIds": [
              "LUK.14.31"
            ]
          }
        }
