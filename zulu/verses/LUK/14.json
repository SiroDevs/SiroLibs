          "attrs": {
            "verseId": "LUK.14.14",
            "verseOrgIds": [
              "LUK.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi omunye wababehlezi naye ekudleni esizwa lezizinto, wathi kuye: Ubusisiwe odla isinkwa embusweni kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.15",
            "verseOrgIds": [
              "LUK.14.15"
            ]
          }
        }
      ]
    },
