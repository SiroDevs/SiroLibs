          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.12",
            "verseOrgIds": [
              "LUK.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha nxa wenza idili, mema abampofu, nezinyonga, nezinyonga, nezimpumputhe;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.13",
            "verseOrgIds": [
              "LUK.14.13"
            ]
          }
        }
      ]
    },
    {
