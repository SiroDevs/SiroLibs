          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngumuphi kini othi efuna ukwakha umbhoshongo, angahlali phansi kuqala, abale izindleko, ukuthi unakho ukuwuqeda na?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.28",
            "verseOrgIds": [
              "LUK.14.28"
            ]
          }
        }
      ]
    },
