          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hleze, esesibekile isisekelo, engakwazi ukusiqeda, bonke abakubonayo baqale ukumhleka usulu;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.29",
            "verseOrgIds": [
              "LUK.14.29"
            ]
          }
        }
