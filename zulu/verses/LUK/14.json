          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngithi kini: Kakho kulawomadoda abemenyiwe ozakuzwa ukudla kwami kwakusihlwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.24",
            "verseOrgIds": [
              "LUK.14.24"
            ]
          }
        }
      ]
    },
