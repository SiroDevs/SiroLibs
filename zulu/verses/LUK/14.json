              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "besithi: Lomuntu waqala ukwakha, kodwa kabanga lamandla okuqeda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.30",
            "verseOrgIds": [
              "LUK.14.30"
            ]
          }
        }
      ]
