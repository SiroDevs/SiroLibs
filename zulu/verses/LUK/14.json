          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.21",
            "verseOrgIds": [
              "LUK.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inceku yasisithi: Nkosi, sekwenziwe njengokulaya kwakho, kodwa indawo isekhona.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.22",
            "verseOrgIds": [
              "LUK.14.22"
            ]
          }
        }
      ]
    },
