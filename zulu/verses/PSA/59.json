          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.16",
            "verseOrgIds": [
              "PSA.59.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 59:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mandla ami, ngifisa ukuhlabelela ngodumo lwakho, ngokuba uNkulunkulu uyisiphephelo sami noNkulunkulu womusa wami.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.17",
            "verseOrgIds": [
              "PSA.59.17"
            ]
          }
        }
