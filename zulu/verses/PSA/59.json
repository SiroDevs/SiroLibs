          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 59:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baqede ngokuthukuthela, baqede, bangabi khona; futhi mabazi ukuthi uNkulunkulu uyabusa kwaJakobe kuze kube semikhawulweni yomhlaba. Sela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.13",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
