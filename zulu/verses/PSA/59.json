          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha mina ngiyakuhlabelela ngamandla akho; yebo, ekuseni ngiyakuhlabelela ngomusa wakho, ngokuba uyisiphephelo sami nesiphephelo ngosuku lokuhlupheka kwami.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.16",
            "verseOrgIds": [
              "PSA.59.16"
            ]
          }
        }
      ]
    },
