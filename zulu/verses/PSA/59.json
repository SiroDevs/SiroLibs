        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.13",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 59:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babuye kusihlwa; bakhamuluke njengenja, bazulazule emzini.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.14",
            "verseOrgIds": [
              "PSA.59.14"
            ]
          }
        }
      ]
