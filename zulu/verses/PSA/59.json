          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 59:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabazulazule befuna ukudla, banqikaze uma bengasuthi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.15",
            "verseOrgIds": [
              "PSA.59.15"
            ]
          }
        }
      ]
