            "sid": "2PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba bayimithombo engenamanzi, amafu aqhutshwa yisiphepho; abagcinelwe inkungu yobumnyama kuze kube phakade.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.17",
            "verseOrgIds": [
              "2PE.2.17"
            ]
          }
        }
