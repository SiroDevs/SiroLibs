            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banamehlo agcwele ukuphinga, abangayeki esonweni; bekhohlisa imiphefumulo engazinzile: nenhliziyo efundiswe ukuhaha; izingane eziqalekisiwe:",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.14",
            "verseOrgIds": [
              "2PE.2.14"
            ]
          }
        }
      ]
    },
    {
