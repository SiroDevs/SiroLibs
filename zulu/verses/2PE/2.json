          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "abayishiyile indlela eqondileyo baduka belandela indlela kaBalami indodana kaBosori owathanda inkokhelo yokungalungi;",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.15",
            "verseOrgIds": [
              "2PE.2.15"
            ]
          }
        }
