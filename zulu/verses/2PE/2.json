            "sid": "2PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa wasolwa ngobubi bakhe: ubabhemi oyisimungulu wakhuluma ngelizwi lomuntu wenqabela ukuhlanya komprofethi.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.16",
            "verseOrgIds": [
              "2PE.2.16"
            ]
          }
        }
      ]
    },
