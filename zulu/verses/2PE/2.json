          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "njalo bayakwamukeliswa umvuzo wokungalungi, njengabathi kuyintokozo ukwenza impinda emini. Bangamabala nezisihla, bedlala ngenkohliso yabo, besidla nani;",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.13",
            "verseOrgIds": [
              "2PE.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
