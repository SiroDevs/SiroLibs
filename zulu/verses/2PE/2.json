        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.11",
            "verseOrgIds": [
              "2PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha laba, njengezilwane ezingenangqondo, ezizalelwe ukubanjwa zibhujiswe, bahlambalaza abangaziqondiyo; futhi bayobhubha nokubhubha ekonakaleni kwabo;",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.12",
            "verseOrgIds": [
              "2PE.2.12"
            ]
          }
        }
      ]
    },
