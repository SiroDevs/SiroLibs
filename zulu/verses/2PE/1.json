          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
            "verseOrgIds": [
              "2PE.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "njengalokhu amandla akhe obuNkulunkulu esinikile konke okuqondene nokuphila nokumesaba uNkulunkulu ngokumazi yena owasibizela enkazimulweni nasebuhleni.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.3",
            "verseOrgIds": [
              "2PE.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.3",
            "verseOrgIds": [
              "2PE.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho siphiwe izithembiso ezinkulu kakhulu leziligugu, ukuze ngalezo libe ngabahlanganyeli bemvelo yobuNkulunkulu, libalekele ukonakala okusemhlabeni ngenkanuko.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.4",
            "verseOrgIds": [
              "2PE.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.4",
            "verseOrgIds": [
              "2PE.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke yenzani inkuthalo yonke, nezeleni ubuhle ekukholweni kwenu; nasebuhleni ukwazi;",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.5",
            "verseOrgIds": [
              "2PE.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
