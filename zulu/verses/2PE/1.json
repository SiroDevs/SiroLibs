          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphezu kwalokho ngizakukhuthalela ukuba nibe-namandla njalo emva kokumuka kwami lezo zinto zikhunjulwe.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        }
      ]
    },
