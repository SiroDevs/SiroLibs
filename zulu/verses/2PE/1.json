          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngazi ukuthi masinyane ngimele ukulisusa leli dokodo lami, njengalokho iNkosi yethu uJesu Kristu yangibonisa.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.14",
            "verseOrgIds": [
              "2PE.1.14"
            ]
          }
        }
      ]
    },
    {
