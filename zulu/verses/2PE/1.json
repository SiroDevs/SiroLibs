            "sid": "2PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba asilandelanga izinganekwane zobuqili, lapho sinazisa amandla nokufika kweNkosi yethu uJesu Kristu, kodwa sasingababonayo amandla obukhosi bakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.16",
            "verseOrgIds": [
              "2PE.1.16"
            ]
          }
        }
