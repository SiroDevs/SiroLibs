            "sid": "2PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba wemukela kuNkulunkulu uBaba udumo nenkazimulo, lapho kufika kuye izwi elinjena, livela enkazimulweni yobukhosi, lithi: Lo uyiNdodana yami ethandekayo engithokozile ngayo.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.17",
            "verseOrgIds": [
              "2PE.1.17"
            ]
          }
        }
