          "attrs": {
            "verseId": "AMO.4.11",
            "verseOrgIds": [
              "AMO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke ngizakwenza lokhu kuwe, Israyeli; futhi ngenxa yokuthi ngizokwenza lokhu kuwe, zilungiselele ukuhlangana noNkulunkulu wakho, Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.12",
            "verseOrgIds": [
              "AMO.4.12"
            ]
          }
        }
      ]
