          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi uJehova yangibonisa kanje; bheka, wenza isikhonyane ekuqaleni kokuhluma kotshani lokugcina; bheka, kwakuyihlaza lokugcina ngemva kokusikwa kwenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.1",
            "verseOrgIds": [
              "AMO.7.1"
            ]
          }
        }
      ]
    },
    {
