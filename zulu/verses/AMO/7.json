              "AMO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengisithi: Nkosi Jehova, yima! uJakobe uyakusukuma ngobani na? ngoba mncane.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.5",
            "verseOrgIds": [
              "AMO.7.5"
            ]
          }
        }
      ]
    },
    {
