        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.5",
            "verseOrgIds": [
              "AMO.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
