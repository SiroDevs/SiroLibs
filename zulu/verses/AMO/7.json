        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.2",
            "verseOrgIds": [
              "AMO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wazisola ngalokhu: Ngeke kwenzeke, kusho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.3",
            "verseOrgIds": [
              "AMO.7.3"
            ]
          }
        }
      ]
    },
    {
