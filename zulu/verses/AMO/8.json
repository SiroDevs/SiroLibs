            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labo abafunga isono seSamariya bathi: Kuphila unkulunkulu wakho, Dani! nokuthi: Indlela yaseBeri Sheba; nabo bayakuwa, bangabe besavuka.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.14",
            "verseOrgIds": [
              "AMO.8.14"
            ]
          }
        }
      ]
