          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.11",
            "verseOrgIds": [
              "AMO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayozulazula besuka olwandle kuze kube selwandle, kusukela enyakatho kuze kufike empumalanga, bayahambahamba befuna izwi likaJehova, bangalitholi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.12",
            "verseOrgIds": [
              "AMO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.12",
            "verseOrgIds": [
              "AMO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolo suku izintombi ezinhle nezinsizwa ziyoquleka ngenxa yokoma.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.13",
            "verseOrgIds": [
              "AMO.8.13"
            ]
          }
        }
      ]
    },
    {
