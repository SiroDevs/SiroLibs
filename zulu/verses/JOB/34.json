          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba indlebe iyahlola amazwi, njengomlomo unambitha ukudla.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.3",
            "verseOrgIds": [
              "JOB.34.3"
