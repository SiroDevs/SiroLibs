          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufanele ngiqambe amanga ngiphikisa ilungelo lami na? isilonda sami asinakuphulukiswa, singenasiphambeko.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
