            "number": "8",
            "style": "v",
            "sid": "JOB 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usuyizwile imfihlo kaNkulunkulu na? wena uzigcinele ukuhlakanipha na?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.8",
            "verseOrgIds": [
              "JOB.15.8"
            ]
          }
        }
