          "attrs": {
            "verseId": "JOB.15.1",
            "verseOrgIds": [
              "JOB.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ohlakaniphileyo angakhuluma ukwazi okuyize, agcwalise isisu sakhe ngomoya wasempumalanga, na?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        }
      ]
    },
    {
