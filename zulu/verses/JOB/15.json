              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesephendula u-Elifazi umThemani, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.1",
            "verseOrgIds": [
              "JOB.15.1"
            ]
          }
        }
