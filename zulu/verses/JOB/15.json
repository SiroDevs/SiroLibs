        {
          "text": "Inhliziyo yakho ikuthathelani na? lapho amehlo akho ecwayiza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.12",
            "verseOrgIds": [
              "JOB.15.12"
