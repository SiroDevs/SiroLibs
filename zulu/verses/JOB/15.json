        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.5",
            "verseOrgIds": [
              "JOB.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umlomo wakho uyakulahla, akumina; yebo, izindebe zakho ziyafakaza ngawe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.6",
            "verseOrgIds": [
              "JOB.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
