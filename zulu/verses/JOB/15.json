          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uphendulela uNkulunkulu umoya wakho, ukhuphe amazwi anjalo emlonyeni wakho?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.13",
            "verseOrgIds": [
