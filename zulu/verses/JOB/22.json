              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa wagcwalisa izindlu zabo ngezinto ezinhle, kodwa iseluleko sababi sikhatshana lami.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.18",
            "verseOrgIds": [
              "JOB.22.18"
            ]
          }
        }
