        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.6",
            "verseOrgIds": [
              "JOB.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhatheleyo awumnikanga amanzi okuphuza, nabalambileyo ubagodle isinkwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.7",
            "verseOrgIds": [
              "JOB.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
