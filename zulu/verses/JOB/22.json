        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu akakho yini endaweni ephakeme yezulu? futhi bheka ukuthi izinkanyezi ziphakeme kangakanani, ukuthi ziphakeme kangakanani!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.12",
            "verseOrgIds": [
              "JOB.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
