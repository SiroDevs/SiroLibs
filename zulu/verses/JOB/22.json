              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesephendula u-Elifazi umThemani, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.1",
            "verseOrgIds": [
              "JOB.22.1"
            ]
          }
        }
