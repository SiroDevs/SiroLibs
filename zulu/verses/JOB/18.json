          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uziklebhula ngolaka lwakhe; umhlaba ungashiywa ngenxa yakho na? nedwala liyakususwa endaweni yalo na?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
