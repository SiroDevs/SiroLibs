          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyothatha isikhathi esingakanani ngaphambi kokuba uyeke ukukhuluma? maka, futhi emva kwalokho sizokhuluma.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.2",
            "verseOrgIds": [
              "JOB.18.2"
            ]
