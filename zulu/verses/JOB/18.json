          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yebo, ukukhanya komubi kuyakucishwa, nenhlansi yomlilo wakhe ngeke ikhanye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.5",
            "verseOrgIds": [
              "JOB.18.5"
            ]
