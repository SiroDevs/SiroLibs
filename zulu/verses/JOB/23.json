            "sid": "JOB 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.3",
            "verseOrgIds": [
              "JOB.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngangizamela indaba yami phambi kwakhe, ngigcwalise umlomo wami ngezimpikiswano.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.4",
            "verseOrgIds": [
              "JOB.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
