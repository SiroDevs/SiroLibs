          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uNkulunkulu uyayithambisa inhliziyo yami, futhi uSomandla uyangithukuthelisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.16",
            "verseOrgIds": [
              "JOB.23.16"
            ]
