          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.5",
            "verseOrgIds": [
              "JOB.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingamelana nami ngamandla ayo amakhulu na? Cha; kodwa ubezafaka amandla kimi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.6",
            "verseOrgIds": [
              "JOB.23.6"
            ]
          }
        }
      ]
    },
    {
