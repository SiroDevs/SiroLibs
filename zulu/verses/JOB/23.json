          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa yena ungqondonye, ngubani ongambuyisa? nalokho umphefumulo wakhe okufisayo, uyakwenza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.13",
            "verseOrgIds": [
              "JOB.23.13"
            ]
          }
        }
