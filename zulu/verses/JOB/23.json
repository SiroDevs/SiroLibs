          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uyayazi indlela engihamba ngayo; uma engilinga, ngiyophuma njengegolide.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.10",
            "verseOrgIds": [
              "JOB.23.10"
            ]
          }
        }
      ]
