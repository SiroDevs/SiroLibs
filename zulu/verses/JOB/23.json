        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O, ngangazi ukuthi ngingamtholaphi! ukuze ngize ngize ngize esihlalweni sakhe!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.3",
            "verseOrgIds": [
              "JOB.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
