        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma ufuna ukufuna uNkulunkulu ngesikhathi futhi wenze ukunxusa kwakho kuSomandla;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.5",
            "verseOrgIds": [
              "JOB.8.5"
            ]
          }
        }
      ]
    },
    {
