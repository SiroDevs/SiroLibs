          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ngokuba singabayizolo, asazi lutho, ngokuba izinsuku zethu emhlabeni ziyisithunzi;)",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.9",
            "verseOrgIds": [
              "JOB.8.9"
            ]
