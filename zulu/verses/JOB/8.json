        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma uhlanzekile, uqotho; impela Wayezonivukela futhi aphumelelise indawo yokuhlala yokulunga kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.6",
            "verseOrgIds": [
              "JOB.8.6"
            ]
          }
        }
      ]
    },
    {
