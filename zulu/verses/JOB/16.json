          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngangihlezi ngikhululekile, kodwa wangephula; Naye wangibamba igolo wangiqhaqhazela wangimisa njengomaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
