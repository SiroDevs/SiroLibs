          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abacibishelayo bangihaqile; uyaqhekeza izinso zami, akahawukeli; Ukhafulela inyongo yami phansi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
