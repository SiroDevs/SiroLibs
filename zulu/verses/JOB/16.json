          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ningigcwalisile ngemibimbi, engufakazi ngami, nobuncane bami obukhuphukela kimi bufakaza ebusweni bami.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.8",
            "verseOrgIds": [
              "JOB.16.8"
            ]
          }
        }
      ]
    },
    {
