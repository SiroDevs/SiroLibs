            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mhlaba, ungasimbozi igazi lami, nokukhala kwami makungabi nandawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.18",
            "verseOrgIds": [
              "JOB.16.18"
            ]
