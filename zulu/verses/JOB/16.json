              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngathunga indwangu yamasaka esikhumbeni sami, ngangcolisa uphondo lwami othulini.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.15",
