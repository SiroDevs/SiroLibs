            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungabi ngokungabi nabulungisa ezandleni zami; umkhuleko wami nawo uhlanzekile.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.17",
            "verseOrgIds": [
              "JOB.16.17"
            ]
