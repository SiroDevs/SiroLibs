            "sid": "JOB 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami bengiyakukhuluma njengani; uma umphefumulo wenu ubusendaweni yomphefumulo wami, bengiyakuqoqa amazwi ngani, nginikine ikhanda lami kini.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
