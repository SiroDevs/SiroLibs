            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizwile izinto eziningi ezinjengalezi: Ningabaduduzi ababi nonke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.2",
            "verseOrgIds": [
              "JOB.16.2"
