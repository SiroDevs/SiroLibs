          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uJobe uwuvulela ize umlomo wakhe; wandisa amazwi engenakwazi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.16",
            "verseOrgIds": [
              "JOB.35.16"
            ]
