          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngisho noma nithi ngeke nimbone, nokho ukwahlulelwa kuphambi kwakhe; ngakho uthembele kuYe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
