        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyazi ukuthi ungenza noma yini nokuthi akukho mcabango ongeke uvinjelwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.2",
            "verseOrgIds": [
              "JOB.42.2"
            ]
          }
        }
      ]
    },
    {
