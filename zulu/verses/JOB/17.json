          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iso lami lifiphele ngenxa yosizi, nezitho zami zonke zinjengethunzi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.7",
            "verseOrgIds": [
              "JOB.17.7"
            ]
          }
        }
