              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngathi enkohlakalweni: Wena ungubaba; empethuni: Wena ungumama wami nodadewethu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.14",
