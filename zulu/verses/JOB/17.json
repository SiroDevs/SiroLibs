          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma ngilinda, indawo yabafileyo iyikhaya lami; Ngendlala umbhede wami ebumnyameni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.13",
            "verseOrgIds": [
              "JOB.17.13"
            ]
