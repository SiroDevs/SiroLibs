          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi olungileyo uyogcina indlela yakhe, futhi onezandla ezihlanzekile uyoba namandla futhi aqine.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.9",
            "verseOrgIds": [
              "JOB.17.9"
            ]
