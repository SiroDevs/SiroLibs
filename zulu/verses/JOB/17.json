              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umoya wami wonakele, izinsuku zami ziphelile, amathuna alungiselwe mina.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
