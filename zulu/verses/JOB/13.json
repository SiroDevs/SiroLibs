          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.17",
            "verseOrgIds": [
              "JOB.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka-ke, sengiyilungisile indaba yami; Ngiyazi ukuthi ngizoqinisekiswa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.18",
            "verseOrgIds": [
              "JOB.13.18"
            ]
          }
        }
      ]
    },
