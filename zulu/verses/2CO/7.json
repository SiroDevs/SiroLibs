          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.15",
            "verseOrgIds": [
              "2CO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke ngiyathokoza ukuthi ezintweni zonke ngiyalithemba;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.16",
            "verseOrgIds": [
              "2CO.7.16"
            ]
          }
        }
      ]
    }
