              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.15",
            "verseOrgIds": [
              "2CO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuba sishumayele ivangeli ezindaweni ezingaphesheya kwenu, singazincomi ngesigaba somunye ngezinto esezilungiselwe esandleni sethu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.16",
            "verseOrgIds": [
              "2CO.10.16"
            ]
          }
        }
      ]
    },
