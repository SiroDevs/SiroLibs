          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha izingqondo zabo zaphuphuthekiswa, ngokuba kuze kube namuhla sisalokhu kufundwa isivumelwano esidala singambulwanga. Okuyindwangu echithwa kuKristu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.14",
            "verseOrgIds": [
              "2CO.3.14"
            ]
          }
        }
