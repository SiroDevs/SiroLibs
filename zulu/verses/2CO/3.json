      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.4",
            "verseOrgIds": [
              "2CO.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungesikho ukuthi siyenelisa ngokwethu ukucabanga utho njengoluvela kithi; kodwa ukwenelisa kwethu kuvela kuNkulunkulu;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.5",
            "verseOrgIds": [
              "2CO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.5",
            "verseOrgIds": [
              "2CO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "owasenza futhi amandla okuba yizikhonzi zesivumelwano esitsha; kungeyisikho okulotshiweyo kodwa okukamoya, ngoba okulotshiweyo kuyabulala, kodwa umoya uyaphilisa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.6",
            "verseOrgIds": [
              "2CO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.6",
            "verseOrgIds": [
              "2CO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uma inkonzo yokufa, ilotshiwe, iqoshwe ematsheni, yayinenkazimulo, kangangokuthi abantwana bakwa-Israyeli babengenakububheka ubuso bukaMose ngenxa yenkazimulo yobuso bakhe; okuyinkazimulo eyayizakuqedwa;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.7",
            "verseOrgIds": [
              "2CO.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.7",
            "verseOrgIds": [
              "2CO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkonzo kaMoya ayiyikuba nenkazimulo kakhulu na?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.8",
            "verseOrgIds": [
              "2CO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.8",
            "verseOrgIds": [
              "2CO.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uma inkonzo yokulahlwa iyinkazimulo, kakhulukazi inkonzo yokulunga iyodlula inkazimulo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.9",
            "verseOrgIds": [
              "2CO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 3:9"
          },
          "items": [
            {
              "text": "9",
