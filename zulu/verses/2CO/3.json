          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siqala futhi ukuzincoma na? Sidinga, njengabathile, izincwadi zokusifakaza kini, noma izincwadi zokusincoma ezivela kini?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.1",
            "verseOrgIds": [
              "2CO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.1",
            "verseOrgIds": [
              "2CO.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nina niyincwadi yethu elotshwe ezinhliziyweni zethu, eyaziwa ifundwa ngabantu bonke;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.2",
            "verseOrgIds": [
              "2CO.3.2"
            ]
          }
        }
      ]
    },
    {
