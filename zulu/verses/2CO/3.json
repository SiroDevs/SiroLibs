          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kuze kube lamuhla, nxa kufundwa uMozisi, umgubuzelo uphezu kwenhliziyo yabo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.15",
            "verseOrgIds": [
