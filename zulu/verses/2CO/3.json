          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uma lokho okwakuphela kwaba nenkazimulo, kakhulu kangakanani lokho okuhlalayo kunenkazimulo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.11",
