          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abangcwele bayakhonza kini.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.13",
            "verseOrgIds": [
              "2CO.13.13"
            ]
          }
        }
      ]
