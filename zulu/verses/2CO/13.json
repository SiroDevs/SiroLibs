        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusa weNkosi uJesu Kristu, nothando lukaNkulunkulu, nokuhlangana kukaMoya oNgcwele makube nani nonke. Amen. (Incwadi yesibili eya kwabaseKorinte yabhalwa uThithu noLucas eFilipi, umuzi waseMakedoniya.)",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.14",
            "verseOrgIds": [
              "2CO.13.14"
            ]
          }
        }
      ]
