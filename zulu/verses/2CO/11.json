          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba niyakubekezelela, uma umuntu enenza izigqila, uma umuntu enidla, uma umuntu ethatha kini, uma eziphakamisa, uma umuntu enishaya ebusweni.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.20",
            "verseOrgIds": [
              "2CO.11.20"
            ]
