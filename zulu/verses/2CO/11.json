          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.16",
            "verseOrgIds": [
              "2CO.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokho engikukhulumayo, angikukhulumi ngokweNkosi, kodwa kungathi ngobuwula kulokhu kuqiniseka kokuzibonga.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.17",
            "verseOrgIds": [
              "2CO.11.17"
            ]
          }
        }
      ]
    },
