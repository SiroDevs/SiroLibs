          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.15",
            "verseOrgIds": [
              "2CO.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyaphinda ngithi: Makungabikho muntu othi ngiyisiwula; uma kungenjalo, ngamukeleni njengesiwula, ukuze ngizibonge ingcosana.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.16",
            "verseOrgIds": [
              "2CO.11.16"
            ]
          }
        }
      ]
    },
    {
