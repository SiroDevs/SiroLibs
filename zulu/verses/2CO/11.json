          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngikhuluma njengehlazo, sengathi sasibuthakathaka. Kepha noma yikuphi lapho umuntu anesibindi ngakho (ngikhuluma ngobuwula) nginesibindi nami.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.21",
            "verseOrgIds": [
              "2CO.11.21"
            ]
          }
        }
