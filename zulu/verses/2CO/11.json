          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke akuyinto enkulu uma nezikhonzi zakhe ziziguqula izikhonzi zokulunga; abakuphela kwabo kuyakuba njengokwemisebenzi yabo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.15",
            "verseOrgIds": [
              "2CO.11.15"
            ]
          }
        }
      ]
    },
