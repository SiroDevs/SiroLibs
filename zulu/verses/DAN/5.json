        },
        {
          "text": "UDaniyeli wayesephendula, wathi phambi kwenkosi: “Izipho zakho mazibe ngeyakho, nemivuzo yakho uyinike omunye; kepha ngiyakuyifundela inkosi umbhalo, ngiyazise incazelo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.17",
            "verseOrgIds": [
              "DAN.5.17"
            ]
          }
        }
