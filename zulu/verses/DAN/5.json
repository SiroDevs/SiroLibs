              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.14",
            "verseOrgIds": [
              "DAN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje kwalethwa phambi kwami abahlakaniphileyo, nababuka izinkanyezi, ukuba bafunde lo mbhalo, bangazise incazelo yawo, kepha azikwazanga ukusho incazelo yalolu daba.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.15",
            "verseOrgIds": [
              "DAN.5.15"
            ]
          }
        }
      ]
    },
