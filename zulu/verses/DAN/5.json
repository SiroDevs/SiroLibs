          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lapho inhliziyo yakhe izikhukhumezile futhi ingqondo yakhe isilukhuni ngokuzidla, wehliswa esihlalweni sakhe sobukhosi, futhi basusa udumo lwakhe kuye.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.20",
            "verseOrgIds": [
