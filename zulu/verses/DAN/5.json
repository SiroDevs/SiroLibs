            "sid": "DAN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenxa yobukhulu abunika yena, bonke abantu, nezizwe, nezilimi bathuthumela, besaba phambi kwakhe; futhi lowo ayethanda wamgcina ephila; lalowo ayethanda ukumvusa; lalowo ayefuna ukumbeka phansi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.19",
            "verseOrgIds": [
              "DAN.5.19"
            ]
          }
        }
      ]
    },
