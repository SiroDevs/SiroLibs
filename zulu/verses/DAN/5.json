          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nkosi, uNkulunkulu oPhezukonke wanika uyihlo uNebukadinesari umbuso nobukhosi nodumo nodumo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.18",
