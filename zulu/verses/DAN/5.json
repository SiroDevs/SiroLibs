          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngizwile ngawe ukuthi ungakwazi ukuchaza futhi uxazulule ukungabaza; manje uma ukwazi ukuwufunda umbhalo, ungazise incazelo yawo, wembathiswe okubomvu, ufake neketanga legolide entanyeni yakho, ube ngowesithathu embusweni.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.16",
            "verseOrgIds": [
              "DAN.5.16"
            ]
          }
        }
      ]
