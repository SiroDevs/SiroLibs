          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yazi-ke futhi uqonde ukuthi kusukela ekuphumeni komyalo wokubuyisela nokwakha iJerusalema kuze kufike uMesiya, iNkosana, kuyohlala amasonto ayisikhombisa namasonto angamashumi ayisithupha nambili: umgwaqo uyokwakhiwa futhi nodonga, ngisho nasezikhathini ezinzima.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.25",
            "verseOrgIds": [
              "DAN.9.25"
            ]
          }
        }
      ]
