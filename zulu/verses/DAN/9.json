          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yangitshela, yakhuluma kimi, yathi: “Daniyeli, ngiphumile manje ukukunika ukuqonda nokuqondisisa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.22",
            "verseOrgIds": [
              "DAN.9.22"
            ]
          }
        }
