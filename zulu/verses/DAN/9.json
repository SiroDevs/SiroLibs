        },
        {
          "text": "Manje yizwa, Nkulunkulu wethu, umkhuleko wenceku yakho nokunxusa kwayo, futhi mawukhanyise ubuso bakho phezu kwendlu yakho engcwele echithekile ngenxa yeNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.17",
            "verseOrgIds": [
              "DAN.9.17"
            ]
          }
        }
      ]
