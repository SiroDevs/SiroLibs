          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.15",
            "verseOrgIds": [
              "DAN.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Jehova, ngokuvumelana nakho konke ukulunga kwakho, makususwe intukuthelo yakho nolaka lwakho emzini wakho iJerusalema, intaba yakho engcwele, ngenxa yezono zethu nangenxa yobubi bawokhokho bethu iJerusalema nabantu bakho. Ihlazo kubo bonke abaphezu kwethu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.16",
            "verseOrgIds": [
              "DAN.9.16"
            ]
          }
        }
      ]
    },
