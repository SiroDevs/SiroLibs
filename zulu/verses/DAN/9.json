          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekuqaleni kokunxusa kwakho kwaphuma umyalo, futhi ngiza ukukubonisa; ngoba uthandwa kakhulu; bese uqonda udaba futhi uqaphele ubuso.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.23",
            "verseOrgIds": [
              "DAN.9.23"
            ]
          }
        }
