          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasonto angamashumi ayisikhombisa amiselwe phezu kwabantu bakini naphezu komuzi wakho ongcwele ukuba afeze isiphambeko, aphelelise izono, enze ukubuyisana ngobubi, angenise ukulunga okuphakade, anamathelise umbono nesiprofetho, agcobe ibandla. Ngcwelengcwele.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.24",
            "verseOrgIds": [
              "DAN.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
