          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi emva kwamasonto angamashumi ayisithupha nambili uMesiya uyobhujiswa, kodwa hhayi yena; futhi abantu besikhulu esizayo bayochitha umuzi nendlu engcwele; futhi ukuphela kwawo kuyakuba ngozamcolo, futhi kuze kube sekupheleni kwempi ukuchithwa kumisiwe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.26",
            "verseOrgIds": [
              "DAN.9.26"
            ]
          }
        }
