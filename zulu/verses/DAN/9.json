          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yebo, ngisakhuluma emkhulekweni, umuntu uGabriyeli engambona embonweni ekuqaleni, wandiza masinyane, wangithinta ngesikhathi somnikelo wakusihlwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.21",
            "verseOrgIds": [
