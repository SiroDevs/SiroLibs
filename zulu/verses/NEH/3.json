            "sid": "NEH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eceleni kwabo uMelathiya waseGibeyoni noJadoni waseMeronoti, amadoda aseGibeyoni naseMispa, abuyisela esihlalweni sobukhosi sombusi ongasentshonalanga koMfula.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.7",
            "verseOrgIds": [
              "NEH.3.7"
            ]
          }
        }
      ]
    },
