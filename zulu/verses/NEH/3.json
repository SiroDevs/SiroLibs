          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwakhe kwalungisa uNehemiya, indodana ka-Ashibuki, umbusi wenxenye yeBeti-Suri, kwaze kwaba maqondana namathuna kaDavide, nasedamu elalakhiwe lapho, nasendlini yamaqhawe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        }
      ]
