            "sid": "NEH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eceleni kwabo kwasinda abaseThekhowa; kodwa izikhulu zabo kazibekanga izintamo zabo emsebenzini weNkosi yabo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        }
      ]
    },
    {
