            "sid": "NEH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eceleni kwakhe uShalumi indodana kaHalohesi, umbusi wengxenye yesifunda saseJerusalema, walungisa, yena namadodakazi akhe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
            "verseOrgIds": [
              "NEH.3.12"
            ]
          }
        }
      ]
