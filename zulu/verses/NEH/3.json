          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "IDalpoort yabuyisela uHanuni nabakhileyo eSanowagi; balakha, bamisa izivalo zalo, nemigoqo yalo, nemishudo yalo, nezingalo eziyinkulungwane ngasemdulini kwaze kwaba seSangweni Lomquba.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        }
      ]
    },
    {
