          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMalikhiya, indodana kaHarimi, noHasubu, indodana kaPhahati Mowabi, balungisa elinye ibanga nombhoshongo wamaziko.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.11",
            "verseOrgIds": [
              "NEH.3.11"
            ]
          }
        }
