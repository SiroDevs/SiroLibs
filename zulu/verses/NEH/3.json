          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eceleni kwakhe kwalungisa u-Uziyeli indodana kaHarihaya, umkhandi wegolide; Eceleni kwakhe uHananiya, indodana yabathaki beziqholo, naye wabuya, baqinisa iJerusalema kuze kube sogangeni olubanzi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.8",
            "verseOrgIds": [
              "NEH.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
