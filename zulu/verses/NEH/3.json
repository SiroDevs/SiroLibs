          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ISango Lomthombo lalilungiswa nguShaluni indodana kaKolihose, umbusi wesifunda saseMispa; walakha, walisibekela, wamisa izivalo zalo, nezihluthulelo zalo, nemigoqo yalo, nogange lwechibi laseSilowama ngasensimini yenkosi, kuze kufike ezitebhisini ezehla emzini kaDavide.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        }
