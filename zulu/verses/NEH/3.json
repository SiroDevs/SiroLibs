          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eceleni kwabo uRefaya indodana kaHure, umbusi wengxenye yesifunda saseJerusalema, walungisa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.9",
            "verseOrgIds": [
              "NEH.3.9"
            ]
          }
        }
