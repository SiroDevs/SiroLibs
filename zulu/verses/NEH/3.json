          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ISango Lomquba lalilungiswa nguMalikiya, indodana kaRekabi, umbusi wesifunda saseBeti Hakeremi; walakha, wamisa izivalo zalo nezihluthulelo zalo nemigoqo yalo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        }
