            "sid": "NEH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isango elidala lalilungiswa nguJehoyada indodana kaPhasehaki, noMeshulamu indodana kaBesodiya; babeka imishayo yalo, bamisa izivalo zalo nezihluthulelo zalo nemigoqo yalo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.6",
            "verseOrgIds": [
              "NEH.3.6"
            ]
          }
        }
      ]
    },
    {
