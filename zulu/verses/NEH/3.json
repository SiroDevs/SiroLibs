            "sid": "NEH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwase kusukuma u-Eliyashibi umpristi omkhulu nabafowabo abapristi, bakha iSango Lezimvu; balingcwelisa, bamisa izivalo zalo; kwaze kwaba seMbhoshongweni waseMeya bawungcwelisa, kwaze kwaba naseMbhoshongweni kaHananeli.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.1",
            "verseOrgIds": [
              "NEH.3.1"
            ]
          }
        }
      ]
    },
    {
