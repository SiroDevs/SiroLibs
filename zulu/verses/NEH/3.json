            "number": "10",
            "style": "v",
            "sid": "NEH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eceleni kwabo kwalungisa uJedaya indodana kaHarumafi malungana nendlu yakhe. Eceleni kwakhe uHathusi, indodana kaHasabinja, walulama.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.10",
            "verseOrgIds": [
              "NEH.3.10"
            ]
          }
        }
      ]
    },
    {
