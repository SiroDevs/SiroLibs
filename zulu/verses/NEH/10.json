              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "okwesinkwa sokubukwa, nomnikelo wempuphu waphakade, nomnikelo oshiswa imihla yonke, owesabatha, nowokwethwasa kwenyanga, nowemikhosi, nowezinto ezingcwele, noweminikelo yesono, ukwenzela u-Israyeli ukubuyisana, nawo wonke umsebenzi. Endlini kaNkulunkulu wethu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        }
      ]
