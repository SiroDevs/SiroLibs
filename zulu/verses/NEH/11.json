          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMathaniya, indodana kaMika, indodana kaSabidi, indodana ka-Asafa, wayeyinhloko ukuqala ukubonga emkhulekweni; noBakibukiya owesibili kubafowabo, no-Abisa, indodana kaSamuwa, indodana kaGalali, indodana kaJeduthuni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.17",
            "verseOrgIds": [
              "NEH.11.17"
            ]
          }
        }
