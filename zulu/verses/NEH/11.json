            "sid": "NEH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "USeraya indodana kaHilikiya indodana kaMeshulamu indodana kaSadoki indodana kaMerayoti indodana ka-Ahithubi wayengumphathi wendlu kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.11",
            "verseOrgIds": [
              "NEH.11.11"
            ]
          }
        }
