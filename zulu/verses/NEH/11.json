          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabafowabo, amaqhawe anesibindi, ikhulu namashumi amabili nesishiyagalombili; umbonisi wabo kwakunguSabidiyeli indodana yezikhulu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.14",
            "verseOrgIds": [
              "NEH.11.14"
            ]
          }
        }
