          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "KumaLevi: nguShemaya, indodana kaHashubi, indodana ka-Asirikamu, indodana kaHashabiya, indodana kaBuni;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.15",
            "verseOrgIds": [
              "NEH.11.15"
            ]
          }
        }
