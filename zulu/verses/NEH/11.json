          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "OSabhethayi noJozabadi ezinhloko zamaLevi babephethe umsebenzi wangaphandle wendlu kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.16",
            "verseOrgIds": [
              "NEH.11.16"
            ]
          }
