          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabafowabo, izinhloko zawoyise, bengamakhulu amabili namashumi amane nambili; no-Amasayi indodana ka-Azareli indodana ka-Ahashayi indodana kaMeshilemoti indodana ka-Imeri,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.13",
            "verseOrgIds": [
              "NEH.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
