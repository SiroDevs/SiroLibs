          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "besenqabela ukuthi sikhulume kwabezizwe ukuze basindiswe, bagcwalise izono zabo njalonjalo;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.16",
            "verseOrgIds": [
              "1TH.2.16"
            ]
          }
        }
