          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha thina, bazalwane, njengokuba sasuswa kini isikhathi esifushane ebusweni, kungenganhliziyo, sakhuthalela kakhulu kakhulu ukubona ubuso benu ngokufisa okukhulu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.17",
            "verseOrgIds": [
              "1TH.2.17"
            ]
          }
        }
      ]
    },
