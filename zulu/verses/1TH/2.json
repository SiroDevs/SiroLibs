        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.14",
            "verseOrgIds": [
              "1TH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ababulala iNkosi uJesu nabaprofethi babo, basizingela nathi; abamthokozisi uNkulunkulu, baphambene nabantu bonke;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.15",
            "verseOrgIds": [
              "1TH.2.15"
            ]
          }
        }
      ]
    },
