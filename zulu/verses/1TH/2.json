          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.11",
            "verseOrgIds": [
              "1TH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze nihambe ngokufanele uNkulunkulu owanibizela embusweni nasenkazimulweni yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.12",
            "verseOrgIds": [
              "1TH.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.12",
            "verseOrgIds": [
              "1TH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho nathi siyambonga uNkulunkulu singaphezi, ngokuba, lapho namukela izwi likaNkulunkulu enalizwa ngathi, anilamukelanga njengezwi labantu, kodwa njengezwi likaNkulunkulu elisebenzayo ngokweqiniso. Nakini enikholwayo.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.13",
            "verseOrgIds": [
              "1TH.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 2:13"
          },
          "items": [
            {
              "text": "13",
