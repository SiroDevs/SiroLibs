          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho kwathi singasenakubekezela, sakubona kukuhle ukuthi sisale sodwa e-Athene;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.1",
            "verseOrgIds": [
              "1TH.3.1"
            ]
          }
        }
      ]
    },
    {
