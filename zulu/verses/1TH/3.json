          "attrs": {
            "verseId": "1TH.3.5",
            "verseOrgIds": [
              "1TH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa khathesi uThimothi esefikile kithi evela kini, esibikele izindaba ezinhle zokukholwa kwenu lothando lwenu, lokuthi lihlala lisikhumbula okuhle, lifisa kakhulu ukusibona, njengoba lathi silibona;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.6",
            "verseOrgIds": [
              "1TH.3.6"
            ]
          }
        }
      ]
    },
