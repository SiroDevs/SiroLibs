          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuze aqinise izinhliziyo zenu zingasoleki ebungcweleni phambi kukaNkulunkulu uBaba wethu ekufikeni kweNkosi yethu uJesu Kristu kanye nabangcwele bayo bonke.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.13",
            "verseOrgIds": [
