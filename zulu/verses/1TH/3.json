          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke, bazalwane, siduduzekile ngani kukho konke ukuhlupheka kwethu losizi ngokholo lwenu;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.7",
            "verseOrgIds": [
              "1TH.3.7"
            ]
          }
        }
      ]
    },
