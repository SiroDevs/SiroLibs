          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anginanto eqinisekileyo ngaye engingayilobela inkosi yami. Ngakho-ke ngimethulile phambi kwenu, futhi ikakhulukazi phambi kwakho, nkosi Agripha, ukuze kuthi ngemva kokuhlolwa ngibe nakho engingakuloba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.26",
            "verseOrgIds": [
