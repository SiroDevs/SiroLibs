              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi sengitsheliwe ukuthi abaJuda babeqamekele lowo muntu, ngathumela kuwe masinyane, ngase ngibayala abammangalelayo ukuba bakhulume phambi kwakho ngalokho abanawo ngakuyo. Ukuvalelisa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.30",
            "verseOrgIds": [
              "ACT.23.30"
            ]
          }
        }
