            "sid": "ACT 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalezo zinsuku, abafundi banda, kwavela ukukhonona kwabekhuluma isiGreki ngamaHeberu, ngokuba abafelokazi bawo babenganakwa enkonzweni yezinsuku zonke.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.1",
            "verseOrgIds": [
              "ACT.6.1"
            ]
          }
        }
      ]
    },
    {
