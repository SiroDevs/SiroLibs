        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.4",
            "verseOrgIds": [
              "ACT.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelizwi lathokozisa ixuku lonke, basebekhetha uStefane, indoda egcwele ukholo loMoya oNgcwele, loFiliphu, loProkoro, loNikanori, loTimoni, loParmena, loNikolasi umproselithe waseAntiyoki;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.5",
            "verseOrgIds": [
              "ACT.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
