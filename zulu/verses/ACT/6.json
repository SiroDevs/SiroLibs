          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.1",
            "verseOrgIds": [
              "ACT.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayishumi nambili base bebizela kubo uquqaba lwabafundi, bathi: “Akukuhle ukuba thina sishiye izwi likaNkulunkulu, sikhonze ematafuleni.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.2",
            "verseOrgIds": [
              "ACT.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.2",
            "verseOrgIds": [
              "ACT.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke, bazalwane, zifuneleni phakathi kwenu amadoda ayisikhombisa anodumo oluhle, agcwele uMoya oNgcwele nokuhlakanipha, esingawabeka phezu kwalo msebenzi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.3",
            "verseOrgIds": [
              "ACT.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.3",
            "verseOrgIds": [
              "ACT.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha thina siyakukhuthalela ukukhuleka, nasenkonzweni yezwi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.4",
            "verseOrgIds": [
              "ACT.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
