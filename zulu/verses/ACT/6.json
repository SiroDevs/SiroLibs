          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelizwi likaNkulunkulu landa; isibalo sabafundi sanda kakhulu eJerusalema; nesixuku esikhulu sabapristi salalela ukholo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.7",
            "verseOrgIds": [
              "ACT.6.7"
            ]
          }
        }
      ]
    },
    {
