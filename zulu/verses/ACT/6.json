        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.7",
            "verseOrgIds": [
              "ACT.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uStefanu egcwele ukholo namandla wenza izimangaliso nezimangaliso ezinkulu phakathi kwabantu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.8",
            "verseOrgIds": [
              "ACT.6.8"
            ]
          }
        }
      ]
    },
    {
