          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ababeka phambi kwabaphostoli; sebekhulekile babeka izandla phezu kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.6",
            "verseOrgIds": [
              "ACT.6.6"
            ]
          }
        }
      ]
