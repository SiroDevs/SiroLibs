        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebevusa abantu labadala lababhali, basebesondela kuye, bambamba, bamusa emphakathini;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.12",
            "verseOrgIds": [
              "ACT.6.12"
            ]
          }
        }
      ]
