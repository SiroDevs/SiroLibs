          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba simzwile ethi loJesu waseNazaretha uzakuchitha le ndawo, aguqule amasiko uMose asinika wona.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.14",
            "verseOrgIds": [
              "ACT.6.14"
            ]
          }
        }
