          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bemisa ofakazi bamanga abathi: “Lona kayeki ukukhuluma amazwi ayinhlamba ngale ndawo engcwele nangomthetho;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.13",
            "verseOrgIds": [
              "ACT.6.13"
            ]
          }
        }
