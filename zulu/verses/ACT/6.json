        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona bakhohlisa amadoda athi: Simzwile ekhuluma amazwi enhlamba ngoMozisi langoNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.11",
            "verseOrgIds": [
              "ACT.6.11"
            ]
          }
        }
      ]
    },
    {
