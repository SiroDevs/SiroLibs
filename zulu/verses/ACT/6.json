        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.9",
            "verseOrgIds": [
              "ACT.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa babengelakho ukumelana lokuhlakanipha loMoya ayekhuluma ngaye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.10",
            "verseOrgIds": [
              "ACT.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
