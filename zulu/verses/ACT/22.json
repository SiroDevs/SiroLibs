          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho kuchithwa igazi likaStefanu ufakazi wakho, nami ngangimi khona, ngivumelana nokubulawa kwakhe, ngilinda izingubo zabambulalayo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.20",
            "verseOrgIds": [
              "ACT.22.20"
            ]
          }
        }
      ]
    },
    {
