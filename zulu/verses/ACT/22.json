          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Induna yenkulungwane yasiphendula yathi: Mina ngalizuza ngemali enkulu. UPawuli wasesithi: Kodwa mina ngizelwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.28",
            "verseOrgIds": [
              "ACT.22.28"
            ]
