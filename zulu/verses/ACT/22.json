          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi bekhala, belahla izingubo zabo, baphonsa uthuli emoyeni;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.23",
            "verseOrgIds": [
              "ACT.22.23"
            ]
          }
        }
