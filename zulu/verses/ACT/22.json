          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngase ngithi: Nkosi, bayazi bona ukuthi bengibabopha ngibashaya emasinagogeni wonke abakholwa nguwe;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.19",
            "verseOrgIds": [
              "ACT.22.19"
            ]
          }
        }
      ]
