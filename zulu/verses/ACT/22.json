            "number": "25",
            "style": "v",
            "sid": "ACT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi besambopha ngemichilo, uPawuli wathi enduneni yekhulu eyayimi lapho: Kuvunyelwe yini kini ukutshaya ngesiswepu umuntu ongumRoma engalahlwanga yicala?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.25",
            "verseOrgIds": [
              "ACT.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
