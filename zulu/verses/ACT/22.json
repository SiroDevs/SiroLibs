          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebemlalela kwaze kwaba kulelolizwi, basebephakamisa amazwi abo besithi: Msuseni onjalo emhlabeni, ngoba kakufanelanga ukuthi aphile.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.22",
            "verseOrgIds": [
              "ACT.22.22"
            ]
          }
        }
