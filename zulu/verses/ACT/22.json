          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Induna yenkulungwane yasilaya ukuthi angeniswe enqabeni, yasilaya ukuthi aphenywe ngesiswepu; ukuze azi ukuthi kungani bekhala kanje kuye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.24",
            "verseOrgIds": [
              "ACT.22.24"
            ]
          }
        }
