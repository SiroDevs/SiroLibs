          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma nginitshelile okusemhlabeni, ningakholwa, niyakukholwa kanjani, uma nginitshela okwasezulwini na?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.12",
            "verseOrgIds": [
              "JHN.3.12"
