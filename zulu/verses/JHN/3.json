          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakho nowenyukele ezulwini, kuphela yena owehla ezulwini, iNdodana yomuntu esezulwini.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.13",
