            "number": "6",
            "style": "v",
            "sid": "JHN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokho okuzelwe yinyama kuyinyama; nalokho okuzelwe nguMoya kungumoya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.6",
            "verseOrgIds": [
              "JHN.3.6"
            ]
          }
        }
      ]
    },
    {
