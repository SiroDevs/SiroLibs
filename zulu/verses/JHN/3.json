            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu waphendula, wathi kuye: “Wena ungumfundisi ka-Israyeli, awuzazi lezi zinto na?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.10",
            "verseOrgIds": [
              "JHN.3.10"
            ]
          }
        }
