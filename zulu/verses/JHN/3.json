            "sid": "JHN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu waphendula wathi: Ngiqinisile, ngiqinisile ngithi kuwe: Ngaphandle kokuthi umuntu azalwe ngamanzi langoMoya, angengene embusweni kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.5",
            "verseOrgIds": [
              "JHN.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
