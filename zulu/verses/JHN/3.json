          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiqinisile, ngiqinisile ngithi kuwe: Sikhuluma esikwaziyo, sifakaza ngesikubonileyo; kepha anibamukeli ubufakazi bethu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.11",
            "verseOrgIds": [
              "JHN.3.11"
