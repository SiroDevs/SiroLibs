          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umoya uphephetha lapho othanda khona, uyawuzwa umsindo wawo, kepha awukwazi lapho uvela khona nalapho uya khona; unjalo wonke ozelwe nguMoya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.8",
            "verseOrgIds": [
              "JHN.3.8"
            ]
          }
