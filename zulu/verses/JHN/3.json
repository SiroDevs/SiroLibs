              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengokuba uMose waphakamisa inyoka ehlane, kanjalo iNdodana yomuntu imelwe ukuphakanyiswa;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.14",
            "verseOrgIds": [
