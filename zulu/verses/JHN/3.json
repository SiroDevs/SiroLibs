          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungamangali ngokuba ngithe kuwe: Nimelwe ukuzalwa ngokusha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.7",
            "verseOrgIds": [
              "JHN.3.7"
            ]
