          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona umuntu wakubaFarisi, nguNikodemu igama lakhe, isikhulu sabaJuda;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.1",
            "verseOrgIds": [
              "JHN.3.1"
            ]
          }
        }
      ]
    },
    {
