          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina ngibanikile izwi lakho; nezwe labazonda, ngokuba bengesibo abezwe, njengalokhu nami ngingesiye owezwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.14",
            "verseOrgIds": [
              "JHN.17.14"
            ]
          }
        }
      ]
    },
