        {
          "text": "Bangcwelise ngeqiniso; izwi lakho liyiqiniso.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.17",
            "verseOrgIds": [
              "JHN.17.17"
            ]
          }
        }
