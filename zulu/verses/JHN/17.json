          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wakhuluma lokho, wayesephakamisela amehlo akhe ezulwini, wathi: “Baba, isikhathi sesifikile; khazimulisa iNdodana yakho, ukuze iNdodana yakho ikukhazimulise wena;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.1",
            "verseOrgIds": [
              "JHN.17.1"
            ]
          }
        }
      ]
    },
    {
