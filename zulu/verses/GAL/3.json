          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazalwane, ngikhuluma ngokwabantu; Noma kuyisivumelwano somuntu, nokho siqinisekiswa, akakho ongasichithayo nonganezela kuso.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.15",
            "verseOrgIds": [
              "GAL.3.15"
            ]
          }
        }
