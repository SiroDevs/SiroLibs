          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha umbhalo uvalile konke phansi kwesono, ukuze isithembiso ngokukholwa nguJesu Kristu siphiwe abakholwayo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.22",
            "verseOrgIds": [
