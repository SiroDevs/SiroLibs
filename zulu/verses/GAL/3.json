          ]
        },
        {
          "text": "Ngokuba uma ifa lingokomthetho, alikho ngesithembiso, kepha uNkulunkulu walinika u-Abrahama ngesithembiso.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.18",
            "verseOrgIds": [
              "GAL.3.18"
            ]
          }
        }
      ]
    },
    {
