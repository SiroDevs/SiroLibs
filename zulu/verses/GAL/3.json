          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje izithembiso zenziwa ku-Abrahama nasenzalweni yakhe. Akasho ukuthi: Nasezinzalweni, kungathi ngeziningi; kodwa kungathi ngeyodwa: Nasenzalweni yakho enguKristu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.16",
            "verseOrgIds": [
              "GAL.3.16"
            ]
          }
        }
      ]
    },
