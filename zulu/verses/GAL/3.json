          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UKristu wasihlenga esiqalekisweni somthetho, esenziwe isiqalekiso ngenxa yethu, ngokuba kulotshiwe ukuthi: “Uqalekisiwe wonke olenga emthini;",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.13",
            "verseOrgIds": [
              "GAL.3.13"
            ]
          }
        }
