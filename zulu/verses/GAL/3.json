          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho yena oniphayo uMoya nowenza imisebenzi yamandla phakathi kwenu ukwenza ngemisebenzi yomthetho noma ngezwi lokukholwa na?",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.5",
            "verseOrgIds": [
              "GAL.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
