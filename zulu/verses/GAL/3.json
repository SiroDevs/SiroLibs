        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.10",
            "verseOrgIds": [
              "GAL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ukuthi ngomthetho kakho olungisiswayo phambi kukaNkulunkulu, kusobala, ngoba olungileyo uzaphila ngokukholwa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.11",
            "verseOrgIds": [
              "GAL.3.11"
            ]
          }
        }
      ]
    },
