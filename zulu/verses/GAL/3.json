        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.5",
            "verseOrgIds": [
              "GAL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
