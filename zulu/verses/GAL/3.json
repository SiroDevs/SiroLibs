          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba bonke abemisebenzi yomthetho baphansi kwesiqalekiso, ngokuba kulotshiwe ukuthi: “Baqalekisiwe bonke abangahlali kukho konke okulotshiweyo encwadini yomthetho, ukuba bakwenze.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.10",
            "verseOrgIds": [
              "GAL.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
