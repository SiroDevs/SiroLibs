        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.1",
            "verseOrgIds": [
              "GAL.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilokhu kuphela engifuna ukukufunda kini: Namamukela uMoya ngemisebenzi yomthetho noma ngezwi lokukholwa na?",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.2",
            "verseOrgIds": [
              "GAL.3.2"
            ]
          }
        }
      ]
    },
    {
