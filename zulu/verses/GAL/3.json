          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nina baseGalathiya abayiziwula, ngubani oniloyile ukuba ningalaleli iqiniso enibekwe obala phambi kwamehlo enu uJesu Kristu ebethelwe esiphambanweni na?",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.1",
            "verseOrgIds": [
              "GAL.3.1"
            ]
          }
        }
      ]
    },
    {
