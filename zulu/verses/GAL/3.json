              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke umthetho waba ngumfundisi wethu wokusiyisa kuKristu, ukuze silungisiswe ngokukholwa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.24",
