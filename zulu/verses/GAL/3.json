            "sid": "GAL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "njengalokho u-Abrahama wakholwa nguNkulunkulu, kwabalelwa kuye ukuthi kungukulunga.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.6",
            "verseOrgIds": [
              "GAL.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.6",
            "verseOrgIds": [
              "GAL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho yazini ukuthi abangabokukholwa yibona abangabantwana bakaAbrahama.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.7",
            "verseOrgIds": [
              "GAL.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.7",
            "verseOrgIds": [
              "GAL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbhalo ubona ngaphambili ukuthi uNkulunkulu uzakulungisisa abezizwe ngokukholwa, walitshumayela ngaphambili ivangeli kuAbrahama, lokuthi: Izizwe zonke zizabusiswa ngawe.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.8",
            "verseOrgIds": [
              "GAL.3.8"
            ]
          }
        }
      ]
    },
    {
