            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke abokukholwa bayabusiswa kanye no-Abrahama okholwayo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.9",
            "verseOrgIds": [
              "GAL.3.9"
