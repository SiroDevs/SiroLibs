          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze isibusiso sika-Abrahama sibe phezu kwabezizwe ngoKristu Jesu; ukuze samukele isithembiso sikaMoya ngokukholwa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.14",
            "verseOrgIds": [
              "GAL.3.14"
            ]
          }
        }
      ]
    },
    {
