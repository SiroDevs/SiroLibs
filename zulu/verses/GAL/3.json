            "sid": "GAL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingabe nahlupheka kangaka ngeze na? uba kuseyize.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.4",
            "verseOrgIds": [
              "GAL.3.4"
            ]
          }
        }
      ]
    },
    {
