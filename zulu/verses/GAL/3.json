          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha umlamuleli kasiye owayedwa, kepha uNkulunkulu munye.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.20",
            "verseOrgIds": [
              "GAL.3.20"
            ]
          }
