        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingabe niyiziwula kangaka na? seniqale ngoMoya manje senipheleliswe enyameni na?",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.3",
            "verseOrgIds": [
              "GAL.3.3"
            ]
          }
        }
      ]
    },
    {
