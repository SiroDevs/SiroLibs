            "sid": "GAL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomthetho awusiwo ongowokukholwa, kodwa uthi: Umuntu owenzayo uyakuphila ngakho.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.12",
            "verseOrgIds": [
              "GAL.3.12"
