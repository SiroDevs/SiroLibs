              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha kungakafiki ukukholwa, sasigcinwa phansi komthetho, sivalelwe kuze kufike ukukholwa obekuzakwambulwa kamuva.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.23",
