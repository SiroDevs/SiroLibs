        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazalwane, uma umuntu ehlelwa yisiphambeko, nina bomoya mbuyiseni onjalo ngomoya wobumnene; uzinaka wena, funa ulingwe nawe.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.1",
            "verseOrgIds": [
              "GAL.6.1"
            ]
          }
        }
      ]
    },
    {
