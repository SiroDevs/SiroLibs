          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa yilowo lalowo kahlole owakhe umsebenzi, yikhona ezakuba lokuzibonga yena yedwa, hatshi ngomunye.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.4",
            "verseOrgIds": [
              "GAL.6.4"
            ]
          }
        }
      ]
    },
    {
