              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusukela manje makungabikho muntu ongihluphayo, ngokuba nginezimpawu zeNkosi uJesu emzimbeni wami.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
            "verseOrgIds": [
              "GAL.6.17"
            ]
          }
