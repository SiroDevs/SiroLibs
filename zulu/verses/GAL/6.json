          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bonke abahamba ngalo mthetho, makube kubo ukuthula nesihawu, naku-Israyeli kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.16",
            "verseOrgIds": [
              "GAL.6.16"
            ]
          }
