          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba kuKristu Jesu ukusoka nokungasoki akulutho, kodwa isidalwa esisha.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.15",
            "verseOrgIds": [
              "GAL.6.15"
            ]
          }
        }
