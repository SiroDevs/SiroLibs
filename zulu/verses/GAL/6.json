          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abafuna ukubonakala bebahle enyameni, yibona abanicindezela ukuba nisokwe; kuphela funa bazingelwe ngenxa yesiphambano sikaKristu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.12",
            "verseOrgIds": [
              "GAL.6.12"
            ]
          }
        }
      ]
    },
    {
