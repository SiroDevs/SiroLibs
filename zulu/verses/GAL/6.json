          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba labo abasokileyo kabawugcini umlayo; kodwa bafisa ukuthi nisokwe, ukuze bazincome enyameni yenu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.13",
            "verseOrgIds": [
              "GAL.6.13"
            ]
          }
        }
      ]
