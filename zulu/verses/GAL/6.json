          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.1",
            "verseOrgIds": [
              "GAL.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thwalisanani imithwalo yenu, kanjalo nigcwalise umthetho kaKristu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.2",
            "verseOrgIds": [
              "GAL.6.2"
            ]
          }
        }
      ]
    },
    {
