          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke njengokuba sinethuba, asenze okuhle kubo bonke, ikakhulu kwabendlu yokukholwa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.10",
            "verseOrgIds": [
              "GAL.6.10"
            ]
          }
        }
      ]
    },
