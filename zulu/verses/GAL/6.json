        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.2",
            "verseOrgIds": [
              "GAL.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uma umuntu ezishaya utho, engelutho, uyazikhohlisa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.3",
            "verseOrgIds": [
              "GAL.6.3"
            ]
          }
        }
      ]
    },
    {
