          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha mangingazibonga mina, kuphela ngesiphambano seNkosi yethu uJesu Kristu, okubethelwe ngaye izwe kimi, nami ezweni.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.14",
            "verseOrgIds": [
              "GAL.6.14"
            ]
          }
        }
      ]
