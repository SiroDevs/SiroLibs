        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.4",
            "verseOrgIds": [
              "GAL.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba thina ngoMoya silindele ithemba lokulunga ngokukholwa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.5",
            "verseOrgIds": [
              "GAL.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
