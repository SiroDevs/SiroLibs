          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba nina, bazalwane, nabizelwa enkululekweni; Kuphela ningasebenzisi inkululeko ibe yithuba enyameni, kodwa khonzanani ngothando.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.13",
            "verseOrgIds": [
              "GAL.5.13"
            ]
          }
        }
      ]
    },
    {
