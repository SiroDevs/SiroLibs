            "style": "v",
            "sid": "GAL 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba inyama ikhanuka okuphambene noMoya, noMoya ukhanuka okuphambene nenyama; lezi zinto ziphambene, ukuze ningenzi enikuthandayo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.17",
            "verseOrgIds": [
              "GAL.5.17"
            ]
          }
        }
      ]
    },
    {
