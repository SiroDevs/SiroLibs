          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho ngithi: Hambani ngoMoya, khona aniyikufeza izinkanuko zenyama.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.16",
            "verseOrgIds": [
              "GAL.5.16"
            ]
          }
        }
      ]
    },
    {
