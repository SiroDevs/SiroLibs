            "number": "12",
            "style": "v",
            "sid": "EZR 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.12",
            "verseOrgIds": [
              "EZR.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuze abantu bahluleke ukwehlukanisa umsindo wenjabulo nokukhala kwabantu;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.13",
            "verseOrgIds": [
              "EZR.3.13"
            ]
          }
        }
      ]
