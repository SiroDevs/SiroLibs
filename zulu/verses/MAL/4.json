            "sid": "MAL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khumbulani umthetho kaMose inceku yami engamyala ngawo eHorebe ngoIsrayeli wonke, izimiso nezahlulelo.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.4.4"
            ]
