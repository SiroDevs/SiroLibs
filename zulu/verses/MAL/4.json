          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyakunyathela ababi; ngokuba bayakuba njengaphansi kwamathe ezinyawo zenu mhla ngenza lokhu,” usho uJehova Sebawoti.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.4.3"
            ]
