          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhekani, ngiyakuthuma kini u-Eliya umprofethi, lungakafiki usuku lukaJehova olukhulu nolwesabekayo.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.4.5"
