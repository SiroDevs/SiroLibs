      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.10",
            "verseOrgIds": [
              "1PE.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "behlolisisa ukuthi yisiphi, loba esinjani isikhathi uMoya kaKristu owayekubo, efakaza ngaphambili ngenhlupheko zikaKristu, lenkazimulo eyayiza kulandela.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.11",
            "verseOrgIds": [
              "1PE.1.11"
            ]
          }
        }
      ]
