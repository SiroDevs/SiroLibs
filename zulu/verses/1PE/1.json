          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi uma nibiza uBaba owahlulela wonke umuntu ngokomsebenzi womuntu engakhethi buso, sebenzisani isikhathi sokuhlala kwenu lapha ngokwesaba;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.17",
            "verseOrgIds": [
              "1PE.1.17"
            ]
          }
        }
      ]
