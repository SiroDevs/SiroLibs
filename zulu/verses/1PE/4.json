            "sid": "1PE 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "abayakulandisa kuye olungele ukwahlulela abaphilayo nabafileyo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.5",
            "verseOrgIds": [
              "1PE.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
