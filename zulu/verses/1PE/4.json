          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.6",
            "verseOrgIds": [
              "1PE.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha ukuphela kwakho konke sekusondele;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.7",
            "verseOrgIds": [
              "1PE.4.7"
            ]
          }
        }
