          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.11",
            "verseOrgIds": [
              "1PE.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathandekayo, ningamangali ngokulingwa okuvuthayo enibhekene nakho, ngokungathi nehlelwa yisimangaliso;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.12",
            "verseOrgIds": [
              "1PE.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.12",
            "verseOrgIds": [
              "1PE.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa thokozani, njengoba lingabahlanganyeli bezinhlupheko zikaKristu; ukuze kuthi, lapho sekwambulwa inkazimulo yakhe, nijabule futhi ngentokozo enkulu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.13",
            "verseOrgIds": [
              "1PE.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
