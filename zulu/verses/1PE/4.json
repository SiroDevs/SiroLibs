        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.13",
            "verseOrgIds": [
              "1PE.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma nihlanjalazwa ngenxa yegama likaKristu, nibusisiwe; ngokuba uMoya wenkazimulo nokaNkulunkulu uhlezi phezu kwenu;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.14",
            "verseOrgIds": [
              "1PE.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
