            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba isikhathi sesifikile sokuba ukwahlulela kuqale endlini kaNkulunkulu; uma kuqala kithi, kuyakuba yini ukuphela kwabangalaleli ivangeli likaNkulunkulu na?",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.17",
            "verseOrgIds": [
              "1PE.4.17"
            ]
          }
        }
      ]
    },
