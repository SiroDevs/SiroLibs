            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa makungabikho kini ohlupheka ngokuba engumbulali, noma eyisela, noma engumenzi wokubi, noma engugaxekile ezindabeni zabanye;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.15",
            "verseOrgIds": [
              "1PE.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
