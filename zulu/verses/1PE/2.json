          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibe nenkambo enhle phakathi kwabezizwe, ukuze kuthi, benihleba ngathi ningabenzi bokubi, babone imisebenzi yenu emihle abayoyibona, badumise uNkulunkulu ngosuku lokuhanjelwa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.12",
            "verseOrgIds": [
              "1PE.2.12"
            ]
          }
        }
      ]
