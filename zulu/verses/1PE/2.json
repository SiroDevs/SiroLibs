          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "enanikade ningesiso isizwe, kepha manje ningabantu bakaNkulunkulu, enaningahawukelwanga, kepha manje nihawukelwe.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.10",
            "verseOrgIds": [
              "1PE.2.10"
            ]
          }
        }
