          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "netshe lokukhubekisa, nedwala lokuwisa, kwabakhubekayo ngezwi ngokungalilaleli, ababemiselwe lokho futhi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
