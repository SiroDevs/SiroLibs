          ]
        },
        {
          "text": "njengabakhululekileyo, njalo lingasebenzisi inkululeko yenu njengesigubuzelo sobubi, kodwa njengezinceku zikaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.16",
