          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho lahlani ububi bonke, nobuqili bonke, nokuzenzisa, nomhawu, nakho konke ukuhleba;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.1",
            "verseOrgIds": [
              "1PE.2.1"
            ]
          }
        }
      ]
    },
