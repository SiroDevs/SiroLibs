        {
          "text": "noma kubabusi njengabathunywe nguye ukujezisa abenzi bokubi, batuswe abenza okuhle.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.14",
            "verseOrgIds": [
              "1PE.2.14"
