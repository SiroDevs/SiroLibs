          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathandekayo, ngiyanincenga njengabafokazi nezihambi ukuba nidede ezinkanukweni zenyama ezilwa nomphefumulo;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.11",
            "verseOrgIds": [
              "1PE.2.11"
            ]
          }
        }
