          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho kini enikholwayo uligugu, kepha kwabangalaleli itshe abakhi abalalayo, yilo laba yinhloko yegumbi;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.7",
            "verseOrgIds": [
              "1PE.2.7"
            ]
          }
        }
      ]
    },
