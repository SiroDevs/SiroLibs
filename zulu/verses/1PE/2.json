          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zithobeni kuzo zonke izimiso zabantu ngenxa yeNkosi: noma kusenkosini, njengophakeme;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.13",
            "verseOrgIds": [
              "1PE.2.13"
            ]
          }
        }
