            "sid": "1PE 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha nina niluhlanga olukhethiweyo, ubupristi obobukhosi, isizwe esingcwele, abantu abazuziweyo; ukuze nishumayele ubukhosi balowo owanibiza niphume ebumnyameni, ningene ekukhanyeni kwakhe okumangalisayo;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.9",
            "verseOrgIds": [
              "1PE.2.9"
            ]
          }
        }
      ]
    },
