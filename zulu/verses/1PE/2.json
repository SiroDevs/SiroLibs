              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba injalo intando kaNkulunkulu, ukuba ngokwenza okuhle nithulise ukungazi kwabantu abayiziwula;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.15",
            "verseOrgIds": [
              "1PE.2.15"
            ]
