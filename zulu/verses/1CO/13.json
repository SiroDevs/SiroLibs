          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluthokozi ngokungalungile, kepha luthokozela iqiniso;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.6",
            "verseOrgIds": [
              "1CO.13.6"
            ]
          }
        }
      ]
