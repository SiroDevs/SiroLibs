          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha nxa kufika okupheleleyo, okuyinxenye kuyakuqedwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.10",
            "verseOrgIds": [
              "1CO.13.10"
            ]
          }
        }
