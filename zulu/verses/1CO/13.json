          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uthando alusoze lwaphela; noma kukhona izilimi, ziyakunqamuka; noma kukhona ukwazi, kuyakunyamalala.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.8",
            "verseOrgIds": [
              "1CO.13.8"
            ]
          }
        }
      ]
    },
