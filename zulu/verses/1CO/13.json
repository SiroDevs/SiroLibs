          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba manje sibona esibukweni kalufifi; kepha ngaleso sikhathi ubuso nobuso; manje ngazi inxenye; kodwa ngalesosikhathi ngizakwazi njengoba lami ngaziwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.12",
            "verseOrgIds": [
              "1CO.13.12"
            ]
          }
        }
