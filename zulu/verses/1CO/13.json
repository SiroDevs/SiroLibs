          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho ngisengumntwana, ngakhuluma okomntwana, ngaqondisa okomntwana, ngazindla okomntwana;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.11",
            "verseOrgIds": [
              "1CO.13.11"
            ]
          }
        }
