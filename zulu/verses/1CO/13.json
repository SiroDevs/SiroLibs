          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje-ke kumi ukukholwa, nokwethemba, nothando, lokho kokuthathu; kodwa okukhulu kukho konke uthando.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.13",
            "verseOrgIds": [
