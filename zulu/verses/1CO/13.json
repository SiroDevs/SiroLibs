          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluziphathi okungafanele, aluzifuneli okwalo;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.5",
            "verseOrgIds": [
              "1CO.13.5"
            ]
          }
        }
      ]
    },
