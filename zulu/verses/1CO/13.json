          "type": "text",
          "attrs": {
            "verseId": "1CO.13.8",
            "verseOrgIds": [
              "1CO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba siyazi inxenye, siprofetha inxenye.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.9",
            "verseOrgIds": [
              "1CO.13.9"
            ]
          }
        }
