          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "lubekezelela izinto zonke, lukholwa yizinto zonke, luthemba izinto zonke, lukhuthazelela izinto zonke.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.7",
            "verseOrgIds": [
              "1CO.13.7"
            ]
