          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.11",
            "verseOrgIds": [
              "1CO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba nginamsebenzi muni ukuba ngahlulele nabangaphandle na? Anibahluleli yini abangaphakathi na?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.12",
            "verseOrgIds": [
              "1CO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.12",
            "verseOrgIds": [
              "1CO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uNkulunkulu uyabahlulela abangaphandle. Ngakho susani phakathi kwenu lowomuntu omubi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.13",
            "verseOrgIds": [
              "1CO.5.13"
            ]
          }
        }
      ]
