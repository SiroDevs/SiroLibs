            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.16",
            "verseOrgIds": [
              "1CO.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho ngithumele kini uThimothewu, oyindodana yami ethandekayo nethembekile eNkosini, oyakunikhumbuza izindlela zami ezikuKristu, njengokuba ngifundisa ezindaweni zonke emabandleni onke.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.17",
            "verseOrgIds": [
              "1CO.4.17"
            ]
          }
        }
      ]
    },
