          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uNkulunkulu ukhethile izinto zobuthutha zomhlaba ukuze ajabhise ezihlakaniphileyo; futhi uNkulunkulu ukhethile izinto ezibuthakathaka zezwe ukuze ajabhise izinto ezinamandla;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.27",
            "verseOrgIds": [
              "1CO.1.27"
            ]
          }
        }
