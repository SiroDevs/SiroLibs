          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba bhekani ukubizwa kwenu, bazalwane, ukuthi ababaningi abahlakaniphileyo ngokwenyama, ababaningi abanamandla, kababaningi abayizikhulu, ababiziweyo;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.26",
            "verseOrgIds": [
              "1CO.1.26"
            ]
          }
        }
