          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha ngisho lokhu ukuthi yilowo nalowo kini uthi: Mina ngingokaPawulu; mina ngingoka-Apholo; mina ngingokaKhefase; futhi mina ngikaKristu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.12",
            "verseOrgIds": [
              "1CO.1.12"
            ]
          }
        }
