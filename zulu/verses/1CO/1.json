          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kuye lina likuKristu Jesu, owenziwe kithi ukuhlakanipha okuvela kuNkulunkulu, lokulunga, lokungcweliswa, lokuhlengwa;",
          "type": "text",
          "attrs": {
