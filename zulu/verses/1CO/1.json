        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa thina sitshumayela uKristu obethelwe esiphambanweni, isikhubekiso kubaJuda, ubuthutha kumaGriki;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.23",
            "verseOrgIds": [
              "1CO.1.23"
            ]
          }
        }
      ]
