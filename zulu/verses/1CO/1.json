          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.23",
            "verseOrgIds": [
              "1CO.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha kwababiziweyo, amaJuda namaGreki, singuKristu ongamandla kaNkulunkulu nokuhlakanipha kukaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.24",
            "verseOrgIds": [
              "1CO.1.24"
            ]
          }
        }
      ]
