          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngibonga uNkulunkulu wami njalo ngani ngenxa yomusa kaNkulunkulu eniwuphiwe kuKristu Jesu;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.4",
            "verseOrgIds": [
              "1CO.1.4"
            ]
          }
        }
      ]
    },
