        {
          "text": "ukuthi ezintweni zonke nicetshisiwe kuye, ekukhulumeni konke, nasekwazini konke;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.5",
            "verseOrgIds": [
              "1CO.1.5"
            ]
