          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPawulu, obizelwe ngentando kaNkulunkulu ukuba abe ngumphostoli kaJesu Kristu, noSostene umzalwane,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.1",
            "verseOrgIds": [
              "1CO.1.1"
            ]
          }
        }
      ]
    },
    {
