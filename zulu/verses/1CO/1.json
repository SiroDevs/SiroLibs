          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke anisileli ngesipho; nilindele ukufika kweNkosi yethu uJesu Kristu;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.7",
            "verseOrgIds": [
              "1CO.1.7"
            ]
          }
        }
