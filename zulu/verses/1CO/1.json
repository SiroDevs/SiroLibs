          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UKristu uhlukene yini na? UPawulu wabethelwa esiphambanweni ngenxa yenu na? noma nabhapathizwa egameni likaPawulu na?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.13",
            "verseOrgIds": [
              "1CO.1.13"
            ]
          }
        }
      ]
    },
