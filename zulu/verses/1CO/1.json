            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba intshumayelo yesiphambano kwababhubhayo iwubuwula; kodwa kithina esisindiswayo kungamandla kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.18",
            "verseOrgIds": [
              "1CO.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
