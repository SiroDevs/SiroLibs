            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngibonga uNkulunkulu ngokuba ngingabhapathizanga muntu kini, kuphela oKrispu noGayu;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.14",
            "verseOrgIds": [
              "1CO.1.14"
            ]
          }
        }
      ]
