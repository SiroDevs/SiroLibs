          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu uthembekile, yena nabizelwa ekuhlanganyeleni neNdodana yakhe uJesu Kristu iNkosi yethu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.9",
            "verseOrgIds": [
              "1CO.1.9"
            ]
          }
        }
