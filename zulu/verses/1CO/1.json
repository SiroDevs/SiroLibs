              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuze kungabikho nyama ezibonga phambi kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.29",
            "verseOrgIds": [
              "1CO.1.29"
