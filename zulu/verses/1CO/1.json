        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.7",
            "verseOrgIds": [
              "1CO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
