      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
