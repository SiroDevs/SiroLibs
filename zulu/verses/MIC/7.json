        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.16",
            "verseOrgIds": [
              "MIC.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MIC 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayakukhotha uthuli njengenyoka, baphume emigodini yabo njengezimpethu emhlabeni; bayakumesaba uJehova uNkulunkulu wethu, bakwesabe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        }
      ]
