        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.13",
            "verseOrgIds": [
              "MIC.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalusa abantu bakho ngentonga yakho, umhlambi wefa lakho ohlala wodwa ehlathini phakathi kweKarmeli; mabadle eBashani nakwaGileyadi njengasezinsukwini zasendulo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
