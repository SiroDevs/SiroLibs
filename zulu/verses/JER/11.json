            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi elafika kuJeremiya livela kuJehova, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.1",
            "verseOrgIds": [
              "JER.11.1"
            ]
          }
        }
