          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi izwi likaJehova lafika kimi, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.1",
            "verseOrgIds": [
              "JER.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.1",
            "verseOrgIds": [
              "JER.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamba umemeze ezindlebeni zeJerusalema uthi: Usho kanje uJehova; Ngicabanga ngawe, umusa wobusha bakho, uthando lomshado wakho, lapho ungilandela ogwadule, ezweni elingatshalwanga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.2",
            "verseOrgIds": [
              "JER.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.2",
            "verseOrgIds": [
              "JER.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Israyeli wayengcwele kuJehova nolibo lwezithelo zakhe; bonke abasidlayo bayokhubeka; okubi kuyakubehlela, usho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.3",
            "verseOrgIds": [
              "JER.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.3",
            "verseOrgIds": [
              "JER.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yizwani izwi likaJehova nina ndlu kaJakobe, zizukulwane zonke zendlu ka-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.4",
            "verseOrgIds": [
              "JER.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.4",
            "verseOrgIds": [
              "JER.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova, uthi: “Buni ububi oyihlo ababufumana kimi, baze basuka kude nami, balandela okuyize, baba yize, na?",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.5",
            "verseOrgIds": [
              "JER.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.5",
            "verseOrgIds": [
              "JER.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi abashongo ukuthi: ‘Uphi uJehova owasikhuphula ezweni laseGibithe, wasihola ehlane, ezweni eliyihlane nelemigodi, ezweni elomileyo nelethunzi lokufa, ezweni elomileyo nelethunzi lokufa. Lapho kungazange kudlule muntu khona nalapho kungazange kuhlale muntu khona?",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.6",
            "verseOrgIds": [
              "JER.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.6",
            "verseOrgIds": [
              "JER.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nganingenisa ezweni elinala, ukuba nidle izithelo zalo nokuhle kwalo; kepha lapho ningena, nalingcolisa izwe lami, nenza ifa lami laba yisinengiso.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.7",
            "verseOrgIds": [
              "JER.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.7",
            "verseOrgIds": [
              "JER.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abapristi abashongo ukuthi: “Uphi uJehova na?” nabaphethe umthetho babengazi Mina;",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.8",
            "verseOrgIds": [
              "JER.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.8",
            "verseOrgIds": [
              "JER.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho ngisakhuluma kini, usho uJehova, ngilwe nabantwana babantwana benu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.9",
            "verseOrgIds": [
              "JER.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.9",
            "verseOrgIds": [
              "JER.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba dabulani eziqhingini zaseKitimi, nibone; nithumele eKedari, nilalelisise, nibone ukuthi ikhona yini into enjalo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.10",
            "verseOrgIds": [
              "JER.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.10",
            "verseOrgIds": [
              "JER.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isizwe sishintshile yini onkulunkulu baso, abangebona onkulunkulu na? kepha abantu bami banana udumo lwabo ngalokho okungasizi ngalutho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.11",
            "verseOrgIds": [
              "JER.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.11",
            "verseOrgIds": [
              "JER.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangalani, nina mazulu, ngalokho, nesabe kakhulu, nifutheke kakhulu,” usho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.12",
            "verseOrgIds": [
              "JER.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.12",
            "verseOrgIds": [
              "JER.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba abantu bami benzile okubi okubili; bangishiyile mina, mthombo wamanzi aphilayo, bazimbele imithombo, imithombo eqhekekileyo, engagcini manzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.13",
            "verseOrgIds": [
              "JER.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.13",
            "verseOrgIds": [
              "JER.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Israyeli uyinceku na? uyisigqila sokuzalwa ekhaya na? woniwe ngani?",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.14",
            "verseOrgIds": [
              "JER.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.14",
            "verseOrgIds": [
              "JER.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amabhongo ezingonyama abhonga, amemeza phezu kwakhe, enza izwe lakhe laba incithakalo; imizi yakhe yashiswa yangabi nabahlali.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.15",
            "verseOrgIds": [
              "JER.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.15",
            "verseOrgIds": [
              "JER.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana baseNofi naseThahapanesi nabo baphula ukhakhayi lwekhanda lakho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.16",
            "verseOrgIds": [
              "JER.2.16"
            ]
          }
        }
      ]
    },
