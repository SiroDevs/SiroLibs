            "number": "30",
            "style": "v",
            "sid": "JER 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngibashaye ngeze abantwana benu; abatholanga ukusolwa; inkemba yenu idlile abaprofethi benu njengengonyama ephangayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.30",
            "verseOrgIds": [
              "JER.2.30"
            ]
          }
        }
      ]
    },
    {
