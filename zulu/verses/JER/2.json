          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungani uzinqumela ekufuneni uthando? ngalokho wafundisa ababi izindlela zakho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.33",
            "verseOrgIds": [
              "JER.2.33"
            ]
          }
        }
