        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba noma ugeza ngodaka, uzithathele insipho eningi, nokho ububi bakho buphambi kwami, isho iNkosi uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.22",
            "verseOrgIds": [
              "JER.2.22"
            ]
          }
        }
      ]
