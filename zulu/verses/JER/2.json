          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje, unani endleleni yaseGibithe ukuba niphuze amanzi aseSihori na? unani endleleni yase-Asiriya ukuba niphuze amanzi omfula na?",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.18",
            "verseOrgIds": [
              "JER.2.18"
            ]
          }
        }
