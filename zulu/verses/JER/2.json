            "sid": "JER 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gcina izinyawo zakho zingagqoki, nomphimbo wakho ekomeni; kodwa wena wathi: Kakukho ithemba. Ngoba ngangibathanda abezizweni, ngabalandela.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.25",
            "verseOrgIds": [
              "JER.2.25"
            ]
          }
        }
      ]
    },
