          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esigqebheni sakho kwafunyanwa igazi lemiphefumulo yabampofu abangenacala;",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.34",
