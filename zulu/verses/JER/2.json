          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa mina ngikutshale umvini omuhle, wonke uyimbewu yeqiniso; pho, ungiphendule kanjani ngibe yisithombo esibolile somvini wezizweni na?",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.21",
            "verseOrgIds": [
