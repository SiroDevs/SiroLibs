            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baphi onkulunkulu bakho ozenzele bona na? mabasukume uma bengakusindisa ngesikhathi sokuhlupheka kwakho; ngoba njengomumo wemizi yakho banjalo onkulunkulu bakho, Juda!",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.28",
            "verseOrgIds": [
              "JER.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
