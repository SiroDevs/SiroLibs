          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungasho kanjani ukuthi: ‘Angingcoliswanga, angibalandelanga oBali? bheka indlela yakho esigodini, yazi okwenzileyo; wena uyinkana yenkazana enejubane, ehamba ngezindlela zayo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.23",
            "verseOrgIds": [
              "JER.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
