            "verseOrgIds": [
              "JER.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "imbongolo yasendle ejwayele ihlane, ehogela umoya ngokuthanda kwayo; ngethuba lakhe ngubani ongamxosha? bonke abamfunayo abayikukhathala; ngenyanga yalo bayakulifumana.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.24",
            "verseOrgIds": [
              "JER.2.24"
            ]
          }
        }
