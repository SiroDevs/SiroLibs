        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyakungimangalelani na? nonke niphambukile kimi,” usho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.29",
            "verseOrgIds": [
              "JER.2.29"
            ]
          }
        }
      ]
    },
