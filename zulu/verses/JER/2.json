            "verseOrgIds": [
              "JER.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "lithi esizweni: Wena ungubaba; nasetsheni: Nangikhipha, ngokuba bangifulathele, abangibhekanga ubuso babo; kodwa ngesikhathi sokuhlupheka kwabo bazakuthi: Sukuma usisindise.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.27",
            "verseOrgIds": [
              "JER.2.27"
            ]
          }
        }
      ]
    },
