          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ububi bakho buyakusola, nezizondo zakho ziyakusola; yazi, ubone ukuthi kuyinto embi nebabayo ukuthi umshiyile uJehova uNkulunkulu wakho nokuthi ukwesaba kwami akukho kuwe, isho iNkosi uJehova Sebawoti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.19",
            "verseOrgIds": [
              "JER.2.19"
            ]
          }
        }
      ]
    },
