              "JER.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengalokhu isela lijabha lapho lifunyanwa, kanjalo indlu yakwa-Israyeli inamahloni; bona, namakhosi abo, nezikhulu zabo, nabapristi babo, nabaprofethi babo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.26",
            "verseOrgIds": [
              "JER.2.26"
            ]
          }
        }
      ]
    },
