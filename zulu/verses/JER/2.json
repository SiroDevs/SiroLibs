              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.16",
            "verseOrgIds": [
              "JER.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awuzenzelanga lokho ngokushiya uJehova uNkulunkulu wakho lapho ekuhola endleleni na?",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.17",
            "verseOrgIds": [
              "JER.2.17"
            ]
          }
        }
      ]
    },
