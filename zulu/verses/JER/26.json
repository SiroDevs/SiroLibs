            "number": "19",
            "style": "v",
            "sid": "JER 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHezekiya inkosi yakwaJuda naye wonke uJuda bambulala na? Akamesabanga uJehova, wamncenga uJehova, uJehova wazisola ngobubi abebukhulume ngabo na? Kanjalo singenza ububi obukhulu emiphefumulweni yethu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
