            "sid": "JER 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamkhipha u-Uriya eGibithe, bamyisa enkosini uJehoyakimi; owambulala ngenkemba, wasiphonsa isidumbu sakhe emathuneni abantukazana.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.23",
            "verseOrgIds": [
              "JER.26.23"
            ]
          }
        }
