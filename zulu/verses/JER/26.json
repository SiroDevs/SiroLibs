        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona futhi umuntu owayeprofetha egameni likaJehova, u-Uriya, indodana kaShemaya, waseKiriyati Jeharimi, owaprofetha ngalo muzi nangaleli zwe njengawo wonke amazwi kaJeremiya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.20",
            "verseOrgIds": [
              "JER.26.20"
            ]
          }
        }
      ]
    },
    {
