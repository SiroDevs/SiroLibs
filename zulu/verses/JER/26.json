        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho inkosi uJehoyakimi nawo onke amaqhawe ayo nazo zonke izikhulu zezwa amazwi ayo, inkosi yazama ukumbulala; kepha u-Uriya esezwile wesaba, wabaleka, waya eGibithe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.21",
            "verseOrgIds": [
              "JER.26.21"
            ]
          }
        }
      ]
    },
