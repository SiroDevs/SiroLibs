              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa isandla sika-Ahikamu, indodana kaShafani, sasinoJeremiya, ukuze bangamnikeli esandleni sabantu ukuba bambulale.",
          "type": "text",
          "attrs": {
