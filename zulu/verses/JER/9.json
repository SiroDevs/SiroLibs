              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ukufa kukhuphuke emafasiteleni ethu futhi kwangena ezindlini zethu zobukhosi ukuze kunqume abantwana ngaphandle nezinsizwa ezitaladini.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
