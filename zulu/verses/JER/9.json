          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhekani, izinsuku ziyeza,” usho uJehova, “lapho ngiyakuhambela bonke abasokile nabangasokile;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.25",
            "verseOrgIds": [
              "JER.9.25"
            ]
