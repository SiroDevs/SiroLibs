            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha ozibongayo makazibonge ngakho, ukuze angiqonde, azi Mina, ukuthi nginguJehova owenza umusa, nokwahlulela, nokulunga emhlabeni; ngokuba lokhu ngiyathokoza,” usho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.24",
            "verseOrgIds": [
              "JER.9.24"
            ]
          }
        }
