              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabasheshe basikhalele, ukuze amehlo ethu ehle izinyembezi, nezinkophe zethu zigeleze amanzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.18",
