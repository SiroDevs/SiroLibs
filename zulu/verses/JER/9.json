          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova, uthi: “Ohlakaniphileyo makangazibongi ngokuhlakanipha kwakhe, nonamandla makangazigabisi ngamandla akhe, nocebileyo makangazibongi ngenotho yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.23"
            ]
          }
        }
