          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho yizwani izwi likaJehova nina besifazane, nilalele izwi lomlomo wakhe, nifundise amadodakazi enu isililo, kube yilowo nalowo komakhelwane bakhe ingoma yokulila.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.20",
            "verseOrgIds": [
