            "sid": "JER 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi elafika kuJeremiya ngabantu bonke bakwaJuda ngomnyaka wesine kaJehoyakimi indodana kaJosiya, inkosi yakwaJuda, okungumnyaka wokuqala kaNebukadinesari, inkosi yaseBabele;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.1",
            "verseOrgIds": [
              "JER.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
