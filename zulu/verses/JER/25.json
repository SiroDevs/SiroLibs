          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma benqaba ukuthatha indebe esandleni sakho ukuba bayiphuze, wothi kubo: Usho kanje uJehova Sebawoti; Uzophuza nakanjani.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.28",
            "verseOrgIds": [
              "JER.25.28"
            ]
          }
        }
