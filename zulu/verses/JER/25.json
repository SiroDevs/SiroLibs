            "sid": "JER 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khalani nina belusi, nikhale; nizibhuqe emlotheni, nkosi yomhlambi, ngokuba izinsuku zokuhlaba kwenu sezidlulile nokuhlakazwa; futhi uzowa njengento ethandekayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
      ]
