          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba bhekani, sengiqala ukwehlisela okubi phezu komuzi obizwa ngegama lami; Aniyikuyeka ukujeziswa, ngokuba ngiyakubiza inkemba phezu kwabo bonke abakhileyo emhlabeni,” usho uJehova Sebawoti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.29",
            "verseOrgIds": [
              "JER.25.29"
            ]
          }
        }
      ]
    },
