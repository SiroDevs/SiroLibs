          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umsindo uyafika emikhawulweni yomhlaba; ngokuba uJehova ubambene nezizwe, uyakulwa nayo yonke inyama; Uzanikela ababi enkembeni, kutsho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
