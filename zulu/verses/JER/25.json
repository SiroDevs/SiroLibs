          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanqotshiweyo nguJehova ngalolo suku bayakuba khona kusukela komunye umkhawulo womhlaba kuze kube komunye umkhawulo womhlaba; abayikulilelwa, babuthwe, bangcwatshwe; bazakuba ngumquba emhlabathini.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.33",
            "verseOrgIds": [
              "JER.25.33"
            ]
          }
        }
      ]
    },
