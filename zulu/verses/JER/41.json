    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenyanga yesikhombisa u-Ishmayeli indodana kaNethaniya ka-Elishama wozalo lwenkosi, nezikhulu zenkosi, namadoda ayishumi kanye naye, kwafika kuGedaliya indodana ka-Ahikamu eMispa; badla isinkwa ndawonye eMispa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke u-Ishmayeli indodana kaNethaniya namadoda ayishumi ayenaye basukuma bamshaya uGedaliya indodana ka-Ahikamu kaShafani ngenkemba, bambulala owayemise inkosi yaseBhabhiloni ukuba ibe umbusi phezu kwakhe izwe unayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Ishmayeli wabulala bonke abaJuda ababenaye, kanye noGedaliya eMispa, namaKaledi afunyanwa khona, namadoda empi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngosuku lwesibili ebulele uGedaliya, kwakungekho muntu owakwazi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwafika abanye bevela eShekemi, eShilo naseSamariya, abantu abangamashumi ayisishiyagalombili, bephucile, nezingubo zabo ziklebhukile, bezisikile, bephethe iminikelo nempepho ezandleni zabo, ukuba balethe endlini kaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Ishmayeli indodana kaNethaniya waphuma eMispa ukubahlangabeza, esakhala njalo; lapho ehlangana nabo, wathi kubo: “Wozani kuGedaliya indodana ka-Ahikamu.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho bengena phakathi nomuzi, u-Ishmayeli indodana kaNethaniya wababulala, wabaphonsa emgodini womgodi, yena namadoda ayenaye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha kwafunyanwa amadoda ayishumi phakathi kwalawo athi ku-Ishmayeli: “Ungasibulali, ngokuba sinengcebo endle: ukolweni, nebhali, namafutha, nezinyosi.” Futhi wayishiya futhi akababulalanga phakathi kwabafowabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umgodi u-Ishmayeli alahla kuwo zonke izidumbu zamadoda awabulalayo ngenxa kaGedaliya yilowo inkosi u-Asa eyawenza ngenxa yokwesaba uBahasha inkosi yakwa-Israyeli; u-Ishmayeli indodana kaNethaniya waligcwalisa ngababuleweyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Ishmayeli wayesethumba yonke insali yabantu ababeseMispa, amadodakazi enkosi, nabo bonke abantu ababesele eMispa, uNebusaradani induna yabalindi wababeka kuGedaliya indodana ka-Ahikamu; no-Ishmayeli indodana. KaNethaniya wabathumba, wahamba ukuwelela kubantwana bakwa-Amoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uJohanani indodana kaKhareya nazo zonke izinduna zempi ezazinaye bezwa ngakho konke okubi u-Ishmayeli indodana kaNethaniya abekwenzile,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bethatha bonke abantu, bahamba ukulwa no-Ishmayeli indodana kaNethaniya, bamfumana ngasemanzini amakhulu aseGibeyoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho wonke amadoda ayeno-Ishmayeli ebona uJohanani indodana kaKhareya nazo zonke izinduna zempi ezazinaye, ajabula.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke wonke amadoda ayethumbe u-Ishmayeli eMispa aphenduka abuyela kuJohanani indodana kaKhareya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa u-Ishmayeli indodana kaNethaniya waphunyuka namadoda ayisishiyagalombili kuJohanani, waya kubantwana bakwa-Amoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJohanani indodana kaKhareya wayesethatha nazo zonke izinduna zempi ezazinaye, yonke insali yabantu ayebophulile ku-Ishmayeli indodana kaNethaniya eMispa ngemva kokuzalwa kukaGedaliya indodana kaNethaniya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basuka bahlala endaweni yokuhlala kaKimhamu engaseBhetlehema ukuze bangene eGibhithe.",
