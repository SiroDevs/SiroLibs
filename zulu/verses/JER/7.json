          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba abantwana bakwaJuda benzile okubi emehlweni ami,” usho uJehova, “babekile izinengiso zabo endlini ebizwa ngegama lami ukuba bayingcolise.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        }
      ]
    },
