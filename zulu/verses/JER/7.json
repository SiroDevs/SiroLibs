          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayangicunula na? usho uJehova; abahlazisi ebusweni babo na?",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.19",
            "verseOrgIds": [
