          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uyakuwakhuluma onke lawa mazwi kubo; kodwa kabayikukuzwa; futhi kumelwe ubabize; kodwa kabayikukuphendula.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.27",
