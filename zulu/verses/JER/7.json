          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakha izindawo eziphakemeyo zaseThofeti elisesigodini sendodana kaHinomu ukuze bashise amadodana abo namadodakazi abo ngomlilo; engingabayalanga ngakho, nokungangenanga enhliziyweni yami.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.31",
            "verseOrgIds": [
              "JER.7.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
