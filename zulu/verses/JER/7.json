            "verseOrgIds": [
              "JER.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke, bheka, izinsuku ziyeza, usho uJehova, lapho zingasayikuthiwa iThofeti, nesigodi sendodana kaHinomu, kepha isiGodi sokuBulala; ngoba bayakungcwatshwa eThofeti kuze kungabi khona indawo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        }
      ]
    },
