          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izidumbu zalaba bantu ziyakuba ngukudla kwezinyoni zezulu nokwezilwane zomhlaba; futhi akekho oyobadabula.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.33",
            "verseOrgIds": [
