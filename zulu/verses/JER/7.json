            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona ngiyokwenza ukuba kuphele izwi lenjabulo nezwi lenjabulo, izwi lomyeni nezwi likamakoti emizini yakwaJuda nasezitaladini zaseJerusalema, ngoba izwe liyoba ihlane.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.34",
