          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana batheza izinkuni, oyise babasa umlilo, abesifazane baxova inhlama ukwenzela indlovukazi yezulu amaqebelengwane, bathululele abanye onkulunkulu iminikelo yokuphuzwa, ukuze bangicunule.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.18",
