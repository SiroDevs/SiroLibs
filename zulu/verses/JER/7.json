          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho isho kanje iNkosi uJehova, ithi: Bheka, intukuthelo yami nokufutheka kwami kuyakuthululelwa kule ndawo, phezu kwabantu, naphezu kwezilwane, naphezu kwemithi yasendle, naphezu kwezithelo zomhlaba; futhi uyovutha futhi ungacimi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        }
