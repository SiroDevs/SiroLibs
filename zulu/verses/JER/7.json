          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nquma izinwele zakho, Jerusalema, uzilahle, uphakamise isililo phezulu; ngokuba uJehova usalile, wasilahla isizukulwane solaka lwayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        }
      ]
    },
    {
