          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kabangilalelanga, kababekanga indlebe yabo, kodwa benza lukhuni intamo yabo; benze okubi kunoyise.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.26",
