    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi elafika kuJehova kuJeremiya emihleni kaJehoyakimi indodana kaJosiya, inkosi yakwaJuda, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.1",
            "verseOrgIds": [
              "JER.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.1",
            "verseOrgIds": [
              "JER.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamba uye endlini yamaRekabi, ukhulume nawo, uwangenise endlini kaJehova kwelinye lamakamelo, uwaphuzise iwayini.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.2",
            "verseOrgIds": [
              "JER.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.2",
            "verseOrgIds": [
              "JER.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngase ngithatha uJahashaniya indodana kaJeremiya, indodana kaHabhasiniya, nabafowabo, nawo onke amadodana akhe, nayo yonke indlu yamaRekabi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.3",
            "verseOrgIds": [
              "JER.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.3",
            "verseOrgIds": [
              "JER.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngabangenisa endlini kaJehova ekamelweni lamadodana kaHanani indodana ka-Igidaliya, umuntu kaNkulunkulu, owayesendlini yezikhulu eyayiphezu kwekamelo likaMahaseya indodana ka-Igidaliya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.4",
            "verseOrgIds": [
              "JER.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.4",
            "verseOrgIds": [
              "JER.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngase ngibeka phambi kwamadodana endlu yamaRekabi izimbiza ezigcwele iwayini nezitsha, ngathi kubo: “Phuzani iwayini.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.5",
            "verseOrgIds": [
              "JER.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.5",
            "verseOrgIds": [
              "JER.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha bathi: “Asiyikuphuza iwayini, ngokuba uJonadaba indodana kaRekabi ubaba wethu wasiyala, wathi: “Aniyikuphuza iwayini kuze kube phakade, nina namadodana enu.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.6",
            "verseOrgIds": [
              "JER.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.6",
            "verseOrgIds": [
              "JER.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi aniyikwakha indlu, ningahlwanyeli imbewu, ningatshala isivini, ningabi nalutho; kodwa zonke izinsuku zakho uyakuhlala ematendeni; ukuze nihlale izinsuku eziningi ezweni eningabafokazi kulo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.7",
            "verseOrgIds": [
              "JER.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.7",
            "verseOrgIds": [
              "JER.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salilalela-ke izwi likaJonadaba, indodana kaRekabi, ubaba, kukho konke asiyala ngakho ukuba singaphuzi wayini zonke izinsuku zethu, thina, omkethu, namadodana ethu, namadodakazi ethu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.8",
            "verseOrgIds": [
              "JER.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.8",
            "verseOrgIds": [
              "JER.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "futhi lingasakheli izindlu zokuhlala; futhi asinaso isivini noma insimu noma imbewu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.9",
            "verseOrgIds": [
              "JER.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.9",
            "verseOrgIds": [
              "JER.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa sasihlala ematendeni, salalela, senza njengakho konke uJonadaba ubaba asiyala ngakho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.10",
            "verseOrgIds": [
              "JER.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.10",
            "verseOrgIds": [
              "JER.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha lapho uNebukadinesari, inkosi yaseBabele, engena ezweni, sathi: “Wozani siye eJerusalema ngenxa yempi yamaKaledi nangenxa yempi yama-Aramu; hlala eJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi likaJehova lafika kuJeremiya, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.12",
            "verseOrgIds": [
              "JER.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.12",
            "verseOrgIds": [
              "JER.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova Sebawoti, uNkulunkulu ka-Israyeli, uthi: “Hamba, usho kubantu bakwaJuda nabakhileyo eJerusalema, uthi: ‘Anikwamukeli ukulaywa ukuba nilalele amazwi ami na? kusho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.13",
            "verseOrgIds": [
              "JER.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.13",
            "verseOrgIds": [
              "JER.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agcwaliseka amazwi kaJonadaba indodana kaRekabi, awayala ngawo amadodana akhe ukuba angaphuzi iwayini; ngoba kuze kube lamuhla kabaphuzi lutho, kodwa balalela umlayo kayise. Kodwa aningilalelanga Mina.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.14",
            "verseOrgIds": [
              "JER.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.14",
            "verseOrgIds": [
              "JER.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngithumile kini zonke izinceku zami, abaprofethi, abavuka ekuseni kakhulu, babathume, bathi: Phendukani, kube yilowo nalowo endleleni yakhe embi, nilungise izenzo zenu, ningalandeli abanye onkulunkulu ukuba ningakwenzi. Khonzani, nihlale ezweni engalinika nina nawoyihlo, kepha anibekanga indlebe yenu, aningilalelanga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.15",
            "verseOrgIds": [
              "JER.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.15",
            "verseOrgIds": [
              "JER.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba amadodana kaJonadaba indodana kaRekabi agcina umyalo kayise ayewayale ngawo; kodwa lababantu kabangilalelanga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.16",
            "verseOrgIds": [
              "JER.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.16",
            "verseOrgIds": [
              "JER.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho usho kanje uJehova uNkulunkulu Sebawoti, uNkulunkulu ka-Israyeli, uthi: Bhekani, ngiyakwehlisela phezu kukaJuda naphezu kwabo bonke abakhileyo eJerusalema konke okubi engikushilo ngabo, ngokuba ngikhulumile kubo, kepha bona akezwanga; ngababiza, kepha abaphendulanga.",
          "type": "text",
