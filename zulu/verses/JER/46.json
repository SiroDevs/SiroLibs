          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "IGibhithe linjengethokazi elihle kakhulu, kodwa ukubhujiswa kuyeza; livela enyakatho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.20",
