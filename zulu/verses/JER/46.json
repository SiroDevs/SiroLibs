          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi lakhe liyohamba njengenyoka; ngoba bayokhuphuka nebutho futhi balifikele ngezimbazo njengabagawuli bezinkuni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.22",
