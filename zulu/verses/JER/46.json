            "number": "26",
            "style": "v",
            "sid": "JER 46:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngiyobanikela esandleni salabo abafuna ukuphila kwabo, nasesandleni sikaNebukadinesari, inkosi yaseBhabhiloni, nasesandleni sezinceku zakhe; ngasemuva liyakuhlalwa njengasezinsukwini zasendulo,” usho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.26",
            "verseOrgIds": [
              "JER.46.26"
            ]
          }
        }
      ]
    },
    {
