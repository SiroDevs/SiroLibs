            "verseOrgIds": [
              "JER.46.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 46:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungesabi, nceku yami Jakobe, usho uJehova, ngokuba nginawe; ngokuba ngiyakuqeda zonke izizwe engikuxoshele kuzo; kepha angiyikuniqeda, kepha ngiyakunikhuza ngokulinganisa; kodwa kangiyikukuyekela ungajeziswanga ngokupheleleyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.28",
