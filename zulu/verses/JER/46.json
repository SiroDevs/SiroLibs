          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ndodakazi ohlala eGibhithe, zilungiselele ukuya ekuthunjweni, ngoba iNofi lizakuba yihlane eliyincithakalo, lingabi lamuntu ohlala khona.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.19",
            "verseOrgIds": [
