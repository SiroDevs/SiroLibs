            "sid": "JER 46:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indodakazi yaseGibhithe iyakuba namahloni; liyakunikelwa esandleni sabantu basenyakatho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.24",
            "verseOrgIds": [
              "JER.46.24"
            ]
          }
        }
