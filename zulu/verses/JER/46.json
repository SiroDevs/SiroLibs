          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuphila kwami, isho iNkosi egama layo linguJehova Sebawoti: Impela njengeThabori phakathi kwezintaba nanjengeKarmeli ngaselwandle, kanjalo uyofika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.18",
            "verseOrgIds": [
              "JER.46.18"
            ]
          }
        }
