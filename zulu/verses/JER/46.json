            "sid": "JER 46:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha ungesabi, nceku yami Jakobe, futhi ungapheli amandla, Israyeli, ngokuba bheka, ngiyakuhlenga ezweni elikude, nenzalo yakho ezweni lokuthunjwa kwayo; uJakobe uyakubuya, abe nokuthula, aphumule, akakho omesabisayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.27",
            "verseOrgIds": [
              "JER.46.27"
            ]
          }
        }
      ]
