          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova Sebawoti, uNkulunkulu ka-Israyeli; Bheka, ngiyakuhambela isixuku saseNo, noFaro, neGibithe, nonkulunkulu balo, namakhosi abo; ngisho uFaro nabo bonke abathembela kuye;",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.25",
            "verseOrgIds": [
              "JER.46.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 46:25"
          },
          "items": [
