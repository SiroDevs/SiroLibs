          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayogawula ihlathi lakhe, usho uJehova, nakuba lingenakuphenywa; ngoba baningi kunesikhonyane futhi abanakubalwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.23",
            "verseOrgIds": [
              "JER.46.23"
            ]
          }
        }
