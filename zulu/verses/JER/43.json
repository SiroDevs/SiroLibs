        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.4",
            "verseOrgIds": [
              "JER.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uJohanani indodana kaKhareya nazo zonke izinduna zempi bathatha yonke insali yakwaJuda eyayibuyile ezizweni zonke eyayixoshelwe kuzo ukuba ihlale ezweni lakwaJuda;",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.5",
            "verseOrgIds": [
              "JER.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
