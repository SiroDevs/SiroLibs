        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.12",
            "verseOrgIds": [
              "JER.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyakwaphula izithombe zaseBeti Shemeshi esezweni laseGibithe; nezindlu zonkulunkulu baseGibithe uyakuzishisa ngomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.13",
            "verseOrgIds": [
              "JER.43.13"
            ]
          }
