        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.5",
            "verseOrgIds": [
              "JER.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "amadoda, nabesifazane, nabantwana, namadodakazi enkosi, nabo bonke abantu uNebuzaradani induna yabalindi, noGedaliya, indodana ka-Ahikamu, indodana kaShafani, noJeremiya umprofethi, noBaruki, indodana kaNeriya, abashiya ngemuva.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.6",
            "verseOrgIds": [
              "JER.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
