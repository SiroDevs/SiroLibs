          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakumemezela izahlulelo zami kubo ngokuphathelene nabo bonke ububi babo, abangidelile, bashisela abanye onkulunkulu umusi, bakhuleka emisebenzini yezandla zabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.16",
            "verseOrgIds": [
              "JER.1.16"
            ]
          }
        }
