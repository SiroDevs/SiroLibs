          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yasisithi kimi: Kusukela enyakatho, ububi buzavela phezu kwabo bonke abakhileyo elizweni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.14",
            "verseOrgIds": [
              "JER.1.14"
            ]
          }
        }
      ]
    },
