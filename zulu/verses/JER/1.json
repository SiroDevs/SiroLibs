          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena-ke bopha izinkalo zakho, usukume, ukhulume kubo konke engikuyala ngakho; ungethuki ebusweni babo, funa ngikwenze ube namahloni phambi kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.17",
            "verseOrgIds": [
              "JER.1.17"
            ]
          }
        }
      ]
