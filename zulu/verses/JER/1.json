          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi likaJehova lafika kimi ngokwesibili, lathi: “Ubonani na? Ngasengisithi: Ngibona imbiza; ubuso bakhe bubheke enyakatho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        }
