          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuzi wonke uyawubalekela umsindo wabamahhashi nabacibishelayo; bayakungena emahlathini, bagibele emadwaleni; yonke imizi iyakushiywa, kungahlali muntu kuyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.29",
            "verseOrgIds": [
              "JER.4.29"
            ]
          }
        }
