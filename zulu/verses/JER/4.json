          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenxa yalokhu umhlaba uyakukhala, nezulu phezulu liyoba mnyama, ngokuba ngikukhulumile, ngikuhlosile, angiyikuzisola, futhi angiyikubuya kukho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.28",
            "verseOrgIds": [
              "JER.4.28"
            ]
          }
        }
      ]
    },
