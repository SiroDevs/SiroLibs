          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngabona, bheka, indawo ethelayo yayiyihlane, nayo yonke imizi yayo yayibhidliziwe phambi kobuso bukaJehova nangenxa yolaka lwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.26",
