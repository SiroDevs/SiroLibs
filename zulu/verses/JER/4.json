          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngabona umhlaba, bheka, wawungenalutho, ungenalutho; namazulu, futhi kwakungekho ukukhanya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.23",
