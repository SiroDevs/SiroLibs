          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koze kube nini ngibona ibhanela futhi ngizwa ukukhala kwecilongo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.21",
            "verseOrgIds": [
