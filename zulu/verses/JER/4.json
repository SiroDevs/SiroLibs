          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumenyezelwa incithakalo phezu kokubhujiswa; ngokuba izwe lonke selichithekile; kungazelelwe amatende ami abhidlika nezilenge zami ngokuphazima kweso.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.20",
