          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba usho kanje uJehova, uthi: “Lonke izwe liyakuba yihlane; nokho angiyikuqeda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.27",
            "verseOrgIds": [
              "JER.4.27"
            ]
          }
        }
