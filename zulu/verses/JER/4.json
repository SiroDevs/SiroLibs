          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlela yakho nezenzo zakho kukulethele lezi zinto; kungububi bakho, ngoba kumunyu, ngoba kufinyelela enhliziyweni yakho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.18",
