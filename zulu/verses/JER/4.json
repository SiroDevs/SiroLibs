          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amathumbu ami, amathumbu ami! Ngibuhlungu enhliziyweni yami; inhliziyo yami ixokozela phakathi kwami; Angikwazi ukuthula, ngokuba uzwile, mphefumulo wami, ukukhala kwecilongo, ukukhala kwempi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.19",
            "verseOrgIds": [
              "JER.4.19"
            ]
          }
        }
      ]
