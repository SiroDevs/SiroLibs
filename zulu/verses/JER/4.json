          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njalo uba uphangiwe, uzakwenzani? Noma ugqoka okubomvu, noma uvunula ngezivunulo zegolide, noma uklebhula ubuso bakho ngopende, uyakuhlobisa ngeze; izithandwa zakho ziyakudelela, zifune ukuphila kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.30",
            "verseOrgIds": [
              "JER.4.30"
            ]
          }
        }
