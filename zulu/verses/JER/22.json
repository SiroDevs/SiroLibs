          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuphila kwami, usho uJehova, noma uKhoniya, indodana kaJehoyakimi, inkosi yakwaJuda, ebeyindandatho yophawu esandleni sami sokunene, bengiyakukukhipha khona;",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.24",
            "verseOrgIds": [
              "JER.22.24"
            ]
          }
        }
