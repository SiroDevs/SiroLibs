              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngiyokuxosha wena nonyoko owakuzalayo niyise kwelinye izwe lapho ningazalelwanga khona; futhi lapho uyofela khona.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.26",
            "verseOrgIds": [
