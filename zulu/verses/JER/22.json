              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ezweni abafuna ukubuyela kulo, ngeke babuyele khona.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.27",
            "verseOrgIds": [
