          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngiyokunikela esandleni sabafuna ukuphila kwakho, nasesandleni salabo osaba ubuso babo, nasesandleni sikaNebukadinesari, inkosi yaseBhabhiloni, nasesandleni samaKaledi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.25",
            "verseOrgIds": [
              "JER.22.25"
            ]
          }
        }
