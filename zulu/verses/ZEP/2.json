              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.10",
            "verseOrgIds": [
              "ZEP.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEP 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova uyakwesabeka kubo, ngokuba uyakwenza ukuba bonke onkulunkulu bomhlaba balambe; futhi abantu bayokhuleka kuyo, kube yilowo nalowo endaweni yakhe, zonke iziqhingi zezizwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.11",
            "verseOrgIds": [
              "ZEP.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
