              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hlanganani, yebo, buthanani, O sizwe esingafunwa;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.1",
            "verseOrgIds": [
