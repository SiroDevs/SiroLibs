          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.14",
            "verseOrgIds": [
              "ZEP.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEP 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lona ngumuzi othokozayo owawuzihlalele, owawuthi enhliziyweni yawo: Yimi yimi, akakho omunye ngaphandle kwami; seliphenduke incithakalo, indawo yokulala izilwane; wonke umuntu odlula ngakuyo uyakushaya ikhwelo, azulise isandla sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.15",
            "verseOrgIds": [
              "ZEP.2.15"
            ]
          }
        }
      ]
