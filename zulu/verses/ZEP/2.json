          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.6",
            "verseOrgIds": [
              "ZEP.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkhawulo uyakuba ngowensali yendlu yakwaJuda; bayoklaba kuyo; ezindlini zase-Ashikeloni kusihlwa bayakulala; ngokuba uJehova uNkulunkulu wabo uyakubahambela, abuyise ukuthunjwa kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
