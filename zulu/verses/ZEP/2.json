            "sid": "ZEP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "lungakafiki umyalo, usuku lungakadluli njengamakhoba, lungakafiki phezu kwenu ulaka lukaJehova, lungakafiki phezu kwenu usuku lolaka lukaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
