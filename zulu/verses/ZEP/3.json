    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEP 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.1",
            "verseOrgIds": [
              "ZEP.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalilalelanga ilizwi; akakwamukelanga ukuqondiswa; akazange athembele kuJehova; akasondelanga kuNkulunkulu wakhe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izikhulu zawo phakathi kwawo zingamabhubesi abhodlayo; abahluleli bawo bayizimpisi zasebusuku; abadli amathambo kuze kuse.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.3",
            "verseOrgIds": [
              "ZEP.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.3",
            "verseOrgIds": [
              "ZEP.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEP 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaprofethi bawo bangabantu abalula nabangathembekanga;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.4",
            "verseOrgIds": [
              "ZEP.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEP 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.4",
            "verseOrgIds": [
              "ZEP.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEP 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova olungileyo uphakathi kwawo; akenzi okubi; njalo ekuseni uyaveza ilungelo lakhe, akaqedi; kepha ongalungile akawazi amahloni.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEP 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizibhubhisile izizwe; imibhoshongo yabo iyincithakalo; Ngenzile izitaladi zazo zibe yincithakalo, ukuze kungadluli muntu;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngathi: Ngiqinisile, lizangesaba, lizakwamukela ukulaywa; ukuze indawo yabo yokuhlala ingaqedwa, nokho ngibajezisile; kepha bavuka ekuseni, baziphanga zonke izenzo zabo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho ngilindeleni, usho uJehova, kuze kufike usuku engiyakuvuka ngalo ukuphanga; ngoba injongo yami iwukuqoqa izizwe, ukuze ngibuthe imibuso, ukuze ngithulule ulaka lwami phezu kwazo, yebo, lonke ulaka lwami oluvuthayo. Ngoba umhlaba wonke uzaqedwa ngomlilo womhawu wami.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEP 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngalesosikhathi ngizanika abantu ulimi oluhlanzekileyo, ukuze bonke babize ibizo le Nkosi, bamkhonze nganhliziyonye.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.9",
            "verseOrgIds": [
              "ZEP.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEP 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.9",
            "verseOrgIds": [
              "ZEP.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEP 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphesheya kwemifula yaseKushe, abangincengayo, indodakazi yabahlakazekileyo bami, bayakunikela ngomhlatshelo wami.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.10",
            "verseOrgIds": [
              "ZEP.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEP 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.10",
            "verseOrgIds": [
              "ZEP.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEP 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolo suku aniyikuba namahloni ngazo zonke izenzo zenu eneqe ngazo kimi; ngokuba lapho ngiyakubasusa kini abathokoza ngokuzidla kwenu, ningabe nisazidla ngenxa yentaba yami engcwele.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.11",
            "verseOrgIds": [
              "ZEP.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEP 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.11",
            "verseOrgIds": [
              "ZEP.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEP 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakushiya phakathi kwakho abantu abadabukileyo nabampofu, abayakwethemba igama likaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.12",
            "verseOrgIds": [
              "ZEP.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEP 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.12",
            "verseOrgIds": [
              "ZEP.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEP 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Insali yakwa-Israyeli ayiyikwenza okubi, ingakhulumi amanga; futhi akukho ulimi olukhohlisayo oluyotholakala emlonyeni wabo, ngoba bayoklaba futhi balale, futhi akekho oyobethusa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.13",
            "verseOrgIds": [
              "ZEP.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEP 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.13",
            "verseOrgIds": [
              "ZEP.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEP 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hlabelela, ndodakazi yaseZiyoni! jabula, Israyeli! jabula, uthokoze ngenhliziyo yakho yonke, ndodakazi yaseJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.14",
            "verseOrgIds": [
              "ZEP.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEP 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.14",
            "verseOrgIds": [
              "ZEP.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEP 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova usezisusile izahlulelo zakho, usixoshile isitha sakho; inkosi yakwa-Israyeli, uJehova, iphakathi kwakho; anisayikubona ububi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.15",
            "verseOrgIds": [
              "ZEP.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEP 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.15",
            "verseOrgIds": [
              "ZEP.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEP 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolo suku kuyothiwa kulo iJerusalema: “Ungesabi, nakulo iSiyoni: Mazingadangali izandla zakho.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.16",
            "verseOrgIds": [
              "ZEP.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEP 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.16",
            "verseOrgIds": [
              "ZEP.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEP 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova uNkulunkulu wakho uphakathi kwakho; uyakusindisa, ajabule ngawe ngentokozo; uyophumula othandweni lwakhe, ajabule ngawe ngengoma.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.17",
            "verseOrgIds": [
              "ZEP.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEP 3:17"
          },
          "items": [
