            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maye kulo muzi ongcolile nongcolile, umuzi ocindezelayo!",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.1",
            "verseOrgIds": [
              "ZEP.3.1"
            ]
          }
        }
