    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi likaJehova elafika kuZefaniya, indodana kaKushi, indodana kaGedaliya, indodana ka-Amariya, indodana kaHezekiya, ezinsukwini zikaJosiya, indodana ka-Amoni, inkosi yakwaJuda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.1",
            "verseOrgIds": [
              "ZEP.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.1",
            "verseOrgIds": [
              "ZEP.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakuqalekisa konke okuphuma ezweni,” usho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.2",
            "verseOrgIds": [
              "ZEP.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.2",
            "verseOrgIds": [
              "ZEP.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakuqeda abantu nezilwane; ngiyakuqeda izinyoni zezulu, nezinhlanzi zolwandle, nezikhubekiso zababi; futhi ngiyonquma umuntu ezweni,” kusho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEP 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakwelulela isandla sami phezu kukaJuda naphezu kwabo bonke abakhileyo eJerusalema; ngiyakunquma insali kaBali kule ndawo, negama lamaKemarim kanye nabapristi;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.4",
            "verseOrgIds": [
              "ZEP.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEP 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.4",
            "verseOrgIds": [
              "ZEP.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEP 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lalabo abakhonza ibandla lezulu phezu kwezindlu; nabakhuleka kuye, bafunge uJehova, nabafunga ngoMalikamu;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEP 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabahlubukayo kuJehova; nalabo abangazange bamfune uJehova futhi abangabuzanga kuye.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.6",
            "verseOrgIds": [
              "ZEP.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.6",
            "verseOrgIds": [
              "ZEP.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thula phambi kweNkosi uJehova, ngokuba usuku lukaJehova luseduze; ngokuba uJehova ulungisile umhlatshelo, unikele abamenyiweyo bakhe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njalo ngosuku lomhlatshelo weNkosi, ngizahambela iziphathamandla, labantwana benkosi, labo bonke abembethe izembatho zezizwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEP 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolo suku ngiyophinde ngijezise bonke abeqa embundwini, abagcwalisa izindlu zamakhosi abo ngobudlova nangenkohliso.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
              "ZEP.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEP 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
              "ZEP.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEP 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolo suku, usho uJehova, kuyakuba khona umsindo wokukhala eSangweni Lezinhlanzi, nokukhala kwelesibili, nomsindo omkhulu ovela ezintabeni.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.10",
            "verseOrgIds": [
              "ZEP.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEP 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.10",
            "verseOrgIds": [
              "ZEP.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khalani nina enakhileyo eMakhethe, ngokuba bonke abathengisi banqunyiwe; bonke abagqoka isiliva bayakubhujiswa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.11",
            "verseOrgIds": [
              "ZEP.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.11",
            "verseOrgIds": [
              "ZEP.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEP 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngaleso sikhathi ngiyakuphenya iJerusalema ngamakhandlela, ngihambele abantu abahlezi emibhedeni yabo, abathi enhliziyweni yabo: ‘UJehova akenzi okuhle nokubi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.12",
            "verseOrgIds": [
              "ZEP.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEP 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.12",
            "verseOrgIds": [
              "ZEP.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEP 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho impahla yabo iyakuba yimpango, nezindlu zabo zibe yihlane; bayakwakha izindlu, kepha bangahlali kuzo; bayakutshala izivini, kepha bangaphuzi iwayini lazo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.13",
            "verseOrgIds": [
              "ZEP.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEP 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.13",
            "verseOrgIds": [
              "ZEP.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usuku olukhulu lukaJehova luseduze, luseduze futhi lushesha kakhulu, izwi losuku lukaJehova; iqhawe liyokhala ngokumunyu lapho.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.14",
            "verseOrgIds": [
              "ZEP.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.14",
            "verseOrgIds": [
              "ZEP.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEP 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lolo suku lungusuku lolaka, usuku losizi nolosizi, usuku lwencithakalo nolwencithakalo, usuku lobumnyama nesigayegaye, usuku lwamafu nolobumnyama obukhulu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.15",
            "verseOrgIds": [
              "ZEP.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEP 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.15",
            "verseOrgIds": [
              "ZEP.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEP 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usuku lwecilongo nolokuhlaba umkhosi ngemizi ebiyelweyo nasemibhoshongweni ephakemeyo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.16",
            "verseOrgIds": [
              "ZEP.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEP 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.16",
            "verseOrgIds": [
              "ZEP.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakwehlisela abantu usizi ukuba bahambe njengezimpumputhe, ngokuba bonile kuJehova; igazi labo liyakuchithwa njengothuli, nenyama yabo njengomquba.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.17",
            "verseOrgIds": [
              "ZEP.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEP 1:17"
          },
          "items": [
            {
