            "sid": "1SA 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasesithi: Lingenzi njalo, bazalwane bami, ngalokho i Nkosi esinike yona, eyasilondolozayo, yanikela esandleni sethu ixuku elasihlasela.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.23",
            "verseOrgIds": [
              "1SA.30.23"
            ]
          }
        }
      ]
    },
