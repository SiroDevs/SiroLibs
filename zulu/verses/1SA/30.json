          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.20",
            "verseOrgIds": [
              "1SA.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasefika ebantwini abangamakhulu amabili ababediniwe njalo bengelakulandela uDavida, abahlalisa emfuleni iBesori; baphuma ukumhlangabeza uDavide nokuhlangabeza amadoda aye naye. Lapho uDavide esondela kubantu, wababingelela.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.21",
            "verseOrgIds": [
              "1SA.30.21"
            ]
          }
        }
      ]
    },
    {
