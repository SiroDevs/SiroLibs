          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi kusukela ngalolo suku kuya phambili wakwenza kwaba yisimiso nesimiso kwa-Israyeli kuze kube namuhla.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.25",
