            "sid": "1SA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bephendula bonke abantu ababi namadoda amabi ahamba noDavide, bathi: “Ngokuba bengahambanga nathi, asiyikubanika empangweni esiyikhulule, kube yilowo nalowo umkakhe nomkakhe abantwana, ukuze babahole bahambe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.22",
            "verseOrgIds": [
              "1SA.30.22"
            ]
          }
        }
      ]
    },
    {
