          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wakhulula konke ama-Amaleki ayekuthathile, uDavide wasindisa nabafazi bakhe ababili.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.18",
            "verseOrgIds": [
              "1SA.30.18"
            ]
          }
        }
