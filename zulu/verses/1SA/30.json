          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uDavida labantu bakhe befika eZikilagi ngosuku lwesithathu, ama-Amaleki ahlasela eningizimu leZikilagi, anqoba iZikilagi, ayitshisa ngomlilo;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.1",
            "verseOrgIds": [
              "1SA.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.1",
            "verseOrgIds": [
              "1SA.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathumba abesifazane ababekulo beyiziboshwa;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.2",
            "verseOrgIds": [
              "1SA.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.2",
            "verseOrgIds": [
              "1SA.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide nabantu bakhe bangena emzini, bheka, wawushisiwe ngomlilo; omkabo namadodana abo namadodakazi abo bathunjwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.3",
            "verseOrgIds": [
              "1SA.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.3",
            "verseOrgIds": [
              "1SA.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide namadoda ayenaye baphakamisa amazwi abo, bakhala, baze bangabe besaba namandla okukhala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.4",
            "verseOrgIds": [
              "1SA.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.4",
            "verseOrgIds": [
              "1SA.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabafazi bakaDavide ababili bathunjwa, u-Ahinohama waseJizreyeli no-Abigayili umkaNabali waseKarmeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.5",
            "verseOrgIds": [
              "1SA.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.5",
            "verseOrgIds": [
              "1SA.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wacindezeleka kakhulu; ngoba abantu babekhuluma ukumkhanda ngamatshe, ngoba imiphefumulo yabantu bonke yayinomunyu, kwaba yilowo nalowo ngenxa yamadodana akhe namadodakazi akhe; kepha uDavide waziqinisa ngoJehova uNkulunkulu wakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.6",
            "verseOrgIds": [
              "1SA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.6",
            "verseOrgIds": [
              "1SA.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wayesethi ku-Abiyathara, umpristi, indodana ka-Ahimeleki, ngilethe lapha ingubo yamahlombe. U-Abiyathara wayeselethela uDavide khona ingubo yamahlombe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.7",
            "verseOrgIds": [
              "1SA.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.7",
            "verseOrgIds": [
              "1SA.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wabuza kuJehova, wathi: “Ngixoshe leliviyo na? ngiyakubafica, wathi kuye: “Xosha, ngokuba uyakuwafica nokuwafica, ubuyise konke ngaphandle kokulibala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.8",
            "verseOrgIds": [
              "1SA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.8",
            "verseOrgIds": [
              "1SA.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wahamba, yena namadoda angamakhulu ayisithupha ayenaye, bafika emfudlaneni iBesori, lapho abasala khona.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.9",
            "verseOrgIds": [
              "1SA.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.9",
            "verseOrgIds": [
              "1SA.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uDavide waxosha, yena namadoda angamakhulu amane, ngokuba abangamakhulu amabili basala ngemuva, bekhathele bengenakuwela umfudlana iBesori.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.10",
            "verseOrgIds": [
              "1SA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.10",
            "verseOrgIds": [
              "1SA.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafumana owaseGibithe endle, bamyisa kuDavide, bamnika isinkwa, wadla; bamphuzisa amanzi;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.11",
            "verseOrgIds": [
              "1SA.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.11",
            "verseOrgIds": [
              "1SA.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebemnika ucezu lweqebelengwane lomkhiwane nezigaxa ezimbili zezithelo zomvini ezomileyo; esedlile umoya wakhe wabuyela kuye, ngokuba wayengadlanga sinkwa, engaphuzanga manzi izinsuku ezintathu nobusuku obuthathu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.12",
            "verseOrgIds": [
              "1SA.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.12",
            "verseOrgIds": [
              "1SA.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasesithi kuye: Ungokabani? kanti ungowaphi? Wathi: “NgingowaseGibithe, inceku yomAmaleki; inkosi yami ingishiyile, ngokuba ezinsukwini ezintathu ezedlule ngigula.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.13",
            "verseOrgIds": [
              "1SA.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.13",
            "verseOrgIds": [
              "1SA.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sahlasela eningizimu yamaKrethe, nasogwini lwakwaJuda, naseningizimu yakwaKalebi; sayishisa iSikilagi ngomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.14",
            "verseOrgIds": [
              "1SA.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.14",
            "verseOrgIds": [
              "1SA.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasesithi kuye: Ungangehlisela kulesixuku? Wathi: “Funga kimi ngoNkulunkulu ukuthi awuyikungibulala, unganginikele esandleni senkosi yami, ngikwehlisele kulesi sixuku;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho emehlisa, bheka, babehlakazekile emhlabeni wonke, bedla, bephuza, besina ngenxa yayo yonke impango enkulu ababeyithathile ezweni lamaFilisti nasezweni lakwaJuda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.16",
            "verseOrgIds": [
              "1SA.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.16",
            "verseOrgIds": [
              "1SA.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wababulala kusukela kusihlwa kwaze kwaba kusihlwa ngangomuso, akwaphunyuka muntu kubo, kuphela izinsizwa ezingamakhulu amane ezazigibele amakamela, zabaleka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.17",
            "verseOrgIds": [
              "1SA.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
