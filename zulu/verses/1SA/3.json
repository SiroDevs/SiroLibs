          "attrs": {
            "verseId": "1SA.3.13",
            "verseOrgIds": [
              "1SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
