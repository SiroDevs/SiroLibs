          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho ngafunga kuyo indlu ka-Eli ukuthi ububi bendlu ka-Eli abuyikuhlanjululwa kuze kube phakade ngomhlatshelo nangomnikelo wokudla.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.14",
            "verseOrgIds": [
              "1SA.3.14"
            ]
          }
        }
      ]
    },
    {
