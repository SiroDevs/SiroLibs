            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indodana uSamuweli yamkhonza uJehova phambi kuka-Eli. Izwi likaJehova laliyigugu ngalezo zinsuku; kwakungekho mbono ovulekile.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngaleso sikhathi u-Eli elele endaweni yakhe, namehlo akhe eqala ukuqundeka ukuba angaboni;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.2",
            "verseOrgIds": [
              "1SA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.2",
            "verseOrgIds": [
              "1SA.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isibani sikaNkulunkulu singakacimi ethempelini likaJehova, lapho kwakukhona khona umphongolo kaNkulunkulu, uSamuweli walala ubuthongo;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "uJehova wambiza uSamuweli, wathi: “Ngilapha.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.4",
            "verseOrgIds": [
              "1SA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 3:4"
          },
          "items": [
            {
