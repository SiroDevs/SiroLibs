            "sid": "1SA 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "USamuweli wathi kuSawule: “UJehova ungithumile ukuba ngikugcobe ube yinkosi phezu kwabantu bakhe u-Israyeli; manje lalela izwi lamazwi kaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.1",
            "verseOrgIds": [
              "1SA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.1",
            "verseOrgIds": [
              "1SA.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova Sebawoti, uthi: “Ngikhumbula lokho u-Amaleki akwenza ku-Israyeli, ukuthi wamlinda endleleni ekukhuphukeni kwakhe eGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.2",
            "verseOrgIds": [
              "1SA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.2",
            "verseOrgIds": [
              "1SA.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje hamba ushaye u-Amaleki, uchithe konke anakho, ungawayekeli; kodwa nihlabe iduna nensikazi, nezinsana, nezinsana, nezinkabi, nezimvu, namakamela, nezimbongolo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.3",
            "verseOrgIds": [
              "1SA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.3",
            "verseOrgIds": [
              "1SA.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "USawule wabiza abantu, wababala eThelayimi, izinkulungwane ezingamakhulu amabili zemigundatshani nezinkulungwane eziyishumi zakwaJuda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.4",
            "verseOrgIds": [
              "1SA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.4",
            "verseOrgIds": [
              "1SA.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "USawule wafika emzini ka-Amaleki, walala phansi esigodini.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.5",
            "verseOrgIds": [
              "1SA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.5",
            "verseOrgIds": [
              "1SA.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "USawuli wasesithi kumaKheni: Hambani lisuke, lehlele phakathi kwamaAmaleki, ukuze ngingalibhubhi kanye lawo; ngoba wabonisa umusa kubo bonke abantwana bakwa-Israyeli ekukhuphukeni kwabo bephuma eGibhithe. Ngakho amaKheni asuka phakathi kwama-Amaleki.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.6",
            "verseOrgIds": [
              "1SA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.6",
            "verseOrgIds": [
              "1SA.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "USawule wawachitha ama-Amaleki kusukela eHavila kuze kufike eShuri elingaphambi kwaseGibhithe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.7",
            "verseOrgIds": [
              "1SA.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.7",
            "verseOrgIds": [
              "1SA.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabamba u-Agagi inkosi yama-Amaleki ephila, wababulala bonke abantu ngosiko lwenkemba ngesiqalekiso.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.8",
            "verseOrgIds": [
              "1SA.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.8",
            "verseOrgIds": [
              "1SA.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uSawule nabantu bamyeka u-Agagi, nehle kunakho konke kwezimvu, nezinkomo, nokukhuluphalisiwe, namawundlu, nakho konke okuhle, abathandanga ukuwashaya ngesiqalekiso, kepha konke okubi nokubi nokubi. Ukugeza imfucuza, ababhubhisa ngokuphelele.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.9",
            "verseOrgIds": [
              "1SA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.9",
            "verseOrgIds": [
              "1SA.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi likaJehova lafika kuSamuweli, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.10",
            "verseOrgIds": [
              "1SA.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.10",
            "verseOrgIds": [
              "1SA.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyazisola ngokuthi ngibeke uSawule njengenkosi, ngokuba wachezuka kimi, akagcinanga imiyalo yami. Lokhu kwamphatha kabi uSamuweli; wakhuleka kuJehova ubusuku bonke.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.11",
            "verseOrgIds": [
              "1SA.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.11",
            "verseOrgIds": [
              "1SA.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "USamuweli wavuka ekuseni ukuhlangabeza uSawule ekuseni, watshelwa uSamuweli ukuthi: “USawule wafika eKarmeli, bheka, wamlungisela indawo;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.12",
            "verseOrgIds": [
              "1SA.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.12",
            "verseOrgIds": [
              "1SA.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho uSamuweli efika kuSawule, uSawule wathi kuye: “Mawubusiswe wena nguJehova! Ngenza umyalo kaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.13",
            "verseOrgIds": [
              "1SA.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.13",
            "verseOrgIds": [
              "1SA.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethi uSamuweli: “Kuyini lokhu kukhala kwezimvu ezindlebeni zami nokuhleka kwezinkomo engikuzwayo na?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.14",
            "verseOrgIds": [
              "1SA.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.14",
            "verseOrgIds": [
              "1SA.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "USawule wayesethi: “Bazikhipha kuma-Amaleki, ngokuba abantu basindise izimvu ezinhle kakhulu nezinkomo ukuze bahlabele uJehova uNkulunkulu wakho; futhi okusele sikushaya ngesiqalekiso sokuxoshwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.15",
            "verseOrgIds": [
              "1SA.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.15",
            "verseOrgIds": [
              "1SA.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "USamuweli wasesithi kuSawuli: Hlala, mina-ke ngizakutshela lokho i Nkosi ekutsho kimi ngalobubusuku. Wathi kuye: “Khuluma nje.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.16",
            "verseOrgIds": [
              "1SA.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.16",
            "verseOrgIds": [
              "1SA.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethi uSamuweli: “Umncane emehlweni akho, awubekwanga waba yinhloko yezizwe zakwa-Israyeli, uJehova wakugcoba ukuba ube yinkosi kwa-Israyeli na?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.17",
            "verseOrgIds": [
              "1SA.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
