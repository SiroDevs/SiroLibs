          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye waya eRama, wafika emthonjeni omkhulu oseSegu; wabuza wathi: “Baphi oSamuweli noDavide na?” Omunye wathi: “Bheka, bakanye noNajoti eRama.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.22",
            "verseOrgIds": [
              "1SA.19.22"
            ]
