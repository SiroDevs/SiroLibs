          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wayesebaleka, waphunyuka, wafika kuSamuweli eRama, wamtshela konke uSawule abekwenzile kuye. Yena noSamuweli bahamba, bahlala eNajoti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.18",
