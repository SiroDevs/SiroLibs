          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waya khona eNajoti eRama, loMoya kaNkulunkulu laye waba phezu kwakhe, waprofetha waze wafika eNajothi eRama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.23",
