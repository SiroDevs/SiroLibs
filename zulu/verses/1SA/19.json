            "sid": "1SA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwabikwa kuSawule, kwathiwa: “Bheka, uDavide useNajoti eRama.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.19",
            "verseOrgIds": [
              "1SA.19.19"
            ]
