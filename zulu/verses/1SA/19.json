          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "USawule wathuma izithunywa ukumlanda uDavide; lapho bebona uquqaba lwabaprofethi beprofetha noSamuweli emi phezu kwabo, uMoya kaNkulunkulu waba phezu kwezithunywa zikaSawule, nazo zaprofetha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.20",
            "verseOrgIds": [
              "1SA.19.20"
            ]
