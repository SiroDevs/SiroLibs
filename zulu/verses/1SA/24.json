              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubonisile namuhla ukuthi wenze okuhle kimi, ngokuba awungibulalanga lapho uJehova enginikela esandleni sakho.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.18",
