            "verseOrgIds": [
              "1SA.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinceku zikaSawule zakhuluma lawa mazwi ezindlebeni zikaDavide. UDavide wathi: “Kuyinto elula kuwe ukuba ngumkhwenyana wenkosi, lokhu mina ngithiwe ngimpofu nomncane na?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.23",
            "verseOrgIds": [
              "1SA.18.23"
            ]
          }
        }
      ]
    },
