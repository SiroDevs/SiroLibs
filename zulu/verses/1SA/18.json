          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngesikhathi uMerabi indodakazi kaSawuli ephiwa uDavida, wanikwa u-Adriyeli umMeholathi abe ngumkakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.19",
