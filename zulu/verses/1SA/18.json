          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "USawule wabona, wazi ukuthi uJehova wayenoDavide nokuthi uMikhali indodakazi kaSawule wayemthanda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        }
      ]
    },
    {
