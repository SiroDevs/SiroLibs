        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.24",
            "verseOrgIds": [
              "1SA.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "USawule wathi: “Niyakusho kanje kuDavide, nithi: ‘Inkosi ayifuni ilobolo, kepha amajwabu ayikhulu amaFilisti ukuba aphindisele ezitheni zenkosi. Kodwa uSawule wacabanga ukumyeka uDavide awe ngesandla samaFilisti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.25",
            "verseOrgIds": [
              "1SA.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
