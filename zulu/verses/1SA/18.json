          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasesithi kuSawuli: Ngingubani mina? futhi iyini impilo yami noma inzalo kababa kwa-Israyeli ukuba ngibe ngumkhwenyana wenkosi?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.18",
