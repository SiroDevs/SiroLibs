          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinceku zakhe zamtshela uDavide lawo mazwi, kwaba kuhle kuDavide ukuba abe ngumkhwenyana wenkosi, kepha izinsuku zazingakapheli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.26",
            "verseOrgIds": [
              "1SA.18.26"
            ]
          }
        }
      ]
    },
