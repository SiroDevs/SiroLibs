          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wazilungiselela, wahamba yena nabantu bakhe, wabulala kumaFilisti amadoda angamakhulu amabili; uDavida waletha amajwabu awo, basebenika inkosi indaba zonke, ukuze abe ngumkhwenyana wenkosi. USawule wamnika uMikhali indodakazi yakhe ibe ngumkakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.27",
            "verseOrgIds": [
              "1SA.18.27"
            ]
          }
        }
      ]
    },
