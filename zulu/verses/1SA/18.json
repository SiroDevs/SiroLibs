          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "USawule wamesaba kakhulu uDavide; uSawule waba yisitha sikaDavide kulo lonke.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
            ]
          }
        }
