              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umalokazana wakhe, umkaFinehasi, wayekhulelwe, esezakubeletha; lapho ezwa umbiko wokuthi umphongolo kaNkulunkulu uthathiwe nokuthi uyisezala nomyeni wakhe bafile, wakhothama wabeletha; ngoba ubuhlungu bakhe behlela phezu kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.19",
            "verseOrgIds": [
              "1SA.4.19"
            ]
          }
        }
