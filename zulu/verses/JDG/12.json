        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.3",
            "verseOrgIds": [
              "JDG.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJefta wayesebutha onke amadoda akwaGileyadi, walwa no-Efrayimi; amadoda akwaGileyadi amchitha u-Efrayimi, ngokuba athi: “Nina maGileyadi ningababaleki bakwa-Efrayimi phakathi kwabakwa-Efrayimi nabakwaManase.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.4",
            "verseOrgIds": [
              "JDG.12.4"
            ]
          }
        }
      ]
    },
    {
