            "sid": "JDG 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.4",
            "verseOrgIds": [
              "JDG.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakwaGileyadi badla iJordani phambi kwabakwa-Efrayimi; amadoda akwaGileyadi athi kuye: “UngumEfrayimi na? Uma ethi: Cha!",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.5",
            "verseOrgIds": [
              "JDG.12.5"
            ]
          }
        }
      ]
    },
    {
