          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayenamadodana angamashumi amathathu namadodakazi angamashumi amathathu; Futhi wahola u-Israyeli iminyaka eyisikhombisa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.9",
