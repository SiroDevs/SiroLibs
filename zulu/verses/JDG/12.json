              "JDG.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJefta wahola u-Israyeli iminyaka eyisithupha. UJefta wakwaGileyadi wafa, wembelwa komunye wemizi yakwaGileyadi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.7",
            "verseOrgIds": [
              "JDG.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
