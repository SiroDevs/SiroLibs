          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwakhe u-Eloni wakwaZebuloni waqondisa u-Israyeli; wabusa u-Israyeli iminyaka eyishumi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.11",
