            "sid": "JDG 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwakhe u-Ibisani waseBetlehema waqondisa u-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.8",
            "verseOrgIds": [
              "JDG.12.8"
            ]
          }
        }
