        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.5",
            "verseOrgIds": [
              "JDG.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bethi kuye: “Yisho ukuthi Siboleti,” yena wathi Siboleti, ngokuba wayengenakukwazi ukulibiza kahle. Base bemthatha, bambulala ngasekuweleni kweJordani, kwawa ngaleso sikhathi kwabakwa-Efrayimi abayizinkulungwane ezingamashumi amane nambili.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.6",
            "verseOrgIds": [
              "JDG.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
