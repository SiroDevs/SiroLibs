          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Eloni wakwaZebuloni wafa, wembelwa e-Ajaloni ezweni lakwaZebuloni.",
          "type": "text",
          "attrs": {
