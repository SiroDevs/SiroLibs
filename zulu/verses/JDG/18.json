          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.30",
            "verseOrgIds": [
              "JDG.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazimisela isithombe esibaziweyo sikaMika abesenze ngaso sonke isikhathi indlu kaNkulunkulu iseShilo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.31",
            "verseOrgIds": [
              "JDG.18.31"
            ]
          }
        }
