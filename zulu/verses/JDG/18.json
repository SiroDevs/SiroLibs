          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakwaDani bazimisela isithombe esibaziweyo; uJonathani, indodana kaGereshomu, indodana kaManase, yena namadodana akhe baba ngabapristi besizwe sakwaDani kwaze kwafika usuku lokuthunjwa kwezwe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.30",
            "verseOrgIds": [
              "JDG.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
