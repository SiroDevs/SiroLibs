          "type": "text",
          "attrs": {
            "verseId": "JDG.19.29",
            "verseOrgIds": [
              "JDG.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi bonke abakubonayo bathi: “Okunje akukenziwa, akubonwanga kusukela osukwini abantwana bakwa-Israyeli abakhuphuka ngalo ezweni laseGibithe kuze kube namuhla; naka, thola izeluleko futhi ukhulume okucabangayo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.30",
            "verseOrgIds": [
              "JDG.19.30"
            ]
          }
        }
