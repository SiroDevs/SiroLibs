          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kuye: “Siyasuka eBetlehema Juda siya eceleni kwentaba yakwa-Efrayimi; Ngasuka lapho, ngaya eBetlehema Juda, kepha manje ngiya endlini kaJehova; futhi kakho ongamukela endlini.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.18",
            "verseOrgIds": [
              "JDG.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
