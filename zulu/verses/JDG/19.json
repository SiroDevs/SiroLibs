            "number": "19",
            "style": "v",
            "sid": "JDG 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.19",
            "verseOrgIds": [
              "JDG.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ixhegu lase lisithi: Ukuthula makube kuwe! zonke izinkanuko zenu mazibe phezu kwami; ungahlali nje emgwaqeni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.20",
            "verseOrgIds": [
              "JDG.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.20",
            "verseOrgIds": [
              "JDG.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamngenisa endlini yakhe, wazinika izimbongolo ukudla, bageza izinyawo zabo, badla, baphuza.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.21",
            "verseOrgIds": [
              "JDG.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.21",
            "verseOrgIds": [
              "JDG.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi besajabula izinhliziyo zabo, bheka, amadoda omuzi, amadodana kaBheliyali, ahaqa indlu, ashaya umnyango, akhuluma kumninindlu, ixhegu, ethi: “Letha ukukhulula.” indoda engene endlini yakho, ukuze simazi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.22",
            "verseOrgIds": [
              "JDG.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
