            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.18",
            "verseOrgIds": [
              "JDG.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokho kukhona utshani kanye nefolishi lezimbongolo zethu; kukhona futhi isinkwa newayini mina nencekukazi yakho nensizwa ekanye nezinceku zakho; ayintuli lutho.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.19",
            "verseOrgIds": [
              "JDG.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
