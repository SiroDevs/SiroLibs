          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayishisa indlu kaNkulunkulu, badiliza ugange lwaseJerusalema, bashisa zonke izigodlo zalo ngomlilo, bachitha zonke izitsha zalo ezinhle.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
