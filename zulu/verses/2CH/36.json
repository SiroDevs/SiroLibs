          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuba kugcwaliseke izwi likaJehova ngomlomo kaJeremiya, izwe laneliswe ngamasabatha alo;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
