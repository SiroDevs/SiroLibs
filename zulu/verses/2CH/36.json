              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaphunyukileyo enkembeni yabathumba, yabayisa eBabele; lapho babeyizinceku zakhe nezamadodana akhe kwaze kwaba sembusweni wombuso wasePheresiya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.20",
            "verseOrgIds": [
              "2CH.36.20"
            ]
          }
        }
