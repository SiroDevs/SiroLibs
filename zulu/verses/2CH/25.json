          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha u-Amasiya akalalelanga; ngokuba kwavela kuNkulunkulu ukubanikela esandleni sezitha zabo, ngokuba babefuna onkulunkulu bakwa-Edomi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.20",
