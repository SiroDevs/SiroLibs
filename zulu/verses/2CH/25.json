          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona uJowashi inkosi yakwa-Israyeli wenyuka; babonana ubuso nobuso, yena no-Amasiya, inkosi yakwaJuda, eBeti Shemeshi lakwaJuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.21",
