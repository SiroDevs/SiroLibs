          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye izindaba zika-Amasiya, ezokuqala nezokugcina, bheka, azilotshiwe yini encwadini yamakhosi akwaJuda nakwa-Israyeli na?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
