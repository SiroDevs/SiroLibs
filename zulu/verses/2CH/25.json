          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi emva kwesikhathi u-Amasiya asuka ngaso kuJehova bamakhela uzungu eJerusalema; wabalekela eLagishi, kepha bathumela eLagishi, bambulala khona.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
