          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yakwa-Israyeli yasibiza enye yezinceku zayo, yathi: “Sheshisa ulethe uMika indodana ka-Imla.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.8",
            "verseOrgIds": [
              "2CH.18.8"
            ]
          }
        }
      ]
