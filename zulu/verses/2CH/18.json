          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yasisithi kuye: Ngizakuyala kangaki ukuthi ungangitsheli lutho ngaphandle kweqiniso ebizweni leNkosi?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.15",
