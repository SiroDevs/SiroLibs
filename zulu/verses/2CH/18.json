        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.23",
            "verseOrgIds": [
              "2CH.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMika wathi: “Bheka, uyakukubona mhla ungena ekamelweni ukuba ucashe.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.24",
            "verseOrgIds": [
              "2CH.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.24",
            "verseOrgIds": [
              "2CH.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yakwa-Israyeli yathi: “Mthathe uMika, umbuyisele ku-Amoni, umbusi womuzi, nakuJowashi, indodana yenkosi;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.25",
            "verseOrgIds": [
              "2CH.18.25"
            ]
          }
        }
      ]
    },
    {
