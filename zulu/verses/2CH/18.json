          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "USedekiya, indodana kaKhenana, wazenzela izimpondo zensimbi, wathi: “Usho kanje uJehova, uthi: ‘Ngalezi niyakuxosha ama-Aramu aze aphele.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.10",
            "verseOrgIds": [
