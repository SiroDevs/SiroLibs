              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi futhi: “Ngalokho yizwani izwi likaJehova; Ngabona iNkosi ihlezi esihlalweni sayo sobukhosi, lebutho lonke lezulu limi ngakwesokunene sayo langakwesokhohlo sayo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.18",
            "verseOrgIds": [
