          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yakwa-Israyeli noJehoshafati inkosi yakwaJuda babeka omunye wabo esihlalweni sakhe sobukhosi, bembethe izingubo zabo, bahlala endaweni eyize ekungeneni kwesango laseSamariya; bonke abaprofethi baprofetha phambi kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.9",
            "verseOrgIds": [
              "2CH.18.9"
            ]
          }
        }
