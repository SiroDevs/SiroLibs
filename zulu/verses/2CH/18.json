          "attrs": {
            "verseId": "2CH.18.5",
            "verseOrgIds": [
              "2CH.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uJehoshafati wathi: “Akukho mprofethi weNkosi lapha ukuba sibuze kuye na?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.6",
            "verseOrgIds": [
              "2CH.18.6"
            ]
          }
        }
      ]
    },
