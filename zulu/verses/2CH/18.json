          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isithunywa esasiyembiza uMika sakhuluma kuye, sathi: “Bheka, amazwi abaprofethi mahle enkosini nganhliziyonye; khona izwi lakho malibe njengenye yazo, ukhulume kahle.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.12",
            "verseOrgIds": [
              "2CH.18.12"
            ]
          }
        }
