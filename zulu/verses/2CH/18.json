        {
          "text": "Inkosi yakoIsrayeli yasisithi kuJehoshafathi: Kangikutshelanga yini ukuthi kayikuprofetha okuhle ngami, kodwa okubi?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.17",
            "verseOrgIds": [
