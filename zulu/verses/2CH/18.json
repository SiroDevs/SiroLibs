          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abaprofethi baprofetha kanje, bathi: “Khuphukela eRamoti kwaGileyadi, libe nempumelelo, ngokuba uJehova uyakulinikela esandleni senkosi.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.11",
            "verseOrgIds": [
              "2CH.18.11"
            ]
          }
        }
