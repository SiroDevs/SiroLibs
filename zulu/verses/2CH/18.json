              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.19",
            "verseOrgIds": [
              "2CH.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaphuma umoya, wema phambi kukaJehova, wathi: “Mina ngiyakumlinga.” UJehova wathi kuye: “Ngani na?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.20",
            "verseOrgIds": [
              "2CH.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.20",
            "verseOrgIds": [
              "2CH.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: “Ngiyakuphuma, ngibe ngumoya wamanga emlonyeni wabo bonke abaprofethi bakhe.” UJehova wathi: “Mlingeni, niyakumnqoba nani; phuma wenze njalo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.21",
            "verseOrgIds": [
              "2CH.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.21",
            "verseOrgIds": [
              "2CH.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje-ke, bheka, uJehova ubeke umoya wamanga emlonyeni walaba baprofethi bakho, futhi uJehova ukhulume ngokufutheka ngokumelene nawe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UZedekhiya indodana kaKhenana wasesondela, wamtshaya uMikha esihlathini, wathi: UMoya weNkosi usuke kimi ngayiphi indlela ukuyakhuluma kuwe?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.23",
            "verseOrgIds": [
              "2CH.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
