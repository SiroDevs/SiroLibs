          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethi uMika: “Kuphila kukaJehova, lokho uNkulunkulu wami akukhulumayo ngiyakukhuluma.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.13",
            "verseOrgIds": [
              "2CH.18.13"
            ]
          }
        }
