        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yakwa-Israyeli yathi kuJehoshafati: “Kusekhona indoda eyodwa esingabuza ngayo kuJehova; kodwa ngiyamzonda; ngokuba akaprofethanga okuhle kimi, kepha okubi njalo; lo nguMika indodana ka-Imla. UJehoshafati wathi: “Mayingasho njalo inkosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.7",
            "verseOrgIds": [
              "2CH.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
