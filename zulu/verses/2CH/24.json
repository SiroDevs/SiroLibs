            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.17",
            "verseOrgIds": [
              "2CH.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayishiya indlu kaJehova uNkulunkulu wawoyise, bakhonza imithi engcwele nonkulunkulu; uJuda neJerusalema behlelwa yintukuthelo ngenxa yesiphambeko sabo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.18",
            "verseOrgIds": [
              "2CH.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.18",
            "verseOrgIds": [
              "2CH.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha wathuma abaprofethi kubo ukuba bababuyisele kuJehova; futhi bafakaza ngokumelene nabo, kodwa abalalelanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMoya kaNkulunkulu wehlela phezu kukaZakariya indodana kaJehoyada umpristi, wema phezu kwabantu, wathi kubo: “Usho kanje uJehova, uthi: ‘Neqelani imiyalo kaJehova ukuba ningabi nampumelelo na? ngoba nimshiyile uJehova, naye unishiyile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamakhela uzungu, bamkhanda ngamatshe ngesiyalezo senkosi egcekeni lendlu kaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho inkosi uJowashi ayizange icabange ngomusa uyise uJehoyada ayemenzele yona, kodwa yabulala indodana yayo. Ekufeni kwakhe wathi: “UJehova makakubone, akubuze.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ekupheleni komnyaka impi yama-Aramu yakhuphukela kuye, yafika kwaJuda naseJerusalema, yachitha zonke izikhulu zabantu phakathi kwabantu, yathumela yonke impango yazo enkosini yaseDamaseku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.23",
            "verseOrgIds": [
              "2CH.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.23",
            "verseOrgIds": [
              "2CH.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba impi yama-Aramu yafika nesixuku esincane samadoda; uJehova wanikela esandleni salo impi enkulu kakhulu, ngokuba babemshiyile uJehova uNkulunkulu wawoyise. Ngakho bamahlulela uJowashi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esemukile kuye (ngokuba amshiya enesifo esikhulu), izinceku zakhe zamakhela ugobe ngenxa yegazi lamadodana kaJehoyada umpristi, zambulala embhedeni wakhe, wafa; bammbela. Emzini kaDavide, kepha abammbelanga emathuneni amakhosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.25",
            "verseOrgIds": [
              "2CH.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.25",
            "verseOrgIds": [
              "2CH.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba yibo abamenzela ugobe; uZabadi, indodana kaShimeyati, wakwa-Amoni, noJozabadi, indodana kaZimriti, umMowabi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.26",
            "verseOrgIds": [
              "2CH.24.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.26",
            "verseOrgIds": [
              "2CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuqondene namadodana akhe, nemithwalo emikhulu eyathweswa yena, nokwakhiwa kwendlu kaNkulunkulu weqiniso, bheka, kulotshiwe eNcwadini Yezindaba Zezindaba Zamakhosi. U-Amasiya indodana yakhe waba yinkosi esikhundleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.27",
            "verseOrgIds": [
              "2CH.24.27"
            ]
          }
        }
      ]
    }
