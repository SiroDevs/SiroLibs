  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "2CH 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosiya wenzela uJehova iphasika eJerusalema, balihlaba iphasika ngosuku lweshumi nane lwenyanga yokuqala.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.1",
            "verseOrgIds": [
              "2CH.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.1",
            "verseOrgIds": [
              "2CH.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamisa abapristi emsebenzini wabo, wabakhuthaza enkonzweni yendlu kaJehova;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.2",
            "verseOrgIds": [
              "2CH.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.2",
            "verseOrgIds": [
              "2CH.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kumaLevi afundisa wonke u-Israyeli, ayengcwele kuJehova: “Bekani umphongolo ongcwele endlini uSolomoni indodana kaDavide, inkosi yakwa-Israyeli, ayakhayo; ngeke kube umthwalo emahlombe enu; manje khonzani uJehova uNkulunkulu wenu nabantu bakhe u-Israyeli,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.3",
            "verseOrgIds": [
              "2CH.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.3",
            "verseOrgIds": [
              "2CH.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zilungiseleni ngokwezindlu zawoyihlo, ngokwezigaba zenu, ngokombhalo kaDavide, inkosi yakwa-Israyeli, nanjengombhalo wendodana yakhe uSolomoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.4",
            "verseOrgIds": [
              "2CH.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.4",
            "verseOrgIds": [
              "2CH.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nime endaweni engcwele ngokwezigaba zemindeni yawoyise babafowenu, abantu, ngokwezigaba zoyise wamaLevi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.5",
            "verseOrgIds": [
              "2CH.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.5",
            "verseOrgIds": [
              "2CH.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bese nihlaba iphasika, nizingcwelise, nilungise abafowenu ukuba benze njengezwi likaJehova ngomsebenzi kaMose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosiya wabanika abantu bonke ababekhona, izimvu, amawundlu, nezimbuzi, kube okwemihlatshelo yephasika, kubo bonke ababekhona, inani lezinkulungwane ezingamashumi amathathu nantathu; lalingelenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.7",
            "verseOrgIds": [
              "2CH.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.7",
            "verseOrgIds": [
              "2CH.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izikhulu zakhe zanika abantu, abapristi namaLevi ngokuzithandela: oHilikiya, noZakariya, noJehiyeli, izinduna zendlu kaNkulunkulu, banika abapristi izimvu eziyizinkulungwane ezimbili namakhulu ayisithupha namakhulu amathathu zibe yimihlatshelo yephasika izinkabi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.8",
            "verseOrgIds": [
              "2CH.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.8",
            "verseOrgIds": [
              "2CH.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "OKhonaniya, noShemaya, noNethaneli, abafowabo, noHashabiya, noJehiyeli, noJozabadi, izinduna zamaLevi, banika amaLevi izimvu eziyizinkulungwane eziyisihlanu nezinkomo ezingamakhulu ayisihlanu, zibe yiminikelo yephasika.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.9",
            "verseOrgIds": [
              "2CH.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.9",
            "verseOrgIds": [
              "2CH.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkonzo yalungiswa, abapristi bema ezindaweni zabo, namaLevi ngezigaba zabo ngokomyalo wenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.10",
            "verseOrgIds": [
              "2CH.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.10",
            "verseOrgIds": [
              "2CH.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balihlaba iphasika, abapristi bafafaza igazi ababesesandleni sabo, amaLevi abagcoba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.11",
            "verseOrgIds": [
              "2CH.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.11",
            "verseOrgIds": [
              "2CH.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayisusa iminikelo yokushiswa ukuba bayinike ngokwezigaba zezizukulwane zabantu ukuba bahlabele uJehova njengokulotshiweyo encwadini kaMose. Benza kanjalo nezinkabi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.12",
            "verseOrgIds": [
              "2CH.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.12",
            "verseOrgIds": [
              "2CH.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawosa iphasika emlilweni njengomthetho, kepha ezinye izipho ezingcwele bazigcoba ezimbizeni, nangamapani, nasemapanini, babelabela bonke abantu masinyane.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.13",
            "verseOrgIds": [
              "2CH.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.13",
            "verseOrgIds": [
              "2CH.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasemuva bazilungisela bona nabapristi, ngokuba abapristi, amadodana ka-Aroni, babenikela ngeminikelo yokushiswa namanoni kwaze kwahlwa; ngalokho amaLevi azilungisela wona nabapristi, amadodana ka-Aroni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.14",
            "verseOrgIds": [
              "2CH.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.14",
            "verseOrgIds": [
              "2CH.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahlabeleli, amadodana ka-Asafa, babesesikhundleni sabo ngokomyalo kaDavide, no-Asafa, noHemani, noJeduthuni, umboni wenkosi; nabalindisango balinda emasangweni onke; akufanele baphambuke emsebenzini wabo; kubafowabo amaLevi abalungisela bona.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.15",
            "verseOrgIds": [
              "2CH.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.15",
            "verseOrgIds": [
              "2CH.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke yonke inkonzo kaJehova yalungiselelwa ngalolo suku ukwenza iphasika nokunikela ngeminikelo yokushiswa e-altare likaJehova njengomyalo wenkosi uJosiya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.16",
            "verseOrgIds": [
              "2CH.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.16",
            "verseOrgIds": [
              "2CH.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakwa-Israyeli ababekhona ngaleso sikhathi bagcina iphasika nomkhosi wesinkwa esingenamvubelo izinsuku eziyisikhombisa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.17",
            "verseOrgIds": [
              "2CH.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.17",
            "verseOrgIds": [
              "2CH.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakungekho phasika elinjengalelo elalenziwa kwa-Israyeli kusukela emihleni yomprofethi uSamuweli; futhi wonke amakhosi akwa-Israyeli akazange alenze iphasika elinjengalo alenzayo uJosiya, nabapristi namaLevi noJuda wonke no-Israyeli ababekhona kanye nabakhileyo eJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.18",
            "verseOrgIds": [
              "2CH.35.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.18",
            "verseOrgIds": [
              "2CH.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka weshumi nesishiyagalombili wokubusa kukaJosiya leli Phasika lenziwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.19",
            "verseOrgIds": [
              "2CH.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.19",
            "verseOrgIds": [
              "2CH.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwakho konke lokho uJosiya eselungisile ithempeli, uNego inkosi yaseGibithe wenyuka ukulwa neKharikemishi ngase-Ewufrathe; uJosiya waphuma ukumhlangabeza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.20",
            "verseOrgIds": [
              "2CH.35.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.20",
            "verseOrgIds": [
              "2CH.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa wathuma izithunywa kuye ukuthi: Ngilani lawe, nkosi yakoJuda? Kangizanga ukulwa lawe lamuhla, kodwa ngimelene lendlu engilwa layo; ngoba uNkulunkulu wangilaya ukuthi ngiphangise; yeka ukuzigaxa noNkulunkulu onami, funa akubhubhise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.21",
            "verseOrgIds": [
              "2CH.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.21",
            "verseOrgIds": [
              "2CH.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uJosiya kazange asuse ubuso bakhe kuye, kodwa waziguqula ukuthi alwe laye, kazange alalele amazwi kaNego aphuma emlonyeni kaNkulunkulu, ukuze alwe esigodini saseMegido.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.22",
            "verseOrgIds": [
              "2CH.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.22",
            "verseOrgIds": [
              "2CH.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abacibishelayo bacibishela inkosi uJosiya; inkosi yathi ezincekwini zayo: “Ngiyekeni ngihambe; ngoba ngilimele kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.23",
            "verseOrgIds": [
              "2CH.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.23",
            "verseOrgIds": [
              "2CH.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho izinceku zakhe zayikhipha kuleyo nqola zayikhwelisa enqoleni yesibili eyayinayo; bamyisa eJerusalema, wafa, wembelwa kwelinye lamathuna awoyise. Wonke uJuda neJerusalema bamlilela uJosiya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.24",
            "verseOrgIds": [
              "2CH.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.24",
            "verseOrgIds": [
              "2CH.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJeremiya walilela uJosiya, nabo bonke abahlabeleli nabahlabeleli bakhuluma ngoJosiya ezililo zabo kuze kube namuhla, bazenza zaba yisimiso kwa-Israyeli; bheka, kuyachazwa encwadini yesiLilo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.25",
            "verseOrgIds": [
              "2CH.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.25",
            "verseOrgIds": [
              "2CH.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye izindaba zikaJosiya nokulunga kwakhe njengokulotshiweyo emthethweni kaJehova,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
              "2CH.35.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
              "2CH.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izenzo zakhe, ezokuqala nezokugcina, bheka, zilotshiwe encwadini yamakhosi akwa-Israyeli nakwaJuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.27",
            "verseOrgIds": [
              "2CH.35.27"
            ]
          }
        }
      ]
