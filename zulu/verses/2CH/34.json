            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba bangishiyile, bashunqa umusi kwabanye onkulunkulu, ukuba bangidlalise ngayo yonke imisebenzi yezandla zabo; ngalokho ulaka lwami luyakuthululwa phezu kwale ndawo, lungayikucinywa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.25",
            "verseOrgIds": [
              "2CH.34.25"
            ]
          }
        }
      ]
    },
    {
