            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, ngiyakukubuthela koyihlo, ubuthelwe ethuneni lakho ngokuthula, amehlo akho angaboni konke okubi engiyakukwehlisela phezu kwale ndawo naphezu kwabakhileyo kuyo. Ngakho balibuyisela ilizwi lenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
