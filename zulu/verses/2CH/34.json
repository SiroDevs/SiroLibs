          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba inhliziyo yakho yayithambile, wazithoba phambi kukaNkulunkulu lapho wezwa amazwi akhe ngale ndawo nabakhileyo kuyo, wazithoba phambi kwami, waklebhula izingubo zakho, wakhala phambi kwami; nami nginizwile,” usho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        }
      ]
    },
