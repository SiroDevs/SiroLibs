              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kubo: “Usho kanje uJehova uNkulunkulu ka-Israyeli, uthi:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.23",
            "verseOrgIds": [
              "2CH.34.23"
