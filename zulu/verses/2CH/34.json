            "sid": "2CH 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova, uthi: “Bheka, ngiyakwehlisela okubi phezu kwale ndawo naphezu kwabakhileyo kuyo, zonke iziqalekiso ezilotshwe encwadini abayifunda phambi kwenkosi yakwaJuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        }
      ]
    },
    {
