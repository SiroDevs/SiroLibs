          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabamisa lapho bonke ababekhona eJerusalema nakwaBenjamini. Futhi abakhileyo eJerusalema benza ngokuvumelana nesivumelwano sikaNkulunkulu, uNkulunkulu wawoyise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        }
      ]
    },
    {
