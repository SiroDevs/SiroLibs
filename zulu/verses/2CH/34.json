          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yasithuma, yabiza wonke amadoda amadala akoJuda leJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.29",
            "verseOrgIds": [
              "2CH.34.29"
            ]
          }
        }
      ]
    },
    {
