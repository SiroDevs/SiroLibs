        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha inkosi yakwaJuda owayithuma ukuba ibuze kuJehova, usho kuyo ukuthi: ‘Usho kanje uJehova uNkulunkulu ka-Israyeli ngamazwi owazwileyo;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
