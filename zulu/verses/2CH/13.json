              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJerobowamu akabe abe namandla emihleni ka-Abiya; uJehova wamshaya, wafa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.20",
