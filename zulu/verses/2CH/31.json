          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobabili ngohlu lozalo lwabapristi ngemindeni yabo namaLevi kusukela kwabaneminyaka engamashumi amabili kuya phezulu ngokwenkonzo yabo ngezigaba zabo;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.17",
