          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isisindo sezipikili sasingamashekeli angamashumi amahlanu egolide. Amakamelo angaphezulu wanameka ngegolide.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
