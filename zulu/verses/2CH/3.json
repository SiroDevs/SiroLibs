          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahlobisa indlu ngamatshe ayigugu ukuze ibe yinkazimulo, igolide laliyigolide laseParvayimi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.6",
            "verseOrgIds": [
