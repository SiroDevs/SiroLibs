              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "USolomoni wayeseqala ukwakha indlu kaJehova eJerusalema entabeni yaseMoriya, lapho uJehova abonakala khona kuDavide uyise, endaweni uDavide ayilungisayo esibuyeni sika-Orinani umJebusi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        }
