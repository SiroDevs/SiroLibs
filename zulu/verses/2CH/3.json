          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza nezinsika ezimbili phambi kwendlu, ukuphakama kwazo kwakuyizingalo ezingamashumi amathathu nanhlanu, nesihloko esasiphezu kwaleyo naleyo sasiyizingalo eziyisihlanu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
