          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza amaketanga njengekamelo elingaphakathi, wawabeka ezinhloko zezinsika; wenza amabhomu ayikhulu, wawafaka emaketangeni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.16",
