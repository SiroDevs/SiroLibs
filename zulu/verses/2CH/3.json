            "sid": "2CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waqala ukwakha ngenyanga yesibili ngosuku lwesibili, ngomnyaka wesine wokubusa kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.2",
            "verseOrgIds": [
              "2CH.3.2"
            ]
