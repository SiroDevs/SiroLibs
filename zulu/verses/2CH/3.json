          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayinameka indlu, nemishayo, nezinsika, nezindonga zayo, neminyango yayo ngegolide; namakherubi eqoshwe ezindongeni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.7",
