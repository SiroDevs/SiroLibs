          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaphiko ala makherubi elu izingalo ezingamashumi amabili; ema ngezinyawo zawo, ubuso bawo bubheke ngaphakathi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.13",
            "verseOrgIds": [
              "2CH.3.13"
            ]
