          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlu enkulu wayigcoba ngemisayipuresi, wayinameka ngegolide elihle, wafaka kuyo amasundu namaketanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.5",
            "verseOrgIds": [
              "2CH.3.5"
            ]
          }
        }
