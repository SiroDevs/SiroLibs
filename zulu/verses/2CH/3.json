          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza iveli ngokuyibubende, nokububende, nokubomvu, nelineni elicolekileyo kakhulu, wenza phezu kwalo amakherubi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
