              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena uyakholwa ukuthi uNkulunkulu munye; wenza kahle; namademoni ayakholwa, athuthumele.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.19",
