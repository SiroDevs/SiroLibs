              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uyathanda yini ukwazi wena muntu oyize, ukuthi ukholo olungelamisebenzi lufile?",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.20",
