          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lona ngumthetho wesikhwele lapho owesifazane engena esikhundleni somyeni wakhe, angcoliswe;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.29",
            "verseOrgIds": [
              "NUM.5.29"
            ]
          }
        }
      ]
    },
