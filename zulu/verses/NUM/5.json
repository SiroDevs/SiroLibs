              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.18",
            "verseOrgIds": [
              "NUM.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi amfungise ngesifungo, athi kowesifazane: ‘Uma kungekho muntu olale nawe, futhi uma ungangcoliswanga ngomunye esikhundleni sendoda yakho, khululeka kulawa manzi ababayo ayisiqalekiso;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.19",
            "verseOrgIds": [
              "NUM.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.19",
            "verseOrgIds": [
              "NUM.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uma uye kwenye indawo yendoda yakho, futhi uma uzingcolisile, futhi othile ulala nawe eceleni kwendoda yakho;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.20",
            "verseOrgIds": [
              "NUM.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.20",
            "verseOrgIds": [
              "NUM.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke umpristi kumelwe afungise owesifazane ngesifungo sesiqalekiso, futhi umpristi kumelwe athi kowesifazane: “UJehova uyokwenza isiqalekiso nesifungo phakathi kwabantu bakini, uma uJehova evusa inqulu yakho nesisu sakho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.21",
            "verseOrgIds": [
              "NUM.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.21",
            "verseOrgIds": [
              "NUM.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawa manzi esiqalekiso ayakungena ezibilinini zakho, avuvukalise isisu sakho, abolise okhalweni lwakho. Futhi owesifazane kumelwe athi: Amen, amen.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.22",
            "verseOrgIds": [
              "NUM.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
