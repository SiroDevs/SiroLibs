              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yala abantwana bakwa-Israyeli ukuba bakhiphe ekamu bonke abantu abanochoko, nabo bonke abacucuzayo, nabo bonke abangcoliswe ngabafileyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.2",
            "verseOrgIds": [
              "NUM.5.2"
            ]
