          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonke iminikelo yezipho ezingcwele zabantwana bakwa-Israyeli abayiletha kumpristi iyakuba ngeyakhe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.9",
            "verseOrgIds": [
              "NUM.5.9"
            ]
          }
        }
      ]
    },
    {
