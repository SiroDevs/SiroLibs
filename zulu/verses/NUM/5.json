          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesilisa nowesifazane bayakunixosha; ubakhiphe ngaphandle kwekamu; ukuze bangangcolisi imibhede yabo engihlezi phakathi kwayo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.3",
            "verseOrgIds": [
              "NUM.5.3"
            ]
          }
        }
      ]
    },
    {
