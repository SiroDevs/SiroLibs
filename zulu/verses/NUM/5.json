            "sid": "NUM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umoya wesikhwele wamfikela, waba nesikhwele ngomkakhe, wangcola; noma uma umoya wesikhwele umfikela, abe nesikhwele ngomkayo, kepha yena angangcoliswa;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.14",
            "verseOrgIds": [
              "NUM.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
