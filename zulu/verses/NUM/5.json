              "NUM.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke indoda kumelwe ilethe umkayo kumpristi, futhi kumelwe ilethe umnikelo wakhe, okweshumi kwe-efa likafulawa webhali; akayikuthela amafutha kuwo, angafaki nampepho phezu kwawo; ngoba kungumhlatshelo wokutshiseka, umnikelo wesikhumbuzo okhumbuza ububi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.15",
            "verseOrgIds": [
              "NUM.5.15"
            ]
          }
        }
      ]
    },
