        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlu engcwele yalowo nalowo iyakuba ngeyakhe; konke umuntu akunika umpristi, kuyakuba ngeyakhe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.10",
            "verseOrgIds": [
              "NUM.5.10"
            ]
          }
        }
