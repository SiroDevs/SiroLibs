        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi indoda yalala naye, futhi kufihliwe emehlweni endoda yakhe futhi kugcinwe eduze, futhi ungcolile, kungekho fakazi ngokumelene naye, futhi akathathwanga ngokulunga;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.13",
            "verseOrgIds": [
              "NUM.5.13"
            ]
          }
        }
      ]
