          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi uyakuthabatha umnikelo esandleni sowesifazane, awusondeze umhlatshelo phambi kukaJehova, awulungise e-altare.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.25",
            "verseOrgIds": [
              "NUM.5.25"
            ]
          }
        }
      ]
    },
