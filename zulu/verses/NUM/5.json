          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noma uma kufika kuye umoya wesikhwele, abe nesikhwele ngomkayo, amlethe owesifazane phambi kukaJehova, umpristi enze kuye wonke lo mthetho;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.30",
            "verseOrgIds": [
              "NUM.5.30"
            ]
          }
        }
      ]
    },
