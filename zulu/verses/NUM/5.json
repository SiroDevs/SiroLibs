          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi kumelwe agcwalise isandla somnikelo, umnikelo wawo wesikhumbuzo, awuthungele ngomlilo e-altare, ngemva kwalokho aphuzise owesifazane la manzi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.26",
            "verseOrgIds": [
              "NUM.5.26"
            ]
          }
        }
      ]
    },
