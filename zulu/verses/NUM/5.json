              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khuluma kubantwana bakoIsrayeli uthi kubo: Uba umkamuntu ephuma enze isono kuye,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.12",
            "verseOrgIds": [
              "NUM.5.12"
            ]
          }
        }
