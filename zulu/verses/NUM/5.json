          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke indoda iyakuba msulwa ebubini, futhi lona wesifazane uyothwala ububi bakhe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.31",
