          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe aphuzise owesifazane amanzi ababayo esiqalekiso, futhi amanzi abangela isiqalekiso ayongena kuye abe ababa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.24",
            "verseOrgIds": [
              "NUM.5.24"
            ]
          }
        }
      ]
