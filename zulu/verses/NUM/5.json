          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi kumelwe amsondeze ammise phambi kukaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.16",
            "verseOrgIds": [
              "NUM.5.16"
