        },
        {
          "text": "Umpristi kumelwe ambeke owesifazane phambi kukaJehova, embule ikhanda lowesifazane, abeke umnikelo wesikhumbuzo womhawu esandleni sakhe, futhi umpristi abe namanzi ababayo esiqalekiso esandleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.18",
            "verseOrgIds": [
              "NUM.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
