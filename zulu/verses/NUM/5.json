              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi kumelwe athathe amanzi angcwele embizeni yobumba; umpristi athabathe othulini oluphansi kwetabernakele, aluphonse emanzini.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.17",
