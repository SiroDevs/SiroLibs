      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.15",
            "verseOrgIds": [
              "NUM.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngemva kwalokho abantu basuka eHazerothi bamisa inkamba enkangala yePharanu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.16",
            "verseOrgIds": [
              "NUM.12.16"
            ]
          }
        }
      ]
    }
