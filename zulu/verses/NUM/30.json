          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke izithembiso nazo zonke izifungo ezibophayo zokucindezela umphefumulo, indoda yakhe ingasiqinisa, noma umyeni wakhe azenze ize.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.13",
            "verseOrgIds": [
              "NUM.30.13"
            ]
          }
        }
      ]
