          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba indoda yakhe ithule kuye insuku ngensuku; Khona-ke uyakuqinisa zonke izithembiso zakhe noma zonke izibopho zakhe eziphezu kwakhe; uyakuqinisekisa, ngokuba wathula naye mhla ekuzwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.14",
            "verseOrgIds": [
              "NUM.30.14"
            ]
          }
        }
      ]
