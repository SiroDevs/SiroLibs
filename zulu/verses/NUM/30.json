            "number": "11",
            "style": "v",
            "sid": "NUM 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umyeni wakhe wakuzwa, wathula naye, akamvumela; zonke izithembiso zakhe ziyakuma, nazo zonke izibopho abophe ngazo umphefumulo wakhe ziyakuma.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.11",
            "verseOrgIds": [
              "NUM.30.11"
