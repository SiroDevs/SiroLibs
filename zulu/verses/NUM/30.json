          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.6",
            "verseOrgIds": [
              "NUM.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umyeni wakhe wakuzwa, wathula naye ngosuku ekuzwa ngalo;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.7",
            "verseOrgIds": [
              "NUM.30.7"
            ]
          }
        }
      ]
