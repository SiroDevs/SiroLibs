          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uma indoda yakhe isichithile impela ngosuku ekuzwa ngalo; khona-ke okuphuma ezindebeni zakhe mayelana nezifungo zakhe noma ngesibopho somphefumulo wakhe ngeke kube khona; umyeni wakhe wayichitha; uJehova uyakumthethelela.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.12",
            "verseOrgIds": [
              "NUM.30.12"
            ]
          }
        }
      ]
    },
    {
