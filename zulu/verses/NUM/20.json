          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakwa-Israyeli bathi kuye: “Sizohamba ngomgwaqo omkhulu; uma mina nezinkomo zami siphuza amanzi akho, ngiyakuwakhokhela; Ngizovele ngidlule ngezinyawo zami ngaphandle kokwenza lutho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.19",
            "verseOrgIds": [
