              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wakhumula izingubo zika-Aroni, wazifaka ku-Eleyazare indodana yakhe; u-Aroni wafela khona esiqongweni sentaba; oMose no-Eleyazare behla entabeni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.28",
            "verseOrgIds": [
              "NUM.20.28"
