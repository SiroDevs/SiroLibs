          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: “Aniyikudabula.” U-Edomi waphuma ukumhlangabeza enamadoda amaningi nangesandla esinamandla.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.20",
            "verseOrgIds": [
              "NUM.20.20"
            ]
          }
        }
