          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thatha u-Aroni no-Eleyazare indodana yakhe, ubakhuphulele eNtabeni yaseHori.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.25",
            "verseOrgIds": [
              "NUM.20.25"
            ]
