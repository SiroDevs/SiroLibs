          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungakho u-Edomi wala ukuba u-Israyeli adabule umkhawulo wakhe; ngalokho u-Israyeli wamfulathela.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.21",
            "verseOrgIds": [
              "NUM.20.21"
