              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Edomi wathi kuye: “Ungadluli kimi, funa ngikuhoshele inkemba.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.18",
            "verseOrgIds": [
              "NUM.20.18"
