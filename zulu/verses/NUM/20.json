          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke umkhumule u-Aroni izingubo zakhe, uzigqokise u-Eleyazare indodana yakhe; u-Aroni uyobuthelwa kubantu bakubo, afele khona.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.26",
            "verseOrgIds": [
              "NUM.20.26"
            ]
