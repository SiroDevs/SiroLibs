          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wenza njengalokho uJehova emyalile, bakhuphuka entabeni yaseHori phambi kwamehlo ayo yonke inhlangano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.27",
            "verseOrgIds": [
              "NUM.20.27"
