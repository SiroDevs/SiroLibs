          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyakuba naso, nenzalo yakhe emva kwakhe isivumelwano sobupristi obuphakade; ngoba wayeshisekela uNkulunkulu wakhe, wabenzela ukubuyisana abantwana bakwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.13",
            "verseOrgIds": [
              "NUM.25.13"
