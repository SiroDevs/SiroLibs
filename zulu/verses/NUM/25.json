          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igama lomIsrayeli owabulawa, naye owabulawa kanye nowesifazane wakwaMidiyani, lalinguZimri indodana kaSalu, isikhulu sendlu kayise kwabakwaSimeyoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.14",
            "verseOrgIds": [
              "NUM.25.14"
            ]
          }
