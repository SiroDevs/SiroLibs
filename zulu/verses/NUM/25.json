              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igama lowesifazane wakwaMidiyani owabulawayo lalinguKoshibi, indodakazi kaSuri; wayeyinhloko yesizwe nendlu yenkosi kwaMidiyani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.15",
