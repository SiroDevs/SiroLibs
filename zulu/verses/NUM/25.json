          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPinehasi, indodana ka-Eleyazare, indodana ka-Aroni umpristi, wayinqanda intukuthelo yami kubantwana bakwa-Israyeli, eshisekela phakathi kwabo ngenxa yami, ukuze ngingabaqedi abantwana bakwa-Israyeli ngokushisekela kwami.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.11",
            "verseOrgIds": [
              "NUM.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
