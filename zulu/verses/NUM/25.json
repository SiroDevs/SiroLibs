          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Israyeli wahlala eShithimi, abantu baqala ukuphinga namadodakazi akwaMowabi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.1",
            "verseOrgIds": [
              "NUM.25.1"
            ]
          }
        }
      ]
    },
    {
