            "sid": "NUM 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokhu kungukuqiniswa komthetho uJehova ayala ngawo ngokuthi: “Yisho kubantwana bakwa-Israyeli ukuthi banilethele inkomo ebomvu engenasici, engenasici, engabekwanga joka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.2",
            "verseOrgIds": [
              "NUM.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.2",
            "verseOrgIds": [
              "NUM.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe ulinike u-Eleyazare umpristi, ukuze amkhiphele ngaphandle kwekamu, futhi othile kumelwe alibulale phambi kobuso bakhe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.3",
            "verseOrgIds": [
              "NUM.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.3",
            "verseOrgIds": [
              "NUM.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi u-Eleyazare kumelwe athathe igazi lakhe ngomunwe wakhe, afafaze elinye legazi lakhe kasikhombisa phambi kwetende lokuhlangana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.4",
            "verseOrgIds": [
              "NUM.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.4",
            "verseOrgIds": [
              "NUM.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu kumelwe ayishise inkomo phambi kwamehlo akhe; kumelwe ashise isikhumba salo nenyama yalo negazi lalo nomquba walo;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.5",
            "verseOrgIds": [
              "NUM.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.5",
            "verseOrgIds": [
              "NUM.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi kumelwe athathe ukhuni lomsedari nehisopi nokubomvu akuphonse phakathi kokusha kwenkomo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.6",
            "verseOrgIds": [
              "NUM.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.6",
            "verseOrgIds": [
              "NUM.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi kumelwe ahlanze izingubo zakhe futhi ageze umzimba wakhe ngamanzi, ngemva kwalokho angene ekamu, umpristi abe ngongcolile kuze kuhlwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.7",
            "verseOrgIds": [
              "NUM.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.7",
            "verseOrgIds": [
              "NUM.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osishisayo kumelwe ahlanze izingubo zakhe ngamanzi, ageze umzimba wakhe ngamanzi, abe ongcolile kuze kuhlwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.8",
            "verseOrgIds": [
              "NUM.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.8",
            "verseOrgIds": [
              "NUM.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ohlanzekile kumelwe abuthe umlotha wethokazi futhi awubeke ngaphandle kwekamu endaweni ehlanzekile, futhi kumelwe ulondolozelwe inhlangano yabantwana bakwa-Israyeli njengamanzi okuhlukanisa; kuyinhlambululo yesono.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.9",
            "verseOrgIds": [
              "NUM.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.9",
            "verseOrgIds": [
              "NUM.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oqoqa umlotha wenkomo kumelwe ahlanze izingubo zakhe abe ongcolile kuze kuhlwe; kuyakuba yisimiso esiphakade kubantwana bakwa-Israyeli nakumfokazi ogogobeleyo phakathi kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.10",
            "verseOrgIds": [
              "NUM.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.10",
            "verseOrgIds": [
              "NUM.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Othinta isidumbu somuntu uzakuba ngongcolile izinsuku eziyisikhombisa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.11",
            "verseOrgIds": [
              "NUM.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.11",
            "verseOrgIds": [
              "NUM.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe azihlanze ngayo ngosuku lwesithathu, futhi ngosuku lwesikhombisa kumelwe abe ohlanzekile; kepha uma engazihlambululi ngosuku lwesithathu, akayikuhlambuluka ngosuku lwesikhombisa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.12",
            "verseOrgIds": [
              "NUM.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.12",
            "verseOrgIds": [
              "NUM.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilowo nalowo othinta isidumbu sofileyo, angaziphothuli, ungcolisa itabernakele likaJehova; lowo mphefumulo kumelwe unqunywe kwa-Israyeli; ngokuba amanzi okuphothula engafafazwanga phezu kwakhe, uyakuba ngongcolile; ukungcola kwakhe kusephezu kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.13",
            "verseOrgIds": [
              "NUM.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.13",
            "verseOrgIds": [
              "NUM.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanku umthetho uma umuntu efela etendeni: wonke ongena etendeni nakho konke okusetendeni uyakuba ngongcolile izinsuku eziyisikhombisa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.14",
            "verseOrgIds": [
              "NUM.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.14",
            "verseOrgIds": [
              "NUM.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke izinto ezivuliwe okungaboshelwa kuzo zingcolile.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.15",
            "verseOrgIds": [
              "NUM.19.15"
            ]
          }
        }
      ]
    },
    {
