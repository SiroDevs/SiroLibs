          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe bathathele ongcolile emlotheni wenkomo yokushiswa yesihlambululo sesono, kuthelwe kuwo amanzi agelezayo ngesitsha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.17",
