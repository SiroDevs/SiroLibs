          "type": "text",
          "attrs": {
            "verseId": "NUM.19.15",
            "verseOrgIds": [
              "NUM.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noma yimuphi othinta endle obulewe ngenkemba, noma ofileyo noma ithambo lomuntu noma ithuna, uyakuba ngongcolile izinsuku eziyisikhombisa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.16",
            "verseOrgIds": [
              "NUM.19.16"
            ]
          }
        }
      ]
    },
    {
