          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zenzele amacilongo amabili esiliva; wowenza ube ngocezu lonke, ulusebenzisele ukubiza umhlangano, nokukhipha amabhoro.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.2",
            "verseOrgIds": [
              "NUM.10.2"
            ]
          }
        }
      ]
    },
    {
