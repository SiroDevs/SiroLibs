              "NUM.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lokuthokoza kwenu nangezinsuku zemikhosi yenu nasekuqaleni kwezinyanga zenu niyakuvuthela amacilongo phezu kweminikelo yenu yokushiswa naphezu kweminikelo yenu yokubonga; ukuze zibe yisikhumbuzo kini phambi kukaNkulunkulu wenu; nginguJehova uNkulunkulu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        }
      ]
    },
    {
