            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngomnyaka wesibili wenyanga yamashumi amabili enyangeni yesibili ifu lenyuswa etendeni lobufakazi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.11",
            "verseOrgIds": [
              "NUM.10.11"
