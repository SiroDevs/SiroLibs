            "sid": "NUM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana ka-Aroni, abapristi, kumelwe abethe amacilongo; kuyakuba yisimiso kini kuze kube phakade ezizukulwaneni zenu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.8",
            "verseOrgIds": [
              "NUM.10.8"
            ]
          }
