          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakwa-Israyeli baphuma ehlane laseSinayi; ifu lahlala ehlane lasePharanu.",
          "type": "text",
