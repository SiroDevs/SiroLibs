            "number": "2",
            "style": "v",
            "sid": "NUM 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshono ebantwaneni bakoIsrayeli uthi kibo: Nxa indoda kumbe owesifazana ezahlukanisa ukwenza isithembiso somNaziri, ukuzahlukanisela eNkosini;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.2",
            "verseOrgIds": [
              "NUM.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.2",
            "verseOrgIds": [
              "NUM.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angayeka iwayini nophuzo oludakayo, angaphuzi viniga wewayini noma uviniga wesiphuzo esinamandla, angaphuzi isiphuzo samagilebhisi, angadli izithelo zomvini ezimanzi noma izithelo zomvini ezomisiweyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.3",
            "verseOrgIds": [
              "NUM.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.3",
            "verseOrgIds": [
              "NUM.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke izinsuku zokuzehlukanisela kwakhe makangadli lutho olwenziwe emvinini, kusukela embewu kuze kube sezikhumbani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke izinsuku zesithembiso sokuzehlukanisa kwakhe akuyikunqunyulwa mpuco ekhanda lakhe; zize zigcwaliseke izinsuku zokuzahlukanisela kwakhe uJehova, uyakuba ngcwele, ayeke ukuhluthuka kwekhanda lakhe kukhule.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke izinsuku azahlukanisela ngazo uJehova, kayikusondela kofileyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.6",
            "verseOrgIds": [
              "NUM.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
