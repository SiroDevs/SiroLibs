          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Israyeli wayithatha yonke le mizi, wahlala u-Israyeli emizini yonke yama-Amori eHeshiboni nasemizini yayo yonke.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.25",
            "verseOrgIds": [
              "NUM.21.25"
            ]
          }
