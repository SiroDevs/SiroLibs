              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho abakhuluma ngezaga bathi: Wozani eHeshiboni, umuzi kaSihoni kawakhiwe, ulungiswe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
