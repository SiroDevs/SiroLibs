          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Israyeli wamshaya ngosiko lwenkemba, walidla izwe lakhe kusukela e-Arinoni kuze kube seJabhoki kubantwana bakwa-Amoni, ngokuba umkhawulo wabantwana bakwa-Amoni wawunamandla.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.24",
            "verseOrgIds": [
              "NUM.21.24"
            ]
          }
        }
