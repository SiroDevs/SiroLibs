              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamnqoba yena namadodana akhe nabo bonke abantu bakhe, kwaze kwangasala muntu, balidla izwe lakhe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.35",
            "verseOrgIds": [
