            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basuka lapho bamisa inkamba esigodini saseSaredi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.12",
            "verseOrgIds": [
              "NUM.21.12"
