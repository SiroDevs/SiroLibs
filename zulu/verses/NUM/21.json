            }
          ]
        },
        {
          "text": "Kungakho kuthiwa egwalweni lwezimpi zeNkosi: Lokho eyakwenza eLwandle lweSihlefu lemithonjeni yeArinoni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
