          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maye kuwe Mowabi! Nibhujiswa nina bantu baseKamos! Wanikela amadodana akhe ababalekile namadodakazi akhe ekuthunjweni kuSihoni, inkosi yama-Amori.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
