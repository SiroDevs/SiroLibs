            "sid": "NUM 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba iHeshiboni lalingumuzi kaSihoni, inkosi yama-Amori, owalwa nenkosi yokuqala yakwaMowabi, walithatha lonke izwe lakhe esandleni sakhe kwaze kwaba se-Arinoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.26",
            "verseOrgIds": [
              "NUM.21.26"
            ]
          }
        }
      ]
    },
