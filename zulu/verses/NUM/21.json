          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basuka e-Oboti, bamisa e-Iye-abarimi ehlane eliphambi kukaMowabi ngasempumalanga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.11",
            "verseOrgIds": [
              "NUM.21.11"
