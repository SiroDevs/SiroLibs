              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, bamemeza bathi: “Sinamsebenzi muni nawe Jesu, Ndodana kaNkulunkulu na? Uze lapha ukusihlupha singakafiki isikhathi?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.29",
            "verseOrgIds": [
              "MAT.8.29"
            ]
          }
        }
      ]
