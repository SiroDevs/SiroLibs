          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe Kapernawume, ophakanyiselwe ezulwini, uyakwehliselwa esihogweni, ngokuba uma yayenziwe eSodoma imisebenzi yamandla eyenziwe kuwe, ngabe isekhona nanamuhla.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.23",
            "verseOrgIds": [
              "MAT.11.23"
            ]
          }
        }
      ]
