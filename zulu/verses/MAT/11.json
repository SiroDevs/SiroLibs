          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha ngithi kini: Kuyakuba ngcono kulo iTire neSidoni ngosuku lokwahlulelwa kunakini.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.22",
            "verseOrgIds": [
              "MAT.11.22"
            ]
          }
        }
