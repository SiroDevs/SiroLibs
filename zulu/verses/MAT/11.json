              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha ngithi kini: Kuyakuba ngcono kuzwe laseSodoma ngosuku lokwahlulelwa kunawe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.24",
            "verseOrgIds": [
