          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalesosikhathi uJesu waphendula wathi: Ngiyakubonga, Baba, Nkosi yezulu lomhlaba, ngoba ukufihlile lezizinto kwabahlakaniphileyo labaqedisisayo, wazambulela izingane;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        }
      ]
    },
