          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maye kuwe Korazini! maye kuwe, Betsayida! ngokuba uma yayenziwe eTire naseSidoni imisebenzi yamandla eyenziwe kini, ngabe kade baphenduka bembethe amasaka nangomlotha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.21",
            "verseOrgIds": [
              "MAT.11.21"
            ]
          }
        }
      ]
    },
