          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bekani ijoka lami phezu kwenu, nifunde kimi; ngokuba ngimnene, ngithobekile ngenhliziyo; niyakufumana ukuphumula emiphefumulweni yenu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
            "verseOrgIds": [
              "MAT.11.29"
            ]
          }
        }
      ]
