          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunjalo, Baba, ngokuba kube kuhle emehlweni akho kanjalo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.26",
            "verseOrgIds": [
              "MAT.11.26"
            ]
          }
        }
      ]
