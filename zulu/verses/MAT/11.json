          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona waqala ukusola imizi okwakwenziwe kuyo iningi lemisebenzi yakhe yamandla, ngokuba ingaphendukanga;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.20",
            "verseOrgIds": [
              "MAT.11.20"
