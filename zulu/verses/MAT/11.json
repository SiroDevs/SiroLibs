          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke izinto zinikelwe kimi nguBaba; akakho owazi iNdodana, kuphela uBaba; kakho futhi omaziyo uYise, ngaphandle kweNdodana, njalo loba ngubani iNdodana ethanda ukumambulela kuye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.27",
            "verseOrgIds": [
              "MAT.11.27"
            ]
          }
        }
      ]
    },
