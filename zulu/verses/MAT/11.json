          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zanini kimi nina nonke enikhatheleyo nenisindwayo, mina ngizakuniphumuza.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.28",
            "verseOrgIds": [
              "MAT.11.28"
            ]
          }
        }
