              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "INdodana yomuntu yafika idla, iphuza, bathi: ‘Bhekani, umuntu oyisiminzi nesiphuzi, umngane wabathelisi nezoni. Kodwa ukuhlakanipha kulungisiswa kubantwana bakho.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.19",
            "verseOrgIds": [
