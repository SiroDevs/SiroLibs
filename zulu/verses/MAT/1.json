          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyakuzala indodana, uyiqambe igama lokuthi uJesu, ngokuba nguye oyakusindisa abantu bakhe ezonweni zabo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.21",
