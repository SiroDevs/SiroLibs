            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuzalwa kukaJesu Kristu kwaba kanje: unina uMariya esemiselwe uJosefa, bengakahlangani wafunyanwa ekhulelwe ngoMoya oNgcwele.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.18",
            "verseOrgIds": [
