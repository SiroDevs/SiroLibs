        {
          "text": "uSalimoni wazala uBhowazi ngoRahabi; uBhowazi wazala u-Obede kuRuthe; u-Obede wazala uJese;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.5",
            "verseOrgIds": [
              "MAT.1.5"
            ]
