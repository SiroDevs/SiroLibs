              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Incwadi yokuzalwa kukaJesu Kristu, indodana kaDavide, indodana ka-Abrahama.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.1",
            "verseOrgIds": [
              "MAT.1.1"
            ]
          }
        }
      ]
    },
    {
