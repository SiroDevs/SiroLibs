          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Aramu wazala u-Aminadaba; u-Aminadaba wazala uNaason; uNahasoni wazala uSalimoni;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.4",
            "verseOrgIds": [
              "MAT.1.4"
            ]
          }
        }
      ]
