          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona uJosefa indoda yakhe, engumuntu olungileyo, engathandi ukumenza ihlazo, waqonda ukumala ngasese.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.19",
