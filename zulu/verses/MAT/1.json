          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esacabanga ngalezi zinto, bheka, ingelosi yeNkosi yabonakala kuye ngephupho, ithi: “Josefa, ndodana kaDavide, ungesabi ukumthatha uMariya umkakho, ngokuba lokho akukhulelweyo kungokwasezulwini uMoya oNgcwele.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.20",
            "verseOrgIds": [
              "MAT.1.20"
            ]
          }
        }
      ]
