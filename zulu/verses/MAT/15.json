          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base besondela abafundi bakhe, bathi kuye: “Uyazi yini ukuthi abaFarisi bakhubeka sebezwile leli zwi na?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.12",
            "verseOrgIds": [
              "MAT.15.12"
            ]
          }
        }
      ]
    },
