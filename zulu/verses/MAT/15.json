            "number": "33",
            "style": "v",
            "sid": "MAT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafundi bakhe bathi kuye: “Singazitholaphi izinkwa ezingaka ehlane ukuba sisuthise isixuku esingaka na?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.33",
            "verseOrgIds": [
              "MAT.15.33"
            ]
          }
        }
      ]
