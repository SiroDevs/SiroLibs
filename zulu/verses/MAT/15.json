          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lababantu basondela kimi ngomlomo wabo, bangidumisa ngezindebe zabo; kepha inhliziyo yabo ikude nami.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.8",
            "verseOrgIds": [
              "MAT.15.8"
            ]
          }
        }
      ]
    },
