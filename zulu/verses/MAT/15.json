            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazenzisi, waprofetha kahle ngani uIsaya, ethi:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.7",
            "verseOrgIds": [
              "MAT.15.7"
            ]
          }
        }
      ]
