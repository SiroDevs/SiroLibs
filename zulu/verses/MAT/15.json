              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha waphendula wathi: “Zonke izithombo ezingatshalwanga nguBaba osezulwini ziyakusishulwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.13",
            "verseOrgIds": [
              "MAT.15.13"
            ]
          }
