          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayekeni; bangabaholi abayizimpumputhe. Uma impumputhe ihola impumputhe, ziyakuyela emgodini zombili.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.14",
