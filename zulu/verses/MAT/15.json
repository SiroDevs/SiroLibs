          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anikaqondi yini ukuthi konke okungena emlonyeni kuya esiswini, futhi kulahlelwa ogwini na?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.17",
            "verseOrgIds": [
              "MAT.15.17"
            ]
          }
        }
      ]
