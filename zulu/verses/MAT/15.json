              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekufika kuJesu ababhali nabaFarisi ababevela eJerusalema, bathi:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.1",
            "verseOrgIds": [
              "MAT.15.1"
            ]
          }
        }
      ]
