          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akusikhona okungena emlonyeni okungcolisa umuntu; kodwa okuphuma emlonyeni, yikho okumngcolisayo umuntu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.11",
            "verseOrgIds": [
              "MAT.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
