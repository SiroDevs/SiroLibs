              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wathi: “Kanti nani anikaqondi na?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.16",
            "verseOrgIds": [
              "MAT.15.16"
