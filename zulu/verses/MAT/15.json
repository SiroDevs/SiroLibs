          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ingahloniphi uyise noma unina; Kanjalo nenze umyalo kaNkulunkulu ube yize ngesiko lenu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.6",
            "verseOrgIds": [
              "MAT.15.6"
            ]
          }
