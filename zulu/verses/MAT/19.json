          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalowo oshiye izindlu, noma abafowabo, noma odadewabo, noma uyise, noma unina, noma abantwana, noma amasimu, ngenxa yegama lami, uyakwamukeliswa okuphindwe kakhulu, adle ifa lokuphila okuphakade.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.29",
            "verseOrgIds": [
              "MAT.19.29"
            ]
