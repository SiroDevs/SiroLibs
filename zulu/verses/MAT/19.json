          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ijaha selizwile lelolizwi, lahamba lidabukile, ngoba lalinengcebo enengi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
            "verseOrgIds": [
