          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njalo futhi ngithi kini: Kulula ukuthi ikamela lingene ngentunja yenalithi, kunokuba onothileyo angene embusweni kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.24",
            "verseOrgIds": [
              "MAT.19.24"
            ]
          }
        }
