              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yazisa uyihlo nonyoko, nokuthi: Wothanda umakhelwane wakho njengalokhu uzithanda wena.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.19",
