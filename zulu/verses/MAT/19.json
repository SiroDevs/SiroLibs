          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wayesethi kubafundi bakhe: “Ngiqinisile ngithi kini: Ocebileyo uyakungena kalukhuni embusweni wezulu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.23",
            "verseOrgIds": [
              "MAT.19.23"
            ]
          }
        }
