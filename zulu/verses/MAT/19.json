              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uJesu wabakhangela wathi kubo: Kubantu lokhu kakwenzeki; kodwa kuNkulunkulu zonke izinto ziyenzeka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.26",
            "verseOrgIds": [
              "MAT.19.26"
            ]
