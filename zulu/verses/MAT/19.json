          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wathi kuye: “Uma uthanda ukuphelela, hamba uthengise ngalokho onakho, uphe abampofu, khona uzakuba negugu ezulwini; uze ungilandele.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.21",
            "verseOrgIds": [
