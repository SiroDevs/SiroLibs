        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.25",
            "verseOrgIds": [
              "MAT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba kuyakumsizani umuntu, uma ezuza izwe lonke, onakalelwe ukuphila kwakhe, na? Yingabe uyakukhiphani umuntu, kube yisihlengo sokuphila kwakhe, na?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.26",
            "verseOrgIds": [
              "MAT.16.26"
            ]
          }
        }
      ]
    },
