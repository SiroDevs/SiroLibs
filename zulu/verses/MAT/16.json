            "verseOrgIds": [
              "MAT.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba yilowo nalowo othanda ukusindisa ukuphila kwakhe uyakulahlekelwa yikho, kepha olahlekelwa ngukuphila kwakhe ngenxa yami uyakukufumana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.25",
            "verseOrgIds": [
              "MAT.16.25"
            ]
          }
        }
      ]
    },
    {
