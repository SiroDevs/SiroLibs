          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusukela ngaleso sikhathi uJesu waqala ukubonisa abafundi bakhe ukuthi umelwe ukuya eJerusalema, ahlushwe ngokuningi ngamalunga nabapristi abakhulu nababhali, abulawe, avuswe ngosuku lwesithathu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.21",
            "verseOrgIds": [
              "MAT.16.21"
            ]
          }
        }
      ]
    },
