          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiqinisile ngithi kini: Bakhona abanye kwabemi lapha abangayikuzwa ngempela ukufa, baze bayibone iNdodana yomuntu iza embusweni wayo.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.28",
            "verseOrgIds": [
              "MAT.16.28"
            ]
          }
        }
