        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova Sebawoti, uthi: “Uma kuyisimangaliso emehlweni ensali yalaba bantu ngalezi zinsuku, kuyakumangalisa nasemehlweni ami na? usho uJehova Sebawoti.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.6",
            "verseOrgIds": [
              "ZEC.8.6"
            ]
          }
        }
      ]
    },
    {
