          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova Sebawoti, uthi: “Nganginomona ngeSiyoni ngokushisekela okukhulu, ngaba nomhawu ngalo ngokufutheka okukhulu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.2",
