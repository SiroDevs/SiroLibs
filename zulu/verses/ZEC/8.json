        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.9",
            "verseOrgIds": [
              "ZEC.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngaphambi kwalezi zinsuku kwakungekho nkokhelo yomuntu noma inkokhelo yezilwane; nophumayo nongenayo kwakungekho ukuthula ngenxa yosizi; ngokuba ngibamise bonke, kube yilowo nalowo kumakhelwane wakhe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.10",
            "verseOrgIds": [
              "ZEC.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
