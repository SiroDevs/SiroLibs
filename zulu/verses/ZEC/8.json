        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.2",
            "verseOrgIds": [
              "ZEC.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova; Ngibuyele eSiyoni, ngiyohlala phakathi kweJerusalema, neJerusalema liyakuthiwa umuzi weqiniso; nentaba kaJehova Sebawoti, intaba engcwele.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.3",
            "verseOrgIds": [
              "ZEC.8.3"
            ]
          }
        }
      ]
    },
    {
