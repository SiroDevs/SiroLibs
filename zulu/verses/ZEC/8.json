          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi njengoba naniyisiqalekiso phakathi kwezizwe, O ndlu yakwaJuda nawe ndlu ka-Israyeli! ngakho ngiyakukusindisa, wena ube yisibusiso; ningesabi, kepha maziqine izandla zenu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.13",
            "verseOrgIds": [
              "ZEC.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
