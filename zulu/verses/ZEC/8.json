            "verseId": "ZEC.8.11",
            "verseOrgIds": [
              "ZEC.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba inzalo izaphumelela; umvini uyakuthela izithelo zawo, umhlaba uthele ukudla kwawo, amazulu anike amazolo awo; ngiyakwenza ukuba insali yalaba bantu idle ifa lazo zonke lezi zinto.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.12",
            "verseOrgIds": [
              "ZEC.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
