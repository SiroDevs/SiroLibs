          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilezi izinto okufanele nizenze; Yilowo nalowo ukhuluma iqiniso kumakhelwane wakhe; yenzani isahlulelo seqiniso nokuthula emasangweni enu;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.16",
            "verseOrgIds": [
              "ZEC.8.16"
            ]
          }
        }
