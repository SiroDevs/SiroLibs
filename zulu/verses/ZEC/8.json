        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.14",
            "verseOrgIds": [
              "ZEC.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho nami ngacabanga ngalezo zinsuku ukwenzela iJerusalema nendlu kaJuda okuhle; Ungesabi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.15",
            "verseOrgIds": [
              "ZEC.8.15"
            ]
          }
        }
      ]
    },
