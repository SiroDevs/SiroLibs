            "sid": "ZEC 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makungabikho kini ocabanga okubi enhliziyweni yakhe ngomakhelwane wakhe; ningathandi isifungo samanga, ngokuba zonke lezi yizinto engizizondayo,” usho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.17",
            "verseOrgIds": [
              "ZEC.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
