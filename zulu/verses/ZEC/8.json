            "verseOrgIds": [
              "ZEC.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova Sebawoti, uthi: “Bheka, ngiyakubakhulula abantu bami ezweni lasempumalanga nasezweni lasentshonalanga;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.7",
            "verseOrgIds": [
              "ZEC.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 8:7"
          },
          "items": [
            {
              "text": "7",
