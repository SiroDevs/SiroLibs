          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thula, nyama yonke, phambi kweNkosi, ngoba ivukile endaweni yayo yokuhlala engcwele.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.13",
            "verseOrgIds": [
              "ZEC.2.13"
            ]
          }
        }
