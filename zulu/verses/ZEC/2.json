        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.11",
            "verseOrgIds": [
              "ZEC.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova uyodla ifa lesabelo sikaJuda ezweni elingcwele futhi aphinde akhethe iJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.12",
            "verseOrgIds": [
              "ZEC.2.12"
            ]
          }
        }
      ]
    },
