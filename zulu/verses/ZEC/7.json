          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.13",
            "verseOrgIds": [
              "ZEC.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngabahlakaza ngesivunguvungu phakathi kwezizwe zonke ababengazazi. Izwe laliyihlane emva kwabo, okungangadluli muntu kulo, kungabuyi muntu, ngokuba benza izwe elihle laba yihlane.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.14",
            "verseOrgIds": [
              "ZEC.7.14"
            ]
          }
        }
      ]
    }
