        {
          "text": "Kwathi ngisaphakamisa izwi lami ngikhala, washiya ingubo yakhe kimi, wabaleka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.18",
            "verseOrgIds": [
