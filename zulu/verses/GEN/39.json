              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umlindi wetilongo wanikela esandleni sikaJosefa zonke iziboshwa ezazisetilongweni; futhi noma yini ababeyenza lapho, wayeyenza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.22",
