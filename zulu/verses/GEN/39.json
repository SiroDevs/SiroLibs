          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi kaJosefa yamthatha yamfaka etilongweni, indawo lapho iziboshwa zenkosi zaziboshwe khona; wayelapho etilongweni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.20",
            "verseOrgIds": [
