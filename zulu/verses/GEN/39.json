          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasekhuluma kuye njengalamazwi wathi: Inceku engumHebheru osilethele yona ingene ukuzodlala ngami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.17",
            "verseOrgIds": [
              "GEN.39.17"
            ]
          }
        }
      ]
