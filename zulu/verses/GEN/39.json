          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uJehova wayenaye uJosefa, wamhawukela, wamnika umusa emehlweni omlindi wetilongo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.21",
            "verseOrgIds": [
              "GEN.39.21"
