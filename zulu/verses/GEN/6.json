          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho abantu beqala ukwanda emhlabeni, bezalelwa amadodakazi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.1",
            "verseOrgIds": [
              "GEN.6.1"
            ]
          }
        }
      ]
    },
    {
