            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nansi indlela okumelwe uwenze ngayo: Ubude bomkhumbi kumelwe bube yizingalo ezingamakhulu amathathu, ububanzi bawo bube yizingalo ezingamashumi amahlanu nokuphakama kwawo kube yizingalo ezingamashumi amathathu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.15",
            "verseOrgIds": [
              "GEN.6.15"
            ]
          }
        }
      ]
    },
    {
