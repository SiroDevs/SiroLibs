              "GEN.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenzela umphongolo ifasitela, uliqedele ngengalo eyodwa phezulu; ubeke iminyango yomphongolo eceleni; ngephansi, isitezi sesibili nesesithathu kufanele ukwenze.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.16",
            "verseOrgIds": [
              "GEN.6.16"
            ]
          }
        }
      ]
    },
