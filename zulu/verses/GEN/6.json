            "number": "17",
            "style": "v",
            "sid": "GEN 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, ngiletha uzamcolo wamanzi emhlabeni ukuba achithe yonke inyama okukuyo umoya wokuphila phansi kwezulu; nakho konke okusemhlabeni kuyakufa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.17",
            "verseOrgIds": [
              "GEN.6.17"
            ]
          }
        }
