        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wathi kuNowa: “Ukuphela kwayo yonke inyama kufikile phambi kobuso bami; ngokuba umhlaba ugcwele ubudlwangudlwangu ngenxa yabo; futhi bheka, ngizobabhubhisa kanye nomhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.13",
            "verseOrgIds": [
              "GEN.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.13",
            "verseOrgIds": [
              "GEN.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zenzele umkhumbi ngokhuni lwegofere; Uyakwenza amakamelo emkhunjini, uwugcobe ngaphakathi nangaphandle ngekolitayi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.14",
            "verseOrgIds": [
              "GEN.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
