          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.11",
            "verseOrgIds": [
              "GEN.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wawubheka umhlaba, bheka, wawonakele; ngoba yonke inyama iyonakalisile indlela yayo emhlabeni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.12",
            "verseOrgIds": [
              "GEN.6.12"
            ]
          }
        }
      ]
    },
    {
