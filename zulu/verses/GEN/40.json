          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa phakathi kwezinsuku ezintathu uFaro uzaphakamisa ikhanda lakho alisuse kuwe, akulengise emthini; izinyoni ziyakudla inyama yakho kuwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.19",
            "verseOrgIds": [
