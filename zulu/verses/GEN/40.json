        },
        {
          "text": "UJosefa waphendula wathi: “Nanku ukuchazwa kwakho: oqoma abathathu bayizinsuku ezintathu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.18",
            "verseOrgIds": [
              "GEN.40.18"
            ]
          }
        }
      ]
