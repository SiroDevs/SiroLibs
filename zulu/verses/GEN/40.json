              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngosuku lwesithathu kwakuwusuku lokuzalwa kukaFaro, wazenzela izinceku zakhe zonke idili;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.20",
