          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalezo zinto umphathizitsha wenkosi yaseGibithe nombhaki bakhubekisa inkosi yabo, inkosi yaseGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.1",
            "verseOrgIds": [
              "GEN.40.1"
            ]
          }
        }
      ]
    },
    {
