            "sid": "GEN 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abrama wakhuphuka ephuma eGibithe, yena nomkakhe, nakho konke anakho, noLoti enaye, waya eningizimu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.1",
            "verseOrgIds": [
              "GEN.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.1",
            "verseOrgIds": [
              "GEN.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abrama wayecebile kakhulu ngemfuyo, nangesiliva nangegolide.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.2",
            "verseOrgIds": [
              "GEN.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 13:2"
          },
          "items": [
