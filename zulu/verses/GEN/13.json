        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yasisithi kuAbrama, emva kokuthi uLothi esehlukene laye: Phakamisa amehlo akho, ukhangele ukulapho okhona, enyakatho laseningizimu, lempumalanga, lentshonalanga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.14",
            "verseOrgIds": [
              "GEN.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.14",
            "verseOrgIds": [
              "GEN.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba lonke ilizwe olibonayo ngizalinika wena lenzalo yakho kuze kube nininini.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.15",
            "verseOrgIds": [
              "GEN.13.15"
            ]
          }
        }
      ]
    },
    {
