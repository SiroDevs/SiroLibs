      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 47:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.25",
            "verseOrgIds": [
              "GEN.47.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 47:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa wabeka umthetho phezu kwezwe laseGibhithe kuze kube namuhla ukuthi uFaro athole ingxenye yesihlanu; ngaphandle kwezwe labapristi lodwa, elingazange libe ngelikaFaro.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.26",
            "verseOrgIds": [
              "GEN.47.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 47:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.26",
            "verseOrgIds": [
              "GEN.47.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 47:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Israyeli wahlala ezweni laseGibithe, ezweni laseGosheni; babenemfuyo kulo, banda, banda kakhulu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.27",
            "verseOrgIds": [
              "GEN.47.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 47:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.27",
            "verseOrgIds": [
              "GEN.47.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 47:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJakobe wahlala iminyaka eyishumi nesikhombisa ezweni laseGibithe; Iyonke iminyaka kaJakobe yaba yiminyaka eyikhulu namashumi amane nesikhombisa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.28",
            "verseOrgIds": [
              "GEN.47.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 47:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
