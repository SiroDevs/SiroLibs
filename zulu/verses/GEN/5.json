          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabadala owesilisa nowesifazane; wababusisa, wababiza ngokuthi u-Adamu mhla badalwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
