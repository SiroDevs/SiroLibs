        {
          "text": "Le yincwadi yezizukulwane zika-Adamu. Mhla uNkulunkulu edala umuntu, wamenza ngomfanekiso kaNkulunkulu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
