          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Adamu wahamba iminyaka eyikhulu namashumi amathathu, wazala indodana emfuze ngomfanekiso wakhe; wambiza ngokuthi uSeti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
