        {
          "text": "Izinsuku zika-Adamu emva kokuzalwa kukaSeti zaziyiminyaka engamakhulu ayisishiyagalombili; wazala amadodana namadodakazi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
