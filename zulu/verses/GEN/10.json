        },
        {
          "text": "Lezi ziyizizukulwane zamadodana kaNowa, oShemi, noHamu, noJafete; bazalelwa wona emva kukazamcolo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.1",
