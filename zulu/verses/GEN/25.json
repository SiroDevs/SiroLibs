          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana baxabana phakathi kwakhe; wathi: “Uma kunjalo, nginje ngani na?” Futhi wahamba wayobuza eNkosini.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.22",
            "verseOrgIds": [
