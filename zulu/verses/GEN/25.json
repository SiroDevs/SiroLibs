              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waphuma owokuqala ebomvu, enjengengubo yoboya; baqamba igama lakhe ngokuthi u-Esawu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.25",
