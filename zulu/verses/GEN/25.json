            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Isaka wamkhulekela umkakhe kuJehova, ngokuba wayeyinyumba; uRebeka umkakhe wakhulelwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.21",
