          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wayesethi kuye: “Esiswini sakho kukhona izizwe ezimbili; esinye isizwe siyakuba namandla kunesinye isizwe; futhi omkhulu kumelwe akhonze omncane.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
