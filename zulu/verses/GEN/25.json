              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafana bakhula, u-Esawu waba yiphisi, indoda yasendle; uJakobe wayeyindoda engenalwazi ehlala ematendeni.",
          "type": "text",
          "attrs": {
