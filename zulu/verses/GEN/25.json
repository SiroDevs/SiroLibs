          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi seziphelele izinsuku zakhe zokubeletha, kwakukhona amawele esizalweni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.24",
