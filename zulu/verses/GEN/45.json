              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamtshela wathi: “UJosefa usekhona, ungumbusi wezwe lonke laseGibithe.” Inhliziyo kaJakobe yaphela, ngokuba engabakholwanga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.26",
