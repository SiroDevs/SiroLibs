          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathumela kanjalo kuyise; izimbongolo eziyishumi, zithwele izinto ezinhle zaseGibithe, nezimbongolo eziyishumi, zithwele amabele, nesinkwa, nenyama kayise endleleni.",
          "type": "text",
