          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unganaki impahla yakho; ngoba okuhle kwezwe lonke laseGibhithe kungokwenu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.20",
            "verseOrgIds": [
