          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasebamukisa abafowabo, basebesuka, wathi kubo: Qaphelani ukuthi lingawa endleleni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.24",
