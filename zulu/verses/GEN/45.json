              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje uyaliwe, kwenze; zithatheleni izinqola ezweni laseGibithe, nithathele abancane benu nabafazi benu, nilethe uyihlo, nize.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.19",
