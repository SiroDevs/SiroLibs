            "number": "17",
            "style": "v",
            "sid": "GEN 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yaseSodoma yaphuma ukumhlangabeza ngemva kokuba isibuyile ekubulaleni uKedorlawomere namakhosi ayenaye, esigodini saseShebe, esiyisigodi samakhosi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.17",
            "verseOrgIds": [
              "GEN.14.17"
            ]
          }
        }
      ]
    },
