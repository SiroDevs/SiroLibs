        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi emihleni ka-Amrafeli inkosi yaseShinari, no-Arjogi, inkosi yase-Elasari, noKedorlawomere inkosi yase-Elamu, inkosi yaseTidali wezizwe;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.1",
            "verseOrgIds": [
              "GEN.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.1",
            "verseOrgIds": [
              "GEN.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "balwa noBera inkosi yaseSodoma, noBirsha inkosi yaseGomora, noSinabi, inkosi yase-Adima, noSemeberi, inkosi yaseSeboyimi, nenkosi yaseBela eyiZowari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.2",
            "verseOrgIds": [
              "GEN.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
