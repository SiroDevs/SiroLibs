      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.6",
            "verseOrgIds": [
              "GEN.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bebuya, bafika e-Enimishipati eyiKadeshi, balichitha lonke izwe lama-Amaleki, nama-Amori ayehlala eHasoni-Tamari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.7",
            "verseOrgIds": [
              "GEN.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.7",
            "verseOrgIds": [
              "GEN.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yaseSodoma, nenkosi yaseGomora, nenkosi yase-Adima, nenkosi yaseSeboyimi, nenkosi yaseBela, okuyiZowari, baphuma balwa nabo esigodini saseSidimi;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.8",
            "verseOrgIds": [
              "GEN.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
