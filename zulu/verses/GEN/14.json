          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.5",
            "verseOrgIds": [
              "GEN.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "namaHori ezintabeni zawo iSeyiri, kwaze kwaba se-Eliparani elisehlane.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.6",
            "verseOrgIds": [
              "GEN.14.6"
            ]
          }
        }
      ]
    },
    {
