              "GEN.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanye noKedorlawomere inkosi yase-Elamu, noTidali inkosi yezizwe, no-Amrafeli inkosi yaseShinari, no-Ariyoki inkosi yase-Elasari; amakhosi amane namahlanu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.9",
            "verseOrgIds": [
              "GEN.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.9",
            "verseOrgIds": [
              "GEN.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isigodi saseSidimi sasigcwele imigodi yebitume; amakhosi aseSodoma naseGomora abaleka, awela khona; labo abaseleyo babalekela entabeni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.10",
            "verseOrgIds": [
              "GEN.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.10",
            "verseOrgIds": [
              "GEN.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bethatha yonke impahla yaseSodoma neGomora kanye nakho konke ukudla kwabo bamuka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.11",
            "verseOrgIds": [
              "GEN.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.11",
            "verseOrgIds": [
              "GEN.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamthatha uLoti, indodana yomfowabo ka-Abrama, owayehlala eSodoma, nempahla yakhe, bamuka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.12",
            "verseOrgIds": [
              "GEN.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.12",
            "verseOrgIds": [
              "GEN.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekufika okhululiweyo, wabikela uAbrama umHebheru; ngokuba wayehlala e-okini kaMamre umAmori, umfowabo ka-Eshikoli nomfowabo ka-Anere; futhi bahlobana no-Abrama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.13",
            "verseOrgIds": [
              "GEN.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.13",
            "verseOrgIds": [
              "GEN.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abrama esezwile ukuthi umfowabo ubotshiwe, wawahlomisa amadoda akhe aqeqeshiweyo, azalelwe endlini yakhe, amakhulu amathathu neshumi nesishiyagalombili, wabaxosha kwaze kwaba kwaDan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.14",
            "verseOrgIds": [
              "GEN.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.14",
            "verseOrgIds": [
              "GEN.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabahlukanisela ebusuku, yena nezinceku zakhe, wabanqoba, wabaxosha kwaze kwaba seHoba elingakwesokhohlo saseDamaseku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.15",
            "verseOrgIds": [
              "GEN.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.15",
            "verseOrgIds": [
              "GEN.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wazibuyisa zonke izimpahla, wambuyisa noLoti umfowabo, nempahla yakhe, nabesifazane, nabantu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.16",
            "verseOrgIds": [
              "GEN.14.16"
            ]
          }
        }
      ]
    },
    {
