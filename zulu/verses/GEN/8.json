              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wamkhumbula uNowa, nezilwane zonke, nezinkomo zonke ezazinaye emkhunjini;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.1",
            "verseOrgIds": [
              "GEN.8.1"
            ]
          }
        }
      ]
