          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ijuba alifumananga indawo yokuphumula yamathe onyawo lwalo, labuyela kuye emkhunjini, ngokuba amanzi ayesesemhlabeni wonke; wayeselula isandla sakhe, walithatha, walidonsela emkhunjini kanye naye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.9",
            "verseOrgIds": [
              "GEN.8.9"
            ]
          }
        }
      ]
    },
