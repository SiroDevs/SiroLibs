          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanzi ancipha kwaze kwaba yinyanga yeshumi; ngenyanga yeshumi, ngolokuqala lwenyanga, kwabonakala iziqongo zezintaba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.5",
            "verseOrgIds": [
              "GEN.8.5"
            ]
          }
        }
      ]
    },
