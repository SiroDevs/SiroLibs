        {
          "text": "Kwathi ekupheleni kwezinsuku ezingamashumi amane uNowa wavula ifasitela lomkhumbi abelenzile.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.6",
            "verseOrgIds": [
              "GEN.8.6"
