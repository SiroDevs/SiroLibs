              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabuye wahlala izinsuku eziyisikhombisa; wabuye walikhipha ijuba emkhunjini;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.10",
            "verseOrgIds": [
              "GEN.8.10"
