          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanzi aphenduka njalo emhlabeni, kwathi ekupheleni kwezinsuku eziyikhulu namashumi ayisihlanu amanzi abohla.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.3",
            "verseOrgIds": [
              "GEN.8.3"
            ]
          }
        }
      ]
    },
    {
