          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaSimeyoni ngu oJemuweli, noJamini, no-Ohadi, noJagini, noSohari, noSawule, indodana yowesifazane waseKhanani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.10",
            "verseOrgIds": [
              "GEN.46.10"
            ]
          }
        }
      ]
    },
