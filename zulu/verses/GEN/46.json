          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaJuda; u-Eri, no-Onani, noShela, noPerezi, noSeraki; kepha o-Eri no-Onani bafela ezweni laseKhanani. Amadodana kaPheresi: ngoHezironi noHamuli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.12",
            "verseOrgIds": [
              "GEN.46.12"
            ]
          }
        }
      ]
