          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaRubeni: uHanoki, noFalu, noHezironi, noKarmi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.9",
            "verseOrgIds": [
              "GEN.46.9"
            ]
          }
        }
      ]
    },
    {
