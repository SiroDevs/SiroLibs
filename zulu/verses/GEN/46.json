          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa wayesethi kubafowabo nakuyo indlu kayise: “Ngiyakwenyuka ngimbonise uFaro, ngithi kuye: ‘Abafowethu nendlu kababa ababesezweni laseKhanani bafikile kimi;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.31",
            "verseOrgIds": [
              "GEN.46.31"
            ]
          }
        }
      ]
    },
