          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 46:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "La madoda angabelusi, ngokuba umsebenzi wawo wawuwukwelusa imfuyo; baletha izimvu zabo, nezinkomo zabo, nakho konke ababenakho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.32",
            "verseOrgIds": [
              "GEN.46.32"
            ]
          }
        }
