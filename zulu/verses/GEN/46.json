          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzakuthi-ke lapho uFaro elibiza esithi: Uyini umsebenzi wenu?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.33",
            "verseOrgIds": [
              "GEN.46.33"
            ]
          }
        }
      ]
