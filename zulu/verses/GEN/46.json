          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonke imiphefumulo eyafika noJakobe eGibhithe, eyaphuma okhalweni lwakhe, ngaphandle kwabafazi bamadodana kaJakobe, yonke imiphefumulo engamashumi ayisithupha nesithupha;",
          "type": "text",
