          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathuma uJuda phambi kwakhe kuJosefa ukuba abhekise ubuso bakhe ngaseGosheni; bafika ezweni laseGosheni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.28",
            "verseOrgIds": [
              "GEN.46.28"
            ]
