          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "UIsrayeli wasesithi kuJosefa: Ake ngife, ngoba ngibonile ubuso bakho, ngoba usaphila.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.30",
            "verseOrgIds": [
              "GEN.46.30"
            ]
          }
