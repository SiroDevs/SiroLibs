          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesilisa ongasokile, ijwabu lakhe elingasokanga, lowo muntu uyakunqunywa kubantu bakubo; wephule isivumelwano sami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
              "GEN.17.14"
            ]
          }
        }
      ]
    },
    {
