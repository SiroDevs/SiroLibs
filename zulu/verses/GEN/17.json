          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakwenza isivumelwano sami phakathi kwami nawe, nginandise kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.2",
            "verseOrgIds": [
              "GEN.17.2"
            ]
          }
        }
      ]
    },
