          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abrahama wawa ngobuso bakhe, wahleka, wathi enhliziyweni yakhe: “Oneminyaka eyikhulu uyakuzalelwa na? noSara oneminyaka engamashumi ayisishiyagalolunye uyakuzala na?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.17",
            "verseOrgIds": [
              "GEN.17.17"
            ]
          }
        }
      ]
    },
