              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abrama eseneminyaka engamashumi ayisishiyagalolunye nesishiyagalolunye uJehova wabonakala ku-Abrama, wathi kuye: “NginguNkulunkulu uSomandla; hamba phambi kwami futhi uphelele.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        }
      ]
    },
    {
