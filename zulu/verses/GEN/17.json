              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abrahama wathi kuNkulunkulu: “U-Ishmayeli makaphile phambi kwakho!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.18",
            "verseOrgIds": [
