          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wathi ku-Abrahama: “USarayi umkakho, ungambizi ngokuthi uSarayi, kepha igama lakhe liyakuba nguSara.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.15",
            "verseOrgIds": [
              "GEN.17.15"
            ]
          }
        }
      ]
    },
