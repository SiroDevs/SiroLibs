          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngizamisa isivumelwano sami loIsaka, uSara azakuzalela yena ngalesisikhathi esimisiweyo ngomnyaka olandelayo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.21",
