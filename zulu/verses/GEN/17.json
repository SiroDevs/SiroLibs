          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizambusisa njalo ngikunike indodana evela kuye; yebo, ngiyakumbusisa, abe ngunina wezizwe; amakhosi ezizwe ayophuma kuyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.16",
            "verseOrgIds": [
              "GEN.17.16"
            ]
          }
        }
      ]
    },
    {
