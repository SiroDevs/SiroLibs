          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJuda wasesithi: Kazithathele, ukuze singajabhi; bheka, ngithume le ngane, kodwa awuyitholanga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.23",
