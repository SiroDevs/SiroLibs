            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elokhu ehoxisa isandla sakhe, umfowabo waphuma, wathi: “Nifohle kanjani na?” ngakho-ke igama lakhe lathiwa uParesi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
