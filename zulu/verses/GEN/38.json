          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJuda wayesethumela izinyane lembuzi ngesandla somngane wakhe wase-Adulamu ukuba athathe isibambiso esandleni sowesifazane, kodwa akamtholanga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.20",
            "verseOrgIds": [
              "GEN.38.20"
            ]
