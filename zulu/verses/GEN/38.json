          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJuda wazivuma, wathi: “Ulungile kunami; ngoba angimnikanga uSela indodana yami. Futhi akasamazi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
