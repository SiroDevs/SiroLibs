          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesebuza abantu baleyo ndawo, wathi: “Siphi isifebe esasise-Enayimi ngasendleleni na?” Bathi: “Akuzange kube khona isifebe kule ndawo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.21",
            "verseOrgIds": [
              "GEN.38.21"
            ]
          }
        }
