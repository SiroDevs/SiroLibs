          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasuka wahamba, walala eduze kweveli lakhe, wembatha izingubo zakhe zobufelokazi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.19",
