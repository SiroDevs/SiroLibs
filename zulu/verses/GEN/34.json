          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethi uShekemi kuyise wayo nakubafowabo: “Mangithole umusa emehlweni enu, nalokho eniyakungitshela khona ngiyakuninika khona.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.11",
            "verseOrgIds": [
              "GEN.34.11"
            ]
          }
        }
      ]
    },
    {
