          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDina, indodakazi kaLeya, ayizalela uJakobe, waphuma ukuyobona amadodakazi alelo zwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.1",
            "verseOrgIds": [
              "GEN.34.1"
            ]
          }
        }
      ]
    },
    {
