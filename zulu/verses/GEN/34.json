          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathi kubo: “Asinakukwenza lokho ukuba udadewethu simnike umuntu ongasokanga; ngoba kuyihlazo kithi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.14",
            "verseOrgIds": [
              "GEN.34.14"
            ]
          }
        }
