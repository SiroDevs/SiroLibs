              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathi: “Iyakumphatha udadewethu njengesifebe na?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.31",
            "verseOrgIds": [
              "GEN.34.31"
