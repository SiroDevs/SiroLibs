        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.5",
            "verseOrgIds": [
              "GEN.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHamori uyise kaShekemi waphuma waya kuJakobe ukuyokhuluma naye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.6",
            "verseOrgIds": [
              "GEN.34.6"
            ]
          }
        }
      ]
    },
    {
