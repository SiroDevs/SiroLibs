          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyakuhlala nathi, izwe libe phambi kwenu; hlalani nihwebe ngalo, nizuze impahla kulo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.10",
            "verseOrgIds": [
              "GEN.34.10"
            ]
          }
        }
      ]
