      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.1",
            "verseOrgIds": [
              "GEN.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UShekemi indodana kaHamori umHivi, umbusi wezwe, wambona, wamthatha, walala naye, wangcolisa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.2",
            "verseOrgIds": [
              "GEN.34.2"
            ]
          }
        }
      ]
    },
    {
