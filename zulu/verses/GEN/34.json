          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "khona siyakuninika amadodakazi ethu, sizithathele amadodakazi enu, sihlale nani, sibe yisizwe sinye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.16",
            "verseOrgIds": [
