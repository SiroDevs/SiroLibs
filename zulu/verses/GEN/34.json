            "sid": "GEN 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJakobe wezwa ukuthi ungcolisile indodakazi yakhe uDina; amadodana akhe ayesemadlelweni nezinkomo zakhe; uJakobe wathula zaze zafika.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.5",
            "verseOrgIds": [
              "GEN.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
