          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJakobe wayesethi kuSimeyoni noLevi: “Ningethusile, ngokungenza nginuke phakathi kwabakhileyo ezweni, phakathi kwamaKhanani namaPherizi; futhi ngimbalwa ngenani, bazongibuthanela futhi bangibulale; ngiyakuchithwa, mina nendlu yami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.30",
            "verseOrgIds": [
              "GEN.34.30"
            ]
          }
        }
      ]
    },
