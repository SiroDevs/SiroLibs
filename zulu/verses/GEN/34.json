          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kulokhu sizavumelana lani: Uba lithanda ukuba njengathi, ukuthi bonke abesilisa phakathi kwenu basokwe;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.15",
            "verseOrgIds": [
              "GEN.34.15"
            ]
