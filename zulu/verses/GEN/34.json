          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaJakobe abaphendula ngamanga oShekemi noyise uHamori, ethi, ngokuba engcolisile udadewabo uDina;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.13",
            "verseOrgIds": [
              "GEN.34.13"
            ]
          }
        }
      ]
