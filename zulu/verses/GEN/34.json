        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.11",
            "verseOrgIds": [
              "GEN.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungalokothi ungicele ilobolo nesipho esingaka, futhi ngizokunika njengokusho kwakho kimi; kodwa nginike intombi ibe ngumkami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.12",
            "verseOrgIds": [
              "GEN.34.12"
            ]
          }
        }
      ]
    },
