          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wamakhulu ayisithupha wokuphila kukaNowa, ngenyanga yesibili, ngosuku lweshumi nesikhombisa lwenyanga, ngalona lolo suku yonke imithombo kazamcolo omkhulu yagqashuka, namafasitele asezulwini avuleka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.11",
            "verseOrgIds": [
