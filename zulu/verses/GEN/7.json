          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zangena ngazimbili kuNowa emkhunjini, iduna nensikazi, njengalokho uNkulunkulu emyalile uNowa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.9",
            "verseOrgIds": [
