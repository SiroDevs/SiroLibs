          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwezinsuku eziyisikhombisa amanzi kazamcolo afika emhlabeni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.10",
            "verseOrgIds": [
              "GEN.7.10"
            ]
          }
        }
      ]
