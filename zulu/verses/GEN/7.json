          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinyameni ezihlambulukileyo, nasezinyameni ezingcolileyo, nakuzinyoni, nakuzo zonke ezinwabuzelayo emhlabeni,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.8",
            "verseOrgIds": [
              "GEN.7.8"
