          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethi uJehova kuNowa: “Ngena emkhunjini wena nendlu yakho yonke; ngoba ngikubonile ulungile phambi kobuso bami kulesisizukulwana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.1",
            "verseOrgIds": [
              "GEN.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.1",
            "verseOrgIds": [
              "GEN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzo zonke izilwane ezihlanzekile kumelwe uzithathele eziyisikhombisa, iduna nensikazi yalo; Ezinyameni ezihlambulukileyo, ngambili ngambili, iduna nensikazi yalo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.2",
            "verseOrgIds": [
              "GEN.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.2",
            "verseOrgIds": [
              "GEN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinyonini zezulu ngasikhombisa, iduna nensikazi; ukugcina imbewu iphila emhlabeni wonke.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.3",
            "verseOrgIds": [
              "GEN.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
