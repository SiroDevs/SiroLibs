          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolo suku uNowa, uShemi, noHamu, noJafete, amadodana kaNowa, nomkaNowa, nabafazi abathathu bamadodana akhe kanye nabo, bangena emkhunjini;",
          "type": "text",
