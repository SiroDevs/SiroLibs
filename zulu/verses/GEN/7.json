          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNowa wayeneminyaka engamakhulu ayisithupha mhla uzamcolo uphezu komhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.6",
            "verseOrgIds": [
              "GEN.7.6"
