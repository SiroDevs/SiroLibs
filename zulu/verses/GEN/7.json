            "sid": "GEN 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNowa wangena emkhunjini, namadodana akhe, nomkakhe, nabafazi bamadodana akhe kanye naye, emkhunjini ngenxa yamanzi kazamcolo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.7",
            "verseOrgIds": [
              "GEN.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
