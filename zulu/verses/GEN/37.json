          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJakobe waklebhula izingubo zakhe, wembatha indwangu yesaka okhalweni lwakhe, walilela indodana yakhe izinsuku eziningi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.34",
            "verseOrgIds": [
              "GEN.37.34"
            ]
          }
        }
