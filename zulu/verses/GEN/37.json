          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "URubeni wathi kubo: “Ningachithi gazi, kepha mphonseni kulo mthombo osehlane, ningabeki isandla kuye; ukuze amkhulule esandleni sabo, ambuyisele kuyise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.22",
            "verseOrgIds": [
              "GEN.37.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
