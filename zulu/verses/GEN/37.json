            "sid": "GEN 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJuda wasesithi kubafowabo: Kuzasizani ukuthi sibulale umfowethu, sifihle igazi lakhe?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.26",
            "verseOrgIds": [
              "GEN.37.26"
            ]
          }
        }
      ]
    },
    {
