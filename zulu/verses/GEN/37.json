          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bethatha ingubo kaJosefa, bahlaba izinyane lembuzi, bacwilisa ingubo egazini;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.31",
            "verseOrgIds": [
              "GEN.37.31"
            ]
          }
        }
      ]
    },
