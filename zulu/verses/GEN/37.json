          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wozani manje simbulale, simphonse emgodini othile, sithi: ‘Udliwe yizilwane ezimbi, sibone ukuthi ayakuba yini ngamaphupho akhe.’",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.20",
            "verseOrgIds": [
              "GEN.37.20"
            ]
          }
        }
      ]
    },
    {
