          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "URubeni wakuzwa, wamsindisa esandleni sabo; wathi: “Masingambulali.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.21",
            "verseOrgIds": [
              "GEN.37.21"
            ]
          }
