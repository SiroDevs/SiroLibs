          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wozani simthengise kwabakwa-Ishmayeli, isandla sethu masingabi phezu kwakhe; ngokuba ungumfowethu nenyama yethu. Abafowabo basutha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.27",
            "verseOrgIds": [
              "GEN.37.27"
            ]
          }
        }
      ]
    },
