            "sid": "GEN 37:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wase ekwazi, wathi: “Le ingubo yendodana yami; isilo esibi samudla; Ngokungangabazeki, uJosefa wadwengulwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.33",
            "verseOrgIds": [
              "GEN.37.33"
            ]
          }
        }
      ]
    },
