          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "URubeni wabuyela emgodini; bheka, uJosefa wayengekho emthonjeni; waklebhula izingubo zakhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.29",
            "verseOrgIds": [
              "GEN.37.29"
            ]
