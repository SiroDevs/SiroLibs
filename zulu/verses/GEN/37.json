            "number": "32",
            "style": "v",
            "sid": "GEN 37:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayithumela ingubo enemibala, bayiyisa kuyise; yathi: “Siyitholile; yazi manje ukuthi iyisambatho sendodana yakho noma qha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.32",
            "verseOrgIds": [
              "GEN.37.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
