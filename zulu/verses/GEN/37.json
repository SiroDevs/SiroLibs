              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onke amadodana akhe nawo onke amadodakazi akhe asuka ukumduduza; kepha wala ukududuzwa; wathi: “Ngokuba ngiyakwehlela endaweni yabafileyo ngilila indodana yami.” Ngakho uyise wamkhalela.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.35",
            "verseOrgIds": [
              "GEN.37.35"
            ]
          }
        }
