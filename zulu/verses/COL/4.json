        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nisikhulekele nathi, ukuba uNkulunkulu asivulele umnyango wenkulumo, ukuba sikhulume imfihlakalo kaKristu, engiboshiwe ngenxa yayo;",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.3",
            "verseOrgIds": [
              "COL.4.3"
            ]
          }
        }
      ]
    },
    {
