            "sid": "COL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukukhuluma kwenu makube nomusa njalo, kuyolisiwe ngosawoti, ukuze nazi enifanele ukubaphendula ngakho bonke abantu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.6",
            "verseOrgIds": [
              "COL.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
