        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyakhonza kini uLuka, udokotela othandekayo, noDema.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.14",
            "verseOrgIds": [
              "COL.4.14"
            ]
          }
        }
      ]
    },
    {
