        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isibingelelo ngesandla sami mina Pawulu. Khumbulani izibopho zami. Umusa mawube nani. Amen. (Yabhalwa uThikhiku no-Onesimu isuka eRoma yaya kwabaseKolose.)",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.18",
            "verseOrgIds": [
              "COL.4.18"
            ]
          }
        }
      ]
