        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.10",
            "verseOrgIds": [
              "COL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "lapho kungekho khona umGreki nomJuda, ukusoka nokungasoki, owezizwe, umSkithe, isigqila noma okhululekile, kepha uKristu uyikho konke, ukubo bonke.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.11",
            "verseOrgIds": [
              "COL.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.11",
            "verseOrgIds": [
              "COL.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke njengabakhethiweyo bakaNkulunkulu, abangcwele nabathandekayo, yembathani izinhliziyo zesihe, umusa, ukuthobeka, ubumnene, nokubekezela;",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.12",
            "verseOrgIds": [
              "COL.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.12",
            "verseOrgIds": [
              "COL.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibekezelelana, nithethelelane, uma umuntu enensongo komunye;",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.13",
            "verseOrgIds": [
              "COL.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
