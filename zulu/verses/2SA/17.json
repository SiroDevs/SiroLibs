        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.23",
            "verseOrgIds": [
              "2SA.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasefika eMahanayimi. U-Abisalomu wadabula iJordani, yena nawo wonke amadoda akwa-Israyeli kanye naye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.24",
            "verseOrgIds": [
              "2SA.17.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.24",
            "verseOrgIds": [
              "2SA.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abisalomu wabeka u-Amasa induna yempi esikhundleni sikaJowabe; u-Amasa wayeyindodana yendoda egama layo linguJitra, umIsrayeli, owangena no-Abigayili indodakazi kaNahashi, udadewabo kaSeruya, unina kaJowabe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.25",
            "verseOrgIds": [
              "2SA.17.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
