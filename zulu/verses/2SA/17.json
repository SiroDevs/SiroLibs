          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.16",
            "verseOrgIds": [
              "2SA.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "OJonathani no-Ahimahasi bahlala e-Eni Rogeli; ngoba babengabonwa bengena emzini. Bahamba bayitshela inkosi uDavide.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.17",
            "verseOrgIds": [
              "2SA.17.17"
