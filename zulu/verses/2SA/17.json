            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lethani imibhede, nezitsha, nezimbiza zebumba, nokolweni, nebhali, nempuphu, nokolweni othosiwe, nobhontshisi, nodalili, namabele athosiweyo;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.28",
            "verseOrgIds": [
              "2SA.17.28"
            ]
          }
        }
      ]
    },
