          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abisalomu wayesethi: “Bizani noHushayi um-Ariki, sizwe ukuthi uthini nje.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.5",
            "verseOrgIds": [
              "2SA.17.5"
            ]
          }
        }
