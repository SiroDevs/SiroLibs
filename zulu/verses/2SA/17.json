          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho ngiyaluleka ukuba wonke u-Israyeli abuthane kuwe, kusukela kwaDani kuze kube seBeri Sheba, ngangesihlabathi esingasolwandle ngobuningi; nokuthi uziyele wena empini.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.11",
            "verseOrgIds": [
              "2SA.17.11"
            ]
          }
        }
