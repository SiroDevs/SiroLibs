          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke thumelani masinyane nitshele uDavide, nithi: ‘Ungalali emathafeni asehlane ngalobubusuku, kepha dabula masinyane; funa inkosi idliwe nabantu bonke abanayo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.16",
            "verseOrgIds": [
              "2SA.17.16"
            ]
          }
        }
      ]
    },
    {
