            "sid": "2SA 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha umfana wababona, watshela u-Abisalomu; kepha bashesha bobabili, bafika endlini yomuntu eBahurimi, owayenomthombo egcekeni lakhe; lapho behla khona.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.18",
            "verseOrgIds": [
              "2SA.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.18",
            "verseOrgIds": [
              "2SA.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesifazane wathatha isimbozo, wendlala umgodi womthombo, weneka ukolweni ogqunyiweyo phezu kwawo; necala lalingaziwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.19",
            "verseOrgIds": [
              "2SA.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.19",
            "verseOrgIds": [
              "2SA.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho izinceku zika-Abisalomu zifika kowesifazane endlini, zathi: “Baphi o-Ahimayo noJonathani na? Owesifazane wathi kubo: “Bawela umfula wamanzi.” Kwathi sebebafunile kodwa ababatholanga, babuyela eJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.20",
            "verseOrgIds": [
              "2SA.17.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.20",
            "verseOrgIds": [
              "2SA.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi sebesukile, bakhuphuka emthonjeni, baya babikela inkosi uDavida, bathi kuDavida: Sukuma uwele masinyane emanzini, ngoba uAhithofeli wenze icebo ngawe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.21",
            "verseOrgIds": [
              "2SA.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.21",
            "verseOrgIds": [
              "2SA.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngemva kwalokho uDavide waqeda kanye nawo wonke amadoda ayenaye, bawela iJordani;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.22",
            "verseOrgIds": [
              "2SA.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.22",
            "verseOrgIds": [
              "2SA.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Ahithofeli ebona ukuthi isiluleko sakhe asilandelwanga, wabophela imbongolo yakhe, wasuka, waya endlini yakhe emzini wakubo, wayala indlu yakhe, waziphanyeka, wafa, wembelwa ethuneni likayise.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.23",
            "verseOrgIds": [
              "2SA.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
