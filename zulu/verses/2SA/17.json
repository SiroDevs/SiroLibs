          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba, uHusayi wathi, wena uyamazi uyihlo labantu bakhe ukuthi bangamaqhawe, futhi bachothozekile ezinhliziyweni zabo njengebhere eliphucwe amawundlu alo egangeni; futhi uyihlo uyindoda yempi futhi akafuni ukulala nabantu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.8",
            "verseOrgIds": [
              "2SA.17.8"
            ]
          }
        }
      ]
