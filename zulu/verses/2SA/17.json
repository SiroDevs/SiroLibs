          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leli zwi lamjabulisa u-Abisalomu namalunga onke akwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.4",
            "verseOrgIds": [
