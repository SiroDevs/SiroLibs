            "verseOrgIds": [
              "2SA.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakubabuyisela kuwe bonke abantu; umuntu omfunayo unjengokungathi bonke babuyile; ngakho bonke abantu bazakuba nokuthula.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.3",
            "verseOrgIds": [
              "2SA.17.3"
            ]
          }
        }
