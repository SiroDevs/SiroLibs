          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.1",
            "verseOrgIds": [
              "2SA.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakumfikela ediniwe, ebuthakathaka isandla, ngimethuse; bonke abantu abanaye bayakubaleka; futhi ngizoyinqoba inkosi kuphela.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.2",
            "verseOrgIds": [
              "2SA.17.2"
            ]
          }
        }
      ]
    },
    {
