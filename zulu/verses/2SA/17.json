        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abisalomu nawo onke amadoda akwa-Israyeli bathi: “Iseluleko sikaHushayi um-Arki singcono kuneseluleko sika-Ahithofeli. Ngokuba uJehova wanquma ukuchitha iseluleko esihle sika-Ahithofeli, ngenjongo yokuthi uJehova uzomehlisela okubi u-Abisalomu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.14",
            "verseOrgIds": [
              "2SA.17.14"
            ]
          }
        }
      ]
    },
    {
