          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHushayi wayesethi kuSadoki naku-Abiyathara abapristi: “U-Ahithofeli weluleka kanje nakanje ku-Abisalomu namadoda amadala akwa-Israyeli; futhi nganikeza iseluleko.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.15",
            "verseOrgIds": [
              "2SA.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
