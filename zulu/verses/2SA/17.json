          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho siyakuhlangana naye endaweni lapho ayotholakala khona, futhi siyokwehlela phezu kwakhe njengamazolo ewela emhlabathini; futhi kuye nakuwo wonke amadoda akanye naye akuyikusala neyodwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.12",
            "verseOrgIds": [
              "2SA.17.12"
            ]
          }
        }
