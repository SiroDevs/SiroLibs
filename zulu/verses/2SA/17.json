            "sid": "2SA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi futhi indoda enesibindi enhliziyo yayo injengenhliziyo yengonyama, iyoncibilika ngokuphelele; ngoba wonke u-Israyeli uyazi ukuthi uyihlo uyiqhawe nokuthi labo abanaye bangamadoda anamandla.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.10",
            "verseOrgIds": [
              "2SA.17.10"
            ]
          }
        }
      ]
