          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nezinyosi nebhotela nezimvu noshizi ezinkomo zikaDavide nabantu ababe naye ukuba badle; ngoba bathi: Abantu balambile, badiniwe, bomile enkangala.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.29",
            "verseOrgIds": [
              "2SA.17.29"
