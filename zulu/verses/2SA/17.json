          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHushayi esefikile ku-Abisalomu, u-Abisalomu wakhuluma kuye, wathi: “U-Ahithofeli ukhulume kanje; kufanele senze ngokwezwi lakhe na? Uma kungenjalo; uyakhuluma.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.6",
            "verseOrgIds": [
              "2SA.17.6"
            ]
          }
