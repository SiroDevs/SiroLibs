          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphezu kwalokho, uma efike emzini, wonke u-Israyeli kumelwe alethe izindophi kulowo muzi, sizidonsele emfuleni kuze kungatholakali nelilodwa itshe elincane.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.13",
            "verseOrgIds": [
              "2SA.17.13"
            ]
          }
        }
