          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHusayi wathi ku-Abisalomu: “Iseluleko sika-Ahithofeli asisihle ngalesi sikhathi.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.7",
            "verseOrgIds": [
              "2SA.17.7"
            ]
