          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhekani, manje ucashile komunye umgodi noma kwenye indawo; uma abanye kubo beketulwa kuqala, yilowo nalowo ozwayo uyakuthi: ‘Kukhona ukubulalana phakathi kwabantu abalandela u-Abisalomu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.9",
            "verseOrgIds": [
              "2SA.17.9"
            ]
          }
        }
