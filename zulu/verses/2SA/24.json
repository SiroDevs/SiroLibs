              "2SA.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yasisithi kuArawuna: Hatshi! kodwa ngiyakusithenga kuwe ngentengo; ngiyakunikela kuJehova uNkulunkulu wami iminikelo yokushiswa engeyize. UDavide wathenga isibuya nezinkabi ngamashekeli angamashumi ayisihlanu esiliva.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.24",
            "verseOrgIds": [
              "2SA.24.24"
            ]
          }
        }
