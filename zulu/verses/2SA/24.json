          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Arawuna wasesithi: Kungani inkosi yami, inkosi, ize encekwini yayo? UDavide wathi: “Ukuzithengela isibuya, ukwakhela uJehova i-altare, ukuze inhlupheko yabantu inqanyulwe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.21",
            "verseOrgIds": [
              "2SA.24.21"
            ]
          }
        }
