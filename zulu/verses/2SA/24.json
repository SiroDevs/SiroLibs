          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Arawuna wayesethi kuDavide: “Inkosi yami, inkosi, mayithathe, ihlabele okuhle kuyo; bheka, nazi izinkabi zomnikelo wokushiswa, nezibhulo nezinye izinto zezinkabi zibe yizinkuni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.22",
            "verseOrgIds": [
              "2SA.24.22"
            ]
          }
        }
