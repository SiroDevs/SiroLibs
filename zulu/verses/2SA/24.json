          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wenyuka njengezwi likaGadi, njengalokho uJehova emyalile.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.19",
