          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Arawuna wabheka, wabona inkosi nezinceku zayo beza kuye; u-Arawuna waphuma wakhothama phambi kwenkosi ubuso bakhe bubheke phansi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.20",
            "verseOrgIds": [
              "2SA.24.20"
            ]
