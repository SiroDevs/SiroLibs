          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke lezi zinto u-Arawuna inkosi wazinika inkosi. U-Arawuna wayesethi enkosini: “UJehova uNkulunkulu wakho ukwamukele;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.23",
            "verseOrgIds": [
              "2SA.24.23"
            ]
          }
        }
