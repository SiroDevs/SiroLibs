              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umlindi wamemeza watshela inkosi. Inkosi yasisithi: Lapho eyedwa, ulolizwi emlonyeni wakhe. Futhi washesha wasondela.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.25",
