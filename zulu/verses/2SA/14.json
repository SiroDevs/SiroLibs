            "style": "v",
            "sid": "2SA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.21",
            "verseOrgIds": [
              "2SA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJowabe wayesewa ngobuso emhlabathini, wakhothama, wabonga inkosi; uJowabe wathi: “Namuhla inceku yakho iyazi ukuthi ngifumene umusa emehlweni akho, nkosi yami, nkosi, ngesicelo senkosi senceku yayo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.22",
            "verseOrgIds": [
              "2SA.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
