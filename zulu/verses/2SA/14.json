            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yasiphendula yathi kowesifazana: Ungangifihleli engikubuzayo. Owesifazane wathi: “Inkosi yami, inkosi, mayikhulume.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.18",
            "verseOrgIds": [
              "2SA.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
