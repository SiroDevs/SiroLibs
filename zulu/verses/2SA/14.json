          "type": "text",
          "attrs": {
            "verseId": "2SA.14.26",
            "verseOrgIds": [
              "2SA.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abisalomu wazalelwa amadodana amathathu nendodakazi inye, igama layo linguTamari; wayengowesifazane owayenokuma okuhle.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.27",
            "verseOrgIds": [
              "2SA.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.27",
            "verseOrgIds": [
              "2SA.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abisalomu wahlala eJerusalema iminyaka emibili egcwele, engabuboni ubuso benkosi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.28",
            "verseOrgIds": [
              "2SA.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
