              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.28",
            "verseOrgIds": [
              "2SA.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abisalomu wayesethumela kuJowabe ukuba amthumele enkosini; kepha akavumanga ukuza kuye; kwathi ephinda ethuma okwesibili, kavumanga ukuza.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.29",
            "verseOrgIds": [
              "2SA.14.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
