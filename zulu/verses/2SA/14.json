          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.20",
            "verseOrgIds": [
              "2SA.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yathi kuJowabe: “Bheka, ngikwenzile lokho; hamba, ubuyise insizwa u-Abisalomu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.21",
            "verseOrgIds": [
              "2SA.14.21"
            ]
          }
        }
      ]
