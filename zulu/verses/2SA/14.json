              "2SA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yasisithi: Isandla sikaJowabi kasilawe yini kukho konke lokhu? Owesifazana waphendula wathi: Kusaphila umphefumulo wakho, nkosi yami, nkosi, kakulamuntu ongaphambukela ngakwesokunene langakwesokhohlo kukho konke inkosi yami, inkosi ekukhulumileyo; ngoba inceku yakho uJowabe ingilayile, lamazwi wonke asemlonyeni wenceku yakho.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.19",
            "verseOrgIds": [
              "2SA.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
