          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inceku yakho uJowabe yenza le nto ukuze ilingise le ndlela; futhi inkosi yami ihlakaniphe njengokuhlakanipha kwengelosi kaNkulunkulu, ukwazi konke okusemhlabeni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.20",
            "verseOrgIds": [
              "2SA.14.20"
            ]
          }
        }
      ]
    },
    {
