          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.19",
            "verseOrgIds": [
              "2SA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
