          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona kuyakwambulwa lowo omubi, iNkosi eyakumqeda ngomoya womlomo wayo, imbhubhise ngokubonakala kokufika kwayo;",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.8",
