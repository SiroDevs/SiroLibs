              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anikhumbuli yini ukuthi ngisenani nganitshela lokho na?",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.5",
            "verseOrgIds": [
              "2TH.2.5"
            ]
          }
        }
