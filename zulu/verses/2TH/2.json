          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena lowo ukufika kwakhe kungokokusebenza kukaSathane ngawo wonke amandla, nezibonakaliso, nezimangaliso zamanga;",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.9",
            "verseOrgIds": [
              "2TH.2.9"
