            "sid": "2TH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omeleneyo oziphakamisayo phezu kwakho konke okuthiwa nguNkulunkulu, nokukhonzwayo; kangangokuthi yena njengoNkulunkulu uhlala ethempelini likaNkulunkulu, ezibonisa ukuthi unguNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.4",
            "verseOrgIds": [
              "2TH.2.4"
            ]
          }
        }
      ]
    },
