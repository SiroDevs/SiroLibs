              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha thina simelwe ukubonga njalo kuNkulunkulu ngani, bazalwane abathandwa yiNkosi, ngokuba kwasekuqaleni uNkulunkulu wanikhethela ukusindiswa ngokungcweliswa kukaMoya nangokukholwa yiqiniso;",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.13",
            "verseOrgIds": [
              "2TH.2.13"
            ]
          }
