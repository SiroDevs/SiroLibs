        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.1",
            "verseOrgIds": [
              "2TH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuze ningasheshi unyakaziswe engqondweni, noma nethuswe, noma ngomoya, noma ngezwi, noma ngencwadi ngokungathi ivela kithi, ngokungathi usuku lukaKristu selusondele.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.2",
            "verseOrgIds": [
              "2TH.2.2"
            ]
          }
        }
      ]
    },
