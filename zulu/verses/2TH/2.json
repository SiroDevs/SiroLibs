          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nangayo yonke inkohliso yokungalungi kwababhubhayo; ngoba kabamukelanga uthando lweqiniso, ukuze basindiswe.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.10",
