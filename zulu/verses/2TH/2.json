          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje siyanincenga, bazalwane, ngokufika kweNkosi yethu uJesu Kristu nangokubuthana kwethu kuyo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.1",
            "verseOrgIds": [
              "2TH.2.1"
            ]
          }
        }
      ]
    },
    {
