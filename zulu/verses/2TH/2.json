            "sid": "2TH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maningadukiswa muntu nangayiphi indlela, ngokuba lolo suku aluyikufika, ngaphandle kokuthi kufike ukuhlubuka kuqala, ambulwe lowo muntu wesono, indodana yokulahlwa;",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.3",
            "verseOrgIds": [
              "2TH.2.3"
            ]
          }
        }
      ]
    },
    {
