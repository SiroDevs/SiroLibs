          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "bangalaleli izinganekwane zamaJuda, nemiyalo yabantu abafulathela iqiniso.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.14",
            "verseOrgIds": [
              "TIT.1.14"
            ]
