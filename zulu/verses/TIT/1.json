          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lobu bufakazi buqinisile. Ngakho-ke ubakhuze kabukhali, ukuze baphile ekukholweni;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.13",
            "verseOrgIds": [
              "TIT.1.13"
            ]
          }
        }
