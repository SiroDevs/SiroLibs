        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.6",
            "verseOrgIds": [
              "TIT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba umbonisi umelwe ukuba ngongasolekiyo, njengomphathi kaNkulunkulu; ongesiye othanda ubugovu, ongasheshi ukuthukuthela, ongadakwa, ongashayi, ongesiye inzuzo embi;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.7",
            "verseOrgIds": [
              "TIT.1.7"
            ]
          }
        }
      ]
    },
    {
