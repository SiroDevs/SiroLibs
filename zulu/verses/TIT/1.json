          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunye wabo, umprofethi wakubo, wathi: AmaKrethe ahlala eqamba amanga, izilwane ezimbi, izisu ezimnene.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.12",
            "verseOrgIds": [
              "TIT.1.12"
            ]
          }
        }
