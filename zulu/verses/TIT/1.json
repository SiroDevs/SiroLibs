          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebambelele ezwini elithembekileyo njengalokho efundisiwe, ukuze abe-namandla okuyala ngesifundiso esiphilileyo, nokuqinisekisa abaphikayo.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.9",
            "verseOrgIds": [
              "TIT.1.9"
            ]
          }
        }
