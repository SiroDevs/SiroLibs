          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwabahlanzekile konke kuhlanzekile, kodwa kwabangcolileyo nabangakholwayo akukho okuhlanzekileyo; kodwa ngisho ingqondo nonembeza wabo kungcolile.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.15",
            "verseOrgIds": [
              "TIT.1.15"
            ]
          }
        }
