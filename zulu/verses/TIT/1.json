          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "abamelwe ukuvalwa umlomo, abachitha izindlu ziphela, befundisa okungafanele ngenxa yenzuzo embi.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.11",
            "verseOrgIds": [
              "TIT.1.11"
