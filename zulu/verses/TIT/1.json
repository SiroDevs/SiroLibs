          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bavuma ukuthi bayamazi uNkulunkulu; kodwa bayamphika ngemisebenzi, benengekayo, nabangalaleliyo, nakuyo yonke imisebenzi emihle bengaboshiwe.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.16",
