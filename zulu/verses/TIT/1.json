          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ophatha kuhle izihambi, othanda okuhle, ozithibileyo, olungileyo, ongcwele, ozithibileyo;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.8",
            "verseOrgIds": [
              "TIT.1.8"
            ]
          }
        }
      ]
    },
