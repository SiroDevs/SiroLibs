          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokho uyakusindiswa ngokuzala abantwana, uma behlala ekukholweni nasothandweni nasebungcweleni kanye nokuqonda.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.15",
            "verseOrgIds": [
