          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.16",
            "verseOrgIds": [
              "1TI.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yala abanothileyo kulomhlaba ukuthi bangazikhukhumezi, bangathembeli engcebweni engaqinisekile, kodwa mabathembele kuNkulunkulu osinika ngokucebile konke ukuba sikujabulele;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.17",
            "verseOrgIds": [
              "1TI.6.17"
            ]
          }
        }
      ]
    },
