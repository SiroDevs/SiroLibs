          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uqalekisiwe osusa umkhawulo womakhelwane wakhe; Futhi bonke abantu kumelwe bathi: Amen!",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.17",
            "verseOrgIds": [
              "DEU.27.17"
            ]
          }
        }
