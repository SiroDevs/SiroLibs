          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.28",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinto ezifihliweyo zingezikaJehova uNkulunkulu wethu, kodwa izinto ezembuliwe zingezethu nabantwana bethu kuze kube phakade, ukuze senze wonke amazwi alo mthetho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.29",
            "verseOrgIds": [
              "DEU.29.29"
            ]
          }
        }
      ]
