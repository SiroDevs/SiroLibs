        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuze kungabikho phakathi kwenu owesilisa, noma owesifazane, noma umndeni, noma isizwe esinhliziyo yaso iphambukela kuJehova namuhla ukuba ahambe akhonze onkulunkulu balezi zizwe; ukuze kungabikho mpande ezala inyongo nenyongo;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.18",
            "verseOrgIds": [
              "DEU.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.18",
            "verseOrgIds": [
              "DEU.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi lapho ezwa amazwi alesi siqalekiso, azibusise enhliziyweni yakhe futhi athi: Ngiyoba nokuthula, noma ngihamba ngenkambiso yenhliziyo yami, ukuze ngengeze ukudakwa ekomeni.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.19",
            "verseOrgIds": [
              "DEU.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.19",
            "verseOrgIds": [
              "DEU.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova akayikumhawukela, kepha lapho intukuthelo kaJehova nokushisekela kwakhe kuyakushunqa kulowo muntu, zibe phezu kwakhe zonke iziqalekiso ezilotshwe kule ncwadi, uJehova alibize igama lakhe phansi kwezulu, azesule.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.20",
            "verseOrgIds": [
              "DEU.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.20",
            "verseOrgIds": [
              "DEU.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova uyakumahlukanisela okubi kuzo zonke izizwe zakwa-Israyeli njengazo zonke iziqalekiso zesivumelwano ezilotshwe kule ncwadi yomthetho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.21",
            "verseOrgIds": [
              "DEU.29.21"
            ]
          }
        }
      ]
    },
    {
