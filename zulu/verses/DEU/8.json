          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona inhliziyo yakho iziphakamisile, ukhohlwe uJehova uNkulunkulu wakho owakukhipha ezweni laseGibithe, endlini yobugqila;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.14",
            "verseOrgIds": [
              "DEU.8.14"
            ]
          }
        }
      ]
    },
