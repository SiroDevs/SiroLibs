        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.11",
            "verseOrgIds": [
              "DEU.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhekani, nxa senidlile, nasutha, nakha izindlu ezinhle, nihlale kuzo;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.12",
            "verseOrgIds": [
              "DEU.8.12"
            ]
          }
        }
      ]
    },
    {
