          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "owakupha ehlane imana oyihlo ababengayazi, ukuba akuthobise, akuvivinye, akwenzele okuhle ekupheleni kwakho;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.16",
            "verseOrgIds": [
              "DEU.8.16"
