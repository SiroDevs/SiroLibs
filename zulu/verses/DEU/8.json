          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "owanihola ogwadule olukhulu nolwesabekayo, okwakukhona kulo izinyoka ezinomlilo nawofezela nesomiso, lapho kwakungekho manzi khona; owanikhiphela amanzi edwaleni;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.15",
            "verseOrgIds": [
              "DEU.8.15"
            ]
          }
        }
