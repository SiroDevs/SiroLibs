          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinsuku eziyisikhombisa uyakugcina umkhosi wokudumisa uJehova uNkulunkulu wakho endaweni uJehova ayakuyikhetha, ngokuba uJehova uNkulunkulu wakho uyakukubusisa kuzo zonke izithelo zakho nasemsebenzini wonke wezandla zakho; jabulani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
