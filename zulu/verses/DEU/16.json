        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.2",
            "verseOrgIds": [
              "DEU.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungadli isinkwa esivutshelweyo kanye nayo; izinsuku eziyisikhombisa uyakudla isinkwa esingenamvubelo kanye nalo, isinkwa sosizi; ngoba waphuma ngokushesha ezweni laseGibhithe ukuze ukhumbule usuku owaphuma ngalo ezweni laseGibhithe zonke izinsuku zokuphila kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.3",
            "verseOrgIds": [
              "DEU.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.3",
            "verseOrgIds": [
              "DEU.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinsuku eziyisikhombisa akuyikubonwa imvubelo kuwe emikhawulweni yakho yonke; futhi akuyikusala lutho lwenyama oyihlabile kusihlwa ngosuku lokuqala kuze kube sekuseni.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.4",
            "verseOrgIds": [
              "DEU.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.4",
            "verseOrgIds": [
              "DEU.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungalihlabeli iphasika kuwo wonke amasango akho uJehova uNkulunkulu wakho akunika wona.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.5",
            "verseOrgIds": [
              "DEU.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
