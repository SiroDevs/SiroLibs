            "sid": "DEU 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinsuku eziyisikhombisa kumelwe nigubhe umkhosi wamadokodo ngemva kokubutha ukolweni namakhoba akho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.13",
            "verseOrgIds": [
              "DEU.16.13"
            ]
          }
        }
      ]
    },
    {
