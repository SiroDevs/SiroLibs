          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kathathu ngomnyaka bonke abesilisa bakho bayakubonakala phambi kukaJehova uNkulunkulu wakho endaweni ayakuyikhetha; ngomkhosi wesinkwa esingenamvubelo, nangomkhosi wamasonto, nangomkhosi wamadokodo; bangabonakali phambi kukaJehova bengenalutho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        }
      ]
    },
