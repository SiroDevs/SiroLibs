          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakuthokoza edilini lakho, wena lendodana yakho lendodakazi yakho lenceku yakho lencekukazi yakho lomLevi, umfokazi lentandane lomfelokazi abaphakathi kwamasango akho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.14",
            "verseOrgIds": [
              "DEU.16.14"
            ]
          }
        }
      ]
    },
