          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uthokoze phambi kukaJehova uNkulunkulu wakho, wena nendodana yakho, nendodakazi yakho, nenceku yakho, nencekukazi yakho, nomLevi osemasangweni akho, nomfokazi, nentandane, nomfelokazi ophakathi kwakho kuleyo ndawo. UJehova uNkulunkulu wakho ayikhethileyo ukumisa igama layo khona.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
