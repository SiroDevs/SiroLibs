        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.14",
            "verseOrgIds": [
              "DEU.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba isandla sikaJehova impela sasimelene nabo ukubachitha empini baze baqedwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.15",
            "verseOrgIds": [
              "DEU.2.15"
            ]
          }
        }
      ]
    },
