          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.11",
            "verseOrgIds": [
              "DEU.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaHori ahlala eSeyiri kuqala; kepha abantwana bakwa-Esawu babalandela, babachitha phambi kwabo, bahamba bahlala endaweni yabo; njengalokho u-Israyeli enza ezweni lefa lakhe uJehova abanika lona.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.12",
            "verseOrgIds": [
              "DEU.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
