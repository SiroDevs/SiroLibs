          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sase siphenduka, samuka saya ehlane endleleni yaseShelfsee, njengokukhuluma kukaJehova kimi; sazungeza intaba yaseSeyiri izinsuku eziningi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.1",
            "verseOrgIds": [
              "DEU.2.1"
            ]
          }
        }
      ]
    },
