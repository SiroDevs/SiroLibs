          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho onke amaqhawe esephelile, efa phakathi kwabantu;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.16",
            "verseOrgIds": [
