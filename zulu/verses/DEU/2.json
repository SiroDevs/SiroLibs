          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.12",
            "verseOrgIds": [
              "DEU.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sukumani manje, niwele umfula iSeredi; Futhi sawela umfudlana iSeredi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.13",
            "verseOrgIds": [
              "DEU.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 2:13"
