            "number": "3",
            "style": "v",
            "sid": "DEU 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sekuyisikhathi eside niyizungeza le ntaba; jikelani enyakatho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.3",
            "verseOrgIds": [
              "DEU.2.3"
            ]
          }
        }
      ]
    },
    {
