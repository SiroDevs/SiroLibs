            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wakhuluma kimi, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.2",
            "verseOrgIds": [
              "DEU.2.2"
            ]
          }
        }
