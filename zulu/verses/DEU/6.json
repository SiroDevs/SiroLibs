          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nezindlu ezigcwele zonke izinto ezinhle ongazigcwalisanga, nemithombo eningayimbanga, izivini neminqumo eningayitshalanga; uma udla usuthe;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.11",
            "verseOrgIds": [
              "DEU.6.11"
            ]
