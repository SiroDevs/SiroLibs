            "number": "7",
            "style": "v",
            "sid": "DEU 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe ulifundise ngenkuthalo abantwana bakho futhi ukhulume ngalo lapho uhlezi endlini yakho nalapho uhamba endleleni nalapho ulala nalapho uvuka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.7",
            "verseOrgIds": [
              "DEU.6.7"
            ]
          }
        }
      ]
    },
    {
