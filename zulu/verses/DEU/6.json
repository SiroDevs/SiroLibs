          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyakuthi lapho uJehova uNkulunkulu wakho esekungenise ezweni alifungela oyihlo, ku-Abrahama, no-Isaka, noJakobe, ukukunika imizi emikhulu nemihle ongayakhanga,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.10",
            "verseOrgIds": [
              "DEU.6.10"
            ]
          }
        }
      ]
    },
