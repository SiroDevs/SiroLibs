        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wakhuphuka emathafeni akwaMowabi, waya entabeni yaseNebo esiqongweni sasePisiga esibhekene neJeriko. UJehova wambonisa lonke izwe lakwaGileyadi kwaDani;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.1",
            "verseOrgIds": [
              "DEU.34.1"
            ]
          }
        }
      ]
    },
    {
