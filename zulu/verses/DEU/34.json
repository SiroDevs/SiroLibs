          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nangaso sonke leso sandla esinamandla nakukho konke ukwesabeka okukhulu uMose akubonisayo phambi kwamehlo ka-Israyeli wonke.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.12",
