          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wezwa izwi lamazwi enu ekukhulumeni kwenu kimi; uJehova wathi kimi: “Ngiwezwile amazwi alaba bantu abawakhulume kuwe; bakhuluma kahle kukho konke ababekukhuluma.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.28",
            "verseOrgIds": [
              "DEU.5.28"
            ]
          }
        }
      ]
    },
