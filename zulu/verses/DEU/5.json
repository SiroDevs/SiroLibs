              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamba uthi kubo: Buyelani emathenteni enu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.30",
            "verseOrgIds": [
              "DEU.5.30"
            ]
          }
        }
      ]
    },
