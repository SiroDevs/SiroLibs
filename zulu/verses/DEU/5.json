            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe nihambe ngazo zonke izindlela uJehova uNkulunkulu wenu aniyale ngazo, ukuze niphile, niphumelele futhi nibe nezinsuku eziningi ezweni eniyakulidla.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.33",
            "verseOrgIds": [
