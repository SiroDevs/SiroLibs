          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yazisa uyihlo nonyoko, njengalokho uJehova uNkulunkulu wakho ekuyalile; ukuze izinsuku zakho zibe zinde futhi kukuhambele kahle ezweni uJehova uNkulunkulu wakho akunika lona.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.16",
            "verseOrgIds": [
              "DEU.5.16"
            ]
          }
        }
      ]
