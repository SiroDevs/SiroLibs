          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho lizakwenza lokunanzelela njengokukulaya kukaJehova uNkulunkulu wakho: lingaphambukeli ngakwesokunene loba kwesokhohlo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.32",
            "verseOrgIds": [
              "DEU.5.32"
            ]
          }
        }
      ]
    },
