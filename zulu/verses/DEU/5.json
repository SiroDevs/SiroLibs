          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khumbula ukuthi wawuyinceku ezweni laseGibithe nokuthi uJehova uNkulunkulu wakho wakukhipha kulo ngesandla esinamandla nangengalo eyeluliweyo; ngalokho uJehova uNkulunkulu wakho wakuyala ukuba ugcine usuku lwesabatha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        }
      ]
    },
