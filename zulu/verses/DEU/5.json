          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawa mazwi uJehova wawakhuluma ngezwi elikhulu ebandleni lenu lonke entabeni, phakathi komlilo, nefu, nasebumnyameni; futhi Akanezelanga lutho. Waliloba ezibhebheni ezimbili zamatshe, wanginika lona.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.22",
            "verseOrgIds": [
              "DEU.5.22"
            ]
          }
        }
