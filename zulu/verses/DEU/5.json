          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha wena, yima lapha nami, futhi ngiyakukhuluma kuwe yonke imiyalo, nezimiso, nezahlulelo oyakubafundisa zona, ukuze bakwenze ezweni engibanika lona ukuba balidle.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.31",
            "verseOrgIds": [
              "DEU.5.31"
            ]
          }
        }
      ]
    },
    {
