            "sid": "DEU 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "O, uma kwakukhona kubo inhliziyo enjalo ukuba bangesabe, bagcine yonke imiyalo yami kuze kube phakade, ukuze kube kuhle kubo nakubantwana babo kuze kube phakade!",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.29",
            "verseOrgIds": [
              "DEU.5.29"
            ]
          }
        }
      ]
    },
