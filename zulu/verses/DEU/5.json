              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngubani enyameni yonke owezwa ilizwi likaNkulunkulu ophilayo likhuluma livela emlilweni njengathi, waphila?",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.26",
            "verseOrgIds": [
              "DEU.5.26"
            ]
          }
        }
      ]
