          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha usuku lwesikhombisa luyisabatha likaJehova uNkulunkulu wakho; ungenzi msebenzi ngalo, wena nendodana yakho, nendodakazi yakho, nenceku yakho, nencekukazi yakho, nenkabi yakho, nembongolo yakho, nezinkomo zakho, nomfokazi wakho ophakathi kwamasango akho; ukuze inceku yakho nencekukazi yakho baphumule njengawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
