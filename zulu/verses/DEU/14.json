          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nazi izilwane eniyakuzidla: Inkomo, imvu, nembuzi,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.4",
            "verseOrgIds": [
              "DEU.14.4"
            ]
          }
        }
