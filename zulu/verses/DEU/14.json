          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe ukhiphe leyo mali kukho konke umphefumulo wakho okufisayo, ngezinkomo noma ngezinkomo noma ngewayini noma ngophuzo olunamandla noma kukho konke umphefumulo wakho okufisayo; udle khona phambi kukaJehova uNkulunkulu wakho, ujabule, wena nendlu yakho;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
