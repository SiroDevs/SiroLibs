          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyakudla okweshumi kukakolweni wakho, nokwewayini lakho, nokwamafutha akho, namazibulo ezinkomo zakho, nawezimvu zakho, phambi kukaJehova uNkulunkulu wakho endaweni ayakuyikhetha ukumisa igama lakhe kuyo; ukuze ufunde ukumesaba uJehova uNkulunkulu wakho njalo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.23",
            "verseOrgIds": [
              "DEU.14.23"
            ]
          }
        }
