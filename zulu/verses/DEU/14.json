        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.6",
            "verseOrgIds": [
              "DEU.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa aniyikukudla kwezetshisayo, lezidabula izinzipho; njengekamela nonogwaja kanye nesigaxa; ngokuba ziyetshisa, kepha azihlukanisi izinzipho; ngalokho zingcolile kini.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.7",
            "verseOrgIds": [
              "DEU.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
