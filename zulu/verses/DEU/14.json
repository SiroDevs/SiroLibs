              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekupheleni kweminyaka emithathu kumelwe ukhiphe konke okweshumi kwenzuzo yakho ngawo lowo nyaka ukulahle emasangweni akho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.28",
            "verseOrgIds": [
