          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma indlela iyinde kakhulu, nize ningakwazi ukuyithwala; noma indawo ikude nawe uJehova uNkulunkulu wakho ayakuyikhetha ukumisa igama lakhe kuyo, lapho uJehova uNkulunkulu wakho ekubusisile;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
