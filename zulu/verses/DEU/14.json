            "sid": "DEU 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke izilwane ezidabula izinzipho nezihlukanisa uzipho zibe yizinzipho ezimbili, ezetshisayo phakathi kwezilwane, ningazidla.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.6",
            "verseOrgIds": [
              "DEU.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
