          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningabantwana beNkosi uNkulunkulu wenu; akumelwe nizinqume futhi ningenzi mpandla phakathi kwamehlo akho ngenxa yofileyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        }
      ]
    },
    {
