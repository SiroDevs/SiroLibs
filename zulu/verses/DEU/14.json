          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe uyishintshe ibe yimali, ubophe imali esandleni sakho, uye endaweni uJehova uNkulunkulu wakho ayoyikhetha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.25",
            "verseOrgIds": [
              "DEU.14.25"
            ]
