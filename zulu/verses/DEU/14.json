              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe ukhiphe okweshumi kuyo yonke imbewu yakho ekhiqizwa izwe unyaka nonyaka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.22",
