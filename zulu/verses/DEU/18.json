              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi kuyokwenzeka ukuthi noma ngubani ongawalaleli amazwi ami ayowakhuluma egameni lami, ngizowafuna kuye.",
          "type": "text",
          "attrs": {
