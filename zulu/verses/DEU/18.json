          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wathi kimi: “Bakhulume kahle abakukhulumile.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.17",
            "verseOrgIds": [
              "DEU.18.17"
            ]
          }
        }
      ]
