            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.15",
            "verseOrgIds": [
              "DEU.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengakho konke owakufisayo ngosuku lwenhlangano yeNkosi uNkulunkulu wakho eHorebe ngokuthi: Mangingabuye ngizwe izwi likaJehova uNkulunkulu wami, futhi ngingabe ngisawubona lo mlilo omkhulu, Angifi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.16",
            "verseOrgIds": [
              "DEU.18.16"
            ]
          }
        }
      ]
    },
