            "sid": "DEU 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakwaRubeni nabakwaGadi ngabanika ingxenye yesigodi kusukela kwaGileyadi kuze kufike emfuleni i-Arinoni, nomngcele kuze kufike emfuleni iJabhoki, ongumngcele wabantwana bakwa-Amoni;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.16",
            "verseOrgIds": [
              "DEU.3.16"
            ]
          }
        }
      ]
    },
    {
