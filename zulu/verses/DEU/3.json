          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.13",
            "verseOrgIds": [
              "DEU.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJayire indodana kaManase walithatha lonke izwe lase-Arigobi kuze kube semkhawulweni wamaGesuri neMahagati; wawabiza ngegama lakhe ngokuthi iBashani Havoti-Jayire kuze kube namuhla.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.14",
            "verseOrgIds": [
              "DEU.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
