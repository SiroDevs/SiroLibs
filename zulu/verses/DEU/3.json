          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "IGileyadi ngalinika iMagiri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.15",
            "verseOrgIds": [
              "DEU.3.15"
            ]
          }
        }
