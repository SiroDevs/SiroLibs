          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nethafa neJordani nomkhawulo walo, kusukela eKinereti kuze kube selwandle lwasemathafeni, uLwandle Lukasawoti, phansi kwe-Ashidodi nePhisiga ngasempumalanga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.17",
            "verseOrgIds": [
              "DEU.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
