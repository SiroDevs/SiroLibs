        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.16",
            "verseOrgIds": [
              "DEU.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
