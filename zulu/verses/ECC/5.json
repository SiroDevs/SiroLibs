            "style": "v",
            "sid": "ECC 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.14",
            "verseOrgIds": [
              "ECC.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekuphumeni kwakhe esizalweni sikanina uyakubuya ahambe ze njengokufika kwakhe, angathathi lutho emshikashikeni wakhe angayiphatha ngesandla sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.15",
            "verseOrgIds": [
              "ECC.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
