          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "isikhathi sokulahla amatshe nesikhathi sokuqoqa amatshe; isikhathi sokugona, nesikhathi sokuyeka ukugona;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.5",
            "verseOrgIds": [
              "ECC.3.5"
            ]
          }
        }
