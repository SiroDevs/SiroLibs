        },
        {
          "text": "Ngathi enhliziyweni yami mayelana nesimo sabantwana babantu, ukuthi uNkulunkulu angabambula futhi babone ukuthi bayizilwane.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.18",
            "verseOrgIds": [
              "ECC.3.18"
            ]
          }
        }
