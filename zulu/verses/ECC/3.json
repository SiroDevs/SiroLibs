          ]
        },
        {
          "text": "Konke kunesikhathi nesikhathi sayo yonke into phansi kwezulu:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.1",
            "verseOrgIds": [
              "ECC.3.1"
