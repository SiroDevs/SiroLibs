          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "isikhathi sokuklebhula nesikhathi sokuthunga; isikhathi sokuthula nesikhathi sokukhuluma;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.7",
            "verseOrgIds": [
              "ECC.3.7"
            ]
