          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha okweshumi kwezinkomo noma kwezinkomo, kukho konke okudlula phansi kodondolo, okweshumi kuyakuba ngcwele kuJehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.32",
            "verseOrgIds": [
              "LEV.27.32"
            ]
          }
        }
