          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma engcwelisa isiqephu sezwe sakhe kusukela ngomnyaka wejubili, siyakuhlala simi njengokulinganisa kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.17",
            "verseOrgIds": [
              "LEV.27.17"
            ]
          }
        }
      ]
