          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi konke okweshumi kwezwe, okwembewu yezwe noma okwesithelo somuthi, kungokukaJehova; kungcwele kuJehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        }
      ]
    },
