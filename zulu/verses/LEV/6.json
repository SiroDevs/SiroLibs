              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi onikela ngawo ngenxa yesono uyakuwudla; uyakudliwa endaweni engcwele egcekeni letende lokuhlangana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.26",
