          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakulowo ogulayo ngenxa yokungcola kwakhe, nakocucuzayo, endodeni, nakowesifazane, nakulowo olala nongcolile.",
          "type": "text",
          "attrs": {
