          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Uma owesifazane ecucuza igazi lakhe izinsuku eziningi kusukela esikhathini sokungcola kwakhe, noma lidlula isikhathi sokungcola kwakhe, zonke izinsuku zokugobhoza kokungcola kwakhe ziyakuba njengezinsuku zokungcola kwakhe; uyakuba ngongcolile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.25",
            "verseOrgIds": [
              "LEV.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
