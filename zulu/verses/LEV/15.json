          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonke imibhede alala kuyo zonke izinsuku zokucucuza kwakhe iyakuba kuye njengombhede wokungcola kwakhe; futhi konke ahlala kukho kuyoba okungcolile njengokungcola kokungcola kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.26",
            "verseOrgIds": [
              "LEV.15.26"
            ]
          }
        }
      ]
    },
