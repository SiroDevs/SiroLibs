          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lona ngumthetho walowo onomopho, nowokuzalwa kwakhe okuphuma kuye, angcoliswe ngakho;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.32",
            "verseOrgIds": [
              "LEV.15.32"
            ]
          }
        }
      ]
