          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konke alala kukho ekungcoleni kwakhe kuyakuba ngokungcolile; nakho konke ahlala kukho kuyakuba ngokungcolile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.20",
            "verseOrgIds": [
