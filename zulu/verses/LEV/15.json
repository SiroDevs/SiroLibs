              "type": "text"
            }
          ]
        },
        {
          "text": "Nowesifazane indoda elale naye, bobabili kumelwe bageze ngamanzi futhi babe abangcolile kuze kuhlwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.18",
            "verseOrgIds": [
              "LEV.15.18"
            ]
          }
        }
      ]
    },
    {
