          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma kuphezu kombhede wakhe noma nakunoma yini ahlala kuyo, uma eyithinta, uyakuba ngongcolile kuze kuhlwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.23",
