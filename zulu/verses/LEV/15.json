            "sid": "LEV 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilowo nalowo othinta noma yini ahlezi phezu kwayo uyakuhlanza izingubo zakhe, ageze ngamanzi, abe ngongcolile kuze kuhlwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.22",
