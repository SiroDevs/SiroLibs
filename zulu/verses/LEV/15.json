          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma umuntu elala naye, ukungcola kwakhe kuphezu kwakhe, uyakuba ngongcolile izinsuku eziyisikhombisa; wonke umbhede alala kuwo uyakuba ngongcolile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.24",
            "verseOrgIds": [
