          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilowo nalowo othinta lezo zinto uyakuba ngongcolile, ageze izingubo zakhe, ageze ngamanzi, abe ngongcolile kuze kuhlwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.27",
            "verseOrgIds": [
              "LEV.15.27"
            ]
