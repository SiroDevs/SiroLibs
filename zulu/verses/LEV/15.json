          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho kumelwe uhlukanise abantwana bakwa-Israyeli nokungcola kwabo; funa bafe ekungcoleni kwabo, uma bengcolisa itabernakele lami eliphakathi kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.31",
            "verseOrgIds": [
              "LEV.15.31"
            ]
          }
