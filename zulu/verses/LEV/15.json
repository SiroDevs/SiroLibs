          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noma ngubani othinta umbhede wakhe kumelwe ahlanze izingubo zakhe futhi ageze ngamanzi abe ongcolile kuze kuhlwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.21",
            "verseOrgIds": [
