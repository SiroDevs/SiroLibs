          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uma ehlambuluka ekugelezeni kwakhe, kumelwe ambalele izinsuku eziyisikhombisa, andukuba ahlambuluke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.28",
            "verseOrgIds": [
              "LEV.15.28"
