          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi kumelwe alungise elinye libe ngumnikelo wesono elinye libe ngumnikelo wokushiswa; umpristi amenzele ukubuyisana phambi kukaJehova ngokucucuza ukungcola kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.30",
            "verseOrgIds": [
              "LEV.15.30"
            ]
