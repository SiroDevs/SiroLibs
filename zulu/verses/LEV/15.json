          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesishiyagalombili kumelwe azithathele amahobhe amabili noma amaphuphu amabili amajuba awalethe kumpristi emnyango wetende lokuhlangana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.29",
            "verseOrgIds": [
              "LEV.15.29"
            ]
