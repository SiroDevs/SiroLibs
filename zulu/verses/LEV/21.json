            "number": "14",
            "style": "v",
            "sid": "LEV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umfelokazi noma owesifazane ohlukanisiwe noma ongcolile noma isifebe, labo angeke abathathe; kodwa kumelwe athathe intombi kubantu bakubo ibe umkakhe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.14",
            "verseOrgIds": [
              "LEV.21.14"
            ]
          }
        }
      ]
    },
    {
