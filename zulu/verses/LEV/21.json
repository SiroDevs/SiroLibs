          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi akufanele angcolise inzalo yakhe phakathi kwabantu bakhe, ngoba mina, iNkosi, ngiyamngcwelisa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.15",
            "verseOrgIds": [
              "LEV.21.15"
            ]
          }
        }
