            "sid": "LEV 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "angaphumi endlini engcwele, angangcolisi indlu engcwele kaNkulunkulu wakhe; ngokuba umqhele wamafutha okugcoba kaNkulunkulu wakhe uphezu kwakhe; nginguJehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.12",
            "verseOrgIds": [
              "LEV.21.12"
            ]
          }
        }
      ]
    },
    {
