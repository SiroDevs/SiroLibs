          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho kumelwe wenze umehluko phakathi kokuhlanzekile nokungcolile phakathi kwezinyoni ezingcolile nezihlanzekile; aniyikwenza imiphefumulo yenu ibe yisinengiso ngezilwane, nangezinyoni, nangezilwane ezinwabuzelayo emhlabeni engizahlukanisele kini njengabangcolile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.25",
            "verseOrgIds": [
              "LEV.20.25"
            ]
          }
        }
      ]
    },
