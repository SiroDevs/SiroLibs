          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akumelwe nihambe ngezindlela zesizwe engisixosha phambi kwenu; ngokuba benze zonke lezi zinto, ngase ngibenyanya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.23",
            "verseOrgIds": [
              "LEV.20.23"
            ]
          }
        }
      ]
