              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyakuba ngcwele kimi, ngokuba mina Jehova ngingcwele, nginahlukanisile nabezizwe ukuba nibe ngabami.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.26",
