            "number": "22",
            "style": "v",
            "sid": "LEV 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho anogcina zonke izimiso zami nezahlulelo zami zonke, nizenze, funa izwe enginiyisa kulo ukuba nihlale kulo, linikhafulele.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.22",
            "verseOrgIds": [
              "LEV.20.22"
            ]
          }
        }
