              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wakhuluma kuMose, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.1",
            "verseOrgIds": [
              "LEV.20.1"
            ]
