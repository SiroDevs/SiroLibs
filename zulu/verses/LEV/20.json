          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.16",
            "verseOrgIds": [
              "LEV.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma umuntu ethatha udadewabo, indodakazi kayise noma indodakazi kanina, abone ihlazo lakhe, naye alibone ihlazo lakhe; kuyinto embi; futhi bayonqunywa phambi kwamehlo abantu bakubo. Wadalula ihlazo likadadewabo; uyakuthwala ububi bakhe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.17",
            "verseOrgIds": [
              "LEV.20.17"
            ]
          }
        }
      ]
    },
