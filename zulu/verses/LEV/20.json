          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngathi kini: Lizakudla ilifa lelizwe labo, njalo ngizalinika lona libe ngelenu, ilizwe elichichima ubisi lezinyosi; nginguJehova uNkulunkulu wenu owanithatha ezizweni ezihlukeneyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.24",
            "verseOrgIds": [
              "LEV.20.24"
            ]
          }
        }
      ]
    },
    {
