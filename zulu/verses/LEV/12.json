              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wakhuluma kuMose, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.1",
            "verseOrgIds": [
              "LEV.12.1"
            ]
