          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe uthele amafutha phezu kwawo, ubeke impepho phezu kwawo; kungumnikelo womlilo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.15",
            "verseOrgIds": [
              "LEV.2.15"
            ]
          }
        }
      ]
