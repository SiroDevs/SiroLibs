          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonke iminikelo yomlilo yomnikelo wakho wokudla kumelwe uyifafaze ngosawoti; futhi akumelwe usawoti wesivumelwano sikaNkulunkulu wakho untuleke emnikelweni wakho wempuphu; nazo zonke izipho zakho woletha usawoti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.13",
            "verseOrgIds": [
              "LEV.2.13"
            ]
          }
        }
      ]
