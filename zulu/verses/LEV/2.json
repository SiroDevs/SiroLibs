        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.11",
            "verseOrgIds": [
              "LEV.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umnikelo womlilo wezibulo uyakuwunikela kuJehova, kepha awuyikushiswa e-altare ube yiphunga elimnandi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.12",
            "verseOrgIds": [
              "LEV.2.12"
            ]
          }
        }
      ]
    },
    {
