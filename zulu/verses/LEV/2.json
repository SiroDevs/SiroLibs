          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Uma ulungisa umnikelo womlilo wolibo lwakho kuJehova, uyakuwulungisela izikhwebu zakho eziluhlaza, ezomiswe ngomlilo, zibe ngumnikelo womlilo wezikhwebu zakho ezibhuliweyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.14",
            "verseOrgIds": [
              "LEV.2.14"
            ]
          }
        }
      ]
    },
