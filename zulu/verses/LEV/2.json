        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akukho mnikelo womlilo eniyakunikela ngawo kuJehova ongenziwa ngemvubelo; ngoba aniyikushisa imvubelo nezinyosi emnikelweni womlilo weNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.11",
            "verseOrgIds": [
              "LEV.2.11"
            ]
          }
        }
      ]
    },
    {
