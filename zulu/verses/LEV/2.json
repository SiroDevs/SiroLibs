        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma umnikelo wakho wokudla ungumnikelo womlilo obhakwe epanini, kumelwe wenziwe ngofulawa ocolekileyo onamafutha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.7",
            "verseOrgIds": [
              "LEV.2.7"
            ]
          }
        }
      ]
    },
    {
