            "sid": "1CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafowabo ngemindeni yabo, lapho kubalwa izizukulwane zabo, isikhulu sesizwe kwakunguJehiyeli noZakariya,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.7",
            "verseOrgIds": [
              "1CH.5.7"
            ]
          }
        }
      ]
