          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "indodana yakhe uBeera, owathunjwa nguThiligati Philineseri, inkosi yase-Asiriya; wayeyinduna yabakwaRubeni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.6",
            "verseOrgIds": [
              "1CH.5.6"
            ]
          }
        }
