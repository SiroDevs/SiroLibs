          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "noBela indodana ka-Asase indodana kaShema indodana kaJoweli owayehlala e-Aroweri kwaze kwaba seNebo naseBhali-meyoni;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.8",
