              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakwaRubeni nabakwaGadi nengxenye yesizwe sakwaManase, emadodeni anamandla, ahloma izikhali nezinkemba, acibishela idandili, anekhono lokulwa, babe yizinkulungwane ezingamashumi amane nane namakhulu ayisikhombisa namashumi ayisithupha, abaphuma umkhosi empini.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.18",
            "verseOrgIds": [
              "1CH.5.18"
            ]
          }
