          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinsukwini zikaSawule balwa nabakwaHagari abawa ngesandla sabo, bahlala ematendeni abo ezweni lonke lasempumalanga yakwaGileyadi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        }
      ]
