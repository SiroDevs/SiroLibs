          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasempumalanga wayehlala kuze kufike ehlane kusukela emfuleni u-Ewufrathe, ngoba izinkomo zabo zaziziningi ezweni lakwaGileyadi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
            "verseOrgIds": [
              "1CH.5.9"
            ]
