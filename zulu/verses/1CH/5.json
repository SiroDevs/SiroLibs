              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba baningi ababulewe, ngokuba impi yayingekaNkulunkulu. Bahlala endaweni yabo kwaze kwaba sekuthunjweni.",
          "type": "text",
          "attrs": {
