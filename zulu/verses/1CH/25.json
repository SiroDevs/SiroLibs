            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkatho yokuqala ka-Asafa yaphumela uJosefa, eyesibili uGedaliya, yena nabafowabo namadodana akhe beyishumi nambili.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
