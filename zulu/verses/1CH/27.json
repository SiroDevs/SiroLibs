            "number": "1",
            "style": "v",
            "sid": "1CH 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.1",
            "verseOrgIds": [
              "1CH.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phezu kwesigaba sokuqala ngenyanga yokuqala kwakunguJasobhamu indodana kaSabidiyeli; esigabeni sakhe kukhona abayizinkulungwane ezingamashumi amabili nane.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.2",
            "verseOrgIds": [
              "1CH.27.2"
            ]
          }
        }
      ]
    },
    {
