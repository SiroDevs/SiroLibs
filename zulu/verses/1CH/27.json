          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owayephethe izinkomo ezaziklaba eSharoni kwakunguSitrayi umSaroni; owayephethe izinkomo ezisezigodini kwakunguShafati indodana ka-Adilayi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.29",
            "verseOrgIds": [
              "1CH.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
