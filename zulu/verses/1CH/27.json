            "sid": "1CH 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "KwaZebuloni: ngu-Ishmaya indodana ka-Obadiya; kwaNafetali: nguJerimoti indodana ka-Asiriyeli;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.19",
            "verseOrgIds": [
              "1CH.27.19"
            ]
