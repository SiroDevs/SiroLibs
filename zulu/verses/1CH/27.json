          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owayephethe iminqumo nemikhiwane yasendle eyayisemathafeni kwakunguBhali-hanani umGederi, noJowashi owayephethe izisele zamafutha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.28",
            "verseOrgIds": [
              "1CH.27.28"
            ]
          }
        }
      ]
    },
