        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJowabe indodana kaSeruya waqala ukubala, kepha akaqedanga, ngokuba intukuthelo yaphumela phezu kuka-Israyeli ngenxa yalokho; futhi inani alilotshiwe encwadini yezindaba zemihla ngemihla yenkosi uDavide.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        }
      ]
    },
