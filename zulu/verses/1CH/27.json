        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezigabeni zenyanga yesibili uDodayi wayengumAhohi, isikhulu sesigaba sakhe sasinguMikilothi; esigabeni sakhe kwakukhona izinkulungwane ezingamashumi amabili nane.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.4",
            "verseOrgIds": [
              "1CH.27.4"
            ]
          }
        }
      ]
    },
