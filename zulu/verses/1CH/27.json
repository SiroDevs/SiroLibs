          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owayephethe izivini kwakunguSimeyi waseRama; phezu kokukhula kwemivini ezindaweni zokugcina iwayini kwakunguSabdi umSifi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.27",
            "verseOrgIds": [
              "1CH.27.27"
            ]
          }
        }
      ]
