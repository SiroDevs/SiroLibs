          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubantwana bakwa-Efrayimi: nguHoseya indodana ka-Asaya; enxenyeni yesizwe sakwaManase: nguJoweli indodana kaPhedaya;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.20",
            "verseOrgIds": [
              "1CH.27.20"
            ]
          }
        }
