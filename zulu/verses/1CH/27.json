          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "KwaJuda, u-Elihu, omunye wabafowabo bakaDavide; kwa-Isakare, u-Omri indodana kaMikayeli;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.18",
