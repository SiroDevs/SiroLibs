          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesine ngenyanga yesine kwakungu-Asaheli umfowabo kaJowabe, noZebadiya indodana yakhe emva kwakhe; esigabeni sakhe kwakukhona izinkulungwane ezingamashumi amabili nane.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.7",
            "verseOrgIds": [
              "1CH.27.7"
            ]
