            "sid": "1CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Induna yesithathu ngenyanga yesithathu kwakunguBenaya, indodana kaJehoyada, umpristi omkhulu; esigabeni sakhe kwakukhona izinkulungwane ezingamashumi amabili nane.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.5",
            "verseOrgIds": [
              "1CH.27.5"
            ]
          }
        }
