        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakwa-Israyeli ngomumo wabo, izinhloko zawoyise, nezinduna zezinkulungwane nezamakhulu, nababonisi babo abakhonza inkosi kunoma yisiphi isigaba sezigaba, abangena baphume inyanga nenyanga ezinyangeni zonke. Onyakeni, esigabeni ngasinye yayiyizinkulungwane ezingamashumi amabili nane.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.1",
            "verseOrgIds": [
              "1CH.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
