          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguye lowo uBenaya owayenamandla phakathi kwabangamashumi amathathu namashumi amathathu; esigabeni sakhe kwakukhona u-Amisabadi indodana yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.6",
