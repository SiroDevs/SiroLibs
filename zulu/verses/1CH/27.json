          "type": "text",
          "attrs": {
            "verseId": "1CH.27.29",
            "verseOrgIds": [
              "1CH.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owayephethe amakamela kwakungu-Obili wakwa-Ishmayeli, noJadiya umMeronoti owayephethe izimbongolo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.30",
            "verseOrgIds": [
              "1CH.27.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 27:30"
          },
          "items": [
