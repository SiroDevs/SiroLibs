              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesihlanu ngenyanga yesihlanu kwakunguSamhuti umJizrahi, futhi esigabeni sakhe kukhona izinkulungwane ezingamashumi amabili nane.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.8",
