              "type": "text"
            }
          ]
        },
        {
          "text": "emadodaneni kaMerari; uAsaya inhloko, nabafowabo, bengamakhulu amabili namashumi amabili;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.6",
            "verseOrgIds": [
              "1CH.15.6"
            ]
          }
        }
