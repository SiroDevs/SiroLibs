            "number": "16",
            "style": "v",
            "sid": "1CH 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wakhuluma ezinduneni zamaLevi ukuba zibeke abafowabo ukuba babe abahlabeleli, benezinsimbi zomculo, amahabhu, nezinsimbi, namasimbali, baphakamise izwi ngokujabula.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.16",
            "verseOrgIds": [
              "1CH.15.16"
            ]
          }
        }
      ]
    },
