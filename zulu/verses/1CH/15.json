          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wazakhela izindlu emzini kaDavide, walungisela umphongolo kaNkulunkulu indawo, wawumisela itende.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.1",
            "verseOrgIds": [
              "1CH.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.1",
            "verseOrgIds": [
              "1CH.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasesithi: Kakulamuntu ongathwala umphongolo kaNkulunkulu, ngaphandle kwamaLevi, ngoba bakhethile uJehova ukuthi athwale umphongolo kaNkulunkulu, bamkhonze kuze kube nininini.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.2",
            "verseOrgIds": [
              "1CH.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
