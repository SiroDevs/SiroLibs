          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wabiza oSadoki no-Abiyathara, abapristi, namaLevi, ku-Uriyeli, no-Asaya, noJoweli, noShemaya, no-Eliyeli, no-Aminadaba;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.11",
            "verseOrgIds": [
              "1CH.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
