          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaLevi amisa uHemani indodana kaJoweli; kubafowabo: ngo-Asafa indodana kaBerekiya; emadodaneni kaMerari, abafowabo: ngo-Ethani indodana kaKusaya;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.17",
            "verseOrgIds": [
              "1CH.15.17"
            ]
          }
        }
