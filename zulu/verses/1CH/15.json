            "sid": "1CH 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wabutha wonke u-Israyeli eJerusalema ukuba alethe umphongolo kaJehova endaweni yawo ayewulungisele wona.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.3",
            "verseOrgIds": [
              "1CH.15.3"
            ]
          }
        }
      ]
    },
    {
