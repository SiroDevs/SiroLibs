              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "emadodaneni kaGereshomu: uJoweli inhloko nabafowabo, beyikhulu namashumi amathathu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.7",
