        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana ka-Amramu; o-Aroni, noMose, no-Aroni bahlukaniselwa ukungcwelisa izinto ezingcwelengcwele, yena namadodana akhe kuze kube phakade, bashunqise umusi phambi kukaJehova, bamkhonze, babusise egameni lakhe kuze kube phakade.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.13",
            "verseOrgIds": [
              "1CH.23.13"
            ]
          }
        }
      ]
    },
    {
