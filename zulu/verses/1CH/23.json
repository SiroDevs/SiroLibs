          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "NgoMose, umuntu kaNkulunkulu, amadodana akhe abizwa esizweni sakwaLevi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.14",
            "verseOrgIds": [
              "1CH.23.14"
            ]
          }
        }
      ]
    },
