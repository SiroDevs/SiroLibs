              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uDavida wathi: I Nkosi, uNkulunkulu kaIsrayeli, inike abantu bayo ukuphumula, ukuze bahlale eJerusalema kuze kube nininini.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.25",
