              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba isikhundla sawo sasingukukhonza amadodana ka-Aroni enkonzweni yendlu kaJehova, emagcekeni nasemakameloni, nasekuhlanzweni kwazo zonke izinto ezingcwele, nomsebenzi wenkonzo yendlu kaNkulunkulu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
