            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide indodana kaJese wabusa phezu kuka-Israyeli wonke.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.26",
            "verseOrgIds": [
              "1CH.29.26"
            ]
          }
        }
      ]
    },
    {
