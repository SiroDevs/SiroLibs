            "verseOrgIds": [
              "1CH.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasesithi kulo lonke ibandla: Khathesi dumisani uJehova uNkulunkulu wenu. Ibandla lonke lambonga uJehova uNkulunkulu wawoyise, bakhothama, bakhuleka kuJehova nasenkosini.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        }
      ]
    },
    {
