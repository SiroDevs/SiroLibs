            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadla, waphuza ngokuthokoza okukhulu phambi kukaJehova ngalolo suku. Basebembeka uSolomoni indodana kaDavide inkosi ngokwesibili, bamgcobela uJehova abe ngumbusi omkhulu, noSadoki abe ngumpristi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        }
      ]
    },
    {
