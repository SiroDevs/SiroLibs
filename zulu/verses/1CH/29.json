          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wamenza uSolomoni waba mkhulu kakhulu emehlweni abo bonke abakwa-Israyeli, wamnika isithunzi sobukhosi esingazange sibe khona nakuyiphi inkosi yakwa-Israyeli ngaphambi kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        }
      ]
    },
