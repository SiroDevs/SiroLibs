          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isikhathi abusa ngaso phezu kuka-Israyeli sasiyiminyaka engamashumi amane; iminyaka eyisikhombisa wabusa eHebroni, futhi wabusa iminyaka engamashumi amathathu nantathu eJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.27",
            "verseOrgIds": [
              "1CH.29.27"
            ]
          }
        }
      ]
    },
    {
