              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahlabela uJehova imihlatshelo, banikela ngeminikelo yokushiswa kuJehova ngangomuso izinkunzi eziyinkulungwane, nezinqama eziyinkulungwane, namawundlu ayinkulungwane neminikelo yakho yokuphuzwa nemihlatshelo eminingi ngo-Israyeli wonke.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.21",
            "verseOrgIds": [
              "1CH.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
