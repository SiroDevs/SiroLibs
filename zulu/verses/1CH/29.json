          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.17",
            "verseOrgIds": [
              "1CH.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova, Nkulunkulu ka-Abrahama, no-Isaka, no-Israyeli, obaba bethu, kulondoloze kuze kube phakade emicabangweni yemicabango yenhliziyo yabantu bakho, ulungisele wena izinhliziyo zabo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.18",
            "verseOrgIds": [
              "1CH.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 29:18"
          },
          "items": [
