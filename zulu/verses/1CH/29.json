          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.18",
            "verseOrgIds": [
              "1CH.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unike uSolomoni indodana yami inhliziyo epheleleyo ukugcina imiyalo yakho, nobufakazi bakho, nezimiso zakho, yenze zonke lezi zinto, akhe indlu yobukhosi engiyilungisile.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.19",
            "verseOrgIds": [
              "1CH.29.19"
            ]
          }
        }
      ]
    },
    {
