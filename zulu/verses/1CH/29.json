            "number": "29",
            "style": "v",
            "sid": "1CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukulandisa kwenkosi uDavide, ezokuqala nezokugcina, bheka, kulotshiwe encwadini kaSamuweli umboni, nasencwadini kaNathani umprofethi, nasencwadini kaGadi umboni,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.29",
            "verseOrgIds": [
              "1CH.29.29"
            ]
          }
        }
      ]
    },
