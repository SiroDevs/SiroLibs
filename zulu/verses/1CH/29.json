          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanye nakho konke ukubusa kwakhe namandla akhe nezikhathi ezedlula yena no-Israyeli naphezu kwayo yonke imibuso yamazwe.",
          "type": "text",
