          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawa angamadodana kaDavide azalelwa wona eHebroni; izibulo ngu-Amnoni ku-Ahinohama waseJizreyeli; owesibili uDaniyeli ku-Abigayili waseKarmeli;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        }
      ]
    },
    {
