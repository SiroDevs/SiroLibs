        {
          "text": "Bazalelwa yena eJerusalema; oShimeya, noShobabi, noNathani, noSolomoni, bobane, kuBatsuwa indodakazi ka-Amiyeli;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.5",
