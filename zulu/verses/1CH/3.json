          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesithathu ngu-Abisalomu indodana kaMahaga, indodakazi kaTalimayi, inkosi yaseGeshuri; owesine ngu-Adoniya indodana kaHagiti;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.2",
            "verseOrgIds": [
              "1CH.3.2"
            ]
          }
        }
