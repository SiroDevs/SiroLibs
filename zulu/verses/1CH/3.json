              "type": "text"
            }
          ]
        },
        {
          "text": "Laba abayisithupha wabazalelwa eHebroni; wabusa khona iminyaka eyisikhombisa nezinyanga eziyisithupha, eJerusalema wabusa iminyaka engamashumi amathathu nantathu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.4",
            "verseOrgIds": [
              "1CH.3.4"
            ]
          }
        }
