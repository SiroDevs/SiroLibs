              "type": "text"
            }
          ]
        },
        {
          "text": "UHiramu inkosi yaseTire wathuma izithunywa kuDavide, nemisedari, nabakhi nababazi, ukumakhela indlu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.1",
