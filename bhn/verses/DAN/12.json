        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Dan 9:27; 11:31; Mat 24:15; Marko 13:14",
              "type": "text"
            }
          ]
        },
        {
          "text": " “ ‘Tangu wakati wa kukomeshwa kwa sadaka za kuteketezwa kila siku, yaani kutoka wakati ule chukizo haribifu litakaposimamishwa itakuwa muda wa siku 1,290. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.11",
            "verseOrgIds": [
              "DAN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heri yao watakaostahimili mpaka siku zile 1,335 zitakapotimia.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.12",
            "verseOrgIds": [
              "DAN.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
