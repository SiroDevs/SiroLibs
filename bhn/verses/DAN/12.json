          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.12",
            "verseOrgIds": [
              "DAN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Lakini wewe, ee Danieli, jiendee, ukapumzike kaburini, na wakati huo utakapotimia, utafufuka na kupata tuzo lako.’”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.13",
            "verseOrgIds": [
              "DAN.12.13"
            ]
          }
        }
