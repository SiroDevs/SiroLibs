              "type": "text"
            }
          ]
        },
        {
          "text": "Hapo wakamwuliza, “Ni wapi Bwana?” Naye akawaambia, “Palipo mzoga, ndipo tai watakapokusanyikia.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
