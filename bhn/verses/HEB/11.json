          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwa na imani ni kuwa na hakika ya mambo tunayotumainia; kusadiki kabisa mambo tusiyoyaona. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.1",
            "verseOrgIds": [
              "HEB.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana wazee wa kale walipata kibali cha Mungu kwa sababu ya imani yao.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.2",
            "verseOrgIds": [
              "HEB.11.2"
            ]
          }
        }
      ]
    },
