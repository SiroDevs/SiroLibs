          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.10",
            "verseOrgIds": [
              "HEB.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunayo mengi ya kusema juu ya jambo hili, lakini ni vigumu kuwaelezeni, kwa sababu nyinyi si wepesi wa kuelewa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.11",
            "verseOrgIds": [
              "HEB.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa wakati huu nyinyi mngalipaswa kuwa waalimu tayari, lakini mnahitaji bado mtu wa kuwafundisheni mafundisho ya mwanzo juu ya neno la Mungu. Mnahitaji maziwa badala ya chakula kigumu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.12",
            "verseOrgIds": [
              "HEB.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila anayepaswa kunywa maziwa ni mtoto bado, hajui uadilifu ni nini. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.13",
            "verseOrgIds": [
              "HEB.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini chakula kigumu ni kwa ajili ya watu waliokomaa, waliofunzwa kwa vitendo kubainisha mema na mabaya.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.14",
            "verseOrgIds": [
              "HEB.5.14"
            ]
          }
        }
      ]
