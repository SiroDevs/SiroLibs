              "text": "Taz Zab 95:7-11",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwa hiyo, basi, kama asemavyo Roho Mtakatifu:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.7",
            "verseOrgIds": [
              "HEB.3.7"
            ]
