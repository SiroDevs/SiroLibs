          },
          "items": [
            {
              "text": "Taz Zab 22:22",
              "type": "text"
            }
          ]
        },
        {
          "text": " kama asemavyo:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.12",
            "verseOrgIds": [
              "HEB.2.12"
            ]
          }
