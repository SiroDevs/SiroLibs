              "text": "Taz Zab 8:4-6",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tena yasemwa mahali fulani katika Maandiko:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.6",
            "verseOrgIds": [
              "HEB.2.6"
            ]
