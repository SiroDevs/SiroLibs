              "MAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.5",
            "verseOrgIds": [
              "MAL.2.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Hes 25:12",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Katika agano hilo, niliwaahidi uhai na amani na kwamba wao ni lazima kunicha mimi, nao kwa upande wao walinicha mimi, wakaliogopa jina langu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.5",
            "verseOrgIds": [
              "MAL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafundisho yao yalikuwa ya kweli na kamwe hawakufundisha uongo. Mimi na wao tulikaa kwa amani. Si kwamba walitenda haki tu, bali waliwafundisha wengine kutotenda maovu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.6",
            "verseOrgIds": [
              "MAL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni wajibu wa makuhani kuwafundisha watu maarifa ya kweli juu ya Mungu. Watu wawaendee kujifunza matakwa yangu kwao, kwani makuhani ni wajumbe wa Mwenyezi-Mungu wa majeshi.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.7",
            "verseOrgIds": [
              "MAL.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.7",
            "verseOrgIds": [
              "MAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bali nyinyi makuhani mmegeuka mkaiacha njia ya haki. Mafundisho yenu yamewaongoza watu wengi katika kutenda mabaya. Mmelivunja agano nililofanya nanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.8",
            "verseOrgIds": [
              "MAL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami pia nitawafanya mdharauliwe na kupuuzwa na Waisraeli, kwa sababu hamkuzifuata njia zangu, na mnapowafundisha watu wangu mnapendelea baadhi yao.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.9",
            "verseOrgIds": [
              "MAL.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.9",
            "verseOrgIds": [
              "MAL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, sisi sote si watoto wa baba mmoja? Je, sisi sote hatukuumbwa na Mungu yuleyule? Mbona basi, hatuaminiani sisi kwa sisi, na tunalidharau agano alilofanya Mwenyezi-Mungu na wazee wetu? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.10",
            "verseOrgIds": [
              "MAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa Yuda wamekosa uaminifu kwa Mungu na kutenda machukizo katika Israeli na mjini Yerusalemu. Wamelitia unajisi hekalu la Mwenyezi-Mungu analolipenda. Tena wameoa wanawake wanaoabudu miungu ya kigeni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.11",
            "verseOrgIds": [
              "MAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu na awaondolee mbali watu wanaofanya mambo hayo kutoka miongoni mwa wazawa wa Yakobo. Na kamwe wasishiriki katika kutoa ushuhuda na kuleta tambiko mbele ya Mwenyezi-Mungu wa majeshi.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.12",
            "verseOrgIds": [
              "MAL.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.12",
            "verseOrgIds": [
              "MAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zaidi ya hayo yote, mnaifunika madhabahu ya Mwenyezi-Mungu kwa machozi yenu, mkilia na kuomboleza kwa sababu yeye hazikubali tena tambiko mnazomtolea. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.13",
            "verseOrgIds": [
              "MAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnauliza, “Mbona sasa hazikubali?” Mwenyezi-Mungu hazikubali kwa sababu anajua wazi kuwa umeivunja ahadi yako kwa mke wa ujana wako. Umekosa uaminifu kwake ingawa uliahidi mbele ya Mungu kwamba ungekuwa mwaminifu kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.14",
            "verseOrgIds": [
              "MAL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, Mungu hakuwafanya nyote wawili muwe mwili mmoja na roho moja?",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.15",
            "verseOrgIds": [
              "MAL.2.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:15",
              "type": "text"
            },
            {
              "text": "Je … moja:",
              "type": "text"
            },
            {
              "text": "Maana katika Kiebrania si dhahiri.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Je, alikusudia nini alipofanya hayo? Yamkini alikusudia tuzae watoto ambao watamcha yeye. Kwa hiyo, hakikisheni kuwa hakuna hata mmoja wenu anayekosa uaminifu kwa mkewe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.15",
            "verseOrgIds": [
              "MAL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu, Mungu wa Israeli asema: “Ninachukia talaka. Ninachukia mmoja wenu anapomtendea mkewe ukatili huo. Hakikisheni kwamba hakuna hata mmoja wenu anayekosa uaminifu kwa mkewe.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.16",
            "verseOrgIds": [
              "MAL.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.16",
            "verseOrgIds": [
              "MAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmemchosha Mwenyezi-Mungu kwa maneno yenu matupu. Hata hivyo, mnasema, “Tumemchoshaje?” Mmemchosha mnaposema, “Mwenyezi-Mungu huwaona kuwa wema watu wanaotenda maovu; tena anawapenda.” Au mnapouliza, “Yuko wapi yule Mungu mwenye haki?”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.17",
            "verseOrgIds": [
              "MAL.2.17"
            ]
          }
        }
      ]
    }
  ],
