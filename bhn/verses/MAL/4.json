        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Mat 11:14; 17:10-13; Marko 9:11-13; Luka 1:17; Yoh 1:21",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Tazama, kabla ya kufika siku ile kuu na ya kutisha, nitamtuma nabii Elia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabii Elia atawapatanisha wazazi na watoto wao; la sivyo, nitakuja na kuiangamiza nchi yenu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.6",
            "verseOrgIds": [
              "MAL.4.6"
            ]
          }
        }
