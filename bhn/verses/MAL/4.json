              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kumbukeni sheria, kanuni na maagizo yangu niliyomwamuru Mose mtumishi wangu kule mlimani Horebu, ili awaamuru watu wote wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.4.4"
            ]
          }
        }
      ]
    },
