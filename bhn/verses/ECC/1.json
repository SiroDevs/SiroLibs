          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilipania kuchunguza na kutafuta kwa hekima kila kitu kinachotukia duniani. Hiyo ni taabu kubwa ambayo Mungu amewapa wanadamu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.13",
            "verseOrgIds": [
              "ECC.1.13"
            ]
          }
        }
