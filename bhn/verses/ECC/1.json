              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi Mhubiri, nilikuwa mfalme wa Israeli, huko Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.12",
            "verseOrgIds": [
              "ECC.1.12"
            ]
          }
        },
