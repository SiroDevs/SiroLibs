          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimeyaona yote yanayofanywa duniani; yote ni bure: Ni sawa na kufukuza upepo!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.14",
