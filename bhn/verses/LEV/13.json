          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kama kuhani ataona kuwa ile alama imefifia baada ya kufuliwa, basi atararua ile sehemu iliyo na namna ya upele wa ukoma. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.56",
            "verseOrgIds": [
              "LEV.13.56"
            ]
