          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LEV 13:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini vazi ambalo upele umetokea baada ya kulifua itabidi lifuliwe mara ya pili na hivyo lipate kuwa safi.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.58",
            "verseOrgIds": [
              "LEV.13.58"
            ]
          }
        },
        {
