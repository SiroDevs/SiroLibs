              "LEV.16.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Eze 44:19",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kisha Aroni atarudi ndani ya hema la mkutano, atavua yale mavazi aliyovaa alipoingia mahali patakatifu sana na kuyaacha humo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.23",
            "verseOrgIds": [
              "LEV.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataoga humo ndani katika mahali patakatifu na kuvaa mavazi yake. Atatoka na kutoa sadaka yake ya kuteketezwa, na sadaka ya kuteketezwa ya watu wa Israeli, ili kufanya ibada ya upatanisho kwa ajili yake mwenyewe na kwa ajili ya watu wote. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.24",
            "verseOrgIds": [
              "LEV.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuta ya sadaka ya kuondoa dhambi atayateketeza juu ya madhabahu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.25",
            "verseOrgIds": [
              "LEV.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule mtu aliyempeleka yule beberu kwa Azazeli kwanza atayafua mavazi yake na kuoga ndipo atakapoweza kuingia kambini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.26",
            "verseOrgIds": [
              "LEV.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Ebr 13:11",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yule fahali na mbuzi waliotolewa sadaka ya kuondoa dhambi ambao damu yao ilipelekwa mahali patakatifu sana ili kufanya ibada ya upatanisho, watapelekwa nje ya kambi na kuteketezwa. Ngozi zao, nyama na mavi yao, vyote vitateketezwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.27",
            "verseOrgIds": [
              "LEV.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule mtu atakayewateketeza atayafua mavazi yake na kuoga, ndipo atakapoweza kuingia kambini.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.28",
