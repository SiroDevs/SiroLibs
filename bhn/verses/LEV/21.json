            "sid": "LEV 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.23",
            "verseOrgIds": [
              "LEV.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akamweleza Aroni na wanawe na Waisraeli wote mambo hayo yote.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.24",
            "verseOrgIds": [
              "LEV.21.24"
            ]
          }
        }
      ]
    }
  ],
