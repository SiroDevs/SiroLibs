            "sid": "LEV 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.26",
            "verseOrgIds": [
              "LEV.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwanamume au mwanamke yeyote aliye mlozi au mchawi, ni lazima auawe kwa kupigwa mawe. Wote watawajibika kwa umwagaji wa damu yao wenyewe.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.27",
            "verseOrgIds": [
              "LEV.20.27"
            ]
          }
        }
      ]
    }
  ],
