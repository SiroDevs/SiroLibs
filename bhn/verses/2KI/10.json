          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.33",
            "verseOrgIds": [
              "2KI.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matendo mengine yote ya Yehu na vitendo vyake vya ushujaa yameandikwa katika Kitabu cha Mambo ya Nyakati za Wafalme wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.34",
            "verseOrgIds": [
              "2KI.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafariki na kuzikwa Samaria. Mwanae Yehoahazi akatawala mahali pake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.35",
            "verseOrgIds": [
              "2KI.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehu alitawala Israeli akiwa Samaria kwa miaka ishirini na minane.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.36",
            "verseOrgIds": [
              "2KI.10.36"
            ]
          }
        }
