              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
