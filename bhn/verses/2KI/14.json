          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroboamu alifariki na kuzikwa katika makaburi ya kifalme na mwanawe Zekaria akatawala mahali pake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.29",
