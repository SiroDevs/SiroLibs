          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.16",
            "verseOrgIds": [
              "2KI.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo Hazaeli mfalme wa Aramu akaushambulia mji wa Gathi na kuuteka. Lakini Hazaeli alipoelekea Yerusalemu ili aushambulie, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.17",
            "verseOrgIds": [
              "2KI.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoashi mfalme wa Yuda alichukua sadaka zote zilizowekwa wakfu na babu zake wafalme wa Yuda: Yehoshafati, Yehoramu na Ahazia, na kuongeza zile zake, pamoja na dhahabu yote iliyokuwa katika hazina ya nyumba ya Mwenyezi-Mungu na katika ikulu, akazituma kwa Hazaeli mfalme wa Aramu. Naye Hazaeli akatoka Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.18",
            "verseOrgIds": [
              "2KI.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
