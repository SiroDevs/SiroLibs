          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.18",
            "verseOrgIds": [
              "2KI.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matendo mengine yote ya mfalme Yoashi yameandikwa katika Kitabu cha Mambo ya Nyakati za Wafalme wa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.19",
            "verseOrgIds": [
              "2KI.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.19",
            "verseOrgIds": [
              "2KI.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maofisa wake walikula njama dhidi yake, wakamuulia katika nyumba ya Milo kwenye barabara inayoelekea Sila. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.20",
            "verseOrgIds": [
              "2KI.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliomuua ni Yozakari mwana wa Shimeathi na Yehozabadi mwana wa Shomeri watumishi wake. Halafu walimzika katika makaburi ya kifalme katika mji wa Daudi; naye Amazia, mwanawe, akatawala mahali pake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.21",
            "verseOrgIds": [
              "2KI.12.21"
            ]
          }
        }
      ]
    }
