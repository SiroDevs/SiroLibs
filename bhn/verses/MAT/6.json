              "MAT.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiwa basi, Mungu hulivika hivyo jani la shambani ambalo leo liko na kesho latupwa motoni, je, si atawafanyia nyinyi zaidi? Enyi watu wenye imani haba!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.30",
            "verseOrgIds": [
              "MAT.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.30",
            "verseOrgIds": [
              "MAT.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Basi, msiwe na wasiwasi: ‘Tutakula nini, tutakunywa nini, tutavaa nini!’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.31",
            "verseOrgIds": [
              "MAT.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana hayo yote yanahangaikiwa na watu wasiomjua Mungu. Baba yenu wa mbinguni anajua kwamba mnahitaji vitu hivyo vyote. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.32",
            "verseOrgIds": [
              "MAT.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali, shughulikeni kwanza juu ya ufalme wa Mungu na matakwa yake, na hayo yote mtapewa kwa ziada. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.33",
            "verseOrgIds": [
              "MAT.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, msiwe na wasiwasi juu ya kesho; kesho inayo yake. Matatizo ya siku moja yanawatosheni kwa siku hiyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.34",
            "verseOrgIds": [
              "MAT.6.34"
            ]
          }
        }
