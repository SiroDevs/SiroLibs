            "style": "v",
            "sid": "EST 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.13",
            "verseOrgIds": [
              "EST.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, Zereshi, mkewe, na marafiki zake, wakamshauri hivi: “Kwa nini asitengenezewe mti wa kuulia, wenye urefu wa mita ishirini na mbili? Kesho asubuhi, unaweza kuzungumza na mfalme ili Mordekai auawe juu yake, kisha uende ukale karamu na mfalme kwa furaha.” Wazo hilo lilimfurahisha Hamani, naye akatengeneza mti wa kuulia.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.14",
            "verseOrgIds": [
              "EST.5.14"
            ]
          }
        }
      ]
    }
  ],
