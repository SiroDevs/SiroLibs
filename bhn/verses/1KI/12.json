          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baadaye mfalme Yeroboamu akaujenga upya mji wa Shekemu kwenye mlima wa Efraimu; akakaa huko. Kisha akaenda akajenga mji wa Penueli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.25",
            "verseOrgIds": [
              "1KI.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yeroboamu akaanza kufikirifikiri: “Sasa ufalme utarudi kwa jamaa ya mfalme Daudi ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.26",
            "verseOrgIds": [
              "1KI.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kama watu hawa wataendelea kwenda kutambikia katika nyumba ya Mwenyezi-Mungu huko Yerusalemu. Mioyo yao itamgeukia bwana wao Rehoboamu mfalme wa Yuda, nao wataniua mimi.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        }
      ]
