              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Kumb 11:29; 27:11-14",
              "type": "text"
            }
          ]
        },
        {
          "text": " Waisraeli wote pamoja na viongozi wao, wazee na waamuzi na wageni wote waliokuwa kati yao, wakasimama kila upande mkabala na sanduku la agano mbele ya makuhani Walawi waliokuwa wamelibeba sanduku la agano la Mwenyezi-Mungu. Nusu yao wakasimama mbele ya mlima Gerizimu na nusu nyingine wakasimama mbele ya mlima Ebali, kama vile Mose, mtumishi wa Mwenyezi-Mungu, alivyoagiza hapo awali kuhusu kubarikiwa kwa Waisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha, Yoshua akawasomea sheria zote, pamoja na baraka na laana kama ilivyoandikwa katika kitabu cha sheria. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.34",
            "verseOrgIds": [
              "JOS.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
