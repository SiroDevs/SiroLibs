            "number": "32",
            "style": "v",
            "sid": "JOS 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na huko, mbele ya umati wote wa Waisraeli, Yoshua aliandika nakala ya sheria ya Mose juu ya mawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
            "verseOrgIds": [
              "JOS.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
