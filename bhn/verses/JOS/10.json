          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapo, mfalme Horamu wa Gerezi akaamua kuja kuwasaidia watu wa Lakishi. Lakini Yoshua alimuua pamoja na watu wake wote, hakumbakiza hata mtu mmoja.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.33",
            "verseOrgIds": [
