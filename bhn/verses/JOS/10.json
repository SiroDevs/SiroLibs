            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku hiyo Yoshua alipouteka mji wa Makeda, alimuua mfalme wake na wakazi wake wote bila kumbakiza hata mtu mmoja. Alimtendea mfalme wa Makeda kama vile alivyomtendea mfalme wa Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.28",
            "verseOrgIds": [
              "JOS.10.28"
            ]
          }
        }
