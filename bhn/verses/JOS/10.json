            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka Makeda, Yoshua pamoja na Waisraeli wote walikwenda Libna wakaushambulia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.29",
            "verseOrgIds": [
              "JOS.10.29"
            ]
          }
