              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha kutoka Libna Yoshua na Waisraeli wote walikwenda Lakishi, wakauzingira na kuushambulia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.31",
            "verseOrgIds": [
              "JOS.10.31"
            ]
          }
