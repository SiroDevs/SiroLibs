          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakauteka siku hiyohiyo na kuwaua wakazi wake wote kama walivyofanya kule Lakishi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.35",
