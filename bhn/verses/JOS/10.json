              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha kutoka Lakishi, Yoshua na Waisraeli wote walikwenda mpaka Egloni, wakauzingira na kuushambulia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.34",
            "verseOrgIds": [
              "JOS.10.34"
            ]
