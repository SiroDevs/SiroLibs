        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.53",
            "verseOrgIds": [
              "1CH.2.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1CH 2:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salma, mwanzilishi wa mji wa Bethlehemu alikuwa babu ya Wanetofathi, Waatroth-beth-yoabu na nusu ya Wamenahathi yaani Wasori.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.54",
            "verseOrgIds": [
              "1CH.2.54"
            ]
          }
        }
      ]
    },
