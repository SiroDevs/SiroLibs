          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahithofeli, alikuwa mshauri wake mfalme; Hushai Mwarki, alikuwa rafiki yake mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
