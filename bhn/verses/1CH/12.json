          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanajeshi hao wote, waliojiandaa tayari kabisa kwa vita, walikwenda Hebroni na nia yao kubwa ikiwa ni kumtawaza Daudi awe mfalme wa Israeli yote. Nao watu wote wa Israeli, pia waliungana wakiwa na nia moja ya kumtawaza Daudi awe mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.38",
            "verseOrgIds": [
              "1CH.12.38"
            ]
          }
        }
      ]
    },
