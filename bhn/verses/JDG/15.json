            "number": "19",
            "style": "v",
            "sid": "JDG 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.19",
            "verseOrgIds": [
              "JDG.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samsoni alikuwa mwamuzi wa Waisraeli kwa miaka ishirini, nyakati za Wafilisti.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.20",
            "verseOrgIds": [
              "JDG.15.20"
            ]
          }
        }
