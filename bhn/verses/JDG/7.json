          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakasimama kila mmoja mahali pake kuizunguka kambi. Jeshi lote la adui likatawanyika huku likipiga mayowe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.21",
            "verseOrgIds": [
              "JDG.7.21"
            ]
