          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa Gideoni walipopiga tarumbeta zao 300, Mwenyezi-Mungu aliwafanya Wamidiani waanze kuuana wao kwa wao kambini. Waliosalia wakatoroka hadi Serera panapoelekea Beth-shita, hadi mpakani mwa Abel-mehola karibu na Tabathi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.22",
            "verseOrgIds": [
              "JDG.7.22"
            ]
          }
        }
