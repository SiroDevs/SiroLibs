              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa kabila la Asheri hawakuwafukuza wakazi wa miji ya Ako, Sidoni, Alabu, Akzibu, Helba, Afeka na Rehobu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.31",
