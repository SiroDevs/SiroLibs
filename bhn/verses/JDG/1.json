          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa kabila la Asheri walikaa pamoja na Wakanaani wenyeji wa nchi hiyo kwani hawakuwafukuza.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
