              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa kabila la Manase hawakuwafukuza wakazi wa miji ya Beth-sheani na vijiji vyake, Taanaki na vijiji vyake, Dori na vijiji vyake, Ibleamu na vijiji vyake, na Megido pamoja na vijiji vyake. Wakanaani waliendelea kukaa huko. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.27",
            "verseOrgIds": [
              "JDG.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata Waisraeli walipokuwa na nguvu hawakuwafukuza Wakanaani bali waliwapa kazi za kulazimishwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
            "verseOrgIds": [
              "JDG.1.28"
            ]
          }
        }
