          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpaka wa Waamori ulikuwa kaskazini ya Sela, kupitia pitio la Akarimu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.36",
            "verseOrgIds": [
