              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo, Shauli akala pamoja na Samueli siku hiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.24",
            "verseOrgIds": [
              "1SA.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliporudi mjini kutoka mahali pa juu pa ibada, Shauli alitandikiwa kitanda kwenye paa la nyumba, akalala huko.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.25",
            "verseOrgIds": [
              "1SA.9.25"
            ]
          }
        }
      ]
