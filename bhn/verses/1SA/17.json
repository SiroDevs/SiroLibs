              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi alikichukua kichwa cha yule Goliathi, Mfilisti, akakipeleka mjini Yerusalemu. Lakini silaha za Goliathi akaziweka katika hema lake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.54",
            "verseOrgIds": [
              "1SA.17.54"
            ]
          }
        }
