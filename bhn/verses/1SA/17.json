          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme Shauli akamwambia, “Basi, uliza yeye ni kijana wa nani.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.56",
            "verseOrgIds": [
              "1SA.17.56"
            ]
