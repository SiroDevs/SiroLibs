            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:36",
              "type": "text"
            },
            {
              "text": "Warudie … Israeli:",
              "type": "text"
            },
            {
              "text": "Au Rudi, ee Mwenyezi-Mungu, wa maelfu na maelfu ya Israeli.",
              "type": "text"
            }
          ]
        }
