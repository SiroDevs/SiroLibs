{
  "id": "NUM.9",
  "number": "9",
  "bookId": "NUM",
  "reference": "Hesabu 9",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
