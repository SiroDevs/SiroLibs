          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Siku ya pili mtatoa: Fahali wachanga kumi na wawili, kondoo madume wawili, wanakondoo wa kiume kumi na wanne, wa mwaka mmoja wasio na dosari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.17",
            "verseOrgIds": [
              "NUM.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
