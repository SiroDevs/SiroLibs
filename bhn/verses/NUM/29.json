          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtatoa pia sadaka ya nafaka na sadaka za vinywaji pamoja na wale fahali, kondoo na wanakondoo, kulingana na idadi yao. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.18",
            "verseOrgIds": [
              "NUM.29.18"
            ]
          }
