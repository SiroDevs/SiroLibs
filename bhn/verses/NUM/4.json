          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utawahesabu wanaume wote wenye umri kati ya miaka thelathini na hamsini, wanaofaa kujiunga na huduma ya hema la mkutano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.30",
            "verseOrgIds": [
              "NUM.4.30"
            ]
          }
        },
        {
