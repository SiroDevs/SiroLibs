          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wao, watakuwa na wajibu na kubeba mbao, mataruma, nguzo na misingi ya hema la mkutano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
              "NUM.4.31"
            ]
          }
        },
        {
