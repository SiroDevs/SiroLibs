              "type": "text"
            }
          ]
        },
        {
          "text": "“Kadhalika, utawahesabu wana wa Merari, kufuatana na jamaa zao na koo zao. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.29",
            "verseOrgIds": [
              "NUM.4.29"
