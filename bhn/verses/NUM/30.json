          "items": [
            {
              "text": "Taz Kumb 23:21-23; Mat 5:33",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kisha Mose alizungumza na viongozi wa makabila ya Israeli, akawaambia, “Hili ndilo neno lililoamriwa na Mwenyezi-Mungu:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
