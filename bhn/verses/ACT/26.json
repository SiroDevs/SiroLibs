              "type": "text"
            }
          ]
        },
        {
          "text": "Walipokwisha ondoka, waliambiana, “Mtu huyu hakufanya chochote kinachostahili adhabu ya kifo au kifungo.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.31",
