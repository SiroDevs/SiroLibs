          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.31",
            "verseOrgIds": [
              "ACT.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
