          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msiwe kikwazo kwa Wayahudi au kwa Wagiriki au kwa kanisa la Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.32",
            "verseOrgIds": [
