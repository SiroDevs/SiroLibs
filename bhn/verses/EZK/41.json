              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Milango hiyo ilikuwa ya tarabe, kwa hiyo kila mlango uliweza kufunguka katikati.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.24",
