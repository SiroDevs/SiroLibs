        },
        {
          "text": "Kulikuwako na mlango wa tarabe wa kuingia kwenye ukumbi wa hekalu na mlango wa tarabe wa kuingia mahali patakatifu kabisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.23",
