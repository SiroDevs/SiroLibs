              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pembeni mwa chumba hiki, kulikuwa na madirisha madogo na kuta zilipambwa kwa michoro ya mitende.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.26",
