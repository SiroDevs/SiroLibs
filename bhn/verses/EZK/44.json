          },
          "items": [
            {
              "text": "44:29-30 Taz Hes 18:8-19",
              "type": "text"
            }
          ]
        },
        {
          "text": " Watakula sadaka ya nafaka, sadaka ya kuondoa dhambi, na sadaka ya kuondoa hatia. Kila kitu katika Israeli kilichowekwa wakfu kwa Mungu kitakuwa chao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.29",
            "verseOrgIds": [
              "EZK.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
