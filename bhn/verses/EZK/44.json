            "number": "30",
            "style": "v",
            "sid": "EZK 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vitu vyote vilivyo bora vya malimbuko yenu na vya matoleo yenu ya kila aina vitakuwa kwa ajili ya makuhani. Tena mtawapa sehemu ya kwanza ya unga wenu, ili mlete baraka juu ya nyumba zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.30",
            "verseOrgIds": [
              "EZK.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makuhani hawatakula nyama ya mnyama au ndege yeyote aliyekufa mwenyewe au aliyeraruliwa na mnyama wa porini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.31",
