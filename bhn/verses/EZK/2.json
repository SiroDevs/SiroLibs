          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.7",
            "verseOrgIds": [
              "EZK.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lakini ewe mtu, sikiliza ninayokuambia, wala usiwe mwasi kama watu hao. Fumbua kinywa chako, ule ninachokupa.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.8",
            "verseOrgIds": [
              "EZK.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:9-10 Taz Ufu 5:1",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nilipotazama, niliona nimenyoshewa mkono, na kumbe ulikuwa na kitabu kilichoandikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.9",
            "verseOrgIds": [
              "EZK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi akakifungua mbele yangu, nacho kilikuwa kimeandikwa mbele na nyuma maneno ya maombolezo, vilio na laana.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.10",
            "verseOrgIds": [
              "EZK.2.10"
            ]
          }
        }
      ]
    }
