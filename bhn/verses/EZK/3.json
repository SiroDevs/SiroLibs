          },
          "items": [
            {
              "text": "3:1-3 Taz Ufu 10:9-10",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akaniambia, “Wewe mtu, kula unachopewa; kula kitabu hiki kisha uende ukawaeleze Waisraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.1",
            "verseOrgIds": [
              "EZK.3.1"
            ]
          }
        }
