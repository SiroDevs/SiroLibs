              "EZK.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.17",
            "verseOrgIds": [
              "EZK.39.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "39:17-20 Taz Ufu 19:17-18",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Sasa, ewe mtu, mimi Bwana Mwenyezi-Mungu nasema hivi: Waite ndege wote na wanyama wote wa porini wakusanyike toka pande zote na kuja kula karamu ya kafara ninayowaandalia, ambayo itakuwa kubwa sana juu ya milima ya Israeli, ambako watakula nyama na kunywa damu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.17",
            "verseOrgIds": [
              "EZK.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watakula nyama ya mashujaa, watakunywa damu ya wakuu wa dunia watakaochinjwa kama kondoo madume au wanakondoo, mbuzi au mafahali wanono wa Bashani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.18",
            "verseOrgIds": [
              "EZK.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika karamu hiyo ninayowafanyia watakula mafuta na kushiba. Watakunywa damu na kulewa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.19",
            "verseOrgIds": [
              "EZK.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mezani pangu, watashibishwa kwa farasi, wapandafarasi, mashujaa na watu wote wa vita. Mimi Bwana Mwenyezi-Mungu nimesema.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.20",
            "verseOrgIds": [
              "EZK.39.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.20",
            "verseOrgIds": [
              "EZK.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu aliniambia, “Nitayafanya mataifa yote yauone utukufu wangu, na kuwaonesha jinsi ninavyotumia nguvu yangu kutekeleza hukumu zangu za haki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.21",
            "verseOrgIds": [
              "EZK.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waisraeli watajua kuwa mimi ni Mwenyezi-Mungu, Mungu wao, tangu siku hiyo na baadaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.22",
            "verseOrgIds": [
              "EZK.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataifa yatajua kuwa Waisraeli walikwenda uhamishoni kutokana na makosa yao wenyewe waliyonikosea. Waliniasi, nami nikageuka wasinione, nikawaweka mikononi mwa maadui zao wakauawa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.23",
            "verseOrgIds": [
              "EZK.39.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niligeuka wasinione, nikawatenda kulingana na uchafu na makosa yao.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.24",
            "verseOrgIds": [
              "EZK.39.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.24",
            "verseOrgIds": [
              "EZK.39.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 39:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwa hiyo mimi Bwana Mwenyezi-Mungu nasema hivi: Sasa nitawahurumia Waisraeli wazawa wa Yakobo, na kuwarudishia fanaka yao. Daima nataka jina langu takatifu liheshimiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.25",
            "verseOrgIds": [
              "EZK.39.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watakapokuwa wanaishi kwa usalama katika nchi yao, bila ya kutishwa, watasahau aibu yao na uasi walionitenda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.26",
            "verseOrgIds": [
              "EZK.39.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 39:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo, nitakuwa nimewarudisha kutoka kwa mataifa na kuwakusanya kutoka nchi za maadui zao na kudhihirisha utakatifu wangu mbele ya mataifa mengi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.27",
            "verseOrgIds": [
              "EZK.39.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 39:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha watatambua kuwa mimi ni Mwenyezi-Mungu, Mungu wao, kwa sababu mimi niliwapeleka uhamishoni kati ya mataifa na kuwarudisha tena katika nchi yao. Sitamwacha hata mtu wao abaki miongoni mwa mataifa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.28",
            "verseOrgIds": [
              "EZK.39.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitakapowamiminia Waisraeli roho yangu, sitageuka tena wasinione. Mimi Bwana Mwenyezi-Mungu nimesema.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.29",
            "verseOrgIds": [
              "EZK.39.29"
            ]
          }
        }
      ]
