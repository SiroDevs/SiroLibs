              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:28-32 Taz Yer 49:1-6; Eze 25:1-7; Amo 1:3-15; Sef 2:8-11",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ewe mtu, tabiri kuhusu Waamoni na maneno yao ya dhihaka kwa Waisraeli: Waambie kuwa nasema:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.29",
            "verseOrgIds": [
              "EZK.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sasa rudisha upanga alani mwake! Nitawahukumu mahali palepale mlipoumbwa, katika nchi mlipozaliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.30",
            "verseOrgIds": [
              "EZK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitawamwagia ghadhabu yangu. Moto wa ghadhabu yangu nitaupuliza juu yenu. Nitawatia mikononi mwa watu wakatili, watu hodari wa kuangamiza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.31",
            "verseOrgIds": [
              "EZK.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtakuwa kuni motoni, damu yenu itamwagika katika nchi. Mtu hatawakumbuka tena. Mimi Mwenyezi-Mungu nimesema.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.32",
            "verseOrgIds": [
              "EZK.21.32"
            ]
          }
        }
      ]
    }
