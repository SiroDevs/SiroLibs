            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno la Mwenyezi-Mungu lilinijia: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.8",
            "verseOrgIds": [
              "EZK.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wewe mtu, toa unabii useme: Mwenyezi-Mungu asema hivi:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.9",
            "verseOrgIds": [
              "EZK.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
