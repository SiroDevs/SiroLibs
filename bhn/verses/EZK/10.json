              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.17",
            "verseOrgIds": [
              "EZK.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha utukufu wa Mwenyezi-Mungu ulitoka kwenye kizingiti cha nyumba, ukaenda na kusimama juu ya wale viumbe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.18",
            "verseOrgIds": [
              "EZK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Viumbe wakakunjua mabawa yao, wakapaa juu, mimi nikiwa nawaona na yale magurudumu yalikuwa kando yao. Wakasimama mbele ya lango la mashariki la nyumba ya Mwenyezi-Mungu, na utukufu wa Mungu wa Israeli ulikuwa juu yao.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.19",
            "verseOrgIds": [
              "EZK.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.19",
            "verseOrgIds": [
              "EZK.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa walikuwa wale viumbe hai niliowaona chini ya Mungu wa Israeli karibu na mto Kebari, nami nikatambua kuwa ni viumbe wenye mabawa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.20",
            "verseOrgIds": [
              "EZK.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila mmoja wao alikuwa na nyuso nne na mabawa manne; na chini ya kila bawa kulikuwa na kitu kama mkono wa binadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.21",
            "verseOrgIds": [
              "EZK.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vilevile nilizitambua nyuso zao: Zilikuwa zilezile nilizokuwa nimeziona kule kwenye mto Kebari. Kila kiumbe alikwenda mbele, moja kwa moja.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.22",
            "verseOrgIds": [
              "EZK.10.22"
            ]
          }
        }
      ]
    }
