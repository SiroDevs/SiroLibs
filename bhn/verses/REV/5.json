          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikasikia viumbe vyote mbinguni, duniani, chini ya dunia na baharini – viumbe vyote ulimwenguni – vikisema:",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.13",
            "verseOrgIds": [
              "REV.5.13"
            ]
          }
        }
