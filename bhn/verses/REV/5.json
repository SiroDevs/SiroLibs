            "verseId": "REV.5.13",
            "verseOrgIds": [
              "REV.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wale viumbe hai wanne wakasema, “Amina!” Na wale wazee wakaanguka kifudifudi, wakaabudu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.14",
