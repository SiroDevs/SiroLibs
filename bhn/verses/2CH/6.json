          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mvua isiponyesha kwa sababu wametenda dhambi dhidi yako, wakiomba wakielekea mahali hapa na kulikiri jina lako, pia wakiziacha dhambi zao, tafadhali ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwasikie kutoka huko mbinguni, na usamehe dhambi zao watumishi wako watu wako Waisraeli, huku ukiwafundisha kufuata njia nyofu, ukanyeshe mvua katika nchi yako hii ambayo uliwapa watu wako iwe mali yao.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        }
      ]
