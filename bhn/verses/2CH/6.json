          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ikiwa watatenda dhambi dhidi yako, maana hakuna mtu asiyetenda dhambi, na ukiwakasirikia na kuwaacha washindwe na adui, hata wapelekwe mateka mpaka nchi ya mbali au ya karibu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
