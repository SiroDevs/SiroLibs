          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "kama watakapokuwa huko uhamishoni watajirudi kwa roho yao yote na kwa moyo wao wote na kutubu na kukuomba msamaha, wakisema, ‘Tumetenda dhambi; tumepotoka na kufanya maovu’; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
