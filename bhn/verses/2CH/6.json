          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Vivyo hivyo wakati mgeni asiye mmoja wa watu wako Israeli atakuja kutoka nchi ya mbali kwa ajili ya jina lako kuu, na kwa sababu ya nguvu na ulinzi wako, kuomba katika nyumba hii, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakusihi umsikie toka huko kwako mbinguni, na umjalie huyo mgeni yote atakayokuomba kusudi watu wote ulimwenguni wapate kujua jina lako na kukutii kama wafanyavyo watu wako Israeli na wapate kufahamu kwamba nyumba hii ambayo nimeijenga inajulikana kwa jina lako.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        }
