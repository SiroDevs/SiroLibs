              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakusihi usikie sala yao na maombi yao ukiwa huko mbinguni na uwapatie ushindi vitani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        }
