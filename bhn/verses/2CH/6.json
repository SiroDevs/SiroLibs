              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "basi, nakusihi usikie huko mbinguni uliko sala yao na maombi yao na uwapatie haki zao, uwasamehe watu wako ambao wametenda dhambi dhidi yako.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
