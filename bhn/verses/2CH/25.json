          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matendo mengine yote ya Amazia kutoka mwanzo hadi mwisho yameandikwa katika Kitabu cha Habari za Wafalme wa Yuda na Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
