              "type": "text"
            }
          ]
        },
        {
          "text": "Amazia mfalme wa Yuda aliishi miaka kumi na mitano baada ya kifo cha mfalme Yehoashi mwana wa Yehoahazi mfalme wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
