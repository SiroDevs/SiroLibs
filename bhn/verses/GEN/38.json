              "type": "text"
            },
            {
              "text": "Peresi:",
              "type": "text"
            },
            {
              "text": "Kiebrania maana yake “kutoka kwa nguvu”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
