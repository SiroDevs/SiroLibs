        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
            "verseOrgIds": [
              "GEN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Mwenyezi-Mungu akasema, “Sasa, binadamu amekuwa kama mmoja wetu, anajua mema na mabaya. Lazima kumzuia kula lile tunda la mti wa uhai, kwani akilila ataishi milele!” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.22",
            "verseOrgIds": [
              "GEN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, Mwenyezi-Mungu akamfukuza Adamu nje ya bustani ya Edeni, ili akailime ardhi ambamo alitwaliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimfukuza nje, na kuweka mlinzi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.24",
            "verseOrgIds": [
              "GEN.3.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:24",
              "type": "text"
            },
            {
              "text": "Kiebrania: Kerubi au makerubi walifikiriwa kuwa viumbe wenye mabawa; Taz orodha ya maneno.",
              "type": "text"
            }
          ]
        },
        {
          "text": " upande wa mashariki wa bustani ya Edeni na upanga wa moto uliogeuka huko na huko, kuilinda njia iendayo kwenye mti wa uhai.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.24",
            "verseOrgIds": [
              "GEN.3.24"
            ]
          }
        }
      ]
