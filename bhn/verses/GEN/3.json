              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:20",
              "type": "text"
            },
            {
              "text": "Adamu:",
              "type": "text"
            },
            {
              "text": "Kiebrania maana yake ni “mtu.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " akampa mkewe jina “Hawa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:20",
              "type": "text"
            },
            {
              "text": "Hawa:",
              "type": "text"
            },
            {
              "text": "Kiebrania lalingana na neno lenye maana “uhai,”",
              "type": "text"
            }
          ]
        },
        {
          "text": "”, kwani alikuwa mama wa binadamu wote. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu akawatengenezea Adamu na mkewe mavazi ya ngozi, akawavika.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
            "verseOrgIds": [
              "GEN.3.21"
            ]
          }
        }
      ]
    },
    {
