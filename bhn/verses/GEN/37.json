          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo, kule Misri, wale Wamidiani walimwuza Yosefu kwa mtu aitwaye Potifa, mmoja wa maofisa wa Farao, ambaye alikuwa mkuu wa kikosi cha ulinzi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.36",
            "verseOrgIds": [
              "GEN.37.36"
            ]
