              "type": "text"
            }
          ]
        },
        {
          "text": "Wafuatao ni wazawa wa Shemu. Miaka miwili baada ya ile gharika, Shemu akiwa na umri wa miaka 100, alimzaa Arfaksadi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya kumzaa Arfaksadi, Shemu aliishi miaka 500 na kupata watoto wengine wa kiume na wa kike.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
      ]
    },
