          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafuatao ni wazawa wa Tera, baba yao Abramu, Nahori na Harani. Harani alikuwa baba yake Loti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.27",
            "verseOrgIds": [
              "GEN.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huyo Harani alifariki wakati Tera baba yake alikuwa anaishi huko Uri alikokuwa amezaliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.28",
            "verseOrgIds": [
              "GEN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu na Nahori walioa. Mke wa Abramu aliitwa Sarai. Mke wa Nahori aliitwa Milka, binti Harani ambaye pia alikuwa baba yake Iska. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.29",
            "verseOrgIds": [
              "GEN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sarai hakuwa na mtoto kwa sababu alikuwa tasa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.30",
            "verseOrgIds": [
              "GEN.11.30"
            ]
          }
        }
      ]
