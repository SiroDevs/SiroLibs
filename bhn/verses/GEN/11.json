              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera alipokuwa na umri wa miaka 70, alimzaa Abramu na Nahori na Harani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.26",
            "verseOrgIds": [
              "GEN.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
