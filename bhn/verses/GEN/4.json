          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.22",
            "verseOrgIds": [
              "GEN.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lameki akawaambia wake zake,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.23",
            "verseOrgIds": [
              "GEN.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.24",
            "verseOrgIds": [
              "GEN.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu akalala tena na Hawa mkewe, naye akazaa mtoto wa kiume, akamwita Sethi akisema, “Mungu amenijalia mtoto mahali pa Abeli aliyeuawa na Kaini.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.25",
            "verseOrgIds": [
              "GEN.4.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:25",
              "type": "text"
            },
            {
              "text": "Sethi:",
              "type": "text"
            },
            {
              "text": "Katika Kiebrania jina Sethi ladokezea maneno yaliyotumiwa hapa: “Mungu amenijalia”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.25",
            "verseOrgIds": [
              "GEN.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sethi naye alipata mtoto wa kiume, akamwita Enoshi. Hapo ndipo watu walipoanza kumwomba Mwenyezi-Mungu kwa jina lake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.26",
            "verseOrgIds": [
              "GEN.4.26"
            ]
          }
        }
      ]
    }
  ],
