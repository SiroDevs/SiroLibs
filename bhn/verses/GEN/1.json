          "items": [
            {
              "text": "Taz Mwa 5:1-2",
              "type": "text"
            }
          ]
        },
        {
          "text": " Basi, Mungu akaumba mtu kwa mfano wake; naam, kwa mfano wake Mungu alimuumba. Aliwaumba mwanamume na mwanamke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
            "verseOrgIds": [
              "GEN.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu akawabariki na kuwaambia, “Zaeni muongezeke, mkaijaze nchi na kuimiliki; muwatawale samaki wa baharini, ndege wa angani, na kila kiumbe hai kitembeacho duniani.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.28",
            "verseOrgIds": [
              "GEN.1.28"
            ]
          }
        }
      ]
