      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.30",
            "verseOrgIds": [
              "GEN.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu alipoona kwamba Lea anachukiwa, akamjalia watoto; lakini Raheli alikuwa tasa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
              "GEN.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea akapata mimba, akajifungua mtoto wa kiume, akamwita Reubeni,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
              "GEN.29.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:32",
              "type": "text"
            },
            {
              "text": "Reubeni:",
              "type": "text"
            },
            {
              "text": "Ni kama neno la Kiebrania lenye maana “Tazama, mwana” au “Ameona taabu zangu”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akisema, “Mwenyezi-Mungu ameyaona mateso yangu; bila shaka sasa mume wangu atanipenda.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
              "GEN.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea akapata mimba tena, akajifungua mtoto wa kiume, akamwita Simeoni,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:33",
              "type": "text"
            },
            {
              "text": "Simeoni:",
              "type": "text"
            },
            {
              "text": "Ni kama neno la Kiebrania lenye maana “Sikia”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akisema, “Mwenyezi-Mungu amenipa mtoto mwingine wa kiume kwa sababu amesikia jinsi ninavyochukiwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapata mimba mara nyingine, akajifungua mtoto wa kiume, akamwita Lawi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:34",
              "type": "text"
            },
            {
              "text": "Lawi:",
              "type": "text"
            },
            {
              "text": "Ni kama neno la Kiebrania lenye maana “Jiunga”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akisema, “Wakati huu mume wangu atajiunga nami, kwani nimemzalia watoto watatu wa kiume.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea akapata mimba tena, akajifungua mtoto wa kiume, akamwita Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.35",
            "verseOrgIds": [
              "GEN.29.35"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:35",
              "type": "text"
            },
            {
              "text": "Yuda:",
              "type": "text"
            },
            {
              "text": "Ni kama neno la Kiebrania lenye maana “Sifu”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akisema, “Safari hii nitamsifu Mwenyezi-Mungu.” Kisha Lea akaacha kuzaa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.35",
            "verseOrgIds": [
              "GEN.29.35"
            ]
          }
        }
      ]
    }
