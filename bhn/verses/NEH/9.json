            "sid": "NEH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuliwekwa jukwaa la Walawi; hapo walisimama Yeshua, Bani, Kadmieli, Shebania, Buni, Sherebia, Bani na Kenani. Wakamwomba kwa sauti kubwa Mwenyezi-Mungu, Mungu wao.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.4",
            "verseOrgIds": [
              "NEH.9.4"
            ]
          }
        }
      ]
