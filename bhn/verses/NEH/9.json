              "type": "text"
            }
          ]
        },
        {
          "text": "Walawi, yaani: Yeshua, Kadmieli, Bani, Hashabuea, Sherebia, Hodia, Shebania na Pethahia wakawaambia watu;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.5",
