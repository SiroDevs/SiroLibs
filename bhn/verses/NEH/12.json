          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Viongozi wa Walawi: Hashabia, Sherebia, Yeshua mwana wa Kadmieli walisimama mkabala na ndugu zao; walipangwa kuimba nyimbo za kusifu na kushukuru, kufuatana na amri ya mfalme Daudi, mtu wa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.24",
            "verseOrgIds": [
              "NEH.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabawabu walikuwa: Matania, Bakbukia, Obadia, Meshulamu, Talmoni na Akubu; pia hao walikuwa walinzi wa ghala.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.25",
            "verseOrgIds": [
              "NEH.12.25"
            ]
          }
        }
      ]
    },
    {
