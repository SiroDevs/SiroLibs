          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wa Eliashibu, Yoyada, Yohanani na Yadua wakuu wa jamaa za Walawi, waliorodheshwa; vilevile wakati wa utawala wa mfalme Dario wakuu wa jamaa za makuhani waliorodheshwa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.22",
            "verseOrgIds": [
              "NEH.12.22"
            ]
          }
        }
      ]
