            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifuatayo ni orodha ya makuhani na Walawi waliorudi kutoka uhamishoni pamoja na Zerubabeli, mwana wa Shealtieli, na kuhani mkuu Yeshua.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.1",
            "verseOrgIds": [
              "NEH.12.1"
            ]
          }
        }
      ]
    },
    {
