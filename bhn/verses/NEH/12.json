          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa Yoaribu, Matenai; wa Yedaya, Uzi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.19",
            "verseOrgIds": [
              "NEH.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
