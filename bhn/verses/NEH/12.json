              "text": "12:17",
              "type": "text"
            },
            {
              "text": "ukoo wa Miniamini:",
              "type": "text"
            },
            {
              "text": "Jina la mkuu wa ukoo huu halipo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " wa Moadia, Piltai; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.17",
            "verseOrgIds": [
              "NEH.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa Bilga, Shamua; wa Shemaya, Yehonathani; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.18",
            "verseOrgIds": [
              "NEH.12.18"
            ]
          }
        },
