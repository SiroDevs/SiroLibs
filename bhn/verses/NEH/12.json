            "sid": "NEH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makuhani: Seraya, Yeremia, Ezra, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.1",
            "verseOrgIds": [
              "NEH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaria, Maluki, Hatushi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.2",
            "verseOrgIds": [
              "NEH.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shekania, Rehumu, Meremothi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.3",
            "verseOrgIds": [
              "NEH.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido, Ginethoni, Abiya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.4",
            "verseOrgIds": [
              "NEH.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miyamini, Maadia, Bilga, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.5",
            "verseOrgIds": [
              "NEH.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemaya, Yoyaribu, Yedaya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.6",
            "verseOrgIds": [
              "NEH.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salu, Amoki, Hilkia na Yedaya. Hao walikuwa ni wakuu wa makuhani na ndugu zao wakati wa Yeshua.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.7",
            "verseOrgIds": [
              "NEH.12.7"
            ]
          }
        }
      ]
    },
    {
