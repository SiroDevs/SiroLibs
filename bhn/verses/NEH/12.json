            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu hao waliishi wakati wa Yoyakimu, mwana wa Yeshua mwana wa Yosadaki na pia wakati wa Nehemia aliyekuwa mtawala wa mkoa; na hata wakati wa Ezra kuhani na mwandishi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.26",
            "verseOrgIds": [
              "NEH.12.26"
            ]
          }
        }
      ]
