          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Usijifanyie sanamu za miungu za kuchonga, wala mfano wa kitu chochote kilicho juu mbinguni, wala kilicho chini duniani, wala kilicho majini chini ya dunia.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.8",
            "verseOrgIds": [
              "DEU.5.8"
            ]
          }
        }
