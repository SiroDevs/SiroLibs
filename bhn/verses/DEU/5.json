          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Usiwe na miungu mingine ila mimi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.7",
            "verseOrgIds": [
              "DEU.5.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:7",
              "type": "text"
            },
            {
              "text": "Usiwe … mimi:",
              "type": "text"
            },
            {
              "text": "Au Usiwe na miungu mingine zaidi yangu.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
