              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwa ajili ya mlango wa hema utatengeneza pazia zito kwa sufu ya rangi ya buluu, zambarau na nyekundu, na kitani safi iliyosokotwa, na kutariziwa vizuri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.36",
            "verseOrgIds": [
              "EXO.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
