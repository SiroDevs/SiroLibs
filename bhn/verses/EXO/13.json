              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.10",
            "verseOrgIds": [
              "EXO.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akaendelea kuwaambia watu, “Hali kadhalika, wakati Mwenyezi-Mungu atakapowafikisha katika nchi ya Wakanaani na kuwapeni iwe mali yenu kama alivyowaapia nyinyi na babu zenu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.11",
            "verseOrgIds": [
              "EXO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Kut 34:19-20; Luka 2:23",
              "type": "text"
            }
          ]
        },
        {
          "text": " lazima kumwekea Mwenyezi-Mungu kila mzaliwa wenu wa kwanza wa kiume. Kila mzaliwa wa kwanza wa kiume wa mifugo yenu atakuwa wa Mwenyezi-Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.12",
            "verseOrgIds": [
              "EXO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mzaliwa wa kwanza wa kiume wa punda utamkomboa kwa kulipa mwanakondoo, la sivyo, utamuua kwa kumvunja shingo. Kila mzaliwa wa kwanza wa kiume wa binadamu utamkomboa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.13",
            "verseOrgIds": [
              "EXO.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama hapo baadaye mwanao akiuliza maana ya jambo hili, utamwambia, ‘Kwa nguvu ya mkono wake, Mwenyezi-Mungu alitutoa nchini Misri ambako tulikuwa watumwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.14",
            "verseOrgIds": [
              "EXO.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao kwa ukaidi alikataa kutuachia tuondoke; kwa hiyo Mwenyezi-Mungu alimuua kila mzaliwa wa kwanza nchini Misri, mzaliwa wa kwanza wa binadamu na wa mnyama. Basi, mimi ninamtolea sadaka Mwenyezi-Mungu kila mzaliwa wa kwanza wa kiume wa mifugo yangu, lakini kila mzaliwa wa kwanza wa wanangu namkomboa.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.15",
            "verseOrgIds": [
              "EXO.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jambo hili litakuwa kama alama mkononi mwako au utepe katika paji la uso wako, kwamba Mwenyezi-Mungu alitutoa nchini Misri kwa mkono wenye nguvu.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.16",
            "verseOrgIds": [
              "EXO.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.16",
            "verseOrgIds": [
              "EXO.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati Farao alipowaachia Waisraeli waende zao, Mungu hakuwapitisha katika nchi ya Wafilisti, ingawa njia hiyo ilikuwa ya karibu. Mungu alisema, “Sipendi watu hawa wabadilishe nia na kurudi Misri wakijua itawabidi kupigana vita.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.17",
            "verseOrgIds": [
              "EXO.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badala yake, Mungu aliwapitisha Waisraeli katika njia ya mzunguko kupitia jangwani, kuelekea bahari ya Shamu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.18",
            "verseOrgIds": [
              "EXO.13.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:18",
              "type": "text"
            },
            {
              "text": "bahari ya Shamu:",
              "type": "text"
            },
            {
              "text": "Kiebrania neno kwa neno ni “bahari ya mafunjo”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Waisraeli waliondoka nchini Misri wakiwa wamejiandaa kwa vita.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.18",
            "verseOrgIds": [
              "EXO.13.18"
            ]
          }
        }
      ]
    },
