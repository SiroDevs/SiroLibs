            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.19",
            "verseOrgIds": [
              "EXO.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, Waisraeli waliondoka Sukothi, wakapiga kambi huko Ethamu, ukingoni mwa jangwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.20",
            "verseOrgIds": [
              "EXO.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mchana Mwenyezi-Mungu aliwatangulia katika mnara wa wingu kuwaonesha njia, na usiku aliwatangulia katika mnara wa moto kuwaangazia, ili waweze kusafiri mchana na usiku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.21",
            "verseOrgIds": [
              "EXO.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Hek 10:17-18; 18:3",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mnara wa wingu wakati wa mchana, na mnara wa moto wakati wa usiku, kamwe haikukosekana kuwatangulia Waisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.22",
            "verseOrgIds": [
              "EXO.13.22"
            ]
          }
