        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Kut 23:1 Mat 19:18; Marko 10:19; Luka 18:20",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Usimshuhudie jirani yako uongo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.16",
            "verseOrgIds": [
              "EXO.20.16"
            ]
