              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wala msitengeneze madhabahu yenye ngazi za kupandia, mtu asije akauona uchi wa huyo anayepanda juu yake.’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.26",
            "verseOrgIds": [
              "EXO.20.26"
            ]
