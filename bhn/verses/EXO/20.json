        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Lawi 19:12; Kumb 18:20; Roma 13:9; Yak 2:11",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Usilitaje bure jina langu mimi Mwenyezi-Mungu, Mungu wako. Maana mimi Mwenyezi-Mungu sitaacha kumwadhibu anayetumia jina langu vibaya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.7",
            "verseOrgIds": [
              "EXO.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
