              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wote walisimama mbali wakati Mose alipokaribia lile wingu zito alimokuwamo Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.21",
