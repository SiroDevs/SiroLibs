            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Kumb 27:5-7; Yosh 8:31",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kama mkinijengea madhabahu ya mawe, msiitengeneze kwa mawe ya kuchonga, maana mkitumia vyombo vya kuchongea mawe, mtaitia najisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.25",
            "verseOrgIds": [
              "EXO.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
