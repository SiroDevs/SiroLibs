              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu akamwambia Mose, “Waambie Waisraeli: ‘Mmejionea nyinyi wenyewe kwamba nimeongea nanyi kutoka mbinguni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.22",
            "verseOrgIds": [
              "EXO.20.22"
            ]
          }
        },
