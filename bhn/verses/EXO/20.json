            "sid": "EXO 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Waheshimu baba yako na mama yako, ili uishi maisha marefu katika nchi ninayokupa mimi Mwenyezi-Mungu, Mungu wako.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.12",
            "verseOrgIds": [
              "EXO.20.12"
            ]
          }
        }
      ]
    },
