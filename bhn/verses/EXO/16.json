            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:31",
              "type": "text"
            },
            {
              "text": "Mana:",
              "type": "text"
            },
            {
              "text": "Neno la Kiebrania lasikika kuwa na maana ya “Nini hiki?” taz. 16:15.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kilikuwa kama mbegu za mtama mweupe na ladha yake ilikuwa kama mkate mwembamba uliotiwa asali. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akawaambia, “Hili ndilo agizo la Mwenyezi-Mungu: Chukueni kiasi cha pishi moja ya mana na kuiweka kwa ajili ya wazawa wenu, ili waweze kuona chakula nilichowalisha jangwani wakati nilipowatoa nchini Misri.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        }
