              "text": "Taz Hes 11:7-8",
              "type": "text"
            }
          ]
        },
        {
          "text": " Waisraeli walikiita chakula hicho “Mana.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        },
        {
          "name": "note",
