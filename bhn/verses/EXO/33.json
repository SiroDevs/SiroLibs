              "EXO.33.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Mwa 12:7; 26:3; 28:13",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwenyezi-Mungu akamwambia Mose, “Anza safari uondoke hapa, wewe na watu hao uliowatoa nchini Misri, mwende katika nchi niliyomwapia Abrahamu, Isaka na Yakobo, nikisema, ‘Nitawapa wazawa wenu nchi hii’. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.1",
            "verseOrgIds": [
              "EXO.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitamtuma malaika awaongoze; nitawafukuza Wakaanani, Waamori, Wahiti, Waperizi, Wahivi na Wayebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.2",
            "verseOrgIds": [
              "EXO.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nendeni katika nchi hiyo inayotiririka maziwa na asali. Lakini kwa sababu nyinyi ni wenye vichwa vigumu sitakwenda pamoja nanyi, nisije nikawaangamiza njiani.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.3",
            "verseOrgIds": [
              "EXO.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.3",
            "verseOrgIds": [
              "EXO.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu walilia waliposikia habari hizi mbaya; wala hakuna aliyevaa mapambo yake. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.4",
            "verseOrgIds": [
              "EXO.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walifanya hivyo kwani Mwenyezi-Mungu alikuwa amemwambia Mose, “Waambie Waisraeli, ‘Nyinyi ni watu wenye vichwa vigumu; nikienda pamoja nanyi kwa muda mfupi tu, nitawaangamiza. Hivyo vueni mapambo yenu ili nijue namna ya kuwatendea.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.5",
            "verseOrgIds": [
              "EXO.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, Waisraeli waliyavua mapambo yao tangu walipoondoka mlimani Horebu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.6",
            "verseOrgIds": [
              "EXO.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.6",
            "verseOrgIds": [
              "EXO.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose alikuwa na desturi ya kulichukua lile hema na kulisimika nje ya kambi. Hema hilo alilipa jina, Hema la Mkutano. Mtu yeyote aliyetaka shauri kwa Mwenyezi-Mungu alikwenda kwenye hema la mkutano nje ya kambi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.7",
            "verseOrgIds": [
              "EXO.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila mara Mose alipotoka kwenda kwenye hema hilo, kila mtu alisimama penye mlango wa hema lake na kumwangalia Mose mpaka alipoingia ndani ya hilo hema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.8",
            "verseOrgIds": [
              "EXO.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati Mose alipoingia ndani ya hilo hema, mnara wa wingu ulitua kwenye mlango wa hema, na Mwenyezi-Mungu akaongea naye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.9",
            "verseOrgIds": [
              "EXO.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wote walipouona ule mnara wa wingu umesimama mlangoni mwa hema, kila mmoja wao alisimama na kuabudu mlangoni mwa hema lake. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.10",
            "verseOrgIds": [
              "EXO.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo ndivyo Mwenyezi-Mungu alivyokuwa akiongea na Mose uso kwa uso, kama mtu na rafiki yake. Kisha Mose alirudi tena kambini. Naye kijana Yoshua mwana wa Nuni ambaye alikuwa mtumishi wake hakuondoka hemani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.11",
            "verseOrgIds": [
              "EXO.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.11",
            "verseOrgIds": [
              "EXO.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akamwambia Mwenyezi-Mungu, “Tazama! Wewe waniambia, ‘Waongoze watu hawa,’ lakini hujanijulisha ni nani utakayemtuma anisaidie. Hata hivyo umesema kwamba unanijua kwa jina na pia kwamba nimepata fadhili mbele zako. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.12",
            "verseOrgIds": [
              "EXO.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa basi, nakusihi, kama kweli nimepata fadhili mbele yako, nioneshe sasa njia zako, ili nipate kukujua na kupata fadhili mbele zako. Naomba ukumbuke pia kwamba taifa hili ni watu wako.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.13",
            "verseOrgIds": [
              "EXO.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.13",
            "verseOrgIds": [
              "EXO.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu akasema, “Mimi mwenyewe nitakwenda pamoja nawe, na nitakupa faraja.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.14",
            "verseOrgIds": [
              "EXO.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akasema, “Kama wewe binafsi hutakwenda pamoja nami, basi, usituondoe mahali hapa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.15",
            "verseOrgIds": [
              "EXO.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana nitajuaje kuwa nimepata fadhili mbele zako, mimi na watu wako kama usipokwenda pamoja nasi? Ukienda pamoja nasi itatufanya mimi na watu wako kuwa watu wa pekee miongoni mwa watu wote duniani.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.16",
            "verseOrgIds": [
              "EXO.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.16",
            "verseOrgIds": [
              "EXO.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu akamwambia Mose, “Kwa kuwa umepata fadhili mbele yangu, nami nakujua kwa jina lako, jambo hilihili ulilolisema nitalifanya.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.17",
            "verseOrgIds": [
              "EXO.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akasema, “Nakusihi unioneshe utukufu wako.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.18",
            "verseOrgIds": [
              "EXO.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Rom 9:15",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwenyezi-Mungu akamjibu, “Nitapita mbele yako na kukuonesha wema wangu wote nikilitangaza jina langu, ‘Mwenyezi-Mungu’. Mimi nitamrehemu yule ninayependa kumrehemu, na kumhurumia yule ninayependa kumhurumia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.19",
            "verseOrgIds": [
              "EXO.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini hutaweza kuniona uso maana hakuna mwanadamu yeyote atakayeniona na kuishi.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.20",
            "verseOrgIds": [
              "EXO.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Mwenyezi-Mungu akamwambia Mose, “Kuna mahali karibu nami ambapo utasimama juu ya mwamba; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.21",
            "verseOrgIds": [
              "EXO.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na utukufu wangu utakapokuwa unapita, nitakutia katika pango mwambani na kukufunika kwa mkono wangu, mpaka nitakapokuwa nimepita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.22",
            "verseOrgIds": [
              "EXO.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halafu nitauondoa mkono wangu nawe utaniona nyuma, lakini uso wangu hutauona.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.23",
            "verseOrgIds": [
              "EXO.33.23"
            ]
          }
        }
      ]
    }
  ],
