          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.17",
            "verseOrgIds": [
              "2TH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunawatakieni nyote neema ya Bwana wetu Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.18",
            "verseOrgIds": [
              "2TH.3.18"
            ]
          }
        }
