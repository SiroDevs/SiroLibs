              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ile, watu wote watasema, “Huyu ndiye Mungu wetu! Tumemngojea atuokoe. Huyu ndiye Mwenyezi-Mungu tuliyemtazamia. Njoni tufurahi na kushangilia kwa kuwa ametuokoa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
