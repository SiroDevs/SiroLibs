        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:10-12 Taz Isa 15:1--16:14; Yer 48:1-47; Eze 25:8-11; Amo 2:1-3; Sef 2:8-11",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwenyezi-Mungu ataulinda mlima wa Siyoni, lakini watu wa Moabu watakanyagwakanyagwa nchini mwao kama nyasi katika shimo la mbolea. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.10",
            "verseOrgIds": [
              "ISA.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watainyosha mikono yao kama mtu anayejaribu kuogelea, lakini pamoja na ustadi wao, Mwenyezi-Mungu ataporomosha kiburi chao. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.11",
            "verseOrgIds": [
              "ISA.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atayabomoa maboma ya miji ya Moabu yenye kuta ndefu na kuyabwaga chini mavumbini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.12",
            "verseOrgIds": [
              "ISA.25.12"
            ]
          }
        }
      ]
