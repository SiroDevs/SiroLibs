              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe, ee Mwenyezi-Mungu, ndiwe Mungu wangu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.1",
            "verseOrgIds": [
              "ISA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.5",
            "verseOrgIds": [
              "ISA.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juu ya mlima Siyoni, Mwenyezi-Mungu wa majeshi atawafanyia watu wote karamu ya vinono na divai nzuri, nyama tamu na mafuta, pamoja na divai safi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mlima huuhuu, Mwenyezi-Mungu ataliondoa wingu la huzuni lililowafunika watu wote, kifuniko cha uchungu juu ya mataifa yote. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.7",
            "verseOrgIds": [
              "ISA.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:8 Taz 1Kor 15:54; Ufu 7:17; 21:4",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwana Mungu atakiangamiza kifo milele! Atayafuta machozi katika nyuso za watu wote na kuwaondolea watu wake aibu duniani kote. Bwana Mwenyezi-Mungu ametamka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
