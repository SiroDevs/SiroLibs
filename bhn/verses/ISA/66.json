        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "66:24 Taz Marko 9:48",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kisha watakwenda kuziona maiti za wale walioniasi. Wadudu watakaowala hawatakufa, na moto utakaowachoma hautazimika kamwe. Watakuwa chukizo kwa watu wote.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.24",
            "verseOrgIds": [
              "ISA.66.24"
            ]
          }
        }
      ]
