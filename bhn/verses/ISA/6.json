          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na juu yake walikuwa wamekaa malaika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:2",
              "type": "text"
            },
            {
              "text": "malaika:",
              "type": "text"
            },
            {
              "text": "Au Maserafi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kila mmoja alikuwa na mabawa sita: Mawili ya kufunika uso, mawili ya kufunika mwili na mawili ya kurukia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
