            "style": "v",
            "sid": "ISA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye akinigusa nalo mdomoni, akasema: “Tazama, kaa hili limekugusa mdomo; umeondolewa hatia yako, umesamehewa dhambi yako.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.7",
            "verseOrgIds": [
              "ISA.6.7"
            ]
