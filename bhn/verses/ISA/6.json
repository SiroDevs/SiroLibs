              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, mmoja wa hao malaika akaruka kunijia, akiwa ameshika mkononi koleo lililokuwa na kaa la moto alilolitwaa madhabahuni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.6",
            "verseOrgIds": [
              "ISA.6.6"
            ]
