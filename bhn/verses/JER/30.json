              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno lililomjia Yeremia kutoka kwa Mwenyezi-Mungu: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.1",
            "verseOrgIds": [
              "JER.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mimi Mwenyezi-Mungu, Mungu wa Israeli, nasema hivi: Yaandike katika kitabu maneno yote niliyokuambia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana siku zaja ambapo nitawarudishia fanaka zao watu wangu wa Israeli na Yuda na kuwarudisha katika nchi niliyowapa wazee wao, nao wataimiliki. Mimi Mwenyezi-Mungu nimesema.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
