          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu wa majeshi asema hivi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.17",
            "verseOrgIds": [
              "JER.9.17"
            ]
          }
        }
