          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu asema: “Siku zaja ambapo nitawaadhibu wote waliotahiriwa mwilini tu: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.25",
            "verseOrgIds": [
              "JER.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamisri, Wayuda, Waedomu, Waamoni, Wamoabu na wakazi wote wa jangwani wanaonyoa denge.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.26",
            "verseOrgIds": [
              "JER.9.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:26",
              "type": "text"
            },
            {
              "text": "wanaonyoa denge:",
              "type": "text"
            },
            {
              "text": "Watu hao walinyoa denge kwa heshima ya mungu wao, desturi ambayo Waisraeli walikatazwa (taz Lawi 19:27).",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maana watu hawa wote na Waisraeli wote hawakutahiriwa moyoni.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.26",
            "verseOrgIds": [
              "JER.9.26"
            ]
          }
        }
      ]
