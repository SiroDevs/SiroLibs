  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "MIC 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anayankhula ndi Mika wa ku Moreseti pa nthawi ya ulamuliro wa Yotamu, Ahazi ndi Hezekiya, mafumu a ku Yuda. Awa ndi masomphenya amene iye anaona onena za Samariya ndi Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.1",
            "verseOrgIds": [
              "MIC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamverani, inu anthu a mitundu yonse,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:2"
      },
      "items": [
        {
          "text": "mvetsera iwe dziko lapansi ndi okhala mʼmenemo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:2"
      },
      "items": [
        {
          "text": "pakuti Ambuye Yehova achitira umboni wokutsutsani,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:2"
      },
      "items": [
        {
          "text": "Ambuye akuyankhula ali mʼnyumba yake yopatulika.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiweruzo cha Samariya ndi Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taonani! Yehova akubwera kuchokera ku malo ake;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.3",
            "verseOrgIds": [
              "MIC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:3"
      },
      "items": [
        {
          "text": "Iye akutsika ndipo akuponda pa malo okwera a dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.3",
            "verseOrgIds": [
              "MIC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapiri akusungunuka pansi pake,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:4"
      },
      "items": [
        {
          "text": "ndipo zigwa zikugawikana",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:4"
      },
      "items": [
        {
          "text": "ngati phula pa moto,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:4"
      },
      "items": [
        {
          "text": "ngati madzi ochokera mʼphiri.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonsezi ndi chifukwa cha cholakwa cha Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "chifukwa cha machimo a nyumba ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Kodi cholakwa cha Yakobo nʼchiyani?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Kodi si Samariya?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Kodi malo achipembedzo a Yuda ndi ati?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Kodi si Yerusalemu?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Choncho Ine ndidzasandutsa Samariya kukhala bwinja,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:6"
      },
      "items": [
        {
          "text": "malo odzalamo mphesa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:6"
      },
      "items": [
        {
          "text": "Miyala yake ndidzayitaya ku chigwa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:6"
      },
      "items": [
        {
          "text": "ndipo ndidzafukula maziko ake.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafano ake onse ndidzawaphwanyaphwanya;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "mphatso zake zonse ndidzazitentha ndi moto;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "ndidzawononga zifanizo zonse za milungu yake.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "Popeza analandira mphatso zake kuchokera ku malipiro a akazi achiwerewere,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "mphatsozonso zidzagwiritsidwa ntchito ndi ena ngati malipiro a akazi achiwerewere.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kulira ndi Kumva Chisoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa cha zimenezi ine ndidzalira momvetsa chisoni;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:8"
      },
      "items": [
        {
          "text": "ndidzayenda wopanda nsapato ndi wamaliseche.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:8"
      },
      "items": [
        {
          "text": "Ndidzafuwula ngati nkhandwe",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:8"
      },
      "items": [
        {
          "text": "ndi kulira ngati kadzidzi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti chilonda cha Samariya nʼchosachizika;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:9"
      },
      "items": [
        {
          "text": "chafika ku Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:9"
      },
      "items": [
        {
          "text": "Chafika pa chipata chenicheni cha anthu anga,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:9"
      },
      "items": [
        {
          "text": "mpaka mu Yerusalemu mwenimwenimo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musanene zimenezi ku Gati;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:10"
      },
      "items": [
        {
          "text": "musalire nʼkomwe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:10"
      },
      "items": [
        {
          "text": "Mugubuduzike mu fumbi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:10"
      },
      "items": [
        {
          "text": "ku Beti-Leafura.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu anthu okhala ku Safiro,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
              "MIC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:11"
      },
      "items": [
        {
          "text": "muzipita ku ukapolo muli amaliseche ndi amanyazi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
              "MIC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:11"
      },
      "items": [
        {
          "text": "Iwo amene akukhala ku Zanaani",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
              "MIC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:11"
      },
      "items": [
        {
          "text": "sadzatuluka.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
