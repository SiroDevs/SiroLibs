  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "HOS 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli anali mpesa wotambalala;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "anabereka zipatso zambiri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "Pamene zipatso zawo zinanka zichuluka,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "anawonjezera kumanga maguwa ansembe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "Pamene dziko lake linkatukuka,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "anakongoletsa miyala yake yopatulika.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wawo ndi wonyenga",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "text": "ndipo tsopano ayenera kulangidwa chifukwa cha kulakwa kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "text": "Yehova adzagumula maguwa awo ansembe",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "text": "ndi kuwononga miyala yawo yopatulika.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo anthuwo adzanena kuti, \"Ife tilibe mfumu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "chifukwa sitinaope Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "Koma ngakhale tikanakhala ndi mfumu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "kodi mfumuyo ikanatichitira chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafumu amalonjeza zambiri,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "amalumbira zabodza",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "pochita mapangano.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "Kotero maweruzo amaphuka",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "ngati zitsamba zakupha mʼmunda umene walimidwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu amene amakhala mu Samariya akuchita mantha",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "chifukwa cha fano la mwana wangʼombe ku Beti-Aveni.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "Anthu ake adzalirira fanolo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "chimodzimodzinso ansembe ake adamawo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "amene anakondwera ndi kukongola kwake,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "chifukwa lachotsedwa pakati pawo ndi kupita ku ukapolo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fanolo lidzatengedwa kupita ku Asiriya",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "ngati mphatso kwa mfumu yayikulu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "Efereimu adzachititsidwa manyazi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "chifukwa cha mafano ake amitengo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samariya ndi mfumu yake adzatengedwa kupita kutali",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.7",
            "verseOrgIds": [
              "HOS.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:7"
      },
      "items": [
        {
          "text": "ngati kanthambi koyenda pa madzi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.7",
            "verseOrgIds": [
              "HOS.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malo opembedzerako mafano a ku Aveni adzawonongedwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "Ili ndiye tchimo la Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "Minga ndi mitungwi zidzamera",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "ndi kuphimba maguwa awo ansembe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "Kenaka anthu adzawuza mapiri kuti, \"Tiphimbeni!\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "ndipo adzawuza zitunda kuti, \"Tigwereni!\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe Israeli, wachimwa kuyambira mʼmasiku a Gibeya,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:9"
      },
      "items": [
        {
          "text": "ndipo wakhala uli pomwepo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:9"
      },
      "items": [
        {
          "text": "Kodi nkhondo sinagonjetse anthu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:9"
      },
      "items": [
        {
          "text": "ochita zoyipa ku Gibeya?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ndifunire, ndidzalanga anthuwo;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.10",
            "verseOrgIds": [
              "HOS.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:10"
      },
      "items": [
        {
          "text": "mitundu ya anthu idzasonkhanitsidwa kudzalimbana nawo,",
          "type": "text",
          "attrs": {
