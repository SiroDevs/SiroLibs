  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1CO 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ndinabwera kwa inu, abale, sindinabwere ndi luntha lodziwa kuyankhula kapena nzeru zapamwamba pamene ndinachitira umboni chinsinsi cha Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.1",
            "verseOrgIds": [
              "1CO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ndinatsimikiza pamene ndinali ndi inu kuti ndisadziwe kanthu kena kupatula Yesu Khristu wopachikidwayo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.2",
            "verseOrgIds": [
              "1CO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinabwera kwa inu wofowoka ndi wamantha, ndiponso wonjenjemera kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.3",
            "verseOrgIds": [
              "1CO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uthenga ndi ulaliki wanga sunali wa mawu anzeru ndi onyengerera koma woonetsa mphamvu za Mzimu,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.4",
            "verseOrgIds": [
              "1CO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti chikhulupiriro chanu chisatsamire pa nzeru ya anthu koma pa mphamvu za Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.5",
            "verseOrgIds": [
              "1CO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzeru Yochokera kwa Mzimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe ife timayankhula uthenga wa nzeru kwa okhwima, koma osati ndi nzeru ya mʼbado uno kapena ya olamula a mʼbado uno, amene mphamvu yawo ikutha.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.6",
            "verseOrgIds": [
              "1CO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi, ife timayankhula za nzeru yobisika ya Mulungu, nzeru imene inabisidwa ndipo imene Mulungu anatikonzera mu ulemerero wathu isanayambe nthawi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.7",
            "verseOrgIds": [
              "1CO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palibe olamulira aliyense wa mʼbado uno amene anamumvetsetsa popeza anakamumvetsetsa sakanamupachika Ambuye wa ulemerero.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.8",
            "verseOrgIds": [
              "1CO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe monga zalembedwa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 2:9"
      },
      "items": [
        {
          "text": "\"Palibe diso linaona,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 2:9"
      },
      "items": [
        {
          "text": "palibe khutu linamva,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 2:9"
      },
      "items": [
        {
          "text": "palibe amene anaganizira,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 2:9"
      },
      "items": [
        {
          "text": "zimene Mulungu anakonzera amene amukonda\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma Mulungu waululira ife mwa Mzimu wake.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.10",
            "verseOrgIds": [
              "1CO.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CO 2:10"
      },
      "items": [
        {
          "text": "Mzimu amafufuza zinthu zonse, ndi zozama za Mulungu zomwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.10",
            "verseOrgIds": [
              "1CO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ndani mwa anthu angadziwe maganizo a munthu wina, kupatula mzimu wa munthuyo wokhala mʼkati mwake? Chimodzimodzinso palibe amene adziwa maganizo a Mulungu kupatula Mzimu wa Mulunguyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.11",
            "verseOrgIds": [
              "1CO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mzimu amene tinalandira ife si wa dziko lapansi koma Mzimu wochokera kwa Mulungu wotipatsa ife mwaulere.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.12",
            "verseOrgIds": [
              "1CO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izi ndi zimene timayankhula osati mʼmawu wophunzitsidwa ndi nzeru za munthu koma mʼmawu wophunzitsidwa ndi Mzimu, kufotokozera zoonadi zauzimu mʼmawu auzimu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.13",
            "verseOrgIds": [
              "1CO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu wopanda Mzimu savomereza zinthu zimene zichokera kwa Mzimu wa Mulungu, popeza ndi zopusa kwa iyeyo, ndipo sangazimvetsetse chifukwa zimazindikirika mwa Mzimu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.14",
            "verseOrgIds": [
              "1CO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu wauzimu amaweruza pa zinthu zonse, koma iye mwini saweruzidwa ndi munthu aliyense.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.15",
            "verseOrgIds": [
              "1CO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.16",
            "verseOrgIds": [
              "1CO.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 2:16"
      },
      "items": [
        {
          "text": "\"Ndani anadziwa malingaliro a Ambuye,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.16",
            "verseOrgIds": [
              "1CO.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 2:16"
      },
      "items": [
        {
          "text": "kuti akhoza kumulangiza Iye.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.16",
            "verseOrgIds": [
              "1CO.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1CO 2:16"
      },
      "items": [
        {
          "text": "Koma tili nawo mtima wa Khristu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.16",
            "verseOrgIds": [
              "1CO.2.16"
            ]
          }
        }
      ]
    }
  ],
