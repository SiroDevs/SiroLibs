  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "LUK 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Kutembenuka Mtima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi yomweyo panali ena amene analipo omwe amamuwuza Yesu za Agalileya amene magazi awo Pilato anawasakaniza ndi nsembe zawo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.1",
            "verseOrgIds": [
              "LUK.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.2",
            "verseOrgIds": [
              "LUK.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi mukuganiza kuti Agalileya amenewa anali ochimwa kwambiri kuposa Agalileya ena onse chifukwa anavutika mʼnjira iyi?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.2",
                "verseOrgIds": [
                  "LUK.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.2",
            "verseOrgIds": [
              "LUK.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndikuti, ayi! Koma ngati inu simutembenuka mtima, inunso mudzawonongeka nonse.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.3",
                "verseOrgIds": [
                  "LUK.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.3",
            "verseOrgIds": [
              "LUK.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kapena anthu 18 aja amene anafa nsanja ya Siloamu itawagwera, kodi mukuganiza kuti iwo aja anali ochimwa kwambiri kuposa onse amene amakhala mu Yerusalemu?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.4",
                "verseOrgIds": [
                  "LUK.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.4",
            "verseOrgIds": [
              "LUK.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndikuti, ayi! Koma ngati inu simutembenuka mtima, inunso mudzawonongeka nonse.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.5",
                "verseOrgIds": [
                  "LUK.13.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Iye anawawuza fanizo kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Munthu wina anali ndi mtengo wamkuyu, umene anadzala mʼmunda wamphesa, ndipo Iye anapita kukayangʼana zipatso, koma sanazipeze.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.6",
                "verseOrgIds": [
                  "LUK.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tsono kwa munthu amene amasamalira munda wamphesawo anati, 'Kwa zaka zitatu tsopano ndakhala ndikubwera kudzafuna chipatso pa mtengo uwu ndipo sindinachipeze. Udule! Nʼchifukwa chiyani ukuwononga nthaka?'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.7",
                "verseOrgIds": [
                  "LUK.13.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Munthuyo anayankha kuti, 'Bwana, tawusiyani kwa chaka chimodzi chokha ndipo ine ndikumba ngalande mozungulira ndi kuthira manyowa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.8",
                "verseOrgIds": [
                  "LUK.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.8",
            "verseOrgIds": [
              "LUK.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati udzabale zipatso chaka chamawa, zili bwino! Koma ngati sudzabala, pamenepo mudzawudule.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.9",
                "verseOrgIds": [
                  "LUK.13.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mayi Wokhota Msana Achiritsidwa pa Sabata",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa Sabata Yesu ankaphunzitsa mʼsunagoge ina,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.10",
            "verseOrgIds": [
              "LUK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo momwemo munali mayi amene anali ndi mzimu woyipa umene unamudwalitsa zaka 18. Iye anali wokhota msana ndipo samatha kuweramuka ndi pangʼono pomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.11",
            "verseOrgIds": [
              "LUK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu atamuona anamuyitana kutsogolo ndipo anati kwa iye,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.12",
            "verseOrgIds": [
              "LUK.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amayi, mwamasulidwa ku mavuto.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.12",
                "verseOrgIds": [
                  "LUK.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.12",
            "verseOrgIds": [
              "LUK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka anasanjika manja ake pa iye, ndipo nthawi yomweyo anawongoka nayamika Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.13",
            "verseOrgIds": [
              "LUK.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa cha kuyipidwa kuti Yesu anachiritsa pa Sabata, wolamulira sunagoge anati kwa anthu, \"Pali masiku asanu ndi limodzi ogwira ntchito. Choncho bwerani kuti mudzachiritsidwe masiku amenewo osati pa Sabata.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.14",
            "verseOrgIds": [
              "LUK.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye anamuyankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.15",
            "verseOrgIds": [
              "LUK.13.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Iwe wachiphamaso! Kodi nonsenu simumasula pa Sabata ngʼombe zanu kapena bulu kumuchotsa mʼkhola ndi kupita naye kukamupatsa madzi?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.15",
                "verseOrgIds": [
                  "LUK.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.15",
            "verseOrgIds": [
              "LUK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nanga mayiyu, amene ndi mwana wa Abrahamu, ndipo anamangidwa ndi Satana zaka 18, kodi siwoyenera kuti amasulidwe msinga imeneyi pa tsiku la Sabata?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.16",
                "verseOrgIds": [
                  "LUK.13.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atanena izi, onse omutsutsa anachititsidwa manyazi, koma anthu anakondwera ndi zodabwitsa zonse zimene Iye anazichita.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.17",
            "verseOrgIds": [
              "LUK.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fanizo la Mbewu ya Mpiru ndi la Yisiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yesu anafunsa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi ufumu wa Mulungu uli ngati chiyani? Kodi Ine ndingawufanizire ndi chiyani?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.18",
                "verseOrgIds": [
                  "LUK.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Uli ngati mbewu ya mpiru, imene munthu anatenga ndi kudzala mʼmunda mwake. Inakula, nʼkukhala mtengo, ndipo mbalame zamlengalenga zinakhala mʼnthambi zake.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.19",
                "verseOrgIds": [
                  "LUK.13.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anafunsanso kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
              "LUK.13.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi ufumu wa Mulungu ndingawufanizire ndi chiyani?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.20",
                "verseOrgIds": [
                  "LUK.13.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
              "LUK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Uli ngati yisiti amene mayi anatenga ndi kusakaniza ndi ufa wambiri mpaka anafufumitsa ufawo.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.21",
                "verseOrgIds": [
                  "LUK.13.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Khomo Lopapatiza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yesu anayendayenda mʼmizinda ndi mʼmidzi, kumaphunzitsa pamene Iye ankapita ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.22",
            "verseOrgIds": [
              "LUK.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wina anamufunsa Iye kuti, \"Ambuye, kodi ndi anthu ochepa okha amene adzapulumutsidwe?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.23",
            "verseOrgIds": [
              "LUK.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 13:23"
      },
      "items": [
        {
          "text": "Iye anawawuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.23",
            "verseOrgIds": [
              "LUK.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yesetsani kulowa pa khomo lopapatiza, chifukwa ndikukuwuzani kuti ambiri adzafuna kulowa koma sadzatha kutero.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.24",
                "verseOrgIds": [
                  "LUK.13.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.24",
            "verseOrgIds": [
              "LUK.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nthawi yomwe mwini nyumba adzayimirira ndi kutseka chitseko, inu mudzayima kunja kugogoda ndi kudandaula kuti, 'Bwana, tatitsekulirani khomo.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.25",
                "verseOrgIds": [
                  "LUK.13.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 13:25"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koma Iye adzayankha kuti, 'Ine sindikukudziwani ndipo sindikudziwanso kumene mwachokera.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.25",
                "verseOrgIds": [
                  "LUK.13.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndipo inu mudzati, tinkadya ndi kumwa ndi inu ndipo munkaphunzitsa mʼmisewu yathu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.26",
                "verseOrgIds": [
                  "LUK.13.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koma Iye adzayankha kuti, 'Ine sindikukudziwani ndipo sindikudziwanso kumene mwachokera. Chokereni inu nonse ochita zoyipa!'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.27",
                "verseOrgIds": [
                  "LUK.13.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mudzalira ndi kukuta mano mukadzaona Abrahamu, Isake ndi Yakobo ndi aneneri onse ali mu ufumu wa Mulungu koma inuyo mutaponyedwa kunja.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.28",
                "verseOrgIds": [
                  "LUK.13.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.28",
            "verseOrgIds": [
              "LUK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Anthu adzachokera kummawa ndi kumadzulo, kumpoto ndi kummwera, kudzakhala pa phwando mu ufumu wa Mulungu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.29",
                "verseOrgIds": [
                  "LUK.13.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.29",
            "verseOrgIds": [
              "LUK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndithudi otsirizira ndiye adzakhale oyambirira, ndipo oyambirira ndiye adzakhale otsirizira.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.30",
                "verseOrgIds": [
                  "LUK.13.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Amvera Chisoni Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi imeneyo Afarisi anabwera kwa Yesu ndipo anati kwa Iye, \"Chokani malo ano ndipo pitani kumalo ena aliwonse. Herode akufuna kukuphani.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.31",
            "verseOrgIds": [
              "LUK.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pitani kawuzeni nkhandweyo, Ine ndikutulutsa ziwanda ndi kuchiritsa anthu lero ndi mawa ndipo tsiku lachitatu ndidzakwaniritsa cholinga changa.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.32",
                "verseOrgIds": [
                  "LUK.13.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mʼnjira ina iliyonse, Ine ndiyenera kupitirira ulendo wanga lero, mawa ndi mkuja. Zoona nʼzakuti mneneri sangafere kunja kwa Yerusalemu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.33",
                "verseOrgIds": [
                  "LUK.13.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iwe Yerusalemu, Yerusalemu! Umapha aneneri ndi kuwagenda miyala anthu amene atumizidwa kwa iwe. Nthawi zambiri ndakhala ndikufuna kusonkhanitsa ana ako pamodzi, monga nkhuku imasonkhanitsira anapiye pansi pa mapiko ake, koma iwe sunafune!",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.34",
                "verseOrgIds": [
                  "LUK.13.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.34",
            "verseOrgIds": [
              "LUK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Taona, nyumba yako yasanduka bwinja. Ine ndikukuwuza kuti, sudzandionanso mpaka pamene udzati, \"Wodala amene akubwera mʼdzina la Ambuye!\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.35",
                "verseOrgIds": [
                  "LUK.13.35"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
