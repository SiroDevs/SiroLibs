  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "LUK 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amufunsa Yesu za Ulamuliro Wake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lina pamene Iye ankaphunzitsa anthu mʼmabwalo a Nyumba ya Mulungu ndi kuphunzitsa Uthenga Wabwino, akulu a ansembe ndi aphunzitsi amalamulo, pamodzi ndi akuluakulu anabwera kwa Iye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.1",
            "verseOrgIds": [
              "LUK.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anati, \"Mutiwuze mukuchita izi ndi ulamuliro wayani? Ndani anakupatsani ulamuliro uwu?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.2",
            "verseOrgIds": [
              "LUK.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.3",
            "verseOrgIds": [
              "LUK.20.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Inenso ndikufunsani, mundiyankhe,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.3",
                "verseOrgIds": [
                  "LUK.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.3",
            "verseOrgIds": [
              "LUK.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Kodi ubatizo wa Yohane, unali wochokera kumwamba, kapena wochokera kwa anthu?' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.4",
                "verseOrgIds": [
                  "LUK.20.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anakambirana pakati pawo ndikuti, \"Ngati ife tinena kuti, 'Kuchokera kumwamba' Iye akatifunsa kuti, 'chifukwa chiyani simunamukhulupirire iye?'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.5",
            "verseOrgIds": [
              "LUK.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ngati ife tinena kuti, 'kuchokera kwa anthu,' anthu onse atigenda miyala, chifukwa amatsimikiza kuti Yohane anali mneneri.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.6",
            "verseOrgIds": [
              "LUK.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo iwo anayankha kuti, \"Ife sitidziwa kumene unachokera.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.7",
            "verseOrgIds": [
              "LUK.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anati,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.8",
            "verseOrgIds": [
              "LUK.20.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngakhale Inenso sindikuwuzani kuti ndi ulamuliro wanji umene ndikuchitira zimenezi.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.8",
                "verseOrgIds": [
                  "LUK.20.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fanizo la Olima Mʼmunda Wamphesa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anapitirira kuwawuza anthu fanizo ili:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.9",
            "verseOrgIds": [
              "LUK.20.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Munthu wina analima munda wamphesa, nabwereketsa kwa alimi ena ndipo anachoka kwa nthawi yayitali.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.9",
                "verseOrgIds": [
                  "LUK.20.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.9",
            "verseOrgIds": [
              "LUK.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pa nthawi yokolola, iye anatumiza wantchito wake kwa alimi aja kuti amupatseko zina mwa zipatso za munda wamphesawo. Koma alimi aja anamumenya namubweza wopanda kanthu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.10",
                "verseOrgIds": [
                  "LUK.20.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.10",
            "verseOrgIds": [
              "LUK.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iye anatumiza wantchito wina, koma uyunso anamumenya namuchita zachipongwe ndi kumubweza wopanda kanthu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.11",
                "verseOrgIds": [
                  "LUK.20.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.11",
            "verseOrgIds": [
              "LUK.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iye anatumizanso wina wachitatu ndipo iwo anamuvulaza namuponya kunja.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.12",
                "verseOrgIds": [
                  "LUK.20.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kenaka mwini mundawo anati, 'Kodi ndichite chiyani? Ndidzatumiza mwana wanga wamwamuna, amene ndimukonda; mwina iwo adzamuchitira ulemu.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.13",
                "verseOrgIds": [
                  "LUK.20.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koma alimiwo ataona mwanayo, anakambirananso. Iwo anati, 'Uyu ndiye wodzamusiyira chumachi. Tiyeni timuphe ndipo chumachi chikhala chathu.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.14",
                "verseOrgIds": [
                  "LUK.20.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.14",
            "verseOrgIds": [
              "LUK.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo anamuponya kunja kwa mundawo ndi kumupha.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.15",
                "verseOrgIds": [
                  "LUK.20.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 20:15"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nanga tsono mwini munda wamphesayo adzawatani anthuwa?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.15",
                "verseOrgIds": [
                  "LUK.20.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.15",
            "verseOrgIds": [
              "LUK.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iye adzabwera ndi kupha alimi aja ndi kupereka mundawo kwa ena.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.16",
                "verseOrgIds": [
                  "LUK.20.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 20:16"
      },
      "items": [
        {
          "text": "Pamene anthu anamva izi, anati, \"Musatero ayi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.16",
            "verseOrgIds": [
              "LUK.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anawayangʼanitsitsa ndipo anafunsa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.17",
            "verseOrgIds": [
              "LUK.20.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi tanthauzo lake ndi chiyani la zimene zinalembedwa kuti,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.17",
                "verseOrgIds": [
                  "LUK.20.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 20:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Mwala umene omanga nyumba anawukana",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.17",
                "verseOrgIds": [
                  "LUK.20.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 20:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "wasanduka mwala wa pa ngodya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.17",
                "verseOrgIds": [
                  "LUK.20.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Aliyense amene agwa pa mwalawu adzapweteka, koma iye amene udzamugwera udzamuphwanya.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.18",
                "verseOrgIds": [
                  "LUK.20.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aphunzitsi amalamulo ndi akulu a ansembe amafuna njira yoti amuphe nthawi yomweyo, chifukwa anadziwa kuti ananena fanizo ili powatsutsa iwo. Koma iwo anali ndi mantha chifukwa cha anthu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.19",
            "verseOrgIds": [
              "LUK.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Kupereka Msonkho kwa Kaisara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ankamulondalonda Iye, iwo anatumiza akazitape amene amaoneka ngati achilungamo. Iwo ankafuna kumutapa mʼkamwa Yesu mu china chilichonse chimene Iye ananena kuti amupereke Iye kwa amene anali ndi mphamvu ndi ulamuliro oweruza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.20",
            "verseOrgIds": [
              "LUK.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Potero akazitapewo anamufunsa Iye kuti, \"Aphunzitsi, tidziwa kuti mumayankhula ndi kuphunzitsa zimene zili zoonadi, ndi kuti simuonetsa tsankho koma mumaphunzitsa njira ya Mulungu mwachoonadi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.21",
            "verseOrgIds": [
              "LUK.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ndi bwino kwa ife kumapereka msonkho kwa Kaisara kapena kusapereka?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.22",
            "verseOrgIds": [
              "LUK.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anaona chinyengo chawo ndipo anawawuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.23",
            "verseOrgIds": [
              "LUK.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onetseni ndalama. Chithunzi ndi malembawa ndi zayani?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.24",
                "verseOrgIds": [
                  "LUK.20.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anayankha kuti, \"Za Kaisara.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.25",
            "verseOrgIds": [
              "LUK.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 20:25"
      },
      "items": [
        {
          "text": "Iye anawawuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.25",
            "verseOrgIds": [
              "LUK.20.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndiye perekani kwa Kaisara zake za Kaisara ndi kwa Mulungu zimene ndi za Mulungu.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.25",
                "verseOrgIds": [
                  "LUK.20.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo analephera kumupeza cholakwa pa zimene ankayankhula pamaso pa anthu. Ndipo pothedwa nzeru ndi yankho lake, iwo anakhala chete.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.26",
            "verseOrgIds": [
              "LUK.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Kuuka kwa Akufa ndi Ukwati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena mwa Asaduki, amene ankanena kuti kulibe kuuka kwa akufa, anabwera kwa Yesu ndi funso.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.27",
            "verseOrgIds": [
              "LUK.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anati, \"Aphunzitsi, Mose anatilembera kuti munthu akamwalira ndi kusiya mkazi wopanda ana, mʼbale wa munthu womwalirayo akuyenera kukwatira mkaziyo kuti amuberekere ana mʼbale wakeyo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.28",
            "verseOrgIds": [
              "LUK.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano panali abale asanu ndi awiri. Woyambayo anakwatira mkazi ndipo anafa wopanda mwana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.29",
            "verseOrgIds": [
              "LUK.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wachiwiri",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.30",
            "verseOrgIds": [
              "LUK.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo kenaka wachitatuyo anamukwatira iye, ndipo chimodzimodzi asanu ndi awiri aja anafa osasiya ana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.31",
            "verseOrgIds": [
              "LUK.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mapeto pake mkaziyo anafanso.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.32",
            "verseOrgIds": [
              "LUK.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano, pa nthawi ya kuukanso, kodi mkaziyu adzakhala wayani popeza onse asanu ndi awiri anamukwatirapo?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.33",
            "verseOrgIds": [
              "LUK.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.34",
            "verseOrgIds": [
              "LUK.20.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Anthu a mʼbado uno amakwatira ndi kukwatiwa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.34",
                "verseOrgIds": [
                  "LUK.20.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.34",
            "verseOrgIds": [
              "LUK.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma mʼmoyo umene ukubwerawo, anthu amene adzaukitsidwe kwa akufa sadzakwatira kapena kukwatiwa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.35",
                "verseOrgIds": [
                  "LUK.20.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.35",
            "verseOrgIds": [
              "LUK.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo sadzafanso, pakuti adzakhala ngati angelo. Iwo ndi ana a Mulungu, chifukwa adzakhala ataukitsidwa kwa akufa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.36",
                "verseOrgIds": [
                  "LUK.20.36"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.36",
            "verseOrgIds": [
              "LUK.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngakhale pa nkhani yachitsamba choyaka moto, Mose anaonetsa kuti akufa amauka, pakuti anatcha Ambuye 'Mulungu wa Abrahamu, Mulungu wa Isake ndi Mulungu wa Yakobo.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.37",
                "verseOrgIds": [
                  "LUK.20.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.37",
            "verseOrgIds": [
              "LUK.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mulungu si Mulungu wa akufa, koma wa amoyo, pakuti kwa Iye onse ali ndi moyo.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.38",
                "verseOrgIds": [
                  "LUK.20.38"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena mwa aphunzitsi amalamulo anayankha kuti, \"Mwanena bwino mphunzitsi!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.39",
            "verseOrgIds": [
              "LUK.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo panalibe wina amene akanalimba mtima kumufunsa Iye mafunso ena.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.40",
            "verseOrgIds": [
              "LUK.20.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Khristu ndi Mwana wa Ndani?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yesu anawawuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.41",
            "verseOrgIds": [
              "LUK.20.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zikutheka bwanji kuti aziti Khristu ndi mwana wa Davide?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.41",
                "verseOrgIds": [
                  "LUK.20.41"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.41",
            "verseOrgIds": [
              "LUK.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Davide mwini wake akunenetsa mʼbuku la Masalimo kuti,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.42",
                "verseOrgIds": [
                  "LUK.20.42"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 20:42"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ambuye anati kwa Ambuye anga:",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.42",
                "verseOrgIds": [
                  "LUK.20.42"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 20:42"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Khalani ku dzanja langa lamanja,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.42",
                "verseOrgIds": [
                  "LUK.20.42"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mpaka Ine nditasandutsa adani anu",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.43",
                "verseOrgIds": [
                  "LUK.20.43"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 20:43"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "chopondapo mapazi anu?'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.43",
                "verseOrgIds": [
                  "LUK.20.43"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Davide akumutcha Iye 'Ambuye.' Nanga zingatheke bwanji kuti Iye akhale mwana wake?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.20.44",
                "verseOrgIds": [
                  "LUK.20.44"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Achenjeza za Aphunzitsi Amalamulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 20:45"
          },
          "items": [
