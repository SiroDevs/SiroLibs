  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "56",
        "style": "c",
        "sid": "PSA 56"
      },
      "items": [
        {
          "text": "56",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 56",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Potsata mayimbidwe a \"Njiwa pa Mtengo wa Thundu wa Kutali.\" Mikitamu ya Davide, pamene Afilisti anamugwira ku Gati.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 56:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundichitire chifundo Inu Mulungu, pakuti anthu akundithamangitsa kwambiri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.1",
            "verseOrgIds": [
              "PSA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:1"
      },
      "items": [
        {
          "text": "tsiku lonse akundithira nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.1",
            "verseOrgIds": [
              "PSA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 56:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ondinyoza akundithamangitsa tsiku lonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.2",
            "verseOrgIds": [
              "PSA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:2"
      },
      "items": [
        {
          "text": "ambiri akumenyana nane monyada.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.2",
            "verseOrgIds": [
              "PSA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 56:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikachita mantha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.3",
            "verseOrgIds": [
              "PSA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:3"
      },
      "items": [
        {
          "text": "ndimadalira Inu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.3",
            "verseOrgIds": [
              "PSA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 56:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa Mulungu, amene mawu ake ine ndimatamanda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:4"
      },
      "items": [
        {
          "text": "mwa Mulungu ine ndimadaliramo; sindidzachita mantha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:4"
      },
      "items": [
        {
          "text": "Kodi munthu amene amafa angandichite chiyani?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 56:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lonse amatembenuza mawu anga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.5",
            "verseOrgIds": [
              "PSA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:5"
      },
      "items": [
        {
          "text": "nthawi zonse amakonza zondivulaza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.5",
            "verseOrgIds": [
              "PSA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 56:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amakambirana, amandibisalira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:6"
      },
      "items": [
        {
          "text": "amayangʼanitsitsa mayendedwe anga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:6"
      },
      "items": [
        {
          "text": "ndipo amakhala ndi chidwi chofuna kuchotsa moyo wanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 56:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musalole konse kuti athawe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.7",
            "verseOrgIds": [
              "PSA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:7"
      },
      "items": [
        {
          "text": "mu mkwiyo wanu Mulungu mugwetse mitundu ya anthu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.7",
            "verseOrgIds": [
              "PSA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 56:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulembe za kulira kwanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:8"
      },
      "items": [
        {
          "text": "mulembe chiwerengero cha misozi yanga mʼbuku lanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:8"
      },
      "items": [
        {
          "text": "Kodi zimenezi sizinalembedwe mʼbuku lanulo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 56:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adani anga adzabwerera mʼmbuyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:9"
      },
      "items": [
        {
          "text": "pamene ndidzalirira kwa Inu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:9"
      },
      "items": [
        {
          "text": "Pamenepo ndidzadziwa kuti Mulungu ali ku mbali yanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 56:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa Mulungu amene mawu ake ndimawatamanda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:10"
      },
      "items": [
        {
          "text": "mwa Yehova amene mawu ake ndimawatamanda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 56:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwa Mulungu ine ndimadalira ndipo sindidzachita mantha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.11",
            "verseOrgIds": [
              "PSA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:11"
      },
      "items": [
        {
          "text": "Kodi munthu angandichite chiyani?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.11",
            "verseOrgIds": [
              "PSA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 56:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiyenera kuchita zomwe ndinalumbira kwa Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.12",
            "verseOrgIds": [
              "PSA.56.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:12"
      },
      "items": [
        {
          "text": "ndidzapereka nsembe zanga zachiyamiko kwa inu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.12",
            "verseOrgIds": [
              "PSA.56.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 56:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti mwawombola moyo wanga ku imfa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:13"
      },
      "items": [
        {
          "text": "ndi mapazi anga kuti ndingagwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 56:13"
      },
      "items": [
        {
          "text": "kuti ndiyende pamaso pa Mulungu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:13"
      },
      "items": [
        {
          "text": "mʼkuwala kwa moyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    }
  ],
