        {
          "text": "Salimo 135",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 135:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamandani Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.1",
            "verseOrgIds": [
              "PSA.135.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 135:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 135:1"
      },
      "items": [
        {
          "text": "Tamandani dzina la Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.1",
            "verseOrgIds": [
              "PSA.135.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:1"
      },
      "items": [
        {
          "text": "mutamandeni, inu atumiki a Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.1",
            "verseOrgIds": [
              "PSA.135.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 135:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "amene mumatumikira mʼnyumba ya Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.2",
            "verseOrgIds": [
              "PSA.135.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:2"
      },
      "items": [
        {
          "text": "mʼmabwalo a nyumba ya Mulungu wathu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.2",
            "verseOrgIds": [
              "PSA.135.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 135:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamandani Yehova, pakuti Yehova ndi wabwino;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.3",
            "verseOrgIds": [
              "PSA.135.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:3"
      },
      "items": [
        {
          "text": "imbani nyimbo zotamanda dzina lake, pakuti nʼkokoma kutero,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.3",
            "verseOrgIds": [
              "PSA.135.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 135:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Yehova wasankha Yakobo kuti akhale wake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:4"
      },
      "items": [
        {
          "text": "Israeli kuti akhale chuma chake chapamtima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 135:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikudziwa kuti Yehova ndi wamkulu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.5",
            "verseOrgIds": [
              "PSA.135.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:5"
      },
      "items": [
        {
          "text": "kuti Ambuye athu ndi wamkulu kuposa milungu yonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.5",
            "verseOrgIds": [
              "PSA.135.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 135:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova amachita chilichonse chimene chimamukomera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.6",
            "verseOrgIds": [
              "PSA.135.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:6"
      },
      "items": [
        {
          "text": "kumwamba ndi dziko lapansi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.6",
            "verseOrgIds": [
              "PSA.135.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:6"
      },
      "items": [
        {
          "text": "ku nyanja zazikulu ndi ku malo ake onse akuya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.6",
            "verseOrgIds": [
              "PSA.135.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 135:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amatulutsa mitambo kuchokera ku malekezero a dziko lapansi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.7",
            "verseOrgIds": [
              "PSA.135.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:7"
      },
      "items": [
        {
          "text": "amatumiza zingʼaningʼani pamodzi ndi mvula",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.7",
            "verseOrgIds": [
              "PSA.135.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:7"
      },
      "items": [
        {
          "text": "ndipo amatulutsa mphepo ku malo ake osungiramo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.7",
            "verseOrgIds": [
              "PSA.135.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 135:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakantha ana oyamba kubadwa a Igupto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.8",
            "verseOrgIds": [
              "PSA.135.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:8"
      },
      "items": [
        {
          "text": "ana oyamba kubadwa a anthu ndi nyama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.8",
            "verseOrgIds": [
              "PSA.135.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 135:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anatumiza zizindikiro zozizwitsa ndi zodabwitsa pakati pako, iwe Igupto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.9",
            "verseOrgIds": [
              "PSA.135.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:9"
      },
      "items": [
        {
          "text": "kutsutsana ndi Farao pamodzi ndi atumiki ake onse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.9",
            "verseOrgIds": [
              "PSA.135.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 135:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anakantha mitundu yambiri ya anthu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.10",
            "verseOrgIds": [
              "PSA.135.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:10"
      },
      "items": [
        {
          "text": "ndi kupha mafumu amphamvu:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.10",
            "verseOrgIds": [
              "PSA.135.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 135:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sihoni mfumu ya Aamori,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:11"
      },
      "items": [
        {
          "text": "Ogi mfumu ya Basani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:11"
      },
      "items": [
        {
          "text": "ndi maufumu onse a ku Kanaani;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 135:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo anapereka dziko lawo ngati cholowa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.12",
            "verseOrgIds": [
              "PSA.135.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:12"
      },
      "items": [
        {
          "text": "cholowa cha anthu ake Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.12",
            "verseOrgIds": [
              "PSA.135.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 135:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzina lanu, Inu Yehova, ndi losatha mpaka muyaya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.13",
            "verseOrgIds": [
              "PSA.135.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:13"
      },
      "items": [
        {
          "text": "mbiri yanu, Inu Yehova, idziwika mibado yonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.13",
            "verseOrgIds": [
              "PSA.135.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 135:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Yehova adzaonetsa kuti anthu ake ngosalakwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.14",
            "verseOrgIds": [
              "PSA.135.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:14"
      },
      "items": [
        {
          "text": "ndipo adzachitira chifundo atumiki ake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.14",
            "verseOrgIds": [
              "PSA.135.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 135:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafano a mitundu ya anthu ndi siliva ndi golide,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.15",
            "verseOrgIds": [
              "PSA.135.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:15"
      },
      "items": [
        {
          "text": "opangidwa ndi manja a anthu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.15",
            "verseOrgIds": [
              "PSA.135.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 135:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakamwa ali napo koma sayankhula",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.16",
            "verseOrgIds": [
              "PSA.135.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:16"
      },
      "items": [
        {
          "text": "maso ali nawo, koma sapenya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.16",
            "verseOrgIds": [
              "PSA.135.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 135:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
