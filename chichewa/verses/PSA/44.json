  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "44",
        "style": "c",
        "sid": "PSA 44"
      },
      "items": [
        {
          "text": "44",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 44",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Ndakatulo ya ana a Kora.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 44:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife tamva ndi makutu athu, Inu Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:1"
      },
      "items": [
        {
          "text": "makolo athu atiwuza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:1"
      },
      "items": [
        {
          "text": "zimene munachita mʼmasiku awo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:1"
      },
      "items": [
        {
          "text": "masiku akalekalewo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi dzanja lanu munathamangitsa mitundu ya anthu ena",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "ndi kudzala makolo athu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "Inu munakantha mitundu ya anthu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "koma makolo athuwo Inu munawapatsa ufulu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanalande dziko ndi lupanga lawo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "si mkono wawo umene unawabweretsera chigonjetso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "koma ndi dzanja lanu lamanja, mkono wanu ndi kuwala kwa nkhope yanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "pakuti munawakonda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu ndinu Mfumu yanga ndi Mulungu wanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:4"
      },
      "items": [
        {
          "text": "amene mumalamulira chigonjetso cha Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudzera kwa inu ife timabweza adani athu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.5",
            "verseOrgIds": [
              "PSA.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:5"
      },
      "items": [
        {
          "text": "kudzera mʼdzina lanu timapondereza otiwukirawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.5",
            "verseOrgIds": [
              "PSA.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sindidalira uta wanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.6",
            "verseOrgIds": [
              "PSA.44.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:6"
      },
      "items": [
        {
          "text": "lupanga langa silindibweretsera chigonjetso;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.6",
            "verseOrgIds": [
              "PSA.44.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma Inu mumatigonjetsera adani athu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.7",
            "verseOrgIds": [
              "PSA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:7"
      },
      "items": [
        {
          "text": "mumachititsa manyazi amene amadana nafe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.7",
            "verseOrgIds": [
              "PSA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timanyadira mwa Mulungu wathu tsiku lonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.8",
            "verseOrgIds": [
              "PSA.44.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:8"
      },
      "items": [
        {
          "text": "ndipo tidzatamanda dzina lanu kwamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.8",
            "verseOrgIds": [
              "PSA.44.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma tsopano mwatikana ndi kutichepetsa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.9",
            "verseOrgIds": [
              "PSA.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:9"
      },
      "items": [
        {
          "text": "Inu simupitanso ndi ankhondo athu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.9",
            "verseOrgIds": [
              "PSA.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munachititsa ife kubwerera mʼmbuyo pamaso pa mdani",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.10",
            "verseOrgIds": [
              "PSA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:10"
      },
      "items": [
        {
          "text": "ndipo amene amadana nafe atilanda katundu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.10",
            "verseOrgIds": [
              "PSA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu munatipereka kuti tiwonongedwe monga nkhosa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.11",
            "verseOrgIds": [
              "PSA.44.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:11"
      },
      "items": [
        {
          "text": "ndipo mwatibalalitsa pakati pa anthu a mitundu ina.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.11",
            "verseOrgIds": [
              "PSA.44.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu munagulitsa anthu anu pa mtengo wotsika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.12",
            "verseOrgIds": [
              "PSA.44.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:12"
      },
      "items": [
        {
          "text": "osapindulapo kanthu pa malondawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.12",
            "verseOrgIds": [
              "PSA.44.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwachititsa kuti tikhale chochititsa manyazi kwa anthu a mitundu ina,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.13",
            "verseOrgIds": [
              "PSA.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:13"
      },
      "items": [
        {
          "text": "chonyozeka ndi chothetsa nzeru kwa iwo amene atizungulira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.13",
            "verseOrgIds": [
              "PSA.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwachititsa kuti tikhale onyozeka pakati pa anthu a mitundu ina;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.14",
            "verseOrgIds": [
              "PSA.44.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:14"
      },
      "items": [
        {
          "text": "anthu amapukusa mitu yawo akationa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.14",
            "verseOrgIds": [
              "PSA.44.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manyazi anga ali pamaso panga tsiku lonse",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.15",
            "verseOrgIds": [
              "PSA.44.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:15"
      },
      "items": [
        {
          "text": "ndipo nkhope yanga yaphimbidwa ndi manyazi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.15",
            "verseOrgIds": [
              "PSA.44.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "chifukwa cha mawu otonza a iwo amene amandinyoza ndi kundichita chipongwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.16",
            "verseOrgIds": [
              "PSA.44.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:16"
      },
