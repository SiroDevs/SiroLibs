      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "amene pakamwa pawo ndi podzaza ndi mabodza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
