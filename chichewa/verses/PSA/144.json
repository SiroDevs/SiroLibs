          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ana aamuna pa chinyamata chawo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "adzakhala ngati mbewu yosamalidwa bwino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "ana athu aakazi adzakhala ngati zipilala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "zosemedwa bwino, zokongoletsera nyumba yaufumu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 144:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkhokwe zathu zidzakhala zodzaza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:13"
      },
      "items": [
        {
          "text": "ndi zokolola za mtundu uliwonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:13"
      },
      "items": [
        {
          "text": "Nkhosa zathu zidzaswana miyandamiyanda",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:13"
      },
      "items": [
        {
          "text": "pa mabusa athu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 144:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼombe zathu zidzanyamula katundu wolemera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.14",
            "verseOrgIds": [
              "PSA.144.14"
            ]
          }
        }
      ]
    },
