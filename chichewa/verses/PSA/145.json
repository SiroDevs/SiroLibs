          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 145",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salimo la matamando la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 145:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakukwezani Mulungu wanga, Mfumu yanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.1",
            "verseOrgIds": [
              "PSA.145.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:1"
      },
      "items": [
        {
          "text": "ndidzatamanda dzina lanu ku nthawi za nthawi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.1",
            "verseOrgIds": [
              "PSA.145.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 145:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakutamandani tsiku ndi tsiku",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.2",
            "verseOrgIds": [
              "PSA.145.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:2"
      },
      "items": [
        {
          "text": "ndi kulemekeza dzina lanu ku nthawi za nthawi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.2",
            "verseOrgIds": [
              "PSA.145.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 145:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ndi wamkulu ndi woyenera matamando onse;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.3",
            "verseOrgIds": [
              "PSA.145.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:3"
      },
      "items": [
        {
          "text": "ukulu wake palibe angawumvetsetse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.3",
            "verseOrgIds": [
              "PSA.145.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 145:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼbado wina udzayamikira ntchito yanu kwa mʼbado wina;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.4",
            "verseOrgIds": [
              "PSA.145.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:4"
      },
      "items": [
        {
          "text": "Iwo adzafotokoza za machitidwe anu amphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.4",
            "verseOrgIds": [
              "PSA.145.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 145:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adzayankhula ulemerero wokongola waufumu wanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.5",
            "verseOrgIds": [
              "PSA.145.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:5"
      },
      "items": [
        {
          "text": "ndipo ine ndidzalingalira za ntchito zanu zodabwitsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.5",
            "verseOrgIds": [
              "PSA.145.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 145:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo adzafotokoza za mphamvu ya ntchito zanu zoopsa kwambiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.6",
            "verseOrgIds": [
              "PSA.145.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:6"
      },
      "items": [
        {
          "text": "ndipo ine ndidzalengeza za ntchito zanu zazikulu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.6",
            "verseOrgIds": [
              "PSA.145.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 145:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adzakondwerera kuchuluka kwa ubwino wanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.7",
            "verseOrgIds": [
              "PSA.145.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:7"
      },
      "items": [
        {
          "text": "ndi kuyimba mwachimwemwe za chilungamo chanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.7",
            "verseOrgIds": [
              "PSA.145.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 145:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ndi wokoma mtima ndi wachifundo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.8",
            "verseOrgIds": [
              "PSA.145.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:8"
      },
      "items": [
        {
          "text": "wosakwiya msanga ndi wodzaza ndi chikondi chosasinthika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.8",
            "verseOrgIds": [
              "PSA.145.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 145:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ndi wabwino kwa onse;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.9",
            "verseOrgIds": [
              "PSA.145.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:9"
      },
      "items": [
        {
          "text": "amachitira chifundo zonse zimene anazipanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.9",
            "verseOrgIds": [
              "PSA.145.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 145:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonse zimene munazipanga zidzakutamandani, Inu Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.10",
            "verseOrgIds": [
              "PSA.145.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:10"
      },
      "items": [
        {
          "text": "oyera mtima adzakulemekezani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.10",
            "verseOrgIds": [
              "PSA.145.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 145:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo adzafotokoza za ulemerero wa ufumu wanu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.11",
            "verseOrgIds": [
              "PSA.145.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:11"
      },
      "items": [
        {
          "text": "ndi kuyankhula za mphamvu yanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.11",
            "verseOrgIds": [
              "PSA.145.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 145:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti anthu onse adziwe za machitidwe anu amphamvu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.12",
            "verseOrgIds": [
              "PSA.145.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:12"
      },
      "items": [
        {
          "text": "ndi ulemerero wokongola wa ufumu wanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.12",
            "verseOrgIds": [
              "PSA.145.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 145:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufumu wanu ndi ufumu wamuyaya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:13"
      },
      "items": [
        {
          "text": "ndipo ulamuliro wanu ndi wosatha pa mibado yonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 145:13"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 145:13"
      },
      "items": [
        {
          "text": "Yehova ndi wokhulupirika pa malonjezo ake onse",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:13"
      },
      "items": [
        {
          "text": "ndi wokonda zonse zimene Iye anazipanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 145:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova amagwiriziza onse amene akugwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.14",
            "verseOrgIds": [
              "PSA.145.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:14"
      },
      "items": [
        {
          "text": "ndipo amakweza onse otsitsidwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.14",
            "verseOrgIds": [
              "PSA.145.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 145:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maso a onse amayangʼana kwa Inu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.15",
            "verseOrgIds": [
              "PSA.145.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:15"
      },
      "items": [
        {
          "text": "ndipo Inu mumawapatsa chakudya chawo pa nthawi yoyenera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.15",
            "verseOrgIds": [
              "PSA.145.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 145:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumatsekula dzanja lanu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.16",
            "verseOrgIds": [
              "PSA.145.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:16"
      },
      "items": [
        {
          "text": "ndi kukwaniritsa zokhumba za chamoyo chilichonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.16",
            "verseOrgIds": [
              "PSA.145.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 145:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ndi wolungama mʼnjira zake zonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.17",
            "verseOrgIds": [
              "PSA.145.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:17"
      },
      "items": [
        {
          "text": "ndi wokonda zonse zimene anazipanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.17",
            "verseOrgIds": [
              "PSA.145.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
