    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Mikitamu ya Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndisungeni Inu Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.1",
            "verseOrgIds": [
              "PSA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:1"
      },
      "items": [
        {
          "text": "pakuti ine ndimathawira kwa Inu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.1",
            "verseOrgIds": [
              "PSA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinati kwa Yehova, \"Inu ndinu Ambuye anga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.2",
            "verseOrgIds": [
              "PSA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:2"
      },
      "items": [
        {
          "text": "popanda Inu, ine ndilibe chinthu chinanso chabwino.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.2",
            "verseOrgIds": [
              "PSA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunena za oyera mtima amene ali pa dziko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.3",
            "verseOrgIds": [
              "PSA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:3"
      },
      "items": [
        {
          "text": "amenewa ndi olemekezeka, amene ndimakondwera nawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.3",
            "verseOrgIds": [
              "PSA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu amene amathamangira kwa milungu ina",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:4"
      },
      "items": [
        {
          "text": "mavuto awo adzachulukadi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 16:4"
      },
      "items": [
        {
          "text": "Ine sindidzathira nawo nsembe zawo zamagazi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:4"
      },
      "items": [
        {
          "text": "kapena kutchula mayina awo ndi pakamwa panga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova, Inu mwandipatsa cholowa changa ndi chikho changa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.5",
            "verseOrgIds": [
              "PSA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:5"
      },
      "items": [
        {
          "text": "mwateteza kolimba gawo langa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.5",
            "verseOrgIds": [
              "PSA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malire a malo anga akhala pabwino;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.6",
            "verseOrgIds": [
              "PSA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:6"
      },
      "items": [
        {
          "text": "ndithudi, ine ndili cholowa chokondweretsa kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.6",
            "verseOrgIds": [
              "PSA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzatamanda Yehova amene amandipatsa uphungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.7",
            "verseOrgIds": [
              "PSA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:7"
      },
      "items": [
        {
          "text": "ngakhale usiku mtima wanga umandilangiza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.7",
            "verseOrgIds": [
              "PSA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndayika Yehova patsogolo panga nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.8",
            "verseOrgIds": [
              "PSA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:8"
      },
      "items": [
        {
          "text": "Popeza Iyeyo ali kudzanja langa lamanja,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.8",
            "verseOrgIds": [
              "PSA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:8"
      },
      "items": [
        {
          "text": "sindidzagwedezeka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.8",
            "verseOrgIds": [
              "PSA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho mtima wanga ndi wosangalala ndipo pakamwa panga pakukondwera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.9",
            "verseOrgIds": [
              "PSA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:9"
      },
      "items": [
        {
          "text": "thupi langanso lidzakhala pabwino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.9",
            "verseOrgIds": [
              "PSA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "chifukwa Inu simudzandisiya ku manda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.10",
            "verseOrgIds": [
              "PSA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:10"
      },
      "items": [
        {
          "text": "simudzalola kuti woyera wanu avunde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.10",
            "verseOrgIds": [
              "PSA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mwandidziwitsa njira ya moyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:11"
      },
      "items": [
        {
          "text": "mudzandidzaza ndi chimwemwe pamaso panu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:11"
      },
      "items": [
        {
          "text": "ndidzasangalala mpaka muyaya pa dzanja lanu lamanja.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        }
      ]
    }
  ],
