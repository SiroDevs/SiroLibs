  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "PSA 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akuyankhe pamene uli pa msautso;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.1",
            "verseOrgIds": [
              "PSA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:1"
      },
      "items": [
        {
          "text": "dzina la Mulungu wa Yakobo likuteteze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.1",
            "verseOrgIds": [
              "PSA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye atumize thandizo kuchokera ku malo ake opatulika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.2",
            "verseOrgIds": [
              "PSA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:2"
      },
      "items": [
        {
          "text": "akugwirizize kuchokera ku Ziyoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.2",
            "verseOrgIds": [
              "PSA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akumbukire nsembe zako zonse",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.3",
            "verseOrgIds": [
              "PSA.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:3"
      },
      "items": [
        {
          "text": "ndipo alandire nsembe zako zopsereza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.3",
            "verseOrgIds": [
              "PSA.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 20:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.20.3",
                "verseOrgIds": [
                  "PSA.20.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akupatse chokhumba cha mtima wako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.4",
            "verseOrgIds": [
              "PSA.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:4"
      },
      "items": [
        {
          "text": "ndipo akuthandize kuti zonse wakonza zichitike.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.4",
            "verseOrgIds": [
              "PSA.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife tidzafuwula ndi chimwemwe pamene iwe wapambana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:5"
      },
      "items": [
        {
          "text": "ndipo tidzanyamula mbendera zathu mʼdzina la Mulungu wathu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 20:5"
      },
      "items": [
        {
          "text": "Yehova ayankhe zopempha zako zonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano ndadziwa kuti Yehova amapulumutsa wodzozedwa wake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:6"
      },
      "items": [
        {
          "text": "Iye amamuyankha kuchokera kumwamba ku malo ake opatulika",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:6"
      },
      "items": [
        {
          "text": "ndi mphamvu yopulumutsa ya dzanja lake lamanja.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena amadalira magaleta ndipo ena akavalo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.7",
            "verseOrgIds": [
              "PSA.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:7"
      },
      "items": [
        {
          "text": "koma ife tidzadalira dzina la Yehova Mulungu wathu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.7",
            "verseOrgIds": [
              "PSA.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amagonjetsedwa ndi kugwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.8",
            "verseOrgIds": [
              "PSA.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:8"
      },
      "items": [
        {
          "text": "koma ife timadzuka ndi kuyima chilili.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.8",
            "verseOrgIds": [
              "PSA.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, pulumutsani mfumu!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.9",
            "verseOrgIds": [
              "PSA.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:9"
      },
      "items": [
        {
          "text": "Tiyankheni pamene tikuyitanani!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.9",
            "verseOrgIds": [
              "PSA.20.10"
            ]
          }
        }
      ]
    }
  ],
