  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "54",
        "style": "c",
        "sid": "PSA 54"
      },
      "items": [
        {
          "text": "54",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 54",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Pa zoyimbira za zingwe. Ndakatulo ya Davide. Pamene anthu a ku Zifi anapita kwa Sauli ndipo anati, \"Kodi Davide sakubisala pakati pathu.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 54:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pulumutseni Inu Mulungu, mwa dzina lanu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.1",
            "verseOrgIds": [
              "PSA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:1"
      },
      "items": [
        {
          "text": "onetsani kuti ndine wosalakwa mwamphamvu yanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.1",
            "verseOrgIds": [
              "PSA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 54:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imvani pemphero langa, Inu Mulungu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.2",
            "verseOrgIds": [
              "PSA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:2"
      },
      "items": [
        {
          "text": "mvetserani mawu a pakamwa panga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.2",
            "verseOrgIds": [
              "PSA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 54:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alendo akundithira nkhondo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:3"
      },
      "items": [
        {
          "text": "anthu ankhanza akufunafuna moyo wanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:3"
      },
      "items": [
        {
          "text": "anthu amene salabadira za Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 54:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zoonadi Mulungu ndi thandizo langa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.4",
            "verseOrgIds": [
              "PSA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:4"
      },
      "items": [
        {
          "text": "Ambuye ndiye amene amandichirikiza ine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.4",
            "verseOrgIds": [
              "PSA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 54:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lolani kuti choyipa chifike pa iwo amene amandichita chipongwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.5",
            "verseOrgIds": [
              "PSA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:5"
      },
      "items": [
        {
          "text": "mwa kukhulupirika kwanu awonongeni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.5",
            "verseOrgIds": [
              "PSA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 54:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzapereka nsembe yaufulu kwa Inu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.6",
            "verseOrgIds": [
              "PSA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:6"
      },
      "items": [
        {
          "text": "ndidzatamanda dzina lanu, Inu Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.6",
            "verseOrgIds": [
              "PSA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:6"
      },
      "items": [
        {
          "text": "pakuti ndi labwino.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.6",
            "verseOrgIds": [
              "PSA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 54:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Iyeyo wandipulumutsa ku masautso anga onse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.7",
            "verseOrgIds": [
              "PSA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:7"
      },
      "items": [
        {
          "text": "ndipo maso anga apenya kupambana kwa pa adani anga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.7",
            "verseOrgIds": [
              "PSA.54.9"
            ]
          }
        }
      ]
    }
  ],
