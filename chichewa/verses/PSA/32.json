      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:5"
      },
      "items": [
        {
          "text": "zolakwa zanga kwa Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 32:5"
      },
      "items": [
        {
