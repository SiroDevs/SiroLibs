      "attrs": {
        "style": "q2",
        "vid": "PSA 32:7"
      },
      "items": [
        {
          "text": "muzinditeteza ku mavuto ndipo muzindizinga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.7",
            "verseOrgIds": [
              "PSA.32.7"
            ]
          }
        }
      ]
    },
