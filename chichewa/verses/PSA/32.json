          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usakhale ngati kavalo kapena bulu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:9"
      },
      "items": [
        {
          "text": "zimene zilibe nzeru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 32:9"
      },
      "items": [
        {
          "text": "koma ziyenera kuwongoleredwa ndi zitsulo za mʼkamwa ndi pamutu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:9"
      },
      "items": [
        {
          "text": "ukapanda kutero sizibwera kwa iwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zowawa ndi zambiri za anthu oyipa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.10",
            "verseOrgIds": [
              "PSA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:10"
      },
      "items": [
        {
          "text": "koma chikondi chosatha cha Yehova",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.10",
            "verseOrgIds": [
              "PSA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:10"
      },
      "items": [
        {
          "text": "chimamuzinga munthu amene amadalira Iye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.10",
            "verseOrgIds": [
              "PSA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
