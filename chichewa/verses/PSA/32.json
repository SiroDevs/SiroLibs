          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakulangiza ndi kukuphunzitsa njira imene udzayendamo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.8",
            "verseOrgIds": [
              "PSA.32.8"
            ]
          }
        }
      ]
