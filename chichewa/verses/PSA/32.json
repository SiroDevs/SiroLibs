          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero ine ndinavomereza tchimo langa kwa Inu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
