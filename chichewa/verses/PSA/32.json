          "text": "Kondwerani mwa Yehova inu olungama;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.11",
            "verseOrgIds": [
              "PSA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:11"
      },
      "items": [
        {
          "text": "imbani, inu nonse amene muli owongoka mtima!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.11",
            "verseOrgIds": [
              "PSA.32.11"
            ]
          }
