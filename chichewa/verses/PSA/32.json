      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 32:6"
      },
      "items": [
        {
          "text": "ndithu pamene madzi amphamvu auka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.6",
            "verseOrgIds": [
              "PSA.32.6"
            ]
          }
        }
