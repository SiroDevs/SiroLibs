  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "PSA 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitsiru chimati mu mtima mwake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "\"Kulibe Mulungu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "Oterewa ndi oyipa ndipo ntchito zawo ndi zonyansa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "palibe amene amachita zabwino.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova kumwamba wayangʼana pansi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:2"
      },
      "items": [
        {
          "text": "kuyangʼana anthu onse",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 14:2"
      },
      "items": [
        {
          "text": "kuti aone ngati alipo wina wanzeru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:2"
      },
      "items": [
        {
          "text": "amene amafunafuna Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onse atembenukira kumbali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:3"
      },
      "items": [
        {
          "text": "onse pamodzi asanduka oyipa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 14:3"
      },
      "items": [
        {
          "text": "palibe amene amachita zabwino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:3"
      },
      "items": [
        {
          "text": "palibiretu ndi mmodzi yemwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi anthu ochita zoyipawa sadziwa chilichonse?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:4"
      },
      "items": [
        {
          "text": "Akudya anthu anga ngati chakudya chawo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:4"
      },
      "items": [
        {
          "text": "ndipo satamanda Yehova?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ali apowo, agwidwa ndi mantha aakulu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.5",
            "verseOrgIds": [
              "PSA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:5"
      },
      "items": [
        {
          "text": "pakuti Mulungu ali mʼgulu la olungama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.5",
            "verseOrgIds": [
              "PSA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu ochita zoyipa mumalepheretsa chikonzero cha anthu osauka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.6",
            "verseOrgIds": [
              "PSA.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:6"
      },
      "items": [
        {
          "text": "koma Yehova ndiye pothawirapo pawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.6",
            "verseOrgIds": [
              "PSA.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithu, chipulumutso cha Israeli chidzachokera ku Ziyoni!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:7"
      },
      "items": [
        {
          "text": "Pamene Yehova abwezeretsa ufulu wa anthu ake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:7"
      },
      "items": [
        {
          "text": "Yakobo akondwere ndipo Israeli asangalale!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        }
      ]
    }
  ],
