          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PSA 68:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa cha Nyumba yanu ku Yerusalemu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.29",
            "verseOrgIds": [
              "PSA.68.30"
            ]
          }
        }
      ]
    },
