      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:31"
      },
      "items": [
        {
          "text": "Kusi adzadzipereka yekha kwa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.31",
            "verseOrgIds": [
              "PSA.68.32"
            ]
          }
        }
      ]
    },
