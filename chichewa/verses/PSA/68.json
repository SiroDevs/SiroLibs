      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:28"
      },
      "items": [
        {
          "text": "tionetseni nyonga zanu, Inu Mulungu, monga munachitira poyamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.28",
            "verseOrgIds": [
              "PSA.68.29"
            ]
          }
        }
      ]
    },
    {
