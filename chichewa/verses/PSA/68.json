      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:23"
      },
      "items": [
        {
          "text": "pamene malilime a agalu anu akudyapo gawo lawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.23",
            "verseOrgIds": [
              "PSA.68.24"
            ]
          }
        }
      ]
    },
