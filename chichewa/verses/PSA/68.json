      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:22"
      },
      "items": [
        {
          "text": "ndidzawabweretsa kuchokera ku nyanja zozama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.22",
            "verseOrgIds": [
              "PSA.68.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
