          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayendedwe aulemu a anthu anu aonekera poyera, Inu Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.24",
            "verseOrgIds": [
              "PSA.68.25"
            ]
          }
        }
      ]
