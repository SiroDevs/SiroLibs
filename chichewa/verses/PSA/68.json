          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 68:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithu Mulungu adzaphwanya mitu ya adani ake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.21",
            "verseOrgIds": [
              "PSA.68.22"
            ]
