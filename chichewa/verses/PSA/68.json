      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:19"
      },
      "items": [
        {
          "text": "amene tsiku ndi tsiku amasenza zolemetsa zathu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.19",
            "verseOrgIds": [
              "PSA.68.20"
            ]
