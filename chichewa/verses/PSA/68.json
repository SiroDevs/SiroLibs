          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye akunena kuti, \"Ndidzawabweretsa kuchokera ku Basani;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.22",
            "verseOrgIds": [
              "PSA.68.23"
            ]
          }
        }
      ]
    },
