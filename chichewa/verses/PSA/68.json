          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamandani Mulungu mu msonkhano waukulu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.26",
            "verseOrgIds": [
              "PSA.68.27"
            ]
          }
        }
      ]
