      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:27"
      },
      "items": [
        {
          "text": "ndiponso pali ana a mafumu a Zebuloni ndi Nafutali.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.27",
            "verseOrgIds": [
              "PSA.68.28"
            ]
          }
        }
      ]
    },
