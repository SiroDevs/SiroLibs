  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "68",
        "style": "c",
        "sid": "PSA 68"
      },
      "items": [
        {
          "text": "68",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 68",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 68:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adzuke Mulungu, adani ake amwazikane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.1",
            "verseOrgIds": [
              "PSA.68.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:1"
      },
      "items": [
        {
          "text": "adani ake athawe pamaso pake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.1",
            "verseOrgIds": [
              "PSA.68.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 68:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga momwe mphepo imachotsera utsi; Inu muwawulutsire kutali.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.2",
            "verseOrgIds": [
              "PSA.68.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:2"
      },
      "items": [
        {
          "text": "Monga phula limasungunukira pa moto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.2",
            "verseOrgIds": [
              "PSA.68.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:2"
      },
      "items": [
        {
          "text": "oyipa awonongeke pamaso pa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.2",
            "verseOrgIds": [
              "PSA.68.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 68:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma olungama asangalale",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.3",
            "verseOrgIds": [
              "PSA.68.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:3"
      },
      "items": [
        {
          "text": "ndi kukondwera pamaso pa Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.3",
            "verseOrgIds": [
              "PSA.68.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:3"
      },
      "items": [
        {
          "text": "iwo akondwere ndi kusangalala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.3",
            "verseOrgIds": [
              "PSA.68.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 68:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirani Mulungu imbirani dzina lake matamando,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.4",
            "verseOrgIds": [
              "PSA.68.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:4"
      },
      "items": [
        {
          "text": "mukwezeni Iye amene amakwera pa mitambo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.4",
            "verseOrgIds": [
              "PSA.68.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:4"
      },
      "items": [
        {
          "text": "dzina lake ndi Yehova ndipo sangalalani pamaso pake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.4",
            "verseOrgIds": [
              "PSA.68.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 68:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atate wa ana amasiye, mtetezi wa akazi amasiye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.5",
            "verseOrgIds": [
              "PSA.68.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:5"
      },
      "items": [
        {
          "text": "ndiye Mulungu amene amakhala mʼmalo oyera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.5",
            "verseOrgIds": [
              "PSA.68.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 68:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu amakhazikitsa mtima pansi osungulumwa mʼmabanja,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.6",
            "verseOrgIds": [
              "PSA.68.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:6"
      },
      "items": [
        {
          "text": "amatsogolera amʼndende ndi kuyimba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.6",
            "verseOrgIds": [
              "PSA.68.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:6"
      },
      "items": [
        {
          "text": "koma anthu osamvera amakhala ku malo owuma a dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.6",
            "verseOrgIds": [
              "PSA.68.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 68:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene munatuluka kutsogolera anthu anu, Inu Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.7",
            "verseOrgIds": [
              "PSA.68.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:7"
      },
      "items": [
        {
          "text": "pamene munayenda kudutsa chipululu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.7",
            "verseOrgIds": [
              "PSA.68.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 68:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "dziko lapansi linagwedezeka, miyamba inakhuthula pansi mvula,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:8"
      },
      "items": [
        {
          "text": "pamaso pa Mulungu, Mmodzi uja wa ku Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:8"
      },
      "items": [
        {
          "text": "Pamaso pa Mulungu, Mulungu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 68:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munapereka mivumbi yochuluka, Inu Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.9",
            "verseOrgIds": [
              "PSA.68.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:9"
      },
      "items": [
        {
          "text": "munatsitsimutsa cholowa chanu cholefuka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.9",
            "verseOrgIds": [
              "PSA.68.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 68:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu anu anakhala mʼmenemo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.10",
            "verseOrgIds": [
              "PSA.68.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:10"
      },
      "items": [
        {
          "text": "ndipo munapatsa anthu osauka zimene zinkawasowa chifukwa cha ubwino wanu Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.10",
            "verseOrgIds": [
              "PSA.68.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 68:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye analengeza mawu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.11",
            "verseOrgIds": [
              "PSA.68.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:11"
      },
      "items": [
        {
          "text": "ndipo gulu linali lalikulu la iwo amene anapita kukawafalitsa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.11",
            "verseOrgIds": [
              "PSA.68.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 68:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mafumu ndi ankhondo anathawa mwaliwiro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.12",
            "verseOrgIds": [
              "PSA.68.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:12"
      },
      "items": [
        {
          "text": "mʼmisasa anthu anagawana zolanda pa nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.12",
            "verseOrgIds": [
              "PSA.68.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 68:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale mukugona pakati pa makola a ziweto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.13",
            "verseOrgIds": [
              "PSA.68.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:13"
      },
      "items": [
        {
          "text": "mapiko a nkhunda akutidwa ndi siliva,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.13",
            "verseOrgIds": [
              "PSA.68.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:13"
      },
      "items": [
        {
          "text": "nthenga zake ndi golide wonyezimira.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.13",
            "verseOrgIds": [
              "PSA.68.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 68:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Wamphamvuzonse anabalalitsa mafumu mʼdziko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.14",
            "verseOrgIds": [
              "PSA.68.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:14"
      },
      "items": [
        {
          "text": "zinali ngati matalala akugwa pa Zalimoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.14",
            "verseOrgIds": [
              "PSA.68.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 68:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapiri a Basani ndi mapiri aulemerero;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.15",
            "verseOrgIds": [
              "PSA.68.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:15"
      },
      "items": [
        {
          "text": "mapiri a Basani, ndi mapiri a msonga zambiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.15",
            "verseOrgIds": [
              "PSA.68.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 68:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyangʼaniranji mwansanje inu mapiri a msonga zambiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.16",
            "verseOrgIds": [
