      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:25"
      },
      "items": [
        {
          "text": "pamodzi ndi iwo pali atsikana akuyimba matambolini.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.25",
            "verseOrgIds": [
              "PSA.68.26"
            ]
          }
        }
      ]
    },
