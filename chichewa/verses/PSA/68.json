      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:30"
      },
      "items": [
        {
          "text": "gulu la ngʼombe zazimuna pakati pa ana angʼombe a mitundu ya anthu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.30",
            "verseOrgIds": [
              "PSA.68.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 68:30"
      },
      "items": [
        {
          "text": "Mochititsidwa manyazi, abweretse mitanda ya siliva.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.30",
            "verseOrgIds": [
              "PSA.68.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:30"
      },
      "items": [
        {
          "text": "Balalitsani anthu a mitundu ina amene amasangalatsidwa ndi nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.30",
            "verseOrgIds": [
              "PSA.68.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PSA 68:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthumwi zidzachokera ku Igupto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.31",
            "verseOrgIds": [
              "PSA.68.32"
            ]
          }
        }
      ]
    },
