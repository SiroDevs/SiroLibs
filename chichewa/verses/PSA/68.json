      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:20"
      },
      "items": [
        {
          "text": "Ambuye Wamphamvuzonse ndiye amene amatipulumutsa ku imfa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.20",
            "verseOrgIds": [
              "PSA.68.21"
            ]
          }
        }
      ]
