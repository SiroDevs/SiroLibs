          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu wathu ndi Mulungu amene amapulumutsa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.20",
            "verseOrgIds": [
              "PSA.68.21"
            ]
