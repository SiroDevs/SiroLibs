      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:24"
      },
      "items": [
        {
          "text": "mayendedwe olemekeza Mulungu wanga ndi Mfumu yanga yokalowa mʼmalo opatulika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.24",
            "verseOrgIds": [
              "PSA.68.25"
            ]
          }
        }
      ]
    },
    {
