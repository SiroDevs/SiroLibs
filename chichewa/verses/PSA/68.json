          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Inu munakwera mmwamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.18",
            "verseOrgIds": [
              "PSA.68.19"
            ]
