      "attrs": {
        "style": "q2",
        "vid": "PSA 68:18"
      },
      "items": [
        {
          "text": "munatsogolera a mʼndende ambiri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.18",
            "verseOrgIds": [
              "PSA.68.19"
            ]
          }
        }
      ]
