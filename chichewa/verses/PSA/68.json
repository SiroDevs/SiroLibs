          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti muviyike mapazi anu mʼmagazi a adani anu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.23",
            "verseOrgIds": [
              "PSA.68.24"
            ]
          }
        }
