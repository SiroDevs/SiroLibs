          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patsogolo pali oyimba nyimbo pakamwa, pambuyo pawo oyimba nyimbo ndi zipangizo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.25",
            "verseOrgIds": [
              "PSA.68.26"
            ]
          }
        }
      ]
