      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:21"
      },
      "items": [
        {
          "text": "zipewa za ubweya za iwo amene amapitiriza kuchita machimo awo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.21",
            "verseOrgIds": [
              "PSA.68.22"
            ]
          }
        }
      ]
    },
    {
