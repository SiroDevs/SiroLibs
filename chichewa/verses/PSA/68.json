      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:29"
      },
      "items": [
        {
          "text": "mafumu adzabweretsa kwa Inu mphatso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.29",
            "verseOrgIds": [
              "PSA.68.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PSA 68:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzudzulani chirombo pakati pa mabango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.30",
            "verseOrgIds": [
              "PSA.68.31"
            ]
          }
        }
      ]
    },
