      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:26"
      },
      "items": [
        {
          "text": "tamandani Yehova mu msonkhano wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.26",
            "verseOrgIds": [
              "PSA.68.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
