          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungani mphamvu zanu Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.28",
            "verseOrgIds": [
              "PSA.68.29"
            ]
          }
        }
      ]
