      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:27"
      },
      "items": [
        {
          "text": "pali gulu lalikulu la ana a mafumu a Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.27",
            "verseOrgIds": [
              "PSA.68.28"
            ]
          }
        }
      ]
    },
