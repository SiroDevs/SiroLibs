          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pali fuko lalingʼono la Benjamini, kuwatsogolera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.27",
            "verseOrgIds": [
              "PSA.68.28"
            ]
          }
        }
      ]
    },
