  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "109",
        "style": "c",
        "sid": "PSA 109"
      },
      "items": [
        {
          "text": "109",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 109",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wamayimbidwe. Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 109:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu amene ndimakutamandani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.1",
            "verseOrgIds": [
              "PSA.109.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:1"
      },
      "items": [
        {
          "text": "musakhale chete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.1",
            "verseOrgIds": [
              "PSA.109.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 109:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakuti anthu oyipa ndi achinyengo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.2",
            "verseOrgIds": [
              "PSA.109.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:2"
      },
      "items": [
        {
          "text": "atsekula pakamwa pawo kutsutsana nane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.2",
            "verseOrgIds": [
              "PSA.109.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:2"
      },
      "items": [
        {
          "text": "iwo ayankhula motsutsana nane ndi malilime abodza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.2",
            "verseOrgIds": [
              "PSA.109.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 109:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andizungulira ndi mawu audani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.3",
            "verseOrgIds": [
              "PSA.109.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:3"
      },
      "items": [
        {
          "text": "amandinena popanda chifukwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.3",
            "verseOrgIds": [
              "PSA.109.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 109:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmalo mwa chikondi changa amandineneza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.4",
            "verseOrgIds": [
              "PSA.109.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:4"
      },
      "items": [
        {
          "text": "koma ine ndine munthu wapemphero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.4",
            "verseOrgIds": [
              "PSA.109.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 109:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amandibwezera zoyipa mʼmalo mwa zabwino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.5",
            "verseOrgIds": [
              "PSA.109.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:5"
      },
      "items": [
        {
          "text": "ndi udani mʼmalo mwa chikondi changa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.5",
            "verseOrgIds": [
              "PSA.109.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 109:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sankhani munthu woyipa kuti amutsutse iye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.6",
            "verseOrgIds": [
              "PSA.109.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:6"
      },
      "items": [
        {
          "text": "lolani wotsutsa ayime ku dzanja lake lamanja.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.6",
            "verseOrgIds": [
              "PSA.109.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 109:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene aweruzidwa, apezeke kuti ndi wolakwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.7",
            "verseOrgIds": [
              "PSA.109.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:7"
      },
      "items": [
        {
          "text": "ndipo mapemphero ake amutsutse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.7",
            "verseOrgIds": [
              "PSA.109.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 109:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masiku ake akhale owerengeka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.8",
            "verseOrgIds": [
              "PSA.109.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:8"
      },
      "items": [
        {
          "text": "munthu wina atenge malo ake a utsogoleri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.8",
            "verseOrgIds": [
              "PSA.109.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 109:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ake akhale amasiye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.9",
            "verseOrgIds": [
              "PSA.109.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:9"
      },
      "items": [
        {
          "text": "ndipo mkazi wake akhale wopanda mwamuna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.9",
            "verseOrgIds": [
              "PSA.109.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 109:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ake akhale oyendayenda ndi opemphapempha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.10",
            "verseOrgIds": [
              "PSA.109.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:10"
      },
      "items": [
        {
          "text": "apirikitsidwe kuchoka pa mabwinja a nyumba zawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.10",
            "verseOrgIds": [
              "PSA.109.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 109:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wokongoza alande zonse zimene ali nazo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.11",
            "verseOrgIds": [
              "PSA.109.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:11"
      },
      "items": [
        {
          "text": "alendo afunkhe ntchito za manja ake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.11",
            "verseOrgIds": [
              "PSA.109.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 109:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasapezeke ndi mmodzi yemwe womukomera mtima",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.12",
            "verseOrgIds": [
              "PSA.109.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:12"
      },
      "items": [
        {
          "text": "kapena kumvera chisoni ana ake amasiye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.12",
            "verseOrgIds": [
              "PSA.109.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 109:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zidzukulu zake zithe nʼkufa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.13",
            "verseOrgIds": [
              "PSA.109.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:13"
      },
      "items": [
        {
          "text": "mayina awo afafanizidwe mu mʼbado wotsatirawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.13",
            "verseOrgIds": [
              "PSA.109.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 109:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mphulupulu za makolo ake zikumbukiridwe pamaso pa Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.14",
            "verseOrgIds": [
              "PSA.109.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:14"
      },
      "items": [
        {
          "text": "tchimo la amayi ake lisadzafafanizidwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.14",
            "verseOrgIds": [
              "PSA.109.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 109:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Machimo awo akhale pamaso pa Yehova nthawi zonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.15",
            "verseOrgIds": [
              "PSA.109.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:15"
      },
      "items": [
        {
          "text": "kuti Iye achotse chikumbutso chawo pa dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.15",
            "verseOrgIds": [
              "PSA.109.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 109:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti iye sanaganizirepo zochita chifundo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.16",
            "verseOrgIds": [
              "PSA.109.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:16"
      },
      "items": [
        {
          "text": "koma anazunza mpaka kuwapha anthu osauka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.16",
            "verseOrgIds": [
              "PSA.109.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:16"
      },
      "items": [
        {
          "text": "ndi osweka mtima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.16",
            "verseOrgIds": [
              "PSA.109.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 109:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakonda kutemberera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.17",
            "verseOrgIds": [
              "PSA.109.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:17"
      },
      "items": [
        {
          "text": "matembererowo abwerere kwa iye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.17",
            "verseOrgIds": [
              "PSA.109.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 109:17"
      },
      "items": [
        {
          "text": "sanakondwe nʼkudalitsa anthu ena,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.17",
            "verseOrgIds": [
              "PSA.109.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:17"
      },
      "items": [
        {
