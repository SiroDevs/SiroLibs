  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "PSA 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Sigioni wa Davide, amene anayimbira Yehova zokhudza Kusi, wa fuko la Benjamini.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova Mulungu wanga, Ine ndikuthawira kwa Inu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.1",
            "verseOrgIds": [
              "PSA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:1"
      },
      "items": [
        {
          "text": "pulumutseni ndi kundilanditsa kwa onse amene akundithamangitsa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.1",
            "verseOrgIds": [
              "PSA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwina angandikadzule ngati mkango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.2",
            "verseOrgIds": [
              "PSA.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:2"
      },
      "items": [
        {
          "text": "ndi kundingʼamba popanda wondipulumutsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.2",
            "verseOrgIds": [
              "PSA.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova Mulungu wanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.3",
            "verseOrgIds": [
              "PSA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:3"
      },
      "items": [
        {
          "text": "ngati ndachita izi ndipo ndapezeka wolakwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.3",
            "verseOrgIds": [
              "PSA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngati ndachita zoyipa kwa iye amene ndili naye pa mtendere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.4",
            "verseOrgIds": [
              "PSA.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:4"
      },
      "items": [
        {
          "text": "kapena popanda chifukwa ndalanda mdani wanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.4",
            "verseOrgIds": [
              "PSA.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamenepo lolani adani anga andithamangitse ndi kundipitirira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.5",
            "verseOrgIds": [
              "PSA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:5"
      },
      "items": [
        {
          "text": "lolani kuti moyo wanga aupondereze pansi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.5",
            "verseOrgIds": [
              "PSA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:5"
      },
      "items": [
        {
          "text": "ndipo mundigoneke pa fumbi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.5",
            "verseOrgIds": [
              "PSA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 7:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.7.5",
                "verseOrgIds": [
                  "PSA.7.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamukani Yehova, mu mkwiyo wanu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.6",
            "verseOrgIds": [
              "PSA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:6"
      },
      "items": [
        {
          "text": "nyamukani kutsutsana ndi mkwiyo wa adani anga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.6",
            "verseOrgIds": [
              "PSA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:6"
      },
      "items": [
        {
          "text": "Dzukani Mulungu wanga, lamulirani chilungamo chanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.6",
            "verseOrgIds": [
              "PSA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lolani gulu la anthu a mitundu ina lisonkhane mokuzungulirani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.7",
            "verseOrgIds": [
              "PSA.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:7"
      },
      "items": [
        {
          "text": "Alamulireni muli kumwambako;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.7",
            "verseOrgIds": [
              "PSA.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova aweruzeni anthu a mitundu inayo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.8",
            "verseOrgIds": [
              "PSA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 7:8"
      },
      "items": [
        {
          "text": "Ndiweruzeni Yehova, monga mwa chilungamo changa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.8",
            "verseOrgIds": [
              "PSA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:8"
      },
      "items": [
        {
          "text": "monga mwa moyo wanga wangwiro, Inu Wammwambamwamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.8",
            "verseOrgIds": [
              "PSA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Mulungu wolungama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:9"
      },
      "items": [
        {
          "text": "amene mumasanthula maganizo ndi mitima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 7:9"
      },
      "items": [
        {
          "text": "thetsani chiwawa cha anthu oyipa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:9"
      },
      "items": [
        {
          "text": "ndipo wolungama akhale motetezedwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chishango changa ndi Mulungu Wammwambamwamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.10",
            "verseOrgIds": [
              "PSA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:10"
      },
      "items": [
        {
          "text": "amene amapulumutsa olungama mtima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.10",
            "verseOrgIds": [
              "PSA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu amaweruza molungama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.11",
            "verseOrgIds": [
              "PSA.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:11"
      },
      "items": [
        {
          "text": "Mulungu amene amaonetsa ukali wake tsiku ndi tsiku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.11",
            "verseOrgIds": [
              "PSA.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati munthu satembenuka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.12",
            "verseOrgIds": [
              "PSA.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:12"
      },
      "items": [
        {
          "text": "Mulungu adzanola lupanga lake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.12",
            "verseOrgIds": [
              "PSA.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:12"
      },
      "items": [
        {
          "text": "Iye adzawerama ndi kukoka uta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.12",
            "verseOrgIds": [
              "PSA.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu wakonza zida zake zoopsa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.13",
            "verseOrgIds": [
              "PSA.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:13"
      },
      "items": [
        {
          "text": "Iye wakonzekera mivi yake yoyaka moto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.13",
            "verseOrgIds": [
              "PSA.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taonani, munthu woyipa amalingalira zoyipa zokhazokha nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.14",
            "verseOrgIds": [
              "PSA.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:14"
      },
      "items": [
        {
          "text": "Zochita zake ndi zosokoneza ndi zovutitsa anthu ena.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.14",
            "verseOrgIds": [
              "PSA.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amene akumba dzenje ndi kulizamitsa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.15",
            "verseOrgIds": [
              "PSA.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:15"
      },
      "items": [
        {
          "text": "amagwera mʼdzenje limene wakumbalo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.15",
            "verseOrgIds": [
              "PSA.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
