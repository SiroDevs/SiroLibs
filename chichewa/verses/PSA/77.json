  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "77",
        "style": "c",
        "sid": "PSA 77"
      },
      "items": [
        {
          "text": "77",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 77",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Potsata mayimbidwe a Yedutuni. Salimo la Asafu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 77:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinafuwulira Mulungu kupempha thandizo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.1",
            "verseOrgIds": [
              "PSA.77.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:1"
      },
      "items": [
        {
          "text": "ndinafuwula mokweza kwa Mulungu kuti anditcherere khutu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.1",
            "verseOrgIds": [
              "PSA.77.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 77:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ndinali pa masautso ndinafunafuna Ambuye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:2"
      },
      "items": [
        {
          "text": "usiku ndinatambasula manja mosalekeza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:2"
      },
      "items": [
        {
          "text": "ndipo moyo wanga unakana kutonthozedwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 77:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinakumbukira Inu Mulungu, ndipo ndinabuwula;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.3",
            "verseOrgIds": [
              "PSA.77.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:3"
      },
      "items": [
        {
          "text": "ndinasinkhasinkha ndipo mzimu wanga unalefuka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.3",
            "verseOrgIds": [
              "PSA.77.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 77:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.77.3",
                "verseOrgIds": [
                  "PSA.77.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 77:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munagwira zikope zanga kuti ndisagone",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.4",
            "verseOrgIds": [
              "PSA.77.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:4"
      },
      "items": [
        {
          "text": "ndipo ndinavutika kwambiri kuti ndiyankhule.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.4",
            "verseOrgIds": [
              "PSA.77.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 77:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinaganizira za masiku akale,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.5",
            "verseOrgIds": [
              "PSA.77.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:5"
      },
      "items": [
        {
          "text": "zaka zamakedzana;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.5",
            "verseOrgIds": [
              "PSA.77.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 77:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinakumbukira nyimbo zanga usiku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.6",
            "verseOrgIds": [
              "PSA.77.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:6"
      },
      "items": [
        {
          "text": "Mtima wanga unasinkhasinkha ndipo mzimu wanga unafunsa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.6",
            "verseOrgIds": [
              "PSA.77.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 77:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi Ambuye adzatikana mpaka muyaya?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.7",
            "verseOrgIds": [
              "PSA.77.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:7"
      },
      "items": [
        {
          "text": "Kodi Iwo sadzaonetsanso kukoma mtima kwawo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.7",
            "verseOrgIds": [
              "PSA.77.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 77:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Chikondi chake chosatha chija chatheratu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.8",
            "verseOrgIds": [
              "PSA.77.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:8"
      },
      "items": [
        {
          "text": "Kodi malonjezo ake alephera nthawi yonse?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.8",
            "verseOrgIds": [
              "PSA.77.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 77:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Mulungu wayiwala kukhala wokoma mtima?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.9",
            "verseOrgIds": [
              "PSA.77.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:9"
      },
      "items": [
        {
          "text": "Kodi mu mkwiyo wake waleka chifundo chake?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.9",
            "verseOrgIds": [
              "PSA.77.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 77:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ndinaganiza, \"Pa izi ine ndidzapemphanso:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.10",
            "verseOrgIds": [
              "PSA.77.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:10"
      },
      "items": [
        {
          "text": "zaka za dzanja lamanja la Wammwambamwamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.10",
            "verseOrgIds": [
              "PSA.77.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 77:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzakumbukira ntchito za Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.11",
            "verseOrgIds": [
              "PSA.77.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:11"
      },
      "items": [
        {
          "text": "Ine ndidzakumbukira zodabwitsa zanu za kalekale.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.11",
            "verseOrgIds": [
              "PSA.77.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 77:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakumbukira ntchito zanu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.12",
            "verseOrgIds": [
              "PSA.77.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:12"
      },
      "items": [
        {
          "text": "ndi kulingalira zodabwitsa zanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.12",
            "verseOrgIds": [
              "PSA.77.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 77:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njira zanu Mulungu ndi zoyera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.13",
            "verseOrgIds": [
              "PSA.77.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:13"
      },
      "items": [
        {
          "text": "Kodi ndi mulungu uti ali wamkulu kuposa Mulungu wathu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.13",
            "verseOrgIds": [
              "PSA.77.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 77:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu ndinu Mulungu wochita zodabwitsa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.14",
            "verseOrgIds": [
              "PSA.77.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:14"
      },
      "items": [
        {
          "text": "Mumaonetsera mphamvu yanu pakati pa mitundu ya anthu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.14",
            "verseOrgIds": [
              "PSA.77.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 77:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi dzanja lanu lamphamvu munawombola anthu anu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.15",
            "verseOrgIds": [
              "PSA.77.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:15"
      },
      "items": [
        {
          "text": "zidzukulu za Yakobo ndi Yosefe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.15",
            "verseOrgIds": [
              "PSA.77.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 77:15"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.77.15",
                "verseOrgIds": [
                  "PSA.77.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 77:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzi anakuonani Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.16",
            "verseOrgIds": [
              "PSA.77.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:16"
      },
      "items": [
        {
          "text": "madzi anakuonani ndipo anachita mantha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.16",
            "verseOrgIds": [
              "PSA.77.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:16"
      },
      "items": [
        {
          "text": "nyanja yozama inakomoka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.16",
            "verseOrgIds": [
              "PSA.77.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
