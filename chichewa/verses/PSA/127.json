          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ndiye cholowa chochokera kwa Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.3",
            "verseOrgIds": [
              "PSA.127.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:3"
      },
      "items": [
        {
          "text": "ana ndi mphotho yochokera kwa Iye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.3",
            "verseOrgIds": [
              "PSA.127.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 127:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a pa unyamata ali ngati mivi mʼmanja",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.4",
            "verseOrgIds": [
              "PSA.127.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:4"
      },
      "items": [
        {
          "text": "mwa munthu wankhondo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.4",
            "verseOrgIds": [
              "PSA.127.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
