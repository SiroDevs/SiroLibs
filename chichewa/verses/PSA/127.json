          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wodala munthu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.5",
            "verseOrgIds": [
              "PSA.127.5"
            ]
          }
        }
      ]
    },
