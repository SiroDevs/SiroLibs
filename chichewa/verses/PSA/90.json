        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 90",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pemphero la Mose munthu wa Mulungu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 90:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye, mwakhala muli malo athu okhalamo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.1",
            "verseOrgIds": [
              "PSA.90.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:1"
      },
      "items": [
        {
          "text": "pa mibado yonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.1",
            "verseOrgIds": [
              "PSA.90.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 90:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapiri asanabadwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:2"
      },
      "items": [
        {
          "text": "musanalenge nʼkomwe dziko lapansi ndi dziko lonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:2"
      },
      "items": [
        {
          "text": "kuyambira muyaya mpaka muyaya Inu ndinu Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 90:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mumabwezera anthu ku fumbi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.3",
            "verseOrgIds": [
              "PSA.90.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:3"
      },
      "items": [
        {
          "text": "mumati, \"Bwerera ku fumbi iwe mwana wa munthu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.3",
            "verseOrgIds": [
              "PSA.90.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 90:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti zaka 1,000 pamaso panu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.4",
            "verseOrgIds": [
              "PSA.90.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:4"
      },
      "items": [
        {
          "text": "zili ngati tsiku limene lapita",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.4",
            "verseOrgIds": [
              "PSA.90.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:4"
      },
      "items": [
        {
          "text": "kapena ngati kamphindi ka usiku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.4",
            "verseOrgIds": [
              "PSA.90.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 90:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mumasesa anthu mʼtulo ta imfa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.5",
            "verseOrgIds": [
              "PSA.90.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:5"
      },
      "items": [
        {
          "text": "iwo ali ngati udzu watsopano wa mmawa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.5",
            "verseOrgIds": [
              "PSA.90.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 90:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngakhale kuti mmawa umaphuka watsopano,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.6",
            "verseOrgIds": [
              "PSA.90.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:6"
      },
      "items": [
        {
          "text": "pofika madzulo wauma ndi kufota.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.6",
            "verseOrgIds": [
              "PSA.90.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 90:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife tathedwa ndi mkwiyo wanu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.7",
            "verseOrgIds": [
              "PSA.90.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:7"
      },
      "items": [
        {
          "text": "ndipo taopsezedwa ndi kuyipidwa kwanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.7",
            "verseOrgIds": [
              "PSA.90.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 90:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwayika mphulupulu zathu pamaso panu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.8",
            "verseOrgIds": [
              "PSA.90.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:8"
      },
      "items": [
        {
          "text": "machimo athu obisika poonekera pamaso panu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.8",
            "verseOrgIds": [
              "PSA.90.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 90:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masiku athu onse amatha ali pansi pa ukali wanu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.9",
            "verseOrgIds": [
              "PSA.90.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:9"
      },
      "items": [
        {
          "text": "timatsiriza zaka zathu ndi kubuwula.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.9",
            "verseOrgIds": [
              "PSA.90.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 90:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchuluka kwa masiku athu ndi 70,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "kapena 80 ngati tili ndi mphamvu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "komabe zaka zonsezi ndi za mavuto ndi nkhawa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "zimatha mofulumira ndipo ife timawulukira kutali.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 90:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ndani amadziwa mphamvu ya mkwiyo wanu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.11",
            "verseOrgIds": [
              "PSA.90.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:11"
      },
      "items": [
        {
          "text": "Pakuti ukali wanu ndi waukulu ngati ulemu umene uyenera Inu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.11",
            "verseOrgIds": [
              "PSA.90.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 90:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiphunzitseni kuwerenga masiku athu molondola,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.12",
            "verseOrgIds": [
              "PSA.90.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:12"
      },
      "items": [
        {
          "text": "kuti tikhale ndi mtima wanzeru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.12",
            "verseOrgIds": [
              "PSA.90.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 90:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezani mtima Inu Yehova! Kodi mudzatikwiyira mpaka liti?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.13",
            "verseOrgIds": [
              "PSA.90.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:13"
      },
      "items": [
        {
          "text": "Achitireni chifundo atumiki anu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.13",
            "verseOrgIds": [
              "PSA.90.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 90:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutikhutitse mmawa ndi chikondi chanu chosatha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.14",
            "verseOrgIds": [
              "PSA.90.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:14"
      },
      "items": [
        {
          "text": "kuti tiyimbe ndi chimwemwe ndi kukhala okondwa masiku athu onse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.14",
            "verseOrgIds": [
              "PSA.90.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 90:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tisangalatseni masiku ambiri monga masiku amene mwatisautsa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.15",
            "verseOrgIds": [
              "PSA.90.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:15"
      },
      "items": [
        {
          "text": "kwa zaka zambiri monga momwe tinaonera mavuto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.15",
            "verseOrgIds": [
              "PSA.90.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 90:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito zanu zionetsedwe kwa atumiki anu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.16",
            "verseOrgIds": [
              "PSA.90.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:16"
      },
      "items": [
        {
