  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "92",
        "style": "c",
        "sid": "PSA 92"
      },
      "items": [
        {
          "text": "92",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 92",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salimo. Nyimbo ya pa tsiku la Sabata.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 92:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼkwabwino kutamanda Yehova",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.1",
            "verseOrgIds": [
              "PSA.92.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:1"
      },
      "items": [
        {
          "text": "ndi kuyimbira nyimbo dzina lanu, Inu Wammwambamwamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.1",
            "verseOrgIds": [
              "PSA.92.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 92:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulengeza chikondi chanu mmawa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.2",
            "verseOrgIds": [
              "PSA.92.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:2"
      },
      "items": [
        {
          "text": "ndi kukhulupirika kwanu nthawi ya usiku,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.2",
            "verseOrgIds": [
              "PSA.92.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 92:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuyimbira nyimbo choyimbira cha zingwe khumi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.3",
            "verseOrgIds": [
              "PSA.92.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:3"
      },
      "items": [
        {
          "text": "ndi mayimbidwe abwino a zeze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.3",
            "verseOrgIds": [
              "PSA.92.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 92:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Inu mumandisangalatsa ndi ntchito zanu, Inu Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.4",
            "verseOrgIds": [
              "PSA.92.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:4"
      },
      "items": [
        {
          "text": "Ine ndikuyimba mwachimwemwe pa ntchito ya manja anu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.4",
            "verseOrgIds": [
              "PSA.92.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 92:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi yayikuludi ntchito yanu Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.5",
            "verseOrgIds": [
              "PSA.92.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:5"
      },
      "items": [
        {
          "text": "maganizo anu ndi ozamadi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.5",
            "verseOrgIds": [
              "PSA.92.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 92:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu wopanda nzeru sadziwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.6",
            "verseOrgIds": [
              "PSA.92.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:6"
      },
      "items": [
        {
          "text": "zitsiru sizizindikira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.6",
            "verseOrgIds": [
              "PSA.92.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 92:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti ngakhale anthu oyipa aphuka ngati udzu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.7",
            "verseOrgIds": [
              "PSA.92.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:7"
      },
      "items": [
        {
          "text": "ndipo anthu onse ochita zoyipa apindula,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.7",
            "verseOrgIds": [
              "PSA.92.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 92:7"
      },
      "items": [
        {
          "text": "adzawonongedwa kwamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.7",
            "verseOrgIds": [
              "PSA.92.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 92:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Inu Yehova, ndinu wokwezedwa kwamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.8",
            "verseOrgIds": [
              "PSA.92.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 92:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zoonadi adani anu Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.9",
            "verseOrgIds": [
              "PSA.92.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:9"
      },
      "items": [
        {
          "text": "zoonadi adani anu adzawonongeka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.9",
            "verseOrgIds": [
              "PSA.92.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:9"
      },
      "items": [
        {
          "text": "onse ochita zoyipa adzabalalitsidwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.9",
            "verseOrgIds": [
              "PSA.92.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 92:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mwakweza nyanga yanga ngati nyanga ya njati;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.10",
            "verseOrgIds": [
              "PSA.92.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:10"
      },
      "items": [
        {
          "text": "mafuta abwino akhuthulidwa pamutu wanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.10",
            "verseOrgIds": [
              "PSA.92.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 92:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maso anga aona kugonjetsedwa kwa olimbana nane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.11",
            "verseOrgIds": [
              "PSA.92.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:11"
      },
      "items": [
        {
          "text": "makutu anga amva za kugwa kwa amaliwongo anga oyipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.11",
            "verseOrgIds": [
              "PSA.92.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 92:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu olungama adzaphuka ngati mtengo wa mgwalangwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.12",
            "verseOrgIds": [
              "PSA.92.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:12"
      },
      "items": [
        {
          "text": "adzakula ngati mkungudza wa ku Lebanoni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.12",
            "verseOrgIds": [
              "PSA.92.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 92:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "odzalidwa mʼnyumba ya Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.13",
            "verseOrgIds": [
              "PSA.92.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:13"
      },
      "items": [
        {
          "text": "adzakula bwino mʼmabwalo a Mulungu wathu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.13",
            "verseOrgIds": [
              "PSA.92.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 92:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo adzaberekabe zipatso mu ukalamba wawo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.14",
            "verseOrgIds": [
              "PSA.92.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:14"
      },
      "items": [
        {
          "text": "adzakhala anthete ndi obiriwira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.14",
            "verseOrgIds": [
              "PSA.92.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 92:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulengeza kuti, \"Yehova ndi wolungama;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.15",
            "verseOrgIds": [
              "PSA.92.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:15"
      },
      "items": [
        {
          "text": "Iye ndiye Thanthwe langa, ndipo mwa Iye mulibe choyipa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.15",
            "verseOrgIds": [
              "PSA.92.16"
            ]
          }
        }
      ]
    }
  ],
