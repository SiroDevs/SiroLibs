  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "PSA 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Pa zoyimbira za zingwe. Molingana ndi seminiti. Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, musandidzudzule mu mkwiyo wanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.1",
            "verseOrgIds": [
              "PSA.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:1"
      },
      "items": [
        {
          "text": "kapena kundilanga mu ukali wanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.1",
            "verseOrgIds": [
              "PSA.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichitireni chifundo Inu Yehova, pakuti ndalefuka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.2",
            "verseOrgIds": [
              "PSA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:2"
      },
      "items": [
        {
          "text": "Inu Yehova chiritseni, pakuti mafupa anga ali pa ululu waukulu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.2",
            "verseOrgIds": [
              "PSA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyo wanga uli pa mazunzo aakulu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.3",
            "verseOrgIds": [
              "PSA.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:3"
      },
      "items": [
        {
          "text": "Mpaka liti, Inu Yehova, mpaka liti?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.3",
            "verseOrgIds": [
              "PSA.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tembenukani Inu Yehova, ndipo mundilanditse;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.4",
            "verseOrgIds": [
              "PSA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:4"
      },
      "items": [
        {
          "text": "pulumutseni chifukwa cha chikondi chanu chosasinthika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.4",
            "verseOrgIds": [
              "PSA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palibe amene amakukumbukirani pamene wamwalira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.5",
            "verseOrgIds": [
              "PSA.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:5"
      },
      "items": [
        {
          "text": "Amakutamandani ndani ali ku manda?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.5",
            "verseOrgIds": [
              "PSA.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndatopa ndi kubuwula;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.6",
            "verseOrgIds": [
              "PSA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:6"
      },
      "items": [
        {
          "text": "usiku wonse pa bedi panga pamadzaza ndi misozi yanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.6",
            "verseOrgIds": [
              "PSA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:6"
      },
      "items": [
        {
          "text": "ndimanyowetsa pogona panga ndi misozi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.6",
            "verseOrgIds": [
              "PSA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maso anga atupa chifukwa cha chisoni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.7",
            "verseOrgIds": [
              "PSA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:7"
      },
      "items": [
        {
          "text": "akulephera kuona chifukwa cha adani anga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.7",
            "verseOrgIds": [
              "PSA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chokani kwa ine inu nonse amene mumachita zoyipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.8",
            "verseOrgIds": [
              "PSA.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:8"
      },
      "items": [
        {
          "text": "pakuti Yehova wamva kulira kwanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.8",
            "verseOrgIds": [
              "PSA.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamva kupempha kwanga kofuna chifundo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.9",
            "verseOrgIds": [
              "PSA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:9"
      },
      "items": [
        {
          "text": "Yehova walandira pemphero langa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.9",
            "verseOrgIds": [
              "PSA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adani anga onse adzachita manyazi ndipo adzakhala ndi mantha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.10",
            "verseOrgIds": [
              "PSA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:10"
      },
      "items": [
        {
          "text": "adzabwerera msangamsanga mwa manyazi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.10",
            "verseOrgIds": [
              "PSA.6.11"
            ]
          }
        }
      ]
    }
  ],
