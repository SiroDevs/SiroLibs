  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "94",
        "style": "c",
        "sid": "PSA 94"
      },
      "items": [
        {
          "text": "94",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 94",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 94:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, ndinu Mulungu wobwezera chilango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:1"
      },
      "items": [
        {
          "text": "Inu Mulungu amene mumabwezera chilango, wonetsani kuwala kwanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 94:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamukani, Inu woweruza wa dziko lapansi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.2",
            "verseOrgIds": [
              "PSA.94.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:2"
      },
      "items": [
        {
          "text": "bwezerani kwa odzikuza zowayenera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.2",
            "verseOrgIds": [
              "PSA.94.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 94:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi mpaka liti anthu oyipa Inu Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.3",
            "verseOrgIds": [
              "PSA.94.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:3"
      },
      "items": [
        {
          "text": "mpaka liti anthu oyipa adzalumpha ndi chimwemwe?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.3",
            "verseOrgIds": [
              "PSA.94.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 94:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuthula mawu onyada;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.4",
            "verseOrgIds": [
              "PSA.94.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:4"
      },
      "items": [
        {
          "text": "onse ochita zoyipa ndi odzaza ndi kudzikuza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.4",
            "verseOrgIds": [
              "PSA.94.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 94:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaphwanya anthu anu, Inu Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.5",
            "verseOrgIds": [
              "PSA.94.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:5"
      },
      "items": [
        {
          "text": "amapondereza cholowa chanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.5",
            "verseOrgIds": [
              "PSA.94.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 94:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaphanso amayi a masiye ndi alendo okhala nawo mʼdziko;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.6",
            "verseOrgIds": [
              "PSA.94.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:6"
      },
      "items": [
        {
          "text": "amapha ana amasiye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.6",
            "verseOrgIds": [
              "PSA.94.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 94:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amati, \"Yehova sakuona;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.7",
            "verseOrgIds": [
              "PSA.94.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:7"
      },
      "items": [
        {
          "text": "Mulungu wa Yakobo salabadirako.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.7",
            "verseOrgIds": [
              "PSA.94.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 94:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samalani, inu anthu opanda nzeru pakati pa anthu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.8",
            "verseOrgIds": [
              "PSA.94.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:8"
      },
      "items": [
        {
          "text": "zitsiru inu, kodi mudzakhala liti anzeru?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.8",
            "verseOrgIds": [
              "PSA.94.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 94:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Iye amene anapanga khutu sangathe kumva?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.9",
            "verseOrgIds": [
              "PSA.94.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:9"
      },
      "items": [
        {
          "text": "Kodi Iye amene anapanga diso sangathe kuona?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.9",
            "verseOrgIds": [
              "PSA.94.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 94:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Iye amene amalangiza mitundu ya anthu sangathenso kulanga?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.10",
            "verseOrgIds": [
              "PSA.94.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:10"
      },
      "items": [
        {
          "text": "Kodi Iye amene amaphunzitsa munthu angasowe nzeru?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.10",
            "verseOrgIds": [
              "PSA.94.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 94:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova amadziwa maganizo a munthu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.11",
            "verseOrgIds": [
              "PSA.94.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:11"
      },
      "items": [
        {
          "text": "Iye amadziwa kuti maganizowo ndi achabechabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.11",
            "verseOrgIds": [
              "PSA.94.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 94:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wodala munthu amene Inu Yehova mumamulangiza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.12",
            "verseOrgIds": [
              "PSA.94.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:12"
      },
      "items": [
        {
          "text": "munthu amene mumamuphunzitsa kuchokera mulamulo lanu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.12",
            "verseOrgIds": [
              "PSA.94.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 94:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumamupumitsa pa nthawi ya mavuto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.13",
            "verseOrgIds": [
              "PSA.94.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:13"
      },
      "items": [
        {
          "text": "mpaka woyipa atakumbiridwa dzenje.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.13",
            "verseOrgIds": [
              "PSA.94.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 94:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Yehova sadzawakana anthu ake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.14",
            "verseOrgIds": [
              "PSA.94.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:14"
      },
      "items": [
        {
          "text": "Iye sadzasiya cholowa chake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.14",
            "verseOrgIds": [
              "PSA.94.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 94:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiweruzo chidzakhazikikanso pa chilungamo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.15",
            "verseOrgIds": [
              "PSA.94.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:15"
      },
      "items": [
        {
          "text": "ndipo onse olungama mtima adzachitsata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.15",
            "verseOrgIds": [
              "PSA.94.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 94:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani adzadzuka chifukwa cha ine kulimbana ndi anthu oyipa?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.16",
            "verseOrgIds": [
              "PSA.94.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:16"
      },
      "items": [
        {
          "text": "Ndani adzayimirira mʼmalo mwanga kulimbana ndi anthu ochita zoyipa?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.16",
            "verseOrgIds": [
              "PSA.94.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 94:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akanapanda kundithandiza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.17",
            "verseOrgIds": [
              "PSA.94.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:17"
      },
      "items": [
        {
          "text": "bwenzi nditakakhala msanga ku malo achete a imfa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.17",
            "verseOrgIds": [
              "PSA.94.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 94:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikanena kuti, \"Phazi langa likuterereka,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.18",
            "verseOrgIds": [
              "PSA.94.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:18"
      },
      "items": [
        {
          "text": "chikondi chanu, Inu Yehova, chimandichirikiza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.18",
            "verseOrgIds": [
              "PSA.94.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
