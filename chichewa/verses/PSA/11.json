  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "PSA 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa Yehova ine ndimathawiramo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:1"
      },
      "items": [
        {
          "text": "Nanga mungathe bwanji kunena kwa ine kuti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:1"
      },
      "items": [
        {
          "text": "\"Thawira ku phiri lako ngati mbalame.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti taona oyipa akunga mauta awo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.2",
            "verseOrgIds": [
              "PSA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:2"
      },
      "items": [
        {
          "text": "ayika bwino mivi yawo pa zingwe za uta,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.2",
            "verseOrgIds": [
              "PSA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 11:2"
      },
      "items": [
        {
          "text": "pobisala pawo kuti alase",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.2",
            "verseOrgIds": [
              "PSA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:2"
      },
      "items": [
        {
          "text": "olungama mtima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.2",
            "verseOrgIds": [
              "PSA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono ngati maziko awonongeka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.3",
            "verseOrgIds": [
              "PSA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:3"
      },
      "items": [
        {
          "text": "olungama angachite chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.3",
            "verseOrgIds": [
              "PSA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ali mʼNyumba yake yoyera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.4",
            "verseOrgIds": [
              "PSA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:4"
      },
      "items": [
        {
          "text": "Yehova ali pa mpando wake waufumu kumwamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.4",
            "verseOrgIds": [
              "PSA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 11:4"
      },
      "items": [
        {
          "text": "Iye amayangʼanitsitsa ana a anthu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.4",
            "verseOrgIds": [
              "PSA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:4"
      },
      "items": [
        {
          "text": "maso ake amawayesa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.4",
            "verseOrgIds": [
              "PSA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova amayesa olungama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.5",
            "verseOrgIds": [
              "PSA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:5"
      },
      "items": [
        {
          "text": "koma moyo wake umadana ndi oyipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.5",
            "verseOrgIds": [
              "PSA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:5"
      },
      "items": [
        {
          "text": "amene amakonda zachiwawa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.5",
            "verseOrgIds": [
              "PSA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzakhuthulira pa oyipa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.6",
            "verseOrgIds": [
              "PSA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:6"
      },
      "items": [
        {
          "text": "makala amoto ndi sulufule woyaka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.6",
            "verseOrgIds": [
              "PSA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:6"
      },
      "items": [
        {
          "text": "mphepo yotentha idzakhala yowayenera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.6",
            "verseOrgIds": [
              "PSA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Yehova ndi wolungama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.7",
            "verseOrgIds": [
              "PSA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:7"
      },
      "items": [
        {
          "text": "Iye amakonda chilungamo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.7",
            "verseOrgIds": [
              "PSA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:7"
      },
      "items": [
        {
          "text": "ndipo anthu olungama adzaona nkhope yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.7",
            "verseOrgIds": [
              "PSA.11.7"
            ]
          }
        }
      ]
    }
  ],
