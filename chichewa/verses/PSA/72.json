        "sid": "PSA 72"
      },
      "items": [
        {
          "text": "72",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 72",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salimo la Solomoni.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 72:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patsani mwana wa mfumu nzeru zanu zoweruzira mwa chilungamo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.1",
            "verseOrgIds": [
              "PSA.72.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:1"
      },
      "items": [
        {
          "text": "Inu Mulungu mupatseni mwana wa mfumu chilungamo chanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.1",
            "verseOrgIds": [
              "PSA.72.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 72:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzaweruza anthu anu mwachilungamo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.2",
            "verseOrgIds": [
              "PSA.72.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:2"
      },
      "items": [
        {
          "text": "anthu anu ozunzika mosakondera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.2",
            "verseOrgIds": [
              "PSA.72.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 72:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapiri adzabweretsa chuma kwa anthu anu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.3",
            "verseOrgIds": [
              "PSA.72.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:3"
      },
      "items": [
        {
          "text": "timapiri tidzabweretsa zipatso zachilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.3",
            "verseOrgIds": [
              "PSA.72.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 72:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzateteza ozunzika pakati pa anthu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:4"
      },
      "items": [
        {
          "text": "ndi kupulumutsa ana a anthu osowa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:4"
      },
      "items": [
        {
          "text": "adzaphwanya ozunza anzawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 72:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adzakhala ndi moyo pa mibado yonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.5",
            "verseOrgIds": [
              "PSA.72.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:5"
      },
      "items": [
        {
          "text": "nthawi zonse pamene dzuwa ndi mwezi zikuwala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.5",
            "verseOrgIds": [
              "PSA.72.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 72:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzakhala kugwa kwa mvula pa minda yolimidwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.6",
            "verseOrgIds": [
              "PSA.72.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:6"
      },
      "items": [
        {
          "text": "ngati mivumbi yothirira dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.6",
            "verseOrgIds": [
              "PSA.72.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 72:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmasiku a munthu wolungama adzakhazikika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.7",
            "verseOrgIds": [
              "PSA.72.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:7"
      },
      "items": [
        {
          "text": "chuma chidzachuluka mpaka mwezi utaleka kuwala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.7",
            "verseOrgIds": [
              "PSA.72.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 72:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzalamulira kuchokera ku nyanja ina mpaka ku nyanja ina",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.8",
            "verseOrgIds": [
              "PSA.72.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:8"
      },
      "items": [
        {
          "text": "ndiponso kuchokera ku mtsinje mpaka ku malekezero a dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.8",
            "verseOrgIds": [
              "PSA.72.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 72:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuko a mʼchipululu adzawerama pamaso pake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.9",
            "verseOrgIds": [
              "PSA.72.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:9"
      },
      "items": [
        {
          "text": "ndipo adani ake adzanyambita fumbi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.9",
            "verseOrgIds": [
              "PSA.72.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 72:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafumu a ku Tarisisi ndi a ku zilumba zakutali",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:10"
      },
      "items": [
        {
          "text": "adzabweretsa mitulo kwa iye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 72:10"
      },
      "items": [
        {
          "text": "mafumu a ku Seba ndi Seba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:10"
      },
      "items": [
        {
          "text": "adzapereka mphatso kwa iyeyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 72:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafumu onse adzamuweramira",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.11",
            "verseOrgIds": [
              "PSA.72.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:11"
      },
      "items": [
        {
          "text": "ndipo mitundu yonse idzamutumikira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.11",
            "verseOrgIds": [
              "PSA.72.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 72:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti iye adzawombola wosowa amene akulira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.12",
            "verseOrgIds": [
              "PSA.72.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:12"
      },
      "items": [
        {
          "text": "wozunzika amene alibe wina womuthandiza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.12",
            "verseOrgIds": [
              "PSA.72.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 72:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzachitira chifundo anthu ofowoka ndi anthu osowa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.13",
            "verseOrgIds": [
              "PSA.72.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:13"
      },
      "items": [
        {
          "text": "ndi kupulumutsa osowa ku imfa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.13",
            "verseOrgIds": [
              "PSA.72.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 72:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzalanditsa iwo ku mazunzo ndi chiwawa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.14",
            "verseOrgIds": [
              "PSA.72.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:14"
      },
      "items": [
        {
          "text": "pakuti magazi awo ndi amtengo wapatali pamaso pake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.14",
            "verseOrgIds": [
              "PSA.72.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 72:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akhale ndi moyo wautali;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:15"
      },
      "items": [
        {
          "text": "golide ochokera ku Seba apatsidwe kwa iye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 72:15"
      },
      "items": [
        {
          "text": "Anthu amupempherere nthawi zonse",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:15"
      },
      "items": [
        {
          "text": "ndi kumudalitsa tsiku lonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 72:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulole kuti tirigu achuluke mʼdziko lonse;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.16",
            "verseOrgIds": [
              "PSA.72.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:16"
      },
      "items": [
        {
          "text": "pamwamba pa mapiri pakhale tirigu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.16",
            "verseOrgIds": [
              "PSA.72.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
