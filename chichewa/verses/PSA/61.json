        "number": "61",
        "style": "c",
        "sid": "PSA 61"
      },
      "items": [
        {
          "text": "61",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 61",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Salimo la Davide. Loyimbidwa ndi zipangizo za zingwe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 61:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imvani kulira kwanga, Inu Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.1",
            "verseOrgIds": [
              "PSA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:1"
      },
      "items": [
        {
          "text": "mvetserani pemphero langa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.1",
            "verseOrgIds": [
              "PSA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 61:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchokera ku malekezero a dziko lapansi ine ndimayitana Inu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:2"
      },
      "items": [
        {
          "text": "ndimayitana pomwe mtima wanga ukufowoka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:2"
      },
      "items": [
        {
          "text": "tsogolereni ku thanthwe lalitali kuposa ineyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 61:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Inu mwakhala pothawirapo panga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.3",
            "verseOrgIds": [
              "PSA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:3"
      },
      "items": [
        {
          "text": "nsanja yolimba polimbana ndi adani anga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.3",
            "verseOrgIds": [
              "PSA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 61:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndikulakalaka kukhala mʼtenti yanu kwamuyaya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.4",
            "verseOrgIds": [
              "PSA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:4"
      },
      "items": [
        {
          "text": "ndi kupeza chitetezo mu mthunzi wa mapiko anu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.4",
            "verseOrgIds": [
              "PSA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 61:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Inu Mulungu mwamva malumbiro anga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.5",
            "verseOrgIds": [
              "PSA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:5"
      },
      "items": [
        {
          "text": "mwandipatsa cholowa cha iwo amene amaopa dzina lanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.5",
            "verseOrgIds": [
              "PSA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 61:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonjezerani masiku a moyo wa mfumu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.6",
            "verseOrgIds": [
              "PSA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:6"
      },
      "items": [
        {
          "text": "zaka zake kwa mibado yochuluka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.6",
            "verseOrgIds": [
              "PSA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 61:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akhale pa mpando waufumu pamaso pa Mulungu kwamuyaya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.7",
            "verseOrgIds": [
              "PSA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:7"
      },
      "items": [
        {
          "text": "ikani chikondi chanu ndi kukhulupirika kwanu kuti zimuteteze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.7",
            "verseOrgIds": [
              "PSA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 61:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero ndidzayimba matamando kwamuyaya pa dzina lanu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.8",
            "verseOrgIds": [
              "PSA.61.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:8"
      },
      "items": [
        {
          "text": "ndi kukwaniritsa malumbiro anga tsiku ndi tsiku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.8",
            "verseOrgIds": [
              "PSA.61.9"
            ]
          }
        }
      ]
    }
  ],
