  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "MRK 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fanizo la Wofesa Mbewu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi inanso Yesu atakhala mʼmbali mwa nyanja, anayamba kuphunzitsa. Gulu lalikulu la anthu linasonkhana momuzungulira kotero kuti Iye analowa mʼbwato lomwe linali pa nyanja nakhalamo, anthu onse ali pa mtunda mʼmbali mwa madzi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.1",
            "verseOrgIds": [
              "MRK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anawaphunzitsa zinthu zambiri mʼmafanizo, ndipo mʼchiphunzitso chake anati:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.2",
            "verseOrgIds": [
              "MRK.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tamverani! Mlimi anapita kukafesa mbewu zake.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.3",
                "verseOrgIds": [
                  "MRK.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.3",
            "verseOrgIds": [
              "MRK.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akufesa, mbewu zina zinagwera mʼmbali mwa njira, ndipo mbalame zinabwera ndi kuzidya.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.4",
                "verseOrgIds": [
                  "MRK.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.4",
            "verseOrgIds": [
              "MRK.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zina zinagwa pa malo a miyala pamene panalibe dothi lambiri. Zinamera mofulumira chifukwa panalibe dothi lambiri.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.5",
                "verseOrgIds": [
                  "MRK.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.5",
            "verseOrgIds": [
              "MRK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma dzuwa litakwera, mbewuzo zinapserera, ndipo zinawuma chifukwa zinalibe mizu.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.6",
                "verseOrgIds": [
                  "MRK.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.6",
            "verseOrgIds": [
              "MRK.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mbewu zina zinagwa pa minga, ndipo mingayo inayanga ndi kuzirepheretsa kukula.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.7",
                "verseOrgIds": [
                  "MRK.4.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.7",
            "verseOrgIds": [
              "MRK.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mbewu zinanso zinagwa pa nthaka yabwino ndipo zinamera, zinakula ndi kubereka zipatso, zina zochuluka makumi atatu, zina makumi asanu ndi limodzi ndi zina 100.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.8",
                "verseOrgIds": [
                  "MRK.4.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yesu anati,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.9",
            "verseOrgIds": [
              "MRK.4.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amene ali ndi makutu akumva, amve.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.9",
                "verseOrgIds": [
                  "MRK.4.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali yekha, ophunzira ndi ena omuzungulira, anamufunsa za mafanizo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.10",
            "verseOrgIds": [
              "MRK.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anawawuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.11",
            "verseOrgIds": [
              "MRK.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chinsinsi cha ufumu wa Mulungu chapatsidwa kwa inu. Koma kwa amene ali kunja zinthu zonse zinenedwa mʼmafanizo:",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.11",
                "verseOrgIds": [
                  "MRK.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.11",
            "verseOrgIds": [
              "MRK.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kotero kuti,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 4:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Kupenya mudzapenya koma osaona kanthu,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 4:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kumva mudzamva koma osamvetsetsa,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 4:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kuti mwina angatembenuke ndi kukhululukidwa!' \"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yesu anawawuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.13",
            "verseOrgIds": [
              "MRK.4.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi simukulimvetsa fanizoli? Kodi nanga mudzazindikira bwanji fanizo lina lililonse?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.13",
                "verseOrgIds": [
                  "MRK.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.13",
            "verseOrgIds": [
              "MRK.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wofesa amafesa mawu.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.14",
                "verseOrgIds": [
                  "MRK.4.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.14",
            "verseOrgIds": [
              "MRK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Anthu ena ali ngati mbewu za mʼmbali mwa njira, mʼmene mawu amafesedwamo. Akangowamva, Satana amabwera ndi kuchotsa mawu amene anafesedwa mwa iwo.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.15",
                "verseOrgIds": [
                  "MRK.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.15",
            "verseOrgIds": [
              "MRK.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ena, monga mbewu zofesedwa pa miyala, amamva mawu ndipo nthawi yomweyo amawalandira ndi chimwemwe.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.16",
                "verseOrgIds": [
                  "MRK.4.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.16",
            "verseOrgIds": [
              "MRK.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma popeza alibe mizu, amakhala kwa kanthawi kochepa. Mavuto kapena masautso akafika chifukwa cha mawu, amagwa mofulumira.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.17",
                "verseOrgIds": [
                  "MRK.4.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.17",
            "verseOrgIds": [
              "MRK.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Komabe ena, monga mbewu zofesedwa pakati pa minga, amamva mawu;",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.18",
                "verseOrgIds": [
                  "MRK.4.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.18",
            "verseOrgIds": [
              "MRK.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "koma nkhawa zamoyo uno, chinyengo cha chuma ndi zokhumba za zinthu zina zimabwera ndi kutchinga mawu, ndipo amawachititsa kukhala osabala chipatso.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.19",
                "verseOrgIds": [
                  "MRK.4.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.19",
            "verseOrgIds": [
              "MRK.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ena, ngati mbewu zofesedwa pa nthaka yabwino, amamva mawu, nawalandira, ndi kubereka zipatso zokwanira makumi atatu, makumi asanu ndi limodzi, kapena ngakhale 100 kuwonjezera pa zomwe zinafesedwa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.20",
                "verseOrgIds": [
                  "MRK.4.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fanizo la Nyale",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anawawuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi umatenga nyale ndi kuyiika pansi pa mbiya kapena pansi pa bedi? Mʼmalo mwake, kodi simuyika pa choyikapo chake?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.21",
                "verseOrgIds": [
                  "MRK.4.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti chilichonse chobisika chidzayenera kuwululika, ndi chilichonse chachinsinsi chidzayenera kuonekera poyera.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.22",
                "verseOrgIds": [
                  "MRK.4.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.22",
            "verseOrgIds": [
              "MRK.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati wina ali ndi makutu akumva, amve.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.23",
                "verseOrgIds": [
                  "MRK.4.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anapitiriza nati,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
              "MRK.4.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ganizirani mosamala zimene mukumva, ndi muyeso umene mugwiritsa ntchito, mudzayesedwa nawo, ndipo ngakhale kwambiri.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.24",
                "verseOrgIds": [
                  "MRK.4.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
              "MRK.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amene ali nazo adzapatsidwa zochuluka; amene alibe, ngakhale zimene ali nazo zidzachotsedwa kwa iwo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.25",
                "verseOrgIds": [
                  "MRK.4.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fanizo la Mbewu Imene Ikukula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anatinso,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.26",
            "verseOrgIds": [
              "MRK.4.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Umu ndi mmene ulili ufumu wa Mulungu. Munthu amafesa mbewu mʼnthaka.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.26",
                "verseOrgIds": [
                  "MRK.4.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.26",
            "verseOrgIds": [
              "MRK.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Usiku ndi usana, kaya agona kapena adzuka, mbewu imamera ndi kukula, ngakhale sadziwa mmene zimachitikira.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.27",
                "verseOrgIds": [
                  "MRK.4.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.27",
            "verseOrgIds": [
              "MRK.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nthaka pa yokha imatulutsa mbewu, umayamba mʼmera, kenaka ngala, kenaka mbewu yokhwima mʼngalayo.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.28",
                "verseOrgIds": [
                  "MRK.4.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.28",
            "verseOrgIds": [
              "MRK.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mbewuyo ikangokhwima, amayimweta chifukwa nthawi yokolola yakwana.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.29",
                "verseOrgIds": [
                  "MRK.4.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fanizo la Mbewu ya Mpiru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anatinso,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.30",
            "verseOrgIds": [
              "MRK.4.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi tinene kuti ufumu wa Mulungu ufanana ndi chiyani, kapena ndi fanizo lotani limene tidzagwiritsa ntchito pakuwufotokozera?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.30",
                "verseOrgIds": [
                  "MRK.4.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.30",
            "verseOrgIds": [
              "MRK.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Uli ngati mbewu ya mpiru imene ndi mbewu yayingʼono kwambiri yomwe mumadzala mʼnthaka.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.31",
                "verseOrgIds": [
                  "MRK.4.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.31",
            "verseOrgIds": [
              "MRK.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma ikadzalidwa, imakula ndi kukhala yayikulu koposa mbewu zina zonse za mʼmunda ndipo mʼnthambi zake zazikulu mbalame zamlengalenga zimadzapuma pa mthunzi wake.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.32",
                "verseOrgIds": [
                  "MRK.4.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi mafanizo ambiri onga awa Yesu anayankhula mawu kwa iwo, monga mmene akanatha kumvetsa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.33",
            "verseOrgIds": [
              "MRK.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye sananene kanthu kwa iwo osagwiritsa ntchito fanizo. Koma ali yekha ndi ophunzira ake, ankawatanthauzira zonse.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.34",
            "verseOrgIds": [
              "MRK.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Aletsa Namondwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo atafika madzulo, anawuza ophunzira ake kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.35",
            "verseOrgIds": [
              "MRK.4.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tiyeni tiwolokere tsidya lina.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.35",
                "verseOrgIds": [
                  "MRK.4.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.35",
            "verseOrgIds": [
              "MRK.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atasiya gulu la anthu mʼmbuyo, anamutenga Iye, napita naye monga momwe anali mʼbwatolo. Panalinso mabwato ena pamodzi ndi Iye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.36",
            "verseOrgIds": [
              "MRK.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mphepo yamkuntho inabuka, ndipo mafunde anawomba bwatolo, kotero kuti linali pafupi kumira.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.37",
            "verseOrgIds": [
              "MRK.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi imeneyi Yesu anali akugona atatsamira pilo kumbuyo kwa bwato. Ophunzira anamudzutsa nati kwa Iye, \"Aphunzitsi, kodi simukusamala kuti timira?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.38",
            "verseOrgIds": [
              "MRK.4.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anauka nadzudzula mphepo nati kwa mafunde,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.39",
            "verseOrgIds": [
              "MRK.4.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chete! Khala bata!\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.39",
                "verseOrgIds": [
                  "MRK.4.39"
                ]
              }
            }
          ]
        },
        {
          "text": "Pamenepo mphepo inaleka ndipo kunachita bata.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.39",
            "verseOrgIds": [
              "MRK.4.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anati kwa ophunzira ake,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.40",
            "verseOrgIds": [
              "MRK.4.40"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Muli ndi mantha chifukwa chiyani? Kodi mukanalibe chikhulupiriro?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.40",
                "verseOrgIds": [
                  "MRK.4.40"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anachita mantha nafunsana wina ndi mnzake kuti, \"Uyu ndani? Ngakhale mphepo ndi nyanja zimumvera Iye!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.41",
            "verseOrgIds": [
              "MRK.4.41"
            ]
          }
        }
      ]
    }
  ],
