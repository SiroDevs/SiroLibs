  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "EST 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pempho la Estere kwa Mfumu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lachitatu Estere anavala zovala zake zaufumu ndipo anayima mʼbwalo la mʼkati la nyumba yaufumu choyangʼana ku chipinda chachikulu cha mfumu. Mfumu inakhala pa mpando waufumu mʼchipinda chachikulu moyangʼana ku chipata cholowera mʼnyumba yaufumu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.1",
            "verseOrgIds": [
              "EST.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu itaona Estere atayima mʼbwalomo inakondwera naye ndipo anamuloza ndi ndodo yagolide imene inali mʼdzanja lake. Choncho Estere anayandikira ndi kukhudza msonga ya ndodoyo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.2",
            "verseOrgIds": [
              "EST.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka mfumu inati kwa iye, \"Kodi mukufuna chiyani, inu mfumukazi Estere? Nanga pempho lanu ndi chiyani? Ngakhale mutapempha theka la ufumu, ndidzakupatsani.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.3",
            "verseOrgIds": [
              "EST.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Estere anayankha kuti, \"Ngati chingakukomereni, mfumu, mubwere lero pamodzi ndi Hamani kuphwando limene ndakonzera inu mfumu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.4",
            "verseOrgIds": [
              "EST.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inati, \"Muwuzeni abwere Hamani msanga, kotero kuti tichite monga Estere wapempha.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.5",
            "verseOrgIds": [
              "EST.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 5:5"
      },
      "items": [
        {
          "text": "Choncho mfumu ndi Hamani anafika kuphwando limene Estere anakonza.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.5",
            "verseOrgIds": [
              "EST.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akumwa vinyo, mfumu inamufunsano Estere kuti, \"Kodi ukupempha chiyani tsopano? Chimene uti upemphe ndikupatsa. Chopempha chako ndi chiti? Ngakhale utafuna mpaka theka la ufumu, ndidzakupatsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.6",
            "verseOrgIds": [
              "EST.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Estere anayankha kuti, \"Pempho langa ndi chofuna changa ndi ichi:",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.7",
            "verseOrgIds": [
              "EST.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati mwandikomera mtima mfumu ndiponso ngati chingakukondweretseni mfumu kundipatsa chimene ndapempha ndi kuchita zimene ndifuna, mubwere mawa inu mfumu ndi Hamani ku phwando limene ndidzakukonzerani. Ndipo ndidzakuyankhani mfumu funso lanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.8",
            "verseOrgIds": [
              "EST.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mkwiyo wa Hamani Ukulabe pa Mordekai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo Hamani anatuluka wokondwa ndi wosangalala kwambiri. Koma ataona Mordekai pa chipata cha mfumu ndi kuti sanayimirire kapena kumupatsa ulemu pamene iye amadutsa, Hamani anamukwiyira kwambiri,",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.9",
            "verseOrgIds": [
              "EST.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "komabe Hamani anadziletsa ndipo anapita ku nyumba kwake.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.10",
            "verseOrgIds": [
              "EST.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 5:10"
      },
      "items": [
        {
          "text": "Anayitana abwenzi ake pamodzi ndi mkazi wake Zeresi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.10",
            "verseOrgIds": [
              "EST.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani anawawuza za kuchuluka kwa chuma chake ndi kuti anali ndi ana aamuna ambiri. Anawawuzanso za mmene mfumu inamukwezera ndi kumuyika kukhala woposa nduna ndi olemekezeka onse.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.11",
            "verseOrgIds": [
              "EST.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani anawonjeza kuti, \"Ndipotu si zokhazi. Ndine ndekha amene ndayitanidwa pamodzi ndi mfumu kuphwando limene mfumukazi Estere anatikonzera. Ndipo mawa wandiyitananso pamodzi ndi mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.12",
            "verseOrgIds": [
              "EST.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma zonsezi sindikhutira nazo ndikamaona nthawi zonse Myuda uja Mordekai atakhala pa chipata cha mfumu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.13",
            "verseOrgIds": [
              "EST.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkazi wake Zeresi ndi abwenzi ake onse aja anamuwuza kuti, \"Anthu apange mtanda wotalika mamita 23 ndipo mmawa upemphe mfumu kuti anthu akhomerepo Mordekai. Kenaka upite ndi mfumu kuphwando mokondwa.\" Hamani anakondwera ndi uphungu umenewu ndipo mtanda unapangidwa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.14",
            "verseOrgIds": [
              "EST.5.14"
            ]
          }
        }
      ]
    }
  ],
