  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1PE 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndine Petro, mtumwi wa Yesu Khristu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1PE 1:1"
      },
      "items": [
        {
          "text": "Ndikulemba kalatayi kwa onse osankhidwa ndi Mulungu, alendo mʼdziko lapansi, obalalikira ku Ponto, Galatiya, Kapadokiya, Asiya ndi Bituniya.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu Atate anakusankhani, atakudziwani kuyambira pachiyambi, ndipo Mzimu Woyera wakuyeretsani kuti mumvere Yesu Khristu ndikutsukidwa ndi magazi ake.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1PE 1:2"
      },
      "items": [
        {
          "text": "Chisomo ndi mtendere zikhale ndi inu mochuluka.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuyamika Mulungu Chifukwa cha Chiyembekezo Chamoyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alemekezedwe Mulungu, Atate wa Ambuye athu Yesu Khristu. Mwachifundo chake chachikulu anatibadwitsa kwatsopano, mʼchiyembekezo chamoyo pomuukitsa Yesu Khristu kwa akufa,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.3",
            "verseOrgIds": [
              "1PE.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti tidzalandire chuma chomwe sichingawonongeke, kuyipitsidwa kapena kufota. Chuma chimenechi akukusungirani kumwamba.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.4",
            "verseOrgIds": [
              "1PE.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwachikhulupiriro, mukusungidwa ndi mphamvu ya Mulungu mpaka chipulumutso chitafika chimene chinakonzedwa kuti adzachionetse nthawi yotsiriza.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.5",
            "verseOrgIds": [
              "1PE.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimenezi zikukondweretseni kwambiri, ngakhale tsopano, kwa kanthawi kochepa, mukumva zowawa mʼmayesero osiyanasiyana.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.6",
            "verseOrgIds": [
              "1PE.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayeserowa abwera nʼcholinga chakuti chikhulupiriro chanu, chimene ndi chamtengo woposa wa golide, amene amawonongeka ngakhale amayengedwa ndi moto, chitsimikizike kuti ndi chenicheni. Pamenepo ndiye mudzalandire mayamiko, ulemerero ndi ulemu pamene Yesu Khristu adzaoneka.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale kuti simunamuone, mumamukonda; ndipo ngakhale kuti simukumuona tsopano, mumamukhulupirira ndipo mumakondwera ndi chimwemwe chachikulu ndi chosaneneka.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.8",
            "verseOrgIds": [
              "1PE.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motero mukulandira mphotho ya chikhulupiriro chanu, ndiyo chipulumutso cha moyo wanu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
              "1PE.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunena za chipulumutso chimenechi, aneneri amene ananeneratu za chisomo chimene chimabwera kwa inu, anafunafuna mofufuzafufuza za chipulumutsochi,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.10",
            "verseOrgIds": [
              "1PE.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kufuna kudziwa nthawi ndi momwe zidzachitikire zinthu zimene Mzimu wa Khristu amene ali mwa iwo ankanenera za kuvutika kwa Khristu, ndi ulemerero umene adzakhale nawo pambuyo pake.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.11",
            "verseOrgIds": [
              "1PE.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anawawululira kuti ntchito yawoyo sankayigwira chifukwa cha iwo eni, koma chifukwa inu, pamene iwo ankayankhula zinthu zimene mwamva tsopano kuchokera kwa amene amalalikira Uthenga Wabwino mwamphamvu ya Mzimu Woyera wotumidwa kuchokera kumwamba. Ngakhale angelo amalakalaka kuona nawo zinthuzi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
              "1PE.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Khalani Oyera Mtima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho konzani mtima wanu, khalani odziretsa; khazikitsani chiyembekezo chanu kotheratu pa chisomo chimene mudzapatsidwe pamene Yesu Khristu adzaonekera.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.13",
            "verseOrgIds": [
              "1PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga ana omvera, musatsatenso zilakolako zoyipa zomwe munali nazo pamene munali osadziwa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.14",
            "verseOrgIds": [
              "1PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma monga amene anakuyitanani ndi woyera, inunso khalani oyera mtima mʼmakhalidwe anu wonse.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.15",
            "verseOrgIds": [
              "1PE.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti, kwalembedwa kuti, \"Khalani oyera mtima, chifukwa Ine ndine Woyera.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.16",
            "verseOrgIds": [
              "1PE.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza mumapemphera kwa Atate amene amaweruza munthu aliyense mopanda tsankho molingana ndi zochita zake, pa nthawi imene muli alendo pa dziko lapansi khalani moopa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.17",
            "verseOrgIds": [
              "1PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti mukudziwa kuti simunawomboledwe ndi zinthu zimene zimawonongeka monga siliva kapena golide, kuchoka ku khalidwe lanu lachabe limene munalandira kwa makolo anu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.18",
            "verseOrgIds": [
              "1PE.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma munawomboledwa ndi magazi a mtengowapatali a Khristu, Mwana Wankhosa wopanda banga kapena chilema.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.19",
            "verseOrgIds": [
              "1PE.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anasankhidwa lisanalengedwe dziko lapansi, koma waonetsedwa chifukwa cha inu pa nthawi ino yotsiriza.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.20",
            "verseOrgIds": [
              "1PE.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudzera mwa Iye mumakhulupirira Mulungu, amene anamuukitsa kwa akufa namupatsa ulemerero. Nʼchifukwa chake chikhulupiriro ndi chiyembekezo chanu chili mwa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.21",
            "verseOrgIds": [
              "1PE.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano mwayeretsa mitima yanu pomvera choonadi, kuti muzikondana ndi abale anu, kukondana kwenikweni kochokera pansi pa mtima.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.22",
            "verseOrgIds": [
              "1PE.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1PE 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza mwabadwanso, osati ndi mbewu imene imawonongeka, koma imene siwonongeka, ndiye kuti ndi Mawu a Mulungu amoyo ndi okhalitsa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.23",
            "verseOrgIds": [
              "1PE.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1PE 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 1:24"
      },
      "items": [
        {
          "text": "\"Anthu onse ali ngati udzu,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 1:24"
      },
      "items": [
        {
          "text": "ndipo ulemerero wawo uli ngati duwa la kuthengo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 1:24"
      },
      "items": [
        {
          "text": "Udzu umafota ndipo duwa limathothoka,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1PE 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma mawu a Ambuye adzakhala mpaka muyaya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.25",
            "verseOrgIds": [
              "1PE.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1PE 1:25"
      },
      "items": [
        {
          "text": "Ndipo awa ndi mawu amene tinalalikira kwa inu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.25",
            "verseOrgIds": [
              "1PE.1.25"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1PE.2",
