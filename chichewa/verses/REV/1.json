{
  "id": "REV.1",
  "number": "1",
  "bookId": "REV",
  "reference": "Chivumbulutso 1",
  "copyright": "The Word of God in Contemporary Chichewa Copyright © 2002, 2016 by Biblica, Inc.® Used by permission of Biblica, Inc.® All rights reserved worldwide. Mawu a Mulungu mu Chichewa Chalero Mwini © 2002, 2016 ndi Biblica, Inc.® Kugwiritsa ntchito mwachilolezo. Umwini ndi otetezedwa pa dziko lonse.",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "REV 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawu Oyamba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vumbulutso lochokera kwa Yesu Khristu, limene Mulungu anamupatsa kuti aonetse atumiki ake zimene zinayenera kuchitika posachedwa. Iye anatuma mngelo wake kuti adziwitse mtumiki wake Yohane,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.1",
            "verseOrgIds": [
              "REV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "amene akuchitira umboni chilichonse chimene anachiona. Awa ndi Mawu a Mulungu ndi umboni wa Yesu Khristu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.2",
            "verseOrgIds": [
              "REV.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngodala munthu amene awerenga mawu oneneratu zamʼtsogolo ndi iwo amene amamva ndi kusunga zolembedwa mʼbukuli pakuti nthawi yayandikira.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.3",
            "verseOrgIds": [
              "REV.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Malonje kwa Mipingo Isanu ndi Iwiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndine Yohane,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 1:4"
      },
      "items": [
        {
          "text": "Kupita ku mipingo isanu ndi iwiri ya mʼchigawo cha Asiya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 1:4"
      },
      "items": [
        {
          "text": "Chisomo ndi mtendere kwa inu, kuchokera kwa Iye amene ali, amene analipo ndi amene akubwera ndi kwa mizimu isanu ndi iwiri yokhala patsogolo pa mpando wake waufumu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndiponso kuchokera kwa Yesu Khristu mboni yokhulupirika, woyamba kuukitsidwa, ndi wolamulira mafumu a dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "REV 1:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 1:5"
      },
      "items": [
        {
          "text": "Kwa Iye amene amatikonda ndipo watimasula ku machimo athu ndi magazi ake,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo watisandutsa mafumu ndi ansembe kuti tizitumikira Mulungu ndi Atate ake. Kwa Iye kukhale ulemerero ndi mphamvu ku nthawi zosatha, Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onani akubwera ndi mitambo,\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "ndipo \"Aliyense adzamuona,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "ndi amene anamubaya omwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "Ndipo anthu a mitundu yonse ya pa dziko lapansi \"adzalira chingʼangʼadza chifukwa cha Iye.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qc",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "Zidzakhaladi momwemo, Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ine ndine Alefa ndi Omega,\" akutero Ambuye Mulungu Wamphamvuzonseyo \"amene muli, amene munalipo, ndi amene mudzakhalapo.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wina Wokhala ngati Mwana wa Munthu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine Yohane mʼbale wanu ndi mnzanu mʼmasautso ndi mu ufumu ndi mukupirira kwambiri, zomwe ndi zathu mwa Yesu, ndinali pa chilumba cha Patimo chifukwa cha Mawu a Mulungu ndi umboni wa Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.9",
            "verseOrgIds": [
              "REV.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku la Ambuye ndinanyamulidwa ndi Mzimu ndipo ndinamva kumbuyo kwanga mawu ofuwula ngati lipenga,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.10",
            "verseOrgIds": [
              "REV.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "amene anati,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.11",
            "verseOrgIds": [
              "REV.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lemba mʼbuku zimene ukuziona ndipo uzitumize ku mipingo isanu ndi iwiri ya ku Efeso, Simurna, Pergamo, Tiyatira, Sarde, Filadefiya ndi ku Laodikaya.\"",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.11",
                "verseOrgIds": [
                  "REV.1.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nditatembenuka kuti ndione amene amandiyankhulayo, ndinaona zoyikapo nyale zisanu ndi ziwiri zagolide.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.12",
            "verseOrgIds": [
              "REV.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakati pa zoyikapo nyalezo ndinaona wina wooneka ngati Mwana wa Munthu atavala mkanjo wofika kumapazi ake ndipo anamangirira lamba wagolide pa chifuwa pake.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsitsi lake linali loyera ngati thonje, kuyera ngati matalala, ndipo maso ake amawala ngati malawi amoto.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.14",
            "verseOrgIds": [
              "REV.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapazi ake anali ngati chitsulo choti chili mʼngʼanjo yamoto, ndipo mawu ake anali ngati mkokomo wamadzi othamanga.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.15",
            "verseOrgIds": [
              "REV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼdzanja lake lamanja ananyamula nyenyezi zisanu ndi ziwiri, ndipo mʼkamwa mwake munali lupanga lakuthwa konsekonse. Nkhope yake imawala ngati dzuwa lowala kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.16",
            "verseOrgIds": [
              "REV.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nditamuona ndinagwa pa mapazi ake ngati wakufa. Kenaka Iye anasanjika dzanja lake lamanja pa ine nati,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.17",
            "verseOrgIds": [
              "REV.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Usachite mantha. Ndine Woyamba ndi Wotsiriza.",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.17",
                "verseOrgIds": [
                  "REV.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.17",
            "verseOrgIds": [
              "REV.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndine Wamoyo; ndinali wakufa ndipo taona ndine wamoyo mpaka muyaya! Ndipo ndili ndi makiyi a imfa ndi Hade.",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.18",
                "verseOrgIds": [
                  "REV.1.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chomwecho, lemba zimene waona, zimene zilipo panopa ndi zimene zidzachitike mʼtsogolo.",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.19",
                "verseOrgIds": [
                  "REV.1.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.19",
            "verseOrgIds": [
              "REV.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tanthauzo la nyenyezi zisanu ndi ziwiri zimene waziona mʼdzanja langa lamanja ndi la zoyikapo nyale zagolide zisanu ndi ziwiri ndi ili: Nyenyezi zisanu ndi ziwiri ndi angelo a mipingo isanu ndi iwiri ija, ndipo zoyikapo nyale zisanu ndi ziwiri zija ndi mipingo isanu ndi iwiri ija.\"",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.20",
                "verseOrgIds": [
                  "REV.1.20"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "next": {
    "id": "REV.2",
    "number": "2",
    "bookId": "REV"
  },
