  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "1JN 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chikhulupiriro mwa Mwana wa Mulungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1JN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliyense amene amakhulupirira kuti Yesu ndi Khristu, iyeyo ndi mwana wa Mulungu, ndipo aliyense amene amakonda Atate amakondanso Mwana wake.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.1",
            "verseOrgIds": [
              "1JN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chodziwira kuti timakonda ana a Mulungu nʼchakuti timakonda Mulungu ndi kusunga malamulo ake.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.2",
            "verseOrgIds": [
              "1JN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti kukonda Mulungu ndiye kusunga malamulo ake. Ndipo malamulo ake siwolemetsa,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.3",
            "verseOrgIds": [
              "1JN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "chifukwa aliyense amene ndi mwana wa Mulungu amagonjetsa dziko lapansi. Chikhulupiriro chathu ndicho timagonjetsera dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.4",
            "verseOrgIds": [
              "1JN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani amagonjetsa dziko lapansi? Yekhayo amene amakhulupirira kuti Yesu ndi Mwana wa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.5",
            "verseOrgIds": [
              "1JN.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu ndiye anabwera mwa madzi ndi magazi, ndiye Yesu Khristu. Sanabwere mwa madzi okha, koma mwa madzi ndi magazi. Ndipo ndi Mzimu Woyera amene akuchitira umboni, chifukwa Mzimu Woyera ndi choonadi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.6",
            "verseOrgIds": [
              "1JN.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti pali atatu amene amachitira umboni.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.7",
            "verseOrgIds": [
              "1JN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mzimu Woyera, madzi ndi magazi; ndipo atatu amavomerezana.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.8",
            "verseOrgIds": [
              "1JN.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timalandira umboni wa anthu, koma umboni wa Mulungu ndi wopambana. Umboniwo ndi umene anachitira Mwana wake.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.9",
            "verseOrgIds": [
              "1JN.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliyense amene amakhulupirira Mwana wa Mulungu ali nawo umboniwu mu mtima mwake, koma aliyense amene sanakhulupirire Mulungu amayesa kuti Mulunguyo ndi wonama, chifukwa sanakhulupirire umboni umene Mulungu anachitira wa Mwana wake.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.10",
            "verseOrgIds": [
              "1JN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1JN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo umboniwo ndi uwu: Mulungu anatipatsa moyo wosatha, ndipo moyowu uli mwa Mwana wake.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.11",
            "verseOrgIds": [
              "1JN.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amene ali ndi Mwana ali ndi moyo, amene alibe Mwana wa Mulungu alibe moyo.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.12",
            "verseOrgIds": [
              "1JN.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawu Otsiriza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1JN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndikulemba zimenezi kwa inu, amene mwakhulupirira dzina la Mwana wa Mulungu kuti mudziwe kuti muli ndi moyo wosatha.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.13",
            "verseOrgIds": [
              "1JN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife timalimba mtima tikamafika pamaso pa Mulungu, popeza kuti ngati tipempha kanthu kalikonse monga mwa chifuniro chake, amatimvera.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.14",
            "verseOrgIds": [
              "1JN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ngati tikudziwa kuti amatimvera, chilichonse chimene timapempha, tikudziwanso kuti tili nacho chimene tamupempha Iye.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.15",
            "verseOrgIds": [
              "1JN.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati wina aona mʼbale wake akuchita tchimo losadzetsa imfa, apemphere ndipo Mulungu adzamupatsa moyo mʼbale wakeyo. Ndikunena za ochita tchimo losadzetsa imfa. Pali tchimo lodzetsa imfa. Ine sindikunena kuti apemphere ayi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.16",
            "verseOrgIds": [
              "1JN.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chilichonse chosalungama ndi tchimo ndipo pali tchimo losadzetsa imfa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.17",
            "verseOrgIds": [
              "1JN.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tikudziwa kuti aliyense amene ndi mwana wa Mulungu sachimwirachimwirabe. Yesu, Mwana wa Mulungu, amamusunga ndipo woyipa uja sangamukhudze.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.18",
            "verseOrgIds": [
              "1JN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tikudziwa kuti ndife ana a Mulungu ndi kuti dziko lonse lapansi lili pansi pa ulamuliro wa woyipayo.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.19",
            "verseOrgIds": [
              "1JN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tikudziwa kuti Mwana wa Mulungu anafika ndipo anatipatsa nzeru, kuti timudziwe Iye amene ali woona. Ndipo ife tili mwa Iye amene ndi woona, Mwana wake, Yesu Khristu. Iye ndi Mulungu woona ndi moyo wosatha.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.20",
            "verseOrgIds": [
              "1JN.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1JN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana okondedwa, dzisungeni bwino, osapembedza mafano.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.21",
            "verseOrgIds": [
              "1JN.5.21"
            ]
          }
        }
      ]
    }
  ],
