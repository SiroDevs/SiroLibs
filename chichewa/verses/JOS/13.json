              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Derali linayambira ku Mahanaimu kuphatikizapo dziko lonse la mfumu Ogi, Mfumu ya ku Basani, pamodzi ndi mizinda 60 ya ku Yairi, ku Basaniko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
