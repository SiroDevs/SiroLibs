            "number": "31",
            "style": "v",
            "sid": "JOS 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Derali linaphatikizanso theka la Giliyadi pamodzi ndi Asiteroti ndi Ederi, mizinda yayikulu ya mfumu Ogi wa Basani. Mizinda imeneyi inapatsidwa kwa mabanja a Makiri, mwana wa Manase kuti ikhale cholowa cha theka la ana a Makiri, malinga ndi mabanja awo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        }
      ]
