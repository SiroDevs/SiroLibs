              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umu ndi mmene Mose anagawira malo a mʼchigwa cha Yorodani, kummawa kwa Yeriko, ku tsidya kwa Yorodani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
            "verseOrgIds": [
              "JOS.13.32"
            ]
