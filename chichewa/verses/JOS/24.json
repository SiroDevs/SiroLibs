  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "JOS 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukonzanso Pangano ku Sekemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Yoswa anasonkhanitsa mafuko onse a Israeli ku Sekemu. Iye anayitanitsa akuluakulu, atsogoleri, oweruza, ndi akuluakulu a boma la Israeli, ndipo iwo anafika pamaso pa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.1",
            "verseOrgIds": [
              "JOS.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa anati kwa anthu onse, \"Yehova Mulungu wa Israeli akuti, 'Kalekale makolo anu, kuphatikiza Tera, abambo a Abrahamu ndi Nahori ankakhala kutsidya kwa Mtsinje ndipo ankapembedza milungu ina.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.2",
            "verseOrgIds": [
              "JOS.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ine ndinatenga kholo lanu Abrahamu kumuchotsa ku dziko la kutsidya kwa mtsinje wa Yufurate ndipo ndinamutsogolera kupita ku dziko la Kanaani. Ndinamupatsa zidzukulu zambiri. Ndinamupatsa Isake,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.3",
            "verseOrgIds": [
              "JOS.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo Isake ndinamupatsa Yakobo ndi Esau. Ndinapereka dziko la mapiri la Seiri kwa Esau, koma Yakobo ndi ana ake anapita ku Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.4",
            "verseOrgIds": [
              "JOS.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kenaka ndinatuma Mose ndi Aaroni, ndipo ine ndinazunza Aigupto. Pambuyo pake ndinakutulutsani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.5",
            "verseOrgIds": [
              "JOS.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nditatulutsa makolo anu ku Igupto ndinafika nawo ku Nyanja Yofiira. Aigupto anawathamangira ndi magaleta ndi okwera pa akavalo mpaka ku Nyanja Yofiira.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.6",
            "verseOrgIds": [
              "JOS.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono makolo anuwo anapemphera kwa Ine kuti ndiwathandize, ndipo ndinayika mtambo wakuda pakati pawo ndi Aiguptowo, ndipo Nyanja inamiza Aigupto aja. Inu munaona ndi maso anu zimene ndinachita kwa Aiguptowo ndipo inu munakhala mʼchipululu nthawi yayitali.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.7",
            "verseOrgIds": [
              "JOS.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pambuyo pake Ine ndinabwera nanu ku dziko la Aamori amene amakhala kummawa kwa Yorodani. Iwo anamenyana nanu koma ndinawapereka mʼdzanja lanu. Ndinawawononga pamaso panu, ndipo inu munalanda dziko lawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.8",
            "verseOrgIds": [
              "JOS.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki mwana wa Zipori, mfumu ya Mowabu, analimbana ndi Israeli. Iye anayitanitsa Balaamu mwana wa Beori kuti akutemberereni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.9",
            "verseOrgIds": [
              "JOS.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ine sindinamvere Balaamu, kotero iye anakudalitsani mowirikiza ndipo ndinakulanditsani mʼdzanja lake.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.10",
            "verseOrgIds": [
              "JOS.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ndipo inu munawoloka Yorodani ndi kufika ku Yeriko. Anthu a ku Yeriko analimbana nanu pamodzi ndi Aamori, Aperezi, Akanaani, Ahiti, Agirigasi, Ahivi ndi Ayebusi. Koma Ine ndinawapereka mʼdzanja lanu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.11",
            "verseOrgIds": [
              "JOS.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndinatumiza mavu amene anapirikitsa mafumu awiri Aamori aja pamaso panu. Inu simunachite izi ndi lupanga ndi uta wanu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.12",
            "verseOrgIds": [
              "JOS.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motero ndinakupatsani dziko limene simunalivutikire ndiponso mizinda imene simunamange. Inu mukukhala mʼmenemo ndi kumadya zipatso za mʼmunda wamphesa ndi kuthyola zipatso mʼmitengo ya olivi zimene simunadzale.'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.13",
            "verseOrgIds": [
              "JOS.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndipo tsopano wopani Yehova ndi kumutumikira Iye mokhulupirika ndi moona. Chotsani milungu imene makolo anu ankapembedza kutsidya kwa mtsinje wa Yufurate ndi ku Igupto ndipo tumikirani Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.14",
            "verseOrgIds": [
              "JOS.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ngati kutumikira Yehova kukuyipirani, sankhani lero amene mudzamutumikire, kapena milungu imene makolo anu ankayitumikira kutsidya kwa mtsinje wa Yufurate, kapena milungu ya Aamori, amene mukukhala mʼdziko lawo. Koma ine ndi banja langa, tidzatumikira Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.15",
            "verseOrgIds": [
              "JOS.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anthu anayankha, \"Sizingatheke kuti timusiye Yehova ndi kutumikira milungu ina!",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.16",
            "verseOrgIds": [
              "JOS.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Mulungu wathu ndiye amene anatitulutsa ife ndi makolo athu mu ukapolo, mʼdziko la Igupto. Tinaona ndi maso athu zizindikiro zozizwitsa zimene anachita. Iye anatiteteza pa ulendo wathu wonse ndi pakati pa mitundu yonse imene tinkakumana nayo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.17",
            "verseOrgIds": [
              "JOS.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife tikufika Iye anapirikitsa anthu onse pamodzi ndi Aamori amene ankakhala mʼdzikoli. Ifenso tidzatumikira Yehova chifukwa Iye ndiye Mulungu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.18",
            "verseOrgIds": [
              "JOS.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yoswa anati kwa anthuwo, \"Inutu simungathe kutumikira Yehova. Iye ndi Mulungu woyera, salola kupikisana naye. Sadzakukhululukirani ngati mumuwukira ndi kumuchimwira.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.19",
            "verseOrgIds": [
              "JOS.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati inu musiya Yehova ndi kutumikira milungu yachilendo, adzakufulatirani. Iye adzakulangani ndi kukuwonongani ngakhale kuti poyamba anakuchitirani zabwino.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.20",
            "verseOrgIds": [
              "JOS.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma anthuwo anati kwa Yoswa, \"Ayi! Ife tidzatumikira Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.21",
            "verseOrgIds": [
              "JOS.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yoswa anati, \"Inu mukudzichitira nokha umboni kuti mwasankha kutumikira Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.22",
            "verseOrgIds": [
              "JOS.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 24:22"
      },
      "items": [
        {
          "text": "Iwo anayankha kuti, \"Inde ife ndife mboni.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.22",
            "verseOrgIds": [
              "JOS.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa anati, \"Tsono chotsani milungu yachilendo imene ili pakati panu ndipo perekani mitima yanu kwa Yehova Mulungu wa Israeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.23",
            "verseOrgIds": [
              "JOS.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anthuwo anati kwa Yoswa, \"Ife tidzatumikira Yehova Mulungu wathu ndi kumvera Iye.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.24",
            "verseOrgIds": [
              "JOS.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho pa tsiku limenelo Yoswa anachita pangano mʼmalo mwa anthuwo, ndipo pa Sekemu pomwepo iye anapereka malamulo ndi malangizo kwa anthu aja.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.25",
            "verseOrgIds": [
              "JOS.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yoswa analemba zinthu izi mʼbuku la malamulo a Mulungu. Kenaka iye anatenga mwala waukulu nawuyimika pansi pa mtengo wa thundu pa malo wopatulika a Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.26",
            "verseOrgIds": [
              "JOS.24.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa anati kwa anthu onse, \"Tamvani! Mwala uwu udzakhala mboni yotitsutsa. Mwalawu wamva mawu onse amene Yehova wayankhula kwa ife. Udzakhala mboni yotitsutsa ngati mukhala osakhulupirika kwa Mulungu wanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.27",
            "verseOrgIds": [
              "JOS.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumwalira kwa Yoswa ndi Eliezara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yoswa analola anthu kuti apite, aliyense ku dera lake.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.28",
            "verseOrgIds": [
              "JOS.24.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zitatha zinthu izi, Yoswa mwana wa Nuni, mtumiki wa Yehova, anamwalira ali ndi zaka 110,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo anamuyika mʼmanda mʼdziko lake, ku Timnati-Sera dziko lamapiri la ku Efereimu, kumpoto kwa phiri la Gaasi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli anatumikira Yehova pa nthawi yonse imene Yoswa anali ndi moyo ndiponso pa nthawi ya akuluakulu amene anali moyo Yoswa atamwalira, anthu amene ankadziwa zonse zimene Yehova anachitira Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mafupa a Yosefe amene Aisraeli anawatulutsa ku Igupto anawayika mʼmanda a ku Sekemu pa malo amene Yakobo anagula ndi ndalama zasiliva 100 kwa ana a Hamori, abambo a Sekemu. Malo awa anakhala cholowa cha adzukulu a Yosefe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.32",
            "verseOrgIds": [
              "JOS.24.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Eliezara mwana wa Aaroni anamwalira ndipo anayikidwa mʼmanda ku Gibeya, malo amene anapatsidwa kwa Finehasi mwana wake, mʼdziko lamapiri la Efereimu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.33",
            "verseOrgIds": [
              "JOS.24.33"
            ]
          }
        }
      ]
    }
