  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JOS 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawo lina la dzikolo linapatsidwa kwa mabanja ena a fuko la Manase, mwana woyamba kubadwa wa Yosefe. Makiri anali mwana woyamba kubadwa wa Manase ndiponso kholo la anthu okhala ku Giliyadi. Popeza kuti iye anali munthu wankhondo, analandira Giliyadi ndi Basani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.1",
            "verseOrgIds": [
              "JOS.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabanja ena otsala a fuko la Manase amene analandira dziko ndi awa: Abiezeri, Heleki, Asirieli, Sekemu, Heferi ndi Semida. Izi ndi zidzukulu zina zazimuna za Manase mwana wa Yosefe ndiponso eni mbumba.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.2",
            "verseOrgIds": [
              "JOS.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panali Zelofehadi mwana wa Heferi, mwana wa Giliyadi, mwana wa Makiri mwana wa Manase. Iyeyu analibe ana aamuna koma aakazi okhaokha ndipo mayina awo ndi awa: Mahila, Nowa, Hogila, Milika ndi Tiriza.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.3",
            "verseOrgIds": [
              "JOS.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anapita kwa Eliezara wansembe, Yoswa mwana wa Nuni, ndi atsogoleri ndipo anati: \"Yehova analamula Mose kuti ife ndi alongo athu atipatse cholowa chathu.\" Choncho iwowo pamodzi ndi abale a abambo awo anawapatsa dera lina la dzikolo kuti likhale monga mwa lamulo la Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.4",
            "verseOrgIds": [
              "JOS.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho kuwonjezera pa mayiko a Giliyadi ndi Basani kummawa kwa Yorodani, anthu a fuko la Manase analandiranso magawo khumi",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.5",
            "verseOrgIds": [
              "JOS.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "chifukwa ana aakazi a fuko la Manase analandira cholowa chawo pakati pa ana aamuna. Dziko la Giliyadi linali dziko la zidzukulu zonse za Manase.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.6",
            "verseOrgIds": [
              "JOS.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malire a dziko la Manase anayambira ku Aseri, ndipo anakafika ku Mikimetati kummawa kwa Sekemu. Tsono malire anapita kummwera kuloza kwa anthu a ku Eni-Tapuwa.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Manase anatenga dziko la Tapuwa, koma mzinda wa Tapuwawo, umene unali mʼmalire mwa Manase unali wa fuko la Efereimu).",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo malire ake anapitirira kummwera mpaka ku mtsinje wa ku Kana. Mizinda ya kummwera kwa mtsinjewo inali ya fuko la Efereimu ngakhale kuti inali mʼdziko la Manase. Malire a fuko la Manase anapita kumpoto kwa mtsinje wa Kana ndi kukathera ku Nyanja.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko la kummwera linali la Efereimu ndipo la kumpoto linali la Manase. Dziko la Manase linafika ku nyanja ndipo linachita malire ndi Aseri, kumpoto ndiponso Isakara, kummawa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼdziko la Isakara ndi Aseri, Manase analinso ndi mizinda ya Beti-Seani ndi Ibuleamu pamodzi ndi midzi yawo yozungulira. Panalinso Akanaani amene ankakhala ku Dori, Endori, Taanaki ndi Megido pamodzi ndi mizinda yozungulira (wachitatu pa mʼndandandawu ndi Nafati Dori).",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe anthu a fuko la Manase sanathe kuwapirikitsa anthu okhala mʼmizinda imeneyi. Choncho Akanaani anakhalabe mʼmizindayi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale Aisraeli anali a mphamvu mʼdzikomo, sanapirikitse Akanaani onse koma anangowasandutsa kukhala akapolo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a fuko la Yosefe anati kwa Yoswa, \"Chifukwa chiyani mwatipatsa gawo limodzi lokha la dziko kuti likhale cholowa chathu? Ife tilipo anthu ambiri popeza Yehova watidalitsa kwambiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa anayankha kuti, \"Ngati muli ambiri ndipo dziko la ku mapiri la Efereimu lakucheperani kwambiri, lowani ku nkhalango mudule mitengo, mudzikonzere malo akuti mukhalemo, mʼdziko la Aperezi ndi Arefai.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.15",
            "verseOrgIds": [
              "JOS.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono zidzukulu za Yosefe zinati, \"Dziko la ku mapiri ndi losatikwaniradi, komanso Akanaani onse amene akukhala ku chigwa pamodzi ndi amene akukhala ku Beti-Seani ndi madera awo ndiponso amene ali ku chigwa cha Yezireeli ali ndi magaleta azitsulo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.16",
            "verseOrgIds": [
              "JOS.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yoswa anawuza zidzukulu za Yosefe, za fuko la Efereimu ndi za fuko la Manase kuti, \"Inu mulipodi ambiri ndiponso amphamvu. Simulandira gawo limodzi lokha,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.17",
            "verseOrgIds": [
              "JOS.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "dziko la ku mapiri lidzakhalanso lanu. Ngakhale kuti ndi nkhalango yokhayokha koma inu mudzadula mitengo yake ndipo lidzakhala lanu mpaka kumapeto. Ngakhale kuti Akanaani ali ndi magaleta azitsulo ndiponso kuti iwo ndi amphamvu, koma inu mudzawapirikitsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.18",
            "verseOrgIds": [
              "JOS.17.18"
            ]
          }
        }
      ]
    }
  ],
