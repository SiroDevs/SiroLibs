  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JOS 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuyimitsidwa kwa Dzuwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoni-Zedeki mfumu ya ku Yerusalemu inamva kuti Yoswa wagonjetsa ndi kuwononga kotheratu mzinda wa Ai pamodzi ndi mfumu yake, monga anachitira ndi Yeriko ndi mfumu yake. Inamvanso kuti anthu a ku Gibiyoni anachita pangano la mtendere ndi Israeli ndipo amakhala pakati pawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.1",
            "verseOrgIds": [
              "JOS.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho iye ndi anthu ake anachita mantha aakulu, chifukwa Gibiyoni unali mzinda waukulu kwambiri, monga mzinda uliwonse wokhala ndi mfumu. Unali waukulu ndipo ankhondo ake anali olimba mtima.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.2",
            "verseOrgIds": [
              "JOS.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chotsatira chake Adoni-Zedeki mfumu ya Yerusalemu inatuma uthenga kwa Hohamu mfumu ya Hebroni, Piramu mfumu ya Yarimuti, Yafiya mfumu ya Lakisi ndi Debri mfumu ya Egiloni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.3",
            "verseOrgIds": [
              "JOS.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anatumiza mawu kuti, \"Bwerani mudzandithandize kumenyana ndi Gibiyoni, chifukwa anthu ake achita pangano la mtendere ndi Yoswa ndi Aisraeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.4",
            "verseOrgIds": [
              "JOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafumu asanu a Aamori aja, mfumu ya Yerusalemu, mfumu ya Hebroni, mfumu ya Yarimuti, mfumu ya Lakisi ndi mfumu ya Egiloni, anagwirizana. Iwo anasonkhanitsa ankhondo awo nazungulira mzinda wa Gibiyoni ndi kuwuthira nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.5",
            "verseOrgIds": [
              "JOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma anthu a ku Gibiyoni anatumiza uthenga kwa Yoswa ku misasa ya ku Giligala nati, \"Musawataye anthu anu! Bwerani msanga mudzatipulumutse! Dzatithandizeni chifukwa mafumu a Aamori ochokera ku dziko la ku mapiri agwirizana kuti adzatithire nkhondo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.6",
            "verseOrgIds": [
              "JOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yoswa ananyamuka kuchoka ku Giligala ndi gulu lake la ankhondo pamodzi ndi anthu ake olimba mtima.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.7",
            "verseOrgIds": [
              "JOS.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anati kwa Yoswa, \"Usawaope, Ine ndawapereka mʼdzanja lako. Palibe ndi mmodzi mwa amenewa amene adzalimbe.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.8",
            "verseOrgIds": [
              "JOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atayenda usiku wonse kuchokera ku Giligala, Yoswa anawathira nkhondo mwadzidzidzi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.9",
            "verseOrgIds": [
              "JOS.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anachititsa mantha adani aja atangoona gulu lankhondo la Israeli. Choncho Aisraeli anagonjetsa Aamori ku Gibiyoni ndipo anawathamangitsa mu msewu wopita ku Beti-Horoni ndi kuwapha njira yonse yopita ku Azeka ndi Makeda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.10",
            "verseOrgIds": [
              "JOS.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ankathawa pamaso pa Israeli pa njira yochokera ku Beti-Horoni mpaka ku Azeka, Yehova anawagwetsera matalala akuluakulu kuchokera kumwamba ndipo ambiri mwa iwo anafa ndi matalala kuposa amene anaphedwa ndi lupanga la Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.11",
            "verseOrgIds": [
              "JOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku limene Yehova anapereka Aamori mʼmanja mwa Israeli, Yoswa ananena kwa Yehova pamaso pa Israeli kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOS 10:12"
      },
      "items": [
        {
          "text": "\"Iwe dzuwa, ima pamwamba pa Gibiyoni,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 10:12"
      },
      "items": [
        {
          "text": "mwezi ima pamwamba pa chigwa cha Ayaloni.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho dzuwa linayima,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "mwezinso unayima,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "mpaka dziko la Israeli litagonjetsa adani ake.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "Zimenezi zalembedwa mʼbuku la Yasari.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "Dzuwa linayima pamodzimodzi pakati pa thambo mlengalenga, osayendanso kwa tsiku lathunthu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sipanakhaleponso tsiku ngati limeneli kuyambira kale, tsiku limene Yehova anamvera munthu. Izi zinatero chifukwa Yehova ankamenyera nkhondo Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.14",
            "verseOrgIds": [
              "JOS.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yoswa anabwerera pamodzi ndi Aisraeli onse ku misasa ku Giligala.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.15",
            "verseOrgIds": [
              "JOS.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuphedwa kwa Mafumu Asanu a Aamori",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafumu asanu aja anathawa ndi kukabisala ku phanga la Makeda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.16",
            "verseOrgIds": [
              "JOS.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yoswa anamva kuti mafumu asanu awapeza akubisala ku phanga la Makeda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.17",
            "verseOrgIds": [
              "JOS.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Yoswa analamula kuti, \"Mugubuduzire miyala ikuluikulu pa khomo la phangalo, ndipo muyike anthu ena kuti azilondera.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.18",
            "verseOrgIds": [
              "JOS.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma inu musakhaleko! Thamangitsani adani anu, muwathire nkhondo kuchokera kumbuyo ndipo musawalole kuti akafike ku mizinda yawo, pakuti Yehova Mulungu wanu wawapereka mʼmanja mwanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.19",
            "verseOrgIds": [
              "JOS.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero Yoswa ndi Aisraeli anapha anthu aja, kupatulapo ochepa amene anathawa nakabisala ku mizinda yawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.20",
            "verseOrgIds": [
              "JOS.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka gulu lonse la ankhondo linabwerera bwinobwino kwa Yoswa ku misasa ya ku Makeda, palibe aliyense mu mzindamo amene anaputanso Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.21",
            "verseOrgIds": [
              "JOS.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa anati, \"Tsekulani khomo la phangalo ndipo muwabweretse kwa ine mafumu asanuwo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.22",
            "verseOrgIds": [
              "JOS.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo mafumu asanu aja anatulutsidwa, mfumu ya ku Yerusalemu, mfumu ya ku Hebroni, mfumu ya ku Yarimuti, mfumu ya ku Lakisi, ndi mfumu ya ku Egiloni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.23",
            "verseOrgIds": [
              "JOS.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atabwera nawo kwa Yoswa, iye anayitana Aisraeli onse. Ndipo analamula akuluakulu ake amene anapita naye limodzi kuti, \"Bwerani kuno ndipo apondeni pakhosi mafumuwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.24",
            "verseOrgIds": [
              "JOS.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa anawawuza kuti, \"Musaope kapena kutaya mtima. Khalani amphamvu ndi olimba mtima popeza umo ndi mmene Yehova adzachitire ndi adani anu onse amene mudzamenyana nawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.25",
            "verseOrgIds": [
              "JOS.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yoswa anawabaya ndi kuwapha mafumuwo ndipo anawapachika pa mitengo isanu ndipo anakhala pamenepo mpaka madzulo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.26",
            "verseOrgIds": [
              "JOS.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzuwa litalowa, Yoswa analamula kuti awachotse pa mitengo ija ndi kuwaponya mʼphanga limene ankabisalamo. Pa khomo pa phangalo anayikapo miyala ikuluikulu imene ilipo mpaka lero.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.27",
            "verseOrgIds": [
              "JOS.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lomwelo Yoswa analanda mzinda wa Makeda. Iye anapha anthu a mu mzindamo ndi mfumu yake ndipo sanasiye aliyense wamoyo. Yoswa anachita ndi mfumu ya ku Makeda monga anachitira ndi mfumu ya Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.28",
            "verseOrgIds": [
              "JOS.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agonjetsa Mizinda ya Kummwera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yoswa ndi Aisraeli onse anapitirira kuchokera ku Makeda nakafika ku Libina ndi kuthira nkhondo mzindawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.29",
            "verseOrgIds": [
              "JOS.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anaperekanso mzindawo ndi mfumu yake mʼmanja mwa Aisraeli. Ndipo Yoswa anapha onse amene anali mu mzindamo. Palibe amene anatsala wamoyo. Ndipo Yoswa anachita ndi mfumu ya Libina monga anachitira ndi mfumu ya Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.30",
            "verseOrgIds": [
              "JOS.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yoswa ndi Aisraeli onse anapitirira kuchokera ku Libina kupita ku Lakisi. Iye anazungulira mzindawo ndi kuwuthira nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.31",
            "verseOrgIds": [
              "JOS.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anapereka Lakisi kwa Israeli; ndipo Yoswa anawulanda pa tsiku lachiwiri. Monga anachita ndi mzinda wa Libina, Yoswa anapha anthu onse okhala mu mzinda wa Lakisi, ndipo palibe amene anatsala ndi moyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.32",
            "verseOrgIds": [
              "JOS.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi imeneyi nʼkuti Horamu mfumu ya Gezeri itabwera kudzathandiza Lakisi koma Yoswa anamugonjetsa pamodzi ndi asilikali ake ndipo palibe anatsala wamoyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.33",
            "verseOrgIds": [
              "JOS.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yoswa ndi Aisraeli onse anapitirira kuchokera ku Lakisi nakafika ku Egiloni. Iwo anazungulira mzindawo ndi kuwuthira nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.34",
            "verseOrgIds": [
              "JOS.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anawulanda tsiku lomwelo ndipo anapha aliyense amene anali mu mzindawo monga momwe anachitira ku Lakisi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.35",
            "verseOrgIds": [
              "JOS.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yoswa ndi Aisraeli onse anachoka ku Egiloni nakafika ku Hebroni ndi kukawuthira nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.36",
            "verseOrgIds": [
              "JOS.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo analanda mzindawo napha ndi lupanga mfumu yake pamodzi ndi onse amene ankakhala mʼmenemo. Monga anachita ndi mzinda wa Egiloni, kuti sanasiye aliyense ndi moyo, anachitanso chimodzimodzi ndi mzinda wa Hebroni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.37",
            "verseOrgIds": [
              "JOS.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake Yoswa ndi Aisraeli onse anatembenukira mzinda wa Debri ndi kukawuthira nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.38",
            "verseOrgIds": [
              "JOS.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo analanda mzindawo ndi midzi ndi kupha mfumu yake pamodzi ndi onse okhala mʼmenemo. Anachita ndi mzinda wa Debri pamodzi ndi mfumu yake zofanana ndi zimene anachita ndi mzinda wa Libina ndi wa Hebroni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motero Yoswa anagonjetsa dziko lonselo. Anapha mafumu onse a dera la kumapiri, dera la kummawa, dera la kumadzulo mʼmphepete mwa phiri, ndiponso dera la ku magomo, kummwera. Iye sanasiye wina aliyense wamoyo. Anapha onse amene anali moyo monga momwe Yehova Mulungu wa Israeli analamulira.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.40",
            "verseOrgIds": [
              "JOS.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa anawagonjetsa iwo kuyambira ku Kadesi Barinea mpaka ku Gaza, ndiponso kuchokera ku chigawo chonse cha Goseni mpaka ku Gibiyoni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.41",
            "verseOrgIds": [
              "JOS.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa anagonjetsa mafumu onsewa ndi kulanda dziko lawo kamodzinʼkamodzi chifukwa Yehova Mulungu wa Israeli anawamenyera nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
            "verseOrgIds": [
              "JOS.10.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake Yoswa ndi Aisraeli onse anabwerera ku misasa yawo ku Giligala.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.43",
            "verseOrgIds": [
              "JOS.10.43"
            ]
          }
        }
      ]
    }
  ],
