      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:13"
      },
      "items": [
        {
          "text": "chifukwa anakana Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.13",
            "verseOrgIds": [
              "JER.17.13"
            ]
          }
        }
