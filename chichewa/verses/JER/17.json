    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:15"
      },
      "items": [
        {
          "text": "\"Mawu a Yehova ali kuti?",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.15",
            "verseOrgIds": [
              "JER.17.15"
            ]
          }
        }
