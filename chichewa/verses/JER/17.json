        "vid": "JER 17:12"
      },
      "items": [
        {
          "text": "wokhazikitsidwa pa phiri lalitali chiyambire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.12",
            "verseOrgIds": [
              "JER.17.12"
            ]
