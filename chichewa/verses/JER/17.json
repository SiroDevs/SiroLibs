          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu akumandinena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.15",
            "verseOrgIds": [
              "JER.17.15"
            ]
          }
        }
