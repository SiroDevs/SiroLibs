          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, chiyembekezo cha Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.13",
            "verseOrgIds": [
              "JER.17.13"
            ]
          }
        }
