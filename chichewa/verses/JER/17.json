      "attrs": {
        "style": "q1",
        "vid": "JER 17:11"
      },
      "items": [
        {
          "text": "Pamene ali pakatikati pa moyo wake, chumacho chidzamuthera,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.11",
            "verseOrgIds": [
