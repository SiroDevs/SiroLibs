      "attrs": {
        "style": "q2",
        "vid": "JER 17:11"
      },
      "items": [
        {
          "text": "ali ngati nkhwali imene imafungatira mazira amene sinayikire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.11",
            "verseOrgIds": [
              "JER.17.11"
