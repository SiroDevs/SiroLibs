      "attrs": {
        "style": "q2",
        "vid": "JER 17:11"
      },
      "items": [
        {
          "text": "ndipo potsiriza adzasanduka chitsiru.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.11",
            "verseOrgIds": [
              "JER.17.11"
            ]
          }
        }
