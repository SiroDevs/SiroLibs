      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:15"
      },
      "items": [
        {
          "text": "Zichitiketu lero kuti tizione!\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.15",
            "verseOrgIds": [
              "JER.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine sindinakuwumirizeni kuti muwalange.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.16",
            "verseOrgIds": [
              "JER.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:16"
      },
      "items": [
        {
          "text": "Mukudziwa kuti ine sindilakalaka tsiku la tsoka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.16",
            "verseOrgIds": [
              "JER.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:16"
      },
      "items": [
        {
          "text": "Zonse zimene ndinayankhula Inu mukuzidziwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.16",
            "verseOrgIds": [
              "JER.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
