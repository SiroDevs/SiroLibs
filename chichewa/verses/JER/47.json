  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "JER 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uthenga Wonena za Afilisti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uthenga umene Yehova anamupatsa mneneri Yeremiya wonena za Afilisti, Farao asanathire nkhondo Gaza ndi uwu:",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.1",
            "verseOrgIds": [
              "JER.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "\"Taonani mmene madzi akubwerera kuchokera kumpoto;",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "adzasanduka mtsinje wosefukira ndi a mkokomo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "Adzasefukira mʼdziko monse ndi kumiza chilichonse mʼmenemo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "mizinda ndi onse okhala mʼmenemo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "Anthu adzafuwula;",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "anthu onse okhala mʼdzikomo adzalira",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "akadzamva mgugu wa ngʼombe zazimuna zothamanga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:3"
      },
      "items": [
        {
          "text": "phokoso la magaleta ake",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:3"
      },
      "items": [
        {
          "text": "ndi kulira kwa mikombero yake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:3"
      },
      "items": [
        {
          "text": "Makolo sadzatembenuka kuti athandize ana awo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:3"
      },
      "items": [
        {
          "text": "manja awo adzangoti khoba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti tsiku lafika",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:4"
      },
      "items": [
        {
          "text": "lowononga Afilisti onse",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:4"
      },
      "items": [
        {
          "text": "ndi kupha onse otsala,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:4"
      },
      "items": [
        {
          "text": "onse amene akanatha kuthandiza Turo ndi Sidoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:4"
      },
      "items": [
        {
          "text": "Yehova ali pafupi kuwononga Afilisti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:4"
      },
      "items": [
        {
          "text": "otsala ochokera ku zilumba za ku Kafitori.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a ku Gaza ameta mipala;",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:5"
      },
      "items": [
        {
          "text": "anthu a ku Asikeloni akhala chete.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:5"
      },
      "items": [
        {
          "text": "Inu otsala a ku chigwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:5"
      },
      "items": [
        {
          "text": "mudzakhala mukudzichekacheka mpaka liti?",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mukulira kuti, 'Aa, lupanga la Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:6"
      },
      "items": [
        {
          "text": "kodi udzapumula liti?",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:6"
      },
      "items": [
        {
          "text": "Bwerera mʼmalo ako;",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:6"
      },
      "items": [
        {
          "text": "ukhale momwemo ndipo ukhale chete.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma lupangalo lidzapumula bwanji",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:7"
      },
      "items": [
        {
          "text": "pamene Yehova walilamulira",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:7"
      },
      "items": [
        {
          "text": "kuti lithire nkhondo",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:7"
      },
      "items": [
        {
          "text": "Asikeloni ndi anthu a mʼmbali mwa nyanja?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
    }
  ],
