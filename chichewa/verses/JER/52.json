    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumasulidwa kwa Yehoyakini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 52:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka chimene Evili-Merodaki analowa ufumu wa Babuloni, iye anakomera mtima Yehoyakini mfumu ya ku Yuda, namutulutsa mʼndende. Izi zinachitika pa tsiku la 25 la mwezi wa khumi ndi chiwiri zitatha zaka 37 chitengedwere Yehoyakimu ku ukapolo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Evili-Merodaki anakomera mtima Yehoyakini, namupatsa malo aulemu kuposa mafumu ena amene anali naye ku Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yehoyakini analoledwa kuvula zovala zake za ku ndende ndipo tsiku ndi tsiku ankadya ndi mfumu pa moyo wake wonse.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku ndi tsiku mfumu ya ku Babuloni inkamupatsa Yehoyakini phoso lake nthawi yonse ya moyo wake, mpaka pa nthawi ya imfa yake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
            "verseOrgIds": [
              "JER.52.34"
            ]
          }
        }
      ]
    }
