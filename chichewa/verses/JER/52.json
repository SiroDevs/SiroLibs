    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JER 52:30"
      },
      "items": [
        {
          "text": "Nebuzaradani, mtsogoleri wa ankhondo a mfumu anagwira Ayuda 745 kupita ku ukapolo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
