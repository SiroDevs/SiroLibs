  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JER 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aa, ndikanakonda kuti mutu wanga ukanakhala chitsime cha madzi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:1"
      },
      "items": [
        {
          "text": "ndi maso anga ngati kasupe wa misozi!",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:1"
      },
      "items": [
        {
          "text": "Ndikanalira usana ndi usiku",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:1"
      },
      "items": [
        {
          "text": "kulirira anthu anga amene aphedwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani adzandipatsa malo",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "ogona mʼchipululu",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "kuti ndiwasiye anthu anga",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "ndi kuwachokera kupita kutali;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "pakuti onse ndi achigololo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "ndiponso gulu la anthu onyenga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Amapinda lilime lawo ngati uta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "Mʼdzikomo mwadzaza",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "ndi mabodza okhaokha",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "osati zoonadi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "Amapitirirabe kuchita zoyipa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "ndipo sandidziwa Ine.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "Akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aliyense achenjere ndi abwenzi ake;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:4"
      },
      "items": [
        {
          "text": "asadalire ngakhale abale ake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:4"
      },
      "items": [
        {
          "text": "Aliyense amafuna kumudyera mʼbale wake masuku pa mutu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:4"
      },
      "items": [
        {
          "text": "Choncho aliyense amachitira bwenzi lake ugogodi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliyense amamunamiza mʼbale wake",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:5"
      },
      "items": [
        {
          "text": "ndipo palibe amene amayankhula choonadi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:5"
      },
      "items": [
        {
          "text": "Anapazoloweza pakamwa pawo kunena zabodza;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:5"
      },
      "items": [
        {
          "text": "amalimbika kuchita machimo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe wakhalira mʼchinyengo",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.6",
            "verseOrgIds": [
              "JER.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:6"
      },
      "items": [
        {
          "text": "ndipo ukukana kundidziwa Ine,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.6",
            "verseOrgIds": [
              "JER.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 9:6"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake Yehova Wamphamvuzonse akuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:7"
      },
      "items": [
        {
          "text": "\"Taonani, Ine ndidzawasungunula ngati chitsulo ndi kuwayesa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:7"
      },
      "items": [
        {
          "text": "Kodi ndingachite nawonso",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:7"
      },
      "items": [
        {
          "text": "bwanji chifukwa cha machimo awo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilime lawo lili ngati muvi wakuthwa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:8"
      },
      "items": [
        {
          "text": "limayankhula zachinyengo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:8"
      },
      "items": [
        {
          "text": "Aliyense ndi pakamwa pake amayankhula mawu achikondi kwa mnansi wake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:8"
      },
      "items": [
        {
          "text": "koma mu mtima mwake amakonzekera zomuchita chiwembu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ndilekerenji kuwalanga chifukwa cha zimenezi?",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "'Kodi ndisawulipsire",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "mtundu wotere wa anthu?' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakhetsa misozi ndi kulira kwamphamvu chifukwa cha mapiri",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "ndipo ndidzadandaula chifukwa cha msipu wa ku chipululu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "Malo onsewo awonongeka ndipo palibe amene amapitako,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "ndipo sikumveka kulira kwa ngʼombe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "Mbalame zamlengalenga zathawa",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "ndipo nyama zakuthengo zachokako.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova anati, \"Ndidzasandutsa Yerusalemu kukhala bwinja,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.11",
            "verseOrgIds": [
              "JER.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:11"
      },
      "items": [
        {
          "text": "malo okhalamo ankhandwe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.11",
            "verseOrgIds": [
              "JER.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:11"
      },
      "items": [
        {
          "text": "ndipo ndidzawononga mizinda ya Yuda",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.11",
            "verseOrgIds": [
              "JER.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:11"
      },
      "items": [
        {
          "text": "kotero kuti palibe munthu amene adzakhalemo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.11",
            "verseOrgIds": [
              "JER.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndinati, \"Kodi munthu wanzeru ndani woti nʼkumvetsa zimenezi? Kodi ndani amene Yehova anayankhula naye zimenezi kuti akafotokozere ena? Nʼchifukwa chiyani dziko lawonongeka ndi kusanduka chipululu, mʼmene anthu sadutsamo?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.12",
            "verseOrgIds": [
              "JER.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anati, \"Nʼchifukwa chakuti anthuwa analeka kutsata malamulo anga amene ndinawapatsa; sanandimvere kapena kuwasamala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.13",
            "verseOrgIds": [
              "JER.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmalo mwake, anatsatira zolakwa za mʼmitima yawo; anapembedza Abaala ngati momwe makolo awo anawaphunzitsira.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.14",
            "verseOrgIds": [
              "JER.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono chimene Ine Yehova Wamphamvuzonse, Mulungu wa Israeli ndidzachite ndi anthu amenewa ndi ichi: \"Ndidzawadyetsa chakudya cha ziphe ndi kuwamwetsa madzi a ndulu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.15",
            "verseOrgIds": [
              "JER.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzawabalalitsa pakati pa mitundu ya anthu imene iwowo kapena makolo awo sanayidziwe, ndipo ndidzawalondola ndi ankhondo mpaka nditawawononga.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.16",
            "verseOrgIds": [
              "JER.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Wamphamvuzonse akuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.17",
            "verseOrgIds": [
              "JER.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:17"
      },
      "items": [
        {
          "text": "\"Tsopano ganizirani! Muyitane akazi olira mwachisoni kuti abwere;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.17",
            "verseOrgIds": [
              "JER.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:17"
      },
      "items": [
        {
          "text": "itanani akazi odziwa kulira bwino.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.17",
            "verseOrgIds": [
              "JER.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu akuti, \"Abwere mofulumira",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.18",
            "verseOrgIds": [
              "JER.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:18"
      },
      "items": [
        {
          "text": "kuti adzatilire",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.18",
            "verseOrgIds": [
              "JER.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:18"
      },
      "items": [
        {
          "text": "mpaka mʼmaso mwathu mutatuluka misozi",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.18",
            "verseOrgIds": [
              "JER.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:18"
      },
      "items": [
        {
          "text": "ndi kuti msidze zathu zinyowe ndi madzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.18",
            "verseOrgIds": [
              "JER.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulira mwachisoni kukumveka kuchokera mu Ziyoni akuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.19",
            "verseOrgIds": [
              "JER.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:19"
      },
      "items": [
        {
          "text": "'Aa! Ife tawonongeka!",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.19",
            "verseOrgIds": [
              "JER.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:19"
      },
      "items": [
        {
          "text": "Tachita manyazi kwambiri!",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.19",
            "verseOrgIds": [
              "JER.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:19"
      },
      "items": [
        {
          "text": "Tiyenera kuchoka mʼdziko lathu",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.19",
            "verseOrgIds": [
              "JER.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:19"
      },
      "items": [
        {
          "text": "chifukwa atipirikitsa mʼnyumba zathu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.19",
            "verseOrgIds": [
              "JER.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono inu amayi, imvani mawu a Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.20",
            "verseOrgIds": [
              "JER.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:20"
      },
      "items": [
        {
          "text": "tcherani makutu anu kuti mumve mawu a Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.20",
            "verseOrgIds": [
              "JER.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:20"
      },
      "items": [
        {
          "text": "Phunzitsani ana anu aakazi kulira mwachisoni;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.20",
            "verseOrgIds": [
              "JER.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:20"
      },
      "items": [
        {
          "text": "aliyense aphunzitse mnzake nyimbo ya maliro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.20",
            "verseOrgIds": [
              "JER.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imfa yatifikira kudzera mʼmazenera athu",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:21"
      },
      "items": [
        {
          "text": "ndipo yalowa mʼnyumba zathu zotetezedwa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:21"
      },
      "items": [
        {
          "text": "yapha ana athu mʼmisewu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:21"
      },
      "items": [
        {
          "text": "ndi achinyamata athu mʼmabwalo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anandiwuza kuti ndinene izi kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:22"
      },
      "items": [
        {
          "text": "\" 'Mitembo ya anthu",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:22"
      },
      "items": [
        {
          "text": "idzakhala ili lambalamba ngati ndowe mʼminda,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:22"
      },
      "items": [
        {
          "text": "ngati mapesi mʼmbuyo mwa wokolola,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:22"
      },
      "items": [
        {
          "text": "popanda munthu woyitola.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:23"
      },
      "items": [
        {
          "text": "\"Munthu wanzeru asanyadire nzeru zake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:23"
      },
      "items": [
        {
          "text": "kapena munthu wamphamvu kunyadira nyonga zake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:23"
      },
      "items": [
        {
          "text": "kapena munthu wolemera kunyadira chuma chake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma ngati munthu akufuna kunyadira, anyadire chinthu ichi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.24",
            "verseOrgIds": [
