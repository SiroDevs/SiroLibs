  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "JER 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hananiya Atsutsana ndi Yeremiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaka chomwecho mwezi wachisanu wa chaka chachinayi, poyambirira pa ulamuliro wa Zedekiya mfumu ya Yuda, mneneri Hananiya mwana wa Azuri, amene amachokera ku Gibiyoni, anandiwuza ine mʼNyumba ya Yehova pamaso pa ansembe ndi anthu onse kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.1",
            "verseOrgIds": [
              "JER.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yehova Wamphamvuzonse, Mulungu wa Israeli, akuti, 'Ndidzathyola goli la mfumu ya ku Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.2",
            "verseOrgIds": [
              "JER.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasanathe zaka ziwiri ndidzabweretsa pa malo ano ziwiya zonse za ku Nyumba ya Yehova zimene Nebukadinezara mfumu ya ku Babuloni anazichotsa pa malo pano ndi kupita nazo ku Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.3",
            "verseOrgIds": [
              "JER.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzabweretsanso pa malo pano Yekoniya mwana wa Yehoyakimu mfumu ya Yuda pamodzi ndi akapolo ena onse ochokera ku Yuda amene anapita ku Babuloni,' akutero Yehova, 'chifukwa ndidzathyola goli la mfumu ya ku Babuloni.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.4",
            "verseOrgIds": [
              "JER.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo mneneri Yeremiya anayankha mneneri Hananiya pamaso pa ansembe ndi anthu onse amene anasonkhana mʼNyumba ya Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.5",
            "verseOrgIds": [
              "JER.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anati, \"Ameni! Yehova achitedi zomwezo! Yehova akwaniritse mawu amene waloserawo. Iye abweretsenso pa malo pano ziwiya za mʼNyumba ya Yehova ndi akapolo onse kuchokera ku Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.6",
            "verseOrgIds": [
              "JER.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe, tamvera zimene nditi ndikuwuze iweyo pamodzi ndi anthu onse:",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.7",
            "verseOrgIds": [
              "JER.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunali aneneri kalelo, ine ndi iwe tisanabadwe. Iwowa analosera za nkhondo, mavuto ndi mliri kuti zidzagwera mayiko ambiri ndi maufumu amphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.8",
            "verseOrgIds": [
              "JER.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mneneri amene amalosera zamtendere adzadziwika kuti ndi woona ndi kuti watumidwa ndi Yehova ngati zimene wanenera zachitikadi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.9",
            "verseOrgIds": [
              "JER.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo mneneri Hananiya anachotsa goli mʼkhosi mwa mneneri Yeremiya nalithyola,",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.10",
            "verseOrgIds": [
              "JER.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo anawuza anthu onse kuti, \"Yehova akuti, 'Umu ndi mmene ndidzathyolere goli la Nebukadinezara mfumu ya ku Babuloni mʼkhosi mwa anthu a mitundu yonse pasanathe zaka ziwiri.' \" Zitatero, mneneri Yeremiya anachoka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.11",
            "verseOrgIds": [
              "JER.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patapita nthawi pangʼono, mneneri Hananiya atathyola goli mʼkhosi mwa mneneri Yeremiya, Yehova anawuza Yeremiya kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.12",
            "verseOrgIds": [
              "JER.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pita, kawuze mneneri Hananiya kuti, 'Yehova akuti: Iwe wathyola goli lamtengo, mʼmalo mwake Ine ndidzayika goli lachitsulo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.13",
            "verseOrgIds": [
              "JER.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Wamphamvuzonse, Mulungu wa Israeli akuti: Ndidzayika goli lachitsulo mʼkhosi mwa anthu a mitundu yonseyi kuti atumikire Nebukadinezara mfumu ya ku Babuloni, ndipo iwo adzamutumikiradi. Ndipo ndamupatsanso ulamuliro ngakhale pa nyama zakuthengo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.14",
            "verseOrgIds": [
              "JER.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mneneri Yeremiya anawuza mneneri Hananiya kuti, \"Tamvera, Hananiya! Iweyo Yehova sanakutume, koma iwe wanyenga anthuwa kuti akhulupirire zabodza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.15",
            "verseOrgIds": [
              "JER.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake Yehova akuti, 'Ndatsala pangʼono kukuchotsa pa dziko lapansi. Iwe ufa chaka chino chisanathe, chifukwa wakhala ukulalikira zowukira Yehova.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.16",
            "verseOrgIds": [
              "JER.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmwezi wachisanu ndi chiwiri wa chaka chomwecho, mneneri Hananiya anamwaliradi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.17",
            "verseOrgIds": [
              "JER.28.17"
            ]
          }
        }
      ]
    }
  ],
