      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Abwenzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe wokongola kuposa akazi onsewa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "kodi wokondedwa wakoyo wapita kuti?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "Kodi wokondedwa wakoyo wakhotera njira iti",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "kuti timufunefune pamodzi ndi iwe?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mkazi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wachikondi wanga watsikira ku munda kwake,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "ku timinda ta zokometsera zakudya,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "akukadyetsa ziweto zake ku minda,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "ndiponso akuthyola maluwa okongola.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wokondedwa wangayo ndine wake ndipo iyeyo ndi wangawanga;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.3",
            "verseOrgIds": [
              "SNG.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:3"
      },
      "items": [
        {
          "text": "amadyetsa ziweto zake pakati pa maluwa okongola.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.3",
            "verseOrgIds": [
              "SNG.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mwamuna",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiwe wokongola, bwenzi langa, ngati Tiriza,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:4"
      },
      "items": [
        {
          "text": "wokongola kwambiri ngati Yerusalemu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:4"
      },
      "items": [
        {
          "text": "ndiwe woopsa ngati gulu lankhondo lonyamula mbendera.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usandipenyetsetse;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "pakuti maso ako amanditenga mtima.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "Tsitsi lako lili ngati gulu la mbuzi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "zikutsetsereka kuchokera ku Giliyadi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano ako ali ngati gulu la nkhosa",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "zimene zikubwera kuchokera kokazisambitsa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "iliyonse ili ndi ana amapasa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "palibe imene ili yokha.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukhalira kumbuyo kwa nsalu yako yophimba kumutu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.7",
            "verseOrgIds": [
              "SNG.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:7"
      },
      "items": [
        {
          "text": "masaya ako ali ngati mabandu a makangadza.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.7",
            "verseOrgIds": [
              "SNG.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale patakhala akazi a mfumu 60,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:8"
      },
      "items": [
        {
          "text": "ndi azikazi 80,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:8"
      },
      "items": [
        {
          "text": "ndi anamwali osawerengeka;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma nkhunda yanga, wangwiro wanga ndi wosiyana ndi wina aliyense;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "mwana wamkazi yekhayo wa amayi ake,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "mwana wapamtima wa amene anamubereka.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "Anamwali anamuona ndipo anamutcha wodala;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "akazi a mfumu ndi azikazi anamutamanda.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Abwenzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani uyu akuoneka ngati mʼbandakucha,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:10"
      },
      "items": [
        {
          "text": "wokongola ngati mwezi, wowala ngati dzuwa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:10"
      },
      "items": [
        {
          "text": "wochititsa mantha ngati gulu la ankhondo mbendera zili mʼmanja?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mwamuna",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinatsikira ku munda wa mitengo ya alimondi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:11"
      },
      "items": [
        {
          "text": "kukayangʼana zomera zatsopano ku chigwa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:11"
      },
      "items": [
        {
          "text": "kukaona ngati mpesa waphukira",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:11"
      },
      "items": [
        {
          "text": "kapena ngati makangadza ali ndi maluwa.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndisanazindikire kanthu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.12",
            "verseOrgIds": [
              "SNG.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
