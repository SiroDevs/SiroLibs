  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "SNG 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mwamuna",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiwe wokongoladi wokondedwa wanga!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "Ndithudi, ndiwe wokongola!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "Maso ako ali ngati nkhunda kumbuyo kwa nsalu yophimba kumutu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "Tsitsi lako lili ngati gulu la mbuzi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "zikutsetsereka kuchokera ku Giliyadi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano ako ali ngati gulu la nkhosa zomwe zangometedwa kumene,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:2"
      },
      "items": [
        {
          "text": "zochokera kozisambitsa kumene.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:2"
      },
      "items": [
        {
          "text": "Iliyonse ili ndi ana amapasa;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:2"
      },
      "items": [
        {
          "text": "palibe imene ili yokha.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Milomo yako ili ngati mbota yofiira;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:3"
      },
      "items": [
        {
          "text": "pakamwa pako ndi pokongola kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:3"
      },
      "items": [
        {
          "text": "Kukhalira kumbuyo kwa nsalu yako yophimba",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:3"
      },
      "items": [
        {
          "text": "kumutuyo, masaya ako akuoneka ngati mabandu a makangadza.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khosi lako lili ngati nsanja ya Davide,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:4"
      },
      "items": [
        {
          "text": "yomangidwa bwino ndi yosalala;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:4"
      },
      "items": [
        {
          "text": "pa nsanja imeneyo pali zishango 1,000,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:4"
      },
      "items": [
        {
          "text": "zishango zonsezo za anthu ankhondo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawere ako ali ngati tiana tiwiri ta nswala,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.5",
            "verseOrgIds": [
              "SNG.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:5"
      },
      "items": [
        {
          "text": "ngati ana amapasa a nswala",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.5",
            "verseOrgIds": [
              "SNG.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:5"
      },
      "items": [
        {
          "text": "amene akudya pakati pa maluwa okongola.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.5",
            "verseOrgIds": [
              "SNG.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamphepo kamadzulo kakayamba kuwuzira",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:6"
      },
      "items": [
        {
          "text": "ndipo mithunzi ikayamba kuthawa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:6"
      },
      "items": [
        {
          "text": "ndidzapita ku phiri la mure",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:6"
      },
      "items": [
        {
          "text": "ndi ku chitunda cha lubani.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiwe wokongola kwambiri wokondedwa wanga;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.7",
            "verseOrgIds": [
              "SNG.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:7"
      },
      "items": [
        {
          "text": "palibe chilema pa iwe.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.7",
            "verseOrgIds": [
              "SNG.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiye tichoke ku Lebanoni iwe mkwatibwi wanga,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "tiye tichoke ku Lebanoni,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "utsikepo pa msonga ya Amana,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "kuchoka pa msonga ya phiri la Seniri, pamwamba penipeni pa Herimoni,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "kuchoka ku mapanga a mikango",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "ndiponso kumapiri kumene akambuku amavutitsa.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe mlongo wanga, mkwatibwi wanga, wanditenga mtima,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "iwe wanditenga mtima",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "ndi kapenyedwe ka maso ako,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "ndiponso ndi umodzi mwa mikanda ya mʼkhosi mwako.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe mlongo wanga, mkwatibwi wanga, chikondi chako nʼchosangalatsa!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:10"
      },
      "items": [
        {
          "text": "Chikondi chako nʼchosangalatsa kwambiri kupambana vinyo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:10"
      },
      "items": [
        {
          "text": "ndiponso fungo la mafuta ako ndi lopambana zonunkhiritsa zonse!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe mkwatibwi wanga, milomo yako ikuchucha uchi ngati chisa cha njuchi;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:11"
      },
      "items": [
        {
          "text": "pansi pa lilime lako pali mkaka ndi uchi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:11"
      },
      "items": [
        {
          "text": "Fungo lonunkhira la zovala zako likumveka ngati fungo la ku Lebanoni.",
