  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JHN 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Achiritsa Munthu Wosaona Chibadwire",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akuyendabe, anaona munthu wosaona chibadwire.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.1",
            "verseOrgIds": [
              "JHN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ophunzira ake anamufunsa Iye kuti, \"Rabi anachimwa ndani, munthuyu kapena makolo ake, kuti iye abadwe wosaona?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.2",
            "verseOrgIds": [
              "JHN.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.3",
            "verseOrgIds": [
              "JHN.9.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sikuti iyeyu anachimwa kapena makolo ake, koma izi zinachitika kuti Mulungu aonetse ntchito zake mwa iyeyu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.9.3",
                "verseOrgIds": [
                  "JHN.9.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.3",
            "verseOrgIds": [
              "JHN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ife tiyenera kugwira ntchito za Iye amene anandituma kukanali masana. Usiku ukubwera, pamene wina aliyense sadzagwira ntchito.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.9.4",
                "verseOrgIds": [
                  "JHN.9.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.4",
            "verseOrgIds": [
              "JHN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamene Ine ndili mʼdziko lapansi, Ine ndine kuwunika kwa dziko lapansi.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.9.5",
                "verseOrgIds": [
                  "JHN.9.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atanena izi, Iye anathira malovu pansi ndi kukanda dothi, napaka matopewo mʼmaso a munthuyo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.6",
            "verseOrgIds": [
              "JHN.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anamuwuza iye kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.7",
            "verseOrgIds": [
              "JHN.9.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pita kasambe mʼdziwe la Siloamu\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.9.7",
                "verseOrgIds": [
                  "JHN.9.7"
                ]
              }
            }
          ]
        },
        {
          "text": "(mawu awa akutanthauza Wotumidwa). Choncho munthuyo anapita ndi kukasamba ndipo anabwerako akupenya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.7",
            "verseOrgIds": [
              "JHN.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzake ndi iwo amene anamuona iye poyamba akupempha anafunsa kuti, \"Kodi uyu si munthu amene amapemphapempha uja?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.8",
            "verseOrgIds": [
              "JHN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena ananena kuti anali yemweyo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.9",
            "verseOrgIds": [
              "JHN.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 9:9"
      },
      "items": [
        {
          "text": "Ena anati, \"Ayi, sakuoneka ngati yemweyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.9",
            "verseOrgIds": [
              "JHN.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 9:9"
      },
      "items": [
        {
          "text": "Koma iye mwini ananenetsa kuti, \"Munthuyo ndine.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.9",
            "verseOrgIds": [
              "JHN.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anafunsitsa kuti, \"Kodi nanga maso ako anatsekuka bwanji?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.10",
            "verseOrgIds": [
              "JHN.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayankha kuti, \"Munthu wina wotchedwa Yesu anakanda dothi ndi kupaka mʼmaso anga. Iye anandiwuza kuti ndipite ku Siloamu ndi kukasamba. Choncho ndinapita kukasamba, ndipo ndikuona.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.11",
            "verseOrgIds": [
              "JHN.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anamufunsa iye kuti, \"Ali kuti munthu ameneyu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.12",
            "verseOrgIds": [
              "JHN.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 9:12"
      },
      "items": [
        {
          "text": "Iye anati, \"Ine sindikudziwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.12",
            "verseOrgIds": [
              "JHN.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Afarisi Afufuza za Kuchiritsidwa Kwake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anabwera naye munthu amene poyamba anali wosaona kwa Afarisi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.13",
            "verseOrgIds": [
              "JHN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono linali la Sabata tsiku limene Yesu anakanda dothi ndi kutsekula maso a munthuyu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.14",
            "verseOrgIds": [
              "JHN.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Afarisi anamufunsanso iye momwe analandirira kuona kwake. Munthuyo anayankha kuti, \"Iye anapaka matope mʼmaso anga, ndipo ine ndinakasamba, ndipo ndikuona.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.15",
            "verseOrgIds": [
              "JHN.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena a Afarisi anati, \"Munthu uyu siwochokera kwa Mulungu, pakuti sasunga Sabata.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.16",
            "verseOrgIds": [
              "JHN.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 9:16"
      },
      "items": [
        {
          "text": "Koma enanso anafunsa kuti, \"Kodi munthu wochimwa angachite bwanji zizindikiro zodabwitsa ngati izi?\" Choncho iwo anagawanika.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.16",
            "verseOrgIds": [
              "JHN.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pomaliza iwo anatembenukiranso kwa munthu amene anali wosaona uja nati, \"Kodi iwe unena chiyani za Iye poti ndi maso ako amene watsekula?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.17",
            "verseOrgIds": [
              "JHN.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 9:17"
      },
      "items": [
        {
          "text": "Munthuyo anayankha kuti, \"Iye ndi mneneri.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.17",
            "verseOrgIds": [
              "JHN.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayuda sanakhulupirirebe kuti iye anali wosaona ndi kuti anayamba kuona kufikira atayitana makolo ake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.18",
            "verseOrgIds": [
              "JHN.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anafunsa kuti, \"Kodi uyu ndi mwana wanu? Kodi iyeyu ndi amene mukunena kuti anabadwa wosaona? Nanga zikutheka bwanji kuti akuona?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.19",
            "verseOrgIds": [
              "JHN.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makolo anayankha kuti, \"Ife tikudziwa kuti ndi mwana wathu, ndipo tikudziwa kuti anabadwa wosaona.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.20",
            "verseOrgIds": [
              "JHN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma sitidziwa zimene zachitika kuti tsopano azipenya. Amenenso wamupenyetsa sitikumudziwa. Mufunseni ndi wamkulu; iye adziyankhira yekha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.21",
            "verseOrgIds": [
              "JHN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makolo ake ananena izi chifukwa amaopa Ayuda, popeza Ayuda anatsimikiza kale kuti aliyense amene adzamuvomereza Yesu kuti anali Khristu adzatulutsidwa mʼsunagoge.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.22",
            "verseOrgIds": [
              "JHN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi ndi chifukwa chake makolo ake anati, \"Mufunseni iye ndi wamkulu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.23",
            "verseOrgIds": [
              "JHN.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anamuyitanitsa kachiwiri munthu amene anali wosaonayo. Iwo anati, \"Lemekeza Mulungu. Ife tikudziwa kuti munthu uyu ndi wochimwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.24",
            "verseOrgIds": [
              "JHN.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayankha kuti, \"Zakuti Iye ndi wochimwa kapena ayi, ine sindikudziwa. Ine ndikudziwa chinthu chimodzi. Ndinali wosaona koma tsopano ndikuona!\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.25",
            "verseOrgIds": [
              "JHN.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka anamufunsa kuti, \"Kodi Iye anachita chiyani kwa iwe? Iye anatsekula motani maso ako?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.26",
            "verseOrgIds": [
              "JHN.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayankha kuti, \"Ine ndakuwuzani kale ndipo inu simunamvetsetse. Chifukwa chiyani mukufuna mumvenso? Mukufuna kuti inu mukhale ophunzira akenso?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.27",
            "verseOrgIds": [
              "JHN.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo anamunyoza ndipo anati, \"Iwe ndiye ophunzira wa munthuyu! Ife ndife ophunzira a Mose!",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.28",
            "verseOrgIds": [
              "JHN.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife tikudziwa kuti Mulungu anayankhula kwa Mose, koma za munthu uyu, ife sitikudziwa ngakhale kumene akuchokera.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.29",
            "verseOrgIds": [
              "JHN.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthuyo anayankha kuti, \"Tsopano izi ndi zodabwitsa! Inu simukudziwa kumene akuchokera, komabe iye watsekula maso anga.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.30",
            "verseOrgIds": [
              "JHN.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife tikudziwa kuti Mulungu samvera wochimwa. Iye amamvera munthu woopa Mulungu amene amachita chifuniro chake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.31",
            "verseOrgIds": [
              "JHN.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palibe amene anamvapo za kutsekula maso a munthu wobadwa wosaona.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.32",
            "verseOrgIds": [
              "JHN.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati munthu uyu akanakhala wosachokera kwa Mulungu, palibe chimene Iye akanachita.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.33",
            "verseOrgIds": [
              "JHN.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo anayankha kuti, \"Iwe unabadwa mu uchimo kotheratu; bwanji ukuyesa kutiphunzitsa ife!\" Ndipo anamutulutsa kunja.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.34",
            "verseOrgIds": [
              "JHN.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusaona kwa Uzimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anamva kuti anamutulutsa kunja ndipo pamene anamupeza anati,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.35",
            "verseOrgIds": [
              "JHN.9.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi ukukhulupirira Mwana wa Munthu?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.9.35",
                "verseOrgIds": [
                  "JHN.9.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthuyo anafunsa kuti, \"Kodi, Ambuye, ameneyo ndi ndani? Ndiwuzeni kuti ndimukhulupirire Iye?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.36",
            "verseOrgIds": [
              "JHN.9.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anati,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.37",
            "verseOrgIds": [
              "JHN.9.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Iwe wamuona tsopano. Zoonadi ndiye amene akuyankhula nawe.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.9.37",
                "verseOrgIds": [
                  "JHN.9.37"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo munthuyo anati, \"Ambuye, ndikukhulupirira,\" ndipo anamulambira Iye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.38",
            "verseOrgIds": [
              "JHN.9.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anati,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.39",
            "verseOrgIds": [
              "JHN.9.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndinabwera pansi pano kudzaweruza kuti osaona aone ndi openya asaone.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.9.39",
                "verseOrgIds": [
                  "JHN.9.39"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afarisi ena amene anali pafupi naye anamva akunena izi ndipo anafunsa kuti, \"Chiyani? Kodi ndife osaonanso?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.40",
            "verseOrgIds": [
              "JHN.9.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anati,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.41",
            "verseOrgIds": [
              "JHN.9.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mukanakhala osaona, simukanachimwa; koma tsopano popeza mukuti mumaona, ndinu ochimwabe.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.9.41",
                "verseOrgIds": [
                  "JHN.9.41"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
