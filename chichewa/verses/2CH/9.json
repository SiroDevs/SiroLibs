  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "2CH 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mfumu Yayikazi ya ku Seba Ichezera Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu yayikazi ya ku Seba itamva za kutchuka kwa Solomoni, inabwera mu Yerusalemu kudzamuyesa ndi mafunso okhwima. Inafika ndi gulu lalikulu la ngamira zonyamula zokometsera zakudya, golide wambiri, ndi miyala yokongola. Inafika kwa Solomoni ndipo inayankhula naye zonse zimene zinali mu mtima mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.1",
            "verseOrgIds": [
              "2CH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni anayankha mafunso ake onse ndipo panalibe kanthu kalikonse kovuta kwa iye komwe sanathe kufotokozera mfumu yayikaziyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.2",
            "verseOrgIds": [
              "2CH.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu yayikazi ya ku Seba itaona nzeru za Solomoni komanso nyumba yaufumu imene anamanga,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.3",
            "verseOrgIds": [
              "2CH.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "chakudya cha pa tebulo pake, moyo wa antchito ake ndi zovala zawo; atumiki opereka zakumwa ndi zovala zawo ndiponso nsembe zopsereza zimene ankapereka ku Nyumba ya Yehova, inathedwa nzeru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.4",
            "verseOrgIds": [
              "2CH.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo inati kwa mfumu, \"Mbiri imene ndinamva ndili ku dziko kwathu, ya zomwe munachita komanso nzeru zanu ndi yoona.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.5",
            "verseOrgIds": [
              "2CH.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma sindinakhulupirire zimene ankanena mpaka nditafika ndi kuona ndi maso anga. Kunena zoona sanandiwuze ngakhale theka lomwe la kuchuluka kwa nzeru zanu, pakuti zaposa zimene ndinamva.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.6",
            "verseOrgIds": [
              "2CH.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngodala anthu anu! Ngodala atumiki anu amene amayimirira pamaso panu nthawi zonse ndi kumamva nzeru zanu!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.7",
            "verseOrgIds": [
              "2CH.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamandike Yehova Mulungu wanu amene wakondwera nanu nakukhazikani pa mpando wake waufumu kuti mulamulire mʼmalo mwa Yehova Mulungu wanu. Chifukwa cha chikondi cha Mulungu wanu pa Israeli, ndi khumbo lake kuti akusungeni mpaka muyaya, Iye wayika inu kukhala mfumu yawo kuti mulamulire moyenera ndi mwachilungamo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.8",
            "verseOrgIds": [
              "2CH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka iyo inapereka kwa mfumu makilogalamu 4,000 a golide, zonunkhira zambirimbiri ndi miyala yokongola. Nʼkale lomwe sikunaonekenso zonunkhiritsa ngati zomwe mfumu yayikazi ya ku Seba inapereka kwa mfumu Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.9",
            "verseOrgIds": [
              "2CH.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Anthu a Hiramu ndi anthu a Solomoni anabweretsa golide kuchokera ku Ofiri ndipo anabweretsanso mitengo ya mʼbawa ndi miyala yokongola.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.10",
            "verseOrgIds": [
              "2CH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inagwiritsa ntchito mitengo ya mʼbawa pokonzera makwerero a Nyumba ya Yehova ndi nyumba yaufumu ndiponso kupangira anthu oyimba apangwe ndi azeze. Zinthu zonga zimenezi sizinaonekeponso mu Yuda).",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu Solomoni inapereka kwa mfumu yayikazi ya ku Seba zonse zimene inazifuna ndi kuzipempha ndipo Solomoni anayipatsa mfumuyo zoposa zimene iyo inabweretsa kwa Solomoni. Ndipo mfumuyo inabwerera ku dziko lake pamodzi ndi atumiki ake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.12",
            "verseOrgIds": [
              "2CH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ulemerero wa Mfumu Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulemera kwa golide amene Solomoni amalandira pa chaka kunali makilogalamu 23,000,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.13",
            "verseOrgIds": [
              "2CH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "osawerengera amene ankabwera ndi anthu ochita malonda ndi osinthanitsa zinthu. Komanso mafumu onse a ku Arabiya ndi abwanamkubwa a mʼdzikomo amabweretsa golide ndi siliva kwa Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.14",
            "verseOrgIds": [
              "2CH.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu Solomoni inapanga zishango zazikulu 200 zagolide wosasantha. Mʼchishango chilichonse mumalowa golide wolemera makilogalamu asanu ndi awiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.15",
            "verseOrgIds": [
              "2CH.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anapanganso zishango zingʼonozingʼono 300 zagolide wosasantha ndipo chishango chilichonse chimapangidwa ndi golide wolemera makilogalamu atatu. Mfumu inayika zishangozi mʼnyumba yaufumu yotchedwa Nkhalango ya Lebanoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.16",
            "verseOrgIds": [
              "2CH.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mfumu inapanganso mpando waukulu waufumu wa nyanga za njovu ndipo unakutidwa ndi golide woyengeka bwino.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.17",
            "verseOrgIds": [
              "2CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpando waufumuwo unali ndi makwerero asanu ndi limodzi ndi choyikapo mapazi cholumikizidwa ku mpandowo. Mʼmbali zonse za mpandowo munali zosanjikapo manja, ndi chifanizo cha mkango chitayima posanjikapo manjapo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.18",
            "verseOrgIds": [
              "2CH.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikango khumi ndi iwiri inayimirira pa makwerero asanu ndi imodzi aja. Umodzi mbali ina ya khwerero ndi wina mbali inayo. Palibe mpando wonga uwu umene unapangidwapo mu ufumu wina uliwonse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.19",
            "verseOrgIds": [
              "2CH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zikho zonse za mfumu Solomoni zinali zagolide, ndiponso zipangizo zonse za ku nyumba yaufumu ya Nkhalango ya Lebanoni zinali zagolide oyengeka bwino. Panalibe chinthu chopangidwa ndi siliva, chifukwa siliva samayesedwa kanthu mʼnthawi ya Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.20",
            "verseOrgIds": [
              "2CH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inali ndi sitima zambiri zapamadzi zimene zimayendetsedwa ndi antchito a Hiramu. Zimabwera kamodzi pa zaka zitatu zilizonse zitanyamula golide, siliva ndi nyanga za njovu, ndiponso anyani ndi apusi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.21",
            "verseOrgIds": [
              "2CH.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu Solomoni anapambana mafumu ena onse a dziko lapansi pa chuma ndi nzeru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.22",
            "verseOrgIds": [
              "2CH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafumu onse a dziko lapansi ankafunafuna kuonana ndi Solomoni kuti adzamve nzeru zimene Mulungu anayika mu mtima mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.23",
            "verseOrgIds": [
              "2CH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaka ndi chaka, aliyense amene amabwera, amabweretsa mphatso monga zipangizo zasiliva ndi golide, mikanjo, zida zankhondo ndi zokometsera zakudya komanso akavalo ndi abulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.24",
            "verseOrgIds": [
              "2CH.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni anali ndi zipinda 4,000 zodyeramo akavalo ndi magaleta, ndi akavalo 12,000 amene amawasunga mʼmizinda yosungira magaleta ndiponso ena anali ndi iye ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.25",
            "verseOrgIds": [
              "2CH.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ankalamulira mafumu onse kuyambira ku mtsinje wa Yufurate mpaka ku dziko la Afilisti, kukafika ku malire a dziko la Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
              "2CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inasandutsa siliva kukhala wambiri ngati miyala wamba mu Yerusalemu ndipo mikungudza kukhala yochuluka ngati mitengo ya mkuyu ya ku zigwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ankayitanitsa akavalo ake kuchokera ku Igupto ndi mayiko ena onse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
            "verseOrgIds": [
              "2CH.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumwalira kwa Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono ntchito zina zonse za Solomoni, kuyambira pachiyambi mpaka kumaliza, kodi sizinalembedwa mʼbuku la mbiri la mneneri Natani, ndi mʼbuku la uneneri wa Ahiya wa ku Silo ndi mʼbuku la masomphenya a mlosi Ido, lokamba za Yeroboamu mwana wa Nebati?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni analamulira Aisraeli onse ku Yerusalemu zaka makumi anayi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anamwalira nagona ndi makolo ake. Anayikidwa mʼmanda mu mzinda wa Davide abambo ake. Ndipo Rehobowamu, mwana wake, analowa ufumu mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
