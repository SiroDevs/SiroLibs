  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "ZEC 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Choyikapo Nyale cha Golide ndi Mitengo Iwiri ya Olivi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka mngelo amene amayankhula nane anabwerera nandidzutsa, ngati mmene amadzutsira munthu amene ali mʼtulo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.1",
            "verseOrgIds": [
              "ZEC.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anandifunsa kuti, \"Kodi ukuona chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.2",
            "verseOrgIds": [
              "ZEC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 4:2"
      },
      "items": [
        {
          "text": "Ndinayankha kuti, \"Ine ndikuona choyikapo nyale, chonse chagolide ndi mbale pamwamba pake ndi nyale zoyaka zisanu ndi ziwiri, iliyonse ili ndi zibowo zisanu ndi ziwiri zolowetsera zingwe zoyatsira.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.2",
            "verseOrgIds": [
              "ZEC.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiponso pambali pake pali mitengo ya olivi iwiri, umodzi uli kumanja kwa mbaleyo ndipo winawo kumanzere.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.3",
            "verseOrgIds": [
              "ZEC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinamufunsa mngelo amene amayankhula nane kuti, \"Kodi zimenezi nʼchiyani mbuye wanga?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.4",
            "verseOrgIds": [
              "ZEC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anandiyankha kuti, \"Kodi iwe sukuzidziwa zimenezi?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.5",
            "verseOrgIds": [
              "ZEC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 4:5"
      },
      "items": [
        {
          "text": "Ndinayankha kuti, \"Ayi mbuye wanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.5",
            "verseOrgIds": [
              "ZEC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho iye anandiwuza kuti, \"Mawu a Yehova kwa Zerubabeli ndi awa: 'Osati mwa nkhondo kapena ndi mphamvu, koma ndi Mzimu wanga,' akutero Yehova Wamphamvuzonse.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.6",
            "verseOrgIds": [
              "ZEC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi ndiwe yani, iwe phiri lamphamvu? Pamaso pa Zerubabeli udzasanduka dziko losalala. Pamenepo adzabweretsa mwala wotsiriza. Akamadzawuyika pamwamba anthu adzafuwula kuti, 'Mulungu adalitse Nyumbayi! Mulungu adalitse Nyumbayi!' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.7",
            "verseOrgIds": [
              "ZEC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova anayankhulanso nane kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.8",
            "verseOrgIds": [
              "ZEC.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Manja a Zerubabeli ndiwo ayika maziko a Nyumbayi; adzatsiriza ndi manja ake omwewo. Pamenepo iwe udzadziwa kuti Yehova Wamphamvuzonse ndiye anakutuma.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.9",
            "verseOrgIds": [
              "ZEC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndani wanyoza tsiku la zinthu zazingʼono? Anthu adzasangalala akadzaona chingwe choyezera mʼmanja mwa Zerubabeli.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.10",
            "verseOrgIds": [
              "ZEC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 4:10"
      },
      "items": [
        {
          "text": "(\"Nyale zisanu ndi ziwirizi ndi maso a Yehova, amene amayangʼanayangʼana pa dziko lapansi.\")",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.10",
            "verseOrgIds": [
              "ZEC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka ndinafunsa mngelo uja kuti, \"Kodi mitengo ya olivi iwiri ili kumanja ndi kumanzere kwa choyikapo nyalechi ikutanthauza chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.11",
            "verseOrgIds": [
              "ZEC.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinamufunsanso kuti, \"Kodi nthambi ziwiri za mtengo wa olivi zomwe zili pambali pa mipopi yodzera mafuta iwiri yagolide zikutanthauza chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.12",
            "verseOrgIds": [
              "ZEC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anandiyankha kuti, \"Kodi iwe sukuzidziwa zimenezi?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.13",
            "verseOrgIds": [
              "ZEC.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 4:13"
      },
      "items": [
        {
          "text": "Ine ndinati, \"Ayi mbuye wanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.13",
            "verseOrgIds": [
              "ZEC.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho iye anati, \"Amenewa ndi anthu awiri amene adzozedwa kuti atumikire Ambuye pa dziko lonse lapansi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.14",
            "verseOrgIds": [
              "ZEC.4.14"
            ]
          }
        }
      ]
    }
  ],
