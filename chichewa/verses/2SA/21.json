  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "2SA 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agibiyoni Abwezera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi ya ulamuliro wa Davide kunali njala kwa zaka zitatu zotsatana. Kotero Davide anapemphera kwa Yehova. Yehova anati, \"Izi zachitika chifukwa chakuti Sauli ndi banja lake akanali ndi mlandu wakupha Agibiyoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.1",
            "verseOrgIds": [
              "2SA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inayitanitsa Agibiyoni ndipo inayankhula nawo. (Tsono Agibiyoni sanali Aisraeli, koma otsala mwa Aamori. Aisraeli analumbira kuwasiya ndi moyo, koma Sauli chifukwa cha chikondi cha pa Israeli ndi Yuda, anafuna kuwawonongeratu).",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.2",
            "verseOrgIds": [
              "2SA.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anafunsa Agibiyoni kuti, \"Kodi ine ndikuchitireni chiyani? Ndipepese bwanji kuti inu mudalitse cholowa cha Yehova?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.3",
            "verseOrgIds": [
              "2SA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agibiyoni anamuyankha kuti, \"Ife tilibe ufulu woti nʼkulamula Sauli ndi banja lake kuti atipatse siliva kapena golide, tilibenso ufulu woti nʼkupha wina aliyense mu Israeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.4",
            "verseOrgIds": [
              "2SA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 21:4"
      },
      "items": [
        {
          "text": "Davide anafunsa, \"Mukufuna ine ndikuchitireni chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.4",
            "verseOrgIds": [
              "2SA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anayankha mfumu kuti, \"Tsono za munthu amene anatiwononga ndi kukonza chiwembu choti titheretu ndi kukhala wopanda malo mu Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.5",
            "verseOrgIds": [
              "2SA.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mutipatse adzukulu ake aamuna asanu ndi awiri kuti tiwaphe ndi kuwapereka pamaso pa Yehova ku Gibeya wa Sauli, wosankhidwa wa Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 21:6"
      },
      "items": [
        {
          "text": "Choncho mfumu inati, \"Ine ndidzakupatsani.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mfumu inasunga Mefiboseti mwana wa Yonatani, mwana wa Sauli, chifukwa cha kulumbira kumene mfumu Davide ndi Yonatani mwana wa Sauli anachita pamaso pa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.7",
            "verseOrgIds": [
              "2SA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mfumu inatenga Arimoni ndi Mefiboseti, ana aamuna awiri a Rizipa, mwana wamkazi wa Ayiwa, amene anaberekera Sauli pamodzi ndi ana asanu a Merabi mwana wamkazi wa Sauli, amene anabereka Adirieli mwana wa Barizilai Mmeholati.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.8",
            "verseOrgIds": [
              "2SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anawapereka kwa anthu a ku Gibiyoni, amene anawapha nawayika pa phiri la Yehova. Onse asanu ndi awiri anafera limodzi. Iwo anaphedwa masiku oyamba kukolola barele.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.9",
            "verseOrgIds": [
              "2SA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rizipa mwana wamkazi wa Ayiwa anatenga chiguduli ndi kudziyalira pa mwala (pamene panali mitemboyo). Kuyambira nthawi yoyamba kukolola mpaka pamene mvula inayambanso kugwa, iye sanalole kuti mbalame zikhudze mitemboyo masana kapena nyama zakuthengo usiku.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.10",
            "verseOrgIds": [
              "2SA.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide atawuzidwa zimene Rizipa mwana wamkazi wa Ayiwa, mzikazi wa Sauli anachita,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.11",
            "verseOrgIds": [
              "2SA.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "anapita kukatenga mafupa a Sauli ndi mwana wake Yonatani kwa anthu a ku Yabesi Giliyadi (iwo anawatenga mwamseri kuchoka pabwalo la ku Beti-Sani, kumene Afilisti anawapachika atapha Sauli ku Gilibowa).",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.12",
            "verseOrgIds": [
              "2SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anakatenga mafupa a Sauli ndi mwana wake Yonatani kumeneko ndiponso mafupa otayidwa a amene anaphedwa nawasonkhanitsa pamodzi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.13",
            "verseOrgIds": [
              "2SA.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anayika mafupa a Sauli ndi mwana wake Yonatani mʼmanda a Kisi abambo ake a Sauli ku Zera mʼdziko la Benjamini, ndipo anachita zonse zimene mfumu inalamula. Atachita zimenezi, Mulungu anayankha pemphero lopempherera dzikolo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.14",
            "verseOrgIds": [
              "2SA.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkhondo ndi Afilisti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi inanso panali nkhondo pakati pa Afilisti ndi Aisraeli, Davide anapita ndi ankhondo ake kukamenyana ndi Afilisti ndipo iye anatopa kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.15",
            "verseOrgIds": [
              "2SA.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Isibi-Benobi, mmodzi mwa zidzukulu za Rafa, amene mkondo wake unkalemera makilogalamu atatu ndi theka ndipo analinso ndi lupanga latsopano, anati adzapha Davide.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.16",
            "verseOrgIds": [
              "2SA.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Abisai mwana wa Zeruya anabwera kudzapulumutsa Davide. Iye anamukantha Mfilisitiyo ndi kumupha. Pamenepo asilikali a Davide analumbira kwa iye kuti, \"Inu simudzapita nafenso ku nkhondo, kuti nyale ya Israeli isadzazimitsidwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.17",
            "verseOrgIds": [
              "2SA.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patapita nthawi, panali nkhondo ina ndi Afilisti ku Gobu. Pa nthawi imeneyo Sibekai Mhusati anapha Safu, mmodzi mwa zidzukulu za Arefai.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.18",
            "verseOrgIds": [
              "2SA.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nkhondo inanso ndi Afilisti ku Gobu, Elihanani mwana wa Yaare-Oregimu wa ku Betelehemu anapha Goliati Mgiti, amene anali ndi mkondo ngati ndodo yowombera nsalu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
            "verseOrgIds": [
              "2SA.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nkhondo inanso imene inachitika ku Gati panali munthu wina wamtali kwambiri wa zala zisanu ndi chimodzi mʼmanja ndi mʼmapazi ndipo zonse pamodzi zinalipo 24. Iyenso anali chidzukulu cha Rafa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.20",
            "verseOrgIds": [
              "2SA.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene iye ankanyoza Aisraeli, Yonatani mwana wa Simea, mʼbale wake wa Davide anamupha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.21",
            "verseOrgIds": [
              "2SA.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu anayi amenewa anali zidzukulu za Rafa ku Gati, ndipo onse anaphedwa ndi Davide ndi ankhondo ake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.22",
            "verseOrgIds": [
              "2SA.21.22"
            ]
          }
        }
      ]
    }
  ],
