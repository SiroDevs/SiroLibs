  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "1CH 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Magulu a Anthu Ankhondo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwu ndi mndandanda wa Aisraeli, atsogoleri a mabanja, olamulira asilikali 1,000, olamulira asilikali 100 ndi akuluakulu awo, amene ankatumikira mfumu mʼzonse zokhudza magulu a ankhondo, amene amagwira ntchito mwezi ndi mwezi chaka chonse. Gulu lililonse linali ndi anthu 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.1",
            "verseOrgIds": [
              "1CH.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amene amalamulira gulu loyamba pa mwezi woyamba anali Yasobeamu mwana wa Zabidieli. Pa gulu lake panali asilikali 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.2",
            "verseOrgIds": [
              "1CH.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyeyu anali chidzukulu cha Perezi ndipo anali mkulu wa atsogoleri onse a ankhondo mwezi woyamba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.3",
            "verseOrgIds": [
              "1CH.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amene amalamulira gulu lachiwiri pa mwezi wachiwiri anali Dodai Mwahohi; Mikiloti ndiye anali mtsogoleri wa gulu lake. Pa gulu lake panali asilikali 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.4",
            "verseOrgIds": [
              "1CH.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wolamulira ankhondo wachitatu, pa mwezi wachitatu anali Benaya, mwana wa wansembe Yehoyada. Iye anali mtsogoleri ndipo pa gulu lake panali ankhondo 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.5",
            "verseOrgIds": [
              "1CH.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu ndi Benaya uja amene anali wamphamvu pa gulu la anthu makumi atatu ndipo ndiye amatsogolera anthu makumi atatu aja. Mwana wake Amizabadi ndiye amatsogolera gulu lake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.6",
            "verseOrgIds": [
              "1CH.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wachinayi pa mwezi wachinayi anali Asaheli mʼbale wake wa Yowabu; ndipo mwana wake Zebadiya ndiye analowa mʼmalo mwake. Pa gulu lake panali asilikali 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.7",
            "verseOrgIds": [
              "1CH.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wachisanu pa mwezi wachisanu anali Samihuti, mdzukulu wa Izira. Pa gulu lake panali asilikali 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.8",
            "verseOrgIds": [
              "1CH.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa 6 pa mwezi wa 6 anali Ira mwana wa Ikesi wa ku Tekowa. Pa gulu lake panali asilikali 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.9",
            "verseOrgIds": [
              "1CH.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa 7 pa mwezi wa 7 anali Helezi Mpeloni wa fuko la Efereimu. Pa gulu lake panali asilikali 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.10",
            "verseOrgIds": [
              "1CH.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa 8 pa mwezi wa 8 anali Sibekai Mhusati, wa mbumba ya Zera. Pa gulu lake panali asilikali 24,000",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.11",
            "verseOrgIds": [
              "1CH.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa 9 pa mwezi wa 9 anali Abiezeri wa banja la Anatoti, wa fuko la Benjamini. Pa gulu lake panali asilikali 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.12",
            "verseOrgIds": [
              "1CH.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa khumi pa mwezi wa khumi anali Mahazayi wa ku Netofa, wa mbumba ya Zera. Pa gulu lake panali asilikali 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.13",
            "verseOrgIds": [
              "1CH.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtsogoleri wa 11, pa mwezi wa 11 anali Benaya wa ku Piratoni, wa fuko la Efereimu. Pa gulu lake panali asilikali 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.14",
            "verseOrgIds": [
              "1CH.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtsogoleri wa 12, pa mwezi wa 12 anali Helidai Mnetofa, wa banja la Otanieli. Pa gulu lake panali asilikali 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.15",
            "verseOrgIds": [
              "1CH.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akuluakulu a Mafuko a Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuluakulu amene amatsogolera mafuko a Israeli ndi awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.16",
            "verseOrgIds": [
              "1CH.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 27:16"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:16"
      },
      "items": [
        {
          "text": "Mtsogoleri wa fuko la Rubeni: Eliezara mwana wa Zikiri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.16",
            "verseOrgIds": [
              "1CH.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:16"
      },
      "items": [
        {
          "text": "mtsogoleri wa fuko la Simeoni: Sefatiya mwana wa Maaka;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.16",
            "verseOrgIds": [
              "1CH.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mtsogoleri wa fuko la Levi: Hasabiya mwana wa Kemueli,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.17",
            "verseOrgIds": [
              "1CH.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:17"
      },
      "items": [
        {
          "text": "mtsogoleri wa banja la Aaroni: Zadoki;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.17",
            "verseOrgIds": [
              "1CH.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mtsogoleri wa fuko la Yuda: Elihu, mʼbale wake wa Davide;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.18",
            "verseOrgIds": [
              "1CH.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:18"
      },
      "items": [
        {
          "text": "mtsogoleri wa fuko la Isakara: Omuri mwana wa Mikayeli;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.18",
            "verseOrgIds": [
              "1CH.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mtsogoleri wa fuko la Zebuloni: Isimaiya mwana wa Obadiya;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.19",
            "verseOrgIds": [
              "1CH.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:19"
      },
      "items": [
        {
          "text": "mtsogoleri wa fuko la Nafutali: Yerimoti mwana wa Azirieli;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.19",
            "verseOrgIds": [
              "1CH.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mtsogoleri wa fuko la Efereimu: Hoseya mwana wa Azaziya;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.20",
            "verseOrgIds": [
              "1CH.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:20"
      },
      "items": [
        {
          "text": "mtsogoleri wa fuko la theka la Manase: Yoweli mwana wa Pedaya;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.20",
            "verseOrgIds": [
              "1CH.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mtsogoleri wa fuko la theka la Manase limene linali ku Giliyadi: Ido mwana wa Zekariya;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.21",
            "verseOrgIds": [
              "1CH.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:21"
      },
      "items": [
        {
          "text": "mtsogoleri wa fuko la Benjamini: Yaasieli mwana wa Abineri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.21",
            "verseOrgIds": [
              "1CH.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "mtsogoleri wa fuko la Dani: Azareli mwana wa Yerohamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.22",
            "verseOrgIds": [
              "1CH.27.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 27:22"
      },
      "items": [
        {
          "text": "Awa anali akuluakulu a mafuko a Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.22",
            "verseOrgIds": [
              "1CH.27.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide sanawerenge amuna amene anali ndi zaka makumi awiri kapena kucheperapo, chifukwa Yehova analonjeza kuti adzachulukitsa Aisraeli ngati nyenyezi zamumlengalenga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabu mwana wa Zeruya anayamba kuwerenga amuna koma sanamalize. Mkwiyo unagwera Aisraeli chifukwa cha zimenezi ndipo chiwerengerochi sanachilowetse mʼbuku la mbiri ya mfumu Davide.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Anthu Oyangʼanira Chuma cha Mfumu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azimaveti mwana wa Adieli ankayangʼanira nyumba zosungiramo katundu wa mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.25",
            "verseOrgIds": [
              "1CH.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 27:25"
      },
      "items": [
        {
          "text": "Yonatani mwana wa Uziya ankayangʼanira nyumba zosungiramo katundu wa maboma ozungulira, mizinda, midzi ndi malo olondera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.25",
            "verseOrgIds": [
              "1CH.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eziri mwana wa Kelubi ankayangʼanira anthu ogwira ntchito yolima ku munda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.26",
            "verseOrgIds": [
              "1CH.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simei wa ku Rama ankayangʼanira minda ya mpesa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.27",
            "verseOrgIds": [
              "1CH.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 27:27"
      },
      "items": [
        {
          "text": "Zabidi wa ku Sifamu ankayangʼanira mphesa ndi mosungiramo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.27",
            "verseOrgIds": [
              "1CH.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baala-Hanani wa ku Gederi ankayangʼanira mitengo ya olivi ndi ya mikuyu ya ku Sefela.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.28",
            "verseOrgIds": [
              "1CH.27.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 27:28"
      },
      "items": [
        {
          "text": "Yowasi ankayangʼanira mafuta a Olivi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.28",
            "verseOrgIds": [
              "1CH.27.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sitirayi wa ku Saroni ankayangʼanira ziweto zimene amaweta ku Saroni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.29",
            "verseOrgIds": [
              "1CH.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 27:29"
      },
      "items": [
        {
          "text": "Safati mwana wa Adilayi ankayangʼanira ngʼombe zakuzigwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.29",
            "verseOrgIds": [
              "1CH.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obili Mwismaeli ankayangʼanira ngamira.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.30",
            "verseOrgIds": [
              "1CH.27.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 27:30"
      },
      "items": [
        {
          "text": "Yehideya Mmerenoti ankayangʼanira abulu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.30",
            "verseOrgIds": [
              "1CH.27.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yazizi Mhagiri akayangʼanira nkhosa ndi mbuzi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
            "verseOrgIds": [
              "1CH.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 27:31"
      },
      "items": [
        {
          "text": "Onsewa anali akuluakulu oyangʼanira chuma cha mfumu Davide.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
            "verseOrgIds": [
              "1CH.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonatani, malume wake wa Davide, anali phungu wake ndipo anali munthu wanzeru komanso analinso mlembi. Yehieli mwana wa Hakimoni ankasamalira ana a mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.32",
            "verseOrgIds": [
              "1CH.27.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitofele anali phungu wa mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
            "verseOrgIds": [
              "1CH.27.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 27:33"
      },
      "items": [
        {
          "text": "Husai Mwariki anali bwenzi la mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
            "verseOrgIds": [
              "1CH.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitofele atamwalira mʼmalo mwake munalowa Yehoyada mwana wa Benaya ndi Abiatara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.34",
            "verseOrgIds": [
              "1CH.27.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 27:34"
      },
      "items": [
        {
          "text": "Yowabu anali mtsogoleri wa gulu lankhondo la mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.34",
            "verseOrgIds": [
              "1CH.27.34"
            ]
          }
        }
      ]
    }
  ],
