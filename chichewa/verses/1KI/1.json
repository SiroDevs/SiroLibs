  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1KI 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adoniya Adziyika Kukhala Mfumu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu Davide atakalamba sankamva kufunda ngakhale akamufunditsa mabulangeti.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.1",
            "verseOrgIds": [
              "1KI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho nduna zake zinamuwuza kuti, \"Tiloleni tifune namwali woti azikhala nanu ndi kumakusamalirani. Namwaliyo azigona pafupi nanu kuti mbuye wathu mfumu muzimva kufundira.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.2",
            "verseOrgIds": [
              "1KI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero anafunafuna mʼdziko lonse la Israeli mtsikana wokongola ndipo anapeza Abisagi wa ku Sunemu, nabwera naye kwa mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.3",
            "verseOrgIds": [
              "1KI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtsikanayo anali wokongola kwambiri ndipo ankasamalira mfumu ndi kumayitumikira, koma mfumuyo sinakhale naye malo amodzi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.4",
            "verseOrgIds": [
              "1KI.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi imeneyi Adoniya, mwana wa Hagiti, anayamba kudzitukumula ndipo anati, \"Ndidzakhala mfumu ndine.\" Choncho anadzikonzera galeta ndi akavalo, pamodzi ndi anthu 50 woti azithamanga patsogolo pake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.5",
            "verseOrgIds": [
              "1KI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Abambo ake sanalowererepo nʼkamodzi komwe ndipo sanafunsepo kuti, \"Nʼchifukwa chiyani ukuchita zimenezi?\" Adoniyayo anali wokongola kwambiri ndipo anali wopondana ndi Abisalomu).",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.6",
            "verseOrgIds": [
              "1KI.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoniya anagwirizana ndi Yowabu mwana wa Zeruya ndiponso Abiatara wansembe, ndipo iwowa anamuthandiza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.7",
            "verseOrgIds": [
              "1KI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Zadoki wansembe, Benaya mwana wa Yehoyada, mneneri Natani, Simei ndi Rei ndiponso asilikali amphamvu a Davide sanamutsate Adoniya uja.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.8",
            "verseOrgIds": [
              "1KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Adoniya anapereka nsembe za nkhosa ndi ngʼombe ndiponso ana angʼombe onenepa ku Mwala wa Zohereti kufupi ndi Eni Rogeli. Iye anayitana abale ake onse, ana aamuna a mfumu ndiponso akuluakulu onse a ku Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.9",
            "verseOrgIds": [
              "1KI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma sanayitane mneneri Natani kapena Benaya kapenanso asilikali amphamvu a Davide ngakhalenso mʼbale wake Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.10",
            "verseOrgIds": [
              "1KI.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Natani anafunsa Batiseba, amayi ake a Solomoni, kuti, \"Kodi simunamve kuti Adoniya, mwana wa Hagiti, walowa ufumu popanda Davide mbuye wathu kudziwa?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.11",
            "verseOrgIds": [
              "1KI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano ine ndikulangizeni inu mmene mungapulumutsire moyo wanu ndi moyo wa mwana wanu Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.12",
            "verseOrgIds": [
              "1KI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pitani msanga kwa Mfumu Davide ndipo mukanene kuti, 'Mbuye wanga mfumu, kodi simunalumbire kwa ine mdzakazi wanu kuti, 'Ndithu mwana wako Solomoni ndiye adzakhale mfumu mʼmalo mwanga, ndipo adzakhala pa mpando wanga waufumu?' Nanga nʼchifukwa chiyani Adoniya walowa ufumu?'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.13",
            "verseOrgIds": [
              "1KI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene inu muzikayankhula ndi mfumu, ine ndidzalowa ndi kuchitira umboni mawu anuwo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.14",
            "verseOrgIds": [
              "1KI.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Batiseba anapita nakalowa ku chipinda kukaonana ndi mfumu imene inali itakalamba kwambiri, kumene Abisagi wa ku Sunemu uja ankayisamalira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.15",
            "verseOrgIds": [
              "1KI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batiseba anagwada nalambira mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.16",
            "verseOrgIds": [
              "1KI.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 1:16"
      },
      "items": [
        {
          "text": "Mfumu inamufunsa kuti, \"Kodi nʼchiyani chimene ukufuna?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.16",
            "verseOrgIds": [
              "1KI.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayankha kuti, \"Mbuye wanga, inu mwini munalumbira kwa ine mdzakazi wanu mʼdzina la Yehova Mulungu wanu kuti, 'Solomoni mwana wako ndiye adzakhale mfumu mʼmalo mwa ine, ndipo adzakhala pa mpando wanga waufumu.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.17",
            "verseOrgIds": [
              "1KI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma tsopano Adoniya ndiye walowa ufumu, ndipo inu mbuye wanga mfumu, simukuzidziwa zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.18",
            "verseOrgIds": [
              "1KI.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo wapereka nsembe ngʼombe zambiri, ana angʼombe onenepa ndi nkhosa ndi mbuzi ndipo wayitana ana anu onse, wansembe Abiatara ndiponso Yowabu mkulu wa ankhondo, koma sanayitane kapolo wanu Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.19",
            "verseOrgIds": [
              "1KI.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuye wanga mfumu, maso a Aisraeli onse ali pa inu, kuti adziwe kuchokera kwa inu amene adzakhala pa mpando waufumu wa mbuye wanga mʼmalo mwanu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.20",
            "verseOrgIds": [
              "1KI.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukapanda kutero, mbuye wanga, mukadzangotisiya nʼkulondola kumene kunapita makolo anu, ine pamodzi ndi mwana wangayu Solomoni adzatiyesa owukira.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.21",
            "verseOrgIds": [
              "1KI.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Batiseba amayankhula ndi mfumu, mneneri Natani analowa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.22",
            "verseOrgIds": [
              "1KI.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anthu anawuza mfumu kuti, \"Kwabwera mneneri Natani.\" Kotero iye anafika pamaso pa mfumu ndipo anawerama nagunditsa nkhope yake pansi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.23",
            "verseOrgIds": [
              "1KI.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natani anafunsa kuti, \"Mbuye wanga mfumu, kodi mwalengeza kuti Adoniya adzakhala mfumu mʼmalo mwanu, ndi kuti adzakhala pa mpando wanu waufumu?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.24",
            "verseOrgIds": [
              "1KI.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lero lomwe lino wakapereka nsembe ngʼombe zambiri, ana angʼombe onenepa ndiponso nkhosa ndi mbuzi. Iye wayitana ana anu onse, atsogoleri a nkhondo, ndiponso wansembe Abiatara. Panopa onsewa akudya ndi kumwa naye ndipo akunena kuti, 'Akhale ndi moyo wautali mfumu Adoniya!'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.25",
            "verseOrgIds": [
              "1KI.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ine kapolo wanu, wansembe Zadoki ndi Benaya mwana wa Yehoyada, ndiponso kapolo wanu Solomoni sanatiyitane.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.26",
            "verseOrgIds": [
              "1KI.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi zimenezi mbuye wanga mfumu mwazichita ndinu, osawawuza atumiki anu kuti adziwe amene adzakhale pa mpando waufumu mʼmalo mwanu?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.27",
            "verseOrgIds": [
              "1KI.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Davide Alonga Ufumu Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo mfumu Davide anati, \"Muyitaneni Batiseba.\" Kotero Batiseba analowa ndipo anayimirira pamaso pa mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.28",
            "verseOrgIds": [
              "1KI.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono mfumu inalumbira kuti, \"Pali Yehova wamoyo, amene anandipulumutsa ine ku mavuto onse,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.29",
            "verseOrgIds": [
              "1KI.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndithu ine lero ndichita zonse zimene ndinalumbira kwa Yehova Mulungu wa Israeli kuti, mwana wako Solomoni adzakhala mfumu mʼmalo mwanga ndipo adzakhala pa mpando wanga waufumu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.30",
            "verseOrgIds": [
              "1KI.1.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Batiseba anawerama, nagunditsa mutu wake pansi nalambira mfumu, ndipo anati, \"Mbuye wanga Mfumu Davide mukhale ndi moyo wautali!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.31",
            "verseOrgIds": [
              "1KI.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu Davide anati, \"Ndiyitanireni wansembe Zadoki, mneneri Natani ndi Benaya mwana wa Yehoyada.\" Atafika pamaso pa mfumu,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.32",
            "verseOrgIds": [
              "1KI.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "mfumuyo inati kwa iwo, \"Tengani atumiki anga ndipo mukweze mwana wanga Solomoni pa bulu wanga ndipo mupite naye ku Gihoni. Mukalize lipenga ndi kufuwula kuti, 'Akhale ndi moyo wautali mfumu Solomoni!'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.33",
            "verseOrgIds": [
              "1KI.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumeneko Zadoki wansembe ndi mneneri Natani akamudzoze kuti akhale mfumu ya Israeli. Kenaka mukalize lipenga ndi kumanena kuti 'Akhale ndi moyo wautali Mfumu Solomoni.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.34",
            "verseOrgIds": [
              "1KI.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo pobwera muzikamutsata pambuyo. Iyeyo akabwere kuno ndi kudzakhala pa mpando wanga waufumu ndi kudzalamulira mʼmalo mwanga. Ndamusankha kukhala wolamulira Israeli ndi Yuda.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.35",
            "verseOrgIds": [
              "1KI.1.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya mwana wa Yehoyada anayankha mfumu kuti, \"Ameni! Yehova Mulungu wa mbuye wanga mfumu akhazikitse kuti zichitike motero.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.36",
            "verseOrgIds": [
              "1KI.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga momwe Yehova wakhalira ndi inu mbuye wanga mfumu, momwemonso akhale ndi Solomoni ndi kukhazikitsa ufumu wake kuti ukhale waukulu kuposa ufumu wa mbuye wanga Mfumu Davide!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.37",
            "verseOrgIds": [
              "1KI.1.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero Zadoki wansembe, mneneri Natani, Benaya mwana wa Yehoyada, Akereti ndiponso Apeleti, anthu oteteza mfumu, anapita kukamukweza Solomoni pa bulu wa Mfumu Davide ndi kupita naye ku Gihoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.38",
            "verseOrgIds": [
              "1KI.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wansembe Zadoki anatenga nyanga ya mafuta yochokera ku malo opatulika ndi kumudzoza Solomoni. Kenaka analiza lipenga ndipo anthu onse anafuwula kuti, \"Akhale ndi moyo wautali Mfumu Solomoni!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.39",
            "verseOrgIds": [
              "1KI.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anthu onsewo anapita namutsatira pambuyo akuyimba zitoliro ndi kukondwerera kwambiri, kotero nthaka inagwedezeka chifukwa cha phokoso lawo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.40",
            "verseOrgIds": [
              "1KI.1.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoniya pamodzi ndi anthu onse oyitanidwa amene anali naye anamva zimenezi pamene ankamaliza madyerero awo. Atamva kulira kwa malipenga, Yowabu anafunsa kuti, \"Kodi phokoso lonselo mu mzindamo likutanthauza chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.41",
            "verseOrgIds": [
              "1KI.1.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akuyankhula, Yonatani mwana wa wansembe Abiatara anafika. Adoniya anati, \"Lowa. Munthu wabwino ngati iwe ayenera kubweretsa nkhani yabwino.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.42",
            "verseOrgIds": [
              "1KI.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonatani anayankha Adoniya kuti, \"Ayi ndithu, zinthu sizili bwino! Mbuye wathu Mfumu Davide walonga Solomoni ufumu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.43",
            "verseOrgIds": [
              "1KI.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu yatuma Zadoki wansembe, mneneri Natani, Benaya mwana wa Yehoyada, Akereti ndi Apeleti ku Gihoni ndipo iwo amukweza pa bulu wa mfumu,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.44",
            "verseOrgIds": [
              "1KI.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo Zadoki wansembe ndi mneneri Natani adzoza Solomoni ku Gihoni kuti akhale mfumu. Ndipo kuchokera kumeneko akhala akululutira, kotero kuti mu mzinda monse muli phokoso lokhalokha. Ndiyetu phokoso limene mukulimvalo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.45",
            "verseOrgIds": [
              "1KI.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Solomoni wakhala kale pa mpando wake waufumu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.46",
            "verseOrgIds": [
              "1KI.1.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwonjezera pamenepo, nduna za mfumu zabwera kale kudzayamika mbuye wathu Mfumu Davide, pomanena kuti, 'Mulungu wanu atchukitse dzina la Solomoni kuposa dzina lanu ndipo ufumu wake ukule kupambana ufumu wanu!' Ndipo mfumu inawerama niyamba kupembedza pa bedi lake,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.47",
            "verseOrgIds": [
              "1KI.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "inati, 'Atamandike Yehova, Mulungu wa Israeli, amene wasankha wolowa mʼmalo mwanga ine ndikanali ndi moyo lero lino.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.48",
            "verseOrgIds": [
              "1KI.1.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu onse amene Adoniya anawayitana ananjenjemera ndi mantha, ndipo anayimirira, kenaka anamwazikana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.49",
            "verseOrgIds": [
              "1KI.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Adoniya, poopa Solomoni, anapita ku Nyumba ya Mulungu nakagwira msonga za guwa lansembe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.50",
            "verseOrgIds": [
              "1KI.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1KI 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Solomoni anawuzidwa kuti, \"Adoniya akukuopani inu Mfumu Solomoni ndipo wagwira msonga za guwa lansembe. Iye akuti, 'Mfumu Solomoni alumbire kuti sadzapha kapolo wake ndi lupanga.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.51",
            "verseOrgIds": [
              "1KI.1.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1KI 1:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni anayankha kuti, \"Ngati iyeyo aonetse kuti ndi munthu wakhalidwe labwino, ngakhale tsitsi la mʼmutu mwake silidzathothoka ndi kugwera pansi, koma akapezeka kuti ali ndi khalidwe loyipa, adzafa ndithu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.52",
            "verseOrgIds": [
              "1KI.1.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1KI 1:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Mfumu Solomoni inatuma anthu ndipo anakamutenga paguwa paja. Adoniya anabwera ndi kudzalambira Mfumu Solomoni, ndipo Solomoni anati, \"Pita ku nyumba yako.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.53",
            "verseOrgIds": [
              "1KI.1.53"
            ]
          }
        }
      ]
    }
  ],
