      },
      "items": [
        {
          "text": "Ulemerero wa Yehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 40:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka mtambo unaphimba tenti ya msonkhano, ndipo ulemerero wa Yehova unadzaza mʼchihemacho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.34",
            "verseOrgIds": [
              "EXO.40.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 40:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sanathe kulowa mu tenti ya msonkhano chifukwa mtambo unali utakhazikika pa chihemacho, ndipo ulemerero wa Yehova unadzaza mʼchihemacho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.35",
            "verseOrgIds": [
              "EXO.40.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 40:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa maulendo awo onse, mtambo ukachoka pamwamba pa chihema, Aisraeli ankasamukanso pamene analipo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.36",
            "verseOrgIds": [
              "EXO.40.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 40:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ngati mtambo sunachoke, iwo sankasamukanso mpaka tsiku limene udzachoke.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.37",
            "verseOrgIds": [
              "EXO.40.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 40:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero mtambo wa Yehova unkakhala pamwamba pa chihema usana, ndi mtambo wamoto umakhala usiku, pamaso pa nyumba yonse ya Israeli pa masiku onse aulendo wawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.38",
            "verseOrgIds": [
              "EXO.40.38"
            ]
          }
        }
      ]
    }
