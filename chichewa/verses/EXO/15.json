        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyimbo ya Mose ndi Miriamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mose ndi Aisraeli anayimbira Yehova nyimbo iyi:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:1"
      },
      "items": [
        {
          "text": "\"Ine ndidzayimbira Yehova",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:1"
      },
      "items": [
        {
          "text": "pakuti wakwezeka mʼchigonjetso.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:1"
      },
      "items": [
        {
          "text": "Kavalo ndi wokwera wake,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:1"
      },
      "items": [
        {
          "text": "Iye wawaponya mʼnyanja.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ndiye mphamvu yanga ndi nyimbo yanga;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:2"
      },
      "items": [
        {
          "text": "ndiye chipulumutso changa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:2"
      },
      "items": [
        {
          "text": "Iye ndiye Mulungu wanga, ndipo ndidzamutamanda,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:2"
      },
      "items": [
        {
          "text": "Mulungu wa makolo anga, ine ndidzamukweza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ndi wankhondo;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.3",
            "verseOrgIds": [
              "EXO.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:3"
      },
      "items": [
        {
          "text": "Yehova ndilo dzina lake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.3",
            "verseOrgIds": [
              "EXO.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaleta a Farao ndi asilikali ake ankhondo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.4",
            "verseOrgIds": [
              "EXO.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:4"
      },
      "items": [
        {
          "text": "Iye wawaponya mʼnyanja.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.4",
            "verseOrgIds": [
              "EXO.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:4"
      },
      "items": [
        {
          "text": "Akatswiri ankhondo amphamvu a Farao",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.4",
            "verseOrgIds": [
              "EXO.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:4"
      },
      "items": [
        {
          "text": "amizidwa mʼNyanja Yofiira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.4",
            "verseOrgIds": [
              "EXO.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyanja yakuya inawaphimba;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.5",
            "verseOrgIds": [
              "EXO.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:5"
      },
      "items": [
        {
          "text": "Iwo anamira pansi ngati mwala.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.5",
            "verseOrgIds": [
              "EXO.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova, dzanja lanu lamanja",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.6",
            "verseOrgIds": [
              "EXO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:6"
      },
      "items": [
        {
          "text": "ndi laulemerero chifukwa cha mphamvu zake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.6",
            "verseOrgIds": [
              "EXO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:6"
      },
      "items": [
        {
          "text": "Ndithu Yehova, dzanja lanu lamanja",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.6",
            "verseOrgIds": [
              "EXO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:6"
      },
      "items": [
        {
          "text": "linaphwanya mdani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.6",
            "verseOrgIds": [
              "EXO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi ulemerero wanu waukulu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.7",
            "verseOrgIds": [
              "EXO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:7"
      },
      "items": [
        {
          "text": "munagonjetsa okutsutsani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.7",
            "verseOrgIds": [
              "EXO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:7"
      },
      "items": [
        {
          "text": "Inu munatumiza mkwiyo wanu waukulu;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.7",
            "verseOrgIds": [
              "EXO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:7"
      },
      "items": [
        {
          "text": "ndipo unawapsereza ngati udzu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.7",
            "verseOrgIds": [
              "EXO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi mpweya wotuluka mʼmphuno mwanu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.8",
            "verseOrgIds": [
              "EXO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:8"
      },
      "items": [
        {
          "text": "madzi anawunjikana pamodzi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.8",
            "verseOrgIds": [
              "EXO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:8"
      },
      "items": [
        {
          "text": "Nyanja yakuya ija inasanduka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.8",
            "verseOrgIds": [
              "EXO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:8"
      },
      "items": [
        {
          "text": "madzi owuma gwaa kufika pansi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.8",
            "verseOrgIds": [
              "EXO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mdaniyo anati,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:9"
      },
      "items": [
        {
          "text": "\"Ine ndidzawalondola, ndipo ndidzawagwira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:9"
      },
      "items": [
        {
          "text": "Ndidzagawa chuma chawo;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:9"
      },
      "items": [
        {
          "text": "ndiye chokhumba changa chidzakwaniritsidwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:9"
      },
      "items": [
        {
          "text": "Ine ndidzasolola lupanga langa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:9"
      },
      "items": [
        {
          "text": "ndi mkono wanga ndidzawawononga.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Inu munawuzira mphepo yanu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.10",
            "verseOrgIds": [
              "EXO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:10"
      },
      "items": [
        {
          "text": "ndipo nyanja inawaphimba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.10",
            "verseOrgIds": [
              "EXO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:10"
      },
      "items": [
        {
          "text": "Iwo anamira ngati chitsulo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.10",
            "verseOrgIds": [
              "EXO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:10"
      },
      "items": [
        {
          "text": "mʼmadzi amphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.10",
            "verseOrgIds": [
              "EXO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithu Yehova, pakati pa milungu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.11",
            "verseOrgIds": [
              "EXO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:11"
      },
      "items": [
        {
          "text": "ndani afanana nanu? Inu amene muli woyera,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.11",
            "verseOrgIds": [
              "EXO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q3",
        "vid": "EXO 15:11"
      },
      "items": [
        {
          "text": "ndiponso wotamandika wolemekezeka,",
          "type": "text"
        }
      ]
    },
