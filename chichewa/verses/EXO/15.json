          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onse agwidwa ndi mantha woopsa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.16",
            "verseOrgIds": [
              "EXO.15.16"
            ]
