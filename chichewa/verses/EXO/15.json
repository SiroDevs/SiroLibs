      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:17"
      },
      "items": [
        {
          "text": "pa phiri lanu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.17",
            "verseOrgIds": [
              "EXO.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:17"
      },
      "items": [
        {
          "text": "Pa malo pamene Inu Yehova munawapanga kuti muzikhalapo;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.17",
            "verseOrgIds": [
              "EXO.15.17"
            ]
          }
        }
      ]
    },
    {
