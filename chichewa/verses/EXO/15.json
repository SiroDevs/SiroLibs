    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:16"
      },
      "items": [
        {
          "text": "Popeza anaona mphamvu zanu zazikulu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.16",
            "verseOrgIds": [
              "EXO.15.16"
            ]
          }
        }
      ]
    },
    {
