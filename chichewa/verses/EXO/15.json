      "attrs": {
        "style": "q2",
        "vid": "EXO 15:16"
      },
      "items": [
        {
          "text": "inde mpaka atadutsa anthu amene munawagula.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.16",
            "verseOrgIds": [
              "EXO.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
