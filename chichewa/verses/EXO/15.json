      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:16"
      },
      "items": [
        {
          "text": "iwo ayima chilili ngati mwala mpaka anthu anu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.16",
            "verseOrgIds": [
              "EXO.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:16"
      },
      "items": [
        {
          "text": "Inu Yehova atadutsa;",
