          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mudzawalowetsa ndi kuwakhazikitsa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.17",
            "verseOrgIds": [
              "EXO.15.17"
            ]
          }
        }
      ]
    },
    {
