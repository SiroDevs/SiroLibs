  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "EXO 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Fano la Mwana Wangʼombe Wagolide",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu ataona kuti Mose akuchedwa kutsika mʼphiri, anasonkhana kwa Aaroni ndipo anati, \"Bwera utipangire milungu imene idzititsogolera. Kunena za Mose amene anatitulutsa mʼdziko la Igupto, sitikudziwa chimene chamuchitikira.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.1",
            "verseOrgIds": [
              "EXO.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni anawayankha kuti, \"Vulani ndolo zagolide zimene avala akazi anu, ana anu aamuna ndi aakazi ndipo muzibweretse kwa ine.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.2",
            "verseOrgIds": [
              "EXO.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero anthu onse anavula ndolo zagolide ndi kubwera nazo kwa Aaroni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.3",
            "verseOrgIds": [
              "EXO.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Aaroni analandira golideyo ndipo anamuwumba ndi chikombole ndi kupanga fano la mwana wangʼombe. Kenaka anthu aja anati, \"Inu Aisraeli, nayu mulungu wanu amene anakutulutsani mʼdziko la Igupto.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.4",
            "verseOrgIds": [
              "EXO.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni ataona izi, anamanga guwa lansembe patsogolo pa mwana wangʼombeyo ndipo analengeza kuti, \"Mawa kudzakhala chikondwerero cha Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.5",
            "verseOrgIds": [
              "EXO.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero tsiku linalo anthu anadzuka mmamawa ndithu ndi kupereka nsembe zopsereza ndi nsembe zachiyanjano. Atatha kupereka nsembezo, anthuwo anakhala pansi nayamba kudya ndi kumwa. Kenaka anayimirira nayamba kuvina mwachilendo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.6",
            "verseOrgIds": [
              "EXO.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yehova anati kwa Mose, \"Tsika msanga, chifukwa anthu ako amene unawatulutsa mʼdziko la Igupto aja adziyipitsa kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.7",
            "verseOrgIds": [
              "EXO.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo apatuka mwamsanga kuleka kutsatira zimene ndinawalamula. Ndiye adzipangira fano la mwana wangʼombe. Aligwadira ndi kuliperekera nsembe nʼkumati, 'Inu Aisraeli, nayu mulungu wanu amene anakutulutsani mʼdziko la Igupto.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.8",
            "verseOrgIds": [
              "EXO.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anati kwa Mose, \"Ine ndikuwadziwa anthu amenewa. Iwowa ndi ankhutukumve.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.9",
            "verseOrgIds": [
              "EXO.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa chake undileke kuti mkwiyo wanga uyake pa iwo ndi kuwawononga. Ndipo Ine ndidzakusandutsa kuti ukhale mtundu waukulu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.10",
            "verseOrgIds": [
              "EXO.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Mose anapempha chifundo cha Mulungu wake ndipo anati, \"Chonde Yehova, chifukwa chiyani mwakwiyira anthu awa amene munawatulutsa mʼdziko la Igupto ndi mphamvu yanu yayikulu ndi dzanja lanu lamphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.11",
            "verseOrgIds": [
              "EXO.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi mukufuna kuti Aigupto azinena kuti, 'Munali ndi cholinga choyipa chofuna kuwaphera ku mapiri kuno ndi kuwawonongeratu pa dziko lapansi pamene munkawatulutsa ku Igupto kuja?' Ayi, chonde mkwiyo wanu woyaka ngati motowu ubwezeni ndipo sinthani maganizo ofunira zoyipa anthu anu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.12",
            "verseOrgIds": [
              "EXO.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbukirani atumiki anu, Abrahamu, Isake, Israeli ndi zija munawalonjeza polumbira pa dzina lanu kuti, 'Ine ndidzachulukitsa zidzukulu zanu ndipo zidzakhala zambiri ngati nyenyezi zakumwamba. Zidzukulu zanuzo ndidzazipatsa dziko lonseli limene ndinalonjeza. Dziko limeneli lidzakhala lawo nthawi zonse.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.13",
            "verseOrgIds": [
              "EXO.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yehova analeka ndipo sanawachitire choyipa anthu ake monga anaopsezera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.14",
            "verseOrgIds": [
              "EXO.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose anatembenuka ndi kutsika phiri miyala iwiri ya pangano ili mʼmanja mwake. Miyalayi inalembedwa mbali zonse, kutsogolo ndi kumbuyo komwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.15",
            "verseOrgIds": [
              "EXO.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miyalayi anayikonza ndi Mulungu. Malembawo analemba ndi Mulungu mozokota pa miyalapo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.16",
            "verseOrgIds": [
              "EXO.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Yoswa anamva phokoso la anthu anati kwa Mose, \"Ku msasa kuli phokoso la nkhondo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.17",
            "verseOrgIds": [
              "EXO.32.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 32:18"
      },
      "items": [
        {
          "text": "\"Phokoso limeneli sindikulimva",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 32:18"
      },
      "items": [
        {
          "text": "ngati phokoso la opambana nkhondo,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 32:18"
      },
      "items": [
        {
          "text": "kapena kulira kwa ongonjetsedwa pa nkhondo. Koma ndikulimva ngati phokoso la anthu amene akuyimba.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose atayandikira msasa ndi kuona mwana wangʼombe ndiponso kuvina, anakwiya kwambiri ndipo anaponya pansi miyala imene inali mʼmanja mwake, ndi kuyiphwanya pa tsinde la phiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.19",
            "verseOrgIds": [
              "EXO.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo iye anatenga mwana wangʼombe amene anthu anapanga uja ndi kumuwotcha pa moto ndi kumuperapera ndikukhala ngati fumbi. Kenaka anawaza fumbilo mʼmadzi ndi kuwamwetsa Aisraeli madziwo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.20",
            "verseOrgIds": [
              "EXO.32.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Mose anafunsa Aaroni kuti, \"Kodi anthu awa anakuchita chiyani kuti uwachimwitse koopsa chotere?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.21",
            "verseOrgIds": [
              "EXO.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni anayankha kuti, \"Musakwiye mbuye wanga. Inu mukudziwa kuti anthu awa ndi ovuta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.22",
            "verseOrgIds": [
              "EXO.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anati kwa ine, 'Bwera utipangire milungu imene idzititsogolera. Kunena za Mose amene anatitulutsa ife mʼdziko la Igupto, sitikudziwa chimene chamuchitikira.'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.23",
            "verseOrgIds": [
              "EXO.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho ine ndinawawuza kuti, 'Aliyense amene ali ndi zokometsera zagolide azivule.' Choncho iwo anandipatsa golide, ndipo ndinamuponya pa moto ndi kupanga fano la mwana wangʼombeyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.24",
            "verseOrgIds": [
              "EXO.32.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose anaona kuti anthuwo anali osokonezekadi chifukwa Aaroni anawalekerera mpaka kusanduka anthu osekedwa pakati pa adani awo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.25",
            "verseOrgIds": [
              "EXO.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho iye anayima pa chipata cholowera mu msasa ndipo anati, \"Aliyense amene ali mbali ya Yehova abwere kwa ine.\" Ndipo Alevi onse anapita mbali yake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.26",
            "verseOrgIds": [
              "EXO.32.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo iye anawawuza kuti, \"Izi ndi zimene Yehova Mulungu wa Israeli akunena, 'Pitani ku misasa konse, mulowe ku zipata zonse ndipo aliyense akaphe mʼbale wake, kapena mnzake kapena mnansi wake.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.27",
            "verseOrgIds": [
              "EXO.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alevi anachita zomwe Mose analamula, ndipo tsiku limenelo panafa anthu pafupifupi 3,000.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.28",
            "verseOrgIds": [
              "EXO.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Mose anati, \"Lero mwadzipatula nokha kukhala ansembe otumikira Yehova. Mwachita izi popeza aliyense wa inu wapha mwana wake kapena mʼbale wake. Tsono lero Yehova wakudalitsani.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.29",
            "verseOrgIds": [
              "EXO.32.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmawa mwake Mose anati kwa anthu onse, \"Inu mwachita tchimo lalikulu. Koma tsopano ine ndipita ku phiri kwa Yehova mwina ndikatha kukupepeserani chifukwa cha tchimo lanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.30",
            "verseOrgIds": [
              "EXO.32.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero Mose anabwereranso kwa Yehova ndipo anati, \"Aa! Anthu awa achita tchimo lalikulu! Iwo adzipangira milungu yagolide.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.31",
            "verseOrgIds": [
              "EXO.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma tsopano, chonde akhululukireni tchimo lawo. Ngati simutero, ndiye mundifute ine mʼbuku limene mwalemba.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.32",
            "verseOrgIds": [
              "EXO.32.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anamuyankha Mose kuti, \"Ndidzafuta mʼbuku aliyense amene wandichimwira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.33",
            "verseOrgIds": [
              "EXO.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano pita ukawatsogolere anthu kumalo kumene ine ndinanena, ndipo mngelo wanga adzakutsogolerani. Komabe, nthawi yanga ikadzafika kuti ndiwalange, ndidzawalanga chifukwa cha tchimo lawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.34",
            "verseOrgIds": [
              "EXO.32.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova anawakantha anthuwo ndi mliri chifukwa anawumiriza Aaroni kuti awapangire fano la mwana wangʼombe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.35",
            "verseOrgIds": [
              "EXO.32.35"
            ]
          }
        }
      ]
    }
  ],
