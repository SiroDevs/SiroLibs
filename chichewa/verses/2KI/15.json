    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Azariya Mfumu ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka cha 27 cha Yeroboamu mfumu ya Israeli, Azariya mwana wa Amaziya mfumu ya Yuda anayamba kulamulira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.1",
            "verseOrgIds": [
              "2KI.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anakhala mfumu ali ndi zaka 16 ndipo analamulira mu Yerusalemu zaka 52. Amayi ake anali Yekoliya wa ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.2",
            "verseOrgIds": [
              "2KI.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyeyo anachita zabwino pamaso pa Yehova, monga momwe anachitira Amaziya abambo ake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.3",
            "verseOrgIds": [
              "2KI.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe malo opembedzerako mafano sanawachotse ndipo anthu anapitirizabe kupereka nsembe ndi kufukiza lubani kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.4",
            "verseOrgIds": [
              "2KI.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova analanga mfumu ndi nthenda ya khate mpaka tsiku limene inamwalira. Tsono mfumuyo inkakhala mʼnyumba yakeyake yapadera. Mwana wake Yotamu ndiye amene ankayangʼanira nyumba ya mfumu ndiponso ndiye amene ankalamulira anthu mʼdzikomo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.5",
            "verseOrgIds": [
              "2KI.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito zina za Azariya ndi zonse zimene anachita, kodi sizinalembedwe mʼbuku la mbiri ya mafumu a Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.6",
            "verseOrgIds": [
              "2KI.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azariya anamwalira ndipo anayikidwa mʼmanda pamodzi ndi makolo ake mu Mzinda wa Davide. Ndipo Yotamu mwana wake analowa ufumu mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.7",
            "verseOrgIds": [
              "2KI.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zekariya Mfumu ya Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka cha 38 cha Azariya mfumu ya Yuda, Zekariya mwana wa Yeroboamu anakhala mfumu ya Israeli ku Samariya ndipo analamulira miyezi isanu ndi umodzi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.8",
            "verseOrgIds": [
              "2KI.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo iye anachita zoyipa pamaso pa Yehova monga anachitira makolo ake. Iye sanaleke machimo a Yeroboamu mwana wa Nebati, amene anachimwitsa nawo Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.9",
            "verseOrgIds": [
              "2KI.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salumu mwana wa Yabesi anachitira chiwembu Zekariya. Anamukantha anthu akuona, namupha, ndipo analowa ufumu mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.10",
            "verseOrgIds": [
              "2KI.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito zina za Zekariya, zinalembedwa mʼbuku la mbiri ya mafumu a Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.11",
            "verseOrgIds": [
              "2KI.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa ndiwo mawu a Yehova amene anayankhula kwa Yehu kuti, \"Ana ako adzalamulira Israeli mpaka mʼbado wachinayi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
            "verseOrgIds": [
              "2KI.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Salumu Mfumu ya Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salumu mwana wa Yabesi anakhala mfumu mʼchaka cha 39 cha ulamuliro wa Uziya mfumu ya Yuda ndipo analamulira mu Samariya mwezi umodzi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.13",
            "verseOrgIds": [
              "2KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Menahemu mwana wa Gadi anachoka ku Tiriza napita ku Samariya nakantha Salumu mwana wa Yabesi ku Samariya, namupha ndipo iye analowa ufumu mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.14",
            "verseOrgIds": [
              "2KI.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito zina za Salumu ndiponso za chiwembu chimene anachita, zinalembedwa mʼbuku la mbiri ya mafumu a Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.15",
            "verseOrgIds": [
              "2KI.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi imeneyo Menahemu, kuchokera ku Tiriza, anakathira nkhondo mzinda wa Tipisa ndi anthu onse amene anali mʼmenemo ndi dera lonse lozungulira chifukwa iwo anakana kutsekula zipata zawo. Iye anatenga katundu yense mu mzinda wa Tipisa ndi kutumbula akazi onse oyembekezera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.16",
            "verseOrgIds": [
              "2KI.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Menahemu Mfumu ya Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka cha 39 cha Azariya mfumu ya Yuda, Menahemu mwana wa Gadi anakhala mfumu ya Israeli ndipo analamulira mu Samariya zaka khumi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.17",
            "verseOrgIds": [
              "2KI.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anachita zoyipa pamaso pa Yehova. Nthawi yonse ya ulamuliro wake sanasiye machimo a Yeroboamu mwana wa Nebati, amene anachimwitsa nawo Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.18",
            "verseOrgIds": [
              "2KI.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Puli mfumu ya ku Asiriya inadzathira nkhondo dzikolo ndipo Menahemu anapatsa Puliyo makilogalamu 34,000 a siliva kuti amuthandize ndi kulimbikitsa ufumu wake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.19",
            "verseOrgIds": [
              "2KI.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemu anapeza ndalamazo kudzera mu msonkho umene ankakhometsa Aisraeli. Munthu aliyense wachuma ankapereka masekeli a siliva makumi asanu kwa mfumu ya ku Asiriya. Choncho mfumu ya ku Asiriya inabwerera ndipo sinakhalenso mʼdzikomo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.20",
            "verseOrgIds": [
              "2KI.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito zina za Menahemu ndi zonse zimene anachita, kodi sizinalembedwe mʼbuku la mbiri ya mafumu a Israeli?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.21",
            "verseOrgIds": [
              "2KI.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemu anamwalira ndipo anayikidwa mʼmanda pamodzi ndi makolo ake. Ndipo Pekahiya mwana wake analowa ufumu mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.22",
            "verseOrgIds": [
              "2KI.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pekahiya Mfumu ya Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka cha makumi asanu a Azariya mfumu ya Yuda, Pekahiya mwana wa Menahemu anakhala mfumu ya Israeli mu Samariya ndipo analamulira zaka ziwiri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.23",
            "verseOrgIds": [
              "2KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pekahiya anachita zoyipa pamaso pa Yehova. Iye sanaleke machimo a Yeroboamu mwana wa Nebati, omwe anachimwitsa nawo Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Peka mwana wa Remaliya, mtsogoleri wake wa ankhondo, anamuchita chiwembu. Iye pamodzi ndi anthu makumi asanu a ku Giliyadi anapha Pekahiya pamodzi ndi Arigobu ndi Ariyeli mʼchipinda choteteza nyumba ya mfumu mu Samariya. Kotero Peka anapha Pekahiya ndipo analowa ufumu mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito zina za Pekahiya ndi zonse zimene anachita zinalembedwa mʼbuku la mbiri ya mafumu a Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.26",
            "verseOrgIds": [
              "2KI.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Peka Mfumu ya Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka cha 52 cha Azariya mfumu ya Yuda, Peka mwana wa Remaliya anakhala mfumu ya Israeli ku Samariya ndipo analamulira zaka makumi awiri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.27",
            "verseOrgIds": [
              "2KI.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anachita zoyipa pamaso pa Yehova. Sanaleke machimo a Yeroboamu mwana wa Nebati, amene anachimwitsa nawo Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.28",
            "verseOrgIds": [
              "2KI.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi ya Peka mfumu ya Israeli, Tigilati-Pileseri mfumu ya ku Asiriya anabwera ndi kudzalanda Iyoni, Abeli-Beti-Maaka, Yanowa, Kedesi ndi Hazori. Mfumu ya ku Asiriya inatenga Giliyadi ndi Galileya, kuphatikizanso madera onse a Nafutali ndipo anatumiza Aisraeli ku Asiriya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.29",
            "verseOrgIds": [
              "2KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Hoseya mwana wa Ela anachitira chiwembu Peka mwana wa Remaliya. Anamukantha ndi kumupha ndipo anakhala mfumu mʼmalo mwake mʼchaka makumi awiri cha Yotamu mwana wa Uziya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.30",
            "verseOrgIds": [
              "2KI.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito zina za Peka ndi zonse zimene anachita, kodi sizinalembedwe mʼbuku la mbiri ya mafumu a Israeli?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.31",
            "verseOrgIds": [
              "2KI.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yotamu Mfumu ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka chachiwiri cha Peka mwana wa Remaliya mfumu ya Israeli, Yotamu mwana wa Uziya mfumu ya Yuda anayamba kulamulira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.32",
            "verseOrgIds": [
              "2KI.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anakhala mfumu ali ndi zaka 25 ndipo analamulira mu Yerusalemu zaka 16. Amayi ake anali Yerusa mwana wa Zadoki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.33",
            "verseOrgIds": [
              "2KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anachita zabwino pamaso pa Yehova monga anachitira Uziya abambo ake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.34",
            "verseOrgIds": [
              "2KI.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe malo opembedzera mafano sanawachotse ndipo anthu anapitiriza kupereka nsembe ndi kufukiza lubani kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.35",
            "verseOrgIds": [
              "2KI.15.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito zina za Yotamu ndi zonse zimene anachita, kodi sizinalembedwe mʼbuku la mbiri ya mafumu a Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.36",
            "verseOrgIds": [
              "2KI.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nthawi imeneyo, Yehova anayamba kumatuma Rezini mfumu ya Aaramu ndi Peka mwana wa Remaliya kudzamenyana ndi Yuda).",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotamu anamwalira ndipo anayikidwa mʼmanda pamodzi ndi makolo ake mu Mzinda wa Davide abambo ake. Ndipo Ahazi mwana wake analowa ufumu mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.38",
            "verseOrgIds": [
              "2KI.15.38"
            ]
          }
        }
      ]
    }
  ],
