              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anatembenuka nawayangʼana ndipo anawatemberera mʼdzina la Yehova. Nthawi yomweyo panatulukira zimbalangondo ziwiri kuchokera kuthengo, ndi kuphapo anyamata 42.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.24",
            "verseOrgIds": [
