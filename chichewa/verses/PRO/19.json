  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "PRO 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi wabwino munthu wosauka amene amayenda mu ungwiro,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.1",
            "verseOrgIds": [
              "PRO.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:1"
      },
      "items": [
        {
          "text": "aposa munthu wopusa woyankhula zokhota.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.1",
            "verseOrgIds": [
              "PRO.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si bwino kuti munthu akhale wopanda nzeru;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.2",
            "verseOrgIds": [
              "PRO.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:2"
      },
      "items": [
        {
          "text": "ndipo munthu woyenda mofulumira amaphonya njira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.2",
            "verseOrgIds": [
              "PRO.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchitsiru wa munthu umamubweretsera zovuta,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.3",
            "verseOrgIds": [
              "PRO.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:3"
      },
      "items": [
        {
          "text": "mtima wake umakwiyira Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.3",
            "verseOrgIds": [
              "PRO.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chuma chimachulukitsa abwenzi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.4",
            "verseOrgIds": [
              "PRO.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:4"
      },
      "items": [
        {
          "text": "koma munthu wosauka bwenzi lake limamuthawa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.4",
            "verseOrgIds": [
              "PRO.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mboni yonama sidzalephera kulangidwa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.5",
            "verseOrgIds": [
              "PRO.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:5"
      },
      "items": [
        {
          "text": "ndipo iye amene amanena mabodza sadzapulumuka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.5",
            "verseOrgIds": [
              "PRO.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu ambiri amafuna munthu wopatsa kuti awakomere mtima,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.6",
            "verseOrgIds": [
              "PRO.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:6"
      },
      "items": [
        {
          "text": "ndipo munthu amene amapereka mphatso ndi bwenzi la munthu aliyense.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.6",
            "verseOrgIds": [
              "PRO.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati munthu wosauka abale ake omwe amadana naye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.7",
            "verseOrgIds": [
              "PRO.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:7"
      },
      "items": [
        {
          "text": "nanji abwenzi ake tsono!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.7",
            "verseOrgIds": [
              "PRO.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 19:7"
      },
      "items": [
        {
          "text": "Iwo adzamuthawa kupita kutali.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.7",
            "verseOrgIds": [
              "PRO.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:7"
      },
      "items": [
        {
          "text": "Amayesa kuwatsatira mowapembedza koma iwo samapezeka konse.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.7",
            "verseOrgIds": [
              "PRO.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amene amapeza nzeru ndiye kuti amakonda moyo wake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.8",
            "verseOrgIds": [
              "PRO.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:8"
      },
      "items": [
        {
          "text": "Wosamalitsa kukhala wanzeru, zinthu zimamuyendera bwino.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.8",
            "verseOrgIds": [
              "PRO.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mboni yonama sidzalephera kulangidwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.9",
            "verseOrgIds": [
              "PRO.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:9"
      },
      "items": [
        {
          "text": "ndipo iye amene amanena mabodza adzawonongeka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.9",
            "verseOrgIds": [
              "PRO.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼkosayenera kuti chitsiru chizikhala ndi moyo wamanyado,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.10",
            "verseOrgIds": [
              "PRO.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:10"
      },
      "items": [
        {
          "text": "nanjinso kuti kapolo azilamulira akalonga!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.10",
            "verseOrgIds": [
              "PRO.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzeru zimapangitsa munthu kukhala wosakwiya msanga;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.11",
            "verseOrgIds": [
              "PRO.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:11"
      },
      "items": [
        {
          "text": "ulemerero wake uli posalabadira kuchitiridwa zoyipa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.11",
            "verseOrgIds": [
              "PRO.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkwiyo wa mfumu uli ngati kubangula kwa mkango,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.12",
            "verseOrgIds": [
              "PRO.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:12"
      },
      "items": [
        {
          "text": "koma kukoma mtima kwake kuli ngati mame pa udzu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.12",
            "verseOrgIds": [
              "PRO.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wopusa ndiye tsoka la abambo ake",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.13",
            "verseOrgIds": [
              "PRO.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:13"
      },
      "items": [
        {
          "text": "ndipo mkazi wolongolola ndi wotopetsa ngati mvula yamvumbi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.13",
            "verseOrgIds": [
              "PRO.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumba ndi chuma ndiye cholowa chochokera kwa makolo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.14",
            "verseOrgIds": [
              "PRO.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:14"
      },
      "items": [
        {
          "text": "koma mkazi wanzeru ndi wochokera kwa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.14",
            "verseOrgIds": [
              "PRO.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulesi umagonetsa tulo tofa nato",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.15",
            "verseOrgIds": [
              "PRO.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:15"
      },
      "items": [
        {
          "text": "ndipo munthu wosatakataka amakhala ndi njala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.15",
            "verseOrgIds": [
              "PRO.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amene amamvera malangizo amasunga moyo wake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.16",
            "verseOrgIds": [
              "PRO.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:16"
      },
      "items": [
        {
          "text": "koma amene sasamala malamulo a Yehova adzafa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.16",
            "verseOrgIds": [
              "PRO.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
