            "sid": "NEH 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motero ndinayeretsa ansembe ndi Alevi powachotsera kalikonse kachilendo. Ndipo ndinakhazikitsa ntchito zawo, kuti aliyense akhale pa ntchito yake.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
              "NEH.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiponso kupereka nkhuni ndi zipatso zoyamba kucha pa nthawi yake.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
            "verseOrgIds": [
              "NEH.13.31"
            ]
          }
        }
      ]
