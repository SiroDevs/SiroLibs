  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ECC 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani angafanane ndi munthu wanzeru?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:1"
      },
      "items": [
        {
          "text": "Ndani angadziwe kutanthauzira zinthu?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 8:1"
      },
      "items": [
        {
          "text": "Nzeru imabweretsa chimwemwe pa nkhope ya munthu",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:1"
      },
      "items": [
        {
          "text": "ndipo imasintha maonekedwe ake awukali.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Kumvera Mfumu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndikuti, mvera lamulo la mfumu, chifukwa unalumbira pamaso pa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.2",
            "verseOrgIds": [
              "ECC.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usafulumire kuchoka pamaso pa mfumu. Usawumirire chinthu choyipa, pakuti mfumu idzachita chilichonse chomwe imasangalatsidwa nacho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.3",
            "verseOrgIds": [
              "ECC.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza mawu a mfumu ali ndi mphamvu, ndani anganene kwa mfumuyo kuti, \"Kodi mukuchita chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.4",
            "verseOrgIds": [
              "ECC.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliyense amene amamvera lamulo lake sadzapeza vuto lililonse,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.5",
            "verseOrgIds": [
              "ECC.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:5"
      },
      "items": [
        {
          "text": "ndipo munthu wanzeru amadziwa nthawi yoyenera ndi machitidwe ake.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.5",
            "verseOrgIds": [
              "ECC.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti pali nthawi yoyenera ndiponso machitidwe a chinthu chilichonse,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.6",
            "verseOrgIds": [
              "ECC.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:6"
      },
      "items": [
        {
          "text": "ngakhale kuti mavuto ake a munthu amupsinja kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.6",
            "verseOrgIds": [
              "ECC.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza palibe munthu amene amadziwa zamʼtsogolo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.7",
            "verseOrgIds": [
              "ECC.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:7"
      },
      "items": [
        {
          "text": "ndani angamuwuze zomwe zidzachitika mʼtsogolo?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.7",
            "verseOrgIds": [
              "ECC.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palibe munthu amene ali ndi mphamvu yolamulira mpweya wa moyo kuti athe kuwusunga,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:8"
      },
      "items": [
        {
          "text": "choncho palibe amene ali ndi mphamvu pa tsiku la imfa yake.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 8:8"
      },
      "items": [
        {
          "text": "Nkhondo sithawika; tsono anthu ochita zoyipa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:8"
      },
      "items": [
        {
          "text": "kuyipa kwawoko sikudzawapulumutsa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonsezi ndinaziona pamene ndinalingalira mu mtima mwanga, zonse zimene zimachitika pansi pano. Ilipo nthawi imene ena amalamulira anzawo mwankhanza.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.9",
            "verseOrgIds": [
              "ECC.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka, ndinaona anthu oyipa akuyikidwa mʼmanda, iwo amene ankalowa ndi kumatuluka mʼmalo opatulika ndipo ankatamandidwa mu mzindawo pamene ankachita zimenezi. Izinso ndi zopandapake.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.10",
            "verseOrgIds": [
              "ECC.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene chigamulo cha anthu opalamula mlandu chikuchedwa, mitima ya anthu imadzaza ndi malingaliro ochita zolakwa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.11",
            "verseOrgIds": [
              "ECC.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale munthu woyipa apalamule milandu yambirimbiri, nʼkumakhalabe ndi moyo wautali, ine ndikudziwa kuti anthu owopa Mulungu zinthu zidzawayendera bwino, omwe amapereka ulemu pamaso pa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.12",
            "verseOrgIds": [
              "ECC.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma popeza oyipa saopa Mulungu zinthu sizidzawayendera bwino, ndipo moyo wawo sudzakhalitsa monga mthunzi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.13",
            "verseOrgIds": [
              "ECC.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palinso chinthu china chopanda phindu chomwe chimachitika pa dziko lapansi: anthu olungama amalangidwa ngati anthu osalungama. Pamene oyipa amalandira zabwino ngati kuti ndi anthu abwino.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.14",
            "verseOrgIds": [
              "ECC.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake ndikuti munthu azikondwerera moyo, pakuti munthu alibe chinanso chabwino pansi pano choposa kudya, kumwa ndi kumadzikondweretsa. Akamatero, munthuyo adzakhala ndi chimwemwe pa ntchito yake masiku onse a moyo wake amene Mulungu wamupatsa pansi pano.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.15",
            "verseOrgIds": [
              "ECC.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ndinayikapo mtima wanga kuti ndidziwe nzeru ndi kuonetsetsa ntchito za munthu pa dziko lapansi, osapeza tulo usana ndi usiku,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.16",
            "verseOrgIds": [
              "ECC.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamenepo ndinaona zonse zimene Mulungu anazichita. Palibe munthu amene angathe kuzimvetsa zonse zimene zimachitika pansi pano. Ngakhale munthu ayesetse kuzifufuza, sangathe kupeza tanthauzo lake. Ngakhale munthu wanzeru atanena kuti iye amadziwa, sangathe kuzimvetsetsa zinthuzo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.17",
            "verseOrgIds": [
              "ECC.8.17"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "ECC.9",
    "number": "9",
    "bookId": "ECC"
  },
