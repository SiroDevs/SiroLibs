              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndinaganiza mu mtima mwanga, \"Taona, ine ndakula ndi kukhala wa nzeru zochuluka kupambana aliyense amene analamulirapo Yerusalemu ndisanabadwe; ndaphunzira nzeru zochuluka ndi luntha.\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.16",
            "verseOrgIds": [
              "ECC.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ndinadzipereka kuti ndithe kumvetsa kuti nzeru nʼchiyani, misala nʼchiyani, uchitsiru nʼchiyani, koma ndinazindikira ichi, kuti kuteronso nʼkungodzivuta chabe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.17",
            "verseOrgIds": [
              "ECC.1.17"
            ]
          }
        }
      ]
    },
