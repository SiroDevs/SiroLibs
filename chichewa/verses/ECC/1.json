  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ECC 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zapansipano Nʼzopandapake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawu a Mlaliki, mwana wa Davide, mfumu ya ku Yerusalemu:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.1",
            "verseOrgIds": [
              "ECC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zopandapake! Zopandapake!\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:2"
      },
      "items": [
        {
          "text": "atero Mlaliki.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:2"
      },
      "items": [
        {
          "text": "\"Zopandapake kotheratu!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:2"
      },
      "items": [
        {
          "text": "Zopandapake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi munthu amapindulanji pa ntchito zake zonse",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.3",
            "verseOrgIds": [
              "ECC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:3"
      },
      "items": [
        {
          "text": "zimene amasautsidwa nazo pansi pano?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.3",
            "verseOrgIds": [
              "ECC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mibado imabwera ndipo mibado imapita,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.4",
            "verseOrgIds": [
              "ECC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:4"
      },
      "items": [
        {
          "text": "koma dziko lapansi limakhalapobe nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.4",
            "verseOrgIds": [
              "ECC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzuwa limatuluka ndipo dzuwa limalowa",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.5",
            "verseOrgIds": [
              "ECC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:5"
      },
      "items": [
        {
          "text": "ndipo limapita mwamsanga kumene limatulukira.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.5",
            "verseOrgIds": [
              "ECC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mphepo imawombera cha kummwera",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:6"
      },
      "items": [
        {
          "text": "ndi kukhotera cha kumpoto;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:6"
      },
      "items": [
        {
          "text": "imawomba mozungulirazungulira,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:6"
      },
      "items": [
        {
          "text": "kumangobwererabwerera komwe yachokera.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitsinje yonse imakathira ku nyanja,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:7"
      },
      "items": [
        {
          "text": "koma nyanjayo sidzaza;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:7"
      },
      "items": [
        {
          "text": "kumene madziwo amachokera,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:7"
      },
      "items": [
        {
          "text": "amabwereranso komweko.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zinthu zonse ndi zotopetsa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:8"
      },
      "items": [
        {
          "text": "kutopetsa kwake ndi kosaneneka.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:8"
      },
      "items": [
        {
          "text": "Maso satopa ndi kuona",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:8"
      },
      "items": [
        {
          "text": "kapena khutu kukwaniritsidwa ndi kumva.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zomwe zinalipo kale zidzakhalaponso,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.9",
            "verseOrgIds": [
              "ECC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:9"
      },
      "items": [
        {
          "text": "zomwe zinachitika kale zidzachitikanso.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.9",
            "verseOrgIds": [
              "ECC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:9"
      },
      "items": [
        {
          "text": "Ndiye kuti chatsopano palibiretu pansi pano.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.9",
            "verseOrgIds": [
              "ECC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi chilipo chinthu chimene wina anganene kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:10"
      },
      "items": [
        {
          "text": "\"Taona! Ichi ndiye chatsopano?\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:10"
      },
      "items": [
        {
          "text": "Chinalipo kale, kalekale;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:10"
      },
      "items": [
        {
          "text": "chinalipo ife kulibe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu akale sakumbukiridwa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:11"
      },
      "items": [
        {
          "text": "ngakhale amene adzabwera mʼtsogolomu",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:11"
      },
      "items": [
        {
          "text": "sadzakumbukiridwa ndi iwo",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:11"
      },
      "items": [
        {
          "text": "amene adzabwere pambuyo pawo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzeru Nʼzopandapake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine, Mlalikine, ndinali mfumu ya Israeli mu Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.12",
            "verseOrgIds": [
              "ECC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinayika mtima wanga pophunzira ndi kufunafuna mwa nzeru zinthu zonse zimene zimachitika pansi pa thambo. Ndi ntchito yolemetsa ndithu imene Mulungu anayipereka kwa anthu!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.13",
            "verseOrgIds": [
              "ECC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndaona zinthu zonse zochitika pansi pano; zinthu zonsezo ndi zopandapake, nʼkungodzivuta chabe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.14",
            "verseOrgIds": [
              "ECC.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinthu chokhota sichingathe kuwongoledwa;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.15",
            "verseOrgIds": [
              "ECC.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:15"
      },
      "items": [
        {
          "text": "chimene palibe sichingathe kuwerengedwa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.15",
            "verseOrgIds": [
              "ECC.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
