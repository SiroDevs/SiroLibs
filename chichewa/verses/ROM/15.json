  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "ROM 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife amene tili ndi chikhulupiriro champhamvu tiziwalezera mtima anthu ofowoka, ndipo tisamadzikondweretse tokha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.1",
            "verseOrgIds": [
              "ROM.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliyense wa ife akondweretse mnzake pomuchitira zabwino zomulimbikitsa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.2",
            "verseOrgIds": [
              "ROM.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ngakhale Khristu sanadzikondweretsa yekha koma, monga kwalembedwa kuti, \"Chipongwe cha anthu okunyozani chinagwera Ine.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.3",
            "verseOrgIds": [
              "ROM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti zilizonse zimene zinalembedwa kale zinalembedwa kuti zitiphunzitse ife. Malembawo amatilimbikitsa kupirira kuti tikhale ndi chiyembekezo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.4",
            "verseOrgIds": [
              "ROM.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu amene amapereka kupirira ndi chilimbikitso akupatseni maganizo amodzi pakati panu monga inu mukutsatira Khristu Yesu,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.5",
            "verseOrgIds": [
              "ROM.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kotero kuti ndi mtima umodzi ndi movomerezana mulemekeze Mulungu ndi Atate a Ambuye athu Yesu Khristu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.6",
            "verseOrgIds": [
              "ROM.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano landiranani wina ndi mnzake, monganso Khristu anakulandirani inu, ndi cholinga choti Mulungu alemekezeke.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.7",
            "verseOrgIds": [
              "ROM.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa kunena zoona, Khristu wasanduka mtumiki wa Ayuda, kuonetsa kuti Mulungu ndi wokhulupirika pa malonjezo amene anachita kwa makolo awo",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.8",
            "verseOrgIds": [
              "ROM.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti a mitundu ina atamande Mulungu chifukwa cha chifundo chake. Monga kwalembedwa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.9",
            "verseOrgIds": [
              "ROM.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 15:9"
      },
      "items": [
        {
          "text": "\"Choncho ine ndidzakutamandani pakati pa a mitundu;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.9",
            "verseOrgIds": [
              "ROM.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 15:9"
      },
      "items": [
        {
          "text": "ndidzayimba nyimbo zotamanda dzina lanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.9",
            "verseOrgIds": [
              "ROM.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akutinso,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.10",
            "verseOrgIds": [
              "ROM.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 15:10"
      },
      "items": [
        {
          "text": "\"Kondwerani inu anthu a mitundu ina pamodzi ndi anthu ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.10",
            "verseOrgIds": [
              "ROM.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo akutinso,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.11",
            "verseOrgIds": [
              "ROM.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 15:11"
      },
      "items": [
        {
          "text": "\"Tamandani Ambuye, inu nonse a mitundu ina,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.11",
            "verseOrgIds": [
              "ROM.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 15:11"
      },
      "items": [
        {
          "text": "ndi kuyimba zotamanda Iye, inu anthu onse.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.11",
            "verseOrgIds": [
              "ROM.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiponso Yesaya akuti,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.12",
            "verseOrgIds": [
              "ROM.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 15:12"
      },
      "items": [
        {
          "text": "\"Muzu wa Yese udzaphuka,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.12",
            "verseOrgIds": [
              "ROM.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 15:12"
      },
      "items": [
        {
          "text": "wina amene adzauka kulamulira anthu a mitundu ina;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.12",
            "verseOrgIds": [
              "ROM.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 15:12"
      },
      "items": [
        {
          "text": "mwa Iye mudzakhala chiyembekezo cha a mitundu ina.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.12",
            "verseOrgIds": [
              "ROM.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu amene amatipatsa chiyembekezo adzaze mitima yanu ndi chimwemwe ndi mtendere pamene mukumudalira Iye, kuti chiyembekezo chanu chisefukire mwamphamvu ya Mzimu Woyera.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.13",
            "verseOrgIds": [
              "ROM.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo Mtumwi wa Anthu a Mitundu Ina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abale anga, ine mwini ndikutsimikiza kuti inuyo ndinu abwino, odzaza ndi chidziwitso ndi okhoza kulangizana wina ndi mnzake.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.14",
            "verseOrgIds": [
              "ROM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndakulemberani inu molimba mtima pa fundo zina, kukhala ngati kukukumbutsaninso za zimenezo, chifukwa cha chisomo chimene Mulungu anandipatsa ine",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.15",
            "verseOrgIds": [
              "ROM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukhala mtumiki wa Khristu Yesu wa a mitundu ina ndi udindo wa wansembe, kulalikira Uthenga Wabwino wa Mulungu, kuti a mitundu ina akhale nsembe yolandiridwa kwa Mulungu, yopatsidwa ndi Mzimu Woyera.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.16",
            "verseOrgIds": [
              "ROM.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho, ine ndikunyadira mwa Khristu Yesu potumikira Mulungu wanga.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.17",
            "verseOrgIds": [
              "ROM.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine sindidzayesera kuyankhula za kanthu kalikonse koma zimene Khristu wazichita kudzera mwa ine zotsogolera a mitundu ina kuti amvere Mulungu mwa zimene ndinanena ndi kuzichita",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.18",
            "verseOrgIds": [
              "ROM.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwamphamvu ya zizindikiro ndi zodabwitsa kudzera mwamphamvu ya Mzimu Woyera. Choncho kuchokera ku Yerusalemu ndi kuzungulira ku Iluriko, ine ndalalikira kwathunthu Uthenga Wabwino wa Khristu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.19",
            "verseOrgIds": [
              "ROM.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakhala chilakolako changa nthawi zonse kuti ndilalikire Uthenga Wabwino kumene Khristu sadziwika, kuti ine ndisamange pa maziko a wina wake.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.20",
            "verseOrgIds": [
              "ROM.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma monga kwalembedwa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.21",
            "verseOrgIds": [
              "ROM.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 15:21"
      },
      "items": [
        {
          "text": "\"Iwo amene sanawuzidwe za Iye adzaona,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.21",
            "verseOrgIds": [
              "ROM.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 15:21"
      },
      "items": [
        {
          "text": "ndi iwo amene sanamve adzazindikira.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.21",
            "verseOrgIds": [
              "ROM.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi nʼchifukwa chake ine ndakhala ndikuletsedwa kawirikawiri kubwera kwa inu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.22",
            "verseOrgIds": [
              "ROM.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo Akonza Zopita ku Roma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma tsopano popeza kulibenso malo anga woti ndigwire ntchito mʼmadera awa, ndakhala ndikufuna kukuonani kwa zaka zambiri.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.23",
            "verseOrgIds": [
              "ROM.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndikukonza kuti nditero pamene ndipita ku Spaniya. Ine ndikuyembekeza kudzakuchezerani pamene ndikudutsa ndi kuti inu mudzathandize popitiriza ulendo wanga, nditasangalala ndi kukhala nanu kwa kanthawi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.24",
            "verseOrgIds": [
              "ROM.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma tsopano, ine ndili pa ulendo wopita ku Yerusalemu potumikira oyera mtima akumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.25",
            "verseOrgIds": [
              "ROM.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti kunakomera a ku Makedoniya ndi a ku Akaya kupereka thandizo kwa osauka pakati pa oyera mtima mu Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.26",
            "verseOrgIds": [
              "ROM.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo chinawakomera kuchita ichi, ndipo ndithu anali ndi ngongole kwa iwo. Pakuti ngati a mitundu ina anagawana ndi Ayuda madalitso auzimu, iwo ali ndi ngongole kwa Ayuda kuti agawane nawo madalitso awo a ku thupi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.27",
            "verseOrgIds": [
              "ROM.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono ine nditamaliza ntchito iyi ndi kutsimikiza kuti alandira chipatsochi, ndidzadzera kwanuko kudzakuchezerani pa ulendo wanga popita ku Spaniya.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.28",
            "verseOrgIds": [
              "ROM.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndikudziwa kuti pamene ndidzabwera kwa inu, ndidzafika ndili wodzaza ndi madalitso a Khristu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.29",
            "verseOrgIds": [
              "ROM.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abale, ine ndikukupemphani, mwa Ambuye athu Yesu Khristu ndi mwachikondi cha Mzimu, kuti mukhale nane pa kulimbika kwanga pondipempherera kwa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.30",
            "verseOrgIds": [
              "ROM.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pempherani kuti ine ndilanditsidwe kwa osakhulupirira a ku Yudeya ndi kuti utumiki wanga mu Yerusalemu ukhale ovomerezeka ndi oyera mtima.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.31",
            "verseOrgIds": [
              "ROM.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti mwachifuniro cha Mulungu ndibwere kwa inu ndi chimwemwe kuti ndidzapumule pamodzi ndi inu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.32",
            "verseOrgIds": [
              "ROM.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu wamtendere akhale ndi inu nonse. Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.33",
            "verseOrgIds": [
              "ROM.15.33"
            ]
          }
        }
      ]
    }
