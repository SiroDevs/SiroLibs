  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "ROM 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nsembe za Moyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake ine ndikukupemphani abale, mwa chifundo cha Mulungu, kuti mupereke matupi anu monga nsembe yamoyo, yopatulika ndi yokondweretsa Mulungu. Nsembeyi ndiye kupembedza kwanu kwa uzimu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.1",
            "verseOrgIds": [
              "ROM.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musafanizidwenso ndi makhalidwe a dziko lino koma musandulike pokonzanso maganizo anu. Ndipo mudzadziwa ndi kuzindikira chifuniro chabwino cha Mulungu chomwe ndi chokondweretsa ndi changwiro.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.2",
            "verseOrgIds": [
              "ROM.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa cha chisomo chopatsidwa kwa ine, ndinena kwa aliyense wa inu kuti musadziyenereze nokha kuposa mmene mulili. Koma mudziganizire nokha modzichepetsa, molingana ndi muyeso wa chikhulupiriro chimene Mulungu wakupatsani.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.3",
            "verseOrgIds": [
              "ROM.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti monga aliyense wa ife ali ndi thupi limodzi koma ziwalo zambiri, ziwalozi sizili ndi ntchito yofanana.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.4",
            "verseOrgIds": [
              "ROM.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Momwemonso mwa Khristu ife amene tili ambiri tipanga thupi limodzi ndipo chiwalo chilichonse ndi cholumikizika ku chinzake.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.5",
            "verseOrgIds": [
              "ROM.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife tili ndi mphatso zosiyana, molingana ndi chisomo chopatsidwa kwa ife. Ngati mphatso ya munthu ndi kunenera, musiyeni ayigwiritse ntchito molingana ndi chikhulupiriro chake.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.6",
            "verseOrgIds": [
              "ROM.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati ndi kutumikira, musiyeni atumikire. Ngati ndi kuphunzitsa, musiyeni aphunzitse.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.7",
            "verseOrgIds": [
              "ROM.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati ndi kulimbikitsa, musiyeni alimbikitse. Ngati ndi kupereka kuthandiza osowa, musiyeni apereke mowolowamanja. Ngati ndi utsogoleri, musiyeni alamulire mosamala. Ngati ndi kuonetsa chifundo, musiyeni achite mosangalala.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.8",
            "verseOrgIds": [
              "ROM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chikondi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikondi chikhale chopanda chinyengo. Dana nacho choyipa; gwiritsitsa chabwino.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.9",
            "verseOrgIds": [
              "ROM.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukondane kwathunthu monga abale. Lemekezanani wina ndi mnzake kuposa inu eni.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.10",
            "verseOrgIds": [
              "ROM.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musakhale aulesi mʼmachitidwe anu. Khalani achangu mu mzimu ndipo tumikirani Ambuye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.11",
            "verseOrgIds": [
              "ROM.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kondwerani mʼchiyembekezo, pirirani mʼmasautso ndiponso khulupirikani mʼpemphero.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.12",
            "verseOrgIds": [
              "ROM.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawanani ndi anthu a Mulungu amene ali ndi chosowa. Cherezani alendo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.13",
            "verseOrgIds": [
              "ROM.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adalitseni amene akuzunzani. Adalitseni ndipo musawatemberere.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.14",
            "verseOrgIds": [
              "ROM.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kondwani pamodzi ndi amene akukondwa ndipo lirani ndi amene akulira.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.15",
            "verseOrgIds": [
              "ROM.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyanjane wina ndi mnzake. Musakhale onyada, koma lolani kuyanjana ndi anthu wamba. Musaganize kuti mumadziwa zonse.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.16",
            "verseOrgIds": [
              "ROM.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musabwezere choyipa ndi choyipa kwa aliyense. Samalitsani kuchita chabwino pamaso pa aliyense.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.17",
            "verseOrgIds": [
              "ROM.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati nʼkotheka, khalani mwamtendere ndi aliyense monga momwe mungathere.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.18",
            "verseOrgIds": [
              "ROM.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okondedwa anga, musabwezere choyipa, koma lekerani Mulungu. Pakuti kwalembedwa, \"Kubwezera chilango nʼkwanga. Ndidzawalanga ndine,\" akutero Ambuye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.19",
            "verseOrgIds": [
              "ROM.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.20",
            "verseOrgIds": [
              "ROM.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 12:20"
      },
      "items": [
        {
          "text": "\"Ngati mdani wako ali ndi njala, mupatse chakudya.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.20",
            "verseOrgIds": [
              "ROM.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 12:20"
      },
      "items": [
        {
          "text": "Ngati ali ndi ludzu, mupatse kanthu kakumwa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.20",
            "verseOrgIds": [
              "ROM.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 12:20"
      },
      "items": [
        {
          "text": "Pochita ichi, udzamuwunjikira makala amoto pamutu pake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.20",
            "verseOrgIds": [
              "ROM.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musagonjetsedwe ndi choyipa, koma gonjetsani choyipa pochita chabwino.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.21",
            "verseOrgIds": [
              "ROM.12.21"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "ROM.13",
    "number": "13",
