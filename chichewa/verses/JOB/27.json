  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "JOB 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yobu anapitiriza kuyankhula kwake:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.1",
            "verseOrgIds": [
              "JOB.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndithu pali Mulungu wamoyo, amene wakana kundiweruza molungama,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.2",
            "verseOrgIds": [
              "JOB.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:2"
      },
      "items": [
        {
          "text": "Wamphamvuzonse, amene wawawitsa mtima wanga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.2",
            "verseOrgIds": [
              "JOB.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nthawi zonse pamene ndili ndi moyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.3",
            "verseOrgIds": [
              "JOB.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:3"
      },
      "items": [
        {
          "text": "mpweya wa Mulungu uli mʼmphuno mwanga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.3",
            "verseOrgIds": [
              "JOB.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakamwa panga sipadzatuluka mawu oyipa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.4",
            "verseOrgIds": [
              "JOB.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:4"
      },
      "items": [
        {
          "text": "lilime langa silidzayankhula zachinyengo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.4",
            "verseOrgIds": [
              "JOB.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sindidzavomereza kuti inu mukunena zoona;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.5",
            "verseOrgIds": [
              "JOB.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:5"
      },
      "items": [
        {
          "text": "mpaka imfa yanga, sindidzataya ungwiro wanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.5",
            "verseOrgIds": [
              "JOB.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzasunga chilungamo changa ndipo sindidzalola kuti chindichokere;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.6",
            "verseOrgIds": [
              "JOB.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:6"
      },
      "items": [
        {
          "text": "chikumbumtima changa sichidzanditsutsa nthawi yonse ya moyo wanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.6",
            "verseOrgIds": [
              "JOB.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mdani wanga akhale ngati woyipa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.7",
            "verseOrgIds": [
              "JOB.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:7"
      },
      "items": [
        {
          "text": "wondiwukira akhale ngati munthu wosalungama!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.7",
            "verseOrgIds": [
              "JOB.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanga chiyembekezo cha munthu wosapembedza nʼchiyani pamene aphedwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.8",
            "verseOrgIds": [
              "JOB.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:8"
      },
      "items": [
        {
          "text": "pamene Mulungu achotsa moyo wake?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.8",
            "verseOrgIds": [
              "JOB.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Mulungu amamva kulira kwake",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.9",
            "verseOrgIds": [
              "JOB.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:9"
      },
      "items": [
        {
          "text": "pamene zovuta zamugwera?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.9",
            "verseOrgIds": [
              "JOB.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi adzapeza chikondwerero mwa Wamphamvuzonse?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.10",
            "verseOrgIds": [
              "JOB.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:10"
      },
      "items": [
        {
          "text": "Kodi adzapemphera kwa Mulungu nthawi zonse?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.10",
            "verseOrgIds": [
              "JOB.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndidzakuphunzitsani za mphamvu ya Mulungu ndipo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.11",
            "verseOrgIds": [
              "JOB.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:11"
      },
      "items": [
        {
          "text": "sindidzabisa njira za Wamphamvuzonse.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.11",
            "verseOrgIds": [
              "JOB.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mwadzionera nokha zonsezi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.12",
            "verseOrgIds": [
              "JOB.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:12"
      },
      "items": [
        {
          "text": "Nanga bwanji mukuyankhula zopanda pake?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.12",
            "verseOrgIds": [
              "JOB.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pano pali chilango chimene Mulungu amasungira woyipa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.13",
            "verseOrgIds": [
              "JOB.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:13"
      },
      "items": [
        {
          "text": "cholowa chimene munthu wankhanza amalandira kuchokera kwa Wamphamvuzonse.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.13",
            "verseOrgIds": [
              "JOB.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angakhale ana ake achuluke chotani adzaphedwa ndi lupanga ndipo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.14",
            "verseOrgIds": [
              "JOB.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:14"
      },
      "items": [
        {
          "text": "zidzukulu zake zidzasowa zakudya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.14",
            "verseOrgIds": [
              "JOB.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amene adzatsalireko adzafa ndi mliri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.15",
            "verseOrgIds": [
              "JOB.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:15"
      },
      "items": [
        {
          "text": "ndipo akazi awo amasiye sadzawalira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.15",
            "verseOrgIds": [
              "JOB.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale aunjike siliva ngati fumbi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.16",
            "verseOrgIds": [
              "JOB.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:16"
      },
      "items": [
        {
          "text": "ndi kukundika zovala ngati mchenga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.16",
            "verseOrgIds": [
              "JOB.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "zimene wasungazo wolungama ndiye adzavale,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.17",
            "verseOrgIds": [
              "JOB.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:17"
      },
      "items": [
        {
          "text": "ndipo anthu osalakwa ndiwo adzagawane siliva wakeyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.17",
            "verseOrgIds": [
              "JOB.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumba imene akuyimanga ili ngati mokhala kadziwotche,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.18",
            "verseOrgIds": [
              "JOB.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:18"
      },
      "items": [
        {
          "text": "ili ngati msasa umene mlonda amamanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.18",
            "verseOrgIds": [
              "JOB.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amapita kokagona ali wolemera koma kutha kwake nʼkomweko;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.19",
            "verseOrgIds": [
              "JOB.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:19"
      },
      "items": [
        {
