  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "JOB 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yobu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yobu anayankha Yehova kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndikudziwa kuti Inu mungathe kuchita zinthu zonse;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.2",
            "verseOrgIds": [
              "JOB.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:2"
      },
      "items": [
        {
          "text": "chimene mufuna kuchita wina sangaletse konse.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.2",
            "verseOrgIds": [
              "JOB.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munandifunsa kuti, 'Kodi ndiwe yani amene ukufuna kusokoneza uphungu wanga ndi mawu opanda nzeru?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.3",
            "verseOrgIds": [
              "JOB.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:3"
      },
      "items": [
        {
          "text": "Zoonadi ndinayankhula zimene sindinazimvetse,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.3",
            "verseOrgIds": [
              "JOB.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:3"
      },
      "items": [
        {
          "text": "zinthu zodabwitsa kwambiri kwa ine zimene sindinazidziwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.3",
            "verseOrgIds": [
              "JOB.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inu munandiwuza kuti, 'Mvetsetsa tsopano ndipo ndidzayankhula;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.4",
            "verseOrgIds": [
              "JOB.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:4"
      },
      "items": [
        {
          "text": "ndidzakufunsa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.4",
            "verseOrgIds": [
              "JOB.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:4"
      },
      "items": [
        {
          "text": "ndipo iwe udzandiyankhe.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.4",
            "verseOrgIds": [
              "JOB.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinkangomva za Inu ndi makutu anga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.5",
            "verseOrgIds": [
              "JOB.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:5"
      },
      "items": [
        {
          "text": "koma tsopanonso ndakuonani ndi maso anga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.5",
            "verseOrgIds": [
              "JOB.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake ndi kuchita manyazi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.6",
            "verseOrgIds": [
              "JOB.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:6"
      },
      "items": [
        {
          "text": "ndikulapa podzithira fumbi ndi phulusa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.6",
            "verseOrgIds": [
              "JOB.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mulungu Adalitsa Yobu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova atayankhula ndi Yobu mawu amenewa anawuza Elifazi wa ku Temani kuti, \"Ine ndakukwiyira pamodzi ndi abwenzi ako awiri, chifukwa simunayankhule zabwino za Ine, monga mmene wayankhulira mtumiki wanga Yobu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.7",
            "verseOrgIds": [
              "JOB.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero tsopano mutenge ngʼombe zazimuna zisanu ndi ziwiri ndi nkhosa zazimuna zisanu ndi ziwiri ndi kupita nazo kwa mtumiki wanga Yobu kuti mukapereke nsembe zopsereza. Mtumiki wanga Yobu adzakupemphererani, ndipo Ine ndidzalandira pemphero lake. Sindidzakuchitirani kanthu molingana ndi uchitsiru wanu. Inu simunayankhule zabwino za Ine, monga anayankhulira Yobu mtumiki wanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motero Elifazi wa ku Temani, Bilidadi wa ku Suki ndi Zofari wa ku Naama anachita zimene Yehova anawawuza ndipo Yehova anamvera pemphero la Yobu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobu atawapempherera abwenzi ake aja, Yehova anamubwezera chuma chake ndipo anamupatsa mowirikiza kuposa zomwe anali nazo kale.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.10",
            "verseOrgIds": [
              "JOB.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abale ake ndi alongo ake onse, kuphatikizapo onse amene ankamudziwa kale, amabwera kwa iye nʼkudzadya naye chakudya mʼnyumba mwake. Iwo anamutonthoza ndi kumupepesa chifukwa cha mavuto onse amene Yehova analola kuti amugwere. Aliyense wa iwowa anamupatsa ndalama ndi mphete yagolide.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.11",
            "verseOrgIds": [
              "JOB.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anadalitsa Yobu pa masiku ake otsirizawa kupambana poyamba paja. Iye anali ndi nkhosa 14,000, ngamira 6,000, ngʼombe zantchito 2,000 ndi abulu aakazi 1,000.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.12",
            "verseOrgIds": [
              "JOB.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaberekanso ana aamuna asanu ndi awiri ndi ana aakazi atatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.13",
            "verseOrgIds": [
              "JOB.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wake wamkazi woyamba anamutcha Yemima, wachiwiri anamutcha Keziya, wachitatu anamutcha Kereni Hapuki.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.14",
            "verseOrgIds": [
              "JOB.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼdziko monsemo munalibe akazi okongola ngati ana a Yobu, ndipo abambo awo anawapatsa cholowa pamodzi ndi alongo awo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.15",
            "verseOrgIds": [
              "JOB.42.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zitachitika zimenezi, Yobu anakhala ndi moyo zaka 140. Iye anaona zidzukulu zake mpaka mʼbado wachinayi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.16",
            "verseOrgIds": [
              "JOB.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Potsiriza, Yobu anamwalira ali nkhalamba ya zaka zochuluka kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.17",
            "verseOrgIds": [
              "JOB.42.17"
            ]
          }
        }
      ]
    }
  ],
