  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "JOB 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yobu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yobu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.1",
            "verseOrgIds": [
              "JOB.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Leronso kudandaula kwanga nʼkwakukulu kwambiri;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.2",
            "verseOrgIds": [
              "JOB.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:2"
      },
      "items": [
        {
          "text": "Iye akundilanga kwambiri ngakhale ndi kubuwula.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.2",
            "verseOrgIds": [
              "JOB.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikanangodziwa kumene ndikanamupeza Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.3",
            "verseOrgIds": [
              "JOB.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:3"
      },
      "items": [
        {
          "text": "ndikanangopita kumene amakhalako!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.3",
            "verseOrgIds": [
              "JOB.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikanafotokoza mlandu wanga pamaso pake",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.4",
            "verseOrgIds": [
              "JOB.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:4"
      },
      "items": [
        {
          "text": "ndipo ndikanayankhula mawu odziteteza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.4",
            "verseOrgIds": [
              "JOB.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikanadziwa mawu amene Iye akanandiyankha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.5",
            "verseOrgIds": [
              "JOB.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:5"
      },
      "items": [
        {
          "text": "ndi kulingalira bwino zimene akananena!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.5",
            "verseOrgIds": [
              "JOB.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Iye akanalimbana nane mwa mphamvu zake zazikulu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.6",
            "verseOrgIds": [
              "JOB.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:6"
      },
      "items": [
        {
          "text": "Ayi, Iye sakanayankhula zinthu zotsutsana nane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.6",
            "verseOrgIds": [
              "JOB.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumeneko munthu wolungama akanafotokoza mlandu wake pamaso pake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.7",
            "verseOrgIds": [
              "JOB.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:7"
      },
      "items": [
        {
          "text": "ndipo woweruzayo akanandipeza wosalakwa nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.7",
            "verseOrgIds": [
              "JOB.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Taonani, ndikapita kummawa, Iye kulibe kumeneko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.8",
            "verseOrgIds": [
              "JOB.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:8"
      },
      "items": [
        {
          "text": "ndikapita kumadzulo sinditha kumupeza kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.8",
            "verseOrgIds": [
              "JOB.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamagwira ntchito kumpoto, sindimuona kumeneko",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.9",
            "verseOrgIds": [
              "JOB.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:9"
      },
      "items": [
        {
          "text": "akapita kummwera, sindimuona.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.9",
            "verseOrgIds": [
              "JOB.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Iye amadziwa mmene ndimayendera;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.10",
            "verseOrgIds": [
              "JOB.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:10"
      },
      "items": [
        {
          "text": "Iyeyo akandiyesa adzandipeza kuti ndili ngati golide.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.10",
            "verseOrgIds": [
              "JOB.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapazi anga akhala akuponda mʼmapazi ake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.11",
            "verseOrgIds": [
              "JOB.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:11"
      },
      "items": [
        {
          "text": "ndasunga njira yake ndipo sindinayitaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.11",
            "verseOrgIds": [
              "JOB.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sindinapatuke kusiya malamulo ochokera pakamwa pake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.12",
            "verseOrgIds": [
              "JOB.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:12"
      },
      "items": [
        {
          "text": "ndasunga mawu a pakamwa pake kupambana chakudya changa cha tsiku ndi tsiku.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.12",
            "verseOrgIds": [
              "JOB.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koma Iyeyo ndi wosasinthika, ndipo ndani angatsutsane naye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.13",
            "verseOrgIds": [
              "JOB.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:13"
      },
      "items": [
        {
          "text": "Iye amachita chilichonse chimene wafuna.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.13",
            "verseOrgIds": [
              "JOB.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amachita chimene watsimikiza kuti chindichitikire,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.14",
            "verseOrgIds": [
              "JOB.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:14"
      },
      "items": [
        {
          "text": "ndipo malingaliro oterowa ali nawobe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.14",
            "verseOrgIds": [
              "JOB.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake ndikuchita mantha kwambiri pamaso pake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.15",
            "verseOrgIds": [
              "JOB.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:15"
      },
      "items": [
        {
          "text": "ndikamaganiza zonsezi ndimamuopa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.15",
            "verseOrgIds": [
              "JOB.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu walefula mtima wanga;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.16",
            "verseOrgIds": [
              "JOB.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:16"
      },
      "items": [
        {
          "text": "Wamphamvuzonse wandiopseza kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.16",
            "verseOrgIds": [
              "JOB.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komatu sindinachititsidwe mantha ndi mdima,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.17",
            "verseOrgIds": [
              "JOB.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:17"
      },
      "items": [
        {
          "text": "ndi mdima wandiweyani umene waphimba nkhope yanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.17",
            "verseOrgIds": [
              "JOB.23.17"
            ]
          }
        }
      ]
    }
  ],
