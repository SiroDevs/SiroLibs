      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:21"
      },
      "items": [
        {
          "text": "pamene chiwerengero cha masiku ake chatha?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.21",
            "verseOrgIds": [
              "JOB.21.21"
            ]
          }
        }
      ]
    },
