      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:22"
      },
      "items": [
        {
          "text": "poti Iye amaweruza ngakhale anthu apamwamba?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.22",
            "verseOrgIds": [
              "JOB.21.22"
            ]
          }
        }
      ]
    },
    {
