          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulole kuti adzionere yekha chilango chake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.20",
            "verseOrgIds": [
              "JOB.21.20"
            ]
          }
        }
