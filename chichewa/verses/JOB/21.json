          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi alipo wina amene angaphunzitse Mulungu nzeru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.22",
            "verseOrgIds": [
              "JOB.21.22"
            ]
          }
        }
      ]
