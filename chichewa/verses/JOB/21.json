      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:23"
      },
      "items": [
        {
          "text": "ali pa mtendere ndi pa mpumulo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.23",
            "verseOrgIds": [
              "JOB.21.23"
            ]
          }
        }
