      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:20"
      },
      "items": [
        {
          "text": "kuti alawe ukali wa Wamphamvuzonse.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.20",
            "verseOrgIds": [
              "JOB.21.20"
            ]
          }
        }
      ]
    },
    {
