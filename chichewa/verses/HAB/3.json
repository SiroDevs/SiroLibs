  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "HAB 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pemphero la Habakuku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAB 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pemphero la mneneri Habakuku potsata mayimbidwe a Sigionoti.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.1",
            "verseOrgIds": [
              "HAB.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, ndamva za kutchuka kwanu;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "Inu Yehova, ntchito zanu zandiopsa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "Muzichitenso masiku athu ano,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "masiku athu ano zidziwike;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "mu ukali wanu mukumbukire kuchita chifundo.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anabwera kuchokera ku Temani,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "Woyerayo kuchokera ku Phiri la Parani.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "Sela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "Ulemerero wake unaphimba mlengalenga",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "ndipo dziko lapansi linadzaza ndi matamando ake.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwala kwa ulemerero wake kunali ngati kutuluka kwa dzuwa;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:4"
      },
      "items": [
        {
          "text": "kunyezimira kunkatuluka mʼdzanja lake,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:4"
      },
      "items": [
        {
          "text": "mʼmene anabisamo mphamvu zake.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patsogolo pake pankagwa mliri;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.5",
            "verseOrgIds": [
              "HAB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:5"
      },
      "items": [
        {
          "text": "nthenda yoopsa inkagwa kumbuyo kwake.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.5",
            "verseOrgIds": [
              "HAB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayimirira ndi kugwedeza dziko lapansi;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "anayangʼana ndipo mitundu ya anthu inanjenjemera.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "Mapiri okhazikika anagumuka",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "ndipo zitunda zakalekale zinatitimira.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "Njira zake ndi zachikhalire.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinaona matenti a ku Kusani ali pa mavuto,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.7",
            "verseOrgIds": [
              "HAB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:7"
      },
      "items": [
        {
          "text": "mokhala a ku Midiyani muli ululu waukulu.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.7",
            "verseOrgIds": [
              "HAB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAB 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, kodi munakwiyira mitsinje?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "Kodi munakalipira timitsinje?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "Kodi munapsera mtima nyanja",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "pamene munakwera pa akavalo anu",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:8"
      },
      "items": [
        {
          "text": "ndiponso magaleta anu achipulumutso?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAB 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munasolola uta wanu mʼchimake,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.9",
            "verseOrgIds": [
              "HAB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:9"
      },
      "items": [
        {
          "text": "munayitanitsa mivi yambiri.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.9",
            "verseOrgIds": [
              "HAB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "HAB 3:9"
      },
      "items": [
        {
          "text": "Sela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:9"
      },
      "items": [
        {
          "text": "Munagawa dziko lapansi ndi mitsinje;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.9",
            "verseOrgIds": [
              "HAB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAB 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mapiri anakuonani ndipo anagwedezeka.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:10"
      },
      "items": [
        {
          "text": "Madzi amphamvu anasefukira;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:10"
      },
      "items": [
        {
          "text": "nyanja yozama inakokoma",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:10"
      },
      "items": [
        {
          "text": "ndipo mafunde ake anakwera kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.10",
            "verseOrgIds": [
              "HAB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzuwa ndi mwezi zinayima chilili mlengalenga,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.11",
            "verseOrgIds": [
              "HAB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:11"
      },
      "items": [
        {
          "text": "pa kungʼanima kwa mivi yanu yowulukayo,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.11",
            "verseOrgIds": [
              "HAB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:11"
      },
      "items": [
        {
          "text": "pa kunyezimira kwa mkondo wanu.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.11",
            "verseOrgIds": [
              "HAB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAB 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munayendayenda mʼdziko lapansi muli ndi ukali,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.12",
            "verseOrgIds": [
              "HAB.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:12"
      },
      "items": [
        {
          "text": "ndipo munapondereza mitundu ya anthu muli ndi mkwiyo.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.12",
            "verseOrgIds": [
              "HAB.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
