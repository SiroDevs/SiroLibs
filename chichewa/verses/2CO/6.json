  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2CO 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pogwira naye ntchito pamodzi, tikukudandaulirani kuti musangolandira chisomo cha Mulungu pachabe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.1",
            "verseOrgIds": [
              "2CO.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti akunena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 6:2"
      },
      "items": [
        {
          "text": "\"Pa nthawi yanga yabwino yokomera anthu mtima ndinakumvera,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:2"
      },
      "items": [
        {
          "text": "ndipo pa nthawi yopulumutsa ndinakuthandiza.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "2CO 6:2"
      },
      "items": [
        {
          "text": "Taonani, ndikukuwuzani kuti, ino ndiyo nthawi yabwino ya Ambuye, lero ndiye tsiku la chipulumutso.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Masautso a Paulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife sitikuyika chokhumudwitsa pa njira ya wina aliyense, kuti utumiki wathu usanyozeke.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.3",
            "verseOrgIds": [
              "2CO.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmalo mwake, mwanjira iliyonse timasonyeza kuti ndife atumiki a Mulungu popirira kwambiri mʼmasautso, mʼzowawa ndi mʼzodetsa nkhawa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.4",
            "verseOrgIds": [
              "2CO.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pomenyedwa, kuponyedwa mʼndende ndi mʼzipolowe. Pogwira ntchito mwamphamvu, posagona usiku onse, posowa chakudya;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.5",
            "verseOrgIds": [
              "2CO.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "pokhala moyo woyera mtima, pomvetsa zinthu, wokoma mtima ndi wachifundo mwa Mzimu Woyera ndi mwachikondi choonadi",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.6",
            "verseOrgIds": [
              "2CO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndi poyankhula choonadi mwamphamvu ya Mulungu. Zida zimene zili mʼdzanja lamanja ndi lamanzere ndizo chilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.7",
            "verseOrgIds": [
              "2CO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timatumikira Mulungu ngakhale ena amatinyoza ndi ena amatilemekeza, ena amatinenera chipongwe, enanso amatiyamikira. Ena amatitenga kukhala ngati onena zoona, ndipo enanso amatitenga kukhala ngati onena zabodza.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.8",
            "verseOrgIds": [
              "2CO.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatiyesa osadziwika komatu ndife odziwika kwambiri. Amatiyesa wooneka ngati tikufa, koma tikupitirirabe ndi moyo, okanthidwa, koma osaphedwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.9",
            "verseOrgIds": [
              "2CO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatiyesa achisoni, koma ndife achimwemwe nthawi zonse, aumphawi, koma olemeretsa ambiri; wopanda kanthu, koma tili ndi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.10",
            "verseOrgIds": [
              "2CO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tayankhula momasuka kwa inu, Akorinto, ndipo tanena zonse za kumtima kwathu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.11",
            "verseOrgIds": [
              "2CO.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife sitikukubisirani chikondi chathu pa inu, koma inu mukubisa chikondi chanu pa ife.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.12",
            "verseOrgIds": [
              "2CO.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pofuna kufanana zochita ndi kuyankhula monga kwa ana anga, nanunso muzinena za kukhosi kwanu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.13",
            "verseOrgIds": [
              "2CO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukhala Pamodzi ndi Osakhulupirira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musamasenze goli pamodzi ndi osakhulupirira. Kodi pali mgwirizano wanji pakati pa kulungama ndi kusalungama? Kapena kodi pali mgwirizano wanji pakati pa kuwala ndi mdima?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.14",
            "verseOrgIds": [
              "2CO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pali mgwirizano wanji pakati pa Khristu ndi Beliyali? Kapena munthu wokhulupirira angayanjane bwanji ndi munthu wosakhulupirira?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.15",
            "verseOrgIds": [
              "2CO.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pali mgwirizano wanji pakati pa Nyumba ya Mulungu ndi nyumba ya mafano? Popezatu ndife Nyumba ya Mulungu wamoyo. Monga Mulungu wanena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 6:16"
      },
      "items": [
        {
          "text": "\"Ndidzakhala mwa iwo",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:16"
      },
      "items": [
        {
          "text": "ndipo ndidzayendayenda pakati pawo,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 6:16"
      },
      "items": [
        {
          "text": "ndipo ndidzakhala Mulungu wawo,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:16"
      },
      "items": [
        {
          "text": "ndipo adzakhala anthu anga.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 6:17"
      },
      "items": [
        {
          "text": "\"Tulukani pakati pawo",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:17"
      },
      "items": [
        {
          "text": "ndi kudzipatula,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "2CO 6:17"
      },
      "items": [
        {
          "text": "akutero Ambuye.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 6:17"
      },
      "items": [
        {
          "text": "Musakhudze chodetsedwa chilichonse,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:17"
      },
      "items": [
        {
          "text": "ndipo ndidzakulandirani.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.18",
            "verseOrgIds": [
              "2CO.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 6:18"
      },
      "items": [
        {
          "text": "\"Ndidzakhala Atate anu,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.18",
            "verseOrgIds": [
              "2CO.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:18"
      },
      "items": [
        {
          "text": "ndipo inu mudzakhala ana anga aamuna ndi aakazi,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.18",
            "verseOrgIds": [
              "2CO.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "2CO 6:18"
      },
      "items": [
        {
          "text": "akutero Ambuye, Wamphamvuzonse.\"",
          "type": "text"
        }
      ]
    }
  ],
