  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "ISA 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Chilango cha Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uthenga wonena za Chigwa cha Masomphenya:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:1"
      },
      "items": [
        {
          "text": "Kodi chachitika nʼchiyani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:1"
      },
      "items": [
        {
          "text": "kuti nonsenu mukwere pa madenga?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe mzinda wodzaza ndi chisangalalo chodzaza tsaya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "iwe mzinda waphokoso ndi wosokonekera?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "Anthu ako ophedwa aja sanaphedwe ndi lupanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "kapena kufera pa nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atsogoleri ako onse ngakhale anathawa limodzi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "koma anagwidwa osadziteteza nʼkomwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "Inu munapezeka ndipo nonse pamodzi munatengedwa ukapolo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "ngakhale munathawa pamene mdani akanali patali.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake Ine ndinati, \"Chokani pamaso panga;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:4"
      },
      "items": [
        {
          "text": "ndilekeni ndilire ndi mtima wowawa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:4"
      },
      "items": [
        {
          "text": "Musayesere kunditonthoza",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:4"
      },
      "items": [
        {
          "text": "chifukwa cha kuwonongeka kwa anthu anga.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lero Ambuye Yehova Wamphamvuzonse walola kuti tione",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "mavuto ndi kugonjetsedwa ndiponso chisokonezo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "mʼChigwa cha Masomphenya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "Malinga agumuka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "komanso anthu akanalira mofuwula ku mapiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ankhondo a ku Elamu anadza pa magaleta",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:6"
      },
      "items": [
        {
          "text": "ndi akavalo ali ndi mivi mʼmanja.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:6"
      },
      "items": [
        {
          "text": "Ankhondo a ku Kiri anakonzeka ndi zishango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zigwa zanu zachonde ndi zodzaza ndi magaleta,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.7",
            "verseOrgIds": [
              "ISA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:7"
      },
      "items": [
        {
          "text": "ndipo asilikali okwera pa akavalo ayikidwa pa zipata za mzinda;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.7",
            "verseOrgIds": [
              "ISA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "zonse zoteteza Yuda zachotsedwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 22:8"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:8"
      },
      "items": [
        {
          "text": "Ndipo tsiku limenelo munayangʼanayangʼana",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:8"
      },
      "items": [
        {
          "text": "zida zankhondo zomwe zinali mʼnyumba yaufumu ya nkhalango;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "inu munaona kuti makoma ambiri a mzinda wa Davide",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "anali ndi malo ambiri ogumuka;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "munasunga madzi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "mu chidziwe chakumunsi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munawerenga nyumba zonse za mu Yerusalemu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.10",
            "verseOrgIds": [
              "ISA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:10"
      },
      "items": [
        {
          "text": "ndipo munagwetsa nyumba zina kuti mulimbitse linga logumuka lija.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.10",
            "verseOrgIds": [
              "ISA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakati pa makoma awiri munamanga chitsime",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "chosungiramo madzi ochokera ku dziwe lakale,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "koma inu simunadalire Mulungu amene anapanga zimenezi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "kapena kusamalako za Iye amene anazilenga kale lomwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku limenelo, Ambuye Yehova Wamphamvuzonse",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.12",
            "verseOrgIds": [
              "ISA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:12"
      },
      "items": [
        {
          "text": "anakuyitanani kuti mulire ndi kukhetsa misozi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.12",
            "verseOrgIds": [
              "ISA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:12"
      },
      "items": [
        {
          "text": "kumeta mutu wanu mpala",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.12",
            "verseOrgIds": [
              "ISA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:12"
      },
      "items": [
        {
          "text": "ndi kuvala ziguduli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.12",
            "verseOrgIds": [
              "ISA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mʼmalo mwake inu munakondwa ndi kusangalala;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:13"
      },
      "items": [
        {
          "text": "munapha ngʼombe ndi nkhosa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:13"
      },
      "items": [
        {
          "text": "munadya nyama ndi kumwa vinyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:13"
      },
      "items": [
        {
          "text": "Inu mumati, \"Tiyeni tidye ndi kumwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:13"
      },
      "items": [
        {
          "text": "pakuti mawa tifa!\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Wamphamvuzonse wandiwululira mondinongʼoneza kuti, \"Tchimo limeneli sindidzakhululuka mpaka tsiku la kufa kwanu,\" akutero Ambuye, Yehova Wamphamvuzonse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.14",
            "verseOrgIds": [
              "ISA.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimene Ambuye, Yehova Wamphamvuzonse akuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.15",
            "verseOrgIds": [
              "ISA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:15"
      },
      "items": [
        {
          "text": "\"Pita, ukanene kwa Sabina kapitawo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.15",
            "verseOrgIds": [
              "ISA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:15"
      },
      "items": [
        {
          "text": "amene amayangʼanira nyumba yaufumu:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.15",
            "verseOrgIds": [
              "ISA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ukuchita chiyani kuno, nanga ndani anakupatsa chilolezo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.16",
            "verseOrgIds": [
              "ISA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:16"
      },
      "items": [
        {
          "text": "kuti udzikumbire manda kuno,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.16",
            "verseOrgIds": [
              "ISA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:16"
      },
      "items": [
        {
          "text": "kudzikumbira manda pa phiri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.16",
            "verseOrgIds": [
              "ISA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:16"
      },
      "items": [
        {
          "text": "ndi kudzisemera malo opumulira mʼthanthwe?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.16",
            "verseOrgIds": [
              "ISA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Samalira, Yehova watsala pangʼono kukugwira zolimba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.17",
            "verseOrgIds": [
              "ISA.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:17"
      },
      "items": [
        {
          "text": "ndi kukuponya mwamphamvu, iwe munthu wamphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.17",
            "verseOrgIds": [
              "ISA.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzakukulunga kwambiri ngati mpira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.18",
            "verseOrgIds": [
              "ISA.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:18"
      },
      "items": [
        {
          "text": "ndipo adzakuponyera mʼdziko lalikulu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.18",
            "verseOrgIds": [
              "ISA.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:18"
      },
      "items": [
        {
          "text": "Kumeneko ndiko ukafere",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.18",
            "verseOrgIds": [
              "ISA.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:18"
      },
      "items": [
        {
          "text": "ndipo kumeneko ndiko kudzatsalire magaleta ako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.18",
            "verseOrgIds": [
              "ISA.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:18"
      },
      "items": [
        {
          "text": "Ndipo udzasanduka wochititsa manyazi nyumba ya mbuye wako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.18",
            "verseOrgIds": [
              "ISA.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzakuchotsa pa ukapitawo wako",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.19",
            "verseOrgIds": [
              "ISA.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:19"
      },
      "items": [
        {
          "text": "ndipo ndidzakutsitsa pa udindo wako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.19",
            "verseOrgIds": [
              "ISA.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsiku limenelo ndidzayitanitsa mtumiki wanga, Eliyakimu mwana wa Hilikiya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.20",
            "verseOrgIds": [
              "ISA.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzamuveka mkanjo wako ndi kumangira lamba wako mʼchiwuno mwake ndi kumupatsa ulamuliro wako. Iye adzakhala kholo la amene amakhala mu Yerusalemu ndiponso a fuko la Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.21",
            "verseOrgIds": [
              "ISA.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzamupatsa ulamuliro wa banja la Davide. Adzatsekula ndipo palibe adzatseke, adzatseka popanda wina kutsekula.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.22",
            "verseOrgIds": [
              "ISA.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufumu wake udzakhala wokhazikika ngati chikhomo chokhomedwa pa malo olimba. Anthu adzalemekeza nyumba ya abale ake chifukwa cha iye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.23",
            "verseOrgIds": [
              "ISA.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ndi abale a nyumba ya abambo ake adzakhala ngati katundu pa iye ngati ziwiya zopanda ntchito zimene zapachikidwa pa chikhomo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.24",
            "verseOrgIds": [
              "ISA.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yehova Wamphamvuzonse akunena kuti, 'Tsiku limeneli chikhomo chokhomedwa kwambiri chija sichidzalimbanso; chidzazuka ndipo chidzagwa ndipo zonse zopachikidwa zidzawonongedwa.' \" Yehova wayankhula chomwechi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.25",
            "verseOrgIds": [
              "ISA.22.25"
            ]
          }
        }
      ]
    }
  ],
