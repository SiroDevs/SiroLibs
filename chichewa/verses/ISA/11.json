  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "ISA 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Ufumu Wamtendere wa Mesiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Padzatuluka mphukira pa tsinde la Yese",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:1"
      },
      "items": [
        {
          "text": "ndipo nthambi idzaphukira kuchokera ku mizu yake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mzimu wa Yehova udzakhala pa iye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:2"
      },
      "items": [
        {
          "text": "Mzimu wanzeru ndi wa kumvetsa zinthu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:2"
      },
      "items": [
        {
          "text": "Mzimu wauphungu ndi wamphamvu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:2"
      },
      "items": [
        {
          "text": "Mzimu wachidziwitso ndi wakuopa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo kuopa Yehova ndiye chidzakhale chinthu chomukondweretsa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 11:3"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:3"
      },
      "items": [
        {
          "text": "Iye sadzaweruza potsata zooneka pamaso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:3"
      },
      "items": [
        {
          "text": "kapena kugamula mlandu potsata zakumva;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma amphawi adzawaweruza mwachilungamo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "adzaweruza mwachilungamo mlandu wa anthu osauka a dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "Iye adzakantha dziko lapansi ndi mawu ake;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "atalamula Iyeyu anthu oyipa adzaphedwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chilungamo chidzakhala ngati lamba wake",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.5",
            "verseOrgIds": [
              "ISA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:5"
      },
      "items": [
        {
          "text": "ndipo kukhulupirika kudzakhala ngati chomangira mʼchiwuno mwake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.5",
            "verseOrgIds": [
              "ISA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmbulu udzakhala pamodzi ndi mwana wankhosa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "kambuku adzagona pansi pamodzi ndi mwana wambuzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "mwana wangʼombe ndi mwana wa mkango adzadyera limodzi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "ndipo mwana wamngʼono adzaziweta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼombe yayikazi ndi chimbalangondo zidzadya pamodzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:7"
      },
      "items": [
        {
          "text": "ana awo adzagona pamodzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:7"
      },
      "items": [
        {
          "text": "ndipo mkango udzadya udzu ngati ngʼombe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wakhanda adzasewera pa dzenje la mamba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.8",
            "verseOrgIds": [
              "ISA.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:8"
      },
      "items": [
        {
          "text": "ndipo mwana wamngʼono adzapisa dzanja lake ku phanga la mphiri osalumidwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.8",
            "verseOrgIds": [
              "ISA.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sipadzakhala chilichonse chopweteka kapena chowononga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "pa phiri lopatulika la Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "pakuti anthu a dziko lapansi adzadzaza ndi nzeru yotha kudziwa Yehova",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "monga momwe nyanja imadzazira ndi madzi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo mfumu yatsopano yochokera pa Muzu wa Yese idzakhala ngati chizindikiro kwa anthu a mitundu yonse. Mitundu ya anthu idzasonkhana kwa Iye, ndipo malo awo okhalapo adzakhala aulemerero.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo Ambuye adzatambasula dzanja lake kachiwiri kuti awombole anthu ake otsalira ku Asiriya, ku Igupto, ku Patirosi, Kusi, ku Elamu, ku Sinana, ku Hamati ndi pa zilumba za nyanja yamchere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.11",
            "verseOrgIds": [
              "ISA.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adzakwezera mitundu ya anthu mbendera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:12"
      },
      "items": [
        {
          "text": "ndipo adzasonkhanitsa otayika a ku Israeli;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:12"
      },
      "items": [
        {
          "text": "Iye adzasonkhanitsa anthu obalalika a ku Yuda",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:12"
      },
      "items": [
        {
          "text": "kuchokera ku mbali zonse zinayi za dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsanje ya Efereimu idzatha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:13"
      },
      "items": [
        {
          "text": "ndipo adani a Yuda adzatha;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:13"
      },
      "items": [
        {
          "text": "Efereimu sadzachitira nsanje Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:13"
      },
      "items": [
        {
          "text": "ngakhale Yuda sadzamuda Efereimu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda ndi Efereimu adzathira nkhondo pa Afilisti mbali ya kumadzulo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.14",
            "verseOrgIds": [
              "ISA.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
