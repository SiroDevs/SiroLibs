      "attrs": {
        "style": "q2",
        "vid": "ISA 57:17"
      },
      "items": [
        {
          "text": "ndinawalanga ndi kuwafulatira mokwiya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.17",
            "verseOrgIds": [
              "ISA.57.17"
            ]
          }
        }
