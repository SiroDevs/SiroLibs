      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:13"
      },
      "items": [
        {
          "text": "Phiri langa lopatulika lidzakhala lakelake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.13",
            "verseOrgIds": [
              "ISA.57.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mpumulo kwa Anthu Osweka Mtima",
          "type": "text"
        }
      ]
    },
    {
