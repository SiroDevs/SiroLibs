      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:20"
      },
      "items": [
        {
          "text": "yosatha kukhala bata,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.20",
            "verseOrgIds": [
              "ISA.57.20"
            ]
          }
        }
