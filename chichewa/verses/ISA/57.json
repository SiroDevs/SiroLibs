      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:13"
      },
      "items": [
        {
          "text": "adzalandira dziko lokhalamo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.13",
            "verseOrgIds": [
              "ISA.57.13"
            ]
          }
        }
      ]
