          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ndaonetsa poyera ntchito zanu zomwe mumati nʼzolungama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.12",
            "verseOrgIds": [
              "ISA.57.12"
            ]
          }
