      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:14"
      },
      "items": [
        {
          "text": "Chotsani zotchinga pa njira yoyendamo anthu anga.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.14",
            "verseOrgIds": [
              "ISA.57.14"
            ]
          }
        }
      ]
    },
    {
