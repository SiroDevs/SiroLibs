      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:11"
      },
      "items": [
        {
          "text": "ndakhala chete nthawi yayitali?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.11",
            "verseOrgIds": [
              "ISA.57.11"
            ]
          }
