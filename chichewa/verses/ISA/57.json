      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:14"
      },
      "items": [
        {
          "text": "\"Undani, undani, konzani msewu!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.14",
            "verseOrgIds": [
              "ISA.57.14"
            ]
          }
        }
      ]
