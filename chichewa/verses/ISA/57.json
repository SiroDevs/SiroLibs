          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Iye amene ali Wamkulu ndi Wopambanazonse,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.15",
            "verseOrgIds": [
              "ISA.57.15"
            ]
          }
