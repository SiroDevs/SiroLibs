      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:13"
      },
      "items": [
        {
          "text": "Koma munthu amene amadalira ine",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.13",
            "verseOrgIds": [
              "ISA.57.13"
            ]
          }
        }
