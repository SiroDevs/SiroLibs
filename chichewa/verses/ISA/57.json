      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:19"
      },
      "items": [
        {
          "text": "\"Ndipo ndidzawachiritsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.19",
            "verseOrgIds": [
              "ISA.57.19"
            ]
