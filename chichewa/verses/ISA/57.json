      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:15"
      },
      "items": [
        {
          "text": "amene alipo nthawi zonse, amene dzina lake ndi Woyerayo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.15",
            "verseOrgIds": [
              "ISA.57.15"
            ]
          }
        }
      ]
    },
