      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:12"
      },
      "items": [
        {
          "text": "ndi mafano anu kuti nʼzosathandiza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.12",
            "verseOrgIds": [
              "ISA.57.12"
            ]
          }
        }
      ]
    },
    {
