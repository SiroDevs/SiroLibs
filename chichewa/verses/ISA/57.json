      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:11"
      },
      "items": [
        {
          "text": "Kodi mwaleka kundiopa chifukwa choti",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.11",
            "verseOrgIds": [
              "ISA.57.11"
            ]
