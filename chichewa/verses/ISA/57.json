      "attrs": {
        "style": "q1",
        "vid": "ISA 57:11"
      },
      "items": [
        {
          "text": "ndipo Ine simundikumbukira nʼkomwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.11",
            "verseOrgIds": [
              "ISA.57.11"
            ]
