  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "ISA 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ufumu Wachilungamo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taonani, kudzakhala mfumu ina imene idzalamulira mwachilungamo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.1",
            "verseOrgIds": [
              "ISA.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:1"
      },
      "items": [
        {
          "text": "ndipo akalonga ake adzaweruza molungama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.1",
            "verseOrgIds": [
              "ISA.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu aliyense adzakhala ngati pothawirapo mphepo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:2"
      },
      "items": [
        {
          "text": "ndi malo obisalirapo namondwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:2"
      },
      "items": [
        {
          "text": "adzakhala ngati mitsinje ya mʼchipululu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:2"
      },
      "items": [
        {
          "text": "ngati mthunzi wa thanthwe lalikulu la mʼdziko lowuma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo maso a anthu openya sadzakhalanso otseka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.3",
            "verseOrgIds": [
              "ISA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:3"
      },
      "items": [
        {
          "text": "ndipo makutu a anthu akumva adzamvetsetsa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.3",
            "verseOrgIds": [
              "ISA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a mtima wopupuluma adzadziwa ndi kuchita zinthu mofatsa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.4",
            "verseOrgIds": [
              "ISA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:4"
      },
      "items": [
        {
          "text": "ndipo anthu ovutika kuyankhula adzayankhula mosadodoma ndi momveka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.4",
            "verseOrgIds": [
              "ISA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitsiru sichidzatchedwanso munthu waulemu wake",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.5",
            "verseOrgIds": [
              "ISA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:5"
      },
      "items": [
        {
          "text": "ndipo munthu woyipa sadzalemekezedwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.5",
            "verseOrgIds": [
              "ISA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti munthu opusa amayankhula zauchitsiru,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "amaganiza kuchita zoyipa:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "Iye amachita zoyipira Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "ndipo amafalitsa zolakwika zokhudza Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "anjala sawapatsa chakudya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "ndipo aludzu sawapatsa madzi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu woyipa njira zake ndi zoyipanso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:7"
      },
      "items": [
        {
          "text": "iye kwake nʼkulingalira zinthu zoyipa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:7"
      },
      "items": [
        {
          "text": "Amalingalira zakuti awononge anthu aumphawi ndi mabodza ake",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:7"
      },
      "items": [
        {
          "text": "ngakhale kuti waumphawiyo akuyankhula zoona.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma munthu wolemekezeka amalingaliranso kuchita zinthu zabwino,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.8",
            "verseOrgIds": [
              "ISA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:8"
      },
      "items": [
        {
          "text": "Iye amakhazikika pa zinthu zabwinozo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.8",
            "verseOrgIds": [
              "ISA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akazi a ku Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khalani maso, inu akazi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:9"
      },
      "items": [
        {
          "text": "amene mukungokhala wopanda kulingalira kuti kunja kulinji",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:9"
      },
      "items": [
        {
          "text": "ndipo imvani mawu anga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:9"
      },
      "items": [
        {
          "text": "Inu akazi odzitama, imvani zimene ndikunena!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakapita chaka ndi masiku pangʼono",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:10"
      },
      "items": [
        {
          "text": "inu akazi amatama mudzanjenjemera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:10"
      },
      "items": [
        {
          "text": "chifukwa mitengo ya mphesa idzakanika",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:10"
      },
      "items": [
        {
          "text": "ndipo zipatso sizidzaoneka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthunthumirani inu okhala mosatekesekanu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:11"
      },
      "items": [
        {
          "text": "ndipo njenjemerani, inu akazi omadzikhulupirira nokhanu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:11"
      },
      "items": [
        {
          "text": "Vulani zovala zanu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:11"
      },
      "items": [
        {
          "text": "ndipo valani ziguduli mʼchiwuno mwanu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzigugudeni pachifuwa mwachisoni chifukwa minda yachonde,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.12",
            "verseOrgIds": [
              "ISA.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:12"
      },
      "items": [
        {
          "text": "ndi mphesa yawonongeka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.12",
            "verseOrgIds": [
              "ISA.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼdziko la anthu anga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.13",
            "verseOrgIds": [
              "ISA.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:13"
      },
      "items": [
        {
          "text": "mwamera minga ndi mkandankhuku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.13",
            "verseOrgIds": [
              "ISA.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:13"
      },
      "items": [
        {
          "text": "Zoona, mulilire nyumba zonse zachikondwerero",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.13",
            "verseOrgIds": [
              "ISA.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:13"
      },
      "items": [
        {
          "text": "ndi mzinda uno umene unali wachisangalalo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.13",
            "verseOrgIds": [
              "ISA.32.13"
            ]
          }
        }
      ]
    },
    {
