      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:15"
      },
      "items": [
        {
          "text": "ndipo dziko lachipululu lidzasanduka munda wachonde,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.15",
            "verseOrgIds": [
              "ISA.32.15"
            ]
          }
        }
      ]
