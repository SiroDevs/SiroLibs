          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumba yaufumu idzasiyidwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.14",
            "verseOrgIds": [
              "ISA.32.14"
            ]
          }
        }
