      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:14"
      },
      "items": [
        {
          "text": "mzinda waphokoso udzakhala wopanda anthu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.14",
            "verseOrgIds": [
              "ISA.32.14"
            ]
          }
        }
      ]
