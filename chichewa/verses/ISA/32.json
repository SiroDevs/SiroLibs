      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:14"
      },
      "items": [
        {
          "text": "malinga ndi nsanja zidzasanduka chipululu mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.14",
            "verseOrgIds": [
              "ISA.32.14"
            ]
          }
