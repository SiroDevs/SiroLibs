      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:14"
      },
      "items": [
        {
          "text": "Abulu adzasangalalamo ndipo ziweto zidzapezamo msipu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.14",
            "verseOrgIds": [
