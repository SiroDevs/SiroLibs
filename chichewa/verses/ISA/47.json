      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:13"
      },
      "items": [
        {
          "text": "Abwere amene amayangʼana nyenyezi, ndi kumalosera mwezi ndi mwezi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
        }
      ]
    },
