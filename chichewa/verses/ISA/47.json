      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:14"
      },
      "items": [
        {
          "text": "ku mphamvu ya malawi a moto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
