      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:15"
      },
      "items": [
        {
          "text": "ndi kuchita nawo malonda chiyambire cha ubwana wako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.15",
            "verseOrgIds": [
              "ISA.47.15"
            ]
          }
        }
