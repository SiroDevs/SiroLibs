      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:12"
      },
      "items": [
        {
          "text": "kapena kuopsezera nazo adani ako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.12",
            "verseOrgIds": [
              "ISA.47.12"
            ]
          }
        }
      ]
