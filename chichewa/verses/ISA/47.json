      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:13"
      },
      "items": [
        {
          "text": "Abwere patsogolopa anthu amene amatanthauzira za kumwamba kuti adzakupulumutseni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
        }
      ]
    },
    {
