      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:15"
      },
      "items": [
        {
          "text": "anthu amene wakhala ukugwira nawo ntchito",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.15",
            "verseOrgIds": [
              "ISA.47.15"
