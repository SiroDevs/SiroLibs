      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:14"
      },
      "items": [
        {
          "text": "adzapsa ndi moto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:14"
      },
      "items": [
        {
          "text": "Sangathe kudzipulumutsa okha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
