      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyimbo ya Matamando",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo anthu a mʼdziko la Yuda adzayimba nyimbo iyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:1"
      },
      "items": [
        {
          "text": "Tili ndi mzinda wolimba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:1"
      },
      "items": [
        {
          "text": "Mulungu amawuteteza ndi zipupa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:1"
      },
      "items": [
        {
          "text": "ndi malinga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsekulani zipata za mzinda",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:2"
      },
      "items": [
        {
          "text": "kuti mtundu wolungama",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:2"
      },
      "items": [
        {
          "text": "ndi wokhulupirika ulowemo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mudzamupatsa munthu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:3"
      },
      "items": [
        {
          "text": "wa mtima wokhazikika",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:3"
      },
      "items": [
        {
          "text": "mtendere weniweni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudalireni Yehova mpaka muyaya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.4",
            "verseOrgIds": [
              "ISA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:4"
      },
      "items": [
        {
          "text": "chifukwa Yehova Mulungu ndiye Thanthwe losatha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.4",
            "verseOrgIds": [
              "ISA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amatsitsa anthu amene amadziyika pamwamba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:5"
      },
      "items": [
        {
          "text": "iye amagwetsa pansi mzinda wodzitukumula,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:5"
      },
      "items": [
        {
          "text": "amagumula makoma ake",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:5"
      },
      "items": [
        {
          "text": "ndi kuwagwetsa pansi pa fumbi penipeni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapazi a anthu akuwupondereza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.6",
            "verseOrgIds": [
              "ISA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:6"
      },
      "items": [
        {
          "text": "mapazi a anthu oponderezedwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.6",
            "verseOrgIds": [
              "ISA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:6"
      },
      "items": [
        {
          "text": "mapazi anthu osauka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.6",
            "verseOrgIds": [
              "ISA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njira ya munthu wolungama ndi yosalaza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.7",
            "verseOrgIds": [
              "ISA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:7"
      },
      "items": [
        {
          "text": "Inu Wolungamayo, mumasalaza njira ya wolungama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.7",
            "verseOrgIds": [
              "ISA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inde Yehova, timayenda mʼnjira zanu zolungama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:8"
      },
      "items": [
        {
          "text": "ife timayembekezera Inu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:8"
      },
      "items": [
        {
          "text": "mitima yathu imakhumba kukumbukira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:8"
      },
      "items": [
        {
          "text": "ndi kulemekeza dzina lanu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyo wanga umalakalaka Inu usiku wonse;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:9"
      },
      "items": [
        {
          "text": "nthawi yammawa ndimafunafuna Inu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:9"
      },
      "items": [
        {
          "text": "Pamene muweruza dziko lapansi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:9"
      },
      "items": [
        {
          "text": "anthu amaphunzira kuchita chilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale mukomere mtima anthu oyipa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:10"
      },
      "items": [
        {
          "text": "saphunzira chilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:10"
      },
      "items": [
        {
          "text": "Amachita zoyipa mʼdziko la chilungamo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:10"
      },
      "items": [
        {
          "text": "ndipo sazindikira ululu wa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, mwatukula dzanja lanu kuti muwalange,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.11",
            "verseOrgIds": [
              "ISA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:11"
      },
      "items": [
        {
          "text": "koma iwo sakuliona dzanjalo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.11",
            "verseOrgIds": [
              "ISA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:11"
      },
      "items": [
        {
          "text": "Aloleni anthu aone ndi kuchita manyazi poona mmene mukondera anthu anu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.11",
            "verseOrgIds": [
              "ISA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:11"
      },
      "items": [
        {
          "text": "ndipo moto umene mwasonkhera adani anu uwapsereze.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.11",
            "verseOrgIds": [
              "ISA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova, mumatipatsa mtendere;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.12",
            "verseOrgIds": [
              "ISA.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:12"
      },
      "items": [
        {
          "text": "ndipo zonse zimene ife tinazichita munatichitira ndinu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.12",
            "verseOrgIds": [
              "ISA.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova Mulungu wathu, ngakhale takhala tikulamulidwa ndi ena mʼmalo mwanu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.13",
            "verseOrgIds": [
              "ISA.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:13"
      },
      "items": [
        {
          "text": "koma ife timalemekeza dzina lanu lokha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.13",
            "verseOrgIds": [
              "ISA.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
