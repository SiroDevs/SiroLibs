  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "MAT 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Afarisi ndi Asaduki Afuna Chizindikiro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afarisi ndi Asaduki anabwera kwa Yesu ndi kumuyesa pomufunsa kuti awaonetse chizindikiro chochokera kumwamba.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.1",
            "verseOrgIds": [
              "MAT.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.2",
            "verseOrgIds": [
              "MAT.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kunja kukamada, inu mumati, kudzakhala nyengo yabwino popeza thambo ndi lofiira.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.2",
                "verseOrgIds": [
                  "MAT.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.2",
            "verseOrgIds": [
              "MAT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo mmawa mumati, 'Lero kudzakhala mvula yamphepo popeza thambo ndi lofiira ndi mitambo ya mvula.' Inu mumadziwa kutanthauzira maonekedwe a thambo koma simungathe kutanthauzira zizindikiro za nthawi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.3",
                "verseOrgIds": [
                  "MAT.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.3",
            "verseOrgIds": [
              "MAT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mʼbado woyipa ndi wachigololo umafuna chizindikiro chodabwitsa koma palibe ngakhale chimodzi chidzapatsidwa kupatula chizindikiro cha Yona.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.4",
                "verseOrgIds": [
                  "MAT.16.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Pamenepo Yesu anawasiya nachoka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.4",
            "verseOrgIds": [
              "MAT.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yisiti wa Afarisi ndi Asaduki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma atawoloka nyanja, ophunzira anayiwala kutenga buledi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.5",
            "verseOrgIds": [
              "MAT.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anawawuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.6",
            "verseOrgIds": [
              "MAT.16.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chenjerani, khalani tcheru ndi yisiti wa Afarisi ndi Asaduki.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.6",
                "verseOrgIds": [
                  "MAT.16.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anakambirana pakati pawo za izi ndipo anati, \"Ichi nʼchifukwa chakuti sitinatenge buledi aliyense.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.7",
            "verseOrgIds": [
              "MAT.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu atadziwa zokambirana zawo, anawafunsa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.8",
            "verseOrgIds": [
              "MAT.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chifukwa chiyani mukukambirana zakuti, 'mulibe buledi?' Inu achikhulupiriro chochepa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.8",
                "verseOrgIds": [
                  "MAT.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.8",
            "verseOrgIds": [
              "MAT.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kodi inu simukumvetsetsabe? Kodi simukukumbukira za buledi musanu amene anadya anthu 5,000 ndi madengu amene munadzaza?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.9",
                "verseOrgIds": [
                  "MAT.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.9",
            "verseOrgIds": [
              "MAT.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kapena buledi musanu ndi muwiri amene anadya anthu 4,000, nanga ndi madengu angati amene munadzaza?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.10",
                "verseOrgIds": [
                  "MAT.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.10",
            "verseOrgIds": [
              "MAT.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zitheka bwanji kuti inu simukumvetsetsa kuti Ine sindinkayankhula nanu za buledi? Koma inu chenjerani ndi yisiti wa Afarisi ndi Asaduki.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.11",
                "verseOrgIds": [
                  "MAT.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.11",
            "verseOrgIds": [
              "MAT.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka iwo anazindikira kuti Iye samawawuza kuti achenjere ndi yisiti wa buledi koma ndi chiphunzitso cha Afarisi ndi Asaduki.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.12",
            "verseOrgIds": [
              "MAT.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petro Avomereza za Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu atafika ku chigawo cha Kaisareya Filipo, Iye anafunsa ophunzira ake kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.13",
            "verseOrgIds": [
              "MAT.16.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi anthu amati Mwana wa Munthu ndi ndani?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.13",
                "verseOrgIds": [
                  "MAT.16.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anayankha kuti, \"Ena amati ndi Yohane Mʼbatizi; ena amati ndi Eliya; komanso ena amati Yeremiya kapena mmodzi wa aneneri.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.14",
            "verseOrgIds": [
              "MAT.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anafunsa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.15",
            "verseOrgIds": [
              "MAT.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nanga inuyo mumati ndine yani?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.15",
                "verseOrgIds": [
                  "MAT.16.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petro anayankha kuti, \"Inu ndinu Khristu, Mwana wa Mulungu wamoyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.16",
            "verseOrgIds": [
              "MAT.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anati kwa iye,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.17",
            "verseOrgIds": [
              "MAT.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndiwe wodala Simoni mwana wa Yona, popeza si munthu amene anakuwululira izi koma Atate anga akumwamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.17",
                "verseOrgIds": [
                  "MAT.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.17",
            "verseOrgIds": [
              "MAT.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo Ine ndikuwuza iwe kuti ndiwe Petro ndipo pa thanthwe ili Ine ndidzamangapo mpingo wanga ndipo makomo a ku gehena sadzawugonjetsa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.18",
                "verseOrgIds": [
                  "MAT.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.18",
            "verseOrgIds": [
              "MAT.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndidzakupatsa makiyi a Ufumu wakumwamba, ndipo chilichonse chimene iwe udzachimanga pansi pano chidzamangidwanso kumwamba.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.19",
                "verseOrgIds": [
                  "MAT.16.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.19",
            "verseOrgIds": [
              "MAT.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Iye anachenjeza ophunzira ake kuti asawuze wina aliyense kuti ndi Khristu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.20",
            "verseOrgIds": [
              "MAT.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Aneneratu za Imfa Yake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyambira nthawi imeneyo Yesu anayamba kuwafotokozera ophunzira ake kuti Iye ayenera kupita ku Yerusalemu ndi kukazunzidwa kwambiri mʼmanja mwa akulu a ansembe ndi aphunzitsi amalamulo kuti ayenera kuphedwa, ndi kuti tsiku lachitatu adzaukitsidwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.21",
            "verseOrgIds": [
              "MAT.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro anamutengera Iye pambali nayamba kumudzudzula kuti, \"Dzichitireni chifundo Ambuye, sizingachitike kwa Inu ayi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.22",
            "verseOrgIds": [
              "MAT.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anatembenuka nati kwa Petro,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.23",
            "verseOrgIds": [
              "MAT.16.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Choka pamaso panga Satana! Iwe ndi chokhumudwitsa kwa Ine; iwe suganizira zinthu za Mulungu koma zinthu za anthu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.23",
                "verseOrgIds": [
                  "MAT.16.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Kusenza Mtanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yesu anati kwa ophunzira ake,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.24",
            "verseOrgIds": [
              "MAT.16.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngati wina aliyense abwera pambuyo panga ayenera kudzikana ndi kutenga mtanda wake ndi kunditsata Ine.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.24",
                "verseOrgIds": [
                  "MAT.16.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.24",
            "verseOrgIds": [
              "MAT.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti aliyense amene afuna kupulumutsa moyo wake adzawutaya koma aliyense amene ataya moyo wake chifukwa cha Ine adzawupeza.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.25",
                "verseOrgIds": [
                  "MAT.16.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.25",
            "verseOrgIds": [
              "MAT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kodi munthu adzapindula chiyani ngati atapeza zonse za dziko lapansi nataya moyo wake? Kapena munthu angapereke chiyani chosinthana ndi moyo wake?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.26",
                "verseOrgIds": [
                  "MAT.16.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.26",
            "verseOrgIds": [
              "MAT.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti Mwana wa Munthu adzabwera mu ulemerero wa Atate ake ndi angelo ake ndipo pamenepo Iye adzapereka mphotho kwa munthu mofanana ndi zimene anachita.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.27",
                "verseOrgIds": [
                  "MAT.16.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ine ndikuwuzani inu choonadi, ena amene akuyimirira pano sadzalawa imfa asanaone Mwana wa Munthu akudza mu ufumu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.28",
