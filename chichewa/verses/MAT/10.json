          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Aliyense amene avomereza Ine pamaso pa anthu, Inenso ndidzavomereza pamaso pa Atate anga akumwamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.32",
                "verseOrgIds": [
                  "MAT.10.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.32",
            "verseOrgIds": [
              "MAT.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma iye amene andikana Ine pamaso pa anthu, Inenso ndidzamukana pamaso pa Atate anga akumwamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.33",
                "verseOrgIds": [
                  "MAT.10.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 10:34"
          },
          "items": [
