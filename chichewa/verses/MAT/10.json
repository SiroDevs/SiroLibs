              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Musaganize kuti Ine ndabweretsa mtendere pa dziko lapansi. Sindinabwere kudzapereka mtendere koma lupanga.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.34",
                "verseOrgIds": [
                  "MAT.10.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.34",
            "verseOrgIds": [
              "MAT.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti Ine ndabwera kudzalekanitsa",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Munthu ndi abambo ake,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mwana wamkazi ndi amayi ake,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mtengwa kulekanitsidwa ndi apongozi ake,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
