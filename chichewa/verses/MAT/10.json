          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "adani a munthu adzakhala a mʼbanja mwake momwe.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.36",
                "verseOrgIds": [
                  "MAT.10.36"
                ]
              }
            }
          ]
        }
