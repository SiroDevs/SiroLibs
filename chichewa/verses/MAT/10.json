    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Aliyense amene akonda abambo kapena amayi ake koposa Ine sayenera kukhala wanga; aliyense amene akonda mwana wake wamwamuna kapena wamkazi koposa Ine sayenera kukhala wanga.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.37",
                "verseOrgIds": [
                  "MAT.10.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.37",
            "verseOrgIds": [
              "MAT.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Aliyense amene satenga mtanda wake ndi kunditsata Ine sayenera kukhala wanga.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.38",
                "verseOrgIds": [
                  "MAT.10.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.38",
            "verseOrgIds": [
              "MAT.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Aliyense amene asunga moyo wake adzawutaya koma aliyense amene ataya moyo chifukwa cha Ine adzawupeza.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.39",
                "verseOrgIds": [
                  "MAT.10.39"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Iye amene alandira inu alandira Ine, ndipo amene alandira Ine alandiranso amene anandituma Ine.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.40",
                "verseOrgIds": [
                  "MAT.10.40"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.40",
            "verseOrgIds": [
              "MAT.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Aliyense amene alandira mneneri chifukwa chakuti ndi mneneri alandira mphotho ya mneneri, ndipo aliyense amene alandira munthu wolungama chifukwa chakuti ndi munthu wolungama, adzalandira mphotho ya wolungama.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.41",
                "verseOrgIds": [
                  "MAT.10.41"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.41",
            "verseOrgIds": [
              "MAT.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati aliyense apereka madzi ozizira a mʼchikho kwa mmodzi wa angʼonoangʼono awa chifukwa cha kuti ndi ophunzira anga, ndikuwuzani zoona, ndithudi sadzataya mphotho yake.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.42",
                "verseOrgIds": [
                  "MAT.10.42"
                ]
              }
            }
          ]
        }
      ]
