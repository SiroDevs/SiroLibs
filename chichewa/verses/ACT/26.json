  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "ACT 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawu a Paulo Pamaso pa Mfumu Agripa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Agripa anawuza Paulo kuti, \"Takulola kuti unene mawu ako.\" Paulo anatambasula dzanja lake nayamba kudziteteza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.1",
            "verseOrgIds": [
              "ACT.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mfumu Agripa ine ndikudziyesa wa mwayi kuyima pamaso panu lero lino ndi kudziteteza, kutsutsa zonse zimene Ayuda andinenera,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.2",
            "verseOrgIds": [
              "ACT.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo makamaka chifukwa inu mukudziwa bwino miyambo yonse ya Chiyuda ndiponso zonse zimene amatsutsana. Nʼchifukwa chake ndikukupemphani kuti mundimvetsere moleza mtima.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.3",
            "verseOrgIds": [
              "ACT.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ayuda onse akudziwa za moyo wanga mmene ndakhalira kuyambira ndili mwana, kuchokera pachiyambi cha moyo wanga mʼdziko lathu ndiponso mu Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.4",
            "verseOrgIds": [
              "ACT.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo akundidziwa kuyambira kalekale ndipo angathe kuchitira umboni kuti ndakhala ndili Mfarisi moyo wanga wonse, mmodzi wa gulu limene limasamala chipembedzo chathu koposa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.5",
            "verseOrgIds": [
              "ACT.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo tsopano ndikuyimbidwa mlandu lero chifukwa cha chiyembekezo changa pa zimene Mulungu analonjeza makolo athu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.6",
            "verseOrgIds": [
              "ACT.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ili ndi lonjezo limene mafuko athu khumi ndi awiri akuyembekezera kuti likwaniritsidwe pamene akupembedza Mulungu molimbika usana ndi usiku. Wolemekezeka Mfumu, nʼchifukwa cha chiyembekezo chimenechi Ayuda kuti akundiyimba mlandu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.7",
            "verseOrgIds": [
              "ACT.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chiyani ena a inu mukuganiza kuti nʼkosatheka kuti Mulungu aukitse akufa?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.8",
            "verseOrgIds": [
              "ACT.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inenso ndimaganiza kuti ndimayenera kuchita zinthu zambiri pofuna kuthana ndi dzina la Yesu wa ku Nazareti.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.9",
            "verseOrgIds": [
              "ACT.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo izi ndi zimene ndinazichita ku Yerusalemu. Ndi ulamuliro wa akulu a ansembe, ine ndinayika mʼndende oyera mtima ambiri, ndipo pamene amaphedwa, ine ndimavomereza.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.10",
            "verseOrgIds": [
              "ACT.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi zambiri ndinkapita mʼsunagoge iliyonse kuti alangidwe, ndipo ndinayesera kuwakakamiza kuti achitire chipongwe Mulungu. Mu mkwiyo wangawo, ndimapita ngakhale ku mizinda yachilendo kuti ndikawazunze.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.11",
            "verseOrgIds": [
              "ACT.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pa ulendo wina wotere, ndikupita ku Damasiko ndi mphamvu ndi ulamuliro ochokera kwa akulu a ansembe,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.12",
            "verseOrgIds": [
              "ACT.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wolemekezeka Mfumu, nthawi ya masana pamene ndimayenda pa msewu, ndinaona kuwala kuchokera kumwamba koposa kuwala kwa dzuwa kutandizungulira ine pamodzi ndi anzangawo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.13",
            "verseOrgIds": [
              "ACT.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonse tinagwa pansi ndipo ndinamva mawu mʼChihebri akuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.14",
            "verseOrgIds": [
              "ACT.26.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Saulo, Saulo chifukwa chiyani ukundizunza Ine? Nʼkovuta kulimbikira mtunda wopanda madzi.' \"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.26.14",
                "verseOrgIds": [
                  "ACT.26.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ine ndinafunsa kuti, \"Ndinu ndani Ambuye?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.15",
            "verseOrgIds": [
              "ACT.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 26:15"
      },
      "items": [
        {
          "text": "Ambuye anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.15",
            "verseOrgIds": [
              "ACT.26.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndine Yesu, amene iwe ukumuzunza.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.26.15",
                "verseOrgIds": [
                  "ACT.26.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.15",
            "verseOrgIds": [
              "ACT.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tsopano dzuka ndipo imirira. Ine ndaonekera kwa iwe kuti ndikusankhe kuti ukhale mtumiki ndiponso mboni ya zimene waziona za Ine ndiponso zimene ndidzakuonetsa.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.26.16",
                "verseOrgIds": [
                  "ACT.26.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.16",
            "verseOrgIds": [
              "ACT.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndidzakulanditsa mʼmanja mwa anthu a mtundu wako ndiponso mwa anthu a mitundu ina. Ine ndikukutuma kwa iwo,",
              "type": "text",
              "attrs": {
                "verseId": "ACT.26.17",
                "verseOrgIds": [
                  "ACT.26.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.17",
            "verseOrgIds": [
              "ACT.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kuti ukatsekule maso awo kuti atembenuke mtima kuchoka ku mdima ndi kulowa mʼkuwala, kuchoka ku mphamvu za Satana ndi kupita kwa Mulungu, kuti alandire chikhululukiro cha machimo awo ndi kukhala mʼgulu la amene akuyeretsedwa chifukwa chokhulupirira Ine.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.26.18",
                "verseOrgIds": [
                  "ACT.26.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼchifukwa chake Mfumu Agripa, sindinakane kumvera masomphenya wochokera kumwamba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.19",
            "verseOrgIds": [
              "ACT.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyambira kwa anthu a ku Damasiko, a ku Yerusalemu, a ku Yudeya konse ndi kwa anthu a mitundu inanso, ndinalalikira kuti akuyenera kulapa ndi kutembenukira kwa Mulungu ndikuti aonetse kulapa kwawo mwa ntchito zawo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.20",
            "verseOrgIds": [
              "ACT.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi nʼchifukwa chake Ayuda anandigwira mʼbwalo la Nyumba ya Mulungu nafuna kundipha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.21",
            "verseOrgIds": [
              "ACT.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Mulungu wakhala akundithandiza mpaka lero lino. Ine ndayima pano kuti ndichitire umboni kwa anthu onse otchuka ndi anthu wamba. Ine sindikunena zina zowonjezera koma zimene Aneneri ndi Mose ananena kuti zidzachitika.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.22",
            "verseOrgIds": [
              "ACT.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo ananena kuti Khristu adzamva zowawa ndipo popeza Iye adzakhala woyamba kuuka kwa akufa, adzalalikira za kuwunika kwa anthu a mtundu wake ndiponso kwa anthu a mitundu ina.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.23",
            "verseOrgIds": [
              "ACT.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo akudziteteza, Festo anakweza mawu nati, \"Wazungulira mutu Paulo! Kuphunzira kwako kwakuchititsa misala.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.24",
            "verseOrgIds": [
              "ACT.26.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo anayankha nati, \"Wolemekezeka Festo, sindine wozungulira mutu. Zimene ndikunena ndi zoona ndiponso za nzeru.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.25",
            "verseOrgIds": [
              "ACT.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu ikuzidziwa bwino zinthu izi, ndipo ndikuyankhula momasuka kwa iyo. Ine ndikukhulupirira kuti palibe kanthu nʼkamodzi komwe kamene sukukadziwa, chifukwa izi sizinachike mseri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.26",
            "verseOrgIds": [
              "ACT.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu Agripa, kodi mumakhulupirira mawu a aneneri? Ine ndikudziwa kuti mumakhulupirira.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.27",
            "verseOrgIds": [
              "ACT.26.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Agripa anati kwa Paulo, \"Kodi ukuganiza kuti mʼkanthawi kochepa kotere ungandikope kuti ndikhale Mkhristu?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.28",
            "verseOrgIds": [
              "ACT.26.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo anayankha kuti, \"Ngakhale kanthawi kochepa kapena nthawi yayitali, ine ndikupempha kwa Mulungu kuti osati inu nokha koma aliyense amene akundimva lero lino akhale monga ine, kupatulapo maunyolo okhawa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.29",
            "verseOrgIds": [
              "ACT.26.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inayimirira pamodzi ndi bwanamkubwa ndi Bernisi ndiponso anthu onse amene anakhala nawo pamodzi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.30",
            "verseOrgIds": [
              "ACT.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inatuluka mʼchipindamo, ndipo pamene imayankhula inati, \"Munthu uyu sanachite kanthu koyenera kuphedwa kapena kumangidwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.31",
            "verseOrgIds": [
              "ACT.26.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agripa anati kwa Festo, \"Munthu uyu akanamasulidwa akanakhala kuti sanapemphe zokaonekera kwa Kaisara.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.32",
            "verseOrgIds": [
              "ACT.26.32"
            ]
          }
        }
      ]
    }
