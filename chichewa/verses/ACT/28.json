          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molimba mtima ndi popanda womuletsa, Paulo analalikira za ufumu wa Mulungu ndi kuphunzitsa za Ambuye Yesu Khristu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.31",
