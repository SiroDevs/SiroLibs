          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo anakhala kumeneko zaka ziwiri zathunthu mʼnyumba yobwereka yomwe amalipira ndipo ankalandira aliyense amene amabwera kudzamuona.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.30",
            "verseOrgIds": [
              "ACT.28.30"
            ]
          }
        },
        {
