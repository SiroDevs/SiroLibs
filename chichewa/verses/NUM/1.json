          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kalembera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anayankhula ndi Mose mʼchipululu cha Sinai, mu tenti ya msonkhano, pa tsiku loyamba la mwezi wachiwiri, mʼchaka chachiwiri atatuluka mu Igupto, kuti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.1",
            "verseOrgIds": [
              "NUM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Werengani Aisraeli onse mʼmafuko awo ndi mʼmabanja awo, lemba dzina la munthu wamwamuna aliyense, mmodzimmodzi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.2",
            "verseOrgIds": [
              "NUM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe ndi Aaroni mwawerenge mwa magulu awo mu Israeli, amuna onse a zaka makumi awiri zakubadwa ndi opitirirapo omwe angathe kugwira ntchito ya usilikali.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.3",
            "verseOrgIds": [
              "NUM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu mmodzi wochokera ku fuko lililonse yemwe ndi mtsogoleri wa banja lake, ndiye akuthandizeni pa ntchitoyi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.4",
            "verseOrgIds": [
              "NUM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayina a anthu amene akuthandizeniwo ndi awa:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.5",
            "verseOrgIds": [
              "NUM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NUM 1:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NUM 1:5"
      },
      "items": [
        {
          "text": "Elizuri mwana wa Sedeuri, kuchokera ku fuko la Rubeni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.5",
            "verseOrgIds": [
              "NUM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Selumieli mwana wa Zurisadai, kuchokera ku fuko la Simeoni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.6",
            "verseOrgIds": [
              "NUM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naasoni mwana wa Aminadabu, kuchokera ku fuko la Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.7",
            "verseOrgIds": [
              "NUM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netanieli mwana wa Zuwara, kuchokera ku fuko la Isakara,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.8",
            "verseOrgIds": [
              "NUM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliabu mwana wa Heloni, kuchokera ku fuko la Zebuloni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.9",
            "verseOrgIds": [
              "NUM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa ana a Yosefe:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.10",
            "verseOrgIds": [
              "NUM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 1:10"
      },
      "items": [
        {
          "text": "kuchokera ku fuko la Efereimu, Elisama mwana wa Amihudi;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.10",
            "verseOrgIds": [
              "NUM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 1:10"
      },
      "items": [
        {
          "text": "kuchokera ku fuko la Manase, Gamalieli mwana wa Pedazuri;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.10",
            "verseOrgIds": [
              "NUM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abidani mwana wa Gideoni, kuchokera ku fuko la Benjamini,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.11",
            "verseOrgIds": [
              "NUM.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiyezeri mwana wa Amisadai, kuchokera ku fuko la Dani,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.12",
            "verseOrgIds": [
              "NUM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pagieli mwana wa Okirani, kuchokera ku fuko la Aseri,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.13",
            "verseOrgIds": [
              "NUM.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyasafu mwana wa Deuweli, kuchokera ku fuko la Gadi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.14",
            "verseOrgIds": [
              "NUM.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahira mwana wa Enani, kuchokera ku fuko la Nafutali.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.15",
            "verseOrgIds": [
              "NUM.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amenewa ndi anthu amene anasankhidwa kuchokera mʼmagulu mwawo, eni mbumba a mafuko a makolo awo. Iwowa anali atsogoleri a mafuko a Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.16",
            "verseOrgIds": [
              "NUM.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ndi Aaroni anatenga anthu amene mayina awo anaperekedwa,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.17",
            "verseOrgIds": [
              "NUM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo pa tsiku loyamba la mwezi wachiwiri, anasonkhanitsa anthu onse pamodzi. Anthuwo anafotokoza za makolo awo mwa mafuko awo ndi mabanja awo. Ndipo mayina a amuna onse amene anali ndi zaka makumi awiri kapena kupitirirapo analembedwa, mmodzimmodzi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.18",
            "verseOrgIds": [
              "NUM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "monga momwe Yehova analamulira Mose. Motero iyeyo anawawerenga mʼchipululu cha Sinai:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.19",
            "verseOrgIds": [
              "NUM.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchokera mwa ana a Rubeni, mwana wamwamuna woyamba wa Israeli:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 1:20"
      },
      "items": [
        {
          "text": "Amuna onse a zaka makumi awiri kapena kupitirirapo, omwe akanatha kugwira ntchito ya usilikali, anawalemba mayina awo, mmodzimmodzi monga mwa mbiri ya mafuko awo ndi mabanja awo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwerengero cha anthu ochokera mʼfuko la Rubeni chinali 46,500.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchokera mwa zidzukulu za Simeoni:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 1:22"
      },
      "items": [
        {
          "text": "Amuna onse a zaka makumi awiri kapena kupitirirapo, omwe akanatha kugwira ntchito ya usilikali anawalemba mayina awo, mmodzimmodzi monga mwa mbiri ya mafuko awo ndi mabanja awo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwerengero cha anthu ochokera mʼfuko la Simeoni chinali 59,300.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.23",
            "verseOrgIds": [
              "NUM.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchokera mwa zidzukulu za Gadi:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.24",
            "verseOrgIds": [
              "NUM.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 1:24"
      },
      "items": [
        {
          "text": "Amuna onse a zaka makumi awiri kapena kupitirirapo, omwe akanatha kugwira ntchito ya usilikali anawalemba mayina awo monga mwa mbiri ya mafuko awo ndi mabanja awo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.24",
            "verseOrgIds": [
              "NUM.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwerengero cha anthu ochokera mʼfuko la Gadi chinali 45, 650.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.25",
            "verseOrgIds": [
              "NUM.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
