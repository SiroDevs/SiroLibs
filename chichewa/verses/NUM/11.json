          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchoka pa Kibiroti Hatava anthuwo anayenda kupita ku Heziroti ndipo anakhala kumeneko kwa kanthawi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.35",
