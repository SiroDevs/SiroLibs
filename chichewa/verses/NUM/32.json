  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "NUM 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mafuko a ku Tsidya la Yorodani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arubeni ndi Agadi amene anali ndi ngʼombe zambiri ndi ziweto zina anaona dziko la Yazeri ndi la Giliyadi kuti linali labwino kwa ziwetozo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.1",
            "verseOrgIds": [
              "NUM.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Arubeni ndi Agadi anapita kwa Mose ndi kwa wansembe Eliezara ndi kwa atsogoleri a anthu ndi kunena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.2",
            "verseOrgIds": [
              "NUM.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ataroti, Diboni, Yazeri, Nimira, Hesiboni, Eleali, Sebamu, Nebo ndi Beoni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.3",
            "verseOrgIds": [
              "NUM.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "dziko lomwe Yehova anagonjetsa pamaso pa Aisraeli, ndiwo malo woyenera ziweto, ndipo atumiki anufe tili ndi ziweto.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.4",
            "verseOrgIds": [
              "NUM.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anati, 'Ngati tapeza ufulu pamaso panu atumiki anufe, mutipatse dziko limeneli kuti likhale lathu. Tisawoloke nanu Yorodani.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.5",
            "verseOrgIds": [
              "NUM.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mose anati kwa Agadi ndi Arubeni, \"Kodi anthu a mtundu wanu apite ku nkhondo inu mutangokhala kuno?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.6",
            "verseOrgIds": [
              "NUM.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa chiyani mukufowoketsa Aisraeli kupita mʼdziko limene Yehova wawapatsa?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.7",
            "verseOrgIds": [
              "NUM.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izi ndi zimene makolo anu anachita pamene ndinawatuma kuchokera ku Kadesi kukaona dzikolo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.8",
            "verseOrgIds": [
              "NUM.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atapita ku chigwa cha Esikolo, ndi kuliona dzikolo, anafowoketsa Aisraeli kuti asalowe mʼdziko limene Yehova anawapatsa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.9",
            "verseOrgIds": [
              "NUM.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anakwiya tsiku limenelo ndipo analumbira kuti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.10",
            "verseOrgIds": [
              "NUM.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Chifukwa sananditsatire ndi mtima wonse, palibe ndi mmodzi yemwe mwa amuna a zaka makumi awiri kapena kuposa pamenepo, amene anachokera ku Igupto, amene adzaone dziko limene ndinalonjeza mwa lumbiro kwa Abrahamu, Isake ndi Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.11",
            "verseOrgIds": [
              "NUM.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palibe ndi mmodzi yemwe kupatula Kalebe mwana wa Yefune, Mkeni, ndi Yoswa mwana wa Nuni chifukwa anatsatira Yehova ndi mtima wonse.'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.12",
            "verseOrgIds": [
              "NUM.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anakwiyira Aisraeli kwambiri ndipo anawachititsa kuyenda mʼchipululu zaka makumi anayi, mpaka mʼbado wonse wa anthu amene anachita choyipa pamaso pake unatha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.13",
            "verseOrgIds": [
              "NUM.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndipo onani tsopano, inu mʼbado wochimwa, mwalowa mʼmalo mwa makolo anu ndipo mwachititsa kuti Yehova akwiyire Israeli kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.14",
            "verseOrgIds": [
              "NUM.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati muleka kumutsata, Iye adzawasiyiranso anthu onsewa mʼchipululu ndipo mudzawonongetsa anthu onsewa.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.15",
            "verseOrgIds": [
              "NUM.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo iwo anabwera kwa Mose namuwuza kuti, \"Ife tikufuna kumanga makola a ziweto zathu kuno ndi mizinda yokhalamo akazi athu ndi ana athu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.16",
            "verseOrgIds": [
              "NUM.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ndife okonzeka kutenga zida za nkhondo ndi kupita pamodzi ndi Aisraeli mpaka titakawafikitsa ku malo awo. Panopa, akazi ndi ana athu akhala mʼmizinda yotetezedwa, kuwateteza kwa anthu okhala mʼdzikoli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.17",
            "verseOrgIds": [
              "NUM.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sitidzabwerera ku midzi yathu mpaka Mwisraeli aliyense atalandira cholowa chake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.18",
            "verseOrgIds": [
              "NUM.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sitidzalandira cholowa chilichonse pamodzi nawo ku tsidya lina la Yorodani, chifukwa cholowa chathu tachipezera ku tsidya lino la kummawa kwa Yorodani.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.19",
            "verseOrgIds": [
              "NUM.32.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Mose anati kwa anthuwo, \"Ngati inu mudzachita zimenezi, kutenga zida zankhondo pamaso pa Yehova kuti muchite nkhondo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.20",
            "verseOrgIds": [
              "NUM.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo ngati nonsenu mudzapita ndi zida kuwoloka Yorodani pamaso pa Yehova mpaka atachotsa adani ake pamaso pake,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.21",
            "verseOrgIds": [
              "NUM.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "dzikolo nʼkugonja pamaso pa Yehova, mudzabwera ndi kukhala mfulu pamaso pa Yehova ndi Aisraeli. Ndipo dziko lino lidzakhala lanu pamaso pa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.22",
            "verseOrgIds": [
              "NUM.32.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koma mukalephera kuchita izi, mudzakhala mukuchimwira Yehova. Ndipo dziwani kuti tchimo lanu lidzakupezani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.23",
            "verseOrgIds": [
              "NUM.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangireni akazi ndi ana anu mizinda, mangani makola a ziweto zanu, koma chitani zomwe mwalonjeza.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.24",
            "verseOrgIds": [
              "NUM.32.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agadi ndi Arubeni anati kwa Mose, \"Ife antchito anu tidzachita monga mbuye wathu mwalamulira.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.25",
            "verseOrgIds": [
              "NUM.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ndi akazi athu, ziweto zathu zina ndi ngʼombe zidzatsala kuno ku mizinda ya Giliyadi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.26",
            "verseOrgIds": [
              "NUM.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma antchito anufe, mwamuna aliyense amene ali ndi chida cha nkhondo, adzawoloka kukamenya nkhondo pamaso pa Yehova monga mbuye wathu wanenera.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.27",
            "verseOrgIds": [
              "NUM.32.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Mose anapereka malamulo awa kwa wansembe Eliezara, kwa Yoswa mwana wa Nuni ndi kwa akulu a mafuko a Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.28",
            "verseOrgIds": [
              "NUM.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose anawawuza kuti, ngati Agadi ndi Arubeni, mwamuna aliyense wokonzekera nkhondo, awoloka Yorodani pamodzi ndi inu pamaso pa Yehova, ndipo dzikolo nʼkugonjetsedwa pamaso panu, mudzawapatse dziko la Giliyadi kukhala lawo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.29",
            "verseOrgIds": [
              "NUM.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ngati sawoloka pamodzi nanu ndi zida zankhondo, ayenera kulandira cholowa chawo pamodzi ndi inu ku Kanaani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.30",
            "verseOrgIds": [
              "NUM.32.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agadi ndi Arubeni anayankha kuti, \"Antchito anu adzachita zimene Yehova wanena.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.31",
            "verseOrgIds": [
              "NUM.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tidzawoloka pamaso pa Yehova ndipo tidzalowa mu Kanaani ndi zida zankhondo, koma cholowa chathu chidzakhala ku tsidya lino la Yorodani.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.32",
            "verseOrgIds": [
              "NUM.32.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Mose anapatsa Agadi, Arubeni ndi theka la fuko la Manase mwana wa Yosefe dziko la Sihoni mfumu ya Aamori ndi dziko la Ogi, mfumu ya ku Basani, dziko lonse, mizinda yake ndi midzi yowazungulira.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.33",
            "verseOrgIds": [
              "NUM.32.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agadi anamanga Diboni, Ataroti, Aroeri,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.34",
            "verseOrgIds": [
              "NUM.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atiroti-Sofani, Yazeri, Yogibeha,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.35",
            "verseOrgIds": [
              "NUM.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beti-Nimira ndi Beti-Harani mizinda ya malinga. Anamanganso makola a ziweto zawo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.36",
            "verseOrgIds": [
              "NUM.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Arubeni anamanga Hesiboni, Eleali, Kiriataimu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.37",
            "verseOrgIds": [
              "NUM.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebo ndi Baala-Meoni (mayina awa anasinthidwa) ndi Sibima. Anapereka mayina ku mizinda ina yomwe anamangayo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.38",
            "verseOrgIds": [
              "NUM.32.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zidzukulu za Makiri mwana wa Manase zinapita ku Giliyadi kulanda mzindawo ndi kuthamangitsira kunja Aamori omwe anali kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.39",
            "verseOrgIds": [
              "NUM.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Mose anapereka Giliyadi kwa Amakiri, ana a Manase, ndipo anakhala kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.40",
            "verseOrgIds": [
              "NUM.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yairi, mwana wa Manase analanda midzi yambiri ya Giliyadi ndi kuyitcha kuti Havoti-Yairi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
            "verseOrgIds": [
              "NUM.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Noba analanda Kenati ndi midzi yozungulira ndi kuyitcha Noba, kutengera dzina la iye mwini.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.42",
            "verseOrgIds": [
              "NUM.32.42"
            ]
          }
        }
      ]
    }
