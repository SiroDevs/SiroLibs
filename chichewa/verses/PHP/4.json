  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "PHP 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono abale anga, ndimakukondani ndipo ndikukulakalakani. Ndinu chimwemwe changa ndi chipewa cha ulemerero wanga. Abwenzi okondedwa, chilimikani choncho mwa Ambuye.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.1",
            "verseOrgIds": [
              "PHP.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikudandaulira Euodiya ndi Suntuke kuti akhale ndi mtima umodzi mwa Ambuye.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.2",
            "verseOrgIds": [
              "PHP.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inde, ndikupempha iwe mnzanga pa ntchitoyi, thandiza amayiwa amene ndagwira nawo ntchito ya Uthenga Wabwino pamodzi ndi Klementonso ndi ena onse antchito anzanga amene mayina awo ali mʼbuku lamoyo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.3",
            "verseOrgIds": [
              "PHP.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Malangizo Otsiriza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi zonse muzikondwa mwa Ambuye. Ndikubwerezanso; muzikondwa!",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.4",
            "verseOrgIds": [
              "PHP.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufatsa kwanu kuzioneka pamaso pa anthu onse. Ambuye anu ali pafupi.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.5",
            "verseOrgIds": [
              "PHP.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musade nkhawa ndi kanthu kalikonse, koma pa china chilichonse, mwa pemphero ndi chidandaulo pamodzi ndi chiyamiko, perekani zopempha zanu kwa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.6",
            "verseOrgIds": [
              "PHP.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mtendere wa Mulungu, umene upambana nzeru zonse udzasunga bwino mitima yanu ndi maganizo anu mwa Khristu Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.7",
            "verseOrgIds": [
              "PHP.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Potsiriza, abale, muziyika mtima wanu pa zinthu zilizonse zabwino ndi zotamandika monga, zinthu zoona, zinthu zolemekezeka, zinthu zolungama, zinthu zoyera, zinthu zokongola ndi zinthu zosiririka.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.8",
            "verseOrgIds": [
              "PHP.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzichita chilichonse chimene mwaphunzira kapena kulandira kapena kumva kuchokera kwa ine kapena mwaona mwa ine. Ndipo Mulungu wamtendere adzakhala nanu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.9",
            "verseOrgIds": [
              "PHP.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuthokoza Chifukwa cha Mphatso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikukondwa kwambiri mwa Ambuye kuti patapita nthawi tsopano mwayambanso kuonetsa kuti mumandiganizira. Zoonadi, mwakhala mukundikumbukira, koma munalibe mpata woti muonetsere zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.10",
            "verseOrgIds": [
              "PHP.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sindikunena izi chifukwa choti ndikusowa thandizo, poti ine ndaphunzira kukhala wokwaniritsidwa ndi zimene ndili nazo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.11",
            "verseOrgIds": [
              "PHP.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimadziwa kusauka nʼkutani, ndipo ndimadziwa kulemera nʼkutani. Ndaphunzira chinsinsi chokhala wokhutitsidwa mwa njira ina iliyonse, kaya nʼkudya bwino kapena kukhala ndi njala, kaya kukhala ndi chuma kapena umphawi.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.12",
            "verseOrgIds": [
              "PHP.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikhoza kuchita zonse kudzera mwa Iye amene amandipatsa mphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.13",
            "verseOrgIds": [
              "PHP.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komatu munachita bwino kundithandiza mʼmavuto anga.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.14",
            "verseOrgIds": [
              "PHP.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo inu Afilipi mukudziwa kuti masiku oyambirira olalikira Uthenga Wabwino, nditachoka ku Makedoniya, panalibe mpingo ndi umodzi omwe umene unagwirizana nane pa nkhani yopereka ndi kulandira, kupatula inu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.15",
            "verseOrgIds": [
              "PHP.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ngakhale pamene ndinali ku Tesalonika, munanditumizira kangapo zondithandiza pa zosowa zanga.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.16",
            "verseOrgIds": [
              "PHP.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osati ndikufuna mphatso zanu, koma ndikufuna kuti pa zimene muli nazo pawonjezerekepo phindu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.17",
            "verseOrgIds": [
              "PHP.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalandira zonse ndipo ndili nazo zokwanira zoposa zosowa zanga popeza ndalandira kwa Epafrodito mphatso zochuluka zimene munatumiza. Ndizo zopereka za fungo labwino, nsembe zolandiridwa zokondweretsa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.18",
            "verseOrgIds": [
              "PHP.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mulungu wanga adzakwaniritsa zosowa zanu monga mwa chuma chake chaulemerero mwa Khristu Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.19",
            "verseOrgIds": [
              "PHP.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa Mulungu ndi Atate athu, kukhale ulemerero mpaka muyaya. Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.20",
            "verseOrgIds": [
              "PHP.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Malonje Otsiriza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perekani moni kwa oyera mtima onse mwa Khristu Yesu. Abale amene ali ndi ine akupereka moni wawo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.21",
            "verseOrgIds": [
              "PHP.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHP 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyera mtima onse akupereka moni, makamaka iwo a ku nyumba ya Kaisara.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.22",
            "verseOrgIds": [
              "PHP.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHP 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisomo cha Ambuye Yesu Khristu chikhale ndi mzimu wanu. Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.23",
            "verseOrgIds": [
              "PHP.4.23"
            ]
          }
        }
      ]
    }
  ],
