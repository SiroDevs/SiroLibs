  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "GEN 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo Akumana ndi Esau",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo atakweza maso ake anaona Esau akubwera ndi anthu ake 400. Choncho ana ake anawagawira Leya, Rakele ndi antchito awiri aja.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.1",
            "verseOrgIds": [
              "GEN.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anayika antchito ndi ana awo patsogolo, kenaka nʼkubwera Leya ndi ana ake, ndipo pambuyo pawo Rakele ndi Yosefe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.2",
            "verseOrgIds": [
              "GEN.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye mwini anakhala patsogolo nawerama mpaka kukhudza pansi kasanu ndi kawiri pamene amayandikira mʼbale wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.3",
            "verseOrgIds": [
              "GEN.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Esau anathamanga kukakumana ndi Yakobo ndipo anamukupatira namupsompsona. Onse awiri ankangolira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.4",
            "verseOrgIds": [
              "GEN.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Esau ataona amayi ndi ana awo anamufunsa Yakobo kuti, \"Kodi anthu amene uli nawowa ndi a ndani?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.5",
            "verseOrgIds": [
              "GEN.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 33:5"
      },
      "items": [
        {
          "text": "Yakobo anayankha kuti, \"Awa ndi ana amene Mulungu, mwa kukoma mtima kwake, wapereka kwa mtumiki wanune.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.5",
            "verseOrgIds": [
              "GEN.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono antchito aja anayandikira naweramitsa mitu pansi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.6",
            "verseOrgIds": [
              "GEN.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka, Leya ndi ana ake anabwera. Nawonso anaweramitsa mitu pansi. Potsiriza pa onse anabwera Yosefe ndi Rakele naweramitsanso mitu yawo pansi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.7",
            "verseOrgIds": [
              "GEN.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau anafunsa kuti, \"Kodi gulu la ziweto ndakumana nalo lija ndi layani?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.8",
            "verseOrgIds": [
              "GEN.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 33:8"
      },
      "items": [
        {
          "text": "Yakobo anayankha nati, \"Mbuye wanga, gulu lija ndi lanu kuti mundikomere mtima.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.8",
            "verseOrgIds": [
              "GEN.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Esau anati, \"Mʼbale wanga, ine ndili nazo kale zambiri. Zinthu zakozi sunga.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.9",
            "verseOrgIds": [
              "GEN.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo anati, \"Chonde musatero. Ngati mwandikomera mtima, landirani mphatso yangayi kuchokera kwa ine. Pakuti ndi mmene mwandirandira bwinomu, ine ndikamaona nkhope yanu ndikuchita ngati ndikuona nkhope ya Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.10",
            "verseOrgIds": [
              "GEN.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chonde, landirani mphatso imene ndakutengeraniyi, popeza Mulungu wandikomera mtima kwambiri moti ndili ndi zonse zimene ndizifuna.\" Ndipo popeza kuti Yakobo anamuwumiriza, Esau analandira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.11",
            "verseOrgIds": [
              "GEN.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Esau anati, \"Tiyeni tizipita; nditsagana nanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.12",
            "verseOrgIds": [
              "GEN.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yakobo anati kwa iye, \"Mbuye wanga, inu mudziwa kuti anawa ndi a nthete ndiponso ndiyenera kusamalira nkhosa ndi ngʼombe zimene zikuyamwitsa ana awo. Ngati ndizimenya kuti zifulumire, tsiku limodzi lokha nyamazo zidzafa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.13",
            "verseOrgIds": [
              "GEN.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho, mbuye wanga lolani kuti mutsogole. Ine ndiziyenda pangʼonopangʼono pambuyo pa ziwetozi ndi anawa mpaka ndikafika ku Seiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.14",
            "verseOrgIds": [
              "GEN.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau anati, \"Ndiye bwanji ndikusiyireko ena mwa anthu anga.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.15",
            "verseOrgIds": [
              "GEN.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 33:15"
      },
      "items": [
        {
          "text": "Koma Yakobo anati, \"Koma muchitiranji zimenezi? Chachikulu nʼkuti mwandilandira bwino, mbuye wanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.15",
            "verseOrgIds": [
              "GEN.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho tsiku limenelo Esau anayamba ulendo wobwerera ku Seiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.16",
            "verseOrgIds": [
              "GEN.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe Yakobo anapita ku Sukoti. Kumeneko anamanga nyumba yake ndi makola a ziweto zake. Nʼchifukwa chake malowa amatchedwa Sukoti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.17",
            "verseOrgIds": [
              "GEN.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmene ankabwerera kuchokera ku Padanaramu, Yakobo anafika ku Salemu, mzinda wa Sekemu ku Kanaani. Anamanga msasa pamalopo moyangʼanana ndi mzindawo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.18",
            "verseOrgIds": [
              "GEN.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malo amenewo anagula kwa zidzukulu za Hamori, abambo a Sekemu ndi ndalama 100 zasiliva.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.19",
            "verseOrgIds": [
              "GEN.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamalopo anamanganso guwa lansembe, nalitcha Eli Elohe Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.20",
            "verseOrgIds": [
              "GEN.33.20"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "GEN.34",
    "number": "34",
    "bookId": "GEN"
  },
