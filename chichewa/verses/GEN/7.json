  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "GEN 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova anati kwa Nowa, \"Lowa mu chombo iwe ndi banja lako lonse, chifukwa ndaona kuti ndiwe wolungama mu mʼbado uwu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.1",
            "verseOrgIds": [
              "GEN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mtundu uliwonse wa nyama zoti nʼkudya utengepo zazimuna zisanu ndi ziwiri ndi zazikazi zisanu ndi ziwirinso. Koma pa mtundu wa nyama iliyonse yosati nʼkudya utengepo zazimuna ziwiri ndi zazikazi ziwirinso.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.2",
            "verseOrgIds": [
              "GEN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimodzimodzinso mbalame, utenge zisanu ndi ziwiri zazimuna ndi zisanu ndi ziwiri zazikazi za mtundu uliwonse kuti mitundu yawo isungike ndi moyo pa dziko lonse lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.3",
            "verseOrgIds": [
              "GEN.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakapita masiku asanu ndi awiri ndidzagwetsa mvula pa dziko lapansi kwa masiku makumi anayi usana ndi usiku ndipo ndidzawononga cha moyo chilichonse chimene ndinachipanga pa dziko lapansi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.4",
            "verseOrgIds": [
              "GEN.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Nowa anachita zonse zimene Yehova anamulamulira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.5",
            "verseOrgIds": [
              "GEN.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene chigumula chinabwera pa dziko lapansi Nowa anali ndi zaka 600.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.6",
            "verseOrgIds": [
              "GEN.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Nowa, ana ake aamuna, mkazi wake, pamodzi ndi ana ake aakazi analowa mu chombo chija kuthawa madzi a chigumula.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.7",
            "verseOrgIds": [
              "GEN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyama zoti nʼkudya ndi nyama zosadyedwa, mbalame, pamodzi ndi nyama zokwawa zonse zinadza kwa Nowa ziwiriziwiri ndi kulowa mʼchombomo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.8",
            "verseOrgIds": [
              "GEN.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Nowa anatenga ziwiriziwiri, yayimuna ndi yayikazi monga anamulamulira Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.9",
            "verseOrgIds": [
              "GEN.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patapita masiku asanu ndi awiri chigumula chinabwera pa dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.10",
            "verseOrgIds": [
              "GEN.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku la 17 la mwezi wachiwiri, Nowa ali ndi zaka 600, akasupe onse akuya kwambiri anasefuka ndiponso zitseko za madzi akumwamba zinatsekuka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.11",
            "verseOrgIds": [
              "GEN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mvula inagwa pa dziko lapansi masiku makumi anayi usana ndi usiku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.12",
            "verseOrgIds": [
              "GEN.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Linali tsiku lomwelo pamene Nowa ndi ana ake aamuna, Semu, Hamu ndi Yafeti, pamodzi ndi mkazi wake ndi akazi a ana ake atatu aja analowa mu chombo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.13",
            "verseOrgIds": [
              "GEN.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwowa analowa mʼchombomo pamodzi ndi nyama iliyonse ya kutchire monga mwa mtundu wake, ziweto zonse monga mwa mitundu yawo, nyama yokwawa iliyonse monga mwa mtundu wake ndi mbalame iliyonse monga mwa mtundu wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.14",
            "verseOrgIds": [
              "GEN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowa analowa mu chombo muja pamodzi ndi zamoyo zonse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.15",
            "verseOrgIds": [
              "GEN.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye analowa nazo zazimuna ndi zazikazi monga mmene Mulungu anamulamulira. Kenaka Yehova anatseka pa khomo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.16",
            "verseOrgIds": [
              "GEN.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chigumula chinagwa pa dziko la pansi kwa masiku makumi anayi. Madzi anayamba kuchuluka ndipo ananyamula chombo chija ndi kuchiyandamitsa pamwamba pa dziko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.17",
            "verseOrgIds": [
              "GEN.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzi anafika mwamphamvu ndipo anachulukirachulukira pa dziko lapansi moti chombo chinayandama pamwamba pa madziwo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.18",
            "verseOrgIds": [
              "GEN.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzi a chigumula anabwerabe molimbika motero kuti mapiri ataliatali onse a pa dziko anamizidwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.19",
            "verseOrgIds": [
              "GEN.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzi anakwera namiza mapiri kwa mamita pafupifupi asanu ndi awiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.20",
            "verseOrgIds": [
              "GEN.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamoyo chilichonse choyenda pa dziko lapansi chinafa: mbalame, ziweto, nyama zakuthengo, miyandamiyanda ya zonse zolengedwa za pa dziko lapansi pamodzi ndi anthu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.21",
            "verseOrgIds": [
              "GEN.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chilichonse chamoyo, chokhala pa mtunda chinafa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.22",
            "verseOrgIds": [
              "GEN.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamoyo chilichonse pa dziko lapansi chinawonongedwa, kuyambira munthu, nyama, zokwawa ndi mbalame. Nowa yekha ndiye anatsala pamodzi ndi onse amene anali naye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.23",
            "verseOrgIds": [
              "GEN.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madziwo anadzaza dziko lonse lapansi kwa masiku 150.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.24",
            "verseOrgIds": [
              "GEN.7.24"
            ]
          }
        }
      ]
    }
  ],
