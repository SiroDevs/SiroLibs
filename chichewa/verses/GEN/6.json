  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "GEN 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuyipa kwa Mtundu wa Anthu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu atayamba kuchuluka pa dziko lapansi ndi kubereka ana aakazi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.1",
            "verseOrgIds": [
              "GEN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ana aamuna a Mulungu anaona kuti ana aakazi a anthuwo anali okongola. Ndipo anakwatira aliyense amene anamusankha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.2",
            "verseOrgIds": [
              "GEN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Yehova anati, \"Sindilola kuti chipwirikiti chikuchitikachi chipitirire mpaka muyaya, pakuti iye ndi munthu; masiku a moyo wake adzakhala zaka 120.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masiku amenewo komanso pambuyo pake, pa dziko lapansi panali Anefili, anthu amphamvu ndiponso otchuka. Anthuwa ndi amene ankabadwa ana a Mulungu aja atakwatira ana aakazi a anthu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.4",
            "verseOrgIds": [
              "GEN.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Yehova anaona kuti kuyipa kwa munthu pa dziko lapansi kunali kwakukulu ndi kuti nthawi zonse amalingalira ndi kukhumbira kuchita zoyipa zokhazokha,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.5",
            "verseOrgIds": [
              "GEN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anamva chisoni kuti analenga munthu ndi kumuyika pa dziko lapansi, ndipo anawawidwa mtima.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.6",
            "verseOrgIds": [
              "GEN.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yehova anati, \"Ndidzafafaniza munthu, nyama, zonse zokwawa, ndi mbalame za mu mlengalenga pa dziko lapansi, pakuti ndikumva chisoni kuti ndinazilenga zimenezi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.7",
            "verseOrgIds": [
              "GEN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yehova anamukomera mtima Nowa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.8",
            "verseOrgIds": [
              "GEN.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nowa ndi Chigumula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbiri ya Nowa inali yotere:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.9",
            "verseOrgIds": [
              "GEN.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 6:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 6:9"
      },
      "items": [
        {
          "text": "Nowa anali munthu wolungama ndi wopanda tchimo pakati pa anthu a mʼbado wake. Ndipo anayenda ndi Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.9",
            "verseOrgIds": [
              "GEN.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowa anabereka ana aamuna atatu: Semu, Hamu ndi Yafeti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.10",
            "verseOrgIds": [
              "GEN.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwawa chinadzaza pa dziko lapansi kotero kuti dziko linakhala lowonongeka pamaso pa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.11",
            "verseOrgIds": [
              "GEN.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu atayangʼana, anaona kuti dziko layipadi chifukwa cha makhalidwe oyipa a anthu onse pa dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.12",
            "verseOrgIds": [
              "GEN.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mulungu anati kwa Nowa, \"Ndatsimikiza mtima kuti ndiwononge anthu onse, pakuti dziko lapansi ladzaza ndi ntchito zawo zoyipa. Ndithudi ndiwawononga pamodzi ndi zonse za pa dziko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.13",
            "verseOrgIds": [
              "GEN.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono udzipangire chombo cha matabwa a mtengo wanjale; mʼkati mwake upange zipinda ndipo upake phula mʼkati ndi kunja.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.14",
            "verseOrgIds": [
              "GEN.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchipange motere: Chombo chikhale mamita 140 mulitali, mamita 23 mulifupi ndi mamita 13 mu msinkhu wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.15",
            "verseOrgIds": [
              "GEN.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchipangire denga ndi kuchimaliza ndi zenera la masentimita makumi asanu. Uyike khomo mʼmbali mwa chombocho ndi kupanga zipinda zosanjikana; chapansi, chapakati ndi chapamwamba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.16",
            "verseOrgIds": [
              "GEN.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzagwetsa mvula ya chigumula pa dziko lapansi kuti ndiwononge zamoyo zonse za pansi pa thambo ndipo chilichonse cha pa dziko lapansi chidzafa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.17",
            "verseOrgIds": [
              "GEN.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ndidzachita pangano langa ndi iwe. Iwe, ana ako aamuna, mkazi wako ndi akazi a ana ako nonse mudzalowa mʼchombocho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.18",
            "verseOrgIds": [
              "GEN.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe udzalowa mʼchombocho ndi zolengedwa zamoyo zonse ziwiriziwiri, chachimuna ndi chachikazi, kuti zisungike ndi moyo pamodzi ndi iwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.19",
            "verseOrgIds": [
              "GEN.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzatenga ziwiriziwiri za mitundu yonse ya mbalame, mitundu yonse ya nyama, ndi mitundu yonse ya zokwawa kuti zikhale ndi moyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.20",
            "verseOrgIds": [
              "GEN.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzatengenso chakudya cha mtundu uliwonse ndi kuchisunga kuti inu ndi nyamazo muzidzadya.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.21",
            "verseOrgIds": [
              "GEN.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowa anachita zonse monga Mulungu anamulamulira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.22",
            "verseOrgIds": [
              "GEN.6.22"
            ]
          }
        }
      ]
    }
  ],
