  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "GEN 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abale a Yosefe Apita ku Igupto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo atamva kuti ku Igupto kuli tirigu, anati kwa ana ake, \"Nʼchifukwa chiyani mukungoyangʼanana wina ndi mnzake?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.1",
            "verseOrgIds": [
              "GEN.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndamva kuti ku Igupto kuli tirigu. Pitani kumeneko mukatigulireko kuti tisafe ndi njala.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.2",
            "verseOrgIds": [
              "GEN.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho abale ake khumi a Yosefe anapita kukagula tirigu ku Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.3",
            "verseOrgIds": [
              "GEN.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yakobo sanamulole Benjamini mngʼono wake wa Yosefe kuti apite nawo chifukwa anaopa kuti choyipa chingamuchitikire.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.4",
            "verseOrgIds": [
              "GEN.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho ana a Israeli aja anapita pamodzi ndi gulu la anzawo kukagula tirigu pakuti ku Kanaani kunalinso njala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.5",
            "verseOrgIds": [
              "GEN.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Yosefe anali nduna yayikulu yolamulira dziko la Igupto, ndiye kuti analinso amene ankagulitsa tirigu kwa anthu onse. Choncho abale ake a Yosefe nawonso anabwera, ndipo anamugwadira pansi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.6",
            "verseOrgIds": [
              "GEN.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefe atangowaona abale ake anawazindikira, koma ananamizira kukhala ngati mlendo nawayankhula mwaukali kuwafunsa kuti, \"Mwachokera kuti?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.7",
            "verseOrgIds": [
              "GEN.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 42:7"
      },
      "items": [
        {
          "text": "Iwo anayankha, \"Ku dziko la Kanaani, tikudzagula chakudya.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.7",
            "verseOrgIds": [
              "GEN.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale Yosefe anawazindikira abale ake, koma iwo sanamuzindikire.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.8",
            "verseOrgIds": [
              "GEN.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo anakumbukira maloto aja amene analota za iwo ndipo anati, \"Inu ndinu akazitape! Mwabwera kudzazonda dziko lathu kuti muone pamene palibe chitetezo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.9",
            "verseOrgIds": [
              "GEN.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anayankha, \"Ayi mbuye wathu, antchito anufe tabwera kudzagula chakudya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.10",
            "verseOrgIds": [
              "GEN.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonse ndife ana a munthu mmodzi. Ndife antchito anu okhulupirika osati akazitape.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.11",
            "verseOrgIds": [
              "GEN.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anawawuza kuti, \"Ayi! Inu mwabwera kudzaona pamene palibe chitetezo mʼdziko muno.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.12",
            "verseOrgIds": [
              "GEN.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma iwo anayankha, \"Tinalipo ana aamuna khumi ndi awiri. Abambo athu ndi mmodzi, ndipo kwathu ndi ku Kanaani. Panopo wotsiriza ali ndi abambo athu ndipo wina anamwalira.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.13",
            "verseOrgIds": [
              "GEN.42.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefe anawawuza kuti, \"Ndi momwe ndaneneramo: Inu ndinu akazitape.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.14",
            "verseOrgIds": [
              "GEN.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiye ndikuyesani motere: Ine ndikulumbira pali Farao ndithu, inuyo simudzachoka malo ano mpaka wotsirizayo atabwera kuno.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.15",
            "verseOrgIds": [
              "GEN.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumizani mmodzi wa inu akamutenge mʼbale wanuyo ndipo ena nonsenu musungidwa mʼndende, kuti titsimikize ngati zimene mukunenazi ndi zoona. Apo ayi, pali Farao ndithu, inu ndinu akazitape!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.16",
            "verseOrgIds": [
              "GEN.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo onse anawayika mʼndende kwa masiku atatu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.17",
            "verseOrgIds": [
              "GEN.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku lachitatu Yosefe anawawuza kuti, \"Popeza ine ndimaopa Mulungu, ndipo inuyo ngati mukufuna kukhala ndi moyo muchite izi:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.18",
            "verseOrgIds": [
              "GEN.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati muli anthu achilungamo, mmodzi wa inu atsale mʼndende, pamene ena nonse mupite kwanu kuti muwatengere chakudya anthu akwanu kuli njalako.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.19",
            "verseOrgIds": [
              "GEN.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukabwere naye kuno mngʼono wanu wotsirizayo kuti titsimikizire zimene munanena kuti musafe.\" Ndipo anachita zomwezo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.20",
            "verseOrgIds": [
              "GEN.42.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anati kwa wina ndi mnzake, \"Ndithu ife tinalakwira mʼbale wathu uja popeza kuti ngakhale tinaona kuvutika kwake ndi kumva kulira kwake pamene ankatidandaulira kuti timuchitire chifundo, koma ife sitinamvere. Nʼchifukwa chake masautso awa atigwera.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.21",
            "verseOrgIds": [
              "GEN.42.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rubeni anayankha, \"Kodi sindinakuwuzeni kuti musamuchite kanthu mnyamata uja? Koma inu simunamvere! Tsopano tikulandira malipiro a magazi ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.22",
            "verseOrgIds": [
              "GEN.42.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 42:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma sanadziwe kuti Yosefe ankawamva popeza kuti ankagwiritsa ntchito wotanthauzira poyankhula naye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.23",
            "verseOrgIds": [
              "GEN.42.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 42:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefe anapita pambali payekha kukalira. Kenaka anabweranso nadzayankhula nawo. Iye anatenga Simeoni namumanga iwo akuona.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.24",
            "verseOrgIds": [
              "GEN.42.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 42:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefe analamula kuti awadzazire matumba awo ndi tirigu, awayikiremo ndalama zawo momwemo ndiponso awapatse chakudya cha panjira. Izi anawachitiradi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.25",
            "verseOrgIds": [
              "GEN.42.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 42:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abale a Yosefe aja anasenzetsa abulu awo tirigu amene anagula uja ndipo ananyamuka ulendo wawo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.26",
            "verseOrgIds": [
              "GEN.42.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 42:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atafika pamalo pena poti agone, mmodzi mwa iwo anatsekula thumba lake kuti atapemo chakudya cha bulu wake. Atangomasula anaona kuti ndalama zake zili pakamwa pa thumba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.27",
            "verseOrgIds": [
              "GEN.42.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 42:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anati kwa abale akewo, \"Ndalama zanga andibwezera, izi zili mʼthumba mwangamu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.28",
            "verseOrgIds": [
              "GEN.42.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 42:28"
      },
      "items": [
        {
          "text": "Mitima yawo inachita ngati yachokamo ndipo anali ndi mantha ambiri, nati, \"Ndi chiyani chimene Mulungu watichitira?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.28",
            "verseOrgIds": [
              "GEN.42.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 42:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atafika kwa abambo awo Yakobo mʼdziko la Kanaani anafotokoza zonse zimene zinawachitikira nati,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.29",
            "verseOrgIds": [
              "GEN.42.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 42:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nduna yayikulu ya mʼdzikomo inatiyankhula mwa ukali kwambiri ndipo inkatiyesa kuti ndife akazitape.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.30",
            "verseOrgIds": [
              "GEN.42.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 42:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma tinamuwuza kuti, 'Ndife anthu woona mtima osati akazitape.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.31",
            "verseOrgIds": [
              "GEN.42.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 42:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife tonse tinalipo ana aamuna khumi ndi awiri, abambo mmodzi. Mmodzi anamwalira, ndipo wamngʼono ali ndi abambo athu ku Kanaani.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.32",
            "verseOrgIds": [
              "GEN.42.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 42:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nduna ija inati kwa ife, \"Kuti ndidziwedi kuti ndinu anthu owona mtima muchite izi: Mmodzi mwa inu atsale ndi ine kuno, ndipo enanu mutenge chakudya ndi kubwerera kwanu kumene kuli njalako.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.33",
            "verseOrgIds": [
              "GEN.42.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 42:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mundibweretsere wotsirizayo kuti ndidziwedi kuti sindinu akazitape koma anthu achilungamo. Kenaka ndidzakubwezerani mʼbale wanuyu ndipo mukhoza kuchita malonda mʼdzikoli.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.34",
            "verseOrgIds": [
              "GEN.42.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 42:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene amakhuthula matumba awo a tirigu aliyense anapeza kuti kathumba kake ka ndalama kali momwemo. Ataona zimenezi, iwo pamodzi ndi abambo awo anachita mantha kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.35",
            "verseOrgIds": [
              "GEN.42.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 42:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abambo awo Yakobo anawawuza kuti, \"Mwandilanda ana anga ine. Yosefe anamwalira ndipo Simeoni palibenso, ndiye tsopano mukufuna mutengenso Benjamini. Zonsezi zandigwera ine!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.36",
            "verseOrgIds": [
              "GEN.42.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 42:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Rubeni anati kwa abambo ake, \"Ngati sindidzabwera naye kwa inu, mudzaphe ana anga aamuna awiri. Muperekeni mʼmanja mwangamu ndipo ndidzamusamala ndi kubwera naye kwa inu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.37",
            "verseOrgIds": [
              "GEN.42.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 42:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yakobo anati, \"Mwana wanga sapita nanu kumeneko; mkulu wake anamwalira ndipo watsala yekha. Ngati choyipa chitamuchitikira pa ulendo mukupitawu, ndiye kuti ndi mmene ndakalambiramu inu mudzandipha ndi chisoni chotere.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.38",
            "verseOrgIds": [
              "GEN.42.38"
            ]
          }
        }
      ]
    }
  ],
