  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "GEN 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiyambi cha Chilengedwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pachiyambi Mulungu analenga kumwamba ndi dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.1",
            "verseOrgIds": [
              "GEN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko lapansi linali losakonzedwa ndi lopanda kanthu. Mdima wandiweyani unakuta nyanja ndipo Mzimu wa Mulungu unkayendayenda pamwamba pa madziwo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.2",
            "verseOrgIds": [
              "GEN.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Mulungu anati, \"Kuwale\" ndipo kunawaladi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.3",
            "verseOrgIds": [
              "GEN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anaona kuti kuwalako kunali bwino ndipo Iye analekanitsa kuwala ndi mdima.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.4",
            "verseOrgIds": [
              "GEN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anatcha kuwalako \"usana\" ndipo mdima anawutcha \"usiku.\" Ndipo panali madzulo ndiponso mmawa pa tsiku loyamba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.5",
            "verseOrgIds": [
              "GEN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Mulungu anati, \"Pakhale thambo pakati pa madzi kuti lilekanitse madzi a mʼmwamba ndi madzi a pansi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.6",
            "verseOrgIds": [
              "GEN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mulungu anapanga thambo nalekanitsa madzi amene anali pansi ndi pamwamba pa thambo lija, ndipo zinachitikadi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.7",
            "verseOrgIds": [
              "GEN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anatcha thambo lija \"kumwamba.\" Ndipo panali madzulo ndiponso mmawa pa tsiku lachiwiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.8",
            "verseOrgIds": [
              "GEN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anati, \"Madzi a pansi pa thambo asonkhane pa malo amodzi kuti mtunda uwoneke,\" ndipo zinachitikadi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.9",
            "verseOrgIds": [
              "GEN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anawutcha mtundawo \"dziko,\" madzi osonkhana pamodziwo anawatcha \"nyanja.\" Ndipo Mulungu anaona kuti zinali bwino.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.10",
            "verseOrgIds": [
              "GEN.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Mulungu anati, \"Dziko libereke zomera zobala mbewu, mitengo yobala zipatso za mbewu, molingana ndi mitundu yake.\" Ndipo zinachitikadi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.11",
            "verseOrgIds": [
              "GEN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko linabereka zomera zokhala ndi mbewu monga mwa mitundu yake ndi mitengo yokhala ndi zipatso za mbewu mʼkati mwake monga mwa mitundu yake. Ndipo Mulungu anaona kuti zinali bwino.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.12",
            "verseOrgIds": [
              "GEN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo panali madzulo ndiponso mmawa pa tsiku lachitatu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.13",
            "verseOrgIds": [
              "GEN.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anati, \"Pakhale zowunikira kuthambo kuti zilekanitse usana ndi usiku. Ndipo zimenezi zikhale zizindikiro zoonetsa nyengo, masiku ndi zaka;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.14",
            "verseOrgIds": [
              "GEN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "zikhale kuthambo kuti ziwunikire pa dziko lapansi. Ndipo zinachitikadi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.15",
            "verseOrgIds": [
              "GEN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anapanga zowunikira zazikulu ziwiri; chachikulu chilamulire usana ndi chachingʼono chilamulire usiku. Iye anapanganso nyenyezi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.16",
            "verseOrgIds": [
              "GEN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anaziyika mlengalenga kuti ziziwunikira pa dziko lapansi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.17",
            "verseOrgIds": [
              "GEN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti zilamulire usana ndi usiku, ndi kuti zilekanitse kuwala ndi mdima. Mulungu anaona kuti zinali bwino.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.18",
            "verseOrgIds": [
              "GEN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo panali madzulo ndiponso mmawa pa tsiku lachinayi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.19",
            "verseOrgIds": [
              "GEN.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anati, \"Mʼmadzi mukhale zamoyo zochuluka ndipo mbalame ziwuluke mlengalenga pamwamba pa dziko lapansi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.20",
            "verseOrgIds": [
              "GEN.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Mulungu analenga zamoyo zikuluzikulu za mʼnyanja ndi chamoyo chamtundu uliwonse chokhala mʼmadzi ndi mbalame iliyonse ya mapiko monga mwa mtundu wake. Mulungu anaona kuti zinali bwino.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.21",
            "verseOrgIds": [
              "GEN.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anazidalitsa nati, \"Muswane, ndi kudzaza mʼmadzi a mʼnyanja, ndipo mbalame zichuluke pa dziko lapansi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.22",
            "verseOrgIds": [
              "GEN.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo panali madzulo ndiponso mmawa pa tsiku lachisanu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.23",
            "verseOrgIds": [
              "GEN.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Mulungu anati, \"Dziko lapansi litulutse zolengedwa zamoyo monga mwa mitundu yawo: ziweto, zolengedwa zokwawa ndi nyama zakuthengo, iliyonse monga mwa mtundu wake.\" Ndipo zinaterodi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.24",
            "verseOrgIds": [
              "GEN.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anapanga nyama zakuthengo monga mwa mitundu yawo, nyama zoweta monga mwa mitundu yawo ndi nyama zokwawa monga mwa mitundu yawo. Ndipo Mulungu anaona kuti zinali bwino.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.25",
            "verseOrgIds": [
              "GEN.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zitatha izi Mulungu anati, \"Tipange munthu mʼchifanizo chathu, mofanana ndi ife kuti alamulire nsomba za mʼnyanja, mbalame zamlengalenga, nyama zonse zoweta ndi zonse zokwawa za pa dziko lapansi ndi zamoyo zonse zakutchire.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.26",
            "verseOrgIds": [
              "GEN.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mulungu analenga munthu mʼchifanizo chake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
            "verseOrgIds": [
              "GEN.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 1:27"
      },
      "items": [
        {
          "text": "Anawalengadi mʼchifanizo cha Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
            "verseOrgIds": [
              "GEN.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 1:27"
      },
      "items": [
        {
          "text": "analenga iwo, mwamuna ndi mkazi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
            "verseOrgIds": [
              "GEN.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anawadalitsa nati kwa iwo, \"Muberekane, muchulukane, mudzaze dziko lapansi ndipo muligonjetse. Mulamulire nsomba zamʼnyanja, mbalame zamlengalenga ndi cholengedwa chamoyo chilichonse chimene chimayenda mokwawa pa dziko lapansi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.28",
            "verseOrgIds": [
              "GEN.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Mulungu anati, \"Ine ndakupatsani chomera chilichonse cha pa dziko lapansi chimene chili ndi mbewu komanso mtengo uliwonse wobala zipatso zokhala ndi mbewu mʼkati mwake kuti zikhale chakudya chanu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.29",
            "verseOrgIds": [
              "GEN.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaperekanso msipu kwa nyama zonse za pa dziko lapansi ndi kwa mbalame zamlengalenga ndi kwa cholengedwa chamoyo chilichonse chimene chimakwawa, chilichonse chimene chili ndi moyo.\" Ndipo zinachitikadi.",
