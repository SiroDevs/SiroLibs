            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Nyini kewonyö nyarïlnoni pö osiswechoni, kïtuwit asis akïma arawa, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.24",
