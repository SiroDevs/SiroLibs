                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.11"
              },
              "items": [
                {
                  "text": "12:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ato asïwekwa kïgh nyo gha nyo kipolpolöy ketö wölo melö keroko kïmi, nya kïpköchï chi nyo somönöy ngalechï, akany kïryagh pich cho mi Yudea kïpus kutïngkot. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.14",
            "verseOrgIds": [
              "MRK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.31"
              },
              "items": [
                {
                  "text": "Luk 17:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mörökunye chi nyo mi kö pörkö kïlïtöy konyi lö tacheng kïgh nyo mi ori. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.15",
            "verseOrgIds": [
              "MRK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mömïlonye chi nyo mi par katanyi lö tacheng anankenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.16",
            "verseOrgIds": [
              "MRK.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wechï ngwan nyoman ompö kor cho mirsïyi nko chane cho rerïyöy monïng! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.17",
            "verseOrgIds": [
              "MRK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asagha tömeghisyö ngalechoni ompö asispa kaghïtan. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.18",
            "verseOrgIds": [
              "MRK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.1"
              },
              "items": [
                {
                  "text": "Dan 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.14"
              },
              "items": [
                {
                  "text": "Ngo 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ompöwölo itu nyarïl osiswechoni nyo tomönye kesïwa kïngeta otini kitowï Tororöt kwigh ngwïny ntökïtenö ye, amökwitunye nyaril nyo lata nyoni ngat. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.19",
            "verseOrgIds": [
              "MRK.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akï ntökimechïchuk Echotyon osiswechoni, tömöminye chi nyonikïny nyo kïsöru. Kichïchuk nyinte osiswechoni ompö pich cho kikïl kïlïkwï chechi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.20",
            "verseOrgIds": [
              "MRK.13.20"
            ]
          }
        }
      ]
    },
