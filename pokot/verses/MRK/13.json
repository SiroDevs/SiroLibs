            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Ngo 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay kïsïwa chane Wero Chi kungwïno poltoy ompö owesyö nyo wow nko ororyö. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.26",
            "verseOrgIds": [
              "MRK.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoktoy nyu malaykenichi kïpa ngwïny kïmïkul kïghamïtï kïlankachi kïngetunö sörömu ngwïny ntökwit sörömu anka.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.27",
            "verseOrgIds": [
              "MRK.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kinetutyo moköngwö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
