                  "text": "Mal 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " le wölo kikirta werkoyon Isaya lö,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.2",
            "verseOrgIds": [
              "MRK.1.2"
            ]
          }
        }
