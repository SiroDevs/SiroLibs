              "items": [
                {
                  "text": "Luk 3:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kungwïna kut yïm, “Ichinyi Werïnyan nyo le chamanenyan. Ochömeninyi kegh tya.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.11",
            "verseOrgIds": [
              "MRK.1.11"
            ]
          }
        }
      ]
    },
    {
