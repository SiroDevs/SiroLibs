              "MRK.1.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.1.8"
              },
              "items": [
                {
                  "text": "2Pöy 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiloköy nyu Yoana sïro cho kikïnapa puto tamas nko angwa mu akyomöy talam nko ponit. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.6",
            "verseOrgIds": [
              "MRK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyomtoy kïlentöy, “Pïnï chi lötunyan nyo wow kïtïlanïn, chi nyo mömïchinanïnye ompö atyak kweghkachi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.7",
            "verseOrgIds": [
              "MRK.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opötisönekwa ompö pögh, wölo pötisönekwa nyinte ompö Mïkulögh nyo Tïlil.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.8",
            "verseOrgIds": [
              "MRK.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kipatisanat nko tyamata Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.8",
            "verseOrgIds": [
              "MRK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingwïna Yeso osiswechoni Nasaret nyo mi Kalilaya, kupatisan Yoana nyinte ompö lalwa Yordan. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.9",
            "verseOrgIds": [
              "MRK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panini lawel kipusuna Yeso pögh, kïsïwa kïyata yïmö kïrökyï nyinte Mïkulögh nyo lata chepïrïm. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.10",
            "verseOrgIds": [
              "MRK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
