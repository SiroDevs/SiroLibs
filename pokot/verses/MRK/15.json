              "MRK.15.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.13"
              },
              "items": [
                {
                  "text": "Rum 16:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kuryam ompö araor nko chi nyo kikuro Simon, nyo kingwïno koro Kurene, kuchikyï nyinte kïkasan kimurtöwonto Yeso (chichoni kï ki papoto Aleksanda nko Rupo). ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.21",
            "verseOrgIds": [
              "MRK.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumït Yeso ntökwitï ato kïkuro Kolkota, nyo ato kïwaghach kelentöy, “Kowo Möt.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.22",
            "verseOrgIds": [
              "MRK.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö nyinte dipay* cho kikïtasta pögho tolkos wölo melö kigha. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.23",
            "verseOrgIds": [
              "MRK.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.22.18"
              },
              "items": [
                {
                  "text": "Tum 22:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïwudochï kimurtöwon akupar sïrokachi, kilasta chane kwegh kïtomö kupar sïrochoni atökïcheng chi nyo köchïnchï nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.24",
            "verseOrgIds": [
              "MRK.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïwudochï Yeso kimurtöwon satïn sömök cho pö tökwoghö. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.25",
            "verseOrgIds": [
              "MRK.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikikirchï ngal cho kïlentöy kigh parakuto mötïnyi cho kimwoghöy lö, “Pöytoghinto pipö Yaudi.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.26",
            "verseOrgIds": [
              "MRK.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akikïwudochï nyinte kimurtöwon nko pich odeny cho kile rïmï, kiwudochï akonga ewunyi okumpö tagh, kewudochï anka okumpö löt. [ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.27",
            "verseOrgIds": [
              "MRK.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.12"
              },
              "items": [
                {
                  "text": "Isa 53:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ompö atoni kï kipïntö ngala cho mwoghöy Kikirut lö, “Kikïtasta nyinte pich cho ghach.”]",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.28",
            "verseOrgIds": [
              "MRK.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.28",
            "verseOrgIds": [
              "MRK.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumwa pich cho kiweröy otini akupirpiröy mötöwekwa kïlentöy, “Nyi nyay kilentöy onyoröy Kö pö Tororöt* aitek ompö osis sömök! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.29",
            "verseOrgIds": [
              "MRK.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sörunö kegh airökunö kimurtöwon!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.30",
            "verseOrgIds": [
              "MRK.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngem tïkwïl tïsï cho echön nko koneti kirurut akïmwochï kegh ayo lö, “Kisörï pikö walaka akwanyï memukönye kïsöru keghï! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.31",
            "verseOrgIds": [
              "MRK.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kïrökunö kimurtöwon Kristo,* pöytoghinto Israel nyete le ye kesïwenacha akeghan.” Kimwa tïkwïl Yeso pïchay kikïwudochï kimurtöwon nko nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.32",
            "verseOrgIds": [
              "MRK.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Megha Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.32",
            "verseOrgIds": [
              "MRK.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kighyö asis kulum tuwïn kore kïmïkul, kïtuwit satïn sömök. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.33",
            "verseOrgIds": [
              "MRK.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.22.1"
              },
              "items": [
                {
                  "text": "Tum 22:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyini kitïta satïn mut nko angwan, kuta Yeso lö, “Eloy, Eloy, lama sapaktani?” Nyo ato kïwaghach kïlentöy, “Tororötïnyu, Tororötïnyu, ompö ne tepïstaninyi?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.34",
            "verseOrgIds": [
              "MRK.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.34",
            "verseOrgIds": [
              "MRK.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlïm pich walaka cho kighyongo atoni, kïlö, “Atere mi kïkuröy Eliya!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.35",
            "verseOrgIds": [
              "MRK.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.21"
              },
              "items": [
                {
                  "text": "Tum 69:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kurïp chi akong ompö pïchay kïwö kïcheng kïgh nyo chimöy tïkwïn cho lenye pögh, akulut dipay cho ngwonöch akïsakana soghywon, atolapay kwonkoghchï Yeso lö kïgha akïlö, “Kekanya tö kesïwena lö, ekungwïnöy Eliya kïngwïso nyinte kimurtöwon!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.36",
            "verseOrgIds": [
              "MRK.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuta Yeso tya atolapay kïma. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.37",
            "verseOrgIds": [
              "MRK.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.31+EXO.26.32+EXO.26.33"
              },
              "items": [
                {
                  "text": "Wuw 26:31-33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïkarera ananka nyo kiporöy Kö pö Tororöt lö tya kïlïkwï odeny, kïngeta möt ntökwit kel. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.38",
            "verseOrgIds": [
              "MRK.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kïsïwa wowïn pö asikarin nyo kighyongo tawu kimurtöwontonay wölo kiteghta Yeso atolapay kïma, kïlö, “Nyoman, Wero Tororöt chichï!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.39",
            "verseOrgIds": [
              "MRK.15.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
