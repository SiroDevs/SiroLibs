              "items": [
                {
                  "text": "Isa 28:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kogh nyo ngölono Kikirut lö,",
          "type": "text",
          "attrs": {
