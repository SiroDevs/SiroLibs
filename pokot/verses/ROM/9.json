              "items": [
                {
                  "text": "Isa 10:22-23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwa Isaya tïkwïl paraku pipö Israel lö, “Kïrkegh köchang pipö Israel le ngayam cho mi sörömu nanam, wölo pich cho ngörï pat ompö chane cho kïsöru, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
              "ROM.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ompöwölo mutöy Echotyon kirwokenyi ompö ngwïny lawel akuwany.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.28",
            "verseOrgIds": [
              "ROM.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.9"
              },
              "items": [
                {
                  "text": "Isa 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lenye nyoni ngat ngölyon nyo kingor Isaya lö, “Ntökile nyo kimetukwechanye Echotyon Kimuktoghin monïng, kötökikewonyecha le pipö Sodoma nko pipö Komora.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.29",
            "verseOrgIds": [
              "ROM.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saghata Paulö ompö pipö Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
