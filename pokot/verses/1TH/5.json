          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tupchenicho möminye machata, akirwakwa wölo lïku ngala könyis nko osis. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.1",
            "verseOrgIds": [
              "1TH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.43"
              },
              "items": [
                {
                  "text": "Mat 24:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.39"
              },
              "items": [
                {
                  "text": "Luk 12:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.10"
              },
              "items": [
                {
                  "text": "2Pt 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ompöwölo onkïtökwa akwane lö itu asispa Echotyon le chorin nyo ngwïnöy oghö. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.2",
            "verseOrgIds": [
              "1TH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mi pich kïlentöy, “Mi pöghisyö nko kalya,” miröy nyu chane wïrata le ato itini kichïr korka nyo lusïyi amemuköcha pïchoni tökïchïwïtyöt! ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.3",
            "verseOrgIds": [
              "1TH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo momitekwanye tuwïn cho le akwa, tupchenicho nyo mömïchininye kumirokwa asisini le chorin. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.4",
            "verseOrgIds": [
              "1TH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochikwa lapay pipö löpoyïn achï pipö pöghet. Melö kichicha pipö oghö anta cho pö tuwïn. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.5",
            "verseOrgIds": [
              "1TH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, mökeruyö le pikö walaka, mïchinecha kechïkonchenö akeripsyö. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.6",
            "verseOrgIds": [
              "1TH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pich cho rusot kïrusot oghö, akïtömesyot tömösï oghö. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.7",
            "verseOrgIds": [
              "1TH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.17"
              },
              "items": [
                {
                  "text": "Isa 59:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.13+EPH.6.14+EPH.6.15+EPH.6.16+EPH.6.17"
              },
              "items": [
                {
                  "text": "Eps 6:13-17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kichicha pipö pöghet akïmïchinecha keripö kegh. Mïchinecha kelacha kighanat nko chomnyogh le longa nyo körtonecha takat nko kikönötencha nyo pö sörunöt le kopiyo karïn. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.8",
            "verseOrgIds": [
              "1TH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo melö kikïlecha Tororöt atökewongunenö nörekyenyi, wölo kikïlecha atöketaka sörunöt ompö ara Echotyontenyo Yeso Kristo,* ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.9",
            "verseOrgIds": [
              "1TH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyo kimeghenecha atökesöpchenö nko nyinte, ato kötökesöpchone anta kökikemeghö. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.10",
            "verseOrgIds": [
              "1TH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona nyu asaghsagha kegh angarak kegh akwane lenyoni omitekwa oghöy ye.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.11",
            "verseOrgIds": [
              "1TH.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kirurut pö söröm nko takwes",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.11",
            "verseOrgIds": [
              "1TH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsoghokwa lasiny, tupchenicho lö, okonyïtö pich cho mi kïpöghisyewokwa cho ntöghoghchinekwa akunetokwa otöp nyo mïchini pipö Kristo kïrïp. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.12",
            "verseOrgIds": [
              "1TH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okonyïtö chane tya acham chane ompö ighisyengwa nyoni mi chane kwighöy atïpï chï le akwa ompö kalya.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.13",
            "verseOrgIds": [
              "1TH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.13",
            "verseOrgIds": [
              "1TH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akesoghokwa ngat tupchenicho lö, aneta pich cho le soson, akil cho nyökoröch, angarak cho nyörkölöl, amïkukön nko pich löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.14",
            "verseOrgIds": [
              "1TH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asïwa kegh tömeker chi ompö akwa kukerchï chitö anka ghöyityö ompö ghöyityö, wölo akanya kïlïkwï machatengwo nyo oghchini kegh nyo karam kïtenö osis aghchï pich lapay nyo karam.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.15",
            "verseOrgIds": [
              "1TH.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.15",
            "verseOrgIds": [
              "1TH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ongörekyenö kïtenö osis, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.16",
            "verseOrgIds": [
              "1TH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "asagh Tororöt kïtenö osis, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.17",
            "verseOrgIds": [
              "1TH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayokyï nyinte sörö ompö kïgh anka tïkwïl. Ompöwölo machata Tororöt nyoni ompö akwa, otini kotuyekwa nko Kristo Yeso.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.18",
            "verseOrgIds": [
              "1TH.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.18",
            "verseOrgIds": [
              "1TH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mopökek Mïkulögh nyo Tïlil, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.19",
            "verseOrgIds": [
              "1TH.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TH 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "masas werkoynön. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.20",
            "verseOrgIds": [
              "1TH.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyama tïkwïn lapay, akaman lasiny cho karamach ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.21",
            "verseOrgIds": [
              "1TH.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1TH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïrö kegh kïgh anka tïkwïl nyo gha.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.22",
            "verseOrgIds": [
              "1TH.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1TH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.22",
            "verseOrgIds": [
              "1TH.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kutïlilokwa Tororöt lasiny nyo konecha kalya ompö or anka tïkwïl akïrip mïkulöwekwa nko söponwekwa nko porwoyikwa atalïkuna pich cho melö tïng lelut ato mïla Echotyontenyo Yeso Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.23",
            "verseOrgIds": [
              "1TH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighöy nyinte nyo kikurokwa ngölyontononi ompöwölo ghanate nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.24",
            "verseOrgIds": [
              "1TH.5.24"
            ]
          }
        }
      ]
    },
    {
