                {
                  "text": "Ist 17:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otini kimökemukechanye kemïkukön, kenanacha nyu lö karam kepökokyecha Atene opïn, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.1",
            "verseOrgIds": [
              "1TH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "keyonucha wölo omitekwa werïncha Timoteo nyo kïpöghisïyi nko acha kwomtoy Lökoy cho Karamach cho pö Kristo,* kungwïn kukilokwa akïcherakwa ompö kighanatengwo ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.2",
            "verseOrgIds": [
              "1TH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "atömanyakorit chi anka tïkwïl ompö kwenunkwa ompö nyörilwokchete. Onkïtökwa akwane lö machata Tororöt nyörilwokchoni ompö acha. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.3",
            "verseOrgIds": [
              "1TH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kikïnyaghacha kemwowokwa atanye kitökemitenöcha nko akwa lö tökechopecha kong onkïtökwa lö kigha lenyini kikïmwaghacha. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.4",
            "verseOrgIds": [
              "1TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyoni kini kighanïn oyonï Timoteo. Kimomukanye omïkukönöy ngat nka nyoni kyoyokwan nyinte kungwïn kuros wölo kitöptö kighanatenkwa atömötöp ana ntökïtyamakwa työmin akwigh ighisyencha nyo kikïsïnga kïlïkwï kwïle!",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.5",
            "verseOrgIds": [
              "1TH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
