                {
                  "text": "18:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kipar chane Echotyon Yeso nko werkoy, akuchopecha kong tïkwïl. Narekate Tororöt ompö chane nyoman, pung pö pich chane löwïr! ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.15",
            "verseOrgIds": [
              "1TH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimukyï chane kïtaghenecha kyomchinö pipö punton ngal cho ipchini chane sörunöto Tororöt. Kewanya chane aranoni ompö ngokikwa löwïr cho kighöy chane kïnomnyö. Wölo kechumchï ye nörekyo Tororöt chane.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.16",
            "verseOrgIds": [
              "1TH.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Makata Paulö kïrutochï chane ngat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.16",
            "verseOrgIds": [
              "1TH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany acha, tupchenicho, kikïpesyecha nko akwa ompö osis cho ngorï ompö por melö ompö mïkulögh, wechï kyamecha emö kenyoryenö nko akwa ngat! ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.17",
            "verseOrgIds": [
              "1TH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyoni kikïmökecha kerutoghwokwa. Kyomökan ante Paulö orutoghchinokwa kïnomnyö, wölo kikartecha Onyötö. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.18",
            "verseOrgIds": [
              "1TH.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo, kötölïku ngo kikönötencha nko ngörekyencha nko kwolötencha, makwanye cho olïku kwolötencha nyo pö rïntagh ompö tawu Echotyon Yeso otini kamïla nyinte? ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.19",
            "verseOrgIds": [
              "1TH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owöy, ochikwa owesyencha nko ngörekyencha!",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.20",
            "verseOrgIds": [
              "1TH.2.20"
            ]
          }
        }
      ]
    }
