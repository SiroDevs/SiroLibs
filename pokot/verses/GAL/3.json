          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo otini kitomönye kwitï kighanatanoni, kïratecha kirurut tökïtenö kengongwï kighanatanoni kitökungwïnöy. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.23",
            "verseOrgIds": [
              "GAL.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpaytecha nyu kirurut tökïtenö kwitï Kristo atömanyïl keyitwech man ompö tawu Tororöt ompö kighanat. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.24",
            "verseOrgIds": [
              "GAL.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GAL 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany ye otï kakwitï kighanata kïmelö tökïpöytonecha kirurut ngat.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.25",
            "verseOrgIds": [
              "GAL.3.25"
            ]
          }
        }
      ]
    },
