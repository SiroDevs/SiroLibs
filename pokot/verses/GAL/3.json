          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalïkukwa löwïr monïngo Tororöt ompö kighanat otini kotuyekwa nko Kristo Yeso. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.26",
            "verseOrgIds": [
              "GAL.3.26"
            ]
          }
        },
        {
