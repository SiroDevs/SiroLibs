          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GAL 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kikipötisönchokwa löwïr Kristo alakakwa nyu nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.27",
            "verseOrgIds": [
              "GAL.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GAL 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mökïminye nyu ngat sisïn kwenu chi pö Yaudi nko chi pö punton anta kwenu sekeyon nko nyo tyakate anta kwenu mïrön nko korka. Kalïkukwa löwïr kïgh akonga otini koghömekwa nko Kristo Yeso. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.28",
            "verseOrgIds": [
              "GAL.3.28"
            ]
          }
        },
        {
