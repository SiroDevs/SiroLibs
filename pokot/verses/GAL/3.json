        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.22",
            "verseOrgIds": [
              "GAL.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
