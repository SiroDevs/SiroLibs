          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.37"
              },
              "items": [
                {
                  "text": "Luk 21:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ompö osiswechoni, kinetisyeghö Yeso Kö pö Tororöt osis löwïr. Kïmach tïsï cho echön nko koneti kirurut kïpar nyinte kimach tïkwïl lenyoni pich cho echön ompö korononi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.47",
            "verseOrgIds": [
              "LUK.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kimönyorïcha ore nyo tïgho, ompöwölo kipïrchï pich kïter ngalechi lödo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.48",
            "verseOrgIds": [
              "LUK.19.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wowïn ne nyo tïng Yeso?",
          "type": "text"
        }
      ]
