              "items": [
                {
                  "text": "2Tm 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ngwïnöy kïmwowokwa lökoyechan löwïr werïnyo Tukiko nyo le chaman akughanate ompö ighisyonete pö Echotyon kighecha tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyoni koyonwan nyinte kukil mïkuliskökwa otini mi kwomwekwa lökoyecha. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.8",
            "verseOrgIds": [
              "COL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.10+PHM.1.11+PHM.1.12"
              },
              "items": [
                {
                  "text": "Plm 1:10-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ngwïnöy nyinte nko werïnyo Onesimo, chito korenkwa nyo ghanate tökïmwowokwa wölo lata ngala ompö wölete kïmitecha.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
            "verseOrgIds": [
              "COL.4.9"
            ]
          }
        }
