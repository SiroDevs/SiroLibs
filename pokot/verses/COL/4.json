              "items": [
                {
                  "text": "Eps 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Alïkuna pich cho ngöghomöch ompö tawu pich cho tomöcha kughan Echotyon, apöghisyeghö nyo karam pöroyïn anka tïkwïl nyo otïngetö. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.5",
            "verseOrgIds": [
              "COL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kïnyïghi pöropchö ngal cho pkono kutïwekwa akwonyïne kïtenö osis, atonkïtunö wölo omölyöngtoy kuten kïgh anka tïkwïl nyo tepokwa pich.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.6",
            "verseOrgIds": [
              "COL.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kitakwesat nyo pö söröm",
          "type": "text"
        }
      ]
    },
    {
