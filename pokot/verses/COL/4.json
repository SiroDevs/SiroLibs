        },
        {
          "text": " Akwa echot, oghchinö man sekeykökwo amowutyeghö lö otïngetekwa tïkwïl Echotyontengwo nyo mi yïm.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.1",
