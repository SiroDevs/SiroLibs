  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "COL 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakiran palalyantani ante Paulö nyo ochï kiyoktoghinto* Kristo* Yeso ompö machata Tororöt nko werïnyo Timoteo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.1",
            "verseOrgIds": [
              "COL.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.1",
            "verseOrgIds": [
              "COL.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö pipö Tororöt cho omitö Kolosay, tupchenicho cho ochï ghönote akï cho kikelinyech nko Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kïkonokwa paponyo Tororöt pöropchö nko kalya.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saghat keyokyï Tororöt sörö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyokyinecha sörö kïnomnyö Tororöt, Papoto Echotyontenyo Yeso Kristo, otini kïsoghchinecha akwa. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.3",
            "verseOrgIds": [
              "COL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kikelïmacha kighanatenkwa nyo otïngetekwa ompö Kristo Yeso nko chomnyenkwa nyo ochömekwa kighönï lapay. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.4",
            "verseOrgIds": [
              "COL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghyongo kighanatenkwa nko chomnyenkwa kikönöt nyo kikekomönwokwa ompö yïm. Kyalïmakwa ngala kikönötononi panto tagh atanya kikyomwokwa Lökoy cho Karamach cho pö man. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.5",
            "verseOrgIds": [
              "COL.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitas tagh Lökoyechoni Karamach kuyinï akwa akulet tagh kïghömï ngwïny kïmïkul, le wölo kilïkwï ompö kwenunkwa kïngeta asisanya kyalïmakwa akïpköchokwa lö nen pöropcho Tororöt, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.6",
            "verseOrgIds": [
              "COL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.12"
              },
              "items": [
                {
                  "text": "Kol 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.23"
              },
              "items": [
                {
                  "text": "Plm 1:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "le wölo kinetïtakwa werïnyo Epapra, mötworinto Kristo nyo kïchömöy akepöghisïyi tïkwïl. Mötworin nyinte nyo ghanate akwompö tösunötencha löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.7",
            "verseOrgIds": [
              "COL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwowecha nyinte wölo lata chomnyenkwa nyo kikonokwa Mïkulögh.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.8",
            "verseOrgIds": [
              "COL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.8",
            "verseOrgIds": [
              "COL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyoni kïmitecha kenonokwa kïnomnyö ompö sowut, kïngeta kelïmacha Lökoyekwa. Kikïsaghacha Tororöt kïkonokwa kinkïtöt nyo pö machatenyi nko ngöghomnyö anka tïkwïl nko pköchin nyo konu Mïkulöwunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.9",
            "verseOrgIds": [
              "COL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukekwa nyu omöngisyö kïrïp kegh nko machata Tororöt, amukakwa agh kïnomnyö tïkwïn cho ngörokyini Echotyon. Oporunekwa ompö söponwekwa ighisyewut cho karamach atasakwa tagh onkïtunö Tororöt tya. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.10",
            "verseOrgIds": [
              "COL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kuchïchimakwa Tororöt ompö owesyo ororyenyi kïmïkul atamuka omïkukönö, akamagh kïgh anka tïkwïl ompö ngörekyö. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.11",
            "verseOrgIds": [
              "COL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyokyinö Papo sörö nyo kasïwa lö mïchinecha kenyorunö kareran pö tïkwïn cho kingotyï nyinte kïlankachi ompö paytaghtanyi nyo pö löpoyïn. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.12",
            "verseOrgIds": [
              "COL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisörunenecha nyinte owesyo tuwïn akuwuwecha nyo karam kelïte pöyunöteto Werïnyi nyo le chamanenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.13",
            "verseOrgIds": [
              "COL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.7"
              },
              "items": [
                {
                  "text": "Eps 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akwompö nyinte kiketyakecha ompöwölo kikelöstowecha ngokicho.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.14",
            "verseOrgIds": [
              "COL.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kristo nko pöghisyenyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.14",
            "verseOrgIds": [
              "COL.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyinte Kristo nyo le kïton pö Tororöt, Tororöt nyo melö kïsïwïyi. Kristo tïkwïl kï poretya tïkwïn löwïr cho kikigh. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.15",
            "verseOrgIds": [
              "COL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kigh Tororöt tïkwïn löwïr ompö nyinte, ato kö tïkwïn cho mi yïm anta kö cho mi ngwïny, kö cho kïsïwïyi anta kö cho mökïsïwïyi. Kigh tïkwïl cho tïng owesyo mïkulis nko pöytoghï nko wowïntin. Kigh Tororöt tïkwïn löwïr kuwerï Kristo akwompö nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.16",
            "verseOrgIds": [
              "COL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimito Kristo kïtomö tïkwïn löwïr akwompö owesyenyi mi kïgh anka tïkwïl kïtöpo lenyini kïmökyini. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.17",
            "verseOrgIds": [
              "COL.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.22+EPH.1.23"
              },
              "items": [
                {
                  "text": "Eps 1:22-23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyinte nyo le mötito portanyi, nyoni kï kanisa. Akï nyinte nyo ngwïno söpon pö por. Nyinte kï towunöt akï poretye nyo kitutunö ngwen atökumï kïlïkwï nyo wow pöroyïnto tagh ompö kïgh anka tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.18",
            "verseOrgIds": [
              "COL.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kicham Tororöt kïrumunö otöptanyi kïmïkul orito Werïnyi, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.19",
            "verseOrgIds": [
              "COL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.16"
              },
              "items": [
                {
                  "text": "Eps 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kïlenyona ompö Werïnyi, kelinyö Tororöt tïkwïn löwïr nko nyinte, kö cho mi yïm anta kö cho mi ngwïny otini kipï nyinte kalya ompö kisönko Werïnyi cho kimïltegha kimurtöwon.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.20",
            "verseOrgIds": [
              "COL.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.20",
            "verseOrgIds": [
              "COL.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyochikwa lowöch nko Tororöt ato le tagh, akyochikwa pungkachi ompö tïkwïn cho ghach cho kyoghekwa nko cho kyononekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.21",
            "verseOrgIds": [
              "COL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "COL 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo keghakwa Tororöt kongotichi otï le ye ompö megheto Werïnyi, atökumï kwighakwa alïkuna pich cho tïlilöch, cho puryö lelut anta kigheghchin anka tïkwïl ompö tawunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.22",
            "verseOrgIds": [
              "COL.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïchinokwa nyu aleta tagh ompö kighanat nyo chïchïmate nyo melö wöghöko, kïpïstö kikönöt nyo kipkokwa Lökoyechay Karamach kyalïmakwa, aki cho kikyomchï pipö ngwïny löwïr. Ani Paulö nyo kikïlan Tororöt alïkwï mötworintenyi nyo omtoy Lökoyechoni Karamach.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.23",
            "verseOrgIds": [
              "COL.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pöghisyo Paulö le mötworinto kanisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.23",
            "verseOrgIds": [
              "COL.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "COL 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ongörökyinan ye nyu nyörilwoköchan cho keghanïn owongwï ompö akwa, ompöwölo ompö nyörilwoköchan, kamukan anyïghit chölös nyo kirarteghate ompö nyörilwok pö Kristo ompö portanyi, nyoni le kanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.24",
            "verseOrgIds": [
              "COL.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "COL 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keghanïn Tororöt alïkwï mötworinteto kanisenyi kïrïp kegh nko tötutyenyi nyo kikonanïn ompö tösunötenkwa. Tötutyononi kï kyamta ngölyontenyi kelïmta, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.25",
            "verseOrgIds": [
              "COL.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "COL 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "akï nyo kiwïnga nyinte pïnwöy löwïr kïngeta otini le könyisyok, wölo köngongchï ye nyu pikachi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.26",
            "verseOrgIds": [
              "COL.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "COL 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mököy Tororöt kïngongchini pikachi lö wow akï oror kïtya kinyiwutyö nyo nyorchini pipö punton wïnyatenyi nyo lentöy, mi Kristo orinkwa, akupöru nyoni lö oporekwa asïyech ororyo Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.27",
            "verseOrgIds": [
              "COL.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "COL 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyoni kyomchinecha Kristo pich lapay. Kïrirchinecha akenetöy chane ompö ngöghomnyö anka tïkwïl atömanyïl kemïtï ompö tawu Tororöt chi anka tïkwïl nyo kikïkil ompö Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.28",
            "verseOrgIds": [
              "COL.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "COL 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona omitan okilöy kegh opöghisïyi atökwighisyö ngalechoni. Opöghisyeghonan owesyö nyo wow nyo konanïn Kristo akwowesyononi nyo pöghisïyi ompö orinyan.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.29",
            "verseOrgIds": [
              "COL.1.29"
            ]
          }
        }
      ]
    }
