              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.16",
            "verseOrgIds": [
              "PHP.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.17",
            "verseOrgIds": [
              "PHP.3.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.16"
              },
              "items": [
                {
                  "text": "1Kr 4:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.11.1"
              },
              "items": [
                {
                  "text": "11:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tupchenyu, arïpa wölo otöptonan, ompöwölo kikeporwokwa körkeyïn nyo karam, arïpa nyu pïchoni rïpöy körkeyïnoni kikeporucha. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.17",
            "verseOrgIds": [
              "PHP.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ngölyon nyo kyomwokwa kïnyïl cho chang, ayokyinan kegh omwoghöy ompö lok lö, mi pich cho chang cho poru otöptinekwa lö pung pö kimurtöwonto Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.18",
            "verseOrgIds": [
              "PHP.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sörömungwa kiwurata, ompöwölo tororötïngwa muyengwa nisonchegho chane arasingwa yonöy kinonutkökwa tïpö ngwïnyinï. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.19",
            "verseOrgIds": [
              "PHP.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo acha kïmi möngencha yïm, akemitecha keköngöy ompö machat nyo wow Ghetintenyo kungwïna yïm, nyoni kï Echotyon Yeso Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.20",
            "verseOrgIds": [
              "PHP.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyo wöghököy porwoyicha chï nyörkölöl akwigh kïkarkegh nko portanyi nyo pö ororyö, ompö owesyö nyo muköy kï pöyuno tïkwïn lapay.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.21",
            "verseOrgIds": [
              "PHP.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kirurut cho sisinchö",
          "type": "text"
        }
      ]
    }
