            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.11+EZK.20.12+EZK.20.13"
              },
              "items": [
                {
                  "text": "20:11-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.28"
              },
              "items": [
                {
                  "text": "Luk 10:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.5"
              },
              "items": [
                {
                  "text": "Rum 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.12"
              },
              "items": [
                {
                  "text": "Kal 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïchinokwa oripö kirurutköchan löwïr ompöwölo chi nyo rïpöy kïsöpöy. Ochan ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.5",
            "verseOrgIds": [
              "LEV.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
