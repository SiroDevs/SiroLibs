              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa ngat, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.1",
            "verseOrgIds": [
              "LEV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato lïs chi pöröryenyi ompö kïgh nyo kakitö nyinte kïkaman anta nyo kikimönokyï anta nyo kakïchor anta mïrput ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.2",
            "verseOrgIds": [
              "LEV.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "anta ato nyorï tïkwïn cho kepotyö akï mïrput paraku tïkuchoni, anta wolwolisyö ompö putintön anta igh ngokï ompö ighisyewut walaka cho ighöy pich, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.3",
            "verseOrgIds": [
              "LEV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kï kegh ngokï akïlel. Mïchini nyu kuyoda tïkuchini kachor anta cho kicheng kïmas anta nyo kikimönokyï nyinte anta tïkwïn cho kipotyö akinyorï ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.4",
            "verseOrgIds": [
              "LEV.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "anta kïgh anka nyo kiwolwolchï ompö putintön, kïmïchini kuyoda kïmïchï, akïtas akonga ompö mut akutö chito kïpö löwïr asiswanini tötoy ropöw cho kïghoktegho ngokï. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.5",
            "verseOrgIds": [
              "LEV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rechini nyinte tïsin makal anta kwagha nyo lïpop le ropöwon ompö ECHOTYON nyo kighoktegho ngokï. Kikipimo olyeto ropöwontononi ropïyeni osiswechoni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighöy tïsin lenyoni atökulinyö nko ECHOTYON atökelöstoghchï nyinte ompö kïgh anka tïkwïl nyo muköy chi kwigh akïnam ngokï.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amörostin cho kïpelöy",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.8",
            "verseOrgIds": [
              "LEV.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwochinö Aron nko werkachi lö, töpo amöros nyo kïpelöy ma kïyech ompö ato kïpelo amöros akewïkchini mat. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.9",
            "verseOrgIds": [
              "LEV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kulak nyu tïsin sïrenyi nyo pö katani nko sïra katani nyo kikörmön, atolapay kïramta aryonto mayay kakïpelo amöros ompö ato kïpelo amöros, akuyin kamasu ato kïpelo amöros. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.10",
            "verseOrgIds": [
              "LEV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïngwïs sïrokachï akulach walaka atökwip arechay kïlïtöy kiror wölo kikengot. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.11",
            "verseOrgIds": [
              "LEV.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akewïkyï mat ompö ato kïpelo amöros kïnagh atömöma, tösyini tïsin kwen tökwoghö kïnomnyö akïtotyï amöros nyo kïpelöy akïpel sunet cho pö ropöwo pöghisyö. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.12",
            "verseOrgIds": [
              "LEV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwïkyini mat ompö ato kïpelo amöros kïnagh kïnomnyö, melö mïchini kïma.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ropöwo pagh",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Achï kirurut cho pö ropöwo pagh. Ipu tïsï ropöwo pagh akutö ECHOTYON ompö tawu ato kïpelo amöros. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.14",
            "verseOrgIds": [
              "LEV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chengöy tïsin pïsya römut akonga nko mwada nko tïkuchay ngutöy cho onyïn, atolapay kïpel le machey nyo pö pïsyechoni löwïr ompö ato kïpelo amöros, ngutogh nyo anyïn nyo mïlöy ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.15",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwam tïsï chinö köngötï le makatin cho puryö mumar ompö wölo tïlil. Omo chane sörömu Ema nyo mi ECHOTYON.* ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.16",
            "verseOrgIds": [
              "LEV.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meghönye chi akutö mumar kotönön chane kïlïkwï karerantangwa nyo pö amöros. Kïlïkwï kïgh nyo tïlil ompö ECHOTYON le ropöwonto ngokï nko nyo kïghoktegho ngokï. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.17",
            "verseOrgIds": [
              "LEV.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omöy mïrönö anka tïkwïl nyo pö ara Aron. Lïku karerantanyi nyoni ompö omisyö nyo kitöni ECHOTYON kuwer ma ompö pïnwöy cho tökïpkonöy. Kïkïröy möswongönye chi anka tïkwïl omisyononi atömöma.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.19",
            "verseOrgIds": [
              "LEV.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ipchini chi anka tïkwïl nyo pö ara Aron ECHOTYON pïsya cho pö kilö akonga kïtenö osis kïngeta asisini kakïkïl nyinte kïlïkwï tïsin. Tötoy kareran tökwoghö, kuwanta kareranta anka nangat. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikulkulyö pïsya nko mwagh aikela kerony, atolapay imïnchïran airopta. Nyoni kï ropöwonto pagh nyo ngutogh nyo anyïn nyo mïlöy ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighöy le nyete chi anka tïkwïl nyo pö ara Aron nyo kïkïlöy kïlïkwï Tïsin nyo Wow* kïpelchï ECHOTYON ropöwonte lökïr. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipelöy ropöwo pagh löwïr cho pö tïsin. Melö mïchini kyomöy.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ropöwo ngokï",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.24",
            "verseOrgIds": [
              "LEV.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lenchinö Aron nko werkachi, ‘Achï kirurut cho pö ropöwo ngokï, kïpöröy ropöwonte ompö tawu ECHOTYON ompö atoni kïpörchini amöros nyo kïpelöy. Tïlil nyu ropöwontononi tya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omöy tïsin nyo roptoy ompö ato tïlil ompö sörömu Ema nyo mi ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.26",
            "verseOrgIds": [
              "LEV.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möswongönye chi anka tïkwïl pentö, kïkïröy atömöma. Akwoto pechï kisönkö sïra, kïmwöto ato tïlil. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.27",
            "verseOrgIds": [
              "LEV.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtïghöy töronini kakighoghta wölo ato kighogha töro karïn, kesitöy akemwata pögh. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.28",
            "verseOrgIds": [
              "LEV.6.28"
            ]
          }
        },
        {
          "name": "verse",
