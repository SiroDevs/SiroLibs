            "sid": "LEV 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omöy mïrönö anka tïkwïl nyo pö tïsï, ompöwölo tïlil tya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.29",
            "verseOrgIds": [
              "LEV.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ropöwo ngokï anka tïkwïl nyo kipu kisönkachi kïlïtu Ema nyo mi ECHOTYON atökegh linyot ompö Emanay kï melö kyomöy penyoni, kïpelöy lömïs.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.30",
