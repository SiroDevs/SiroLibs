              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïlenyona orip kirurutköchan agh lenyini mwoghöy. Ochan ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
              "LEV.22.31"
            ]
          }
        },
        {
