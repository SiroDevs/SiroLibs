          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosïmnyon kaynenyan nyo tïlil wölo mïchini kïtekanïn pipö Israel. Ochan ECHOTYON nyo otïlilokwa ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
