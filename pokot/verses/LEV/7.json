  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "LEV 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Achï kirurut cho pö ropöw cho kighoktegho ngokï, tïlil tya ropöwontononi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.1",
            "verseOrgIds": [
              "LEV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpöröy ropöwonte ompö atoni kïpörchini amöros nyo kïpelöy, akesö kisönkö kuwit ato kïpelo amöros woptine löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.2",
            "verseOrgIds": [
              "LEV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitötoy sunetkö löwïr nko tore kïmïkul nko siro mu ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.3",
            "verseOrgIds": [
              "LEV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko söromoykachi kwodeny kïmi nko sunetkö nko koghogh wölo karam. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.4",
            "verseOrgIds": [
              "LEV.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelöy tïsin sunetchoni ompö ato kïpelo amöros ompö ECHOTYON. Ropöwon nyete nyo kïghoktegho ngokï. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.5",
            "verseOrgIds": [
              "LEV.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omöy mïrönö anka tïkwïl nyo pö tïsï, wölo kyomo ato tïlil, ompöwölo tïlil tya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.6",
            "verseOrgIds": [
              "LEV.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.6",
            "verseOrgIds": [
              "LEV.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Körökegh kirurut nyo pö ropöwonto ngokï nko nyo kïghoktegho ngokï, pöyitu pentö tïsin nyo ighöy kïlinyot. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.7",
            "verseOrgIds": [
              "LEV.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chengöy tïsin menyonto amöros nyo kïpelöy nyo tötoy nyinte kïlïkwï nyenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.8",
            "verseOrgIds": [
              "LEV.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pöyitu tïsintononi tötoy ropöwo pagh walaka tïkwïl cho kïpelo ma anta kighogho tör anta kïkela kerony. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.9",
            "verseOrgIds": [
              "LEV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïchöghchini tïsi ara Aron löwïr pagh cho kakikulkulyö nko mwagh anta cho melö kakikulkulyö.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.10",
            "verseOrgIds": [
              "LEV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ropöwo pöghisyö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.10",
            "verseOrgIds": [
              "LEV.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Achï kirurut pö ropöwo pöghisyö cho kïropchini ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.11",
            "verseOrgIds": [
              "LEV.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato tötoy chi ropöwon nyo pö sörö kutötoy ropöwontononi kïmi makatina cho puryö mumar cho kakikulkulyö nko mwaghpa orolwö nko makatina pïsya cho kakikulkulyö nko mwaghpa orolwö. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.12",
            "verseOrgIds": [
              "LEV.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tötoy nyinte tïkwïl makatin cho mïnkech cho kakitö mumar. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.13",
            "verseOrgIds": [
              "LEV.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kutötö ompö makatinechoni kareran anka le ropöwonto ECHOTYON. Pöyitu tïsintonini chengöy kisönko ropöwonto pöghisyö akwisö ato kïpelo amöros. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.14",
            "verseOrgIds": [
              "LEV.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyomöy pento ropöwontononi asisoni kitötoy Melö kituköy ntökïyech.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.15",
            "verseOrgIds": [
              "LEV.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.15",
            "verseOrgIds": [
              "LEV.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïlenyona, ato pö ropöwontenyi kiwalwalat anta kö pö chamat, kyomöy ropöwontononi asisini tötoy nyinte, wölo ato nyo köngötï kyomöy ato le asïyech. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.16",
            "verseOrgIds": [
              "LEV.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpelöy lökïr pempö ropöwon anka tïkwïl nyo köpöghön osis sömök. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.17",
            "verseOrgIds": [
              "LEV.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkïröy ato kyam pempö ropöwontononi asispa sömök, melö tökïchömöy Tororöt. Melö tökeyityini nyinte nyo tötoy, ompöwölo orus, chi nyo kam kite kïnye kï nömöy ngokï nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.18",
            "verseOrgIds": [
              "LEV.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.18",
            "verseOrgIds": [
              "LEV.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Melö kyomöy peny nyo kaswany kïgh anka tïkwïl nyo orus, kïpelöy lökïr, kïnyïl panye chinö walaka kwomöy chi anka tïkwïl nyo melö orus. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.19",
            "verseOrgIds": [
              "LEV.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato am chi nyo orus pempö ropöwonto pöghisyö nyo pö ECHOTYON, kepesyot nko pikachi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.20",
            "verseOrgIds": [
              "LEV.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato swany chi kïtïkon kïgh nyo orus, ato kö chi anta tyony, atolapay kwam peny nyo pö ropöwontononi kepesyot chichoni nko pikachi.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.21",
            "verseOrgIds": [
              "LEV.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.21",
            "verseOrgIds": [
              "LEV.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.22",
            "verseOrgIds": [
              "LEV.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwochinö pipö Israel lö, motöp ntam sunet cho pö tïch anta kechir anta ngaror. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.23",
            "verseOrgIds": [
              "LEV.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Momönye chi sunet pö kïgh nyo sapul nyo kama anta nyo kam tyompö wuw wölo kïpöghisyeghö ompö ortïn walaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.24",
            "verseOrgIds": [
              "LEV.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipesyegho pikachi chi anka tïkwïl nyo omöy sunet pö tany nyo kitöni ECHOTYON le amöros, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.25",
            "verseOrgIds": [
              "LEV.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
