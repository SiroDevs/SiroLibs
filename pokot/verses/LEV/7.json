              "LEV.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Achï kirurut pö amörostin cho kïpelöy nko ropöwo pagh nko ropöwo ngokï nko ropöw cho kïghoktegho ngokï nko ropöwo ngotat nko ropöwo pöghisyö ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "cho kiyomis ECHOTYON pipö Israel kwipchï nyinte ompö kutïng pö Sinay.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        }
      ]
    },
