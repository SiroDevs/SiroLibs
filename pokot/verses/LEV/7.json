                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "molï kisön pö tarit anka tïkwïl anta kïgh nyo sapul nyo mi wöloni omöngekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.26",
            "verseOrgIds": [
              "LEV.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato marïpnye chi kirurutyonï, kepesyegho pikachi.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.27",
