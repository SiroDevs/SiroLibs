            "sid": "LEV 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.1",
            "verseOrgIds": [
              "LEV.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwochinö pipö Israel, kïtïgh chi nyo pö Israel anta ton nyo töni montanyi Molek. Wiro pich nyinte koghïn. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.2",
            "verseOrgIds": [
              "LEV.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otöghan nyinte akepesyot nko pikachi, ompöwölo ketö montanyi Molek. Kesïmnyon Konyan akurat kaynenyan nyo tïlil. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.3",
            "verseOrgIds": [
              "LEV.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato igh kegh piko kore lö, masïwacha kïgh nyo kegh chichoni, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.4",
            "verseOrgIds": [
              "LEV.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "otöghan nyu chichoni nko katanyi nko chane löwïr cho karïp ngalechi kutö monekwa Molek. Akepesyot chane nko pikökwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.5",
            "verseOrgIds": [
              "LEV.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.5",
            "verseOrgIds": [
              "LEV.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato wö chi wölo mi chemöwostin nko ponï, otöghan nyinte akepesyot nko pikachi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.6",
            "verseOrgIds": [
              "LEV.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otïlilitö kegh nyu, ompöwölo ochan ECHOTYON Tororötïnkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.7",
            "verseOrgIds": [
              "LEV.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orip kirurutköchan, ompöwölo ochan ECHOTYON nyo otïlilokwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.8",
            "verseOrgIds": [
              "LEV.20.8"
            ]
          }
        }
      ]
    },
    {
