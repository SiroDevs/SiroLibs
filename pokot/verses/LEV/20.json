              "items": [
                {
                  "text": "Mrk 7:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chi anka tïkwïl nyo chïpöy paponyi anta yonyi ketïghöy akwomöy nyinte kisönkachi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.9",
            "verseOrgIds": [
              "LEV.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
