            "style": "v",
            "sid": "LEV 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.19",
            "verseOrgIds": [
              "LEV.20.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.12+LEV.18.13+LEV.18.14"
              },
              "items": [
                {
                  "text": "Law 18:12-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Merï nko chepto ompö yongu anta sankengu, ompöwölo takalnan nyoni, Omöy chane ngokikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.19",
            "verseOrgIds": [
              "LEV.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato rï chi nko korketo mamatanyi kikurat mamatanyi, Omöy chane ngokikwa akïmeghot mösïch monïng. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.20",
            "verseOrgIds": [
              "LEV.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.9"
              },
              "items": [
                {
                  "text": "Law 18:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.22"
              },
              "items": [
                {
                  "text": "Krt 27:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato ip chi korketo werïngwa, kï sïmnyon nyoni, ompöwölo kerat werïngwa. Meghot mösïch monïng.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.21",
            "verseOrgIds": [
              "LEV.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.21",
            "verseOrgIds": [
              "LEV.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïlenyona orip kirurutköchan nko ngalechan löwïr atömötaghak koronï omïtyinokwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.22",
            "verseOrgIds": [
              "LEV.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metöp nterïp otöptino puntonichï oyonan ye ompö tawunkwa, ompöwölo kigh chane tïkuchï löwïr nkanyï ye nyu köghöchanïn chane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.23",
            "verseOrgIds": [
              "LEV.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo komwowokwa lö, ‘Omïtekwa kor nyo okonokwa kïlïkwï nyinkwa, kor nyo chang chö akï wow kumata,’ ompöwölo ochan ECHOTYON Tororötïnkwa nyo kyaghakwa asisituna nko pich walaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.24",
            "verseOrgIds": [
              "LEV.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona nyu opesyenö tyonkïn nko törit cho melö sïmnyon nko cho le sïmnyon. Okïr kegh mam tyonkïn anta törit cho kyoghitön ompö akwa lö sïmnyon. Ato amakwa olïkukwa sïmnyon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.25",
            "verseOrgIds": [
              "LEV.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alïkuna cho tïlilöch ompö ani, ompöwölo ani ECHOTYON, ochan tïlil. Ani nyo kyangotokwa asisituna nko pich walaka atalïkuna chichan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.26",
            "verseOrgIds": [
              "LEV.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.26",
            "verseOrgIds": [
              "LEV.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato mïrön anta korka nyo le chemöwosyon anta ponin ketïghöy. Kïwiro koghïn chane akwomöy chane kisönkökwa.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.27",
            "verseOrgIds": [
              "LEV.20.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tïlilyo tïsï",
          "type": "text"
        }
      ]
    }
  ],
