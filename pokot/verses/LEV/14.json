            "style": "v",
            "sid": "LEV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.2",
            "verseOrgIds": [
              "LEV.14.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
