              "type": "text"
            }
          ]
        },
        {
          "text": "Chete kï kirurut cho pö psenkwet nyo rumuno ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.54",
            "verseOrgIds": [
              "LEV.14.54"
