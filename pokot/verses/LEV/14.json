          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcheng tïsin mwada nyinö köngötyï ewunyi akïnyïra möt pö chichay. Ighöy nyu tïsin lenyoni atökulinyö chichay nko ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.29",
            "verseOrgIds": [
              "LEV.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tötoy nyinte chepïrïmpen anta kayuntun le ato kemuk, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.30",
            "verseOrgIds": [
              "LEV.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "pö akonga ropöwonto ngokï, kïpöyit anka amöros nyo kïpelöy nko ropöwo pagh. Ighöy nyu tïsin lenyoni atökulinyö chichay nko ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.31",
            "verseOrgIds": [
              "LEV.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chete kï kirurut cho pö chi nyo kam psenkwet akï memukönye ntökïnyorï ropöwon nyo tïso kegh.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        }
      ]
    },
    {
