              "items": [
                {
                  "text": "Mrk 1:44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.14"
              },
              "items": [
                {
                  "text": "Luk 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.14"
              },
              "items": [
                {
                  "text": "17:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achï kirurut pö chi nyo kyam psenkwet ompö asisini tïsöy kegh nyinte. Kimïtyini tïsin ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.2",
            "verseOrgIds": [
              "LEV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyo wetöy kurosöy. Ato kisöp ompö sömewononi kyam nyinte, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.3",
            "verseOrgIds": [
              "LEV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïmwatïta tïsin kenömï törit odeny cho sötöte cho melö sïmnyon akepï ket pö törokwö nko sïra nyo pïrir nko isop.* ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.4",
            "verseOrgIds": [
              "LEV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay nyu kïmwatïta tïsin ketïgh tarite anka ompö tör nyo mi pögh cho karamach ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.5",
            "verseOrgIds": [
              "LEV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïcheng tarite nyay tökïsatat nko ket pö törokwe nko sïre nyo pïrir nko isop* akulut kisön pö taritanay kakïtïghchï töronay mi pögh cho karamach. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.6",
            "verseOrgIds": [
              "LEV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwisö kïnyïl mut nko odeny chichay kitïsöy ompö sömew akïmwa lö melö tökïsïmnyon chichï. Atolapay kïpïstö tarite nyay satate kupiltö. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.7",
            "verseOrgIds": [
              "LEV.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwat nyu chichay sïrokachi akïrwach putechi cho pö möt akuwunö kegh pögh, kïtïsö nyu nyinte, muköy nyu kungwïn möngot, wölo mölïtönye emenyi ompö osis mut nko odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.8",
            "verseOrgIds": [
              "LEV.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrwak putechi löwïr cho pö möt nko tamughyenyi nko puto kamama nko putechi walaka löwïr ompö asisto mut nko odeny. Atolapay kïmwat sïrokachi akuwun kegh melö tökïsïmnyon nyu nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nyini ketïta asisto mut nko sömök, kurewï wara kechir odeny cho le mökol nko nyo sakat akonga cho pö köny akonga löwïr akïlïpopöch nko kilen sömök cho pö pïsya cho kakikulkulyö nko mwaghpa orolwö nko lal akonga nyo pö mwagh. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Töni tïsin chichay kïtïsöy nko ropöwechi Ema nyo mi ECHOTYON.* ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.11",
            "verseOrgIds": [
              "LEV.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïcheng tïsin wawe anka nyo le makal akutötö kïpöyit ropöwon nyo kïghoktegho ngokï nko lala mwagh atökïlïkwï ropöwon nyo kiwiswisöy ompö tawu ECHOTYON ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.12",
            "verseOrgIds": [
              "LEV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïtïgh wawe ompö atay kïpörchini ropöwonto ngokï nko amöros nyo kïpelöy ompö atay tïlil. Ighöy lenyoni kïle ropöwon nyo kïghoktegho nko ropöwonto ngokï kïpöyitu tïsï. Tïlilöch choni tya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.13",
            "verseOrgIds": [
              "LEV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïcheng tïsin kisön pö wawanay akïnyïra yit wal nyo pö okumpö tagh nko morïn nyo wow nyo pö ewu tagh nko morïna kel nyo wow nyo pö tagh nyo pö chichay mököy ketïs. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.14",
            "verseOrgIds": [
              "LEV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïcheng tïsin mwaghay kite kutö koghogh pö ewunyi pö löt ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.15",
            "verseOrgIds": [
              "LEV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "akulut morïnenyi nyo pö ewu tagh mwaghay akwistö ompö tawu ECHOTYON kïnyïl mut nko odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.16",
            "verseOrgIds": [
              "LEV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïcheng mwada kite ompö ewunyi akïnyïra yit wal nyo pö okumpö tagh nko morïn nyo wow nyo pö ewu tagh nko morïna kel nyo wow nyo pö tagh nyo pö chichay mököy ketïs kïmi nko kisön pö wawanay. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.17",
            "verseOrgIds": [
              "LEV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcheng tïsin mwada nyinö köngötyï ewunyi akïnyïra möt pö chichay. Ighöy nyu tïsin lenyoni atökulinyö chichay nko ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.18",
            "verseOrgIds": [
              "LEV.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.18",
            "verseOrgIds": [
              "LEV.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tötoy nyu tïsin ropöwonto ngokï atökwigh linyot nyo pö chichay kitïsöy ompö sïmnyontenyi. Nyini kewanta kegh kïpar amöros nyo kïpelöy, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.19",
            "verseOrgIds": [
              "LEV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "atolapay kutötö amöros nyo kïpelöy nko ropöwo pagh ompö ato kïpelo amöros. Ighöy nyu tïsin linyot ompö chichay atökïtïsö.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo ato meywon chi nyo memukönye ntökïnyorï tïkuchï löwïr, kïcheng wawa kech nyo le makal kïpöyit ropöwon nyo kïghoktegho ngokï nko kilö akonga nyo pö pïsya tökegh linyot akwompö nyinte akitasta mwaghpa orolwö le ropöwo pagh nko lal nyo mi mwagh ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.21",
            "verseOrgIds": [
              "LEV.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko chepïrïmpen odeny anta kayuntun odeny, le ato kemuk, pö akonga ropöwo ngokï, kïpö anka amöros nyo kïpelöy. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.22",
            "verseOrgIds": [
              "LEV.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipchini nyinte tïsin ompö asispa mut nko sömök tökïtïsö kegh ompö kuka Ema nyo mi ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.23",
            "verseOrgIds": [
              "LEV.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïcheng tïsin wawanay nko lal nyo mi mwagh akutötö le ropöwon nyo kiwiswisöy ompö ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.24",
            "verseOrgIds": [
              "LEV.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tïghöy nyu tïsin wawanay akïcheng kisön tïkwïte akïnyïra chichay yit wal nyo pö okumpö tagh nko morïn nyo wow nyo pö ewu tagh nko morïna kel nyo wow nyo pö tagh. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.25",
            "verseOrgIds": [
              "LEV.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïcheng tïsin mwaghay kite kutö koghogh pö ewunyi nyo pö löt ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.26",
            "verseOrgIds": [
              "LEV.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "akulut morïnenyi nyo pö ewu tagh mwaghay akwistö ompö tawu ECHOTYON kïnyïl mut nko odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.27",
            "verseOrgIds": [
              "LEV.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïcheng mwada kite ompö ewunyi akïnyïra yit wal nyo pö okumpö tagh nko morïn nyo wow nyo pö ewu tagh nko morïna kel nyo wow nyo pö tagh kïmi nko kisön pö wawanay. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.28",
