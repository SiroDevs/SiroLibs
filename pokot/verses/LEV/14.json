          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkwich nko kutunat nko tasus nko cho pö rirïm cho rumuno sïra nko kö. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.55+LEV.14.56",
            "verseOrgIds": [
              "LEV.14.55",
              "LEV.14.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
