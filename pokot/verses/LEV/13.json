          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato tïng mïrönö anta korka kapomparen cho relach ompö por, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.38",
            "verseOrgIds": [
              "LEV.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "kurosöy tïsin. Ato melö relach tya, kï melö kapomparen cho ghach, mïkaskas pat cho kapkana por, melö sïmnyon chichoni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.39",
            "verseOrgIds": [
              "LEV.13.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 13:39"
          },
          "items": [
