              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.39",
            "verseOrgIds": [
              "LEV.13.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato pech chi möt kïklïku palor, wölo melö ighöy nyoni nyinte kïlïkwï sïmnyon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.40+LEV.13.41",
            "verseOrgIds": [
              "LEV.13.40",
              "LEV.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato tïng tasus nyo pïrir akupayteghat ompö mötïnyi, kï kilïkwï nyoni psenkwet nyo kengwïna palortanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.42",
            "verseOrgIds": [
              "LEV.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuros tïsin nyinte, ato rel nyo pïrir tasusnoni, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.43",
            "verseOrgIds": [
              "LEV.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "kï kinam psenkwet nyinte, ki kïlïkwï sïmnyon. Kïmwatïta nyu tïsin, sïmnyon chichï ompöwölo kinam psenkwet mötïnyi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.44",
            "verseOrgIds": [
              "LEV.13.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
