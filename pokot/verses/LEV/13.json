        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.46",
            "verseOrgIds": [
              "LEV.13.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato nam rirïm",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
            "verseOrgIds": [
              "LEV.13.47"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:47",
              "type": "text"
            },
            {
              "text": "rirïm:",
              "type": "text"
            },
            {
              "text": "Psenkwet nko rirïm ompö Eprania kï kïgh akonga.",
              "type": "text"
            }
          ]
        },
        {
          "text": " sïra, ato kö sïra kech anta nyo pö katani ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
            "verseOrgIds": [
              "LEV.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "anta sïra nyo kikïnapa puto kech anta nyo pö menyon anta kïgh anka tïkwïl nyo kikigha menyon, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.48",
            "verseOrgIds": [
              "LEV.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "ato nyarilit anta pïririt otini mi rirïm ompö sïra anta menyon anta kïgh anka tïkwïl nyo kikigha menyon, kï rirïm nyo mi kutïtuko, mïchini keporchï tïsin. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.49",
            "verseOrgIds": [
              "LEV.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kura nyu tïsin sïrochay kinyorisyö atolapay kutö yona, ompö osis mut nko odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
            "verseOrgIds": [
              "LEV.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kura ngat tïsin ompö asisto mut nko odeny, ato kitïtukö ompö sïra anta menyon kïtïkon, kïtïng rirïm. Kï kilïkwï sïmnyon tïkuchoni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpelöy tïsin sïranoni anta kïgh anka tïkwïl nyo kikigha menyon nyo tïng sïmnyon akwompöwölo gha rirïmchoni. Kïpelöy tïkuchoni lökïr.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 13:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo ato ros tïsin lö metïtukönye rirïm ompö sïranay anta sïra anka tïkwïl nyo kikigha menyon, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.53",
            "verseOrgIds": [
              "LEV.13.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 13:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïmwatïta tïsin kemwat sïranay. Atolapay kutö wudanyi ngat osis mut nko odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
            "verseOrgIds": [
              "LEV.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini nyu kakemwat sïranay kö le sïmnyon kura tïsin ngat, ato melö kisisit wölo lata rirïmchay, kïrkegh melö kötökutïtukö kïtö kï sïmnyon. Ipel sïre kïrkegh kinam wop akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
            "verseOrgIds": [
              "LEV.13.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 13:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato ros tïsin sïranay lö kiwonyö rirïmchay otini kikemwat, kïpachta otini kinam rirïm kïwö wudanyi ompö sïra anta menyon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.56",
            "verseOrgIds": [
              "LEV.13.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 13:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato rumï ompö sïranay anta menyontonay lö mi kutïtuko ngat, kepelöy kïgh anka tïkwïl nyo kinam rirïm. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.57",
            "verseOrgIds": [
              "LEV.13.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LEV 13:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo sïra anta menyon nyo kakïmwat amökïnamnye rirïm, kemwötöy ngat amelö sïmnyon.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.58",
            "verseOrgIds": [
              "LEV.13.58"
            ]
          }
        }
      ]
    },
