                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ananan nyu mumenyu nyo kyaman nko Yakopo nko Isak nko Apraam nko kore nyo kyoyomisyan chane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.42",
            "verseOrgIds": [
              "LEV.26.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 26:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo mïchini kïlïkwï korö kïratyan tökumuny ompö könyi Sapato ntökïtenö kïghakta pich ngokikwa löwïr ompöwölo melö kirip kirurutköchan löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.43",
            "verseOrgIds": [
              "LEV.26.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 26:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïrkegh kimi chane koro pungkökwa, kïmelö ocholtenan chane awany lömïs, tömenyara mumenyan nko chane, ompöwölo ochan ECHOTYON Tororötïngwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.44",
            "verseOrgIds": [
              "LEV.26.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 26:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ononan mumenyu nyo kyaman nko papotïnekwa cho kyamïtwan kïpkana koro Misri kïsïwïyi puntonï lö talïkwan Tororötïngwa, ompöwölo ochan ECHOTYON.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        }
      ]
