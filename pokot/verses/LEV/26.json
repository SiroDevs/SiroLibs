          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chete kï kinetut nko kirurut cho kimwochï ECHOTYON pipö Israel kuwerï kuti Musa ompö kutïng pö Sinay.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        }
      ]
