              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö ECHOTYON, “Moghchï kegh körkeyïntin anta körkeyïn nyo kipötöy anta pchörin anta nyo pö kagh ompö korengwo lö tökekïtïngchinö. Ochan ECHOTYON Tororötïnkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orip Sapatotinechan* akonyït Konyan otini opetöy osoghöy. Ochan ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        }
      ]
    },
    {
