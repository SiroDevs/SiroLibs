              "type": "text"
            }
          ]
        },
        {
          "text": "Mam kïgh anka tïkwïl ompö tyonychï, atömalïkwï sïmnyon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.43",
            "verseOrgIds": [
