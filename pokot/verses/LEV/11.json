          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.13+LEV.11.14+LEV.11.15+LEV.11.16+LEV.11.17+LEV.11.18+LEV.11.19",
            "verseOrgIds": [
              "LEV.11.13",
              "LEV.11.14",
              "LEV.11.15",
              "LEV.11.16",
              "LEV.11.17",
              "LEV.11.18",
              "LEV.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïkïrenokwa tyonkïn löwïr cho tïng köpepoy nko kelyön angwan, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.20",
            "verseOrgIds": [
              "LEV.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïpoto tïkwïn cho komtoy ato piltoy. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.21",
            "verseOrgIds": [
              "LEV.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukekwa ome talam nko tarkakay nko kaperon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.22",
            "verseOrgIds": [
              "LEV.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïkïrenokwa tïkwïn walaka tïkwïl cho tïng köpepoy nko kelyön angwan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.23",
            "verseOrgIds": [
              "LEV.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.23",
            "verseOrgIds": [
              "LEV.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Chi anka tïkwïl nyo swongöy nyo kama ompö tyonchï melö sökote putïlöy akuntoröy ngömïgh nko tyonkïn löwïr cho tïng sighoy kïlïku sïmnyon kwimön. Akï chi nyo sïtöy tyonyoni kama kïmïchini kuwun sïrokachi wölo lïku nyinte sïmnyon kwimön.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.24+LEV.11.25+LEV.11.26+LEV.11.27+LEV.11.28",
            "verseOrgIds": [
              "LEV.11.24",
              "LEV.11.25",
              "LEV.11.26",
              "LEV.11.27",
              "LEV.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.24+LEV.11.25+LEV.11.26+LEV.11.27+LEV.11.28",
            "verseOrgIds": [
              "LEV.11.24",
              "LEV.11.25",
              "LEV.11.26",
              "LEV.11.27",
              "LEV.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Achï tyonkïn cho mïnkech cho pestegho ngwïny cho le sïmnyon ompö akwa: pungungwöy nko mïr nko martas ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.29",
            "verseOrgIds": [
              "LEV.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko pönkös nko nyirit. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.30",
            "verseOrgIds": [
              "LEV.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anka tïkwïl nyo swongöy nyo kama, kïlïku sïmnyon kwimön. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.31",
            "verseOrgIds": [
              "LEV.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato chïnchï nyo kama kïgh anka tïkwïl ato kö pö ket anta sïra anta menyon anta kwïnïya kïlïku sïmnyon, kïmïchini kelut pögh, lïku sïmnyon kwimön. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.32",
            "verseOrgIds": [
              "LEV.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato chïnchï akonga tör, kïlïku sïmnyon kïgh anka tïkwïl nyo mi ori, kïmïchini otïghökwa törononi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.33",
            "verseOrgIds": [
              "LEV.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omisyö anka tïkwïl nyo kötökyomöy wölo kömi pögh cho pö törononi nko pöghechoni tïkwïl, kïlïku sïmnyon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.34",
            "verseOrgIds": [
              "LEV.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïgh anka tïkwïl nyo köchïnchï tyonyoni kama, kïlïku sïmnyon. Ato kö nökögh kïmïchini ketïgh. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.35",
            "verseOrgIds": [
              "LEV.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tïlil kompa pögh anta kö pö pögh, wölo sïmnyon chi anka tïkwïl nyo swongöy tyony nyo kama. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.36",
            "verseOrgIds": [
              "LEV.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato chïnchï tyony nyo kama kösïgh cho mach kekatkat, kï mölïkunye sïmnyon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.37",
            "verseOrgIds": [
              "LEV.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato kakenur kösïghe akïchïnchï tyony nyo kama, kïlïku sïmnyon ompö akwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.38",
            "verseOrgIds": [
              "LEV.11.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
