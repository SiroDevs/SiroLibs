      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa nko Aron, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.1",
            "verseOrgIds": [
              "LEV.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Olenchinö pipö Israel, Achï tyonkïn cho omekwa cho sötote ompö ngwïny. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.2",
            "verseOrgIds": [
              "LEV.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukekwa ome tyony anka tïkwïl nyo sakate putïlyö akuntoröy ngömïgh. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.3",
            "verseOrgIds": [
              "LEV.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo mi tyonkïn walaka cho ntoröy ngömïgh le tamasay nko köneroy nko plekwoy, kïrkegh kentoröy ngömïgh, wölo melö sökote putïlöy. Sïmnyon tyonchoni ompö akwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.4+LEV.11.5+LEV.11.6",
            "verseOrgIds": [
              "LEV.11.4",
              "LEV.11.5",
              "LEV.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam nkïruwen, cho kïrkegh sökote putïlöy, wölo mentoröcha ngömïgh. Sïmnyon tyonchoni ompö akwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.7",
            "verseOrgIds": [
              "LEV.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motöp ntam panyekwa anta aswany nyo kama, ompöwölo sïmnyon ompö akwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.8",
            "verseOrgIds": [
              "LEV.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.8",
            "verseOrgIds": [
              "LEV.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Achï tïkwïn löwïr cho omekwa cho mi pögho nanam anta lalwatïn kïgh anka tïkwïl nyo tïny köpepoy nko nyo tïny resyan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.9",
            "verseOrgIds": [
              "LEV.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo tïku walaka löwïr cho mi nanam anta lalwatïn cho melö tïng köpepoy nko resyan kekïrenokwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.10",
            "verseOrgIds": [
              "LEV.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïnyïl kekïrenokwa, motöp ntam panyekwa anta aswany nyo kama. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.11",
            "verseOrgIds": [
              "LEV.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïgh anka tïkwïl nyo satate nyo mi pögh nyo melö tïny köpepoy anta resyan kekïrenokwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.12",
            "verseOrgIds": [
              "LEV.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
