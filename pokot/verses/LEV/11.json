              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "ato köwestegho ngwïny anta kechuto kegh mu ngwïny anta nyo westegho kelyön angwan anta nyo tïng kelyön cho chang. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.42",
            "verseOrgIds": [
