        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.12",
            "verseOrgIds": [
              "LEV.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Motöp ntam töritwechï: sichtin nko pyukïktin nko sirören nko kamchereresöy nko mötongtin nko chesampunoy nko kukayoy nko cheptusonkoltin nko töritwo nanam nko kachïlïkoköchtin nko kongoytin nko törit cho karkegh nko paten nko wutpöghö nko reresoy.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.13+LEV.11.14+LEV.11.15+LEV.11.16+LEV.11.17+LEV.11.18+LEV.11.19",
            "verseOrgIds": [
              "LEV.11.13",
