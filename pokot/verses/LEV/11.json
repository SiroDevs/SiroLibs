              "type": "text"
            }
          ]
        },
        {
          "text": "“Mam tyony anka tïkwïl nyo wegho ngwïny kïkïrenokwa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.41",
            "verseOrgIds": [
