                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo moltonye chi anta al kïgh anka tïkwïl nyo kikengotyï ECHOTYON. Ato kö chi anta kïgh nyo sapul anta parenyi, kï tïlil tya akïpöyitu ECHOTYON kokay. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möminye chi nyo kakïngotyï ECHOTYON nyo kimuköy ntökyal ngat, wölo kïtïghöy.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
