                  "text": "Krt 14:22-29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pöyitu ECHOTYON kareran akonga ompö taman cho pö tïkwïn löwïr cho rïro kor, ato kö pagh anta akwa. Choni kï tïlilöch ompö ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mököy chi kwolöy ngat tïkuchoni kïtas akonga ompö mut nyo pö olyenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.31",
            "verseOrgIds": [
              "LEV.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pöyitu ECHOTYON akonga ompö taman cho pö kyak walaka löwïr cho kitïlilchini nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.32",
            "verseOrgIds": [
              "LEV.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amelö tepöy chichoni lö karamach nya anta ewo. Amekerönye nko anka, ato waghach kïpöyitu ECHOTYON kwodeny amelö tökyolöy ngat.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.33",
            "verseOrgIds": [
              "LEV.27.33"
            ]
          }
        }
      ]
