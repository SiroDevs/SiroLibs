          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuyitöy tïsin olye kïrïp kegh nko könyis cho köngötï ntökwitïta könyi kilïngat. Konu nyinte ropïyeni asisini akïpöyitu ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
              "LEV.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini ketïta könyi kilïngat keyokchini chichay pö tagh parenyi anta monechi kïlïkwï nyingwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.24",
            "verseOrgIds": [
              "LEV.27.24"
            ]
          }
        }
      ]
    },
    {
