              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.1",
            "verseOrgIds": [
              "LEV.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwochinö pipö Israel lö, ato kitötö chi kïlïkwï nyo kipuntegho kiwalwalat ompö ECHOTYON, kumuko kyal kïrïp kegh nko olyenyi:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.2",
            "verseOrgIds": [
              "LEV.27.2"
            ]
          }
        }
      ]
    },
    {
