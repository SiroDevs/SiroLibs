          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato mïrön nyo tïng könyis tömönut odeny ntökwit 60 kï ropïyeni silpa cho le tömönut mut.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.3",
            "verseOrgIds": [
              "LEV.27.3"
            ]
          }
        }
      ]
    },
    {
