          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato weri nyo pö arawa akonga ntökwit könyis mut nko odeny kï ropïyeni silpa cho le mut.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.6",
            "verseOrgIds": [
              "LEV.27.6"
            ]
          }
        }
      ]
    },
