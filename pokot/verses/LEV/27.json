          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato weri nyo tïng könyis mut ntökwit tömönut odeny kï ropïyeni silpa cho le tömönut odeny.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.5",
            "verseOrgIds": [
              "LEV.27.5"
            ]
          }
        }
      ]
    },
    {
