          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pöyitu ECHOTYON poretya kïgh anka tïkwïl nyo sapul, kïlenyona möminye chi nyo tïlilchini ECHOTYON kyakichoni. Ato kö mogh anta wawa aran anta kech, kï pö ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato sïmnyon, kwolöy ngat nyinte akïtas akonga ompö mut nyo pö olyenyi. Ato mökyalnye kyolchini chi anka ompö olyenyi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        }
      ]
    },
