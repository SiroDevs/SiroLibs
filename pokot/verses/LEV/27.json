              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato cheptö kï ropïyen sömök.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.6",
            "verseOrgIds": [
              "LEV.27.6"
