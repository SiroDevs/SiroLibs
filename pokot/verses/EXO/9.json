              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asagha ECHOTYON, kïcheng kighumötonï nko takarïschï, ompöwölo kingwonchencha. Opïstenokwa ape, amelö totöpïyokwa nyo kogh.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.28",
            "verseOrgIds": [
              "EXO.9.28"
            ]
          }
        }
