          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kewany ighisyö löwïr nyo pö Ema nyo mi ECHOTYON* akwigh pipö Israel lenyini kimwochï ECHOTYON Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 39:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïtï chane Emanay wölo mi Musa nko karichi löwïr nko akodetiska nko pölöwechi nko pïrompurkö nko pchörinechi nko pïrïmpotkachi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.33",
            "verseOrgIds": [
              "EXO.39.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 39:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köröwonte nyo tapïlïl nyo pïrir nyo pö sïro pö mökol nko ananka nyo kikïtotö kot ori ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.34",
            "verseOrgIds": [
              "EXO.39.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 39:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Santuku Muma* nyo mi koghi kirurut nko pölöwechi nko köröwonte ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.35",
            "verseOrgIds": [
              "EXO.39.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 39:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko mesa nko karichi löwïr nko makatyan nyo kipöy tawu Echotyon ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.36",
            "verseOrgIds": [
              "EXO.39.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 39:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko ket nyo kikönoghöy kitömöwo nyo pö koltin cho pïchighöch nko kitömöwechi nko karichi nko mwagh nyo kinoghöy ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.37",
            "verseOrgIds": [
              "EXO.39.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 39:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko ato kïpelo amöros nyo pö koltin nko mwagh nyo kiyiltoy nko mankoy cho kïpelöy cho ngutoy cho onyïn nko ananka nyo pö kuka Ema ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.38",
            "verseOrgIds": [
              "EXO.39.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 39:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko ato kïpelo amöros nyo pö tay nko wölo lïtöy arenï nyo pö tay nko pölöwe nko kari löwïr nko otupe nko kelyechi ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.39",
            "verseOrgIds": [
              "EXO.39.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 39:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko anankis cho körtoy kasaruto kot nko pchörinechi nko pïrïmpoti nko ananka nyo körtoy kuke nyo pö sany nko pörköyi nko nömöwe nko kari löwïr cho kipöghisyegho ompö Ema nyo mi ECHOTYON ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.40",
            "verseOrgIds": [
              "EXO.39.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 39:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko sïro cho pö tïsï cho kikïnap nyo karam cho kipöghisyegho Aron ompö Atay Tïlil nko cho pö werkachi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.41",
            "verseOrgIds": [
              "EXO.39.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 39:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh pipö Israel ighisye löwïr lenyini kimwochï ECHOTYON Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.42",
            "verseOrgIds": [
              "EXO.39.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 39:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïwa Musa lö kikwigh chane ighisye lenyini kimwa ECHOTYON, kusoyön Musa chane.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.43",
            "verseOrgIds": [
              "EXO.39.43"
            ]
          }
        }
