      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON, “Oghinyi le Tororöt ompö Parao, lïku werïnkwa Aron werkoyontengu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.1",
            "verseOrgIds": [
              "EXO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingölonenyi lapay cho omwowunyi akï mwochini Aron Parao kïpïstö pipö Israel kïwuwö korenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.2",
            "verseOrgIds": [
              "EXO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.36"
              },
              "items": [
                {
                  "text": "Ist 7:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo oghan möt pö Parao kwaghïghit, kïrkegh atasan kiporut nko töngönchintin ompö koro Misri, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.3",
            "verseOrgIds": [
              "EXO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "möterunyinye nyinte. Onyörilan kong pipö Misri amïtwan piköchan kïwuwunö koro Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.4",
            "verseOrgIds": [
              "EXO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atökunkïtï nyu pipö Misri lö ochan ECHOTYON, otini kanyarilan kong pipö Misri amïtwan pipö Israel kïwuwunö korengwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.5",
            "verseOrgIds": [
              "EXO.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh Musa nko Aron kïgh nyo kimwochï ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.6",
            "verseOrgIds": [
              "EXO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Musa könyis 80, kïtïng Aron könyis 83 otini kingölonöy nko Parao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.7",
            "verseOrgIds": [
              "EXO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lïpö Aron",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.7",
            "verseOrgIds": [
              "EXO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa nko Aron, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.8",
            "verseOrgIds": [
              "EXO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato mwowokwa Parao lö, ‘Oporunö töngönchin,’ ilenchï Aron, ‘Chenga lïkïngu aiwirchï ngwïny tawu Parao, atökïlïkwï moroy.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.9",
            "verseOrgIds": [
              "EXO.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Musa nko Aron ka Parao akwigh le ato kimwochï ECHOTYON. Kïwirchï Aron lïkïnyi tawu Parao nko mötworichi, kïwaghaka kïlïkwï moroy. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.10",
            "verseOrgIds": [
              "EXO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur Parao pich cho ngöghomöch nko chesoköytin, kwigh chane tïkwïl lenyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.11",
            "verseOrgIds": [
              "EXO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwirchï chi anka tïkwïl lïkïnyi ngwïny kïlïkwï moroyut. Wölo kïnyïkwïda lïpö Aron lïkipkökwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.12",
            "verseOrgIds": [
              "EXO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kwaghïghit möt pö Parao amöterchïnye chane lenyini kimwa ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.13",
            "verseOrgIds": [
              "EXO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kam tangany pipö Misri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.13",
            "verseOrgIds": [
              "EXO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, “Kaghïghit möt pö Parao, katagh kïchömchï pich kïpa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.14",
            "verseOrgIds": [
              "EXO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wïyö wölo mi Parao tökwoghö, otini wetöy lalwa Nile aikany nyinte lalwa kamas, ip lïkïngu nyay kikïwaghach kïlïkwï moroy. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.15",
            "verseOrgIds": [
              "EXO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ailenchï nyinte, ‘Keyokwanïn ECHOTYON Tororöt pö Eprania, wölo imitenyi akïlö, Nya kïpa piköchan, atökïpöghisyeghwanïn ompö surkwen. Wölo tomönye ighanyi lenyoni.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.16",
            "verseOrgIds": [
              "EXO.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.4"
              },
              "items": [
                {
                  "text": "Ngo 16:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kölö ECHOTYON, “Inkïtunenyi lö ochan ECHOTYON. Rosa, olïwan pögh cho mi lalwa Nile ompö lïkïyï mi ewunyan kïwöghökisyö kïlïku kisön. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.17",
            "verseOrgIds": [
              "EXO.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïmeghyot kaghagh cho mi ori akwararit lalwe, kïtagh pipö Misri kïgha pöghe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.18",
            "verseOrgIds": [
              "EXO.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.18",
            "verseOrgIds": [
              "EXO.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, “Mwochinö Aron lö, ‘Chenga lïkïngu aighïtö ompö paraku pögho Misri nko paraku lalwatïnekwa nko champilwonoykökwa nko ngörpilkökwa pö pögh. Atökïlïkwï kisön koro Misri kïmïkul, ata ompö pögh cho mi söton nko tören.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.19",
            "verseOrgIds": [
              "EXO.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.19",
            "verseOrgIds": [
              "EXO.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh Musa nko Aron le ato kimwochï ECHOTYON, ompö tawu Parao nko mötworichi, kisït lïkïnyi parak akulï pögho Nile. Kïwöghökisyö pögho Nile kïlïkwï kisön. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.20",
            "verseOrgIds": [
              "EXO.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmeghö kaghagh cho mi ori akwararit lalwe ntömökumïcha pipö Misri kïgha pögho Nile. Kïlïkwï kisön koro Misri kïmïkul. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.21",
            "verseOrgIds": [
              "EXO.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh chepsoköytino Misri lenyoni tïkwïl, wölo kwaghïghit möt pö Parao amöterchïnye chane kïle ato kimwa ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.22",
            "verseOrgIds": [
              "EXO.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Parao konyi amelö kiyang ngalechï. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.23",
            "verseOrgIds": [
              "EXO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpal pipö Misri sörömu Nile tökïnyorï pögh cho gheghöy, ompöwölo kimemuköcha kïgha pögho Nile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
            "verseOrgIds": [
              "EXO.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
            "verseOrgIds": [
              "EXO.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwer osiswö cho le mut nko odeny kïngata otini kilï ECHOTYON Nile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.25",
            "verseOrgIds": [
              "EXO.7.25"
            ]
          }
        }
      ]
    }
  ],
