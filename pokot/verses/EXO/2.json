              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcham Musa kïmang wöloni, kuyilchï Yetro Musa cheptanyi Sipora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.21",
