              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyï kokonay worö, kïkurö Musa kaynenyi Kersyom,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.22",
            "verseOrgIds": [
