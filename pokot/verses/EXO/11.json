            "number": "1",
            "style": "v",
            "sid": "EXO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, “Köngötï kïgh akong nyo otyorchinan Parao nko koro Misri, nyo atomuchö kïpïstokwa nyu ape. Tulekwa apeghena korenyi otini köpïstokwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.1",
            "verseOrgIds": [
              "EXO.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalana ye kïlïm pïchï lö, nya kïsom chi anka tïkwïl nyo le mïrön nko korka pöröryenyi kari silpa nko kari koltin.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.2",
            "verseOrgIds": [
              "EXO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitö ECHOTYON pipö Israel chamat ompö tawu pipö Misri nyo tïlate. Ki wow Musa ompö tawu mötwori Parao nko pikachi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.3",
            "verseOrgIds": [
              "EXO.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.3",
            "verseOrgIds": [
              "EXO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Musa Parao, “Kölö ECHOTYON, oweran oghonete ato muryö oghö koro Misri, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.4",
            "verseOrgIds": [
              "EXO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïmeghsot poretay löwïr cho mi koro Misri, kïngeta poretye nyo pö Parao nyo mïlöy ngacharu paytagh, ntökwit poretye nyo pö chepö monïng nyo ngoghöy pagh nko twatan löwïr cho pö tïch. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.5",
            "verseOrgIds": [
              "EXO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku nyu rira nyo wow nyoman ompö koro Misri kïmïkul, nyo kitomönye kïmito nyo lata nyoni, amökïminye ngat. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.6",
            "verseOrgIds": [
              "EXO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo möminye kïgh nyo omöy pipö Israel anta kyakikwa, tonkïtunö lö pesyot ECHOTYON pipö Misri nko pipö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.7",
            "verseOrgIds": [
              "EXO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akï pkonchinanïn sekeyiku lapay akïkïtïngchanïn akïlö, ‘Wïyö nko piköku löwïr.’ ” Atowonyö ngalechoni owan nyu. Atolapay kïweghö Musa tawu Parao nko mïrmïryö.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.8",
            "verseOrgIds": [
              "EXO.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
