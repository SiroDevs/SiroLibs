              },
              "items": [
                {
                  "text": "Esr 2:63",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.7.65"
              },
              "items": [
                {
                  "text": "Nem 7:65",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itö Urim nko Tumim* sïranay pö takat pö kirwok, atökïmito takatu Aron otini wetöy tawu ECHOTYON, kïlenyona, sïtöy Aron chik kirwoko pipö Israel ompö takatunyi ompö tawu ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sïro walaka cho pö tïsin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inöpenyi sïro pö epod cho orusöch löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.31",
            "verseOrgIds": [
              "EXO.28.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 28:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tïngeto wölo lïtöy möt ompö kwen nyo kikinipnip kuwitwit le punpun nyo pö kalacha, atömöpala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.32",
            "verseOrgIds": [
              "EXO.28.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 28:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inöpchinenyi sïre okumpö kel makumanka* cho orusöch nko cho lata akwa lamay nko cho pïröch, kuwitwit nko kwïrkwïris pö koltin cho mi kwen. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.33",
            "verseOrgIds": [
              "EXO.28.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 28:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aitö sïre kel kwïrkwïris pö koltin nko makomanken cho sisinchö muntinekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.34",
            "verseOrgIds": [
              "EXO.28.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 28:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokotoy Aron otini pöghisïyi akelïmöy chöghötengwa otini lïtöy Aron Wölo Tïlil tawu ECHOTYON nko otini ngwïnöy sany atömöma.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.35",
            "verseOrgIds": [
              "EXO.28.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 28:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.35",
            "verseOrgIds": [
              "EXO.28.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 28:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Itang aparparatpa koltin cho pïchighöch aikir parakunyi lö, ‘Nyo Tïlil ompö ECHOTYON.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 28:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irötyï aparparatnoni kopiyö ompö pörköyö nyo orus okumpö tokoch. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.37",
            "verseOrgIds": [
              "EXO.28.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 28:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loköy Aron ompö tokochunyi atachaman amörostinekwa kïrkegh kömi lelut cho kegh chane.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.38",
            "verseOrgIds": [
              "EXO.28.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 28:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.38",
            "verseOrgIds": [
              "EXO.28.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 28:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inap sïra nko kopiyö nyo pö katani nyo pïchigh nko angwa nyo kikïnap nyo karam akesïl.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.39",
            "verseOrgIds": [
              "EXO.28.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 28:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.39",
            "verseOrgIds": [
              "EXO.28.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 28:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inöpchinenyi werpö Aron sïro nko angwo pö sïro nko kopiyen cho pö konyït nko pïchighyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.40",
            "verseOrgIds": [
              "EXO.28.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 28:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ailokyï sïrochï werïnkwa Aron nko werkachi aiyil aitöror aikïl atökïpöghisyeghwanïn chane le tïsï. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.41",
            "verseOrgIds": [
              "EXO.28.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 28:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inöpchinenyi chane sïrwalis cho pö katani atökïkarta chïrutyengwa, kïngata kapkörmön ntökwit kïpesöy. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.42",
            "verseOrgIds": [
              "EXO.28.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 28:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuloköy Aron nko werkachi otini petöy Ema nyo mi ECHOTYON* anta otini petöy ato lekïto ato kïpelo amöros atökïpöghisyö ompö Wölay Tïlil, atömepchï kegh ghöyityö akïmeghö. Lïku nyete kirurut nyo pö kokay ompö nyinte nko monechi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.43",
            "verseOrgIds": [
              "EXO.28.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kïlata Aron nko werkachi kïlïkwï tïsï",
          "type": "text"
        }
      ]
    }
  ],
