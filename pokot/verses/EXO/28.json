          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.28",
            "verseOrgIds": [
              "EXO.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sïtöy Aron kaynötut pö ortïna Israel ompö sïra takat nyo pö kirwok ompö takatunyi, otini wetöy Wölo Tïlil, atökwip chane tawu ECHOTYON ompö kinonut nyo pö chik. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.29",
            "verseOrgIds": [
              "EXO.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
