  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "EXO 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mïtuna werïnkwa Aron nko werkachi Nadap nko Apiu nko Eleasar nko Itamar ompö kwenu pipö Israel, atökïpöghisyeghwanïn le tïsï. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.1",
            "verseOrgIds": [
              "EXO.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inöpchinenyi werïnkwa Aron sïro cho tïlilöch cho pö konyït nko pïchighyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.2",
            "verseOrgIds": [
              "EXO.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingölonchinenyi pich cho tïng kimukat cho kyanyïghitan ngöghomnyö atökïnöpchï Aron sïro akutïlil nyinte kïpöghisyeghwanïn ompö ighisyo tïsintön. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.3",
            "verseOrgIds": [
              "EXO.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nöpöy chane sïrochï: kalacha nyo ngïru takat nko epod* nko sïra nyo kogh nko koti nyo karam nko sïra möt nko angwa mu. Nöpchini chane werïnkwa Aron sïro cho tïlilöch nko werkachi atökïpöghisyeghwanïn le tïsï. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.4",
            "verseOrgIds": [
              "EXO.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pöghisyegho chane puto kech cho orusöch nko nyo lata akwa lamay nko nyo pïrir nko koltin nko sïra katani nyo karam.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.5",
            "verseOrgIds": [
              "EXO.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.5",
            "verseOrgIds": [
              "EXO.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ighöy chane epod nyo pö tasim pö koltin nko cho orusöch nko cho lata akwa lamay nko cho pïröch nko sïra katani nyo kikïnanagh akenap nyo karam. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.6",
            "verseOrgIds": [
              "EXO.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tïngeto chane kalachis odeny cho lumöy löyos cho kinam kegh söremwokökwa, atökenyoryö tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.7",
            "verseOrgIds": [
              "EXO.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nko angwa mu nyo kikïnap nyo karam nyo kïrotïtoy nyo kikituyö nko epod akïkarkegh tïku cho kikigha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.8",
            "verseOrgIds": [
              "EXO.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icheng koghïn odeny cho nyörilöch aikirchï kaynötut pö werpö Yakopo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.9",
            "verseOrgIds": [
              "EXO.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikirchï mut nko akonga kagh akonga aikirchï kaynötutkö chinö köngötï kada nyinö anka kïrïp kegh nko ortïnekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.10",
            "verseOrgIds": [
              "EXO.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïla chi nyo nkït kukiröy koghïn aikany kukir kaynötut pö werpö Yakopo. Aitö koghichoni kughyongö koltin cho kikïtök. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.11",
            "verseOrgIds": [
              "EXO.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itönenyi koghichoni paraku kalachanay pö epod, atökïlïkwï koghi kinonut ompö ortïna Israel. Ipöy nyu Aron kaynötutkökwa tawu ECHOTYON ompö löyoswechi atökïlïkwï kinonut. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.12",
            "verseOrgIds": [
              "EXO.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itök koltin ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.13",
            "verseOrgIds": [
              "EXO.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ainagh sïrïmtin odeny cho pö koltin cho pïchighöch atolapay inyoryö sïrïmtine nko koltine.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.14",
            "verseOrgIds": [
              "EXO.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sïra takat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.14",
            "verseOrgIds": [
              "EXO.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inöpchinenyi sïra takat nyo pö kirwok, ompö ighisyo nöpin nyo karam, inöpenyi le napata epod, akïkarkegh tïku cho kikigha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.15",
            "verseOrgIds": [
              "EXO.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kongityot woptine kwangwan akikïnyakïm kïnyïl odeny, sentimiten 22 koghïntö nko töpesïntö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.16",
            "verseOrgIds": [
              "EXO.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itötenyi tötut angwan cho pö koghïn, tötut nyo pö tagh kï: sardiyo nko topas nko karpunkïl. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.17",
            "verseOrgIds": [
              "EXO.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo pö odeny kï: emerald nko sapire nko dayemon. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.18",
            "verseOrgIds": [
              "EXO.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo pö sömök kï: chasinto nko akate nko ametist. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.19",
            "verseOrgIds": [
              "EXO.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo pö angwan kï: peril nko oniks nko chaspa. Aitö koghichoni kughyongö koltin cho kikïtök. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.20",
            "verseOrgIds": [
              "EXO.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku koghi taman nko odeny kïrïp kegh nko kaynötut pö werpö Yakopo, kagh akonga ompö kaynata chi akonga, ompö ortïne kï taman nko odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.21",
            "verseOrgIds": [
              "EXO.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inöpchinenyi sïra takat sïrïmtin cho kikïnanagh le pörköy cho pö koltin cho pïchighöch. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.22",
            "verseOrgIds": [
              "EXO.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighenyi kaymoris odeny cho pö koltin cho pö sïra takat aitö kaymoriska woptine kwodeny. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.23",
            "verseOrgIds": [
              "EXO.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irötinenyi pörköyichay le odeny kikïnanagh ori kaymoris. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.24",
            "verseOrgIds": [
              "EXO.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyoryonyi söremwokö kwodeny ompö pörköyichay nko koltinechay kikïtök ainyoryö ompö okumpö tagh kalachanay pö löyos pö epod. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.25",
            "verseOrgIds": [
              "EXO.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igh kaymoris odeny cho pö koltin aitö söremwok odeny cho pö sïra takat ompö sörömunyi nyo mi okumpö epod ori. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.26",
            "verseOrgIds": [
              "EXO.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igh kaymoris cho pö koltin aitö sïrochay le odeny pö epod okumpö ngwïny wölo le tagh, ato lekïto rötutyenyi, paraku angwa nyo pö epod nyo kikïnap nyo karam. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.27",
            "verseOrgIds": [
              "EXO.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irata tasim nyo orus sïra takat kïnam kegh kaymoriskachi nko cho pö epod, atökïtöpö paraku angwanay pö epod kikïnap nyo karam, atömöchagh kegh sïranay pö takat nko epod.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.28",
            "verseOrgIds": [
              "EXO.28.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
