          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, “Pata koghïn odeny cho töpölöl le chay kipö tagh, tokirchan ori ngalechay kimi chay kipö tagh kiwirtenyi kïghyösyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.1",
            "verseOrgIds": [
              "EXO.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Töpenö kïpsach asïyech atenyonö tökwoghö kutïng pö Sinay parak atenyoryenö nko ani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.2",
            "verseOrgIds": [
              "EXO.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möminye chi nyo pusu kutïng nko nyi amekany kesöchï chi kutïngoni kïmïkul amekany kwaketa kyakï ato lekïto kutïngoni.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.3",
            "verseOrgIds": [
              "EXO.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupat Musa koghïn odeny cho töpölöl le chay pö tagh akïwö tökwoghö kutïng pö Sinay, lenyini kimwochï ECHOTYON nyinte akwip koghichay.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.4",
            "verseOrgIds": [
              "EXO.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.4",
            "verseOrgIds": [
              "EXO.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrökunö ECHOTYON polta akughyongö atoni nko nyinte akïkur kaynenyi lö, ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.5",
            "verseOrgIds": [
              "EXO.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
