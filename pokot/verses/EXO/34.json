          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungïrukö Musa lawel ntökwit ngwïny akïsagh ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.8",
            "verseOrgIds": [
              "EXO.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "lö, “Ato kechamanyi kïgh nyo kaghan, we Echotyon, osoghinyi lö, wïyö nko acha, kïrökegh kö pich cho oghïghe mötöwöy ailöstewecha ghöyityenyo nko ngokicho aichengecha kelïkuna piköku kegh.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.9",
            "verseOrgIds": [
              "EXO.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
