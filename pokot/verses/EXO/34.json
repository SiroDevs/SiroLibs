      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakirelit muma*",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
