              "type": "text"
            }
          ]
        },
        {
          "text": "Mamasa man pikökwo cho le mey ompö kirwokengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.6",
            "verseOrgIds": [
              "EXO.23.6"
