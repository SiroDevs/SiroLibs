              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pkonöy mïrön tawu ECHOTYON Tororöt kïnyïl sömök ompö köny akonga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
