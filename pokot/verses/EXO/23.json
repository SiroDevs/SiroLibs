            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato onyorï egh pö punyontengwo anta sïkïryenyi nyo kepot, mïchini oyokyinökwa nyinte ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
