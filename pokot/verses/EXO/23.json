            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okötkötekwa parenikwo al paghe ompö könyis mut nko akonga, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
