          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mokonï amörostino kyak nko makatin cho mi mumar. Amaror sunet cho pö ichontönyan ntökïyekï.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
