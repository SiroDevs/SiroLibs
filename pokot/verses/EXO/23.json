              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Agh Ichon pö Tunkun ompö sörömu köny, ato osupekwa paghekwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
