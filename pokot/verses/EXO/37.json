        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigha Pesalel Santuku Muma ket pö tilak, kitenö koghïntanyi sentimiten 110, kïtenö töpesïntanyi sentimiten 66 akï sentimiten 66 kïwö parak. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.1",
            "verseOrgIds": [
              "EXO.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmala koltin cho pïchighöch sany nko ori akutö koltin kuwitwit söröm. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.2",
            "verseOrgIds": [
              "EXO.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh kaymoris angwan cho pö koltin akutö kelyechi kwangwan, kaymoris odeny onkuntö anka, odeny onkuntö anka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.3",
            "verseOrgIds": [
              "EXO.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh pölöwo tilok akïmala koltin ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.4",
            "verseOrgIds": [
              "EXO.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "akulut pölöwe kaymorischay mi wop odeny atökesïtö Santukunay. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.5",
            "verseOrgIds": [
              "EXO.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwigh köröwon nyo pö koltin cho pïchighöch nyo kiteno koghïntanyi sentimiten 110, kiteno töpesïntanyi sentimiten 66. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.6",
            "verseOrgIds": [
              "EXO.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh kerupimtin* odeny cho pö koltin ompö woptin odeny nyo pö köröwontonay. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.7",
            "verseOrgIds": [
              "EXO.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö kerupim akonga wop akonga, kutö anka woptö anka akwigh kerupimtin odeny kïnam köröwonte. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.8",
            "verseOrgIds": [
              "EXO.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Syolöy kerupimtine köpepokökwa parak atökïkarta köröwonte. Pörchini kegh mutïn kurosöy köröwonte.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.9",
            "verseOrgIds": [
              "EXO.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ighata mesa nyo pö makatyan nyo kitöni Tororöt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.9",
            "verseOrgIds": [
              "EXO.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh mesa nyo pö tilak nyo tenö koghïntanyi sentimiten 88, töpesïntö kï sentimiten tömönut angwan nko angwan akï sentimiten 66 kïwö parak. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.10",
            "verseOrgIds": [
              "EXO.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmala koltin cho pïchighöch akutö koltin kuwitwit. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.11",
            "verseOrgIds": [
              "EXO.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh korope nyo tenö töpesïntanyi milimiten 75 akutö koltin kuwitwit koropetö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.12",
            "verseOrgIds": [
              "EXO.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh kaymoris angwan cho pö mesanoni akutö luchtine kwangwan, wölo ghyongo kelye kwangwan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.13",
            "verseOrgIds": [
              "EXO.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany kïlekïtö kaymoriska koropetö tökïnam ketichay kïsïto mese. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.14",
            "verseOrgIds": [
              "EXO.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh pölöwo tilok akïmïla koltin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.15",
            "verseOrgIds": [
              "EXO.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh karïn cho pö koltin cho pïchighöch cho pö mesa: tïwanay nko mpalaway nko alepïtis nko otupöy cho kïpöghisyegho ompö kitötogh.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.16",
            "verseOrgIds": [
              "EXO.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ighata ato kikönoghöy kitömöwo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.16",
            "verseOrgIds": [
              "EXO.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh ket nyo kikönoghöy kitömöwo ompö koltin cho pïchighöch. Akwigh pchörin nko kelye ompö koltin cho kitongöy cho tïng tapïk akinam kegh. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.17",
            "verseOrgIds": [
              "EXO.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïtïng morïn cho le mut nko akonga, sömök ompö woptine kwodeny. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.18",
            "verseOrgIds": [
              "EXO.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng morïna anka tïkwïl kikompen sömök cho lata tapïko pö mlosi cho ketar. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.19",
            "verseOrgIds": [
              "EXO.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng pchörinoni kikompen angwan cho lata tapïko pö mlosi cho ketar. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.20",
            "verseOrgIds": [
              "EXO.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimito tapïkyanta nyo tomönye kïnganya otini kasakegha morïna akong ompö chay le mut nko akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.21",
            "verseOrgIds": [
              "EXO.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku akonga tapïkyan nyo tomönye kïnganya nko morikwa nko pchöri akikitanga koltin cho pïchighöch. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.22",
            "verseOrgIds": [
              "EXO.37.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh kitömöw cho le mut nko odeny nko kitampine nko otupeni koltin cho pïchighöch. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.23",
            "verseOrgIds": [
              "EXO.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigha karichoni löwïr kilen 35 cho pö koltin cho pïchighöch.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.24",
            "verseOrgIds": [
              "EXO.37.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ighata ato kïpelo köröstin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.24",
            "verseOrgIds": [
              "EXO.37.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh ato kïpelo köröstin ompö ket pö tilak. Kïlïkwï sentimiten 45 koghïntanyi nko töpesïntanyi akïkarkegh wop tïkwïl, sentimiten 90 kutok akïnömöy kegh nko kuyechi tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.25",
            "verseOrgIds": [
              "EXO.37.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmala koltin cho pïchighöch okumpö parak nko kamastö nko kuye akwighchï söremwokö koltin kuwitwit. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.26",
            "verseOrgIds": [
              "EXO.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwighchï kaymoris odeny cho pö koltin ngwïnyi söremwokachi okumpö ngwïny, ompö woptine kwodeny, atökïlïkwï ato kitöni ketichay kïsïto. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.27",
            "verseOrgIds": [
              "EXO.37.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigha keti tilok akïmala koltin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.28",
            "verseOrgIds": [
              "EXO.37.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ighata mwagh nyo kiyiltoy nko tïkwïn cho ngutoy cho onyïn",
          "type": "text"
        }
      ]
    },
    {
