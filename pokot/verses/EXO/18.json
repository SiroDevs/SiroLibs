    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilïm Yetro kapikoyo Musa, nyo kile tïsin ompö Midyan, ngal cho kighchï Tororöt Musa nko pipö Israel nko otini kimïtï chane kïngetunö Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.1",
            "verseOrgIds": [
              "EXO.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.21+EXO.2.22"
              },
              "items": [
                {
                  "text": "Wuw 2:21-22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumïtï Yetro cheptanyi Sipora, koko Musa ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.2",
            "verseOrgIds": [
              "EXO.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.29"
              },
              "items": [
                {
                  "text": "Ist 7:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko werkachi odeny. Kikuro akonga Kersyom,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.3",
            "verseOrgIds": [
              "EXO.18.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:3",
              "type": "text"
            },
            {
              "text": "Kersyom:",
              "type": "text"
            },
            {
              "text": "Ompö Eprania kïlata, pïnotyon.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ompöwölo kilö Musa, “Kalïkwan pïnotyon ompö koro pich walaka,” kekurö anka Elieser,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.3",
            "verseOrgIds": [
              "EXO.18.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:3",
              "type": "text"
            },
            {
              "text": "Elieser:",
              "type": "text"
            },
            {
              "text": "ompö Eprania kïlata, kingarakanïn Tororöt.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ompöwölo kilö Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.3",
            "verseOrgIds": [
              "EXO.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ki kingörokintenyan Tororöt pö paponyan. Kisörunenanïn choko Parao.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.4",
            "verseOrgIds": [
              "EXO.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumïtï Yetro koko Musa nko werkachi odeny kïpka surkwen wölo kimi kïmöngöy ato lekïto kutïng pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.5",
            "verseOrgIds": [
              "EXO.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kökikuyoktö kut Yetro wölo mi Musa lö, “Omïtunan korkengu nko werkachi kwodeny.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.6",
            "verseOrgIds": [
              "EXO.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Musa kïtaroch kapikoyenyi akukongköy. Kutakwes kegh akïpa kutang ema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.7",
            "verseOrgIds": [
              "EXO.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï Musa kapikoyenyi ngal löwïr cho kighchï ECHOTYON Parao nko pipö Misri akwompö pipö Israel akïmwochï kömpölelut löwïr cho kinyorï ompö rutogh nko wölo kisörï chane ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.8",
            "verseOrgIds": [
              "EXO.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngarak Yetro otini kilïm ngal cho karamach cho kighchï ECHOTYON pipö Israel akïsörunö owesyo pipö Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.9",
            "verseOrgIds": [
              "EXO.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö, “Nya kïkwolö ECHOTYON nyo kisörunenokwa owesyo pipö Misri nko Parao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.10",
            "verseOrgIds": [
              "EXO.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onkïtön ye nyu lö wow ECHOTYON kïtïl tororötin walaka, ompöwölo kisörunö pipö Israel mori pipö Misri ato kichop kong chane.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.11",
            "verseOrgIds": [
              "EXO.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwipï Yetro amöros nyo kïpelöy nko kitötogh wölo mi Tororöt, kungwïn Aron nko poyi Israel kwam makatyan nko kapikoyo Musa ompö tawu Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.12",
            "verseOrgIds": [
              "EXO.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kïlata kirwokï",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.12",
            "verseOrgIds": [
              "EXO.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtöpö Musa ngwïny asisto odeny atökurwokyï pich, kughyö chane kuwit nyinte kïngata tökwoghö ntökwimön. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.13",
            "verseOrgIds": [
              "EXO.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kisïwa apoytanyi löwïr cho kighchini Musa pich kïlö, “Ne nyï ighchinenyi pich? Ompö ne telïkunanyi kirwokin onkït, kïmi pïchï ghyongöy kuwitinyi kïngata tökwoghö ntökwimön?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.14",
            "verseOrgIds": [
              "EXO.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.14",
            "verseOrgIds": [
              "EXO.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Musa, “Ompöwölo pkonöy pich wölo omitan kïyöröy machata Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.15",
            "verseOrgIds": [
              "EXO.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato tïng chane ngölyon, kwipu wölo omitan, alïkunan mutinto ngal ompö kwenu chi nko chitö anka amwochan kinetut pö Tororöt nko kirurutkachi.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.16",
            "verseOrgIds": [
              "EXO.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.16",
            "verseOrgIds": [
              "EXO.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Yetro lö, “Melö karam kïyï ighenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.17",
            "verseOrgIds": [
              "EXO.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ioghökenyi ompö pïchï pkonöy wölo imitenyi. Nïkis ighisyonï ompö nyi, memukenyinye onkït. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.18",
            "verseOrgIds": [
              "EXO.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera nyu orurïn, nya kïtöpö Tororöt nko nyi. Lïkuna nyo ighyongtechini pich ompö tawu Tororöt aipchï Tororöt ngalekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.19",
            "verseOrgIds": [
              "EXO.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neta chane kirurut pö Tororöt aiporchï chane wölo töptoy nko ighisyö nyo mïchini kwigh. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.20",
            "verseOrgIds": [
              "EXO.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïla pich cho ngöghomöch ompö pïchï lapay, cho konyïtöy Tororöt akï cho kighönöy melö chengöy asoya, tönö chane kïlïkwï yetïntino pich 1,000 nko 100 nko 50 nko taman. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.21",
            "verseOrgIds": [
              "EXO.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku chane kirwokï cho pö pich ompö osis löwïr, wölo nya kwipï chane ngölyon nyo awes wölo imitenyi, kïmut chane nyo kwïskwïs. Ighöy nyoni nïkisyengu kïkwïskwïsit, ompöwölo chöghöy chane nko nyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.22",
            "verseOrgIds": [
              "EXO.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato ighanyi lenyini mwoghöy Tororöt, melö ioghökenyi. Akïrotöy pïchï löwïr keston ompö kalya.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.23",
            "verseOrgIds": [
              "EXO.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.23",
            "verseOrgIds": [
              "EXO.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïterchï Musa kapikoyenyi akwigh kïgh anka tïkwïl nyo kimwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.24",
            "verseOrgIds": [
              "EXO.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkïl pich cho ngöghomöch ompö Israel akutö kïlïkwï kintöghoghi pich 1,000 nko 100 nko 50 nko taman. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.25",
            "verseOrgIds": [
              "EXO.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipöghisyö le kirwokï ompö pich osis löwïr, Kipchï Musa ngal cho owesöch, kïmut chane cho kwïskwïs cho kimuköy.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.26",
            "verseOrgIds": [
              "EXO.18.26"
            ]
