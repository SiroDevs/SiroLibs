              "type": "text"
            }
          ]
        },
        {
          "text": "Kingalan Tororöt ngalechï löwïr lö, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.1",
            "verseOrgIds": [
              "EXO.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ochan ECHOTYON Tororötïnkwa, nyo kyamïtunekwa koro Misri wölo kyochikwa sekey.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.2",
            "verseOrgIds": [
              "EXO.20.2"
            ]
          }
        }
      ]
    },
    {
