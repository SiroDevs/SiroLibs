            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mekur kaynata ECHOTYON Tororötïngu kwïle, ompöwölo yityini ECHOTYON ngokï chi nyo kuröy kaynatenyi kwïle.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.7",
            "verseOrgIds": [
              "EXO.20.7"
            ]
          }
        }
      ]
