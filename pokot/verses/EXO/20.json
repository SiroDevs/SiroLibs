          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.19",
            "verseOrgIds": [
              "EXO.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Musa pïchay, “Mowöghisyö, kengwïn Tororöt kïtyamakwa, atawaghakwa nyinte atömaghakwa ngokï.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.20",
            "verseOrgIds": [
              "EXO.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtïpïyö pich wölo low, kïwö Musa kïrich poltonay kimi Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.21",
            "verseOrgIds": [
              "EXO.20.21"
            ]
          }
        }
      ]
    },
