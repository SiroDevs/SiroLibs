              },
              "items": [
                {
                  "text": "Krt 7:9-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesagh tïkuchoni anta ipöghisyechï, ompöwölo ochan ECHOTYON Tororötïngu nyo le söstoghin ompö tororötin walaka. Otökonan monïng ghöyïntino papotïnekwa pïnta nyo pö sömök nko nyo pö angwan, chona reyanïn. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo osyonchinan pich cho makïrar cho chömanïn, akïripöy kirurutköchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.6",
            "verseOrgIds": [
              "EXO.20.6"
            ]
          }
        }
      ]
    },
