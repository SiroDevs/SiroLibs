              "items": [
                {
                  "text": "Wuw 31:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kigh ECHOTYON yïm nko ngwïny nko nanam nko tïkwïn löwïr cho mi oringwa ompö osis mut nko akonga, atolapay kumuny ompö asispa mut nko odeny akusoyön asispa Sapato akutïlil.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.11",
            "verseOrgIds": [
              "EXO.20.11"
            ]
          }
        }
