          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïlenchï chane Musa, “Ngölonwecha nyo le nyi kïterecha. Wölo mekany kïngölonwecha Tororöt atömökïmeghecha.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.19",
            "verseOrgIds": [
