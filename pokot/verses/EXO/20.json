              "type": "text"
            }
          ]
        },
        {
          "text": "Meghchï kegh körkeyïn pö kïgh anka tïkwïl nyo kipötöy nyo mi yïm anta ngwïny anta nyo mi pögh cho mi ngwïny ori. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.4",
            "verseOrgIds": [
              "EXO.20.4"
            ]
          }
        },
        {
          "name": "verse",
