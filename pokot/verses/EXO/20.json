            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighenyi ighisyewutköku löwïr osis mut nko akonga, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.9",
            "verseOrgIds": [
              "EXO.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wölo lïku asispa mut nko odeny Sapato pö ECHOTYON Tororötïngu. Kïlenyona megh ighisyö anka tïkwïl asisoni: nyi anta werïngu anta cheptöngu anta mötworintengu anta kyakiku anta ton nyo mi katangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.10",
            "verseOrgIds": [
              "EXO.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
