            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato otekwanïkwa ato kïpelo amöros nyo pö koghïn, mateka koghïn cho kakipat, ompöwölo osïmnyonekwa ato opöghisyeghekwa karikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.25",
            "verseOrgIds": [
              "EXO.20.25"
            ]
          }
        },
        {
