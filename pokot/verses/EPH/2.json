            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.13"
              },
              "items": [
                {
                  "text": "Kol 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kyochikwa ato le tagh pich cho kimeghö, ompö tighintön nko ngokï, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.1",
            "verseOrgIds": [
              "EPH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "cho kyaghakwa atakinya kyorïpekwa otöp pö ngwïnyinï nyo gha, aterchini pöytoghinto oy nyo mi wölnö le mïröt, mïkulögh nyo le sïmnyon, nyo pöyu pich cho töghöy Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.2",
            "verseOrgIds": [
              "EPH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïlatecha tïkwïl choni, kikïrïpecha möchutko porwöyicho akegh kïgh anka tïkwïl nyo kimököy porwöyicho nko kinonutköcho. Kikïchicha monïngo nörekyo Tororöt le pikö walaka.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.3",
            "verseOrgIds": [
              "EPH.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.3",
            "verseOrgIds": [
              "EPH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo tïng Tororöt kisyonöt nyo wow. Kichamecha nyinte ompö chomnyogh nyo wow nyoman ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.4",
            "verseOrgIds": [
              "EPH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyo kïrkegh otini kitökechicha pich cho kimeghö ompö ngokicho, kwighecha nyinte kesöpchenö nko Kristo.* Kikïsörwokwa ompö pöropcho Tororöt, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.5",
            "verseOrgIds": [
              "EPH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "akwïghecha ketutunö nko nyinte akïkonecha kelïnyenö nko Kristo Yeso, atöketïpinö nko nyinte wölnö le yïm, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.6",
            "verseOrgIds": [
              "EPH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "tökuporï ompö könyis cho pkonöy wölo tenö sïkönöteto pöropchenyi nyo pö kisyönöt ompö acha kuwerï Kristo Yeso. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.7",
            "verseOrgIds": [
              "EPH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kikesörwokwa ompö pöropcho Tororöt ompö ara kighanat. Melö ompö ara ighisyewutkökwa, wölo ropöwonto Tororöt, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.8",
            "verseOrgIds": [
              "EPH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "melö ompö ighisyewut atömötöp chi anka tïkwïl tökïkwol kegh. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.9",
            "verseOrgIds": [
              "EPH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïchicha ighanpa Tororöt kighecha nyinte ompö Kristo Yeso, atökegha ighisyewut cho karamach cho kisötwecha nyinte kegha könyisyok.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.10",
            "verseOrgIds": [
              "EPH.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ghömïchö akonga ompö Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.10",
            "verseOrgIds": [
              "EPH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyochikwa ato le tagh, pipö punton cho kïkurenok, “Sompen,” kïkurö kegh pipö Yaudi, “Sorngony” (poru ngalechoni tïkwïn cho kighchini chane porwöyikwa). Anane wölo kyalatekwa ato le tagh. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.11",
            "verseOrgIds": [
              "EPH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onkïtï lö kyochikwa lowöch nko Kristo osiswechoni, kyomitekwa sanypa pipö Israel. Kyochikwa pïnot akimoghönekwanye kïgh ompö kiyomisut pö Tororöt. Kimotïngetekwanye kikönöt akimononekwanye lö mi Tororöt ngwïnyinï. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.12",
            "verseOrgIds": [
              "EPH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ye, akwa cho kyochï lowöch nyoman ompö Kristo Yeso, kikenokunekwa arikuna ompö meghenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.13",
            "verseOrgIds": [
              "EPH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo nyinte nyo keghecha kenyorunö kalya, otini kigh pipö Yaudi nko pipö punton kïlïkwï kïgh akonga, akunyar ompö meghenyi punyontön nyo kipesyot chane le nayat. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.14",
            "verseOrgIds": [
              "EPH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.14"
              },
              "items": [
                {
                  "text": "Kol 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiwang nyinte ompö meghenyi kirurut pö pipö Yaudi nko kinetutkökwa atömanyïl kwighuna puntonichoni kwodeny chi akonga cho tïng otöp nyo rel cho kakelinyö nko nyinte, akwompö aranoni kwipï kalya. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.15",
            "verseOrgIds": [
              "EPH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.20"
              },
              "items": [
                {
                  "text": "Kol 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atö kuwany megha Kristo punyontönengwa ompö kimurtöwon, akumï kunyoryö puntonichoni kwodeny kïlïkwï por akonga akuyokwï chane kïmïlisyö wölo mi Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.16",
            "verseOrgIds": [
              "EPH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.19"
              },
              "items": [
                {
                  "text": "Isa 57:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kingwïn Kristo akwomwokwa Lökoy cho Karamach cho pö kalya, akwa chona ochï pipö punton cho kyochï lowöch ompöwölo mi Tororöt akwomchï pipö Yaudi cho kilekïtö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.17",
            "verseOrgIds": [
              "EPH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimukecha ye nyu ompö ara Kristo kepete tawu Tororöt kuwerï Mïkulöwunoni le akonga, kïrkegh kechicha pipö Yaudi anta pipö punton.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.18",
            "verseOrgIds": [
              "EPH.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.18",
            "verseOrgIds": [
              "EPH.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona mochikwanye ngat pipö punton pïnot nko to, kalïkukwa ye pipö möngot akonga nko pipö Tororöt, pich cho omitö Kö pö Tororöt.* ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.19",
            "verseOrgIds": [
              "EPH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiketekyokwa paraku kitoröto kiyoktoghï nko werkoy akï nyinte Yeso Kristo nyo le kado luch. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.20",
            "verseOrgIds": [
              "EPH.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyinte nyo tighöy teksye kïmïkul akwigh kïyetï kïlïkwï Kö pö Tororöt nyo tïlil. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.21",
            "verseOrgIds": [
              "EPH.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmi ketekokwa tïkwïl alïkuna akonga nko nyinte aketekokwa nko pikö walaka alïkuna möngo Tororöt kuwerï Mïkulöwunyi.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.22",
            "verseOrgIds": [
              "EPH.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ighisyo Paulö ompö pipö punton",
          "type": "text"
        }
      ]
    }
  ],
