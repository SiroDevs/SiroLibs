              "items": [
                {
                  "text": "Ngo 18:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kïlenyona, tïpo wudïn opïn cho kïnyoru kïmöngöy Papilon, tyonkïn cho lata suyï nko cheptusonkol. Puryö chi nyo möngöy su korononi kokay. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.39",
            "verseOrgIds": [
              "JER.50.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
