              },
              "items": [
                {
                  "text": "Tow 19:24-25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïle wölo kyanyaran Sodoma nko Komora nko kanastin cho kilekïtinö, owetan ante ECHOTYON onyoröy Papilon ntömökïmi chi nyo ngötu kïmöngöy orinyi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.40",
            "verseOrgIds": [
              "JER.50.40"
            ]
          }
        }
