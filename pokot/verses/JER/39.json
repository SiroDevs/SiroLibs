{
  "id": "JER.39",
  "number": "39",
  "bookId": "JER",
  "reference": "Yeremia 39",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "39",
        "style": "c",
