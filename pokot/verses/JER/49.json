            }
          ]
        },
        {
          "text": " Kilö ECHOTYON Kimuktoghin paraku Edom,",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.7",
            "verseOrgIds": [
              "JER.49.7"
            ]
