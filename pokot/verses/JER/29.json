                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.2"
              },
              "items": [
                {
                  "text": "Dan 9:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Lentöy ECHOTYON, opetekwa omöngöy koro Papilon könyis 70. Atomuchö, ongwïnchokwa atopuntö ayomis nyo kikyamwaghan lö ongwïnan oyokwokwa omïlisyeno korengwo nyete. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.10",
            "verseOrgIds": [
              "JER.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo onkïtön ante ECHOTYON tötut nyo otötwokwa, tötut cho pö köromnyö, melö cho pö ghöyityö. Tötut cho konokwa kikönöt nko köromnyö ompö osis cho pkonöy. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.11",
            "verseOrgIds": [
              "JER.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuranïkwa nyu atoni asaghanïn aterwokwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.12",
            "verseOrgIds": [
              "JER.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.29"
              },
              "items": [
                {
                  "text": "Krt 4:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oyöranïkwa anyorwanïn ato ayaranïkwa ompö mïkulögh kïmïkul. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.13",
            "verseOrgIds": [
              "JER.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyorwanïkwa nyo mötïny atolapay aghamïtunekwa woptin löwïr cho kyotoytoychekwa. Oyokwokwa omïlisyeno korengwo nyo kyayonenakwa apa le pïnot.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kamwaghakwa lö, ‘Kökonecha ECHOTYON werkoy ompö koro Papilon.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo atere kïgh nyo mwoghöy ECHOTYON paraku pöytoghintonete töpo ye ngacharu paytaghpa Daudi nko pich löwïr cho möngöy kanasyantanï nko pikökwa löwïr cho mapanye nko akwa koro pïnotnön. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lentöy ECHOTYON Kimuktoghin, ‘Opchinan chane ngot nko kömöy nko sömew. Oghan chane kïkarkegh nko akwa makany cho kisïnö cho memukönye chi kwam. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.17",
            "verseOrgIds": [
              "JER.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opïrpïrenan chane ngot nko kömöy nko sömew nyo gha. Oghan chane kïlïkwï pich cho atosïwa pikö walaka kwotyö akïmïghyö. Kïmïnöy chane kwararit akepöghisyeghö kaynengwa ompö chïpö. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.18",
            "verseOrgIds": [
              "JER.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighisyot choni löwïr ompö chane ompöwölo melö kirïp ngölyontenyan nyo kyoyokchan chane kïtenö osis kuwerï mötworichan werkoy. Wölo melö kilïm chane. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.19",
            "verseOrgIds": [
              "JER.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwa löwïr chona kyayonan kïpa koro Papilon le pïnot, mïchinokwa atera kïgh nyo omwoghan ante ECHOTYON.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lentöy ECHOTYON Kimuktoghin, Tororöt pö Israel ompö paraku Aap wero Kolaya nko Sedekia wero Maaseya, ‘Kömïrchokwa pïchoni putintön ompö kaynenyan. Arose! Otöninan chane mori. Nepukadnesa, pöytoghinto Papilon nyo wetöy kïpöröy chane orosunekwa! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.21",
            "verseOrgIds": [
              "JER.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mököy chi anka tïkwïl nyo kikïranga koro Yuda kïwö Papilon le ratan kïchïpöy chi, chïpöy kïlenchini, “Nya kwiwun Tororöt le wölo kida Sedekia nko Aap cho kipela ma pöytoghinto Papilon kïsöpsot!” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.22",
            "verseOrgIds": [
              "JER.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku nyoni sörömungwa ompöwölo kigh tïpo arasï ompö kwenu pipö Israel. Kigh chane cheporesnan nko koru pöroriskökwa akïmïr putintön ompö kaynenyan, ngal cho melö kyomwochan chane kwigh. Onkïtön ante tïkwïn cho kigh, ochan söwinto tïkuchoni.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Palalyanta Syemaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyoktanïn ECHOTYON owö omwochï Syemaya chi pö Nelam lö, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.24",
            "verseOrgIds": [
              "JER.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "lentöy ECHOTYON Kimuktoghin, Tororöt pö Israel, “Kikirchinyi palalyan ompö kaynengu tïsin Sepania wero Maaseya nko tïsi walaka löwïr nko pipö Yerusalem kïmïkul lö, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.25",
            "verseOrgIds": [
              "JER.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Kakïlinyi ECHOTYON we Sepania lïkuna tïsin nyo keröy tïsin Yeoyada. Ilïkunyi yetïn nyo pö Kö pö Tororöt.* Kïmökeninyi torchinö chela airata sïrïmtin chepoyï anka tïkwïl nyo lentöy ochï werkoyon ompö Kö pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.26",
            "verseOrgIds": [
              "JER.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akï ye o, ompö ne tomö ighanyi lenyoni ompö Yeremia nyo ngwïno Anatot, nyona mwochini pich ngal cho lentöy pö werkoynön nya? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.27",
            "verseOrgIds": [
              "JER.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïchini kekar kut ompöwölo mwochini pich ompö Papilon lö, “Omikwa pïnotnön nyo pö könyis cho chang. Kïlenyona ateka korïn amöngisyö, angora paren am paghekwo.” ’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        },
        {
