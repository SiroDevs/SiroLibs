        "style": "s1"
      },
      "items": [
        {
          "text": "Palalyanta Yeremia nyo kikirchï pipö Yaudi ompö Papilon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
