          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lentöy ECHOTYON, “Mïghyot pöytoghï nko yetïntin asisoni, kïchïrïmnyö tïsï akïtöngönchö werkoy.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.9",
            "verseOrgIds": [
              "JER.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
