                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.11+2CH.36.12+2CH.36.13"
              },
              "items": [
                {
                  "text": "2Ot 36:11-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otini kitor Sedekia, wero Yosia kïpayta Yuda, kïlenchanïn ECHOTYON, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.1",
            "verseOrgIds": [
              "JER.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yeremia, ighchinö kegh mchokyon ompö angwoy nko ket airötchï katïngu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay iyokchï kut pöytoghi Edom nko Moap nko Amon nko Tiro nko Sidon nyo ipöy pich cho keyokwï pöytoghichoni kïpka Yerusalem kïnyorï Sedekia, pöytoghinto Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.3",
            "verseOrgIds": [
              "JER.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwochinö pïchoni ipöy kutinoni kïpa kïmwochï pöytoghikwa lö kamwaghan ante ECHOTYON Kimuktoghin, Tororöt pö Israel lö, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.4",
            "verseOrgIds": [
              "JER.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani nyo kyagh ngwïny nko pich nko tyonkïn cho söpsot cho mi ngwïny kïmïkul ompö owesyenyan nyo wow, atöninan chi owesyö lenyini kachaman. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.5",
            "verseOrgIds": [
              "JER.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyete le ye, kotönön koroschï löwïr mori mötworintenyan Nepukadnesa, pöytoghinto Papilon kotönön tïkwïl morichi tïpö wudïn atökïpöghisyechï nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.6",
            "verseOrgIds": [
              "JER.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pöghisyechini koroswö löwïr nyinte nko werunyi nko kukötanyi ntökïtenö ato rulöy paytaghtanyi. Atoni nyu ato ighöy pöytoghï nko koros cho echön, Papilon kïlïkwï sekeyontengwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo omungan kor anta paytagh anka tïkwïl nyo melutönye katïnyi möchokyo Nepukadnesa pöytoghinto Papilon akïpöghisyechï nyinte. Omungenan chane ngot nko kömöy nko sömew ntökïtenö awany lömïs ompö mori Nepukadnesa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona mater ngala werkoykökwa nko chepsoköytin nko kirwotïtoghï nko ponï cho mi kwenunkwa chona lenchinokwa mopöghisyechï pöytoghinto Papilon. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.9",
            "verseOrgIds": [
              "JER.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi chane kïlïsokwa ompö ngalekwa, nyo ato aterakwa, kepokwa wölo low ompö korenkwa. Otulchinokwa wölo low, apekwa owonyö. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.10",
            "verseOrgIds": [
              "JER.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato lut katïnyi chi pö kor anka tïkwïl möchokyo Nepukadnesa pöytoghinto Papilon akïpöghisyechï nyinte, opïsinan kïmöngisyö akïngor paren ompö korengwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyomwochan tïkwïl Sedekia pöytoghinto Yuda ngalechoni kyolenchan, “Olutö katwayikwo möchokyo pöytoghinto Papilon, apöghisyechï nyinte nko pikachi atosöpchenö. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.12",
            "verseOrgIds": [
              "JER.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö ne temegha nko piköku ompö ngot anta kömöy anta sömew? Nka chete tïkwïn cho kimwa ECHOTYON lö ighisyot ompö kor anka tïkwïl nyo möchomönye kïpöghisyechini pöytoghinto Papilon. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.13",
            "verseOrgIds": [
              "JER.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mater ngala werkoy chona lenchinokwa, mopöghisyechï pöytoghinto Papilon ompöwölo putintön ngalechoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.14",
            "verseOrgIds": [
              "JER.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö koyokwan chane wölo kamwa putintön ompö kaynenyan. Kïlenyona otulchinan chane wölo low, awonyan chane nko werkoychoni mwowokwa ngala putintön.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay omwochan tïsï nko pïchoni löwïr lö lentöy ECHOTYON, “Mater ngala werkoykökwa cho mwowokwa lö kiyoku nyete le lawel kari Kö pö Tororöt kïpkana Papilon, ompöwölo putintön choni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.16",
            "verseOrgIds": [
              "JER.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mater ngalekwa. Opöghisyechinö pöytoghinto Papilon tosöpchenö ompö ne tachama kegh kanasyantanï kïlïkwï kïratyan nyo kirulyö korïn kutïkumö nya? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.17",
            "verseOrgIds": [
              "JER.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato kö werkoy chane cho pö man akïtïng ngölyontenyan, kwompö ne tömösaghanïn, ECHOTYON Kimuktoghin, tömökip karïn cho kidong Kö pö Tororöt nko kö pö pöytoghinto Yuda nko kanasyanta Yerusalem kïpa koro Papilon.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kirang pöytoghin Nepukadnesa, Yekonia wero Yeoyakim pöytoghinto Yuda nko pich cho echön ompö Yuda nko Yerusalem kïpa le pïnot, kimi tïkwïn cho kituk mepnye. Mepnye tïkwïn cho lata pchörin, töreni taghoy, nkaritin nko tïku walaka cho mi Kö pö Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.19+JER.27.20",
            "verseOrgIds": [
              "JER.27.19",
              "JER.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.19+JER.27.20",
            "verseOrgIds": [
              "JER.27.19",
              "JER.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lentöy ECHOTYON Kimuktoghin ompö paraku kari chay kingötï Kö pö Tororöt nko kö pö pöytoghinto Yuda nko kanasyanta Yerusalem, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.21",
            "verseOrgIds": [
              "JER.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kipöy löwïr kugheghöy Papilon akïtïpïyot wölini ntökïtenö atoni kangwïnan asat. Atoni nyu ato oyokunan kïpka wölete. Kamwaghan ante ECHOTYON lenyoni.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.22",
            "verseOrgIds": [
              "JER.27.22"
            ]
          }
        }
      ]
    }
  ],
