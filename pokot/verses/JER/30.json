            "sid": "JER 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenchanïn ECHOTYON, Tororöt pö Israel, “Kirchinö kitapï ngalechï löwïr komwowunyi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.1+JER.30.2",
            "verseOrgIds": [
              "JER.30.1",
              "JER.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ompöwölo itu osiswö cho oyokyinan piköchan Israel nko Yuda tïkukwa. Oyokunan chane kïmïlisyö kor nyo kyotönön papotïnekwa akïchengöy ngat kïlïkwï nyingwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
