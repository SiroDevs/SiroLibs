        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        2Pöy 23:36–24:6",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7"
              },
              "items": [
                {
                  "text": "2Ot 36:5-7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïlenyona omwoghöy nyinte ECHOTYON ompö paraku Yeoyakim wero Yosia, pöytoghinto Yuda lö,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngölyonto Yeremia ompö kiwonyogh pö Yerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kirwoko Tororöt ompö Yeoyakin",
          "type": "text"
        }
      ]
    },
    {
