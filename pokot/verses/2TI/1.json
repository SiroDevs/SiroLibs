          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakirwan palalyantanï ante Paulö kiyoktoghinto* Kristo* Yeso ompö machata Tororöt, ani nyo kikïyonton amwatïta ngala kiyomisöto söpon nyo kïsïkecha otini kökïtuyecha nko Kristo Yeso.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        }
      ]
    },
    {
