          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiryam kiyoktoghichay nko Yeso, kïtep nyinte lö, “Echotyon, panete ato iyokyinenyi paytagh Israel?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.6",
            "verseOrgIds": [
              "ACT.1.6"
            ]
          }
        }
      ]
