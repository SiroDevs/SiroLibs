              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kecher kaynötut pö pich odeny: Yosep, nyo kikïkuro Parsapas (akekuro Yusto) nko Matias. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.23",
            "verseOrgIds": [
              "ACT.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïsagh chane lö, “Echotyon, nyi nyo inkït mïkulis pö pich löwïr, porwecha ompö pïchï le odeny lö nyono nyo kekïlanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.24",
            "verseOrgIds": [
              "ACT.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
