          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kughyongö Petro osiswechoni tawu kighönï cho kingata 120 akïlö, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.15",
            "verseOrgIds": [
              "ACT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tupchenichu, kömïchï kïpïntö Kikirut cho kimwa Mïkulögh nyo Tïlil kuwerï kuti Daudi ompö ngala Yudas nyay kintöghoghchï pich cho kipa kïnam Yeso. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.16",
            "verseOrgIds": [
              "ACT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki akonga Yudas nko acha akitïng karerantanyi ompö ighisyencha.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.17",
            "verseOrgIds": [
              "ACT.1.17"
            ]
          }
        }
      ]
    },
