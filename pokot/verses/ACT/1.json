          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïcheng ighisyonï pö kiyoktoghin* kipïsto Yudas kïwö arenyi onkït.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.25",
            "verseOrgIds": [
              "ACT.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïpïrchï kura chane, kïnyorï Matias kur. Kïlïkwï nyinte akonga nko kiyoktoghichay le taman nko akonga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.26",
