          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïmïlisyeghö kiyoktoghï kutïng pö Arol kutang Yerusalem, pan nyo kitöy kilomita akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.12",
            "verseOrgIds": [
              "ACT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.2+MAT.10.3+MAT.10.4"
              },
              "items": [
                {
                  "text": "Mat 10:2-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.16+MRK.3.17+MRK.3.18+MRK.3.19"
              },
              "items": [
                {
                  "text": "Mrk 3:16-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.14+LUK.6.15+LUK.6.16"
              },
              "items": [
                {
                  "text": "Luk 6:14-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyini kïlïtöy kanasyan kïpus kïpa kö nyo mi parak wölo kimpuröy ompö: Petro nko Yoana nko Yakopo nko Andrea nko Pilipo nko Tomas nko Partolomayo nko Matayo nko Yakopo wero Alpayo nko Simon nyo kïkuro Silot, akïlö Yudas wero Yakopo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.13",
            "verseOrgIds": [
              "ACT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïghömö nyu chane löwïr kïlïkwï kïgh akonga kïmi korï nko Marya yoto Yeso nko werko ompö Yeso, kïsagh.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.14",
            "verseOrgIds": [
              "ACT.1.14"
            ]
          }
        }
      ]
    },
