            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " (Kyala nyinte par ropïyenichini kisïkö ighisyenyi nyo gha. Kupïtyï ngwïny kïkarera mu kïmïlï kegh kwan löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.18",
            "verseOrgIds": [
              "ACT.1.18"
