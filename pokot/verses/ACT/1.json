            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.6",
            "verseOrgIds": [
              "ACT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï chane, “Melö parakunkwa onkïtunö osis anta könyis cho kitat Paponyan ompö owesyenyi kegh. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.7",
            "verseOrgIds": [
              "ACT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.19"
              },
              "items": [
                {
                  "text": "Mat 28:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.15"
              },
              "items": [
                {
                  "text": "Mrk 16:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.47+LUK.24.48"
              },
              "items": [
                {
                  "text": "Luk 24:47-48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wölo onyorunekwa owesyö otini körökyokwa Mïkulögh nyo Tïlil alïkukwa nyu söwichan ompö Yerusalem nko koro Yudea kïmïkul nko Samaria, ntökwïtïta sörömu ngwïny.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.8",
            "verseOrgIds": [
              "ACT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.19"
              },
              "items": [
                {
                  "text": "Mrk 16:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.50+LUK.24.51"
              },
              "items": [
                {
                  "text": "Luk 24:50-51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïkany kuwany kïngölonöy, kengwïsa nyinte tawungwa akep kïwö yïm kïsïwïyi chane ntökïtenö kïkarta polta.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.9",
            "verseOrgIds": [
              "ACT.1.9"
            ]
          }
        }
      ]
    },
    {
