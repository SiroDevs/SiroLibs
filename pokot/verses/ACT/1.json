            "number": "19",
            "style": "v",
            "sid": "ACT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunkïtï pich löwïr ngalechoni cho kimöngöy Yerusalem, kïlenyona kïkurö paranay Akeldama ompö kutingwa, nyoni kelentöy, “Para Kisön.”)",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.19",
            "verseOrgIds": [
              "ACT.1.19"
            ]
          }
