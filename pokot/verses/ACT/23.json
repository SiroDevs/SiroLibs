    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchirchï kong Paulö pïchay mi Kokwö* akïlö, “Tupchenichu! Möwiranïnye choghïn nyo gha ompö tawu Tororöt ompö nyete le asisete.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.1",
            "verseOrgIds": [
              "ACT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï Anania nyo le Tïsin nyo Wow* pich cho kighyongo atolekïtö Paulö lö, arapaka nyinte kut. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.2",
            "verseOrgIds": [
              "ACT.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.27+MAT.23.28"
              },
              "items": [
                {
                  "text": "Mat 23:27-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïlenchï Paulö, “Nya kurapakinyi Tororöt, nyi nyo ilata nayat nyo kikïnyïra choka! Ketöponenyi atoni irwokwanïn kïrïp kegh nko kirurut, akwanyï inyorenyi kirurut imwochini pich kurapakanïn.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.3",
            "verseOrgIds": [
              "ACT.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.3",
            "verseOrgIds": [
              "ACT.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï pïchay kighyongo atolekïto Paulö, “Kechïpönyi Tïsinto Tororöt nyo Wow.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.4",
            "verseOrgIds": [
              "ACT.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
