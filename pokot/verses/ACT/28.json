              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmang Paulö könyis odeny kö nyo kighoktoy nyinte, akïtach pich lapay cho kipka kuros nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.30",
