              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwany nyu Paulö kïlenchï, “Onkïtunö ye nyu lö, kakeyonta ngölyonto Tororöt nyo pö sörunöt kutang pipö punton. Lïmöy chane!” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.28",
            "verseOrgIds": [
              "ACT.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kiwany Paulö kïmwa lenyoni, kumölomöl kegh pipö Yaudi nyoman.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.29",
            "verseOrgIds": [
              "ACT.28.29"
            ]
          }
        }
