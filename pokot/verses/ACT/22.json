            "sid": "ACT 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panini lawel kuchïchuka kegh wölo mi Paulö pïchay kömököy kïmunyöy nyinte, kuwöghisyö yetïnay otini kinkïtï lö ki Rumiyon Paulö, akwanyï karata nyinte sïrïmtin.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.29",
            "verseOrgIds": [
              "ACT.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mi Paulö tawu Kokwö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
