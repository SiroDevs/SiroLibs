          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï yetïnay wow, “Kyalïkwan chi pö kanasyanta Rumi ompöwölo kyalan ropïyen cho chang.” Kïlenchï Paulö, “Wölo ochan chi pö Rumi ompö yiyö.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.28",
            "verseOrgIds": [
              "ACT.22.28"
            ]
          }
        }
