  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "2CH 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mi löt kïrapas Yeosyapat ketïpchï wölo kikïtïpchï Papotïnechi wölo kikïtïpchini pöytoghï ompö kanasyanta Daudi kuker werïnyi Yeoram kïlïkwï pöytoghin.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.1",
            "verseOrgIds": [
              "2CH.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pöytoghin Yeoram nyo pö Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.1",
            "verseOrgIds": [
              "2CH.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Yeoram werkökwa, werpö Yeosyapat, pöytoghinto Yuda akï choni kï Asaria nko Yeyel nko Sakaria nko Asaria nko Mikael nko Syepatia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.2",
            "verseOrgIds": [
              "2CH.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiropchï papongwa tïkwïn cho echön cho pö Silpa nko koltin akïlö tïku walak cho pïchighöch akutö ngat kanasyanta Yuda nyo tïng nayat cho oghïgh. Wölo ompöwölo Yeoram nyo kile poretyenyi, kutö Yeosyapat paytaghtanyi kïpayta kuker nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.3",
            "verseOrgIds": [
              "2CH.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kitöpö Yeoram ngacharu paytagh akïchïchïm paytaghtanyi, kïpar werkökwa löwïr akïpar tïkwïl kintöghoghi walaka cho echön ompö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.4",
            "verseOrgIds": [
              "2CH.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitor Yeoram paytagh ato kitïng könyis 32. Kipayta ompö Yerusalem könyis mut nko sömök.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.5",
            "verseOrgIds": [
              "2CH.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.5",
            "verseOrgIds": [
              "2CH.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirïp otöptino pöytoghin Aap cho ghach nko cho pö pöytoghi Israel walak le wölo kighöy pipö kö pö Aap ompöwölo kip chepö Aap kïlïkwï korkenyi. Kigh nyinte ngokï ompö tawu ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.6",
            "verseOrgIds": [
              "2CH.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.36"
              },
              "items": [
                {
                  "text": "1Pöy 11:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo machamnye ECHOTYON kuwany pipö ara Daudi, ompöwölo kikikwan muma* nko Daudi, akikikuyomis Daudi lö, letöy tagh yiyenyi kïpöytoy kokay.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.8",
            "verseOrgIds": [
              "2CH.21.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.40"
              },
              "items": [
                {
                  "text": "Tow 27:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitagh pipö Edom paytaghpa Yuda ompö osiswo Yeoram akïkïlchï kegh pöytoghintengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.8",
            "verseOrgIds": [
              "2CH.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, kïnget Yeoram oghö kïmi nko yetïntinechi pö lïk nko nkarinechi löwïr, akïwö kiporyeghö pipö Edom cho kökikurik nyinte nko yetïntinechi pö lïk nko nkarinechi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.9",
            "verseOrgIds": [
              "2CH.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.9",
            "verseOrgIds": [
              "2CH.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kitagh pipö Edom paytaghpa Yuda nko nyete le ye. Osiswechoni ato kïpesyö tïkwïl pipö kanasyanta Lipna ompöwölo kikipïstö Yeoram ECHOTYON, Tororöto papotïnechi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.10",
            "verseOrgIds": [
              "2CH.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amönyoninye onkït, kitek ompö kutïng pö Yuda wölo kïsogho körkeyïntin akuntöghoghchï pipö Yerusalem kupotö kighanata, akuryal pipö Yuda kupotyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.11",
            "verseOrgIds": [
              "2CH.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurelchï palalyanta pöytoghin Yeoram nyo kingwïno wölo mi werkoyonta Eliya nyo kikikir lö, “Kölö ECHOTYON, Tororöt pö paponkwa Daudi, merïpanyinye pöghisyewut pö papongu pöytoghin Yeosyapat anta cho pö Asa pöytoghinto Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.12",
            "verseOrgIds": [
              "2CH.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kirïpanyi otöptino pöytoghi pipö Israel aighanyi pipö Yuda nko Yerusalem kïlïkwï penyï ompö tawu Tororöt le wölo kida Aap nko pöytoghï cho kirïpöy nyinte pipö Israel. Anyï ye keparanyi werkökwa, cho opo kaw akonga, cho kikaramach kïtïlinyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.13",
            "verseOrgIds": [
              "2CH.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, yonchini ECHOTYON piköku nyaril, maneku nko koruku, akunyar tïkuku löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.14",
            "verseOrgIds": [
              "2CH.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nöminyi nyo le nyi sömewö nyo gha kwan, nyo mösöpönye tökïtenö kïpka kwanköku sany.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.15",
            "verseOrgIds": [
              "2CH.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwïkwï ECHOTYON pipö Pilisti nko pipö Arapia cho kimöngöy ato le kïtö pipö Etopya kïpa kïporyö nko Yeoram. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.16",
            "verseOrgIds": [
              "2CH.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa nyu kïset kïpar koro Yuda akïngatar tïkwïn löwïr cho kimi kö pö pöytoghin akuretö monechi löwïr nko koruchi, kudong Aasia werïnyi nyo mïnïng.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.17",
            "verseOrgIds": [
              "2CH.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.17",
            "verseOrgIds": [
              "2CH.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mi lötuto ngalechoni löwïr, kïwira ECHOTYON pöytoghin sömew nyo kinam kwan nyo kimötïngnye sakïtyan. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.18",
            "verseOrgIds": [
              "2CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinam sömewö, akïlïkwï sömewenyi nyo töso asis anka tïkwïl. Kïma sörömuto könyito odeny ompö ngwonïn nyo wow menoghchïnye pikachi nyinte ma otini kima le papotïnechi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.19",
            "verseOrgIds": [
              "2CH.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.19",
            "verseOrgIds": [
              "2CH.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitor Yeoram kïpayta kïtïng könyis 32. Kïpayta könyis mut nko sömök ompö Yerusalem. Puryö chi nyo kilok otini kima. Kikïtïpchï kanasyanta Daudi wölo melö wop nyo kïtïpchini pöytoghï.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.20",
            "verseOrgIds": [
              "2CH.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pöytoghin Aasia nyo pö Yuda",
          "type": "text"
        }
      ]
    }
  ],
