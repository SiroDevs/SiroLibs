          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato set piköku kïpa kïporyö nko pungkökwa kïrïp kegh nko wölo kemwochintenyi akïsaghinyi chane kïpöru kanasyantanete kikïlanyi nko köyï kyotekunyi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "iter nyu ompö yïm sowutkökwa nko somutkökwa aitö chane owesyö kïrïnta pungkökwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        }
      ]
