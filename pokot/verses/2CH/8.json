                "loc": "DEU.16.16"
              },
              "items": [
                {
                  "text": "Krt 16:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipel amörostin kïrïp kegh nko Kirurut pö Musa ompö asis anka tïkwïl nyo tïlil, choni kï: Sapatotin* nko Ichontino Relïn pö Arawa nko ichontin sömök cho echön, choni kï: Ichon pö Makatin cho puryö Mumar nko Ichon pö Ilö nko Ichon pö Tunkun. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitat wölo ightoy tïsï ighisyengwa le wölo kidoy paponyi Daudi, kutö pipö Lawi pöghisyengwa nyo pö sölut nko kintaghoghat ompö tawu tïsï kïrïp kegh nko ighisyo asis anka tïkwïl, kuyomis ripi kukot kwigh pöghisyengwa lasiny ompö kukat anka tïkwïl, ompöwölo lenye nyoni wölo kiyomistö chi pö Tororöt Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amöpïstöcha ngala pöytoghin cho kitötyï tïsï nko pipö Lawi kïrïp kegh nko ngölyon anka tïkwïl anta kïrïp kegh nko ngala kaplawachtin.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
