      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiwonyö könyiswö cho le tömönut odeny, cho kiteka Solomon Kö pö Tororöt nko konyi kegh. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.1",
            "verseOrgIds": [
              "2CH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtek Solomon kanastin cho kikikutö Uram nyinte, akutö pipö Israel kïmang. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.2",
            "verseOrgIds": [
              "2CH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïset Solomon kïwö Amat Sopa, akïrïnta ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.3",
            "verseOrgIds": [
              "2CH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïtek kanasyanta Tadmor ompö surkwen nko kanastin löwïr cho kïrorchini tïkwïn ompö Amat. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.4",
            "verseOrgIds": [
              "2CH.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitek tïkwïl Pet Oron nyo toka nko Pet Oron nyo porö, kanastin cho kikiwak, cho kitïng nïyet nko kukot nko köröwe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.5",
            "verseOrgIds": [
              "2CH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Paalat nko kanastinechï pö kaplawach löwïr cho kitïng töpoton nko cho pö nkarinechi nko kanastin cho pö pich cho ipöy angoletinechi nko kïgh anka tïkwïl nyo kimököy Solomon kïteköy ompö Yerusalem nko ompö Lepanon nko ompö kor löwïr wölo kitöy paytaghtanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.6",
            "verseOrgIds": [
              "2CH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pich löwïr nyu cho kidong cho melö ki pö pipö Israel pipö Ititi nko Amori nko Peris nko Ipiti nko Yepusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.7",
            "verseOrgIds": [
              "2CH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh Solomon monïngo pïchoni kidong korononi cho kimaparcha pipö Israel kïkwöghchï nyinte surï, atökïlenye nyoni nko nyete le ye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.8",
            "verseOrgIds": [
              "2CH.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo meghnye Solomon pipö Israel kïlïkwï sekeykachi. Kilïkwï chane pich cho pö lïk nko yetïntino pich cho setöy lïkos nko cho kisetöy pich cho ipöy angoletin kïpa poryot nko cho kipöy angoletine. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.9",
            "verseOrgIds": [
              "2CH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Solomon kirwokot cho kintöghoghchïn pich cho kile 250.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwuwï nyu Solomon chepö Parao kuwuwunö kanasyanta Daudi kungwïn kïmang kö nyo kitekyï nyinte, ompöwölo kimwa lö, “Mömöngönye korkenyan kö pö Daudi pöytoghinto Israel ompöwölo tïlil wop anka tïkwïl wölo mi Santuku Muma* ECHOTYON.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïropchï Solomon ECHOTYON ropöw cho kïpelöy ompö ato kïpelo amöros nyo kitekyï körkör tagh ompö tawu Kö pö Tororöt.* ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
