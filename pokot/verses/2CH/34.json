              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.3"
              },
              "items": [
                {
                  "text": "2Ot 33:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngany pich ato kïpelo amörostino Paal* ompö tawunyi akurul ato kïpelo tïkwïn cho ngutoy cho onyïn cho lekïtöch. Kïtörotör körkeyïntino Asyera nko körkeyïntine walak löwïr cho kikipat nko cho kikitany kïlïkwï syawsyaw akïtïghotïgh kïlïkwï terïtyon akïlösyï pïrïmpoti pich cho kipelchini körkeyïntinechoni amörostin.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
