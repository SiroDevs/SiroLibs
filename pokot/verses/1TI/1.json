            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakirwan ante Paulö kiyoktoghinto* Kristo* Yeso kïle wölini kimakta Tororöt Ghetintenyo nko Kristo Yeso nyo le kikönötenyo.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.1",
            "verseOrgIds": [
              "1TI.1.1"
            ]
          }
        }
      ]
    },
