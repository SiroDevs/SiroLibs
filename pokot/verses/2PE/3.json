              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.16",
            "verseOrgIds": [
              "2PE.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo akwa, tupchenichu kikyonkïtukwa ngölyontononi. Orip kegh nyu tömemïtak pich cho le penyi ara kipotöt ompö kinetutkakwa cho pö putintön akwighak ochïntenö ompö kighyongötengwo nyo chïchïmate. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.17",
            "verseOrgIds": [
              "2PE.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo atasa tagh oghetunö ompö pöropchö nko kinkïtöto Echotyontenyo akï Ghetintenyo Yeso Kristo.* Nya kïsïch nyinte ororyö kïngeta ye nko kokay! Amen.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.18",
            "verseOrgIds": [
              "2PE.3.18"
            ]
          }
        }
      ]
    }
  ],
