                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.39"
              },
              "items": [
                {
                  "text": "Luk 12:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.2"
              },
              "items": [
                {
                  "text": "1Ts 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.15"
              },
              "items": [
                {
                  "text": "Ngo 16:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wölo miru asispa Echotyon le chorin. Weröy yïmöy Asisoni nko kighumöt nyo wow, kiwuro ma tïpö yïm, kïpelöy ngwïny nko tïkwïn löwïr cho mi orinyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.10",
            "verseOrgIds": [
              "2PE.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany ato kiwuröy tïkuchoni löwïr lenyoni, mïchinokwa nyu olïkune pich cho nenach nya? Mïchini otïpinökwa otöp nyo tïlil nyo teköy Tororöt, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.11",
            "verseOrgIds": [
              "2PE.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "otini omitekwa oköngöy Asisoni ngwïnöy Tororöt kurwokyini ngwïny akïmïchini agha Asisoni kwitï lawel. Asis nyoni nyo kiwuro ma yïmöy nko tïkwïn löwïr cho mi yïmöyichoni. Lochini tïkuchoni ma tökuyinta. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.12",
            "verseOrgIds": [
              "2PE.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.17"
              },
              "items": [
                {
                  "text": "Isa 65:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.22"
              },
              "items": [
                {
                  "text": "66:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.1"
              },
              "items": [
                {
                  "text": "Ngo 21:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wölo kïköngecha kïgh nyo kikuyomiswecha Tororöt. Nyoni kï yïm nyo rel nko ngwïny nyo rel wölo möngöy man.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.13",
            "verseOrgIds": [
              "2PE.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.13",
            "verseOrgIds": [
              "2PE.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona nyu, kongotichu, otini omitekwa oköngöy Asisoni, okilö kegh lasiny alïkwï pich cho tïlilöch akï cho puryö lelut ompö tawu Tororöt, asïch kalya nko nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.14",
            "verseOrgIds": [
              "2PE.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyitö lö mïkukönöto Echotyontenyo ompö acha, akï pöroyïn nyo kökonecha tökenyorunö sörunöt le wölanye kikirwakwa werïnyo Paulö ompö ngöghomnyö nyo kitö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.15",
            "verseOrgIds": [
              "2PE.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyete wölo mwoytoy nyinte ompö palaltinechi lapay paraku ngölyontoni. Mi tïkwïn cho oghïghe kesöwï ompö palaltinechi, tïkwïn cho muköy sölwöy nko cho puryö wölo ghyongo kuweng ompö ara putintön, le wölo wengtoy Kikirutkö walaka cho Tïlilöch kïchumponchö. Kïlenyona ipchini kegh kiwurat.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.16",
            "verseOrgIds": [
              "2PE.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
