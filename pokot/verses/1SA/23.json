  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "1SA 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kemwochï Daudi lö, “Mi pipö Pilisti kïporyegho kanasyanta Keila akïchoröy pagh cho mi ghatoy.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.1",
            "verseOrgIds": [
              "1SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.1",
            "verseOrgIds": [
              "1SA.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Daudi ECHOTYON lö, “Owan oporyeghö pïchï pö Pilisti?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.2",
            "verseOrgIds": [
              "1SA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Daudi, “Wïyö poryeghenö chane aisörï kanasyanta Keila.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.2",
            "verseOrgIds": [
              "1SA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.2",
            "verseOrgIds": [
              "1SA.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlenchï pikachi Daudi, “Kakemïghyecha ompö wölete le Yuda, lentöy ne nyu ato kïpecha Keila keporyeghö pipö Pilisti?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.3",
            "verseOrgIds": [
              "1SA.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Daudi ECHOTYON ngat. Kïlenchï ECHOTYON nyinte, “Wïyö tanga Keila, ompöwölo otönan pipö Pilisti morikwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.4",
            "verseOrgIds": [
              "1SA.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Daudi nko pikachi kutang Keila akïporyö nko pipö Pilisti akïrongwï tukakwa akïpar chane cho chang. Kïsörï nyu Daudi pipö Keyila.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.5",
            "verseOrgIds": [
              "1SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.5",
            "verseOrgIds": [
              "1SA.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kip Apyatar wero Aimelek epod* otini kiperta kutang Keila wölo mi Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.6",
            "verseOrgIds": [
              "1SA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.6",
            "verseOrgIds": [
              "1SA.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kemwochï Saulö lö, köwö Daudi Keila. Kïlö Saulö, “Kikutö nyu Tororöt nyinte morichan, ompöwölo kökörchï kegh kanasyan nyo tïng kukot cho tekote.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.7",
            "verseOrgIds": [
              "1SA.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï Saulö pikachi kïpa Keila atökurich akïporyeghö Daudi nko pikachi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.8",
            "verseOrgIds": [
              "1SA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.8",
            "verseOrgIds": [
              "1SA.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunkïtï Daudi lö kitïng Saulö tötut kïpar nyinte, kïlenchï tïsintonay le Apyatar, “Ipunö yi epodnay.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.9",
            "verseOrgIds": [
              "1SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlö Daudi, “We ECHOTYON Tororöt pö Israel, kalïman lö ngwïnöy Saulö Keila, atökunyar kanasyante akwompö ani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.10",
            "verseOrgIds": [
              "1SA.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osoghinyi ECHOTYON Tororöt pö Israel lö mwowante, tönanïn pipö Keila morichi? Ngwïnöy Saulö wölete le ato kalïman?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.11",
            "verseOrgIds": [
              "1SA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Daudi, “Ngwïnöy wölete.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.11",
            "verseOrgIds": [
              "1SA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.11",
            "verseOrgIds": [
              "1SA.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö nyinte, “Tönanïn pipö Keila nko piköchan mori Saulö?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.12",
            "verseOrgIds": [
              "1SA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö ECHOTYON, “Töninyi.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.12",
            "verseOrgIds": [
              "1SA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.12",
            "verseOrgIds": [
              "1SA.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingeta Daudi Keila nko pikachi cho kingata 600, kïpa wölo kïpestata. Otini kilïm Saulö lö kikuperta Daudi, kïpïrönö kïrïp nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.13",
            "verseOrgIds": [
              "1SA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi ompö komos",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.13",
            "verseOrgIds": [
              "1SA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwïnchï kegh Daudi wölo aghïgh ompö surkwen, cho mi komoswo surkwen pö Sip. Kiyar Saulö Daudi kïtenö osis, wölo metönye Tororöt nyinte morichi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.14",
            "verseOrgIds": [
              "1SA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimïgh Daudi nyoman ompöwölo kimököy Saulö kïpöröy nyinte. Kimi surkwen pö Sip nyo mi Ores. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.15",
            "verseOrgIds": [
              "1SA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Yonatan wero Saulö wölo mi Daudi ompö Ores, akuchïchim nyinte kutwayta kegh Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.16",
            "verseOrgIds": [
              "1SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï nyinte, “Mewoghisyö, ompöwölo melö muköy paponyan Saulö ntökïparinyi, ilïkunenyi pöytoghinto Israel, alïkwan rïpöwontengu, akunkït paponyan lenyoni.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.17",
            "verseOrgIds": [
              "1SA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwam chane muma kwodeny ompö ECHOTYON. Kudong Daudi Ores, kïwö Yonatan kaw.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.18",
            "verseOrgIds": [
              "1SA.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.18",
            "verseOrgIds": [
              "1SA.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.19",
            "verseOrgIds": [
              "1SA.23.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.54"
              },
              "items": [
                {
                  "text": "Tum 54",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa pipö Sip kutang Kipea wölo mi Saulö, akïlenchï, “Mi Daudi kïwïngo kegh wölo aghïgh ompö Ores nyo mi kutïng pö Akila ewu tagh ompö Yesimon. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.19",
            "verseOrgIds": [
              "1SA.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyonö nyu, we pöytoghin, korencha ato imökenyi lenyoni atöketönöcha nyinte moriku.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.20",
            "verseOrgIds": [
              "1SA.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.20",
            "verseOrgIds": [
              "1SA.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Saulö, “Nya kuperurokwa Tororöt, ompöwölo kosyonchanïkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.21",
            "verseOrgIds": [
              "1SA.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ape okïtunö lasiny otini mi nyinte, akï ngo nyo kasïwechï nyinte wölini, ompöwölo kakïmwowanïn lö lïsin nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.22",
            "verseOrgIds": [
              "1SA.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omörörunö nyu lasiny wölo westegho nko wölo wïngo kegh, apkan nyu omwowanïn ngala man. Atowan nyu nko akwa, atomito kïnye kore, oyöran kïghömu koro Yuda kïmïkul.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.23",
            "verseOrgIds": [
              "1SA.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.23",
            "verseOrgIds": [
              "1SA.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa pïchay chane kuntaghogha Saulö kutang surkwen pö Sip. Kimito Daudi nko pikachi surkwen pö Maon, nyo mi Arapa, okumpö tagh ompö Yesimon. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.24",
            "verseOrgIds": [
              "1SA.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Saulö nko pikachi kïyar nyinte. Kemwochï Daudi, kïlenyona kurïp kïwö kumpur köpön nyo mi surkwen pö Maon. Nyini kilïm Saulö kïrïp nyinte kutang surkwen pö Maon. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.25",
            "verseOrgIds": [
              "1SA.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwit Saulö nko pikachi kutïngtö kareran, kïmi Daudi nko pikachi kareran kïngwïnto kegh atömönyorï Saulö. Otini kimi Saulö nko pikachi kuriköy Daudi atökïnam nyinte nko pikachi, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.26",
            "verseOrgIds": [
              "1SA.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwitï chi akïlenchï Saulö, “Mïlena lawel ompöwölo kikupokyï pipö Pilisti kore.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.27",
            "verseOrgIds": [
              "1SA.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpïstö Saulö Daudi akïwö kïporyeghö pipö Pilisti, kïlenyona kekurö atoni Ghatya Chïwïtat. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.28",
            "verseOrgIds": [
              "1SA.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïweghö Daudi atoni akïmang köpönoti okumpö Enkedi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.29",
            "verseOrgIds": [
              "1SA.23.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Katagh Daudi kïpar Saulö",
          "type": "text"
        }
      ]
    }
