  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "1SA 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Samwel, “Ilöngönchini Saulö nko oyï? Akwanyï isïwïyenyi lö, kataghan nyinte kïlïkwï pöytoghinto Israel? Nyïghita mwagh lal aiwö itang ka Yese nyo mi Petleem, ompöwölo kakïlan akonga ompö werkachi kïlïkwï pöytoghin.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.1",
            "verseOrgIds": [
              "1SA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.1",
            "verseOrgIds": [
              "1SA.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Samwel, “Owetan lö ne? Atolïm Saulö kïpöranïn.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö ECHOTYON, “Chenga mösör ailö, ‘Owetan otoni ECHOTYON amöros.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikur Yese ompö amörosnoni atoporunyi kïgh nyo ighenyi. Iyilwaninyi nyu chi nyo oporunyi.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.3",
            "verseOrgIds": [
              "1SA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.3",
            "verseOrgIds": [
              "1SA.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh Samwel lenyini kimwochï ECHOTYON, kïwö kutang Petleem. Kïpka poyi kanasyan kïtarok nyinte akïpotonchot, akïtep lö, “Kengwïnanyi ompö pöghisyö nya?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.4",
            "verseOrgIds": [
              "1SA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.4",
            "verseOrgIds": [
              "1SA.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö nyinte, “Owöy! Kangwïnan ompö pöghisyö otö ECHOTYON amöros, otïlilö kegh akepa nko ani ketötö amöros.” Kutïlil Samwel Yese nko werkachi akïkur chane ompö amörosnoni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.5",
            "verseOrgIds": [
              "1SA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.5",
            "verseOrgIds": [
              "1SA.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kipetöy, kuros Samwel Elyap akïlö, “Nyoman nyete nyo kakïkïl ECHOTYON.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.6",
            "verseOrgIds": [
              "1SA.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlenchï ECHOTYON Samwel, “Meros wölo lata nyinte anta koghïnto portanyi, ompöwölo kataghan nyinte. Melö rosöy ECHOTYON le ptangengmöt nyo rosöy wölo lata chi, wölo rosöy ECHOTYON mïkulögh.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur Yese Apinadap kuwer tawu Samwel. Kïlö Samwel, “Makïlnye ECHOTYON nyete tïkwïl.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.8",
            "verseOrgIds": [
              "1SA.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany Yese kuwer Syama. Kïlö Samwel, “Makïlnye ECHOTYON nyete tïkwïl.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.9",
            "verseOrgIds": [
              "1SA.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany Yese kuwer werkachi tawu Samwel ntökwit mut nko odeny. Kïlenchï Samwel Yese, “Makïlnye ECHOTYON chete.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.10",
            "verseOrgIds": [
              "1SA.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Samwel Yese lö, “Werköku chete löwïr?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.11",
            "verseOrgIds": [
              "1SA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö, “Mi nyo mïnïng kuyokwïyöy kechir.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.11",
            "verseOrgIds": [
              "1SA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Samwel Yese, “Yontena chi kïkurï, ompöwölo melö kitötocha amöros ato tomönye kungwïn nyinte.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.11",
            "verseOrgIds": [
              "1SA.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kekurï nyinte kungwïn tawungwa. Ki chi nyo pïrir nyinte akïkaram tokochunyi nko portanyi. Kïlenchï ECHOTYON Samwel, “Yila nka nyete nyinte.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.12",
            "verseOrgIds": [
              "1SA.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicheng Samwel lal nyo mi mwagh, akuyil Daudi ompö kwenu werkökwa, kungwïnchï Mïkulöwu ECHOTYON Daudi asisoni kutang tagh. Kïmïla Samwel kutang Rama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.13",
            "verseOrgIds": [
              "1SA.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi ompö ka Saulö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.13",
            "verseOrgIds": [
              "1SA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngeta mïkulöwu ECHOTYON Saulö, kïlïtï mïkulögh nyo gha nyo kisus nyinte nyo kiyonï ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï mötworichi nyinte, “Kölïtinyi mïkulögh nyo gha nyo susinyi nyo köyonï Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.15",
            "verseOrgIds": [
              "1SA.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwowecha ye nyu kepecha keyörunö chi nyo nkït kïpïtöy pïkan, nyo ato lïtinyi mïkulögh nyo gha nyo yonu Tororöt, kïpït pïkan, atökïturön mïkulöwungu.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.16",
            "verseOrgIds": [
              "1SA.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.16",
            "verseOrgIds": [
              "1SA.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Saulö mötworichi, “Oyörwanïn chi nyo nkït kïpïtöy pïkan lasiny, amïtwanïn.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.17",
            "verseOrgIds": [
              "1SA.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.17",
            "verseOrgIds": [
              "1SA.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö chi akong ompö pïchay, “Tïngeto chi nyo pö Petleem nyo kïkuro Yese werïnyi nyo nkït kïpïtöy pïkan akï chi nyo le nyakan akïkörom ompö poryot, chi nyo ngölonöy nyo karam akimi ECHOTYON nko nyinte.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.18",
            "verseOrgIds": [
              "1SA.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.18",
            "verseOrgIds": [
              "1SA.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta Saulö pich wölo mi Yese, kïlenchï, “Yokwanïn werïngu Daudi nyona yokwïyi kechir.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.19",
            "verseOrgIds": [
              "1SA.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyoktö Yese Daudi wölo mi Saulö nko wara aran nko sïkïryö nyo kösönöy makatin nko tokal nyo mi dipay.* ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.20",
            "verseOrgIds": [
              "1SA.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Daudi wölo mi Saulö akïpöghisyechï. Kïcham Saulö nyinte tya akwigh kïlïkwï ipinto karichi pö poryot. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.21",
            "verseOrgIds": [
              "1SA.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyoktö kut Saulö wölo mi Yese akïlenchï, “Nya kwighwanïn Daudi ighisyö, ompöwölo kegh nyinte kïgh nyo kachaman.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.22",
            "verseOrgIds": [
              "1SA.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kingwïnchï Saulö mïkulögh nyo gha nyo kiyonï Tororöt, kïcheng Daudi pïkan akïpït, kïpïstö mïkulöwunay gha Saulö kïturön nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.23",
            "verseOrgIds": [
              "1SA.16.23"
            ]
          }
        }
