                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kikonï kegh nyinte tökïsörunenecha ghöyityö anka tïkwïl akutïlilecha, cho le pikachi kegh, cho tïng machat kwigh pöghisyewut cho karamach.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        }
      ]
