          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenyona mwochinö pich ngalechï, aipöghisyeghö owesyengu kïmïkul ikil pich aichil. Mepisyï chi anka tïkwïl kïsasïnyi.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.15",
            "verseOrgIds": [
              "TIT.2.15"
            ]
          }
        }
      ]
    },
    {
