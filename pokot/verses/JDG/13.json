          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyï kokonay werïnyi akïkurö kaynenyi Samson. Kïyetï monïngay, kusoyön ECHOTYON nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.24",
            "verseOrgIds": [
              "JDG.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpöghisyeghö Mïkulöwu ECHOTYON nyinte ompö koro Maanedan, nyo kimi kwenu Sora nko Estaol.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.25",
