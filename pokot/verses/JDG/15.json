            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.17",
            "verseOrgIds": [
              "JDG.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwam maral Samson nyoman, kïkur ECHOTYON akïlenchï, “Kekonaninyi rïntagh nyo wow le nyï wölo nyiwu ne akwanyï omeghan ompö maral, pkonöy ye nyu sompenichï kuwonyanïn!” ",
          "type": "text",
