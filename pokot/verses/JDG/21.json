            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.25",
            "verseOrgIds": [
              "JDG.21.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.17.6"
              },
              "items": [
                {
                  "text": "Kir 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimöminye pöytoghintö koro Israel osiswechoni. Kigh chi anka tïkwïl kïgh nyo kisïwa lö karam ompö nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.25",
            "verseOrgIds": [
              "JDG.21.25"
            ]
          }
