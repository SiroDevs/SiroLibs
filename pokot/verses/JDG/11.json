  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "JDG 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki chi pö lïk nyo le nyakan awes Yepta nyo kingwïna koro Kiliad, aki wero chepores. Kiyï Kiliad Yepta. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.1",
            "verseOrgIds": [
              "JDG.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyï koko Kiliad tïkwïl werkö walaka. Otini kïyetu werchay, kïyon chane Yepta akïlenchï, “Möminye kïgh nyo imïlenyi ompö katancha, ompöwölo ichinyi wero korka anka.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.2",
            "verseOrgIds": [
              "JDG.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kupertegha Yepta wölo mi werkökwa, akïwö kïmang koro Top. Kïtuyö ompö wöloni nko pich cho ghach, akïpa kïpörisyö tïkwïl.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.3",
            "verseOrgIds": [
              "JDG.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.3",
            "verseOrgIds": [
              "JDG.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mi asista anka, kïpa pipö Amon kïporyö nko pipö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.4",
            "verseOrgIds": [
              "JDG.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïpa poyi Kiliad kumïtuna Yepta koro Top ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.5",
            "verseOrgIds": [
              "JDG.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïlenchï nyinte, “Nyonö atentöghoghwecha, atö keporyeghenö pipö Amon.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.6",
            "verseOrgIds": [
              "JDG.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.6",
            "verseOrgIds": [
              "JDG.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kuyokyï Yepta chane lö, “Kyareyanïkwa nyoman ayonenanïn koto paponyan. Kwompö ne topkonekwa wölo omitan otinö konyorukwa kömpölelyö?” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.7",
            "verseOrgIds": [
              "JDG.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï poyichay pö Kiliad Yepta lö, “Kakïpkanacha wölo imitenyi ompöwölo kïmökecha nyi wete nko acha atö keporyenö nko pipö Amon, atelïkunanyi nyu kintöghoghinto pipö Kiliad löwïr.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.8",
            "verseOrgIds": [
              "JDG.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.8",
            "verseOrgIds": [
              "JDG.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Yepta chane lö, “Ekwoto töp ntamïlan nko akwa wölini le kaw atö keporyenö nko pipö Amon akïcham ECHOTYON kutö chane morichan, oghanïkwa nyoman olïku kintöghoghintenkwa?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.9",
            "verseOrgIds": [
              "JDG.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.9",
            "verseOrgIds": [
              "JDG.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï poyichay pö Kiliad nyinte lö, “Nya kïlïkwï söwinte ECHOTYON. Kighecha lenyini kemwaghanyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.10",
            "verseOrgIds": [
              "JDG.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö nyu Yepta nko poyichay pö Kiliad akwigh pich nyinte kïlïkwï kintöghoghintengwa. Kïngalan Yepta ngalechi lapay ompö tawu ECHOTYON ompö kanasyanta Mispa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.11",
            "verseOrgIds": [
              "JDG.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.11",
            "verseOrgIds": [
              "JDG.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïyonta Yepta pich kïpa kïtep pöytoghinto Amon lö, “Itïngetenyi ne nyo isyölonyi nko acha temökenyi nyone poryeghone korencha?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.12",
            "verseOrgIds": [
              "JDG.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.12",
            "verseOrgIds": [
              "JDG.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï pöytoghintonay pö pipö Amon pïchay kiyonï Yepta lö, “Kicheng pipö Israel korenyan atakinye kiwuwunö koro Misri, kïngata lalwa Arnon ntökwit lalwa Yapok, akïwö ntökwitïta lalwa Yordan. Nyo mïchinokwa ye okonunö koroswechoni ompö kalya.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.13",
            "verseOrgIds": [
              "JDG.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.13",
            "verseOrgIds": [
              "JDG.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta Yepta pikö walaka ngat wölo mi pöytoghintonay pö Amon, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.14",
            "verseOrgIds": [
              "JDG.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïlenchï, “Melö man lö kicheng pipö Israel koro pipö Moap anta koro pipö Amon. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.15",
            "verseOrgIds": [
              "JDG.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo atanye kipkana chane koro Misri, kuwerata kor nyo kile surkwen ntökwitïta Nanam nyo Pïrir akïpa ntökwitïta Kades. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.16",
            "verseOrgIds": [
              "JDG.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.14+NUM.20.15+NUM.20.16+NUM.20.17+NUM.20.18+NUM.20.19+NUM.20.20+NUM.20.21"
              },
              "items": [
                {
                  "text": "Kiy 20:14-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay kïyonta pipö Israel ngat pich kïpa wölo mi pöytoghinto Edom, kïlenchï, ‘Chömwecha kewera korengu,’ wölo melö kichömchï pöytoghintonay pö Edom chane. Kïyonta pikö walaka wölo mi pöytoghinto Moap, kïtagh nyoni tïkwïl. Kïtïpï nyu pipö Israel wölini le Kades. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.17",
            "verseOrgIds": [
              "JDG.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.4"
              },
              "items": [
                {
                  "text": "Kiy 21:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kuwer wölo le surkwen akuwit koro Edom nko nyo pö Moap ntökwitïta okumpö kongasispa koro Moap, lalwa Arnon antakwagh. Kïtek möngengwa atoni, wölo melö kyoghyö Arnon ompöwölo ki rotyot nyo pö koro Moap.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.18",
            "verseOrgIds": [
              "JDG.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.18",
            "verseOrgIds": [
              "JDG.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atolapay kïyonta pipö Israel pich wölo mi Sion pöytoghinto pipö Amori nyo kipöytoy ompö kanasyanta Espon, kïlenchï, ‘Chömwecha kewera korengu atö kepe korenyo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.19",
            "verseOrgIds": [
              "JDG.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kighan Sion pipö Israel kuwer korenyi. Kïlenyona kïghamïtï piko lïkenyi löwïr akïtek möngengwa kanasyanta Yaas akïporyeghö nko pipö Israel.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.20",
            "verseOrgIds": [
              "JDG.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.20",
            "verseOrgIds": [
              "JDG.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo kutö ECHOTYON Tororöt pö Israel Sion nko lïkenyi mori pipö Israel. Kïlenyona kïnam chane korononi kïmïkul pö pipö Amori cho kimöngöy wöloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.21",
            "verseOrgIds": [
              "JDG.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnam chane koro Amori kïmïkul, kïngata lalwa Arnon ntökwitïta lalwa Yapok akïngata surkwen ntökwitïta lalwa Yordan. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.22",
            "verseOrgIds": [
              "JDG.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ECHOTYON, Tororöt pö Israel nyo kitö koro pipö Amori pipö Israel. Ichengonyi nyu chane lö ne? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.23",
            "verseOrgIds": [
              "JDG.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chenga kor nyo koninyi tororötïngu Kemos, kïchengecha kor nyo konecha ECHOTYON Tororötïncha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.24",
            "verseOrgIds": [
              "JDG.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.1+NUM.22.2+NUM.22.3+NUM.22.4+NUM.22.5+NUM.22.6"
              },
              "items": [
                {
                  "text": "Kiy 22:1-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ilentenyi so ochï karam kïtïl Palak wero Sipor pöytoghinto Moap? Melö kisyal nyinte anta poryö nko acha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.25",
            "verseOrgIds": [
              "JDG.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimang pipö Israel Espon nko Aroer nko kanastinekwa cho mïnkech nko kanastin löwïr cho kimi sörömu lalwa Arnon ompö könyis 300. Ompö ne tömoyokukwa kanastinekwo atoni? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.26",
            "verseOrgIds": [
              "JDG.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo melö kawunyi nyo gha, poto nyi nyo keghwanïn nyo gha otini kengwïnanyi iporyö nko acha. ECHOTYON nyo le Kirwokinte, nyo mutöy asisete ngal cho mi kwenu pipö Israel nko cho pö Amon.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.27",
            "verseOrgIds": [
              "JDG.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.27",
            "verseOrgIds": [
              "JDG.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïtagh pöytoghintonay pö Amon ngalechoni kimwochï Yepta nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.28",
            "verseOrgIds": [
              "JDG.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.28",
            "verseOrgIds": [
              "JDG.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kungwïnchï Mïkulöwu ECHOTYON Yepta. Kïwö kuwerata koro Kiliad nko nyo pö Manase, akïmïla kutöngwï kanasyanta Mispa nyo mi Kiliad, atolapay kïwö kutang wölo mi pipö Amon. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.29",
            "verseOrgIds": [
              "JDG.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwolwolchï Yepta ECHOTYON lö, “Ato töp ntetönönyi pipö Amon morichan, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.30",
            "verseOrgIds": [
              "JDG.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "okoninyi chi anka tïkwïl nyo nyoghöy kïlïtuno kukenyan kungwïnöy kïtörokanïn otini kangwïnan rïntagh nyo pö pipö Amon. Okoninyi kïlïku amöros nyo kïpelöy.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.31",
            "verseOrgIds": [
              "JDG.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.31",
            "verseOrgIds": [
              "JDG.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kwoghyö Yepta lalwanay akïwö wölo mi pipö Amon atö kïporyö nko chane. Kutö ECHOTYON chane morichi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.32",
            "verseOrgIds": [
              "JDG.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpar pïchay lömïs ompö kanastin tömönut odeny, kïngata Aroer ntökwit Minit nko Apel Keramim, kïpar pich cho chang nyoman. Kïrïnta nyu pipö Israel pipö Amon.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.33",
            "verseOrgIds": [
              "JDG.11.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chepö Yepta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.33",
            "verseOrgIds": [
              "JDG.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kïmïla Yepta katanyi wölini le Mispa, kïlïtï sany cheptanyi nyo kitïng kwïrkwïris kungwïn kïtaroch nyinte kïnyolonu. Kimötïngnye montö anka kïpoto nyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.34",
            "verseOrgIds": [
              "JDG.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.30.2"
              },
              "items": [
                {
                  "text": "Kiy 30:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kisïwa kïkarer sïrokachi ompö nyarïl akïlö, “Heywey! Cheptanyu! Kekonaninyi nyarïl nko kisusöt nyo wow ompöwölo kowolwolchan ECHOTYON amomukanye ntayoda.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.35",
            "verseOrgIds": [
              "JDG.11.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.35",
            "verseOrgIds": [
              "JDG.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï cheptanyi lö, “Paponyu, ighwante kïrïp kegh nko ngölyon nyo kiwolwolchinyi ECHOTYON, ompöwölo kakutökunyi ECHOTYON pungköku, pipö Amon.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.36",
            "verseOrgIds": [
              "JDG.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïlenchï ngat kwanta, “Ighwante ngölyontononi, wölo pïswante otöpan onkït aro odeny, atowan wölnö le kutïngkot owestotö atarir nko kongotichu, ompöwölo omeghan atochan chepkïltït.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.37",
            "verseOrgIds": [
              "JDG.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï, “Winyi.” Kïchömchï kïwö aro odeny. Kïwö chepay nko kongotichi wölo le kutïngkot akïpa kïriryö, ompöwölo meghöy nyinte kïtomö kep amösïch monïng. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.38",
            "verseOrgIds": [
              "JDG.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kiwonyö oroyechay le odeny, kïmïla wölo mi kwanta, kwighchï nyinte cheptanyi kïrïp kegh nko kiwalwalatenyi, akitomönye kïrï cheponi nko chi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.39",
            "verseOrgIds": [
              "JDG.11.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïna atoni otöp ompö koro Israel ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.39",
            "verseOrgIds": [
              "JDG.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyo petöy tipö Israel köny anka tïkwïl ompö osis angwan kunonöy chepö Yepta nyo kipö Kiliad.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.40",
            "verseOrgIds": [
              "JDG.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yepta nko pipö Epraim",
          "type": "text"
        }
      ]
    }
