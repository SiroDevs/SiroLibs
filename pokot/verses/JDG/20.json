  "reference": "Kirwokï 20",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "JDG 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpka pipö Israel löwïr kïngeta Dan nyo mi okumpö löt ntökwit Persyepa nyo mi okumpö ewu tagh akïpkana Kiliad nyo mi okumpö kongasis tïkwïl akïtuyechï Mispa tawu ECHOTYON le kïgh akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.1",
            "verseOrgIds": [
              "JDG.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi kirwokotï löwïr cho pö ortïna pipö Israel tuyononi pö pipö Tororöt. Kingata chane pipö lïk 400,000 cho kiporyegho chokon. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.2",
            "verseOrgIds": [
              "JDG.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlïm nyu pipö Penchamen lö kituyechï pipö Israel Mispa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.3",
            "verseOrgIds": [
              "JDG.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep pipö Israel lö, “Kingwïn lö ne ghöyityonï?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.3",
            "verseOrgIds": [
              "JDG.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.3",
            "verseOrgIds": [
              "JDG.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï chichay pö Lawi kikïpara chemïnïngwenyi* lö, “Kyowan nko chemïnïngwenyu Kipea nyo mi koro Penchamen atö keruyenö wöloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.4",
            "verseOrgIds": [
              "JDG.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpka mïrön pö Kipea akuwit kö nyo kyorïwan akimököy kïtïghanïn. Kïpatal chane chemïnïngwenyan ntökïma. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.5",
            "verseOrgIds": [
              "JDG.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achengan nyu chemïnïngwenyu atanatan ayoktan kep kïghömï koros löwïr cho kicheng pipö Israel, ompöwölo kigh pipö Penchamen arasï nyo wow nko sölwontön ompö koro Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.6",
            "verseOrgIds": [
              "JDG.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona ye nyu, pipö Israel löwïr, amwagha arwok kïgh nyo mïchini kegh.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.7",
            "verseOrgIds": [
              "JDG.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.7",
            "verseOrgIds": [
              "JDG.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnget pïchay löwïr akïmwa ngölyon akonga lö, “Möminye chi nyo le ompö akonga nyo wetöy wölo mi emenyi, anta lö owetöy katanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.8",
            "verseOrgIds": [
              "JDG.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo anyï kïgh nyo kighchinecha pipö Kipea: kïpetecha wölini, wölo kïnyoghöy kepöröy kwegh tökesïwa lö ngo nyo poyot nko chane. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.9",
            "verseOrgIds": [
              "JDG.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konu chi akonga ompö taman ompö pipö Israel omisyö nyo pö pipö lïk, kïpa cho kïngötï kïpar pipö Kipea ompö ghöyityönï kigh chane ompö Israel.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.10",
            "verseOrgIds": [
              "JDG.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kutuyö kegh pipö Israel löwïr le kïgh akonga atö kïpar kanasyantanoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.11",
            "verseOrgIds": [
              "JDG.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.11",
            "verseOrgIds": [
              "JDG.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïyonta pich pipö Israel kïghömï koroswo Penchamen löwïr, kïlenchï, “Ne ghöyitye nyï kaghakwa? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.12",
            "verseOrgIds": [
              "JDG.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, onömunö pïchoni le mwokïyis mi Kipea atö keparacha, atö kïngeta ghöyityö koro Israel.” Wölo melö kiterchï pipö Penchamen pikökwa chinö pö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.13",
            "verseOrgIds": [
              "JDG.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïghamïtuna kegh pipö Penchamen kanastinekwa löwïr akïpa kïghömechï Kipea atö kïporyeghö pipö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.14",
            "verseOrgIds": [
              "JDG.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keyit pipö Penchamen asisoni cho kipkana kanastinekwa, kïlïkwï pich 26,000 cho kiporyegho chokon, amelö kikiyit pich cho kimöngöy Kipea cho kile pich 700 cho kikïlöwön ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.15",
            "verseOrgIds": [
              "JDG.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki pich cho kile kerï nyoman cho kiwirtegho koghïn pörköy akimötosönöcha nyonikïny. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.16",
            "verseOrgIds": [
              "JDG.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kikiyit pipö Israel kïlïkwï pich mïrön 400,000 cho kiporyegho chokon cho pö lïk kïsis pipö Penchamen.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.17",
            "verseOrgIds": [
              "JDG.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakïporyeghö pipö Penchamen",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.17",
            "verseOrgIds": [
              "JDG.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnget pïchay pö Israel kïpusta kutang Petel akïpa kïtep Tororöt lö, “Ngo ompö acha cho nyoghöy kïporyegho pipö Penchamen?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.18",
            "verseOrgIds": [
              "JDG.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï ECHOTYON lö, “Pipö ara Yuda cho nyoghöy.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.18",
            "verseOrgIds": [
              "JDG.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïnget pipö Israel nyini le kiwasan akïtek möngengwa ato lekïto Kipea, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.19",
            "verseOrgIds": [
              "JDG.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "atö kïporyeghö pipö Penchamen. Kwigh kegh atö kïporyeghö chane ompö Kipea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.20",
            "verseOrgIds": [
              "JDG.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngetunö pipö Penchamen kanasyantengwa akïpar pipö Israel 22,000 asisoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.21",
            "verseOrgIds": [
              "JDG.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpusta pipö Israel wölo kïsogho kïlokyï ECHOTYON kwimön. Kïtep ECHOTYON lö, “Kïpecha keporyeghö werköcho pipö Penchamen anta ewo?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.22+JDG.20.23",
            "verseOrgIds": [
              "JDG.20.22",
              "JDG.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï ECHOTYON lö, “Ape oporyenö nko chane.” Kïlenyona kukil kegh pïchay pö Israel, akwigh kegh ngat panta nyo pö odeny ompö atakinye kiporyeghö tagh. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.22+JDG.20.23",
            "verseOrgIds": [
              "JDG.20.22",
              "JDG.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpusta nyu pipö Israel atö kïpa kïporyö nko pipö Penchamen asisto odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.24",
            "verseOrgIds": [
              "JDG.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpkana pipö Penchamen kanasyanta Kipea asisto odeny, akïpar pipö Israel 18,000 cho kiporyegho chokon. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.25",
            "verseOrgIds": [
              "JDG.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa nyu pipö Israel löwïr kïpusta kutang Petel, kïtïpï atoni ngwïny akïriryö ompö tawu ECHOTYON asisoni kwimön amamcha kïgh. Kïropchï amörostin ECHOTYON cho kïpelöy nko ropöwo kalya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.26",
            "verseOrgIds": [
              "JDG.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi osiswechoni Santuku Muma* Tororöt Petel ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.27",
            "verseOrgIds": [
              "JDG.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "akighyongchini Pineas wero Eleasar, wero Aron. Kïtep nyu pipö Israel ECHOTYON lö, “Kïpecha ngat kepusta atö keporyenö nko pipö Penchamen anta ewo?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.28",
            "verseOrgIds": [
              "JDG.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON, “Ape oporyenö nko chane, ompöwölo otöninan morikwa asïyech.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.28",
            "verseOrgIds": [
              "JDG.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.28",
            "verseOrgIds": [
              "JDG.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö nyu pipö Israel pich cho le kisyepï kuwit Kipea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.29",
            "verseOrgIds": [
              "JDG.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa pipö Israel kïpusta walaye atö kïporyeghö pipö Penchamen asisto sömök, kwigh kegh atö kïporyeghö chane, le su. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.30",
            "verseOrgIds": [
              "JDG.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpka nyu pipö Penchamen lö tökepokyinö pïchay, kengwïs chane kïlowöchitunö kanasyan. Kïpörchï pïchoni pipö Israel wölo le sany cho ngata tömönut sömök le su ompö ortïn cho echön nyo kiwetöy anka kutöngöy Petel, kïwetöy anka kutöngöy Kipea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.31",
            "verseOrgIds": [
              "JDG.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö pipö Penchamen, “Kakïparacha chane ompö tawuncha le wölaye kakidocha su.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.32",
            "verseOrgIds": [
              "JDG.20.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlö mi pipö Israel, “Akanya keryagha atö kengwïsunena chane kanasyan ntökwitï wölï mito ortïna cho echön.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.32",
            "verseOrgIds": [
              "JDG.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngeta nyu atoni pipö Israel löwïr akwigh kegh ompö Paal Tamar, kïnget pïchay kimi kusyepisïyi ompö wölini kighïpchegho le okumpö löt nyo pö Kipea.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.33",
            "verseOrgIds": [
              "JDG.20.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:33",
              "type": "text"
            },
            {
              "text": "Kipea:",
              "type": "text"
            },
            {
              "text": "Ompö kikirut cho pö köny. Ompö ngala Eprania, Kepa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.33",
            "verseOrgIds": [
              "JDG.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpka pipö Israel cho le 10,000 cho kökikelöwönö koro Israel kïmïkul akïporyeghö pipö Kipea. Ki wow poryononi tya wölo kimenkïtïcha pipö Penchamen lö kirich kuwonyö chane. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.34",
            "verseOrgIds": [
              "JDG.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö ECHOTYON pipö Israel kïrïnta pipö Penchamen Kïpar pipö Israel asisoni pipö lïk cho pö Penchamen cho le 25,100. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.35",
            "verseOrgIds": [
              "JDG.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpköchï nyu pipö Penchamen lö kichö kikerïnta chane.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.36",
            "verseOrgIds": [
              "JDG.20.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Karïnta pipö Israel pipö Penchamen",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh kegh pipö Israel le pich cho kikerïnta, ompöwölo kitigho chane möt pipö lïk cho kisyepisyegho atolekïtö Kipea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.36",
            "verseOrgIds": [
              "JDG.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïryagh pïchay kisyepisïyi akïlïtöy Kipea akïpar kanasyantanay kïtuwit. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.37",
            "verseOrgIds": [
              "JDG.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kökichomnyechï pipö Israel cho kimi kusyepisïyi lö, nyini kasïwa ighöt nyo wow ompö kanasyan, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.38",
            "verseOrgIds": [
              "JDG.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïmïlonchö nyu pipö Israel akïporyö. Kökinya atoni pipö Penchamen kïpar pipö Israel cho le tömönut sömök akïlö, “Kakïparacha chane le poryonanya kipö tagh.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.39",
            "verseOrgIds": [
              "JDG.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kilïtunö ighot kanasyantanay, kïwöghökisyö pïchay pö Penchamen, kïlö kiros kinagh kanasyante kïtuwit. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.40",
            "verseOrgIds": [
              "JDG.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JDG 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmïlisyö nyu pipö Israel akïporyeghö chane, kïmïghyö pipö Penchamen, ompöwölo kisïwa lö kichïnchï chane nyarïl. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.41",
            "verseOrgIds": [
              "JDG.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JDG 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kupertoy pipö Penchamen kutang wölo le surkwen, wölo melö kitökïchïwïtyö ompöwölo otini kiryöghöy kuryam nko pipö Israel cho kipkono wölo le kanasyan, kïmi pïchinö kiyonu chane, kepar chane kuwonyö. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.42",
            "verseOrgIds": [
              "JDG.20.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JDG 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurich pipö Israel pïchay pö Penchamen akïyon chane, atolapay kïpar chane ompö Kipea okumpö kongasis. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.43",
            "verseOrgIds": [
              "JDG.20.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JDG 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepar pipö lïk cho pö Penchamen cho le 18,000 cho kile nyökon. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.44",
            "verseOrgIds": [
              "JDG.20.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JDG 20:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwöghokisyö walaka akupertoy kutang wölo le surkwen ntökwit ghat nyo pö Rimon. Kïpara pïchay pö Israel pich ara mït cho le 5,000. Kïrïpata chane ntökwit Kidom, kïpara walaka wöloni cho le 2,000. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.45",
            "verseOrgIds": [
              "JDG.20.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JDG 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlïkwï pïchoni pö Penchamen tïkwïl kikïpar asisoni 25,000 aki pipö lïk chane löwïr cho kile nyökon.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.46",
            "verseOrgIds": [
              "JDG.20.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JDG 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.46",
            "verseOrgIds": [
              "JDG.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JDG 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kimï kïchïwïtyö pich cho le 600 cho kitoyechï wölo le surkwen ntökwit ghatya Rimon, akïmang wöloni aro angwan. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.47",
            "verseOrgIds": [
              "JDG.20.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JDG 20:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïmïlonchö pipö Israel wölo mi pipö Penchamen. Kïpar pich nko kyak nko kïgh anka tïkwïl nyo kinyorï akïpel kanastin löwïr ompö korononi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.48",
            "verseOrgIds": [
              "JDG.20.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Koru pipö Penchamen",
          "type": "text"
        }
      ]
    }
  ],
