          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcheng Musa nko Aron pïchay, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.17",
            "verseOrgIds": [
              "NUM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïkur pipö Israel löwïr ompö asispa tagh nyo pö arawa odeny, kukir pich kïrïp kegh nko ortïnekwa nko ompö korikwa, akeyit pich cho kitïng könyis tömönut odeny kutok, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.18",
            "verseOrgIds": [
              "NUM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïle ato kimwochï ECHOTYON Musa: kuyit nyu Musa pich ompö surkwen pö Sinay. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.19",
            "verseOrgIds": [
              "NUM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikikir pich kïrïp kegh nko ortïnekwa nko korikwa cho kimuköy kïpa poryot, cho kitïng könyis tömönut odeny kutok. Kikitorö ara Rupen poretya Yakopo, kilata nyï kiyitötengwa:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20+NUM.1.21+NUM.1.22+NUM.1.23+NUM.1.24+NUM.1.25+NUM.1.26+NUM.1.27+NUM.1.28+NUM.1.29+NUM.1.30+NUM.1.31+NUM.1.32+NUM.1.33+NUM.1.34+NUM.1.35+NUM.1.36+NUM.1.37+NUM.1.38+NUM.1.39+NUM.1.40+NUM.1.41+NUM.1.42+NUM.1.43+NUM.1.44+NUM.1.45+NUM.1.46",
