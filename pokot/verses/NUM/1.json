            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngölonchï ECHOTYON Musa ompö surkwen pö Sinay ompö Ema nyo mi ECHOTYON* ompö asispa tagh nyo pö arawa odeny könyito odeny kïngeta kïpkana chane Misri, kïlenchï, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.1",
            "verseOrgIds": [
              "NUM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yitö pipö Israel löwïr, ompö korikwa nko ortïnekwa, iyitenyi mïrön löwïr, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.2",
            "verseOrgIds": [
              "NUM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïngeta könyis tömönut odeny kutok, cho kikumï kïpa poryot, iyitenyi nko Aron. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.3",
            "verseOrgIds": [
              "NUM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichengenyi kirwokin akonga ompö or anka tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.4",
            "verseOrgIds": [
              "NUM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achï kaynötut pö ortïn nko kintöghoghikwa cho kikïkïl kwigh pöghisyonï:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.5+NUM.1.6+NUM.1.7+NUM.1.8+NUM.1.9+NUM.1.10+NUM.1.11+NUM.1.12+NUM.1.13+NUM.1.14+NUM.1.15+NUM.1.16",
            "verseOrgIds": [
              "NUM.1.5",
              "NUM.1.6",
              "NUM.1.7",
              "NUM.1.8",
              "NUM.1.9",
              "NUM.1.10",
              "NUM.1.11",
              "NUM.1.12",
              "NUM.1.13",
              "NUM.1.14",
              "NUM.1.15",
              "NUM.1.16"
            ]
          }
        }
      ]
    },
