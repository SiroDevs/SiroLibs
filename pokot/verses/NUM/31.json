          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcheng Musa nko tïsin Eleasar koltinechay nko karïn lapay cho kikitang. ",
          "type": "text",
          "attrs": {
