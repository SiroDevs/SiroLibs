              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakipucha ye nyu ropöwo ECHOTYON, kïgh anka tïkwïl nyo könyorï chi, kari koltin nko kari morïn nko kari kelyön nko kaymoris nko kari yitïn nko sanay atökeghacha linyogh ompö tawu ECHOTYON.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.50",
            "verseOrgIds": [
              "NUM.31.50"
            ]
          }
