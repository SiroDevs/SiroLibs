          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.1",
            "verseOrgIds": [
              "NUM.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwochinö pipö Israel kïkoninyi lïkip taman nko odeny, akonga ompö kintöghoghinto or anka tïkwïl. Aikirchï kaynata chi tïkwïl lïkïnyi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.2",
            "verseOrgIds": [
              "NUM.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "aikirchï kaynata Aron nyo pö Lawi. Lïkïp akonga ompö kintöghoghinto or anka tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.3",
            "verseOrgIds": [
              "NUM.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay ip lïkipchoni Ema nyo mi ECHOTYON* aitö tawu Santuku Muma* wölay onyoryeghonan nko akwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.4",
            "verseOrgIds": [
              "NUM.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sïlöy nyu lïkïp nyo pö chi nyo okïlan, atö aghan pïchï pö Israel kïsisyö atömökïngwïngwïronchokwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.5",
            "verseOrgIds": [
              "NUM.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngölonchï nyu Musa pipö Israel löwïr, kutö kintöghoghikwa Musa lïkip taman nko odeny, akonga ompö or akonga akimi lïpö Aron nko lïkipchoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.6",
            "verseOrgIds": [
              "NUM.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö Musa lïkipchay, tawu ECHOTYON ompö Ema nyo mi ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.7",
            "verseOrgIds": [
              "NUM.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
