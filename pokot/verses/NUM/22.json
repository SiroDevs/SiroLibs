  "bookId": "NUM",
  "reference": "Kiyitut 22",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "NUM 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwï pipö Israel akïpa kïmang tömko Moap Yordan antakwagh atolekïtö Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.1",
            "verseOrgIds": [
              "NUM.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kilïm Palak pöytoghinto Moap wero Sipor wölo kida pipö Israel pipö Amori, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.2",
            "verseOrgIds": [
              "NUM.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïnam tapan Moap nyoman, akuwa pipö Israel ompöwölo kimöngörïcha pipö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.3",
            "verseOrgIds": [
              "NUM.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï pipö Moap kintöghoghi Midyan, “Wongöy pïchï tïkwïn cho mi koronï le ato omöy egh sus cho mi paren.” Ompöwölo ki pöytoghinto Moap Palak wero Sipor osiswechoni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.4",
            "verseOrgIds": [
              "NUM.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïyonta nyu pich kïpa wölo mi Palaam wero Peor nyo kimi Petor atolekïtö lalwa Yuparet ompö koro Amaw akïlenchï, “Achï pich cho kapkana koro Misri, akinyïghï chane wop tïkwïl akïmököy kïchengöy kore. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.5",
            "verseOrgIds": [
              "NUM.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chang chane kïtïlecha, kïlenyona nyonö lawel atechïpkante pïchï, ompöwölo owesöch chane kïtïlecha atökemukacha ana kerïntena chane akeyona kore, ompöwölo onkïtön lö nyo kechïpönyi kïchïpoy, akï nyo kesoyönönyi kusoyöno.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.6",
            "verseOrgIds": [
              "NUM.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.6",
            "verseOrgIds": [
              "NUM.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïpa poyi Moap nko cho pö Midyan wölo mi Palaam akwipöy ropöw, akïmwochï nyinte ngölyonto Palak. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.7",
            "verseOrgIds": [
              "NUM.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Palaam pïchay, “Oruyenö aghonete wölete atomwowokwa asïyech ngölyon nyo kamwa ECHOTYON.” Kïruyö nyu kintöghoghichay pö Moap wölini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.8",
            "verseOrgIds": [
              "NUM.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïn Tororöt wölo mi Palaam akïtep lö, “Ngo pïchï mi nko nyi?” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.9",
            "verseOrgIds": [
              "NUM.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Palaam Tororöt, “Keyokwï chane Palak pöytoghinto Moap wero Sipor wölo omitan lentöy, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.10",
            "verseOrgIds": [
              "NUM.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Kanyïghï kore kïmïkul pich cho kapkana Misri, nyonö nyu chïpkanïn pïchï, töptoy ana omukan oporyeghö chane ayona kore.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.11",
            "verseOrgIds": [
              "NUM.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Tororöt Palaam, “Metöp ntewö nko chane, amechïp pipö Israel, ompöwölo soyönote chane.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.12",
            "verseOrgIds": [
              "NUM.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnget Palaam tökwoghö akïlenchï pïchay pö Palak, “Omïlisyenö korengwo ompöwölo katagh ECHOTYON owan nko akwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.13",
            "verseOrgIds": [
              "NUM.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmïlisyö pïchay pö Moap akïlenchï Palak, “Katagh Palaam kungwïn nko acha.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.14",
            "verseOrgIds": [
              "NUM.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.14",
            "verseOrgIds": [
              "NUM.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta nyu Palak ngat kintöghoghi walaka cho chang kïtïl chay pö tagh akïkonyïtote kitïl chay potagh. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.15",
            "verseOrgIds": [
              "NUM.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa wölo mi Palaam akïlenchï, “Kölö Palak wero Sipor, mekany kïratïn kïgh nyonikïny, mengwïn wölo omitan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.16",
            "verseOrgIds": [
              "NUM.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okoninyi konyït nyo wow, owunyi kïgh anka tïkwïl nyo kemökenyi, nyonö chïpkante pïchete.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.17",
            "verseOrgIds": [
              "NUM.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïwöghökyï Palaam mötwori Palak lö, “Kïrökegh kïkonanïn Palak konyi nyo kinyïghï silpa nko koltin, kïmotïlanye ngölyonto ECHOTYON Tororötïnyan, nyo melö otösan anta achïchuk kïgh nyo mïnïng anta nyo wow. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.18",
            "verseOrgIds": [
              "NUM.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo osomokwa lö oruyenö aghonete wölete, atö atepan ECHOTYON töptoy ana mi kïgh nyo sis nyo mwowanïn.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.19",
            "verseOrgIds": [
              "NUM.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïn chï Tororöt Palaam aghononi akïlenchï, “Ato kapka pïchï kïkurinyi, iwö nko chane, wölo igh le ato komwowunyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.20",
            "verseOrgIds": [
              "NUM.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnap kegh Palaam ato le asïyech, kïrat sïkïryenyi akïwö nko kintöghoghichay pö Moap.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.21",
            "verseOrgIds": [
              "NUM.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Palaam nko sïkïryenyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.21",
            "verseOrgIds": [
              "NUM.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïnyala ECHOTYON ompöwölo kiwö Palaam, kughyongö malaykayanta ECHOTYON or kïkarta nyinte kïwegho otini Palaam sïkïryenyi akimi nko mötworichi odeny, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.22",
            "verseOrgIds": [
              "NUM.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kisïwa sïkïryonay malaykayanta ECHOTYON kughyongo or akïnömöy chok, kïmasta kïlït wuw. Kïmuny Palaam sïkïryonay akuyokï kutïngï or. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.23",
            "verseOrgIds": [
              "NUM.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kughyongö malaykayantanay pö ECHOTYON or ato marich ompö para sapipun akimi nïyetwö woptine kwodeny. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.24",
            "verseOrgIds": [
              "NUM.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kisïwa sïkïryonay malaykayantanay pö ECHOTYON kïyumchï kegh nayat, kïngongogh kel pö Palaam nayatunay, kïmuny Palaam sïkïryonay ngat. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.25",
            "verseOrgIds": [
              "NUM.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö malaykayantanay pö ECHOTYON tagh ngat, akughyongö or ato marich ato kimemukonye kewöghökisyeghö ketang ewu tagh anta ewu löt. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.26",
            "verseOrgIds": [
              "NUM.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kisïwa sïkïryonay malaykayantanay pö ECHOTYON, kïrï ngwïny, kïnyala Palaam akïmuny sïkïryonay. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.27",
            "verseOrgIds": [
              "NUM.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngany ECHOTYON kuti sïkïryonay, kïngalan kïlenchï Palaam, “Kaghunyi ne temunganinyi le nyï kïnyïl sömök?” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.28",
            "verseOrgIds": [
              "NUM.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Palaam sïkïryonay, “Ompöwölo kepirönenaninyi, ntökotïngetan chok kötökaparinyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.29",
            "verseOrgIds": [
              "NUM.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï sïkïryonay Palaam, “Mochanye so sïkïryengu nyo keweghonyi chik? Mi ato kyawunyi le nyete asistanka?” Kïlö Palaam, “Ewo.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.30",
            "verseOrgIds": [
              "NUM.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.30",
            "verseOrgIds": [
              "NUM.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngany ECHOTYON konyi Palaam kïsïwa malaykayanta ECHOTYON kughyongo or akïnömöy chok, kungïrukö Palaam akïkïtïng. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.31",
            "verseOrgIds": [
              "NUM.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï malaykayantanay pö ECHOTYON Palaam, “Ompö ne temungönyi sïkïryengu le nyï kïnyïl sömök? Ani nyo kangwïn akarta orengu, ompöwölo ghach ortïneku ompö tawunyan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.32",
            "verseOrgIds": [
              "NUM.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasïwanïn sïkïryengu, akïmörkölo kutang kamas kïnyïl sömök. Ntömö kigh lenyoni, kötökyaparinyi apïstan sïkïryonï.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.33",
            "verseOrgIds": [
              "NUM.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Palaam malaykayantanay, “Kaghan ngokï ompöwölo melö konkïtön lö, keghyongenyi or ikartanïn. Ye nyu ato gha ompö nyi owan, omïlenan kaw.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.34",
            "verseOrgIds": [
              "NUM.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï malaykayantanay Palaam, “Wïyönyi nko pïchï, wölo ingalan ngölyon nyo omwowunyi.” Kïwö nyu Palaam nko pïchay.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.35",
            "verseOrgIds": [
              "NUM.22.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Katak Palak Palaam",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.35",
            "verseOrgIds": [
              "NUM.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kilïm Palak lö mi Palaam kungwïnöy, kïwö kïtarok nyinte kanasyanta Moap nyo mi sörömu rotyo Arnon. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.36",
            "verseOrgIds": [
              "NUM.22.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Palak Palaam, “Kilïkwï ne tömengwïnanyi atanya kyokurinyi panto tagh? Kinonenyi so lö melö omukan okonyïtinyi lasiny?” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.37",
            "verseOrgIds": [
              "NUM.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Palaam Palak, “Kangwïnan ye nyu, wölo imitenyi melö otïngetan owesyö, ongölonan pat kïgh nyo kömwowanïn ECHOTYON lö, mwagha.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.38",
            "verseOrgIds": [
              "NUM.22.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Palaam nko Palak kutang Kiryat Usot. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.39",
            "verseOrgIds": [
              "NUM.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyeng Palak amöros pö egh nko kech akutö Palaam nko kintöghoghï cho kimi nyinte tïkwïl.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.40",
            "verseOrgIds": [
              "NUM.22.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngorsyo Palaam nyo pö tagh",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.40",
            "verseOrgIds": [
              "NUM.22.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumït Palak Palaam asis nyo kïrïpöy ntökwit Pamot Paal ato kimuköy kisïwïyi pipö Israel.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.41",
            "verseOrgIds": [
              "NUM.22.41"
            ]
          }
        }
      ]
    }
