              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcheng ropïyenichay le 1,365 ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.50",
            "verseOrgIds": [
              "NUM.3.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
