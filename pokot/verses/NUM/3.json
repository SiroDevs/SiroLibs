          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki pö pipö Mali nko pipö Musyi ara Merari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.33",
            "verseOrgIds": [
              "NUM.3.33"
            ]
          }
        },
        {
          "name": "verse",
