          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wor löwïr cho kikiyit cho kitïng arawa akonga kutok kï 6,200. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.34",
            "verseOrgIds": [
              "NUM.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roko kimang chane okumpö löt nyo pö Ema aki Suriel wero Apiail nyo kile kintöghoghintengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.35",
            "verseOrgIds": [
              "NUM.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighisyö nyo kikitö chane kï pölöwo Ema nko pïrompurkö nko pchörine nko pïrïmpoti nko karichi lapay. Nko pöghisyewut löwïr kirip nko choni ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.36",
            "verseOrgIds": [
              "NUM.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki chane tïkwïl cho kighöy pchörine nko pïrïmpoti nko nömöwe nko pörköyi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.37",
            "verseOrgIds": [
              "NUM.3.37"
            ]
          }
        }
      ]
    },
