          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roko Kïmang pipö ara Koat okumpö tagh nyo pö Ema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.29",
            "verseOrgIds": [
              "NUM.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aki Elisapan wero Usiel nyo kile kintöghoghintengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.30",
            "verseOrgIds": [
              "NUM.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiripöy chane Santuku Muma nko mese nko ketïto kitömöwon nko ato kïpelo amöros nko karïn cho pöghisyegho tïsï ompö Wölo Tïlil Tya* nko ananka nko pöghisyewut löwïr kïrïp kegh nko tïkuchï. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.31",
            "verseOrgIds": [
              "NUM.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleasar wero Aron nyo kile kintöghoghinto pipö Lawi. Akï nyinte nyo kiwowö pich cho kipöghisïyi ompö wölay Tïlil Tya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        }
      ]
    },
    {
