          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipö ara Kersyon pipö Lipni nko Syimey. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.21",
            "verseOrgIds": [
              "NUM.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wor cho kikiyit löwïr cho kitïng arawa akonga kutok kï ki 7,500. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.22",
            "verseOrgIds": [
              "NUM.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roko Kimang pipö Kersyon lötu Ema okumpö ta, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.23",
            "verseOrgIds": [
              "NUM.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "aki Elyasap wero Lael nyo kile yetïntöngwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.24",
            "verseOrgIds": [
              "NUM.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighisyo werpö Kersyon ompö Ema kï kïrip Santuku Muma* nko köröwonte nko ananka nyo körtoy kuka Ema nyo mi ECHOTYON, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.25",
            "verseOrgIds": [
              "NUM.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko anankis cho kikïtöt kiwit Ema nko ato kïpelo amöros nko ananka nyo yïso kukat nko pörköyichi nko pöghisyewut löwïr cho kiripöy kegh nko tïkuchoni. Chane cho kighyongchini pöghisyö anka tïkwïl nyo rïpöy kegh nko tïkuchoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.26",
            "verseOrgIds": [
              "NUM.3.26"
            ]
          }
        }
      ]
    },
    {
