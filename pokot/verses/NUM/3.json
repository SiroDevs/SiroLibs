          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.11",
            "verseOrgIds": [
              "NUM.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Wuw 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rosa, kochengunan pipö Lawi kwenu pipö Israel kuker poretayi pipö Israel löwïr. Lïku pipö Lawi chichan, ompöwölo chichan poretay löwïr, kyongotyan kegh poretayi pipö Israel löwïr, cho pö pich nko cho pö kyak lïku nyu chichan otini kyaparan poretay löwïr ompö koro Misri. Ochan ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.12+NUM.3.13",
            "verseOrgIds": [
              "NUM.3.12",
              "NUM.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiyitöto pipö Lawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.12+NUM.3.13",
            "verseOrgIds": [
              "NUM.3.12",
              "NUM.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa ompö surkwen pö Sinay, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.14",
            "verseOrgIds": [
              "NUM.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yitö pipö Lawi ompö koriko papotïnekwa nko ompö ortïnekwa, kïngeta worö nyo tïng köny akonga kutok.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.15",
            "verseOrgIds": [
              "NUM.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyit nyu Musa le ato kimwochï ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.16",
            "verseOrgIds": [
              "NUM.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chï kï werpö Lawi: Kersyon nko Koat nko Merari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.17",
            "verseOrgIds": [
              "NUM.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chï kï monïngo Kersyon: Lipni nko Syimey. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.18",
            "verseOrgIds": [
              "NUM.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kï monïngo Koat chï: Amram nko Isar nko Epron nko Usiel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.19",
            "verseOrgIds": [
              "NUM.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monïngo Merari chï: Mali nko Musyi. Chï kï monïngo Lawi kïpeghategha koriko papotïnekwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.20",
            "verseOrgIds": [
              "NUM.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
