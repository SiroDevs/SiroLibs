            "number": "45",
            "style": "v",
            "sid": "NUM 3:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Chenga pipö Lawi le ato kötechengenyi poretayi pipö Israel aicheng tukakwa tïkwïl le ato kötechengenyi cho pö pipö Israel, atökïlïkwï pipö Lawi chichan. Ochan ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.45",
            "verseOrgIds": [
              "NUM.3.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
