          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh Musa lenyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.49",
            "verseOrgIds": [
              "NUM.3.49"
            ]
          }
