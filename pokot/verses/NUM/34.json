          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pïchete cho kimwochï ECHOTYON kïchöghchï pipö Israel kor nyo mïloy chane ompö koro Kanan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.29",
