        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.12",
            "verseOrgIds": [
              "NUM.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Musa pipö Israel, “Koronete nyo omïlekwa ompö kura, kor nyo kamwa ECHOTYON lö, otöni ortïn mut nko angwan nko kwenu or akonga, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ompöwölo kikïnyorï mïlatengwa pipö Rupen nko werpö Kad nko kwenu pipö Manase kïrïp nko korikwa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.14",
            "verseOrgIds": [
              "NUM.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ompö kongasispa lalwa Yordan atolekïtö Yeriko.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kintöghoghï cho kikitö kïchagh kor",
          "type": "text"
        }
      ]
    },
    {
