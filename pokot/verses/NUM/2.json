            }
          ]
        },
        {
          "text": "Kiyitöto pipö Israel löwïr cho kikiyit kïrïp kegh nko korikwa nko ortïnekwa kï 603,550. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.32",
