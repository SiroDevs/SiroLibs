          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kikiyit pipö Lawi nko pikö walaka le ato kimwochï ECHOTYON Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.33",
            "verseOrgIds": [
