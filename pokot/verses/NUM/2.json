              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Chöghöy kegh pipö Israel ompö möngot, chi nko katanyi ompö ortïneko papotïnekwa. Möngöy chane kuwit Ema nyo mi ECHOTYON.* ",
          "type": "text",
