              "items": [
                {
                  "text": "Kiy 21:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlïm chi pö Kanan nyo kile pöytoghinto Arad nyo kimi okumpö Nekep* ompö Kanan lö, mi pipö Israel kïpkonöy. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.40",
            "verseOrgIds": [
              "NUM.33.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 33:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngeta kutïng pö Or ntökwit tömköyi Moap, kimangata chane koroswechï: Solmona nko Punon nko Opot nko Aparim nyo mi koro Moap nko Dipon Kad nko Almon Diplataim nko kutïng pö Aparim nyo lekïto kutïng pö Nepo nko tömköyi Moap kamasu lalwa Yordan ompö Yeriko, kwenu Pet Yesyimot nko Apel Syitim.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.41+NUM.33.42+NUM.33.43+NUM.33.44+NUM.33.45+NUM.33.46+NUM.33.47+NUM.33.48+NUM.33.49",
            "verseOrgIds": [
              "NUM.33.41",
              "NUM.33.42",
              "NUM.33.43",
              "NUM.33.44",
              "NUM.33.45",
              "NUM.33.46",
              "NUM.33.47",
              "NUM.33.48",
              "NUM.33.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kirurut kïtomö kyoghyö Yordan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
