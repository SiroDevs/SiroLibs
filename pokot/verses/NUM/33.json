              "items": [
                {
                  "text": "32:50",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpusta Aron kutïng pö Or le ato kimwochï ECHOTYON, akïröpösyï wölini, ompö könyi tömönut angwan asispa tagh nyo pö arawa mut kïngeta kïpkana pipö Israel koro Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.38",
            "verseOrgIds": [
              "NUM.33.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 33:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Aron könyis 123 otini kimeghchini kutïng pö Or.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.39",
            "verseOrgIds": [
              "NUM.33.39"
            ]
          }
        }
      ]
    },
