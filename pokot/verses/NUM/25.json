        "sid": "NUM 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kimi pipö Israel kïmöngöy Syitim, kutor pich kwigh cheporesnan nko tipö pipö Moap. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.1",
            "verseOrgIds": [
              "NUM.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitach chane koruchoni ompö ichontino amörostin, ompöwölo kikïsogho tororötino pipö Moap, kyam pïchoni omisye akïkïtïngchï tororötïnekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.2",
            "verseOrgIds": [
              "NUM.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunomnyö kegh Israel nko Paal* nyo pö Peor akwigh ECHOTYON kïnarek. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.3",
            "verseOrgIds": [
              "NUM.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïlenchï ECHOTYON Musa, “Chenga kintöghoghi pïchï lapay aitïgh chane kïmeghö kulïwu asis ompö tawu ECHOTYON atökïweghö nörekyo ECHOTYON pipö Israel.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Musa kirwoki pipö Israel, “Tïghö chi anka tïkwïl piköku cho kikunomnyö kegh nko Paal nyo pö Peor.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.5",
            "verseOrgIds": [
              "NUM.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.5",
            "verseOrgIds": [
              "NUM.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwipï chi pö Israel akong konyi korka nyo pö Midyan kïsïwïyi Musa nko pipö Israel löwïr ato kimi chane kïlokyegho kuka Ema nyo mi ECHOTYON.* ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.6",
            "verseOrgIds": [
              "NUM.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kisïwa Pineas wero Eleasar wero Aron, nyany le tïsin kïnget nko ngotïnyi akïpïstö pïchay ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.7",
            "verseOrgIds": [
              "NUM.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïrïp chichay pö Israel ntökwit konyi ori akïpar chichay nko kokonay kechïchuk nyu sömewonay kimi kuwongöy pich, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.8",
            "verseOrgIds": [
              "NUM.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "wölo kikitïgh pich cho le 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.9",
            "verseOrgIds": [
              "NUM.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.9",
            "verseOrgIds": [
              "NUM.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.10",
            "verseOrgIds": [
              "NUM.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Melö tonörekyinan pipö Israel ompö kïgh nyo kegh Pineas wero Eleasar wero Aron tïsin. Katagh nyinte tororötin walaka kïpoto ani, nka nyoni manyaranye pipö Israel ompö nyölotyenyan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.11",
            "verseOrgIds": [
              "NUM.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona mwochinö nyinte lö, ‘Oman muma* nko nyinte nyo pö kalya, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.12",
            "verseOrgIds": [
              "NUM.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyinte nko monechi cho töpkonöy, lïku chane Tïsï kokay, ompöwölo kitagh pung pö Tororöt akwigh kelöstoghchï pipö Israel lelutkökwa.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.13",
            "verseOrgIds": [
              "NUM.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.13",
            "verseOrgIds": [
              "NUM.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chichay pö Israel kikïpar nko korka nyo pö Midyan kï Simri wero Salu, kintöghoghinto ara pipö Simion. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.14",
            "verseOrgIds": [
              "NUM.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikuro korkononi Kospi chepö Sur nyo kile kirwokinto Midyan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.15",
            "verseOrgIds": [
              "NUM.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.15",
            "verseOrgIds": [
              "NUM.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.16",
            "verseOrgIds": [
              "NUM.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pokyinö pipö Midyan aipar chane, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.17",
            "verseOrgIds": [
              "NUM.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ompöwölo kilïsakwa ompö Peor nko ompö Kospi nyay kikïpar osiswechay kiwang pich sömewö ompö Peor.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.18",
            "verseOrgIds": [
              "NUM.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiyitöto odeny",
          "type": "text"
        }
      ]
    }
