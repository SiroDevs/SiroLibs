        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiwang Musa kïtek Ema nyo mi ECHOTYON* akuyil akutïlil nko kari lapay nko ato kïpelo amöros nko karichi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.1",
            "verseOrgIds": [
              "NUM.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïpka nyu kintöghoghi ortïna, pipö Israel nko yetïntino kori pipö Israel cho kighyongchini kiyitöt, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.2",
            "verseOrgIds": [
              "NUM.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwipï ropöwekwa tawu ECHOTYON: Nkaritin mut nko akonga cho lumote nko eghin taman nko odeny, nkari akonga ompö kintöghoghï odeny egh akonga ompö kintöghoghin akonga. Kutötö nyu tïkuchoni ompö tawu Ema ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.3",
            "verseOrgIds": [
              "NUM.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.4",
            "verseOrgIds": [
              "NUM.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Chenga ropöwechï atökïpöyit ighisyö nyo kigho Ema, tönö pipö Lawi kïrïp kegh nko ighisyengwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.5",
            "verseOrgIds": [
              "NUM.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenyona kïcheng nyu Musa nkarinechay nko eghine akutö pipö Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.6",
            "verseOrgIds": [
              "NUM.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö pipö Kersyon nkaritin odeny nko eghin angwan kirip nko pöghisyengwa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.7",
            "verseOrgIds": [
              "NUM.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kutö pipö Merari nkaritin angwan nko eghin mut nko sömök kïrïp kegh nko pöghisyengwa. Itamar wero Aron nyo kighyongchini ighisyengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.8",
            "verseOrgIds": [
              "NUM.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo metönye kigh pipö Koat ompöwölo kiripöy chane tïkwïn cho tïlilöch cho kikïsïto löyos. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.9",
            "verseOrgIds": [
              "NUM.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipï tïkwïl kintöghoghï ropöwekwa ompö kitïlilöto ato kïpelo amöros ompö asis nyo kikiyilöy, kutötö nyu kintöghoghï ropöwekwa ompö tawu ato kïpelo amöros. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.10",
            "verseOrgIds": [
              "NUM.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, “Tötoy kintöghoghintö anka tïkwïl ropöwontenyi asis akonga akonga ompö kitïlilöto ato kïpelo amöros.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.11",
            "verseOrgIds": [
              "NUM.7.11"
            ]
          }
        }
      ]
    },
