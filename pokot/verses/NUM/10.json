              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akimi poltonay pö ECHOTYON parakungwa pöghet otini kiwuwöy kutöngöy möngot anka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
