    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.1",
            "verseOrgIds": [
              "NUM.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwochinö pipö Israel lö, ato mököy mïrönö antö korka kuwolwolöy kegh, kiwalwalat nyo mököy kïlïku nasirin kutö kegh ECHOTYON, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.2",
            "verseOrgIds": [
              "NUM.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.15"
              },
              "items": [
                {
                  "text": "Luk 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïmïchï kïpïstö dipay* anta kumïn. Mömïchininye kïgha kumïn walaka nko walaka cho pö sapipun anta gha pögho akwa sapipun. Momönye akwa sapipun cho kötökepïtöy anta cho kikeyam. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.3",
            "verseOrgIds": [
              "NUM.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö osis cho le nasirin nyinte, momönye kïgh nyo kengwïna sapipun, ompö nyo le kösïghyonte anta resyante.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Amörwoköy mötïnyi anta mut pute ompö osis löwïr cho ketö kegh nyinte ECHOTYON kïtïlilitu nyu nyinte, köngöy kïpitöy putechi kïkoghöchitu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mömïchininye kïrich nyinte mïntïrich kokoy, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.6",
            "verseOrgIds": [
              "NUM.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïrkegh kö pö kwanta anta kame anta werïngwa anta cheptöngwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.7",
            "verseOrgIds": [
              "NUM.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö osis cho le nasirin nyinte, kï tïlil nyinte ompö ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.8",
            "verseOrgIds": [
              "NUM.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.8",
            "verseOrgIds": [
              "NUM.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atomeghchï chi ato mi nyinte, akusïmnyon kïmïchini kïkönyisyö osis mut nko odeny atolapay kïrwak mötïnyi nko tamughyenyi atökïtïlilit ngat. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.9",
            "verseOrgIds": [
              "NUM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipu nyinte asispa mut nko sömök chepïrïmpen odeny anta kayuntun odeny wölo mi Tïsin ompö kuka Ema nyo mi ECHOTYON,* ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.10",
            "verseOrgIds": [
              "NUM.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "atolapay nyu kutötö Tïsin anka kïpöyit ropöwo ngokï kïpöyit anka amöros nyo kïpelöy atökutïlil nyinte ompöwölo kegh ngoki ompö mïntïrïch. Tïlilöy nyu nyinte mötïnyi asisoni ngat, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.11",
            "verseOrgIds": [
              "NUM.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "akutö kegh ECHOTYON le nasirin. Mökeyitönye osiswechi chay kipö tagh kitö kegh ECHOTYON, ompöwölo kikisïmnyon. Kïlenyona ipu nyinte wawa kech nyo le makal nyo tïng köny akonga atökïpöyit ghaktay.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.12",
            "verseOrgIds": [
              "NUM.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.12",
            "verseOrgIds": [
              "NUM.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.13",
            "verseOrgIds": [
              "NUM.6.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.23+ACT.21.24"
              },
              "items": [
                {
                  "text": "Ist 21:23-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Otini kewonyö osiswo nasirin cho kitö kegh ECHOTYON, kepöy nyinte kughyongö kuka Ema nyo mi ECHOTYON, ompöwölo lenyoni kirurut ompö Nasarin ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.13",
            "verseOrgIds": [
              "NUM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "atökutö ECHOTYON ropöwechï: wawa kech nyo le makal nyo tïng köny akonga nyo lïpop le amöros nyo kïpelöy nko wawa kech nyo sakate nyo tïng kïny akonga nyo lïpop nyo pö ropöwonto ngokï nko makal nyo lïpop le ropöwonto pöghisyö. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.14",
            "verseOrgIds": [
              "NUM.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akutötoy nyinte köröpo makatin cho puryö mumar nko makatin cho kakinyornyoryö nko mwaghpa arol nko makatin cho töwörör cho kakitö mwagh nko ropöwo pagh nko dipay. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.15",
            "verseOrgIds": [
              "NUM.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kutötö tïkuchï nyu Tïsin ompö tawu ECHOTYON akï ropta ropöwo ngokï nko cho kïpelöy. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.16",
            "verseOrgIds": [
              "NUM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tötoy makalu le ropöwonto pöghisyö ompö ECHOTYON nko köröpo makatin cho puryö mumar akutötö tïkwïl ropöwo pö pagh nko dipay. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.17",
            "verseOrgIds": [
              "NUM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwoköy nyu mötïnyi chi nyo le nasirin ompö kuka Ema nyo mi ECHOTYON akïcheng pute kutö ma nyo kïpelo ropöwonto pöghisyö. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chengöy nyu tïsin löyo makalunay kikegha nko makatyan akonga nko akonga nyo tawarar akutö mori nasirin. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.19",
            "verseOrgIds": [
              "NUM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïcheng tïsin akuwiswis ompö tawu ECHOTYON le ropöw cho kiwiswisöy. Kakitïlilchï choni Tïsin nko take nyo kakiwiswis nko kïpestö nyo kakïropta. Atolapay nyu muköy kïgha dipay nasirin.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nyï kï kirurut nyo pö nasirin nyo wolwolsïyi, wölo ato yomis nasirin ropöwon nyo tïlöy kiwalwalatenyi, kïmïchini kïkonï kïrïp kegh nko kiyomisötenyi, nyo kimwa.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kisoyönöto tïsintön",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.22",
            "verseOrgIds": [
              "NUM.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lenchinö Aron nko werkachi osoyönekwa pipö Israel lö, ompö ngalechï: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.23",
            "verseOrgIds": [
              "NUM.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kusoyönok ECHOTYON akïripok. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.24",
            "verseOrgIds": [
              "NUM.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kwighwak ECHOTYON nyo karam akusyonchok. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.25",
            "verseOrgIds": [
              "NUM.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kurosok ECHOTYON ompö chamat akïkonok kalya.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.26",
            "verseOrgIds": [
              "NUM.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
