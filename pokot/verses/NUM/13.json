            "sid": "NUM 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.1",
            "verseOrgIds": [
              "NUM.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïla pich cho le kintöghoghï ompö ortïnekwa, kïngetunö ortïna Israel kï taman nko odeny aiyonta kïghot koro Kanan nyo otönan pipö Israel.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.2",
            "verseOrgIds": [
              "NUM.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh Musa le ato kimwa ECHOTYON, kïyonta kintöghoghichï ompö surkwen pö Paran:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.3+NUM.13.4+NUM.13.5+NUM.13.6+NUM.13.7+NUM.13.8+NUM.13.9+NUM.13.10+NUM.13.11+NUM.13.12+NUM.13.13+NUM.13.14+NUM.13.15",
            "verseOrgIds": [
              "NUM.13.3",
              "NUM.13.4",
              "NUM.13.5",
              "NUM.13.6",
              "NUM.13.7",
              "NUM.13.8",
              "NUM.13.9",
              "NUM.13.10",
              "NUM.13.11",
              "NUM.13.12",
              "NUM.13.13",
              "NUM.13.14",
              "NUM.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.3+NUM.13.4+NUM.13.5+NUM.13.6+NUM.13.7+NUM.13.8+NUM.13.9+NUM.13.10+NUM.13.11+NUM.13.12+NUM.13.13+NUM.13.14+NUM.13.15",
            "verseOrgIds": [
              "NUM.13.3",
              "NUM.13.4",
              "NUM.13.5",
              "NUM.13.6",
              "NUM.13.7",
              "NUM.13.8",
              "NUM.13.9",
              "NUM.13.10",
              "NUM.13.11",
              "NUM.13.12",
              "NUM.13.13",
              "NUM.13.14",
              "NUM.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chï kï kaynötut pö pich cho kiyonta Musa kïpa kïghot kore. Kiwaghach Musa kayna Osyea wero Nun kïlïkwï Yoswö.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.16",
            "verseOrgIds": [
              "NUM.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.16",
            "verseOrgIds": [
              "NUM.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiyontoy Musa chane kïpa kïghot Kanan, kïlenchï chane, “Ape atanga Nekep,* apusta koro komos. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.17",
            "verseOrgIds": [
              "NUM.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atorosunö lö, nen kore, aros lö, ekï owesöch piko korononi kïtya anta chang kïtya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.18",
            "verseOrgIds": [
              "NUM.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arosï lö, karam koronini möngöy chane nya anta gha arosï lö, möngöy chane kanastin cho tekote nya antö ewo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.19",
            "verseOrgIds": [
              "NUM.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "atorosunö lö, karam nyïngwïtyante nya anta gha arosï lö, mi wuw anta ewo. Onyökönitu apï akweko koronini.” Ki osiswo sapipun cho pö tagh choni ato kirïröy.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.20",
            "verseOrgIds": [
              "NUM.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.20",
            "verseOrgIds": [
              "NUM.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa kïghot kore kutorö surkwen pö Sin ntökwit Reop atolekïtö ato kïlïto Amat. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.21",
            "verseOrgIds": [
              "NUM.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa nyo tagh kutang Nekep* ntökwit Epron wölo kimöngöy pipö Aiman nko Syesyay nko Talmay monïngo Anak. Kikïtek Epron könyis mut nko odeny kïtomö ketek Soan ompö Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.22",
            "verseOrgIds": [
              "NUM.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa ntökwit mpöghoghyo Eskol, kïtör ompö atoni morïna ket pö sapipu nyo kinam kurur, akïrötyï pich odeny ket akïsït. Kipï tïkwïl makumanka* nko makany. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.23",
            "verseOrgIds": [
              "NUM.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kekurö atoni mpöghoghyo Eskol akwompö morïnanoni pö ket pö sapipun cho kitörö pipö Israel atoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.24",
            "verseOrgIds": [
              "NUM.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.24",
            "verseOrgIds": [
              "NUM.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiwonyö osiswö tömönut angwan kimïlisyö chane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.25",
            "verseOrgIds": [
              "NUM.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpka wölo mi Musa nko Aron nko pipö Israel löwïr ompö surkwen pö Paran nyo mi Kades, kwipchï chane lökoy akuporchï chane akwechay kipunö koronini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.26",
            "verseOrgIds": [
              "NUM.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïlenchï chane Musa, “Kakïghotacha koronini, kesïwecha lö, yintegho chö nko kumat akwachï akwa koronini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.27",
            "verseOrgIds": [
              "NUM.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo owesöch pich cho möngöy koronini, akï echön kanastinekwa akïtekote nyoman. Akïmöchonicha pat, kökïsöchicha monïngo Anak koronini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.28",
            "verseOrgIds": [
              "NUM.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möngöy pipö Amalek Nekep kïmöngöy pipö Ititi nko Yepusi nko pipö Amori wölo le okumpö kamas, kïmöngöy pipö Kanan wölo riköy nanampa Kwen nko sörömu lalwa Yordan.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.29",
            "verseOrgIds": [
              "NUM.13.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.29",
            "verseOrgIds": [
              "NUM.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï Kalep pich cho kïtïlchini Musa kïsisyö akïlö, “Kepustena lawel akecheng kore, ompöwölo kïtïngeticha owesyö nyo kïrïntoy.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.30",
            "verseOrgIds": [
              "NUM.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö pich cho kipa nko Kalep, “Mökimukechanye keporyone nko pïchoni ompöwölo owesöch chane kïtïlecha.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.31",
            "verseOrgIds": [
              "NUM.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï chane putintön pipö Israel ompö paraku koronay kipa chane kïghot, lö, “Möminye omisyö nyo mïchini pïchoni mi koronini akikïsïwecha pich cho koghöch ompö koronini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.32",
            "verseOrgIds": [
              "NUM.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.4"
              },
              "items": [
                {
                  "text": "Tow 6:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akesöchicha korononi Nepilim, monïngo Anak cho pkono Nepilim, akikïlatecha peron ompö chane.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.33",
            "verseOrgIds": [
              "NUM.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Köngwïrngwïron pich",
          "type": "text"
        }
      ]
    }
  ],
