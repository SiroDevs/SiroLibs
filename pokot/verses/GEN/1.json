                {
                  "text": "1Kr 11:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay kïlö Tororöt, “Kegha chi ompö kïtontönyo, nyo karkegh nko achone tökïpayta kaghagh nko törit nko kyak nko tïpö wudïn löwïr cho mi wuw, cho echön nko cho mïnkech.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.26",
            "verseOrgIds": [
              "GEN.1.26"
            ]
          }
        },
        {
