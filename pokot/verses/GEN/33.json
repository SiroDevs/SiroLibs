  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "GEN 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Yakopo otopöntö, kïsïwa Esau mi kungwïnöy nko pich 400. Kupar Yakopo monechay kuporchï Lea nko Rael nko chemïnïngwenichi* odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.1",
            "verseOrgIds": [
              "GEN.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïkany kuntaghogh chemïnïngwenichay nko monekwa, atolapay kïrïpta Lea nko monechi, kïkany kïrïpï lötungwa Rael nko werïnyi Yosep. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.2",
            "verseOrgIds": [
              "GEN.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuntaghogha nyinte chane akungïrukotö nyinte ntökwit ngwïny kïnyïl mut nko odeny ntökïtenö kïrich werïngwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.3",
            "verseOrgIds": [
              "GEN.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kurïpï Esau kungwïn kïtaroch akuwita morichi katïnyi akukonköy. Kimi chane kwodeny kïlokyot. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.4",
            "verseOrgIds": [
              "GEN.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikany otini kitopöntö Esau, kïsïwa kor nko monïng, kïtep lö, “Ngo pikö chï imitenyi tïkwïl?” Kuyokyï Yakopo lö, “Monïng choni echotyon cho kikonanïn Tororöt ompö kisyonötenyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.5",
            "verseOrgIds": [
              "GEN.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnyini lawel, kïrikï chemïnïngwenichay nko monekwa akïpka kungïrukisyö ompö konyït. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.6",
            "verseOrgIds": [
              "GEN.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh lenyoni Lea tïkwïl nko monechi otini kirikï kungïrukisyö chane ompö konyït. Ato mi lötuto chane lapay, kwitï Rael nko werïnyi Yosep, kïpka akungïrukisyö ompö konyït.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.7",
            "verseOrgIds": [
              "GEN.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.7",
            "verseOrgIds": [
              "GEN.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïtep Esau lö, “Pö ne okwotinechï tïkwïl kotuyeghan ompö or?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.8",
            "verseOrgIds": [
              "GEN.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Yakopo lö, “Cho pö soghsyö tökïcham echotyontenyan kïgh nyo kaghan.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.8",
            "verseOrgIds": [
              "GEN.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.8",
            "verseOrgIds": [
              "GEN.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlö Esau, “Otïngetan cho mïchinanïn, werïnyo nya kïlïkwï cheku choni itïngetenyi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.9",
            "verseOrgIds": [
              "GEN.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.9",
            "verseOrgIds": [
              "GEN.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yakopo, “Ewo, osoghinyi lö, ato ketakaninyi kï karam takanyi ropöwechan chï okoninyi, ompöwölo omwowunyi nyo pö nyoman lö otini kasïwan tokochungu, kïlenye ato kasïwan tokochu Tororöt, ompöwölo kechamanyi kïgh nyo kaghan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.10",
            "verseOrgIds": [
              "GEN.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo osoghinyi lö taka ropöwechan chï okoninyi, ompöwölo keghwanïn tïkwïl Tororöt nyo karam, nka nyï ye otïngetan kyak cho chang.” Kïsaghsagh Yakopo ntökïcham nyinte kïrang.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.11",
            "verseOrgIds": [
              "GEN.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.11",
            "verseOrgIds": [
              "GEN.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlö Esau, “Kenama pan kepe, nya antaghoghan.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.12",
            "verseOrgIds": [
              "GEN.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïlenchï Yakopo Esau, “Inkïtönyi echotyontenyu lö tökïmïnkech monïnge akïtïng kyaki wara, kïtïng tuka mogh. Nyo ato kïrang tya chane ompö asis akonga, kumuköy kuwonyot kyaki tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.13",
            "verseOrgIds": [
              "GEN.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo osoghinyi echotyontenyu lö ntöghoghwante ani nyo ochï mötworintengu, atarïpkan mut kïle wöloni lata panto tïch nko cho pö monïnge ntökïtenö onyorchan echotyontenyu wölini le Seir.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.14",
            "verseOrgIds": [
              "GEN.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.14",
            "verseOrgIds": [
              "GEN.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïlö Esau, “Kwoto lenyona, kïne mopïsunyi piköchan walaka cho mi nko ani.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.15",
            "verseOrgIds": [
              "GEN.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kuyokyï Yakopo lö, “Ompö ne teghanyi lenyoni? Chömwante echotyontenyu lenyini kosominyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.15",
            "verseOrgIds": [
              "GEN.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmïlegha Esau asisoni pantanyi akïwö ntökwit Seir. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.16",
            "verseOrgIds": [
              "GEN.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïwö Yakopo kutang Sukot akïtekyï kegh kö ompö wöloni akuwach pighpa kyakichi, nka nyoni tökekurö atoni Sukot.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.17",
            "verseOrgIds": [
              "GEN.33.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "33:17",
              "type": "text"
            },
            {
              "text": "Sukot:",
              "type": "text"
            },
            {
              "text": "Ompö Eprania kelentöy, “Söpoten.”",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.17",
            "verseOrgIds": [
              "GEN.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kimïlegha Yakopo Mesopotamia, kungwïn ompö kalya kwitï kanasyanta Syekem nyo mi koro Kanan akïtek möngenyi kanasyan sany. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.18",
            "verseOrgIds": [
              "GEN.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.32"
              },
              "items": [
                {
                  "text": "Yos 24:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.5"
              },
              "items": [
                {
                  "text": "Yna 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyala korononi kitek möngenyi werpö Amor nyo kile papoto Syekem ompö ropïyeni silpa cho kile pokol akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.19",
            "verseOrgIds": [
              "GEN.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtek atoni ato kïpelo amöros akïkurö El, Tororöt pö Israel.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.20",
            "verseOrgIds": [
              "GEN.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakisïmnyon Dina",
          "type": "text"
        }
      ]
    }
