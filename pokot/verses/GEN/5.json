        },
        {
          "text": "Kigh mïrön nko korka akusoyön atolapay kïmïnchï chane lö, “Ptangengmöt.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
          }
