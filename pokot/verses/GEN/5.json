              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kitïng Adam könyis 130, kïsïch monïng nyo le weri nyo kikarkegh nko nyinte, kïkurö Set. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
              "GEN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngata otini kiyï Adam Set, kïtöpö ngat könyis 800 kisïch monïnge walaka cho le wor nko tipïn. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
