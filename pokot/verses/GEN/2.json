          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, kwighisyö yïmwöy nko ngwïny nko tïkwïn löwïr cho mi oringwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.1",
            "verseOrgIds": [
              "GEN.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.4"
              },
              "items": [
                {
                  "text": "Epr 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.11"
              },
              "items": [
                {
                  "text": "Wuw 20:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kitïta asispa mut nko odeny, kuwany Tororöt ighisyenyi nyo kighöy akumuny ompö ighisyewutkachi löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.2",
            "verseOrgIds": [
              "GEN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusoyön Tororöt asispa mut nko odeny akïngot kïlïkwï asis nyo tïlil ompöwölo asisoni nyini kimuny Tororöt ompö ighisyenyi nyo pö towunöt. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.3",
            "verseOrgIds": [
              "GEN.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lenye nyï wölo kikida yïmwöy nko ngwïny.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.4",
            "verseOrgIds": [
              "GEN.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Para Eden",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kigh ECHOTYON Tororöt yïmwöy nko ngwïny, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.4",
            "verseOrgIds": [
              "GEN.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kimöminye ket cho kimi ngwïny akimöminye kösïgh cho kipit, ompöwölo kitomönye kïropönchï ECHOTYON Tororöt ngwïny akimöminye chi nyo kingor ngwïny. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.5",
            "verseOrgIds": [
              "GEN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïngetunö kapuret ngwïny akupïs kor kïmïkul.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.6",
            "verseOrgIds": [
              "GEN.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
