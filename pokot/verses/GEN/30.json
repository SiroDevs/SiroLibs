          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.21",
            "verseOrgIds": [
              "GEN.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kunan Tororöt Rael, kïterchï nyinte saghatenyi akusyonchï kïsïch owesyö nyo sïköy monïng. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.22",
            "verseOrgIds": [
              "GEN.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïkisyö akïyï weri, kïlö, “Kachengenanïn Tororöt arasinyan.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.23",
            "verseOrgIds": [
              "GEN.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïkurö kaynenyi Yosep,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.24",
            "verseOrgIds": [
              "GEN.30.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "30:24",
              "type": "text"
            },
            {
              "text": "Yosep:",
              "type": "text"
            },
            {
              "text": "Ompö Eprania kelentöy, “Osoghan ECHOTYON kïkonï anka.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " akïlö, “Osoghan ECHOTYON kïtöswanïn weri anka.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.24",
            "verseOrgIds": [
              "GEN.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kitösisyö kyaki Yakopo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.24",
            "verseOrgIds": [
              "GEN.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikany kïyï Rael Yosep, kïlenchï Yakopo Lapan, “Pïswante owö atamïla atang katanyo wölini le korencha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.25",
            "verseOrgIds": [
              "GEN.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chömwante owö nko koruchu nko monechu, ompöwölo kyopöghisyewunyi ompö chane, pïswante owö inkïtönyi wölini kyopöghisyewunyi kïlïkwï.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.26",
            "verseOrgIds": [
              "GEN.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.26",
            "verseOrgIds": [
              "GEN.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlenchï Lapan, “Ato isïwenyi lö karam ompö nyi, itöpö. Onkïtön nyo le ani lö kikïchamanïn ECHOTYON akwompö nyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.27",
            "verseOrgIds": [
              "GEN.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwowante ghosyengu nyo otïngön tokonïn.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.28",
            "verseOrgIds": [
              "GEN.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yakopo, “Inkïtönyi nyinte wölanye kyopöghisyewunyi kïlïkwï nko wölanye kyoriptan kyakiku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.29",
            "verseOrgIds": [
              "GEN.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïngetenyi kyak cho ngörï atanye kitomönye atwan, wölo kïtösisyö kyakiku kïchangit kïngeta atakinye kyatwan akusoyöninyi ECHOTYON ompö wop anka tïkwïl nyo kyowan. Wölo lïku nyu oyï ato owetan opöghisyechini piko konyu?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.30",
            "verseOrgIds": [
              "GEN.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Lapan nyinte lö, “Okoninyi ne?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.31",
            "verseOrgIds": [
              "GEN.30.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Yakopo lö, “Mekonanïn kïgh nyonikïny kïpoto ighwante kïgh nyo omökan atayakuyunyi kyakiku kutang tagh. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.31",
            "verseOrgIds": [
              "GEN.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya owan orim kyakiku ye, tataran kech anka tïkwïl nyo köpentö nko nyo pusyentö, lïku choni nyu ropöwechan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.32",
            "verseOrgIds": [
              "GEN.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atökïpïntö ato le asïyech kighanatenyan lasiny otini kengwïnanyi iros ropöwechan cho mi tawungu. Akï aran anka tïkwïl nyo otïngetan nyo melö köpentö anta pusyentö anta kecha anka tïkwïl nyo melö tuw, iyit lö kakïchor.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.33",
            "verseOrgIds": [
              "GEN.30.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.33",
            "verseOrgIds": [
              "GEN.30.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 30:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Lapan, “Nya kïle! Pïsyinönyi nyu lenyoni kemwanyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.34",
            "verseOrgIds": [
              "GEN.30.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 30:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïwö asisoni Lapan kïtar kwöghe cho köronöch nko cho pusyenöch nko ngaror tïkwïl cho köpenöch nko cho pusyenöch nko anka tïkwïl nyo kitïng put cho relach nko wara kechir tïkwïl cho tuwöch, atolapay kutö werkachi kuyakwïy. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.35",
            "verseOrgIds": [
              "GEN.30.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 30:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Lapan kulowitö kegh wölo mi Yakopo wölo tenö rutogh pö osis sömök. Kïwechï Yakopo kuyakwïy kyaki Lapan cho le ngötunön.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.36",
            "verseOrgIds": [
              "GEN.30.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 30:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.36",
            "verseOrgIds": [
              "GEN.30.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 30:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïpït Yakopo lïkip cho nyörilöch cho pö ket pö mlupna nko mlosi nko mwaramoni akungirngir. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.37",
            "verseOrgIds": [
              "GEN.30.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 30:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kutö sititchay tawu otupöy löwïr cho kighegho kyakï pögh, kitö nyinte lenyoni ompöwölo kirïsyegho kyakï atoni kigheghöy pögh. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.38",
            "verseOrgIds": [
              "GEN.30.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 30:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, otini kipka ngaror kïrïsyeghö tawu sititchay, kïmi ato le asïyech kïyï nechay wara cho köronöch nko cho köpenöch nko cho pusyenöch.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.39",
            "verseOrgIds": [
              "GEN.30.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 30:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.39",
            "verseOrgIds": [
              "GEN.30.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 30:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, kupesyö Yakopo warechay pö kechir. Atolapay kïkany kïtopön nechay wölo mi cho köronöch nko cho tuwöch tïkwïl cho pö nepö Lapan akutö ocheywechi okuntöngwa opïn, melö kituyö nko cho pö Lapan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.40",
            "verseOrgIds": [
              "GEN.30.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 30:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.40",
            "verseOrgIds": [
              "GEN.30.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 30:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany otini kirïsyot ngaror cho nöryote, kutö Yakopo sititchay tawu nechay wölini kimi otupenichay kïghegho pögh, tökïrïsyeghö atoni kimi sititchay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.41",
            "verseOrgIds": [
              "GEN.30.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 30:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kimetönye otini kirïsyot ngaror cho nyösyote. Ato mi löt kïpöyit Lapan nekö cho kinyösyote, kïpöyit Yakopo cho kinöryote. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.42",
            "verseOrgIds": [
              "GEN.30.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 30:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlïkwï chichoni monkoryon nyoman ompö aranoni, kitïng ocheywo kyak cho chang nko mötwor cho le tipïn nko mötwor cho le mïrön nko tamasay nko sïkïröy.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.43",
            "verseOrgIds": [
              "GEN.30.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kepertegha Yakopo ka Lapan",
          "type": "text"
        }
      ]
    }
