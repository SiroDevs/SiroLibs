          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chete löwïr kï ortïn taman nko odeny cho pö Israel akï chete cho kimwochï kwanta chane otini kisoyönisïyi. Kisoyön chi kïrïp kegh nko kisoyönut cho kimwochini nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.28",
            "verseOrgIds": [
              "GEN.49.28"
            ]
          }
        }
      ]
    },
    {
