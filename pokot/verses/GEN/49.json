              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.23.3+GEN.23.4+GEN.23.5+GEN.23.6+GEN.23.7+GEN.23.8+GEN.23.9+GEN.23.10+GEN.23.11+GEN.23.12+GEN.23.13+GEN.23.14+GEN.23.15+GEN.23.16+GEN.23.17+GEN.23.18+GEN.23.19+GEN.23.20"
              },
              "items": [
                {
                  "text": "Tow 23:3-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ompö köpönononi mito para Makpela okumpö tagh ompö Mamre nyo mi koro Kanan nyo kyal Apraam nko nyay pö Epron, kyal lö tökïlïkwï wölo kïtïpchini pich. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
