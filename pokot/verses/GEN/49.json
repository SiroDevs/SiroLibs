              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirur Yakopo chane kïlenchï, “Lekït arapasan aroranïn nko papotïnechan ompö köpönonay mito para Epron nyo le chi pö Ititi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.29",
            "verseOrgIds": [
              "GEN.49.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
