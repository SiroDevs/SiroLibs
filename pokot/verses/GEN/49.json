              },
              "items": [
                {
                  "text": "Ist 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiwany Yakopo kurur monechi kuyoda kelyechi kughegh pöröy, kunuk akïma.",
          "type": "text",
