                "loc": "ACT.7.15"
              },
              "items": [
                {
                  "text": "Ist 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïtïpchï atoni Apraam nko kokönyontenyi Sara, aketïpchï atoni Isak nko kökönyontenyi Repeka atïpchan atoni Lea. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikyal pare nko köpöne nyo mi ori kyala pipö Ititi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        },
        {
