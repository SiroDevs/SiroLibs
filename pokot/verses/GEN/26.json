  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "GEN 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitï kömöyu anka korononi nyo kisis nko nyakinya kipö tagh, nyo kimi ompö osiswo Apraam. Kïwö Isak kutang Kerar wölo kimi Apimelek pöytoghinto pipö Pilisti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.1",
            "verseOrgIds": [
              "GEN.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïnchï ECHOTYON Isak akïlenchï, “Mewö ngat iröytö Misri, wölo töpenönyi korononi opörunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.2",
            "verseOrgIds": [
              "GEN.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilïkunenyi ton ompö korononi, totöpan nko nyi asoyöninyi. Ompöwölo okoninyi tönön piko yiyengu koroswechete löwïr, achïchiman mumenyu nyo kyomwochan papongu Apraam. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.3",
            "verseOrgIds": [
              "GEN.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otösan piko yiyengu kïkarkegh nko kokelya yïm tönön chane koroswechete löwïr akeperuröy pipö punton tïkwïl ompö piko yiyengu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.4",
            "verseOrgIds": [
              "GEN.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ompöwölo kitechanïn Apraam akïrïp kiyomisutköchan nko kirurutköchan.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.5",
            "verseOrgIds": [
              "GEN.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.5",
            "verseOrgIds": [
              "GEN.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïmang Isak wölnö le Kerar. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.6",
            "verseOrgIds": [
              "GEN.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kitep piko wöloni ngaleko korkenyi, kïsöwintönchï nyinte lö ki cheptöngwa, ompöwölo kiwagh lö ato amwagh lö, ki korkenyi kitöptoy kipöröy pich nyinte tökwip Repeka, ompöwölo ki pïchigh Repeka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.7",
            "verseOrgIds": [
              "GEN.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikany kïtöpö wölini osis cho chang, kïtopönteghö tïrisya Apimelek nyo kile pöytoghinto pipö Pilisti, kïsïwa lö pirönöy Isak nko korkenyi Repeka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.8",
            "verseOrgIds": [
              "GEN.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, kïkur Apimelek Isak akïlenchï, “Kichö korkengu nyete, kwompö ne temwaghanyi lö cheptönkwa?” Kuyokyï Isak lö, “Ompöwölo kyawaghan lö kïpöranïn ompö nyinte.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.9",
            "verseOrgIds": [
              "GEN.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.9",
            "verseOrgIds": [
              "GEN.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Apimelek lö, “Ne ngölyonte nyï keghwechanyi? Kemuköy chi akong ompö piköchan ntökïrï nko korkengu tökwipkecha ngokï.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.10",
            "verseOrgIds": [
              "GEN.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, kïrirchï Apimelek pich lapay lö, “Kïpöröy chi anka tïkwïl kïma nyo swongöy chichï anta korkenyi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.11",
            "verseOrgIds": [
              "GEN.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.11",
            "verseOrgIds": [
              "GEN.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkatkat Isak kösïgh korononi könyinoni, kwil kïnyïl pokol, ompöwölo kiperur ECHOTYON nyinte, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.12",
            "verseOrgIds": [
              "GEN.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïlïkwï chichay sïkön akïtas kïsïch tïku walaka nko walaka ntökïtenö kïlïkwï nyinte sïkön nyoman. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.13",
            "verseOrgIds": [
              "GEN.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng okwotin cho pö kechir nko cho pö tïch nko cho le mötwor tïkwïl cho chang cho pö konyi: kïlenyona, kwipö kong pïchay pö Pilisti nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.14",
            "verseOrgIds": [
              "GEN.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtïpö nyïngwïny pïchay pö Pilisti koriko pögh löwïr cho kökikïpal mötworiko paponyi Apraam otini kitökïsöpöy nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.15",
            "verseOrgIds": [
              "GEN.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.15",
            "verseOrgIds": [
              "GEN.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, kïlenchï Apimelek Isak, “Ngetena korencha ompöwölo ichinyi awes tya kïsirecha.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.16",
            "verseOrgIds": [
              "GEN.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïweghö Isak koronay akïpörtochï emenyi mpöghoghyo Kerar akïmang wöloni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.17",
            "verseOrgIds": [
              "GEN.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpal ngat Isak korichay pö pögh chanya kikïpal atakinya kitökïsöpöy kwanta Apraam, kïtïp pipö Pilisti otini kirapas Apraam akïkurö kaynötutchay kökikutö paponyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.18",
            "verseOrgIds": [
              "GEN.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.18",
            "verseOrgIds": [
              "GEN.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo otini kipal mötwori Isak mpöghoghyonay akïnyorchï kö pö pögh nyo kosu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.19",
            "verseOrgIds": [
              "GEN.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïporyö mösöwo Kerar nko cho pö Isak, kimi kïlentöy, “Chicha pöghechï.” Kïlenyona kïkurö Isak köyoni pö pögh Esek,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.20",
            "verseOrgIds": [
              "GEN.26.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:20",
              "type": "text"
            },
            {
              "text": "Esek:",
              "type": "text"
            },
            {
              "text": "Ompö Eprania kelentöy, “Nyo kïporyegho.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ompöwölo kiporyö chane nko nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.20",
            "verseOrgIds": [
              "GEN.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.20",
            "verseOrgIds": [
              "GEN.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpal koto pögh anka kïporyeghö nyoni tïkwïl, kïkurö Isak Sitna.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.21",
            "verseOrgIds": [
              "GEN.26.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:21",
              "type": "text"
            },
            {
              "text": "Sitna:",
              "type": "text"
            },
            {
              "text": "Ompö Eprania kelentöy, “Pö punyontön.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.21",
            "verseOrgIds": [
              "GEN.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïwuwö Isak wöloni akïwö kïpal koto pögh anka amelö kiporyeghö chi köyoni. Kïkurö Isak Reopot",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.22",
            "verseOrgIds": [
              "GEN.26.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:22",
              "type": "text"
            },
            {
              "text": "Reopot:",
              "type": "text"
            },
            {
              "text": "Ompö Eprania kelentöy, “Pöroyïn nyo tapes.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " akïlö, “Ompöwölo keghwecha ye ECHOTYON pöroyïn, tökeyichinö koronete.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.22",
            "verseOrgIds": [
              "GEN.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.22",
            "verseOrgIds": [
              "GEN.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïweghö Isak wöloni ntökwit Persyepa ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.23",
            "verseOrgIds": [
              "GEN.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïnchï ECHOTYON oghononi akïlenchï, “Ochan Tororöt pö papongu Apraam. Mewöghisyö ompöwölo omitan nko nyi, operurinyi, tösunyi piko yiyengu kïchangit ompö paraku mötworintenyan Apraam.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.24",
            "verseOrgIds": [
              "GEN.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, kïtek Isak wöloni ato kïpelo amöros akïsagh ECHOTYON ompö atoni. Akïtek emenyi, akïpal mötworichi kö pö pögh atoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.25",
            "verseOrgIds": [
              "GEN.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kam Isak muma nko Apimelek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.25",
            "verseOrgIds": [
              "GEN.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïweghö Apimelek Kerar kutang wölo mi Isak kïmi nko kongenyi Ausat nko Pikol nyo kile yetïn pö lïkenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.26",
            "verseOrgIds": [
              "GEN.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Isak chane lö, “Kopkonchanïkwa ompö ne akwanyï omikwa owöchanïn ayonenanïn atanya korengwo?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.27",
            "verseOrgIds": [
              "GEN.26.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.27",
            "verseOrgIds": [
              "GEN.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï pïchay lö, “Kakïsïwecha nyoman lö mi ECHOTYON nko nyi, kelecha karam kyamacha muma nko nyi, tökeyomisö kegh nko nyi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.28",
            "verseOrgIds": [
              "GEN.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "lö tömeghwecha kïgh nyo gha, kïle wölini melö kikidecha nyi kïgh, wölo kikïpïstecha kegh nko nyi ompö kalya. Akakesïwecha ye lö kakuperurinyi ECHOTYON.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.29",
            "verseOrgIds": [
              "GEN.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, kwighchï Isak chane omisyö nyo wow, kwomisyö pïchay akïgheghsyö. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.30",
            "verseOrgIds": [
              "GEN.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mi ato le asïyech, kïnget nyini le kiwasan akwomchï kegh muma. Atolapay kïpïstö Isak chane kïpa ompö kalya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.31",
            "verseOrgIds": [
              "GEN.26.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.31",
            "verseOrgIds": [
              "GEN.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mi asisoni, kïpka mötwori Isak akïmwochï nyinte ngala köyay pö pögh kimi chane kïpölöy lö, “Kakïnyorucha pögh!” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.32",
            "verseOrgIds": [
              "GEN.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïkurö Isak köyay pö pögh Sipa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:33",
              "type": "text"
            },
            {
              "text": "Sipa:",
              "type": "text"
            },
            {
              "text": "Ompö Eprania kelentöy, “Muma.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïlenyona kekurö kanasyantanay Persyepa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:33",
              "type": "text"
            },
            {
              "text": "Persyepa:",
              "type": "text"
            },
            {
              "text": "Ompö Eprania kelentöy, “Kö pö pögho muma.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " nko ompö nyete le ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kip Esau kor cho pö sany",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kip Esau kor odeny ato kitïngetö könyis 40 cho kipö pipö Ititi. Kip Yudit chepö Peeri nko Pasemat chepö Elon. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh koruchoni otöp nyo pö Isak nko Repeka kïngwanit.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.35",
            "verseOrgIds": [
              "GEN.26.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kesoyön Isak Yakopo",
          "type": "text"
        }
      ]
    }
