              "items": [
                {
                  "text": "Tow 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusoyön Tororöt Noa nko werkachi akïlenchï, “Osïch monïng cho chang tösisyö atanyïghita ngwïny. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.1",
            "verseOrgIds": [
              "GEN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wöyokwa tyonkïn tïkwïl cho echön nko cho mïnkech nko törit nko kaghagh lapay, nyökoritu chane ompö akwa, opöytokwa chane lapay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.2",
            "verseOrgIds": [
              "GEN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku omisyenkwa tyonkïn lapay cho sötote, kïle wölanye kyokonokwa onkïy, okonokwa choni tïkwïl kïlïkwï omisyenkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.3",
            "verseOrgIds": [
              "GEN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.26+LEV.7.27"
              },
              "items": [
                {
                  "text": "Law 7:26-27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.17.10+LEV.17.11+LEV.17.12+LEV.17.13+LEV.17.14"
              },
              "items": [
                {
                  "text": "17:10-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
