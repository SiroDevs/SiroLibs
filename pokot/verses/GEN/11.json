        {
          "text": "Achï monïngo Syem. Kiwer könyiswö odeny otini kiwonyö puseryonta akitïng Syem könyis 100, kïsïch werïnyi Arpaksyad, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïtöpö ngat könyis 500, kïsïch monïnge walaka cho le wor nko tipïn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
