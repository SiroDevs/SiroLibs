          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Montö nyo kipö tagh kï ki Us nko werïngwa Pus nko Kemuel nyo kile papoto Aram ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.21",
            "verseOrgIds": [
