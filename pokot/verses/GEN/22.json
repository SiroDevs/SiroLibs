        },
        {
          "text": "Soyönöy kegh asïyech pipö punton cho pö ngwïny kïmïkul, ompöwölo keteranyi kutinyan.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.18",
            "verseOrgIds": [
              "GEN.22.18"
            ]
          }
        },
        {
