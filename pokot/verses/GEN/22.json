              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyo kiyï Repeka. Kïyichï Milka Naor nyo kile werto ompö Apraam werchoni le mut nko sömök. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.23",
