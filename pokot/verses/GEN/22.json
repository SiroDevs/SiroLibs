          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmïla nyu Apraam wölanye kimi karachïnechay le chechi, kïnget chane akïpa tïkwïl ntökwit Persyepa, kïmang Apraam Persyepa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.19",
            "verseOrgIds": [
              "GEN.22.19"
            ]
          }
        }
      ]
    },
