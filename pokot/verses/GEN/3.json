          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.11",
            "verseOrgIds": [
              "GEN.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï chichay lö, “Kökonanïn kokonay kikonunyi kïtöpö nko ani okintononi, atolapay aman.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.12",
