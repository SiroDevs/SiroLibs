          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.9",
            "verseOrgIds": [
              "GEN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï lö, “Kalïminyi ompö par, anyakoritwan aghïpan, ompöwölo ochan chïrut.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.10",
            "verseOrgIds": [
              "GEN.3.10"
            ]
          }
        }
      ]
    },
    {
