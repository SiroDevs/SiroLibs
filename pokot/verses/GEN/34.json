  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "GEN 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö asistanka Dina chepö Yakopo nyo kiyichï Lea kïtuyö nko koruko korononi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.1",
            "verseOrgIds": [
              "GEN.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kisïwa Syekem wero Amor nyo kile chi pö Ipiti, aki nyinte nyo kirwokyini korononi, kïnam chepay akïpatal nyinte ompö owesyö. Kïlenyona, kutö arasï nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.2",
            "verseOrgIds": [
              "GEN.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlö aros kipïchighit nyoman Dina. Kïwechï kïchamacham chepay pö Yakopo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.3",
            "verseOrgIds": [
              "GEN.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö kïlenchï kwanta, “Kaykay weghwante aloto ka Yakopo topön cheptanyi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.4",
            "verseOrgIds": [
              "GEN.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.4",
            "verseOrgIds": [
              "GEN.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunkïtï Yakopo lö kikusïmnyon Syekem cheptanyi Dina, wölo kimeghnye kïgh ntökïtenö kïpka werkachi, ompöwölo kitökïmi chane achey. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.5",
            "verseOrgIds": [
              "GEN.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Amor papoto Syekem aloto ka Yakopo, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.6",
            "verseOrgIds": [
              "GEN.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kipkono achey werpö Yakopo panoni. Nyini kilïm ngalechoni, kïngwonchï nyoman, ompöwölo kighchï chichoni pipö Israel ghöyityö nyo wow otini kinam chepö Yakopo ompö owesyö, kïgh nyo kimelö kikïchömöy keghöy. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.7",
            "verseOrgIds": [
              "GEN.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïngalan Amor nko chane lö, “Kicham werïnyan Syekem cheptönkwa nyoman nyo osoghokwa lö opïsinö kwip nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.8",
            "verseOrgIds": [
              "GEN.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanya kechomnyechinö ngala kensyö. Okonecha tipikwa kepö, opökwa chicha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.9",
            "verseOrgIds": [
              "GEN.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimukechanyu kemöngisyenö tïkwïl. Omukekwa omönge wop anka tïkwïl nyo kamachakwa, ompurö atagha mïnchïrïsnön atalïkuna monkor ompö wölete.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.10",
            "verseOrgIds": [
              "GEN.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.10",
            "verseOrgIds": [
              "GEN.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchï Syekem papoto Dina nko werkökwa, “Kaykay achama kïgh nyo kaghan, tö ato mi kïgh nyo omwowanïkwa, omukan oghöy. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.11",
            "verseOrgIds": [
              "GEN.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otörwokwa kanyoy cho tenö chini komökekwa nko ropöw, otini kokonanïkwa kïnye cheponi opön.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.12",
            "verseOrgIds": [
              "GEN.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.12",
            "verseOrgIds": [
              "GEN.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï werpö Yakopo Syekem nko kwanta Amor ompö lïs, ompöwölo kökikusïmnyon cheptöngwa Dina. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.13",
            "verseOrgIds": [
              "GEN.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï, “Melö kimukecha keyilchine cheptönyo chi nyo le somchon. Lïku nyoni arasï ompö acha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.14",
            "verseOrgIds": [
              "GEN.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimukecha kechomnyenö nko akwa ato arïpakwa otöptöncha nyo mötïnye, kemutöy pich löwïr cho le mïrön ompö kwenunkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.15",
            "verseOrgIds": [
              "GEN.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atoni nyu ato kïpïswokwa opö tipicha akepöcha tipikwa aketïpicha nyu nko akwa akelïkwï pich akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.16",
            "verseOrgIds": [
              "GEN.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato machamakwanye lenyoni, kemïtecha cheptönyo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.17",
            "verseOrgIds": [
              "GEN.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.17",
            "verseOrgIds": [
              "GEN.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïwa Amor nko werïnyi Syekem lö karamach ngalechoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.18",
            "verseOrgIds": [
              "GEN.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurïpchï rotwö panini weray mïnïng ompöwölo kichomnyö nyoman nyinte nko chepö Yakopo. Aki weroni nyo kikonyïtote tya ompö katangwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.19",
            "verseOrgIds": [
              "GEN.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, kïwö Amor nko werïnyi Syekem kutang areto kanasyantengwa akïngölonchï pich cho kimi kanasyantanay lö, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.20",
            "verseOrgIds": [
              "GEN.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Achï pich cho le kongot. Kepïsyinö chane kïmöngisyö akwigh mïnchïrïsnön, ompöwölo mïchinecha koronete nko chane tïkwïl, tökepöcha tipikwa, kwip chane tipicha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.21",
            "verseOrgIds": [
              "GEN.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo muköy pïchoni kïcham kïmang nko acha tökelïkuna pich akonga ato kïchamacha kemuta ompö kwenuncha monïng lapay cho le wor kïkarkegh nko chane. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.22",
            "verseOrgIds": [
              "GEN.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mölïkucha so kyakikwa nko tïkukwa kïmïkul chicha? Akanya pat kechömchinö chane tökïmöngisyö nko acha.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.23",
            "verseOrgIds": [
              "GEN.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcham piko kanasyantanay kïmïkul ngala Amor nko Syekem. Kïlenyona kemut mïrön anka tïkwïl.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.24",
            "verseOrgIds": [
              "GEN.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.24",
            "verseOrgIds": [
              "GEN.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mi asisto sömök, otini kitökuchiryot pïchay kikïmut, kïcheng chokonikwa werpö Yakopo odeny, Simion nko Lawi cho tupchö nko Dina, kïpa kïlïtöy kanasyantanay ompö nyakanat akïpar mïrön löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.25",
            "verseOrgIds": [
              "GEN.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpara chok Amor nko werïnyi Syekem akumïtuna Dina kö pö Syekem, kïpechï kegh pïchay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.26",
            "verseOrgIds": [
              "GEN.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kiwonyö pörchonay, kïpa werpö Yakopo walaka kïlïtöy kanasyantanay akïcheng tïkwïn, tökutak arasito cheptöngwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.27",
            "verseOrgIds": [
              "GEN.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpörï kechir nko tïch nko sïkïröy nko kïgh anka tïkwïl nyo kimi kanasyan anta nyo kimi wuw. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.28",
            "verseOrgIds": [
              "GEN.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcheng tïkukwa löwïr, monïng nko korukwa nko kïgh anka tïkwïl nyo kimi korikwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.29",
            "verseOrgIds": [
              "GEN.34.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 34:29"
          },
          "items": [
            {
