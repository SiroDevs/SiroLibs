                "loc": "HEB.11.9"
              },
              "items": [
                {
                  "text": "Epr 11:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochan rutoghin nyo owestegho kwenunkwa. Oltewante par kite ompö korenkwa otïpchan korkenyu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.4",
            "verseOrgIds": [
              "GEN.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.4",
            "verseOrgIds": [
              "GEN.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï pïchay pö Ititi Apraam lö, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.5",
            "verseOrgIds": [
              "GEN.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Terwecha, we echotyon ichinyi wow nyoman ompö kwenuncha. Tïpchinö mïntïrïchengu pïrïm nyo kekïlanyi ompö pïrïmpoticha, möminye chi ompö acha nyo muköy kïgheteninyi pïrïmpenyi tömetïpchï mïntïrïchengu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.6",
            "verseOrgIds": [
              "GEN.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.6",
            "verseOrgIds": [
              "GEN.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnget Apraam akungïrukyï pipö Ititi ompö konyït, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.7",
            "verseOrgIds": [
              "GEN.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïlenchï, “Ato kochömwanïkwa otïpön mïntïrïchenyu, kïkaram osomwante Epron wero Soar, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.8",
            "verseOrgIds": [
              "GEN.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwoltewanïn köpönenyi nyo mi Makpela sörömuto parenyi, aghan kïlïkwï parsïkontönyan, otöninan nyinte ye ropïyeni cho mïchini.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.9",
            "verseOrgIds": [
              "GEN.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.9",
            "verseOrgIds": [
              "GEN.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitöpö Epron tïkwïl kwenuto pikökwa pipö Ititi. Kïlenchï Epron Apraam kïlïmöy pipö Ititi, cho kituyeghö kukanay pö kanasyan, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.10",
            "verseOrgIds": [
              "GEN.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ewo, echotyontenyu, terwante. Okoninyi pare kïmïkul nko köpöne nyo mi orinyi. Kokonwan kïsïwïyi piköchan. Tïpchinö mïntïrïchengu wöloni.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.11",
            "verseOrgIds": [
              "GEN.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.11",
            "verseOrgIds": [
              "GEN.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungïrukö Apraam ngat ompö konyït ompö tawuto pïchay pö koronay, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.12",
            "verseOrgIds": [
              "GEN.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïlenchï Epron kïlïmöy pïchay pö koronay, “Terwante, ato ichömenyi. Okoninyi olyeto parengu kïmïchï, nyo osoghinyi ye lö tacha ropïyenichï atowan otïpchï mïntïrïchenyu wölini.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.13",
            "verseOrgIds": [
              "GEN.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.13",
            "verseOrgIds": [
              "GEN.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Epron Apraam lö, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.14",
            "verseOrgIds": [
              "GEN.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Echotyontenyu, tere köny, kikongityot nko ne ompö nyi nko ani par nyo kyolo ropïyeni silpa cho le 400? Tïpö mïntïrïchengu.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.15",
            "verseOrgIds": [
              "GEN.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcham Apraam ngalechoni pö Epron, kupimchï ropïyenichay le 400 kökimwa nyinte ompö tawu pipö Ititi, le nyo kipöghisyegho mïnchïrïs osiswechoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.16",
            "verseOrgIds": [
              "GEN.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.16",
            "verseOrgIds": [
              "GEN.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lata nyoni wölo kisïktö Apraam para Epron nyo kimi Makpela okumpö kongasis pö Mamre. Kïlïkwï nyenyi pare kïmi nko köpöne nyo kimi orinyi nko keti tïkwïl cho kiwit paranoni, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.17",
            "verseOrgIds": [
              "GEN.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kikitö Apraam choni löwïr kïlïkwï tïkuchi ompö tawu pipö Ititi nko ompö tawu pich lapay cho kilïtöy tawu kuketo kanasyantenyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.18",
            "verseOrgIds": [
              "GEN.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.18",
            "verseOrgIds": [
              "GEN.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany kuwonyö, kïtïpchï Apraam Sara korkenyi köpöno para Makpela kïparta wölnö le Mamre (nyoni kï Epron) nyo mi koro Kanan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.19",
            "verseOrgIds": [
              "GEN.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, kikyolchï Apraam paranay kipö pipö Ititi, kïmi nko köpöne kïlïkwï nyenyi nyo tïpchini pich.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.20",
            "verseOrgIds": [
              "GEN.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakïkensyechï Isak",
          "type": "text"
        }
      ]
    }
