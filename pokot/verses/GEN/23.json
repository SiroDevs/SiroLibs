              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitöpö Sara könyis 127. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.1",
            "verseOrgIds": [
              "GEN.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïröpösyï Sara Kiryatarpa, nyoni kï Epron nyo mi koro Kanan. Kungwïn Apraam kïloch kïrirchï Sara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.2",
            "verseOrgIds": [
              "GEN.23.2"
            ]
          }
        }
      ]
    },
    {
