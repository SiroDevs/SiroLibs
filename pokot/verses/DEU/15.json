          "type": "text",
          "attrs": {
            "verseId": "DEU.15.12",
            "verseOrgIds": [
              "DEU.15.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
