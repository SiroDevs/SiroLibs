                {
                  "text": "Krt 3:23-27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchï ECHOTYON Musa asisoni, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.48",
            "verseOrgIds": [
              "DEU.32.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 32:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pustena kutïngï pö Aparim mi koro Moap nyï topönöy kegh nko Yeriko aipusta kutïng pö Nepo atetopönö korononi pö Kanan karich otönön pipö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.49",
            "verseOrgIds": [
              "DEU.32.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "DEU 32:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iröpösyinenyi kutïngï le atanya kiröpösï werïnkwa Aron kutïngoni pö Or, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.50",
            "verseOrgIds": [
              "DEU.32.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "DEU 32:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "ompöwölo kyosïmnyonökwa kaynenyan ompö kwenu pipö Israel, atanye kyagheghakwa pögh ompö Meripa, ato lekïto kanasyanta Kades nyo kimi surkwen pö Sin. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.51",
            "verseOrgIds": [
              "DEU.32.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "DEU 32:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itopönenyi kwïle koronini ompö wölo low, wölo melö ilïtenyi korononi otöninan pipö Israel.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.52",
            "verseOrgIds": [
              "DEU.32.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kesoyön Musa pipö Israel",
          "type": "text"
        }
      ]
    }
