          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo ato töp ngölyontononi ntökïlïkwï man, lö melö ki chepkïltït kokononi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.20",
            "verseOrgIds": [
              "DEU.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "akany kumït poyichoni kokononi cheponi ntökwit kuketo koto kwanta akïwira piko kanasyantanoni koghïn ntökïma. Ompöwölo kitö arasï pipö Israel otini kinya kïwestotö kïtomö keyilta. Aranoni nyo omukekwa onoteghone ghöyityö ompö kwenunkwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.21",
            "verseOrgIds": [
              "DEU.22.21"
            ]
          }
        }
      ]
