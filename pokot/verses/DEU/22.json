              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato kïnyorï chi nyo rïwöy nko koko chi ketïghöy chane kwodeny. Aranoni nyo omukekwa onoteghone ghöyityö ompö kwenunkwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
      ]
