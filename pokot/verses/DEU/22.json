          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kinyorchï wuw akïkïrkegh kilö arir, kïmelö kimi chi nyo kyowönchï nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
            "verseOrgIds": [
              "DEU.22.27"
            ]
          }
        }
