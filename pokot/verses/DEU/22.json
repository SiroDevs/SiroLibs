              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo ato nyorchï mïrönö työ wuw nyo kikelotokïn akïwechï kïporyeghö, kepöröy chichoni onkït. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.25",
            "verseOrgIds": [
              "DEU.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mada kïgh cheponi, melö kegh nyinte ngokï cho mïchini meghat. Karkegh ngölyontononi nko chi nyo kepulchï chitö anka akïpar. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.26",
            "verseOrgIds": [
              "DEU.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
