            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.7"
              },
              "items": [
                {
                  "text": "Wuw 17:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.11.3"
              },
              "items": [
                {
                  "text": "Kiy 11:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.11.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aghakwa ngat ECHOTYON kïnarek ompö Tapera nko Masa nko Kiprot Atapa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
            "verseOrgIds": [
              "DEU.9.22"
            ]
          }
        },
