                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Meghchï kegh körkeyïn pö kïgh anka tïkwïl nyo kipötöy, nyo mi yïm anta nyo mi pögh ngwïny ori. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.8",
            "verseOrgIds": [
              "DEU.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesagh tïkuchoni anta ipöghisyechï: ompöwölo ochan ECHOTYON Tororötïngu nyo le söstoghin ompö tororötin walaka. Otökonan monïng ghöyïntino papotïnekwa ntökwit pïnta nyo pö sömök nko nyo pö angwan, chona reyanïn. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.9",
            "verseOrgIds": [
              "DEU.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo osyonchinan pich cho makïrar cho chömanïn, akïripöy kirurutköchan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.10",
            "verseOrgIds": [
              "DEU.5.10"
            ]
          }
        }
      ]
    },
