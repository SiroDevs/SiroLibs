      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïweghö Musa tömköyi Moap akïpus kutang kutïng pö Nepo akïwö ntökwit kutïng pö Piska parak kongasispa Yeriko. Kuporchineghö ECHOTYON atoni koroswechï löwïr, kïngata koro Kiliad okumpö ewu löt ntökwit kanasyanta Dan ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.1",
            "verseOrgIds": [
              "DEU.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko koro Naptali kïmïkul nko koroswo Epraim nko Manase nko koro Yuda akïwö kutang okumpö ta ntökwit nanampa Kwen ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.2",
            "verseOrgIds": [
              "DEU.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko koro Yuda okumpö ewu tagh nko tömkö nyo wegho Soar ntökwit Yeriko kanasyanta sostin. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.3",
            "verseOrgIds": [
              "DEU.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
