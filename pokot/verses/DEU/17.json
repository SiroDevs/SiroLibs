                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.27"
              },
              "items": [
                {
                  "text": "9:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amömïchininye kïtas nyinte kor cho chang, atömötöp mïkulöwunyi ntökïwaghaka ompö ECHOTYON amakany kuchangit tya ropïyen nko koltin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Akwotini kalïkwï pöytoghin nyinte, kuroko kïtïng kitapu kirurut pö Tororöt nko kinetut cho pkono kitapï nyo tïng tïsï cho le pipö Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.18",
            "verseOrgIds": [
              "DEU.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïchini kutö nyinte kitapunoni kamasunyi akusomön osis löwïr otini tökïsatate nyinte, atökumï kïkonyït ECHOTYON akïrip ngalechi cho mwoghöy. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.19",
            "verseOrgIds": [
              "DEU.17.19"
            ]
          }
        },
