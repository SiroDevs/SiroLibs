            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.28"
              },
              "items": [
                {
                  "text": "9:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Merokonye kïtösyï kegh pöytoghintö angoletin anta yonta pich kïpa Misri kïrongwï angoletin atökïtas, ompöwölo kilenchokwa ECHOTYON, ‘Momïlonchenö ngat koronini.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.16",
            "verseOrgIds": [
              "DEU.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 17:17"
          },
          "items": [
