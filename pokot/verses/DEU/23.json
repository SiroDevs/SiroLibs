          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato iwerata pareto pöröryengwo nyo pö matay omukekwa opoke yiti, wölo makas.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.25",
            "verseOrgIds": [
              "DEU.23.25"
            ]
          }
