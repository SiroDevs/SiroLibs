              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato awerata pareto pöröryengwo nyo pö sapipun, omukekwa omey sapipun ntopïghyö, wölo motö walaka mïlotwekwo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.24",
            "verseOrgIds": [
              "DEU.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
