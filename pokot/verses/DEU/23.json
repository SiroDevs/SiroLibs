              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato awolwolchikwa kïgh ECHOTYON Tororötïngwo, atötö lawel, ompöwölo mökonokwa nyinte kïyoni. Akïlïku ngokï ompö akwa ato motötekwanye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato melö kowolwolchikwa nyinte kïgh, kïmelö ngokï ompö akwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irip lasiny agh kïgh nyo kengwïna kutïwekwo, kïrïp kegh nko kiwalwalatengwo ompö ECHOTYON Tororötïngwo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
        }
      ]
