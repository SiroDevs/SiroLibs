            "sid": "DEU 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.25",
            "verseOrgIds": [
              "DEU.1.25"
            ]
          }
        },
