          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kïtöpö chomnyenyan nko akwa löwïr ompö Kristo Yeso.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.24",
            "verseOrgIds": [
              "1CO.16.24"
            ]
