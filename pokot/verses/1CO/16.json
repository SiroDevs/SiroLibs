            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.11",
            "verseOrgIds": [
              "1CO.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye nyu ompö ngala werïnyo Apolo, kyasaghan nyinte nyoman kïrutowokwa nko werköcho walaka, wölo katagh nyinte lakat kungwïn otï le ye, wölo ngwïnöy lawel ato muka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.12",
            "verseOrgIds": [
              "1CO.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngala söröm",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
