                "loc": "EXO.13.21+EXO.13.22"
              },
              "items": [
                {
                  "text": "Wuw 13:21-22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.22+EXO.14.23+EXO.14.24+EXO.14.25+EXO.14.26+EXO.14.27+EXO.14.28+EXO.14.29"
              },
              "items": [
                {
                  "text": "14:22-29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omökan ononwokwa, werköcho, ngal cho kichumchï kukötinecho chanya kirïpöy Musa. Kikarta polta chane löwïr, akimechutcha pögh otini kyoghyot Nanam nyo Pïrir. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.1",
            "verseOrgIds": [
              "1CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikipatisan chane kïmïkul kïlïkwï rïpanpa Musa ompö poltononi nko nanamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.2",
            "verseOrgIds": [
              "1CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.35"
              },
              "items": [
                {
                  "text": "Wuw 16:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwam chane löwïr omisyononi pö mïkulögh, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.3",
            "verseOrgIds": [
              "1CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.6"
              },
              "items": [
                {
                  "text": "Wuw 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.11"
              },
              "items": [
                {
                  "text": "Kiy 20:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïgha chane löwïr pöghechoni pö mïkulögh, ompöwölo kighegha ghatyanoni pö mïkulögh kirïpöy chane aki Kristo* nyinte ghatyanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.4",
            "verseOrgIds": [
              "1CO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.29+NUM.14.30"
              },
              "items": [
                {
                  "text": "Kiy 14:29-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wölo kïrkegh kïlenyoni, kïmelö kingarak Tororöt ompö pïchoni cho chang, ketoytoyö mïntïruchkökwa wölo le surkwen.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.5",
            "verseOrgIds": [
              "1CO.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.5",
            "verseOrgIds": [
              "1CO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.6",
            "verseOrgIds": [
              "1CO.10.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.11.4"
              },
              "items": [
                {
                  "text": "Kiy 11:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kighisyö ngalechoni löwïr atökïlïkwï körkeyïn ompö acha, tökïrirwecha tömökïpïrchï tïkwïn cho ghach le pïchoni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.6",
            "verseOrgIds": [
              "1CO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.6"
              },
              "items": [
                {
                  "text": "Wuw 32:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " anta kïsagh körkeyïntin le wölo kisaghta walaka ompö chane. Le wölo mwoytoy Kikirut lö, “Kimpur pïchoni ngwïny akwomisyö akïgheghsyö atolapay kïnget akïnyal.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.7",
            "verseOrgIds": [
              "1CO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.1+NUM.25.2+NUM.25.3+NUM.25.4+NUM.25.5+NUM.25.6+NUM.25.7+NUM.25.8+NUM.25.9+NUM.25.10+NUM.25.11+NUM.25.12+NUM.25.13+NUM.25.14+NUM.25.15+NUM.25.16+NUM.25.17+NUM.25.18"
              },
              "items": [
                {
                  "text": "Kiy 25:1-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mïchini kekïrenöcha kegh cheporesnan tömökïkarkegh nko walaka ompö chane cho kimeghö asis akonga cho le 23,000. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.8",
            "verseOrgIds": [
              "1CO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.5+NUM.21.6"
              },
              "items": [
                {
                  "text": "Kiy 21:5-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amöketyam Echotyon le wölo kida walaka ompö chane, kuwany moroyut. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.9",
            "verseOrgIds": [
              "1CO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.41+NUM.16.42+NUM.16.43+NUM.16.44+NUM.16.45+NUM.16.46+NUM.16.47+NUM.16.48+NUM.16.49"
              },
              "items": [
                {
                  "text": "Kiy 16:41-49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amökengwïrngwïronchö le wölo kilïkwï walaka ompö chane kunyar Malaykayanta Meghat.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.10",
            "verseOrgIds": [
              "1CO.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.10",
            "verseOrgIds": [
              "1CO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipkonchï nyu pïchoni löwïr ngalechoni atökïlïkwï kiporunöt ompö pikö walaka akekir atökïrirwecha cho kakwitwecha osiswo söröm.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.11",
            "verseOrgIds": [
              "1CO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.11",
            "verseOrgIds": [
              "1CO.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïchini kïrip kegh chi tömepït nyo nonöy lö ochï chïchïmate. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.12",
            "verseOrgIds": [
              "1CO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möminye tyamata nyo itwokwa nyo sis nko nyo nyoru chi anka tïkwïl. Ghanate Tororöt amelö pïsini nyinte ketyömokwa kïtïl owesyenkwa, wölo konokwa tïkwïl owesyö kïmi nko tyamatanoni nyo omïkuköno nko or nyo ochïwïto atamuka oghyongtenö.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.13",
            "verseOrgIds": [
              "1CO.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.13",
            "verseOrgIds": [
              "1CO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, chamankachu, olowitenö kegh saghata körkeyïntin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.14",
            "verseOrgIds": [
              "1CO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ongölonwokwa pich cho ngöghomöch, anan akwane ngalechï omwoghan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.15",
            "verseOrgIds": [
              "1CO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.2+MAT.26.3+MAT.26.4+MAT.26.5+MAT.26.6+MAT.26.7+MAT.26.8+MAT.26.9+MAT.26.10+MAT.26.11+MAT.26.12+MAT.26.13+MAT.26.14+MAT.26.15+MAT.26.16+MAT.26.17+MAT.26.18+MAT.26.19+MAT.26.20+MAT.26.21+MAT.26.22+MAT.26.23+MAT.26.24+MAT.26.25+MAT.26.26+MAT.26.27+MAT.26.28"
              },
              "items": [
                {
                  "text": "Mat 26:2-28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.14.22"
              },
              "items": [
                {
                  "text": "Mrk 14:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.19+LUK.22.20"
              },
              "items": [
                {
                  "text": "Luk 22:19-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mökïghömechinechanye so kisön pö Kristo ompö kikompe nyo kïpöghisyeghonecha ompö omisyo Echotyon akeyokyï Tororöt sörö otini kïgheghonecha kikompononi? Ato kïmïnchïrecha makatyan, melö so kïghömechinecha por pö Kristo? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.16",
            "verseOrgIds": [
              "1CO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlïkunecha por akonga ompöwölo akonga makatyantanoni, kïrkegh kakïchicha chang, ompöwölo kiporecha löwïr makatyantanoni le akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.17",
            "verseOrgIds": [
              "1CO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.6"
              },
              "items": [
                {
                  "text": "Law 7:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anane ya pipö Israel cho omöy amörostin, mötïngcha so chane ghömïchö nko ato kïpelo amörostin? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.18",
            "verseOrgIds": [
              "1CO.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omökan omwoghöy ne nya? Kamwaghan so lö osöröpu körkeyïntin? Anta omisyö nyo kïropchini chane?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.19",
            "verseOrgIds": [
              "1CO.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.19",
            "verseOrgIds": [
              "1CO.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.20",
            "verseOrgIds": [
              "1CO.10.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.17"
              },
              "items": [
                {
                  "text": "Krt 32:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ewo! Kamwaghan lö kyak cho yengöy puntonï cho menkïtcha Tororöt kïropchini panyekwa oy, melö Tororöt amochömanye osïkekwa ghömïchö nko oy. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.20",
            "verseOrgIds": [
              "1CO.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Momukekwanye ogheghone kikompo Echotyon nko nyo pö oy amomukekwanye omisyeghone mesa Echotyon nko nyo pö oy. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.21",
            "verseOrgIds": [
              "1CO.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.21"
              },
              "items": [
                {
                  "text": "Krt 32:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anta kïmökecha kwipenecha Echotyon sikong nya? Kichicha so owesöch kïtïl nyinte?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.22",
            "verseOrgIds": [
              "1CO.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kegh kïgh anka tïkwïl ompö ororyo Tororöt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.22",
            "verseOrgIds": [
              "1CO.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.23",
            "verseOrgIds": [
              "1CO.10.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.12"
              },
              "items": [
                {
                  "text": "1Kr 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwoghöy chane lö, “Kïchomwecha keghe kïgh anka tïkwïl.” Lata nyoni nyoman, wölo melö karamach tïkwïn tïkwïl, “Kïchomwecha keghe kïgh anka tïkwïl,” wölo melö ngörokecha tïkuchoni löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.23",
            "verseOrgIds": [
              "1CO.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Merokonye kïyar chi tïkwïn cho töni nyinte onkït tösunöt, poto cho ngöroköy pikö walaka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.24",
            "verseOrgIds": [
              "1CO.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.24",
            "verseOrgIds": [
              "1CO.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama kïgh anka tïkwïl nyo kyoltegho donyo pany amateptep kïgh akwompö sïkunötenkwa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.25",
            "verseOrgIds": [
              "1CO.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.24.1"
              },
              "items": [
                {
                  "text": "Tum 24:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ompöwölo lentöy Kikirut, “Pö Echotyon ngwïnyï nko kïgh anka tïkwïl nyo mi orinyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.26",
            "verseOrgIds": [
              "1CO.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo ato kurchokwa chi nyo melö ghanate omisyö, achömchikwa nyinte, am nyu omisyewut löwïr cho ketö nyinte tawunkwa, amateptep wölo lata omisyewutchoni ompö areto sïkunötengwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.27",
            "verseOrgIds": [
              "1CO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato lenchokwa chi, “Kakïropchï omisyonete körkeyïntin,” mam nyu omisyononi akwompö chichoni kikwowokwa lenyoni nko choghïn nyo karam. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.28",
            "verseOrgIds": [
              "1CO.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamwaghan nyoni amelö ompö choghïntönkwa, wölo ompö choghïn pö chichoni kömwowokwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.29",
            "verseOrgIds": [
              "1CO.10.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tepöy ye nyu chitö anka lö, “Kwompö ne tökïmir otöptönyan nyo tyakate sïkunöteto chitö anka nya? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.29",
            "verseOrgIds": [
              "1CO.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato atachan am omisyononi asoyön Tororöt, kwompö ne tökegheghchinanïn ompö omisyö nyo koyokyineghan Tororöt sörö?”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.30",
            "verseOrgIds": [
              "1CO.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.30",
            "verseOrgIds": [
              "1CO.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona nyu ato koghöy kïgh anka tïkwïl, ato komisïyi anta kogheghsïyi agh choni löwïr ompö ororyo Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.31",
            "verseOrgIds": [
              "1CO.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amolelchï pipö Yaudi anta pipö punton anta kanisa Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.32",
            "verseOrgIds": [
              "1CO.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akara kegh nko ani, ompöwölo komukyan agh pich löwïr kïngörekyö ompö kïgh anka tïkwïl nyo oghan, amelö ompö tösunötenyan kegh, wölo tösunöto pikö walaka atökesörï chane.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.33",
            "verseOrgIds": [
              "1CO.10.33"
            ]
          }
        }
      ]
    }
  ],
