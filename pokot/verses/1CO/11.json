                "loc": "PHP.3.17"
              },
              "items": [
                {
                  "text": "Plp 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arïpanïn nyu, le wölo orïptonan Kristo.*",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        }
