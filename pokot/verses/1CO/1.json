                {
                  "text": "Yer 9:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïlenyona nyu, lentöy Kikirut,",
          "type": "text",
          "attrs": {
