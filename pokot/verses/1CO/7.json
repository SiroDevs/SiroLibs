                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.11"
              },
              "items": [
                {
                  "text": "Mrk 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.18"
              },
              "items": [
                {
                  "text": "Luk 16:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otïngetan ngölyon ompö pich cho kakensyö amelö nyinyan ngölyonte, wölo pö Echotyon, lö, tömötöp korka tökïpïstö santenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.10",
            "verseOrgIds": [
              "1CO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwoto pïstö, kïtöpö mö kip ngat anta manyona, kïchomnyö nko santenyi. Amötöp tïkwïl mïrönö lö otyoköy korkenyi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.11",
            "verseOrgIds": [
              "1CO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.11",
            "verseOrgIds": [
              "1CO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwochinan ante pikö walaka (amelö Echotyon), lö, ato tïng mïrönö nyo kakughan Kristo* korka nyo tomönye kughan akïcham kokononi kïtöpö nko nyinte, kïmömïchininye kutyak. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.12",
            "verseOrgIds": [
              "1CO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mi korka nyo ghanate Kristo nyo tïng santenyi nyo melö ghanate, akïcham santenyi kïtöpö nko nyinte, kïmïchini kïtïpï tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.13",
            "verseOrgIds": [
              "1CO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo toköy Tororöt chichoni otini ketuyö kegh nyinte nko korkenyi. Kïtoköy Tororöt kokononi melö ghanate otini kötuyö nyinte nko santenyi. Ntökömökïlenye nyoni, kötömelö lïku monekwa monïngo Tororöt, wölo kakïtach Tororöt ye monekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.14",
            "verseOrgIds": [
              "1CO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato mach nyinte nyo melö ghanate kïpïstö nyinte nyo ghanate, kïpïstö pat. Tyoko nyu chichoni anta kokononi ghanate, ompöwölo kökurokwa Tororöt otïpinö ompö kalya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.15",
            "verseOrgIds": [
              "1CO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imukenyi korka nyo ichï ghanate tenkïtï lö ne lö memukenyinye sörune santengu? Anta nyi nyo ichï mïrön nyo ichï ghanate, tenkïti lö ne lö memukenyinye sörune korkengu?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.16",
            "verseOrgIds": [
              "1CO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Töpenö le wölo kilatenyi otini kikurïnyi Tororöt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.16",
            "verseOrgIds": [
              "1CO.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïchini kïtöpö chi anka tïkwïl kïrïp kegh nko ropöw cho kiropchï Echotyon akïtöpö le wölo kilata nyinte otini kikur Tororöt. Omwochinan nyu kanisen löwïr lenyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.17",
            "verseOrgIds": [
              "1CO.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato ghan chi nyo kikemut, kïmerokonye kwigh kegh le chi nyo le somchon. Ato kighan nyinte kï somchon, kïmerokonye nyu kïwö tum. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.18",
            "verseOrgIds": [
              "1CO.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo mökïghnye ato wö chi tum anta möwö, wölo kerïp Kirurut pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.19",
            "verseOrgIds": [
              "1CO.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kïtöpö chi anka tïkwïl le wölini kilata otini kighan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.20",
            "verseOrgIds": [
              "1CO.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïkurinyi otini kichinyi sekeyon nya? Mesus kegh, wölo ato inyorï pöroyïn nyo kakityakïn, ipöghisyeghö kityakatengu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.21",
            "verseOrgIds": [
              "1CO.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo tyoko chi ompö Echotyon nyo kökur Echotyon kï sekeyon. Kïlenyoni tïkwïl, nyinte nyo kakïkur kutyakate kïlïku sekeyonto Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.22",
            "verseOrgIds": [
              "1CO.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikyalakwa ompö olyot nyo wow. Malïkune nyu sekeyi pich. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.23",
            "verseOrgIds": [
              "1CO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanya nyu werköcho, kïtöpö chi anka tïkwïl nko Tororöt le wölo kilata nyinte otini kikïkur.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.24",
            "verseOrgIds": [
              "1CO.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngal paraku cho mökensïyicha nko mïsïktin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.24",
            "verseOrgIds": [
              "1CO.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motïngetanye ye nyu kichiköt nyo ngwïno wölo mi Echotyon ompö kor cho kïltït nko mïsïktin, wölo okonunan kinonutyenyu ante nyo kakusyonchï Echotyon alïkwï chi nyo kighönöy. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.25",
            "verseOrgIds": [
              "1CO.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ononan ye nyu ompö kömpölelyonï ketï, lö mïchini kïtöpö chi le wölo kölata nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.26",
            "verseOrgIds": [
              "1CO.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekikensyenyi? Metyak nyu korkengu. Tomönye so kensyenönyi? Meyara nyu kensyogh. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.27",
            "verseOrgIds": [
              "1CO.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato ikensyenyi kïmelö keghanyi ngokï. Ato kip mïrar kïmelö kegh nyinte ngokï. Nyoru pïchoni kensïyi kömpölelut pö ngwïnyinï nka nyoni komökan lö tochïwïtyeghekwa kömpölelutchoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.28",
            "verseOrgIds": [
              "1CO.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.28",
            "verseOrgIds": [
              "1CO.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyï kïgh nyo omökan omwoghöy werköcho: köngötï osiswö cho ngörï, nyo mïchini kïtïpï pich cho kakïkensyö kïngeta ye le cho tomöcha kïkensyö, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.29",
            "verseOrgIds": [
              "1CO.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwigh kegh cho riryot le cho mötïngcha nyarïl, kwigh kegh cho turonchot le cho melö turonchot, kwigh kegh chane cho olöy tïkwïn le ato melö chikwa tïkuchoni kal chane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.30",
            "verseOrgIds": [
              "1CO.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïchini kwigh kegh cho sïngo tïpö ngwïnyinï le pich cho mösïngocha tïkuchoni tya. Ompöwölo mi ngwïnyinete kïsïwïyi ye kuweröy.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.31",
            "verseOrgIds": [
              "1CO.7.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.31",
            "verseOrgIds": [
              "1CO.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omökan otyokekwa kegh ompö sïngut, sïngo chi nyo tomönye kïkensyö ighisyo Echotyon atökïsïwa wölo idoy nyinte Echotyon kïngarak. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.32",
            "verseOrgIds": [
              "1CO.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïngo chi nyo kikensyö ngala ngwïny atökwigh korkenyi kïngarak, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.33",
            "verseOrgIds": [
              "1CO.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïpesyö nyu chane kïlïkwï odeny. Kïkany korka nyo tomönye kep anta nyo le chepkïltït, kïsïngo ighisyo Echotyon, ompöwölo mököy nyinte kutöni Echotyon portanyi nko mïkulöwunyi. Wölo sïngo korka nyo kikep tïpö ngwïnyinï atökwigh santenyi kïngarak.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.34",
            "verseOrgIds": [
              "1CO.7.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.34",
            "verseOrgIds": [
              "1CO.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komwowokwa ngalechoni ompöwölo omökan ongörokokwa, molenchï kegh omökan omirokwa. Wölo kömökan pat osïkekwa tötut cho mïchini atamuka opöghisyechinö Echotyon ompö mïkulögh nko machat akonga.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.35",
            "verseOrgIds": [
              "1CO.7.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.35",
            "verseOrgIds": [
              "1CO.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato sïwa chi lö melö koghchï nyo karam mïrar nyo kökakulotokïn ato mepnye nyinte. Ato pöl nyinte pïrchinoghtinechi, kwigh le wölo kömöktoy akany kwip kegh chane melö ighöy ngoki, ato kensyö. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.36",
            "verseOrgIds": [
              "1CO.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato mut chi ompö mïkulöwunyi lö mokensïyi, akumuköy kïpöytoy pïrchinoghtinechi akïmut kïgh nyo ighöy, kwighöy nyu nyo karam tya ato mepnye mïrarunoni kökikulotokïn. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.37",
            "verseOrgIds": [
              "1CO.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, ighöy chi nyo karam nyo kep mïrarunoni kökakulotokïn, wölo ighöy nyo karam tya chi nyo katagh kïkensyö.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
