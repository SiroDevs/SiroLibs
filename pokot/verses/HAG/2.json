            "number": "1",
            "style": "v",
            "sid": "HAG 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngalan ngat ECHOTYON könyinoni ompö kuti werkoyon Akay asispa 21 arawa mut nko odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.1",
            "verseOrgIds": [
              "HAG.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAG 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenchï mwochinö Serupapel pöytoghinto Yuda nko Yoswö Tïsin nyo Wow* nko pich löwïr lö, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.2",
            "verseOrgIds": [
              "HAG.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAG 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.3.12"
              },
              "items": [
                {
                  "text": "Esr 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ekïmi chi ompö akwa nyo tökunonöy lö kipïchigh lö ne Kö pö Tororöt atanya le taghï? Osïwïyekwa otï le ye lö nen? Mölatanye kwïle ye? ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.3",
            "verseOrgIds": [
              "HAG.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïrkegh kïlenyoni, osïkö nyakanat we Serupapel nko nyi Yoswö nko akwa pipö koronï löwïr atamuka ateka ngat Kö pö Tororöt. Omitan ante ECHOTYON Kimuktoghin nko akwa ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.4",
            "verseOrgIds": [
              "HAG.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïrïp kegh nko wölo kyoyomiswokwa atanya kyamïtunekwa koro Misri. Kïlenyona, mi mïkulöwunyan nko akwa, nyo mowöghisyö nyonikïny.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.5",
            "verseOrgIds": [
              "HAG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.5",
            "verseOrgIds": [
              "HAG.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAG 2:6"
          },
          "items": [
            {
              "text": "6",
