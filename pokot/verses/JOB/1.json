        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.15",
            "verseOrgIds": [
              "JOB.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwotini kitökïmi kïngölonöy, kwitï mötworinte anka akïlö, “Köyonï Tororöt ilat kwam kechiryeku nko mötwori lömïs, kachïwïtan onkït nkanyï kangwïnan omwowunyi.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.16",
            "verseOrgIds": [
              "JOB.1.16"
            ]
          }
        }
      ]
    },
    {
