              "items": [
                {
                  "text": "Ngo 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Onyötö ECHOTYON lö, “Wöghöy so Ayupu Tororöt kwïle? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.9",
            "verseOrgIds": [
              "JOB.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kekartenyi nyinte nko pikachi nko kïgh anka tïkwïl nyo tïng nyinte aisoyönönyi kïgh anka tïkwïl nyo ighöy nyinte aitönönyi nyinte kyak cho chang kïghömï ngwïny. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.10",
            "verseOrgIds": [
              "JOB.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato ichenganyi kïgh anka tïkwïl nyo tïng nyinte, kïchïpinyi nyinte lokonyïn!”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.11",
            "verseOrgIds": [
              "JOB.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
