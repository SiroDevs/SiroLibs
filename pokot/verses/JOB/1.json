          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwotini kitökïmi kïngölonöy, kwitï mötworinte anka akïlö, “Kimi moneku kwomöy akortangwa ompö koto werïngwa nyo wow, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.18",
            "verseOrgIds": [
              "JOB.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwitï chepkïrïri nyo kingwïno okumpö surkwen akurulto köyay kïtïgh chane lömïs. Kachïwïtan onkït nkanyï atangwïn kangwïnan omwowunyi.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.19",
            "verseOrgIds": [
              "JOB.1.19"
            ]
          }
        }
