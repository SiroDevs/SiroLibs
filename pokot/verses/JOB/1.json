          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï ECHOTYON Onyöt lö, “Achona tïkuchi löwïr mi moriku, idena wölo kedoy, wölo meswanga ewungu nyinte.” Kïweghö nyu Onyötonay otini kimi ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kityam Onyötö Ayupu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
