              "items": [
                {
                  "text": "Tow 6:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi nyu asis akong ato kipka malayken kughyongo tawu ECHOTYON. Kimi Onyötö atoni tïkwïl nko chane. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.6",
            "verseOrgIds": [
              "JOB.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep ECHOTYON Onyöt lö, “Ingwïnenyi onö?”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.7",
            "verseOrgIds": [
              "JOB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Onyötö ECHOTYON lö, “Komitan owestotoy orimotoy ngwïny.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.7",
            "verseOrgIds": [
              "JOB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.7",
            "verseOrgIds": [
              "JOB.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep ECHOTYON lö, “Akesïwenyi mötworintenyan Ayupu nya? Möminye chitö anka nyo kikongityot nko nyinte ompö ngwïny, chi nyo tenate akï pö man, chi nyo konyïtanïn akïripöy kegh tömegh ngokï.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.8",
            "verseOrgIds": [
              "JOB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
