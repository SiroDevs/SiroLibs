          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi chi nyo kimöngöy kor Us nyo kikïkuro Ayupu. Ki chi nyo tenate akikonyïtöy Tororöt akilowito kegh ghöyityö. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.1",
            "verseOrgIds": [
              "JOB.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng werkachi mut nko odeny nko tipïn sömök ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.2",
            "verseOrgIds": [
              "JOB.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "akitïng kechir 7,000 nko tamasay 3,000 nko tïch 1,000 nko sïkïröy 500 nko mötwor cho chang aki chi nyo kile sïkön nyinte kïtïl pich löwïr ompö wölini le Kongasis.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.3",
            "verseOrgIds": [
              "JOB.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
