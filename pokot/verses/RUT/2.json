              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï nyu Naomi Rus, “Karam nyoman cheptanyu nyo kewestenyi nko mötworichi nyo antö kö para chi anka kötökisusinyi.” ",
          "type": "text",
          "attrs": {
