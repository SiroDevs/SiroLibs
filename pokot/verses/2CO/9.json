          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kingarakat nyo kitöni pipö Kristo*",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möminye machata atasan akirwakwa ompö ighisyononi pö kingarakat oghchinekwa pipö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.1",
            "verseOrgIds": [
              "2CO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onkïtön lö otïngetekwa machat, akyokwolan kegh tawu pipö Makedonia ompö akwa ompö ngölyontononi. Kyomwochan chane lö, “Kïmi tupchenicho cho pö Akaya kïpsach kungörokisyö könyinay kewer.” Kenget nyu pich cho chang tya ompö chane kikilötenkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.2",
            "verseOrgIds": [
              "2CO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyoni koyonwan ye werköcho chete atömöwaghaka kwolötencha nyo kïkwolocha kegh akwa kïlïkwï kwïle, otïpï nyu kïpsach nko kingarakatengwo le nyanye kyomwowokwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.3",
            "verseOrgIds": [
              "2CO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tömötöp ato angwïnan nko pipö Makedonia kelö momitekwanye kïpsach, kïnyorunecha nyu atoni arasï, ompöwölo kïtighecha kegh akwa tya! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.4",
            "verseOrgIds": [
              "2CO.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyoni kasïwan lö mötïnye oyonwan werköcho chete kïnya kïrutowokwa kïtomö angwïnan atökïpka kïror ropöwontenkwa nyanya kyoyomisukwa atökïrorwanïn ropöwontononi atokïrumï lö kyokonukwa akwane ompö machatengwo amelö ompöwölo kakichikyokwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.5",
            "verseOrgIds": [
              "2CO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.5",
            "verseOrgIds": [
              "2CO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anana lö, chi anka tïkwïl nyo kötkötöy kösïgh cho ngörï, kïkösöy cho ngörï kïkany nyo kötkötöy cho chang kïkösöy cho chang. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.6",
            "verseOrgIds": [
              "2CO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanya nyu kutötö chi anka tïkwïl kïrïp kegh nko machatenyi melö ompö chopat anta ompö kichikyin, ompöwölo chömöy Tororöt chi nyo tötoy kïgh ompö ngörekyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.7",
            "verseOrgIds": [
              "2CO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akumuköy Tororöt kïkonokwa tïkwïn cho chang kïtïl cho komökekwa atamuka otïngetenö kïnomnyö kïgh anka tïkwïl, atatasa tagh angaraka ighisyö anka tïkwïl nyo karam. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.8",
            "verseOrgIds": [
              "2CO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.112.9"
              },
              "items": [
                {
                  "text": "Tum 112:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïle wölo mwoytoy Kikirut lö,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.9",
            "verseOrgIds": [
              "2CO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
