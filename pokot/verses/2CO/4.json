        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mökosyo Mïkulögh cho mi tören",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona nyu, ompöwölo kakusyonchecha Tororöt akïkonecha ighisyonï, kemitecha kekilöy kegh. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.1",
            "verseOrgIds": [
              "2CO.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakïpïstecha ngala arasï löwïr cho wïngote. Melö tökepöghisyeghocha lïs anta kïpöghisyeghö ngölyonto Tororöt ompö putintön. Kiportocha man otini kighecha man atöketönöcha sïkunöto chi anka tïkwïl kurwokyecha ompö tawu Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.2",
            "verseOrgIds": [
              "2CO.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrkegh köwïngisyö Lökoyechï Karamach kyomtocha, kïwïngisyot pat ompö pich cho mi kupotyot. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.3",
            "verseOrgIds": [
              "2CO.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö ghönöy chane ompöwölo körchini tororöt pö ngwïnyinï tuwïn pköchintöngwa, atömemï chane kïsïwa löpoyïn pö Lökoy cho Karamach cho pö töroryo Kristo* nyo le kïton pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.4",
            "verseOrgIds": [
              "2CO.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kyomtocha kegh achane, wölo kyomtocha Yeso Kristo nyo le Echotyon, kïchicha achane mötworikwa ompö Yeso. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.5",
            "verseOrgIds": [
              "2CO.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.3"
              },
              "items": [
                {
                  "text": "Tow 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ompöwölo Tororötini nyo kimwa lö, “Nya kulïwunö löpoyïn tuwïn,” nyoni lïwchini mïkulöwecha tökïkonecha löpoyïn pö kinkïtöt nyo pö töroryo Tororöt nyo lïwuno tokochu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.6",
            "verseOrgIds": [
              "2CO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.6",
            "verseOrgIds": [
              "2CO.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlatecha nyu cho kïtïng mökosyononi pö mïkulögh kari tören, atökïrumtö lasiny lö, ngwïno owesyononi wow wölo mi Tororöt amelö ngwïnonecha achane kegh. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.7",
            "verseOrgIds": [
              "2CO.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyörilecha kong ompö or anka tïkwïl, wölo tomönye kewanyecha. Kïtomtomönecha, wölo melö meghsonecha mutïnö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.8",
            "verseOrgIds": [
              "2CO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichopecha kong, wölo möminye ato melö kïtïngetecha kingarakat. Akï kïrkegh kakikotönecha kïnomnyö, wölo tomönye kewanyecha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.9",
            "verseOrgIds": [
              "2CO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkösönecha megha Yeso ompö porwöyicho kïnomnyö, atökïrumteghö tïkwïl söpontanyi porwöyicha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.10",
            "verseOrgIds": [
              "2CO.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmitecha tapanpa meghat ompöwölo kighönecha Yeso kïnomnyö, atökumï söpontanyi tïkwïl kïrumteghö porwöyicha cho wonyot. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.11",
            "verseOrgIds": [
              "2CO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poru nyoni lö pöghisyegho meghat orincha, kïmi söpon kïpöghisyegho orinkwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.12",
            "verseOrgIds": [
              "2CO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
