        "number": "5",
        "style": "c",
        "sid": "2CO 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kinkïtöcha lö ato kïngany koncha nyï kïmöngöy otï le ye nyoni kï portöncha nyo pö ngwïnyinï, kïtökïkonecha Tororöt mönge anka nyo mi yïm nyo pö kokay nyo melö kïteko ewun. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.1",
            "verseOrgIds": [
              "2CO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmitecha ye kengerötyot nyoman ompö otöpnete, aketïngetö machat nyo wow nyoman lö tökilokwech möngenyo nyo ngwïno yïm. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.2",
            "verseOrgIds": [
              "2CO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato kilokwecha otöpnoni, kïmelö kighyongonecha tawu Tororöt kechï chïrutöch. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.3",
            "verseOrgIds": [
              "2CO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingerötyocha otete tökemitenö otöpnete pö por ompö pïröto pich amelö ompöwölo kïmökecha kechengenech portönyo nyï meghöy, wölo kïmökecha kelokwecha por nyo melö wïröy atökïnyïkwïda söpon kïyoni meghöy. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.4",
            "verseOrgIds": [
              "2CO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tororöt nyinte nyo kipï waghakatanoni akï nyinte nyo konecha Mïkulöwunyi kïlïku kikïniniogh pö tïkwïn cho tökïpkonöy cho kakïrorwecha nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.5",
            "verseOrgIds": [
              "2CO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.5",
            "verseOrgIds": [
              "2CO.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmitecha nyu kekilöy kegh kïnomnyö. Kinkïtöcha lö otini tökemitenöcha orito porete, kïtökechicha lowöch nko Echotyon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.6",
            "verseOrgIds": [
              "2CO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kïpestotocha ompö kighanat amelö ompö kirosïtagh. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.7",
            "verseOrgIds": [
              "2CO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïchicha nyökon akepïrchinecha lö tökïwuwö möngonete akepa ketïpï nko Echotyon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.8",
            "verseOrgIds": [
              "2CO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïgh nyo wow kïsïr, kï keghacha tïkwïn cho mököy nyinte ato kö ompö ngwïnyinete anta kö woptö anka.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.9",
            "verseOrgIds": [
              "2CO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
