  "verseCount": 45,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "DAN 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ompö könyi tagh nyo pö Daryas nyo pö Mede. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.1",
            "verseOrgIds": [
              "DAN.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwowunyi ye nyu man.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.2",
            "verseOrgIds": [
              "DAN.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pöyunöto Misri nko Sirya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pkonöy pöytoghï walaka cho le sömök ompö Pasya, atolapay kïrip akong nyo pö angwan nyo lïku sïkön kïtïl chane löwïr. Nyini nyu kawesit ompö sïkönötenyi kwigh pich löwïr kiporyeghö pöyunöto Krik.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.2",
            "verseOrgIds": [
              "DAN.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.2",
            "verseOrgIds": [
              "DAN.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atolapay kungwïn nyu pöytoghintö nyo awes akïpayta kor nyo wow akwigh kïrïp kegh nko machatenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.3",
            "verseOrgIds": [
              "DAN.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïchöghöy pöyunötononi kïlïkwï angwan, amelö pöytoy pöytoghï cho pö orenyi amönyorucha owesyö nyo kitïng nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.4",
            "verseOrgIds": [
              "DAN.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.4",
            "verseOrgIds": [
              "DAN.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Owesitu pöytoghinto Misri, wölo yetu wowïntö akong kïtïl nyinte akïghetu akwawesit pöyunötenyi nyoman. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.5",
            "verseOrgIds": [
              "DAN.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kiwer könyiswö cho te, kwam mis pöytoghinto Misri nko nyo pö Sirya akuyilchï cheptanyi kukïninio mis, wölo melö kitöpö misnoni nyo kogh. Kepar chepay nko kwanta",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.6",
            "verseOrgIds": [
              "DAN.11.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11:6",
              "type": "text"
            },
            {
              "text": "kwanta:",
              "type": "text"
            },
            {
              "text": "Ompö kikirut walaka cho pö köny kï, werïnyi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nko mötworichi nko pontenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.6",
            "verseOrgIds": [
              "DAN.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku nyu pöytoghin chi nyo pö ara ompö kokononi ompö osiswechoni. Poryegho lïko pöytoghinto Sirya akïlït nïyetwechay kikïtek akïrïnta chane. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.7",
            "verseOrgIds": [
              "DAN.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipöy kutang Misri tororötinekwa nko körkeyïntin cho kikipat nko kari silpa nko koltin cho pö olyot nyo wow. Töpo nyu könyis cho te amelö poryegho pöytoghinto Sirya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.8",
            "verseOrgIds": [
              "DAN.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kupokyï pöytoghinto Sirya koro Misri wölo kïrïntoy nyinte, kïmïla nyu korenyi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.9",
            "verseOrgIds": [
              "DAN.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.9",
            "verseOrgIds": [
              "DAN.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Petöy nyu werpö pöytoghinto Sirya kïporyot, ghömïtöy pipö lïk cho chang. Pkonöy akïmölöl pich le puseryon akïporyotö ntökwit nïyet cho kikïtek. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.10",
            "verseOrgIds": [
              "DAN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö nyu pöytoghinto Misri ompö nörekyö kïporyeghö pöytoghinto Sirya nyini kisïwa kungwïnöy kïghamït pikachi pö lïk cho chang, wölo kerïnta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.11",
            "verseOrgIds": [
              "DAN.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini nyu kiwany kïrïnta pïchay chang kïkwol kegh ompö rïntaghtanyi akïtas tagh kïpar pich cho makïrar, wölo melö rïntoy nyo kogh.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.12",
            "verseOrgIds": [
              "DAN.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.12",
            "verseOrgIds": [
              "DAN.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïghamït ngat pöytoghinto Sirya lïk nyo wow kïtïl nyay pö tagh. Otini kikwigh kegh lasiny ompö könyis cho te, kungwïn nyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.13",
            "verseOrgIds": [
              "DAN.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Penyöy pich cho chang osiswechoni pöytoghinto Misri, akïnget piköku cho köromöch, we Daniel kïporyeghö nyinte atökïpïntö ngala sïwïyagh, wölo kïrïntoy chane. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.14",
            "verseOrgIds": [
              "DAN.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kurik nyu pöytoghinto Sirya kanasyantanay kikïtekyï nayat akïpar, makumïcha lïko Misri ntökïporyö ata chini le nyökon. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.15",
            "verseOrgIds": [
              "DAN.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh nyu pöytoghinto Sirya kïrïp kegh nko machatenyi akimöminye chi nyo kiköngöy nyinte. Ghyongo nyinte koro Ayomis akïnömunö kegh.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.16",
            "verseOrgIds": [
              "DAN.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.16",
            "verseOrgIds": [
              "DAN.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kitat nyu pöytoghinto Sirya nko lïkenyi atökïporyö, kimach kwam mis nko punyontenyi akuyilchï cheptanyi kukïninio mis, wölo melö kimukta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.17",
            "verseOrgIds": [
              "DAN.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mi löt kïset kïpar koros cho kimi sörömu nanam akïrïnta cho chang wölo rïntoy wowïn pö lïk akuwany otöptanyi nyo gha, kïmïla nyu otöptanyi nyo gha wölo mi nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.18",
            "verseOrgIds": [
              "DAN.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï kegh nyu kanastina korenyi cho kiketek nïyet, wölo kerïnta nyinte akïlïkwï nyoni sörömunyi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.19",
            "verseOrgIds": [
              "DAN.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.19",
            "verseOrgIds": [
              "DAN.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngetu pöytoghintö anka nyo chengo pich surï atökïnyorï pöyunötenyi ororyö wölo kïpöröy nyinte ompö osis cho ngörï, melö ompö nörekyö anta poryot.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.20",
            "verseOrgIds": [
              "DAN.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pöytoghinto Sirya nyo le mwokïyon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.20",
            "verseOrgIds": [
              "DAN.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atolapay kïrïpta nyinte pöytoghintö anka nyo le mwokïyon nyo melö kimïchini kïlïkwï pöytoghin. Miröy pich akïcheng paytagh ompö lïs. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.21",
            "verseOrgIds": [
              "DAN.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pöröy nyinte söpïchis pö lïkos lömïs ata ompö nyini le Tïsin nyo Wow.* ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.22",
            "verseOrgIds": [
              "DAN.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kam mis nko punton, kïpöghisyeghö lïsut akwawesit kïrkegh kingorï pich cho kirïpöy nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.23",
            "verseOrgIds": [
              "DAN.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miru nyinte kïwetöy kor wölo le sïkön akwigh kïgh nyo kimegh papotïnechi, kïwechï kïngatar pöröw nko pikachi. Akïset kïpar kanastin cho kikïtekyï nïyet, wölo ompö osis cho ngörï.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.24",
            "verseOrgIds": [
              "DAN.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.24",
            "verseOrgIds": [
              "DAN.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atolapay kuset lïkenyi kïporyeghö pöytoghinto Misri ompö owesyö nko nyakanat, kutomtö mi kïpsach nyinte tïkwïl nko lïkenyi nyo wow, wölo kïlïsöy pöytoghinto Misri akerïnta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.25",
            "verseOrgIds": [
              "DAN.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wongöy nyinte pikachi pich cho kiruröy nyinte, kïpöröy piko lïkenyi cho chang kuwonyö lömïs. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.26",
            "verseOrgIds": [
              "DAN.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuyot pöytoghichoni kwodeny ompö mesa akonga atolapay kïlïs kegh ompöwölo ghach kinonutkökwa amöminye kinyiwutyö nyo nyoru, ompöwölo tomönye kwitïta pöroyïntanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.27",
            "verseOrgIds": [
              "DAN.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïlo nyu pöytoghinto Sirya nko pöröwechi löwïr cho kipörï, wölo kunan kïwö kïpar Kö pö Tororöt* ompö Yerusalem. Akwigh kïrïp kegh nko machatenyi atolapay kïmïla korenyi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.28",
            "verseOrgIds": [
              "DAN.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.28",
            "verseOrgIds": [
              "DAN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngwïnöy nyu ngat akïpar Misri otini ketïta asis nyo kikekïl, wölo sisitu ngala cho pö ye ompö nyinte, ompö cho kipö tagh. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.29",
            "verseOrgIds": [
              "DAN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany kupokï nyinte melino Kitim, kïmïgh nyoman akuyoda kegh nyu ompö nörekyö, akumukyï kïpar ngat pipö Tororöt akïwaghaka kïrïp ngala pich cho kipeny muma* nyo tïlil. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.30",
            "verseOrgIds": [
              "DAN.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sïmnyonöy pipö lïkenyi Kö pö Tororöt nko nïyetkö akïtagh amörostin cho kïpelöy kïnomnyö. Akutö körkeyïn nyo pö otyogh. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.31",
            "verseOrgIds": [
              "DAN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köperöy nyinte pich ompö lïs cho kipeny muma ECHOTYON, wölo ghyongo man pich cho nkït Tororötïngwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.32",
            "verseOrgIds": [
              "DAN.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akunet pich cho ngöghomöch pikökwa cho chang kïpköchï ngalechï, kïrkegh kepar walaka, akïmeghö walaka ompö ma akerang walaka kïlïkwï pïnot. Ighisyot lenyoni ompö osis cho ngörï. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.33",
            "verseOrgIds": [
              "DAN.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini nyu kimi kepöröy pipö Tororöt, kïnyorï kingörokut kite, kïpka cho chang kïrïp chane ompö lïs. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.34",
            "verseOrgIds": [
              "DAN.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Potyot nyu pïchay ngöghomöch walaka atöketïlil pich akemwat akegh chane kïrelachitu ntökwitïta asispa söröm ompöwölo tomönye kwitïta asisini kikekïl.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.35",
            "verseOrgIds": [
              "DAN.11.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.35",
            "verseOrgIds": [
              "DAN.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.36",
            "verseOrgIds": [
              "DAN.11.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.3+2TH.2.4"
              },
              "items": [
                {
                  "text": "2Ts 2:3-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.5+REV.13.6"
              },
              "items": [
                {
                  "text": "Ngo 13:5-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ighöy nyu pöytoghinto Sirya kïrïp kegh nko machatenyi. Kwolöy kegh akïsït kegh parak kïtïl tororötin löwïr. Akïtagh Tororöt pö tororötin kïngalana nyo gha. Sïkönonöy ntökwitïta asisoni, itïtoy nörekyo Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.36",
            "verseOrgIds": [
              "DAN.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möyongönye nyinte tororötino papotïnechi anta cho chömöy korï. Möyongönye tororöt anka tïkwïl ompöwölo sïtöy kegh parak nyinte kïtïl löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.37",
            "verseOrgIds": [
              "DAN.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DAN 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyïtöy nyinte tororöt nyo ripöy nïyetwo kanastin kïtïl chï löwïr. Ropchini tororöt nyo melö kinkït papotïnechi koltin nko silpa nko koghïn cho pö olyot nyo wow nko ropöw cho pö olyot. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.38",
            "verseOrgIds": [
              "DAN.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DAN 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pokyini nyinte ompö owesyo tororöt nyo le ton kanastin cho kikitek nïyet, akï konyït chane cho chömöy nyinte. Ighöy chane kïlïkwï yetïntino pich cho chang akutö koros kïlïkwï ropöwekwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.39",
            "verseOrgIds": [
              "DAN.11.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DAN 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.39",
            "verseOrgIds": [
              "DAN.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DAN 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Otini ketïta osiswo söröm kupokyï pöytoghinto Misri pöytoghinto Sirya, wölo nyu ryöpöy pöytoghinto Sirya nyinte le pïchpïch ompö nkarinechi nko pich cho pegho angoletin nko melin cho chang. Lïtu nyinte kor akïmölöl le puseryon akuwer. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.40",
            "verseOrgIds": [
              "DAN.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DAN 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itu koro Ayomis akïpar pich cho makïrar, wölo kïsöru koroswo Edom nko Moap nko koro Amon kareran. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.41",
            "verseOrgIds": [
              "DAN.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DAN 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kaset kïpar koroswechoni, kïmöchïwïtönye koro Misri, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.42",
            "verseOrgIds": [
              "DAN.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DAN 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "chengöy nyinte kaplawachtina silpa nko koltin nko tïkwïn löwïr cho pö olyot cho pö Misri akïpar Lipya nko Etopya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.43",
            "verseOrgIds": [
              "DAN.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DAN 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otyegho nyinte ngal cho pkono kongasis nko okumpö ewu löt, wölo wetöy ompö nörekyö nyo wow akïpar chane cho chang. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.44",
            "verseOrgIds": [
              "DAN.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DAN 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïparta emenichi cho pö paytagh kwenu nanam nko kutïng nyo mi Kö pö Tororöt, wölo meghöy akï möminye nyo ngöroköy nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.45",
            "verseOrgIds": [
              "DAN.11.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sörömu osis",
          "type": "text"
        }
      ]
    }
