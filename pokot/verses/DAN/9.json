  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "DAN 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipöytoy Daryas wero Aasuero nyo pö Mede koro Papilonia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.1",
            "verseOrgIds": [
              "DAN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.25.11"
              },
              "items": [
                {
                  "text": "Isa 25:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.10"
              },
              "items": [
                {
                  "text": "29:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyosomönön kitapun ompö könyi tagh nyo pö paytaghtanyi, kïpköchanïn ngala cho kimwochï Tororöt Yeremia lö, weröy könyiswö cho le 70 akïtö kï kïratyan Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.2",
            "verseOrgIds": [
              "DAN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaghan nyu Echotyon Tororöt, arirchini nyinte akïruröy, alakan sarankwachtin, atöpan aryon kuporï kötogh. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.3",
            "verseOrgIds": [
              "DAN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaghan ECHOTYON Tororötïnyu akötoy ngokï, olan, “Ichinyi, we Echotyon Tororöt awes, aichï Tororöt nyo pö konyït, nyo ikonyïtöy muma,* aiporchini chomnyengu nyo melö wonyot pich cho chöminyi akïrïpöy kirurutköku.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.4",
            "verseOrgIds": [
              "DAN.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.4",
            "verseOrgIds": [
              "DAN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kikeghacha ngokï akelel akeghacha nyo gha akepeny kirurutköku löwïr akemastecha kareran. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.5",
            "verseOrgIds": [
              "DAN.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kikïterchicha mötworiku werkoy cho kingölonchï pöytoghicha nko yetïntinecha nko papotïnecha nko piko korencha löwïr ompö kaynatengu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.6",
            "verseOrgIds": [
              "DAN.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipoyenyi man, we Echotyon, wölo acha cho kikelel akekonï arasï kïnomnyö ompö pipö Yuda nko cho pö Yerusalem nko pipö Israel löwïr cho lekïtöch nko cho lowöch cho mi koroswechini kiyonchinyi chane, ompöwölo kitagh kughaninyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.7",
            "verseOrgIds": [
              "DAN.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiketönöcha kegh arasï, we ECHOTYON, cho kakighucha nyi nko pöytoghicha nko yetïntinecha nko papotïnecha löwïr ompö ngokï. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.8",
            "verseOrgIds": [
              "DAN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itïngetenyi kisyonchin nko lastaghpa ngokï, kïrkegh kikïtaghichanyi, we Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.9",
            "verseOrgIds": [
              "DAN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kikïteracha ngaleku, we ECHOTYON Tororötïnyo, kerïp kirurutköku cho kitönönyi mötworiku werkoy. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.10",
            "verseOrgIds": [
              "DAN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïpeny pipö Israel löwïr kirurutköku akïtagh kïlïm ngaleku, kamecha ye nyu chïpötonay kikikir kirurut pö Musa mötworintengu, ompöwölo kikewuchanyi ngokï. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.11",
            "verseOrgIds": [
              "DAN.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kighanyi lenyini kimwaghanyi lö, oghwecha nko pöytoghicho, kitönönyi sitöt nyo wow Yerusalem nyo möminye sitöt nyo kimungenyi asistanka ngwïny kïmïkul, nyo lenye nyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.12",
            "verseOrgIds": [
              "DAN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipkonchecha ngalechini löwïr kikikirchï kirurut pö Musa. Wölo kïrkegh kikenyorucha sitöt, we ECHOTYON Tororötïnyo, kïmelö kikechïstecha akewöghökisyö ompö ngokï akerïp mantangu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.13",
            "verseOrgIds": [
              "DAN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, ighanyi kegh tekonecha sitöt, aikonechanyi lenyoni ompöwölo, ighenyi man kïtenö osis wölo melö kikïteruchanyi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.14",
            "verseOrgIds": [
              "DAN.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.14",
            "verseOrgIds": [
              "DAN.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“We Echotyon Tororötïnyo, kiporunyi owesyengu otini kimïtunenyi piköku koro Misri atökenonöy owesyengu nko ye. Kakighecha ngokï nko ghöyityö. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.15",
            "verseOrgIds": [
              "DAN.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "We Echotyon, yodena nörekyengu nko sïngiryengu ompö kanasyantengu Yerusalem, kutïngtöngu nyo tïlil, ompöwölo ighenyi man kïnomnyö. Kisasecha pich akïsas kanasyantengu cho kimang Yerusalem kuwitwitecha akwompö ngokicha nko cho pö papotïnecha. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.16",
            "verseOrgIds": [
              "DAN.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, we Tororötïncha tera sowutko mötworintengu nko riratenyi akwompö kaynengu. Itek kongu nyo kikinyar, ompöwölo kikïlïkwï kïratyan. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.17",
            "verseOrgIds": [
              "DAN.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Terwante we Tororötïnyu. Rosa nyörilwoköcha, airos wölo kiwongwï kanasyantengu, nyo kïkurtegho kaynengu melö kisoghecha nyi ompöwölo kïchicha pipö man, wölo ompöwölo itïngönyi kisyonchin. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.18",
            "verseOrgIds": [
              "DAN.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera, we Echotyon ailöstewecha. Tera we Echotyon, aigh, meropï akwompö kaynengu, we Tororötïnyu ompöwölo kïkurtegho kanasyante nko piköku kaynengu.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.19",
            "verseOrgIds": [
              "DAN.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kömwowï Kapïryel ngala ngorat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.19",
            "verseOrgIds": [
              "DAN.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kyomitan ongölonöy osoghöy akötoy ngokichu nko ngoki piköchan, pipö Israel, olokyan ECHOTYON Tororötïnyu, akwompö Yerusalem, kutïngtanyi nyo tïlil. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.20",
            "verseOrgIds": [
              "DAN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.19"
              },
              "items": [
                {
                  "text": "Luk 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kungwïnchanïn Kapriel, chichay kyasïwan ompö sïwïyagh kupilu le wisyan ato tenö atay kïpelöy amörostin cho pö nangat. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.21",
            "verseOrgIds": [
              "DAN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïn kïlenchanïn, “Daniel, atongongunyi ngal löwïr cho kesïwenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.22",
            "verseOrgIds": [
              "DAN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngata otini kitorönyi isagh Tororöt, kïlïm nyinte nka nyï kangwïnan amwowunyi, ompöwölo ichinyi chamat nyoman, kïlenyona tera lasiny ngalechoni pö sïwïyagh.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.23",
            "verseOrgIds": [
              "DAN.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.23",
            "verseOrgIds": [
              "DAN.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kakïmutyï piköku nko kanasyan nyo tïlil könyis 70 kïnyïl mut nko odeny atökïpïstö ngokï nko ghöyïn atökemista ngokï akegh man nyo pö kokay atökïpïntö ngala sïwïyagh nko werkoynön aketïlil Kö pö Tororöt*",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.24",
            "verseOrgIds": [
              "DAN.9.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:24",
              "type": "text"
            },
            {
              "text": "Kö pö Tororöt:",
              "type": "text"
            },
            {
              "text": "Anta ato kïpelo amöros.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nyo tïlil. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.24",
            "verseOrgIds": [
              "DAN.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona nkïtunö akïpköchin lö lïku könyis mut nko odeny kïnyïl mut nko odeny kïngata otini kakïmwowï ketek ngat Yerusalem ntökïtenö kungwïn pöytoghintö nyo kikengot. Kïteköy Yerusalem nko ortïne nko nïyetkö ompö könyis 62 kïnyïl mut nko odeny, wölo osiswo kömpölelyö choni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.25",
            "verseOrgIds": [
              "DAN.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 9:26"
          },
          "items": [
