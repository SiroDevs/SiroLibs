        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïlenyona kamwaghan ye nyu lö, ‘Pipö punton nko pich walaka cho pö kutïw cho sis cho mwoghöy Tororöt pö Syadrak nko Mesyak nko Apedneko ketörotöröy akepar korikwa kïlïkwï kïratis. Ompöwölo möminye tororöt anka nyo muköy kïsoru pich le nyï?’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.29",
            "verseOrgIds": [
              "DAN.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kutotegha pöytoghintö Syadrak nko Mesyak nko Apedneko kïlïkwï yetïntino koro Papilon.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.30",
            "verseOrgIds": [
              "DAN.3.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kirwotïtogh pö Nepukadnesa nyo pö odeny",
          "type": "text"
        }
