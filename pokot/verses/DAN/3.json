              "DAN.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Nepukadnesa, “Nya kïsala Tororöt pö Syadrak nko Mesyak nko Apedneko nyo kiyokwï malaykayantenyi kungwïn kïsörï mötworichi cho kighönöy nyinte. Kitagh ngalechan akusalta kegh, kïtïl kïpöghisyechï akïsagh tororötin walaka kïpoto Tororötïngwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.28",
            "verseOrgIds": [
              "DAN.3.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
