            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kimwatïta Pelsyasar kelokyï Daniel sïranay lata akwa lamay orus nko sïrïmnyonto koltin ompö katïnyi, kegh Daniel kïlïkwï rïpöwon nyo pö sömök ompö pöyunöt. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.29",
            "verseOrgIds": [
              "DAN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepar Pelsyasar pöytoghinto Papilonia aghononi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.30",
            "verseOrgIds": [
              "DAN.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlïkwï Daryas nyo pö pipö Mede pöytoghin. Kitïng könyis 62.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.31",
            "verseOrgIds": [
              "DAN.5.31"
            ]
          }
        }
      ]
