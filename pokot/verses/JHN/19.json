              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany kuwanta kegh choni, kïwö Yosep, chi pö kanasyanta Arimatea, wölo mi Pilato akïsom nyinte por pö Yeso atökwip. (Ki rïpana Yeso Yosep, wölo kiwïngöy kegh, ompöwölo kiwöghöy pipö Yaudi.) Kïchömchï Pilato nyinte kwip poroni, kïwö nyu Yosep akwip. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.38",
            "verseOrgIds": [
              "JHN.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.1+JHN.3.2"
              },
              "items": [
                {
                  "text": "Yna 3:1-2",
                  "type": "text"
