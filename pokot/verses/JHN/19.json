            "verseOrgIds": [
              "JHN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Pilato lö, “Möwöghökönye ngal cho kakiran.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.22",
            "verseOrgIds": [
              "JHN.19.22"
            ]
          }
        }
      ]
