      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Megha Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
