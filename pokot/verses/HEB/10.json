                  "text": "Apk 2:3-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ompöwölo mwoghöy Kikirut lö,",
          "type": "text",
