                  "text": "Tum 40:6-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nka nyoni nyu otini kingwïnöy Kristo* ngwïnyinï kilenchï Tororöt,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
