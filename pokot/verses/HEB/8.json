              "items": [
                {
                  "text": "Tum 110:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anyï nyu kïgh nyo wow nyo kïmwowunecha lö, kïtïngetecha Tïsin nyo Wow* nyo lata nyoni nyo töpuno ewu tagh nyo pö ngacharu paytaghpa Tororöt Kimuktoghin nyo mi yïm. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.1",
            "verseOrgIds": [
              "HEB.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pöghisïyi nyinte le Tïsin nyo Wow ompö Wölo Tïlil Tya,* nyoni kï orito emanoni pö man, kitek Echotyon amelö ptangengmöt.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.2",
            "verseOrgIds": [
              "HEB.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.2",
            "verseOrgIds": [
              "HEB.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkïlöy Tïsin anka tïkwïl nyo Wow atökutö Tororöt ropöw nko kyak cho kïpelchini nyinte kïlïkwï amörostin. Kïlenyoni tïkwïl ompö Tïsintencha nyo Wow, mïchini nyu kïtïng nyinte kïgh nyo roptoy. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.3",
            "verseOrgIds": [
              "HEB.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntökipö nyinte ngwïnyinete, melö kitölïku nyinte tïsin nyonikïny, ompöwölo mi tïsï wölete cho roptoy tïkwïn kïrïp kegh nko kirurut pö pipö Yaudi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.4",
            "verseOrgIds": [
              "HEB.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.40"
              },
              "items": [
                {
                  "text": "Wuw 25:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lata ighisyononi pö tïsï körkeyïn akïlata rurwö nyo pö tïpö yïm. Karkegh nko wölo kilata Musa ato kimököy kïteköy ema, kïlenchï Tororöt, “Irosïta lasiny aigh kïgh anka tïkwïl kïrïp kegh nko körkeyïnay kisöchinyi kutïng parak.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.5",
            "verseOrgIds": [
              "HEB.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kakitö ye nyu Yeso kïlïkwï tïsin nyo pö tïlat, kïlenyona kulinyö pich nko Tororöt ompö muma nyo karam tya nyo kikïteka towunöto teksyo kiyomisöto man.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.6",
            "verseOrgIds": [
              "HEB.8.6"
            ]
          }
        }
      ]
    },
    {
