                {
                  "text": "Wuw 26:31-33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kimi lötuto tote nyo pö odeny eme anka nyo kikïkuro Wölo Tïlil Tya,* ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
