            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ompöwölo kikigh ema nyo kitöpunö okumpö sany nyo kikïkurö Wölo Tïlil. Kimi ori ket pö kitömöwon nko mesa nko makatyan nyo kiporu lö mi Tororöt yete. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        },
        {
