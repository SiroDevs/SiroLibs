    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïporyeghö Daudi Pilisti ngat akïrïnta akïchenga chane kanasyanta Kat nko cho mïnkech cho kiwit. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.1",
            "verseOrgIds": [
              "1CH.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirïnta tïkwïl pipö Moap cho kilïkwï mötworichi akïkwöghchï nyinte surï.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.2",
            "verseOrgIds": [
              "1CH.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.2",
            "verseOrgIds": [
              "1CH.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirïnta tïkwïl Daudi Adadeser nyo pö Sirya pöytoghinto Sopa, ompö ato lekïto Amat ato kirich kïnyorï owesyö lalwa Yuparet. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.3",
            "verseOrgIds": [
              "1CH.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnam Daudi nkaritinechi cho le 1,000 nko pipö angoletin cho le 7,000 nko pipö lïk cho pegho kelyön cho le 20,000. Kïtörotör Daudi angoletine chepkintolay cho kichutöy nkaritin, kïpoto cho le 100 cho pö nkaritin cho kipïstö.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.4",
            "verseOrgIds": [
              "1CH.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.4",
            "verseOrgIds": [
              "1CH.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta pipö Sirya cho pö Damaska pipö lïk kïpa kungarak Adadeser pöytoghinto Sopa, kïpar Daudi cho le 22,000. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.5",
            "verseOrgIds": [
              "1CH.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïtek Daudi kampi lïk kanasyanta Sirya nyo pö Damaska, kïlïkwï pipö Sirya mötwori Daudi akïkwöghchï Surï. Kutö ECHOTYON Daudi rïntagh ompö wop anka tïkwïl wölo kiwö poryot. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.6",
            "verseOrgIds": [
              "1CH.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcheng Daudi longoy pö koltin cho kipöy mötwor Adadeser akwip Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.7",
            "verseOrgIds": [
              "1CH.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.40+1KI.7.41+1KI.7.42+1KI.7.43+1KI.7.44+1KI.7.45+1KI.7.46+1KI.7.47"
              },
              "items": [
                {
                  "text": "1Pöy 7:40-47",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.11+2CH.4.12+2CH.4.13+2CH.4.14+2CH.4.15+2CH.4.16+2CH.4.17+2CH.4.18"
              },
              "items": [
                {
                  "text": "2Ot 4:11-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwipunö Daudi kari tayoy cho chang Tipat nko Kun kanastina Adadeser. (Kigha Solomon tïkuchi ato le löt, töro pögh nko pchörin nko kari tayoy.)",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.8",
            "verseOrgIds": [
              "1CH.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.8",
            "verseOrgIds": [
              "1CH.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kilïm Toy pöytoghinto Amat lö karïnta Daudi pipö lïk löwïr cho pö Adadeser, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.9",
            "verseOrgIds": [
              "1CH.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïyonta werïnyi Yoram wölo mi Daudi kutakwes nyinte akuyokyï sörö ompöwölo karïnta Adadeser nyo köporyot nko nyinte su ngat. Kwipchï Yoram Daudi tïkwïn cho kikigh koltin nko silpa nko tayoy. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.10",
            "verseOrgIds": [
              "1CH.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcheng Daudi tïkuchï akutötö tökepöghisyeghö ompö saghat kïmi nko silpa nko koltin chay kichenga puntonichay kirïnta pö: Edom nko Moap nko Amon nko Pilisti nko Amalek.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.11",
            "verseOrgIds": [
              "1CH.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.11",
            "verseOrgIds": [
              "1CH.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrïnta Apisyay nyo kile yonyi Seruya pipö Edom akïpar cho le 18,000 ompö mpöghoghyo Paryan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
            "verseOrgIds": [
              "1CH.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtek Daudi möngenyi pö lïk kuwit Edom akïlïkwï pipö Edom mötworichi, kutö Echotyo nyinte rïntagh ompö wop anka tïkwïl wölo kiwö poryot.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpayta Daudi koro Israel kïmïkul akurwokyï pikachi ompö man. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.14",
            "verseOrgIds": [
              "1CH.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apisyay werto ompö Yoap, wero Seruya nyo kile yetïn pö lïk, Yeosyapat wero Ailud nyo kile komöninto tïkwïn. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.15",
            "verseOrgIds": [
              "1CH.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sadok wero Aitup nko Aimelek wero Apyatar cho kile tïsï, kï kikirinte Seraya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.16",
            "verseOrgIds": [
              "1CH.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Penaya wero Yeoyada nyo kighyongtoy pipö Keret nko Pelet, kïcheng werpö Daudi ngöcher cho echön ompö paytaghtanyi. Naya wero Yeoyada nyo kighyongtoy pipö Keret nko Pelet, kïcheng werpö Daudi ngöcher cho echön ompö paytaghtanyi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.17",
            "verseOrgIds": [
              "1CH.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Karïnta Daudi pipö Amon nko pipö Sirya",
          "type": "text"
        }
      ]
    }
