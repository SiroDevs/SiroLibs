          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimang kanastine walaka tïkwïl cho mïnkech: Etam nko Ayin nko Rimon nko Token nko Asyan ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.32",
