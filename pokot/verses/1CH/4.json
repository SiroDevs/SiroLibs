          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwï kutang ta, ato lekïto Kedor, kongasispa mpöghogh kïyarata wölo oketïyi kyakikwa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.39",
