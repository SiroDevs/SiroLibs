              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïnyorï chane wölo karam wölo oketïyi kyakï, kor nyo pöro akimi kalya nko payasat pich cho kimöngöy wöloni ato le tagh kï pipö Am.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.40",
