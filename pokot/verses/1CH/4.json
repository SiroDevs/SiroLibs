              "type": "text"
            }
          ]
        },
        {
          "text": "nko Pet Markapot nko Asarsusim nko Petpiri nko Syaaraim. Ki kanastinekwa choni ntökïtenö paytaghpa Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.31",
