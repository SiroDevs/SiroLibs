  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "1CH 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipchï Onyötö pipö Israel kömpölelyö, kïlenyona kwigh Daudi kuyit pipö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.1",
            "verseOrgIds": [
              "1CH.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï Daudi Yoap nko yetïntin walaka lö, “Ape oghömunö koro Israel kïngata söröm ntökwit sörömu anka ayit pich löwïr, atonkïtwan lö tya chane.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.2",
            "verseOrgIds": [
              "1CH.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.2",
            "verseOrgIds": [
              "1CH.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yoap pöytoghin, “Nya kïtas ECHOTYON pipö Israel kïnyïl 100 ompö chongïn kïtïl ye! Cheku pïchï löwïr we pöytoghin. Wölo ompö ne temökenyi yite chane aipchï lelut Israel löwïr.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.3",
            "verseOrgIds": [
              "1CH.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kwigh pöytoghintö Yoap kwigh lenyini kamwa nyinte, kïwö nyu Yoap kïghömï koro Israel akïmïla Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.4",
            "verseOrgIds": [
              "1CH.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwipchï Yoap pöytoghin Daudi kaynötut pö pich cho kimuköy poryot: pipö Israel cho le 1,100,000 nko cho pö Yuda 470,000. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.5",
            "verseOrgIds": [
              "1CH.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimeyitnye Yoap pipö ara Lawi nko ara Penchamen ompöwölo melö kicham nyinte ngala Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.6",
            "verseOrgIds": [
              "1CH.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.6",
            "verseOrgIds": [
              "1CH.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimangaraknye Tororöt ompö ngalechoni, kïlenyona kutö sitöt pipö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.7",
            "verseOrgIds": [
              "1CH.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi ECHOTYON, “Kaghan lelut nyo wow ompö kïyï kaghan wölo osoghinyi we ECHOTYON lö sölwontön.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.8",
            "verseOrgIds": [
              "1CH.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.8",
            "verseOrgIds": [
              "1CH.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Kad nyo le werkoyonto Daudi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.9",
            "verseOrgIds": [
              "1CH.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wïyö mwochinö Daudi lö otöninan nyinte tïkwïn sömök kïkïl, oghan nyo kakïl nyinte.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.10",
            "verseOrgIds": [
              "1CH.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.10",
            "verseOrgIds": [
              "1CH.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Kad wölo mi Daudi akïmwochï ngalechay kamwa ECHOTYON, kïtep nyinte lö, “Nyono nyo imökenyi? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.11",
            "verseOrgIds": [
              "1CH.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömöy nyo pö könyis sömök ompö korengu nya anta rïpenönyi tawu punköku ompö aro sömök anta parakwa ECHOTYON akuyokwï sömew nyo pö osis sömök ompö korengu akïpöghisyeghö malaykayan kwipï meghat kïghömï Israel? Omwochinan ne ECHOTYON?”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.12",
            "verseOrgIds": [
              "1CH.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.12",
            "verseOrgIds": [
              "1CH.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi Kad, “Omitan ato kampalal! Wölo mochömanye kïkonanïn ptangengmöt sitöt. Nya kïkonanïn ECHOTYON sitöt, ompöwölo tïng kisyonchin.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.13",
            "verseOrgIds": [
              "1CH.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.13",
            "verseOrgIds": [
              "1CH.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö ECHOTYON sömewe pipö Israel kïmeghö cho le 70,000. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.14",
            "verseOrgIds": [
              "1CH.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta ECHOTYON malaykayan kunyar Yerusalem, wölo kïwaghach kinonsyewutkachi akïlenchï malaykayantanay, “Pïstenö kikïmïchï.” Kimi malaykayantanay atoni atolekïtö ghatya Arauna nyo pö pipö Yepusin.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.15",
            "verseOrgIds": [
              "1CH.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.15",
            "verseOrgIds": [
              "1CH.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïwa Daudi malaykayan nyo kighyongo mïröt akitïng chok ompö ewunyi, kimi psach kunyar Yerusalem. Kïkïtïng Daudi ntökwit tokochunyi ngwïny kïmi nko kintöghoghï cho kiloköy sarankwachtin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.16",
            "verseOrgIds": [
              "1CH.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsagh Daudi ECHOTYON lö, “We Tororöt, ani nyo kaghan ngokï amwatïta keyit pich. Ne kitö nyu nyo gha nyo kegh pïchï? Nya kïlïkwï nyinyan site nko katanyan.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.17",
            "verseOrgIds": [
              "1CH.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.17",
            "verseOrgIds": [
              "1CH.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï malaykayanta ECHOTYON Kad, mwochinö Daudi kïtekyï ECHOTYON atay kïpelö Amöros ompö ghatya Arauna. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.18",
            "verseOrgIds": [
              "1CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiter Daudi ngölyonto ECHOTYON akïwö le ato kömwochï Kad. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.19",
            "verseOrgIds": [
              "1CH.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi Arauna nko werkachi angwan kïtïghöy nkanun ompö ghatyanoni, nyini kisïwa chane malaykayan, kïryögh werkachi kïpa kïwïng kegh. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.20",
            "verseOrgIds": [
              "1CH.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïwa Arauna pöytoghin Daudi kungwïnöy ghatyanay akïwö kïkïtïngchï Daudi ompö konyït ntökïswany tokochunyi ngwïny. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.21",
            "verseOrgIds": [
              "1CH.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi nyinte, “Olwante ghatyengu, atotekyan ECHOTYON ato kïpelö Amöros atökïngeta pich sömewö. Olan lenyini imökenyi.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.22",
            "verseOrgIds": [
              "1CH.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.22",
            "verseOrgIds": [
              "1CH.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Arauna, “Chenga we pöytoghin, aigh le wölo keda, achï eghin cho pö amöros nyo kïpelöy nko ketichï kinyertoy cho lïku kwenka nko nkanune cho kïroptoy. Okoninyi löwïr.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.23",
            "verseOrgIds": [
              "1CH.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.23",
            "verseOrgIds": [
              "1CH.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlö pöytoghintö, “Melö lenye nyona oghokunyi löwïr. Melö otönan ECHOTYON ropöwon ompö kïgh nyo le nyengu, nyo melö kalan.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.24",
            "verseOrgIds": [
              "1CH.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïghokyï Daudi Arauna ropïyeni koltin cho le 600 cho pö ghatyanay kinyertoy. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.25",
            "verseOrgIds": [
              "1CH.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtekyï Daudi ECHOTYON atay kïpelö Amöros ompö atoni akutötö Amöros nyo kïpelöy nko nyo pö pöghisyö. Kïsagh ECHOTYON, kïterchï nyinte ECHOTYON sowutkachi akuyokwï ma kungwïna yïm nyo kipel Amörostinechay kimi atay kïpelo Amöros.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
