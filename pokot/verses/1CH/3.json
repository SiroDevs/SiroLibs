              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chï kï monïngo Daudi cho kikïyichï Epron kïrïp kegh nko yiyengwa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1+1CH.3.2+1CH.3.3",
            "verseOrgIds": [
              "1CH.3.1",
              "1CH.3.2",
              "1CH.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Monïngo Solomon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.9",
            "verseOrgIds": [
              "1CH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monïngo Solomon kï: Reopoam nko Apiya nko Asa nko Yeosyapat, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.10",
            "verseOrgIds": [
              "1CH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Yoram nko Aasia nko Yoas. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.11",
            "verseOrgIds": [
              "1CH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nko Amasya nko Asaria nko Yotam ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.12",
            "verseOrgIds": [
              "1CH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Aas nko Esekia nko Manase, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.13",
            "verseOrgIds": [
              "1CH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Amon nko Yosia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.14",
            "verseOrgIds": [
              "1CH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werpö Yosia kï: Yoanan nyo le poretye nko Yeoyakim nko Sedekia nko Yoaas. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.15",
            "verseOrgIds": [
              "1CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Yeoyakim wor odeny, Yekonia nko Sedekia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.16",
            "verseOrgIds": [
              "1CH.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Monïngo Yekonia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.16",
            "verseOrgIds": [
              "1CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chï kï werpö pöytoghin Yekonia nyo kinam pipö Papilon kïlïkwï mötworin cho le mut nko odeny, Syealtiel ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.17",
            "verseOrgIds": [
              "1CH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Makiram nko Pedaya nko Syenasar nko Yekamia nko Osyama nko Nedapia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.18",
            "verseOrgIds": [
              "1CH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werpö Pedaya kï: Serupapel nko Syimey, werpö Serupapel kï: Mesyulam nko Anania nko cheptöngwa Syelomit. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.19",
            "verseOrgIds": [
              "1CH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng wor walaka cho le mut: Asyupa nko Owel nko Perekia nko Asadia nko Yusyapesed. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.20",
            "verseOrgIds": [
              "1CH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werpö Anania kï: Pelatia nko Yesyaya. Yesyaya kï papoto Repaya, papoto Arnan, papoto Opadia, papoto Syekania. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.21",
            "verseOrgIds": [
              "1CH.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Syekania werïnyi akonga nyo kikïkuro Syemaya, nyo kitïng werkachi mut: Atus nko Ikal nko Paria nko Nearia nko Syapat. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.22",
            "verseOrgIds": [
              "1CH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Nearia wor sömök: Elioenai nko Iskia nko Asrikam. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.23",
            "verseOrgIds": [
              "1CH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Elioenai wor mut nko odeny: Odapia nko Elyasyip nko Pelaya nko Akup nko Yoanan nko Delaya nko Anani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.24",
            "verseOrgIds": [
              "1CH.3.24"
            ]
          }
        }
      ]
    },
    {
