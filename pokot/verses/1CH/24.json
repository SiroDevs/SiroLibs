          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chï kï söpïch pö monïngo Aron kitïng Aron wor angwan: Nadap nko Apiu nko Eleasar nko Itamar. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.1",
            "verseOrgIds": [
              "1CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.5+NUM.3.6+NUM.3.7+NUM.3.8+NUM.3.9"
              },
              "items": [
                {
                  "text": "Kiy 3:5-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirapas Nadap nko Apiu kïtomö papongwa akimötïngnye chane monïng, kïlenyona kilïkwï tïsï Eleasar nko Itamar. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.2",
            "verseOrgIds": [
              "1CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitat Daudi monïngo Aron kïpeghategha söpïchis kïrïp kegh nko ighisyewutkökwa. Kingarak nyinte Sadok nyo pö ara Eleasar nko Aimelek nyo pö ara Itamar. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.3",
            "verseOrgIds": [
              "1CH.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïtat monïngo Eleasar ompö söpïchis 16, ketat cho pö Itamar ompö söpïchis mut nko sömök, kikigh lenyoni ompöwölo kichang monïngö cho le wor ompö kori monïngo Eleasar cho kile kintöghoghï. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.4",
            "verseOrgIds": [
              "1CH.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kimito kwenu monïngo Eleasar nko Itamar yetïntino Kö pö Tororöt* nko cho netisïyi, kïlenyona kikïchöghchï chane ighisyewutkökwa ompö pkiryot. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.5",
            "verseOrgIds": [
              "1CH.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukir chane kikirin Syemaya wero Netanel nyo pö pipö Lawi kïsïwïyi pöytoghintö nko yetïntin nko tïsin Sadok nko Aimelek wero Apyatar nko yetïntino kori ara tïsï nko pipö Lawi. Kikir kö pö chi akonga nyo ngwïno ara Eleasar nko anka nyo ngwïno ara Itamar ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.6",
            "verseOrgIds": [
              "1CH.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lata nyï wölo kikïtatïta ighisyewut pö söpïchis pö ortïn 24:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.7+1CH.24.8+1CH.24.9+1CH.24.10+1CH.24.11+1CH.24.12+1CH.24.13+1CH.24.14+1CH.24.15+1CH.24.16+1CH.24.17+1CH.24.18",
            "verseOrgIds": [
              "1CH.24.7",
              "1CH.24.8",
              "1CH.24.9",
              "1CH.24.10",
              "1CH.24.11",
              "1CH.24.12",
              "1CH.24.13",
              "1CH.24.14",
              "1CH.24.15",
              "1CH.24.16",
              "1CH.24.17",
              "1CH.24.18"
            ]
          }
        }
      ]
    },
