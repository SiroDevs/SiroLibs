            "number": "28",
            "style": "v",
            "sid": "1CH 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Mali wor odeny: Eleasar nko Kis. Akimötïngnye Eleasar wor wölo kitïng Kis weri akonga nyo kikïkuro Yeramel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.28+1CH.24.29",
            "verseOrgIds": [
              "1CH.24.28",
              "1CH.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Musyi wor sömök, Mali nko Eder nko Yerimot.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.30",
            "verseOrgIds": [
              "1CH.24.30"
            ]
          }
        }
      ]
