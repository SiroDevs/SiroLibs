          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikikir pïchï kïrïp kegh nko ighisyewutkökwa cho kighöy ompö Kö pö Tororöt, cho kitowï kukötöngwa Aron lenyini kimwochï ECHOTYON Tororöt pö Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        }
