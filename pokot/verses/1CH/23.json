        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chane cho kiripöy Ema nyo mi ECHOTYON nko Kö pö Tororöt akungarak monïngo tïsï cho pö ara Aron nko werkökwa ompö Kö pö Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
