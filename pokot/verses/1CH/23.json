              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïl Daudi werïnyi Solomon kïlïkwï pöytoghinto Israel otini kiyosit nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.1",
            "verseOrgIds": [
              "1CH.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ighisyo pipö Lawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.1",
            "verseOrgIds": [
              "1CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutuyö Daudi kintöghoghi Israel löwïr nko tïsï nko pipö Lawi löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.2",
            "verseOrgIds": [
              "1CH.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyit pipö Lawi löwïr cho le mïrön cho kitïng könyis tömönut sömök kutok, kïlïkwï chane löwïr 38,000. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.3",
            "verseOrgIds": [
              "1CH.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö Daudi cho le 24,000 kwigh ighisyö ompö Kö pö Tororöt,* kïlïkwï cho le 6,000 yetïntin nko kirwokï. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.4",
            "verseOrgIds": [
              "1CH.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïripsyö cho le 4,000, kïtumchï ECHOTYON cho le 4,000 akïpöghisyegho kari tumöt cho kikonï pöytoghintö ompö ighisyononi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.5",
            "verseOrgIds": [
              "1CH.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.5",
            "verseOrgIds": [
              "1CH.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichagh Daudi pipö Lawi kïlïkwï söpïchis sömök, kïrïp kegh nko monekwa: Kersyon nko Koat nko Merari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.6",
            "verseOrgIds": [
              "1CH.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.6",
            "verseOrgIds": [
              "1CH.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Kersyon werko odeny: Ladan nko Syimey. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.7",
            "verseOrgIds": [
              "1CH.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Ladan wor sömök: Yeiel nko Setam nko Yoel, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.8",
            "verseOrgIds": [
              "1CH.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "cho kile kintöghoghi ortïnekwa. Kitïng Syimey wor sömök: Syelomot nko Asiel nko Aran akï chane cho kile kintöghoghi ortïna ara Ladan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.9",
            "verseOrgIds": [
              "1CH.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Syimey wor angwan: Yaat nko Sina nko Yeus nko Peria kïrïp kegh nko könyiswekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.10",
            "verseOrgIds": [
              "1CH.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki wow Yaat ompö chane aki nyo kirïpöy nyinte kï Sisa. Wölo kimötïngnye Yeus nko Peria monïng cho chang, kïlenyona kikiyit chane le or akonga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.11",
            "verseOrgIds": [
              "1CH.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.11",
            "verseOrgIds": [
              "1CH.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Koat wor angwan: Amram nko Isar nko Epron nko Usiel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.12",
            "verseOrgIds": [
              "1CH.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.1"
              },
              "items": [
                {
                  "text": "Wuw 28:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitïng Amram wor odeny: Musa nko Aron, kikïkïl Aron nko monechi kïrip karïn cho tïlilöch kokay akïpel tïkwïn cho ngutoy cho onyïn ato kïsoghöy ECHOTYON akïpöghisyechï nyinte, akusoyön pich ompö kaynenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.13",
            "verseOrgIds": [
              "1CH.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikiyit monïngo Musa nyo le chi pö Tororöt nko cho pö pipö Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.14",
            "verseOrgIds": [
              "1CH.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Musa wor odeny: Kersyom nko Elieser. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.15",
            "verseOrgIds": [
              "1CH.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kintöghoghchini Syepuel werpö Kersyom. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.16",
            "verseOrgIds": [
              "1CH.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Elieser weri akonga nyo kikïkuro Reapia akitïng Rapia monïng cho chang.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.17",
            "verseOrgIds": [
              "1CH.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.17",
            "verseOrgIds": [
              "1CH.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Isar wero Koat nyo pö odeny weri akonga, Syelomit nyo kile kintöghoghinto arengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.18",
            "verseOrgIds": [
              "1CH.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Epron wero Koat nyo pö sömök wor angwan: Yeria nko Amaria nko Yaasiel nko Yekameam. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.19",
            "verseOrgIds": [
              "1CH.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Usiel wero Koat nyo pö angwan wor odeny: Mika nko Isyia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.20",
            "verseOrgIds": [
              "1CH.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.20",
            "verseOrgIds": [
              "1CH.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Merari wor odeny: Mali nko Musyi. Kitïng Mali wor odeny: Eleasar nko Kis, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.21",
            "verseOrgIds": [
              "1CH.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "wölo kirapas Eleasar kïmötïng wor kïpoto tipïn. Kip werpö Kis tipichoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.22",
            "verseOrgIds": [
              "1CH.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtïng Musyi wor sömök, Mali nko Eder nko Yeremot.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.23",
            "verseOrgIds": [
              "1CH.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.23",
            "verseOrgIds": [
              "1CH.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chete kï monïngo pipö Lawi cho kikikir ompö kaynötut kïrïp kegh nko ortïnekwa nko korikwa, cho kitïng könyis tömönut odeny kutok, atökwigh ighisyö ompö Kö pö ECHOTYON Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.24",
            "verseOrgIds": [
              "1CH.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
