              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Daudi, “Kikutö ye nyu ECHOTYON Tororöt pö Israel pikachi Kalya, akïmöngöy nyinte Yerusalem kokay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.25",
            "verseOrgIds": [
              "1CH.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.8"
              },
              "items": [
                {
                  "text": "Krt 10:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mökïminye machata ye kïsïtsetö pipö Lawi Ema nyo mi ECHOTYON* nko tïkwïn cho kïpöghisyegho ompö saghat.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.26",
            "verseOrgIds": [
              "1CH.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwa Daudi ompö ngalechi cho pö söröm lö, kiyitöy pipö Lawi cho tïng könyis tömönut odeny kutok ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.27",
            "verseOrgIds": [
              "1CH.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
