              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.5+NUM.3.6+NUM.3.7+NUM.3.8+NUM.3.9"
              },
              "items": [
                {
                  "text": "Kiy 3:5-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "aketö chane ighisyewutchï: kungarak tïsï cho pö ara Aron ompö saghat ompö Kö pö Tororöt akïrip kirorye nko kori akuwun tïkwïn cho tïlilöch ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïrip makatyan nyo kïropchini Tororöt nko pïsye nko makateni cho mïnkech cho puryö mumar nko ropöw cho kakïchïl nko pïsya cho kakinyornyoryö nko mwaghpa arol, kuyit akupim ropöwo Kö pö Tororöt, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.29",
            "verseOrgIds": [
              "1CH.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuyokyï sörö akïkwol ECHOTYON tökwoghö nko mönon ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.30",
            "verseOrgIds": [
              "1CH.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko ato kïpelöy ropöwo ECHOTYON ompö Sapato* nko Ichon pö Relïn pö Arawa nko ichontin walaka, kïrïp kegh nko chini machate chik ompö ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.31",
            "verseOrgIds": [
