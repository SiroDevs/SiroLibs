        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.23+1CH.12.24+1CH.12.25+1CH.12.26+1CH.12.27+1CH.12.28+1CH.12.29+1CH.12.30+1CH.12.31+1CH.12.32+1CH.12.33+1CH.12.34+1CH.12.35+1CH.12.36+1CH.12.37",
            "verseOrgIds": [
              "1CH.12.23",
              "1CH.12.24",
              "1CH.12.25",
              "1CH.12.26",
              "1CH.12.27",
              "1CH.12.28",
              "1CH.12.29",
              "1CH.12.30",
              "1CH.12.31",
              "1CH.12.32",
              "1CH.12.33",
              "1CH.12.34",
              "1CH.12.35",
              "1CH.12.36",
              "1CH.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipa pïchï pö lïk löwïr Epron, akimi kïpsach kïporyö, ki machatengwa kwigh Daudi kïpayta Israel kïmïkul. Akirïp pipö Israel löwïr ngalekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.38",
            "verseOrgIds": [
              "1CH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimpur chane wöloni nko Daudi ompö osis sömök, kyomisïyi akïgheghsïyi, ompöwölo kökikwighchï werkökwa omisyö. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.39",
            "verseOrgIds": [
              "1CH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipka tïkwïl pöröriskökwa cho pö Isakar nko Saplon nko Naptali, akïrongwï sïkïröy nko tamasay nko nyumpun* nko eghin cho kikösönu pïsya nko makany nko sapipun cho kikiyam nko dipay* nko mwaghpa arol nko tïch nko kechir cho kyomöy. Ompöwölo kimi ngörekyo Israel kïmïkul.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.40",
            "verseOrgIds": [
              "1CH.12.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakiwï Santuku Muma* ompö Kiriat Yearim",
          "type": "text"
        }
      ]
    }
  ],
