      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipa pich walaka cho owesöch cho kingarak Daudi ompö poryot wölo kimi nyinte ompö Siklak, wölo kiwö kïwïnchï kegh akwompö pöytoghin Saulö, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.1",
            "verseOrgIds": [
              "1CH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "pich cho kipö ara Penchamen, tïlyayi Saulö. Kiwutïtoy chane kotï akïwirtegho koghïn porköy ompö ewune kwodeny. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.2",
            "verseOrgIds": [
              "1CH.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kintöghoghintengwa kï Aieser nko Yoas, chane kwodeny kï werpö Syema nyo pö Kipea. Chï kï piko lïk:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.3+1CH.12.4+1CH.12.5+1CH.12.6+1CH.12.7",
            "verseOrgIds": [
              "1CH.12.3",
              "1CH.12.4",
              "1CH.12.5",
              "1CH.12.6",
              "1CH.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rïpanpa Daudi cho pö ara Kad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.3+1CH.12.4+1CH.12.5+1CH.12.6+1CH.12.7",
            "verseOrgIds": [
              "1CH.12.3",
              "1CH.12.4",
              "1CH.12.5",
              "1CH.12.6",
              "1CH.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chï kï pich cho owesöch cho pö ara Kad cho kipa wölo kimi Daudi ompö surkwen, pich cho kinkït kïpöghisyegho longoy nko ngötwö akï lata owesyengwa nyo pö ngötuny aki lata korinyoy. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.8",
            "verseOrgIds": [
              "1CH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chane chï: Eser nko Opadia nko Elyap ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.9",
            "verseOrgIds": [
              "1CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Mismana nko Yeremia ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.10",
            "verseOrgIds": [
              "1CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Atai nko Eliel ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.11",
            "verseOrgIds": [
              "1CH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Yoanan nko Elsapad ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.12",
            "verseOrgIds": [
              "1CH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Yeremia nko Makpanai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.13",
            "verseOrgIds": [
              "1CH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pïchete pö ara Kad kï yetïntin cho ghyongchini pich 1,000 nko cho mïnkech cho ghyongchini pich pokol. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.14",
            "verseOrgIds": [
              "1CH.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chane cho kyoghyö lalwa Yordan arawa tagh otini kitö kuyintoy kunyalta akutoyö pich cho kimi mpöghogh okumpö kongasis nko okumpö ta.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rïpanpa Daudi cho pö ara Penchamen nko Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa pikö walaka cho pö ara Penchamen nko Yuda wölo kimi Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.16",
            "verseOrgIds": [
              "1CH.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Daudi kïtarok chane akïlenchï, “Ato kapkanakwa le kongot angarakanïn, kï ochikwa tokote, wölo ato kapkanakwa atö olchanïn pungköchan, kïrökegh motïngetanye ghöyityö nko akwa, akany nyu kïlïkwï Tororöt pö papotïnecho nyo rosu choni akï konok sitöt.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.17",
            "verseOrgIds": [
              "1CH.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.17",
            "verseOrgIds": [
              "1CH.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngölonchï mïkulögh Amasay nyo kile kintöghoghinto pïchay le tömönut sömök, kïlö,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rïpanpa Daudi cho pö ara Manase",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa pipö Manase walaka kutang wölo mi Daudi otini kingwïnöy nko Pilisti atökïporyeghö Saulö. Wölo melö kingarak nyinte Pilisti, ompöwölo kiwagh pöytoghi Pilisti akïlö, “Töptoy muköy ntökïwaghaka akungarak Saulö yetïntanyi.” Kïlenyona kuyoda nyinte kïwö Siklak. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.19",
            "verseOrgIds": [
              "1CH.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chï kï pipö ara Manase cho kipa wölo mi Daudi otini kimïlo: Adna nko Yosapad nko Yediael nko Mikael nko Yosapad nko Eliu nko Siletay, ki kintöghoghï chane cho pö pich 1,000 ompö ara Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.20",
            "verseOrgIds": [
              "1CH.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kintöghoghchï chane pipö lïko Daudi, ompöwölo ki pipö lïk chane cho le nyökon. Ki lïkwï chane ato le lötï yetïntino pipö lïk cho pö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.21",
            "verseOrgIds": [
              "1CH.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitösisyö pich chik cho kingarak Daudi, ntökwawesit lïkenyi tya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.22",
            "verseOrgIds": [
              "1CH.12.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lïko Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.22",
            "verseOrgIds": [
              "1CH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chï kï kiyitut pö pipö lïk cho kipka wölo mi Daudi ompö Epron, atökïwaghach paytaghpa Saulö akutö Daudi kïle ato kimwa ECHOTYON:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.23+1CH.12.24+1CH.12.25+1CH.12.26+1CH.12.27+1CH.12.28+1CH.12.29+1CH.12.30+1CH.12.31+1CH.12.32+1CH.12.33+1CH.12.34+1CH.12.35+1CH.12.36+1CH.12.37",
            "verseOrgIds": [
              "1CH.12.23",
              "1CH.12.24",
              "1CH.12.25",
              "1CH.12.26",
              "1CH.12.27",
              "1CH.12.28",
              "1CH.12.29",
              "1CH.12.30",
              "1CH.12.31",
              "1CH.12.32",
              "1CH.12.33",
              "1CH.12.34",
              "1CH.12.35",
              "1CH.12.36",
              "1CH.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
