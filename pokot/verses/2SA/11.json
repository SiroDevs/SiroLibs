              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi chichay, “Ichïchim Yoap ailenchï, ‘Mesus kegh ompö ngölyontonï, ompöwölo menkïtunye chi lö ngo nyo meghöy ompö poryot, kilö kegh ainoghyö ntenam kanasyante.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.25",
            "verseOrgIds": [
              "2SA.11.25"
            ]
          }
        }
