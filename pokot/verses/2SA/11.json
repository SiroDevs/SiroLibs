            "sid": "2SA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.1",
            "verseOrgIds": [
              "2SA.11.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.20.1"
              },
              "items": [
                {
                  "text": "1Ot 20:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikany ato kile towunöto köny, ato kisetöy pöytoghï, kïyonta Daudi Yoap nko mötworichi nko lïko Israel kïpa kïpar pipö Amon, akurich kanasyanta Rapa. Wölo kimpur Daudi Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.1",
            "verseOrgIds": [
              "2SA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.1",
            "verseOrgIds": [
              "2SA.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngeta Daudi kö nyo kimungo ato kile mönon akïwesteghö konyi wölo le parak, kïsïwa korka nyo pïchigh nyo kiwunöy kegh. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.2",
            "verseOrgIds": [
              "2SA.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Daudi lö, “Ki Ngo kokononi?” Kïlö chi, “Patsyepa nyoni chepö Eliyam koko Uriya nyay pö pipö Ititi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.3",
            "verseOrgIds": [
              "2SA.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta Daudi pich kïpa kumïtï wölo mi nyinte, kïrï tïkwïl. (Kökikuwonyö osiswo kokonini cho kitöpo yona.) Atolapay kïmïla kokonay konyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.4",
            "verseOrgIds": [
              "2SA.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomönye kite kïsöwï kokonay lö kyosïkisyö, kïmwatïta kemwochï Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.5",
            "verseOrgIds": [
              "2SA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.5",
            "verseOrgIds": [
              "2SA.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyoktö Daudi chi wölo kimi Yoap akïlenchï, “Yonunö Uriya nyay pö pipö Ititi kungwïn wölo omitan.” Kïyonta Yoap Uriya wölo mi Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.6",
            "verseOrgIds": [
              "2SA.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kit Uriya, kïtep Daudi pöghisyö nyo pö Yoap nko nyo pö pich nko wölo kilata poryot. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.7",
            "verseOrgIds": [
              "2SA.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi Uriya, “Wïyö tanga katangu aimungchï kegh.” Kïweghö Uriya kö pö pöytoghin, kuyoktö pöytoghintö chi kwipchï nyinte omisyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.8",
            "verseOrgIds": [
              "2SA.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïrï Uriya wölo kiruyot mötwori echotyontenyi ompö kuka pöytoghin amöwönye kutang katanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.9",
            "verseOrgIds": [
              "2SA.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kemwochï Daudi lö, “Möwönye Uriya katanyi.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.10",
            "verseOrgIds": [
              "2SA.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Daudi Uriya lö, “Olentan kengwïnenyi rutogh? Ompö ne tömewenyi katangu?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.10",
            "verseOrgIds": [
              "2SA.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.10",
            "verseOrgIds": [
              "2SA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Uriya Daudi, “Mi pipö Israel nko Yuda kïporyot akïmito nko Santuku Muma.* Kïmito echotyontenyan Yoap nko mötwori echotyontenyan pöytoghin kïmöngöy wölnö mi poryot, owetan nyu lö ne katanyan omisïyi agheghsyö arï nko korkenyu? Momukanye ntagh kïgh nyo lata nyoni kokay.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.11",
            "verseOrgIds": [
              "2SA.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.11",
            "verseOrgIds": [
              "2SA.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi Uriya, “Töpenö wölete asete atewïyö asïyech.” Kïtöpö Uriya Yerusalem asisoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.12",
            "verseOrgIds": [
              "2SA.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtak Daudi nyinte asisto odeny kwomisyö tïkwïl akïgheghsyö nko nyinte, kïkany kïtamas nyinte tya, ato mi mönon kïwö kïrï ngat wölo mi mötwori echotyontenyi, mökïwönye katanyi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.13",
            "verseOrgIds": [
              "2SA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.13",
            "verseOrgIds": [
              "2SA.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukirchï Daudi palalyan Yoap tökwoghö akutö Uriya kwip. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.14",
            "verseOrgIds": [
              "2SA.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukir ompö palalyantanay lö, “Tönö Uriya tagh wölo ngwan poryot, amïlisyö löt cho le akwa atökepar nyinte.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.15",
            "verseOrgIds": [
              "2SA.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kimi Yoap nko pikachi kuriköy kanasyan, kutö Uriya wölo kinkït lö kimi pung cho le nyökon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.16",
            "verseOrgIds": [
              "2SA.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpka sany pipö kanasyan akïporyö nko chane, kepar mötwori Daudi walaka, akepar Uriya tïkwïl.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.17",
            "verseOrgIds": [
              "2SA.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.17",
            "verseOrgIds": [
              "2SA.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta Yoap chi wölo mi Daudi kïmwochï nyinte paraku poryot ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.18",
            "verseOrgIds": [
              "2SA.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïlenchï nyinte, “Ato kemwochinyi pöytoghin ngalechï pö poryot lapay, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.19",
            "verseOrgIds": [
              "2SA.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "töptoy nöreköy pöytoghintö akïlenchinyi, ‘Ompö ne tarikakwa kanasyan tya otini koporyokwa? Kömonkïtökwanye so lö muköy chane kïwutokwa ompö nayat? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.20",
            "verseOrgIds": [
              "2SA.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.9.53"
              },
              "items": [
                {
                  "text": "Kir 9:53",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mononekwanye lö kikïpar lö ne Apimelek wero Kidyon? Kipar korka nyinte ompö Tepes nyo kichïnuna koghpa pagh nayat kïwir nyinte kïma. Ompö ne nyu tarikakwa nayat?’ Ilenchï nyinte, ‘Kakïpar tïkwïl mötworintengu Uriya chichay pö Ititi.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.21",
            "verseOrgIds": [
              "2SA.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.21",
            "verseOrgIds": [
              "2SA.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö chichay akïmwochï Daudi ngalechay löwïr cho kömwochï Yoap. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.22",
            "verseOrgIds": [
              "2SA.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï chichay Daudi, “Kisïch nyakanat pungköcha, akïpka sany kïporyeghenecha, wölo keyonacha chane ntökwit kuka kanasyan. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.23",
            "verseOrgIds": [
              "2SA.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwutecha chane ompö nayat, kepar yetïntineku, kepar mötworintengu tïkwïl Uriya chichay pö Ititi.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.24",
            "verseOrgIds": [
              "2SA.11.24"
            ]
