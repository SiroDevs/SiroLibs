              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kilïm koko Uriya lö kikïpar pontenyi, kïrir akwompö nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.26",
            "verseOrgIds": [
