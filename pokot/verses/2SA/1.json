          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.5",
            "verseOrgIds": [
              "2SA.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
