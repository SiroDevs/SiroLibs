              "items": [
                {
                  "text": "1Ot 10:1-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï, “Kyomitan kutïng pö Kilpoa, akimi Saulö kïtököntoy ngotïnyi, kïrich nyinte pung tya cho kipegho nkaritin nko angoletin. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.6",
            "verseOrgIds": [
              "2SA.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwaghaka nyinte akuros lötunyi, kïsïwanïn, kïkuranïn, ongitönön lö, ‘Yoy.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.7",
            "verseOrgIds": [
              "2SA.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtepanïn nyinte lö, ‘Ichinyi ngo?’ Olenchan nyinte, ‘Ochan chi pö Amalek.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.8",
            "verseOrgIds": [
              "2SA.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn nyinte, ‘Nyonö wanganïn, ompöwölo omitan nyarïl kwen, kïrkegh kötosöpan.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.9",
            "verseOrgIds": [
              "2SA.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona owan apar nyinte, ompöwölo kyonkïtön lö kimeghöy nyinte nyo mötïny otini kepït. Achengan tenta nyo kimi mötïnyi nko apököy nyo kimi ewunyi akopkan ye wölo imitenyi.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.10",
            "verseOrgIds": [
              "2SA.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.10",
            "verseOrgIds": [
              "2SA.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkarer Daudi sïrokachi akïkarer pikachi sïrokökwa tïkwïl ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.11",
            "verseOrgIds": [
              "2SA.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïriryö ompö Saulö nko werïnyi Yonatan nko pipö ECHOTYON cho pö Israel, ompöwölo kikïpar chane cho chang.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.12",
            "verseOrgIds": [
              "2SA.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.12",
            "verseOrgIds": [
              "2SA.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Daudi chichay kömwowï ngalechay lö, “Ingwïnonyi onö?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.13",
            "verseOrgIds": [
              "2SA.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö, “Ochan pïnotyon nyo pö pipö Amalek.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.13",
            "verseOrgIds": [
              "2SA.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.13",
            "verseOrgIds": [
              "2SA.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi chichay, “Kalïkwï ne tömewaghanyi para chi nyo le kïlana ECHOTYON?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.14",
            "verseOrgIds": [
              "2SA.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur Daudi chi ompö pikachi akïlenchï, “Para nyinte.” Kepar chichay. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.15",
            "verseOrgIds": [
              "2SA.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi nyinte, “Ominyi kisönköku, ompöwölo kemwaghenyi kutingu lö, ‘Kaparan chi nyo le kïlana ECHOTYON.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.16",
            "verseOrgIds": [
              "2SA.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Karir Daudi ompö megha Saulö nko Yonatan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.16",
            "verseOrgIds": [
              "2SA.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrirchï Daudi Saulö nko werïnyi Yonatan ompö tumï. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.17",
            "verseOrgIds": [
              "2SA.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.10.13"
              },
              "items": [
                {
                  "text": "Yos 10:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kikikirchï tumï pö kïwang kitapu Yasyar atökenet pipö Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.18",
            "verseOrgIds": [
              "2SA.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakïkïl Daudi kïlïkwï pöytoghinto Yuda",
          "type": "text"
        }
      ]
    }
  ],
