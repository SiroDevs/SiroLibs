  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "2SA 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutuyö Daudi pikachi akïtat pich cho ghyongchini söpïchis pö 1,000 nko 100. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.1",
            "verseOrgIds": [
              "2SA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïyonta chane ompö söpïchis sömök. Kighyongchï Yoap söpïch anka, kughyongchï Apisyay wero Seruya, werto ompö Yoap anka, kughyongchï anka Itay nyo pö pipö Kit. Kïlenchï pöytoghintö chane, “Owetan tïkwïl nko akwa.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.2",
            "verseOrgIds": [
              "2SA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.2",
            "verseOrgIds": [
              "2SA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlenchï pikachi nyinte, “Mewetenyinye nko acha. Ompöwölo ato kïryaghacha, kïmelö kïgh ompö chane anta kïparecha kwen lö tïch. Ompöwölo ikörenyi kegh nko acha cho le 10,000. Ngwangwa konechanyi kingörokut aimitenyi kanasyan.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.3",
            "verseOrgIds": [
              "2SA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.3",
            "verseOrgIds": [
              "2SA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï pöytoghintö chane, “Oghan kïgh nyo osïwïyekwa lö karam.” Kughyongö pöytoghintö kuka kanasyan kamas, otini kimi pipö lïk kuweröy ompö söpïchis pö 1,000 nko 100. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.4",
            "verseOrgIds": [
              "2SA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi Yoap nko Apisyay nko Itay, “Oghchï Apsolom nyo karam akwompö ani.” Kïlïm pich löwïr ato kimwochini Daudi yetïntinechay paraku Apsolom.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.5",
            "verseOrgIds": [
              "2SA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.5",
            "verseOrgIds": [
              "2SA.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa pipö lïk cho pö Daudi kutang sany kïporyeghö pipö Israel ompö wuw pö Epraim. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.6",
            "verseOrgIds": [
              "2SA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrïnta mötwori Daudi pipö Israel ompö wöloni. Kikïpar pich cho le 20,000. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.7",
            "verseOrgIds": [
              "2SA.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïghömï poryot korononi akï chang pich cho kiwonyechï wuw kïtïl cho kikïpar.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.8",
            "verseOrgIds": [
              "2SA.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.8",
            "verseOrgIds": [
              "2SA.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchumchï Apsolom mötwori Daudi lawel, kimi Apsolom kïwegho sïkïryö, kuwer sïkïryonay ngwïnyi mori ket nyo wow, kïnam sökotïn pö ketay katïnyi, kïtas tagh sïkïryonay, kïpïstö Apsolom kïyïsö yïm. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.9",
            "verseOrgIds": [
              "2SA.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïwa chi akong nyo pö Daudi, kïwö kïmwochï Yoap lö, “Kasïwan Apsolom yïso ket.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.10",
            "verseOrgIds": [
              "2SA.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.10",
            "verseOrgIds": [
              "2SA.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yoap chichay, “Ato kesïwenyi nyinte kïlö ne tömeparanyi panini? Kötö okoninyi ropïyeni silpa taman nko angwa mu.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.11",
            "verseOrgIds": [
              "2SA.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.11",
            "verseOrgIds": [
              "2SA.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï chichay Yoap, “Kïrökegh kekonaninyi ropïyeni silpa cho le 1,000, melö kopöran mompö pöytoghin, ompöwölo kakïlïmacha nyinte kïmwowunyi nko Apisyay nko Itay lö, ‘Orip werïnyan Apsolom akwompö ani!’ ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.12",
            "verseOrgIds": [
              "2SA.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïrökegh kaghan kïgh nyo lata nyoni apar nyinte, akwanyï möminye kïgh nyo wïngo ompö pöytoghin, melö kötengörokaninyi.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.13",
            "verseOrgIds": [
              "2SA.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.13",
            "verseOrgIds": [
              "2SA.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Yoap, “Möminye pöroyïn nyo ongölonan nko nyi.” Kïcheng ngötwö cho le sömök akïtöra Apsolom takat otini kitökïsöpöy ompö ketay. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.14",
            "verseOrgIds": [
              "2SA.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kuwit mïrön cho le taman cho kile sïti kari lïk cho pö Yoap Apsolom akuwanta.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.15",
            "verseOrgIds": [
              "2SA.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.15",
            "verseOrgIds": [
              "2SA.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkut Yoap kontï, kïmïlisyö pipö Yoap cho kirïpöy pipö Israel, ompöwölo kimwochï Yoap chane kïpïstö. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.16",
            "verseOrgIds": [
              "2SA.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcheng chane por pö Apsolom akïwirchï pïrïm nyo kogh nyo kimi wuway akïkara koghïn cho echön. Kïryagh pipö Israel, kïwö chi anka tïkwïl katanyi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.17",
            "verseOrgIds": [
              "2SA.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.17",
            "verseOrgIds": [
              "2SA.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kökitekyï kegh Apsolom pchörï ato kitökïsöpöy nyo mi mpöghoghyo pöytoghin, ompöwölo kilö, “Motïngetanye worö nyo letoy kaynenyan.” Kïkurteghö nyinte pchörinay kaynenyi, kekurö ato kinono Apsolom nko ye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.18",
            "verseOrgIds": [
              "2SA.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakïmwochï Daudi megha Apsolom",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.18",
            "verseOrgIds": [
              "2SA.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Aimaas wero Sadok, “Nya opön lökoyechï wölo mi pöytoghintö olenchï, kikïsörï nyinte ECHOTYON ompö mori pungkachi.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.19",
            "verseOrgIds": [
              "2SA.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.19",
            "verseOrgIds": [
              "2SA.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yoap nyinte, “Mepenyinye asete ngalechï, ipenyi asistanka melö ye, ompöwölo kikïma wero pöytoghin.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.20",
            "verseOrgIds": [
              "2SA.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yoap chi pö Kus, “Wïyö nyo le nyi mwochinö pöytoghin ngal cho kesïwenyi.” Kungïrukö chichay ompö tawu Yoap akïwö. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.21",
            "verseOrgIds": [
              "2SA.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep ngat Aimaas wero Sadok Yoap lö, “Nya owan tïkwïl nko chichini pö Kus.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.22",
            "verseOrgIds": [
              "2SA.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Yoap, “Ompö ne temökenyi wete tïkwïl nya werïnyu, akwanyï inkïtönyi lö möminye ropöwonta nyo inyorunyi ompö lökoyechoni?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.22",
            "verseOrgIds": [
              "2SA.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.22",
            "verseOrgIds": [
              "2SA.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Aimaas, “Nya kïpka cho kapka, owetan.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.23",
            "verseOrgIds": [
              "2SA.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yoap nyinte, “Wïyö.” Kurïp Aimaas kuwer mpöghogh akïtïl chichay pö Kus.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.23",
            "verseOrgIds": [
              "2SA.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.23",
            "verseOrgIds": [
              "2SA.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi Daudi kïtöpö kwenu kukoti kanasyan cho pö ori nko cho pö sany. Kïpusta ripin nayat akïwö kö parak, otini kirosïta, kïsïwa chi nyo kirïpu onkït. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.24",
            "verseOrgIds": [
              "2SA.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur pöytoghin akïmwochï, kïlö pöytoghintö, “Ato mi nyinte onkït kïtïng lökoy.” Kïrikwï chichay kirïpu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.25",
            "verseOrgIds": [
              "2SA.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.25",
            "verseOrgIds": [
              "2SA.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïwa ngat ripintonay chitö anka nyo kirïpu, kïkur pöytoghin akïlenchï, “Anyinö chitö anka nyo rïpu onkït!”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.26",
            "verseOrgIds": [
              "2SA.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö pöytoghintö, “Ipu nyinte tïkwïl lökoy.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.26",
            "verseOrgIds": [
              "2SA.18.26"
            ]
          }
        }
      ]
    },
