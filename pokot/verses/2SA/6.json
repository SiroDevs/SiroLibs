  "reference": "2 Samwel 6",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2SA 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutuyö ngat Daudi pipö Israel 30,000 cho le nyökon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.1",
            "verseOrgIds": [
              "2SA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.22"
              },
              "items": [
                {
                  "text": "Wuw 25:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Daudi nko pïchay löwïr cho kimi nyinte tïkwïl kutang Paala nyo mi Yuda, atökwipï Santuku Muma nyo kïkurtegho kaynata Tororöt Kimuktoghin nyo mi paytaghtanyi kwenu kerupimtin.* ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.2",
            "verseOrgIds": [
              "2SA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïtunö kö pö Apinadap nyo kimi kutïng akutö nkari nyo tökïrel. Aki Usa nko Aio werpö Apinadap cho kikötöy nkaritö ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.3",
            "verseOrgIds": [
              "2SA.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "akimi Aio kuntöghogho Santuku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.4",
            "verseOrgIds": [
              "2SA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmi Daudi nko pipö Israel löwïr kïnyolöy akïtumchini ECHOTYON ompö owesyengwa kïmïkul, akitïng pilimpin nko pïkantis nko kwïrkwïris nko kari walaka cho pö tumwöy.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kit chane ghatya pagh nyo pö Nakon, kïchityö eghinechay, kïnam Usa Santuku Muma. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.6",
            "verseOrgIds": [
              "2SA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnarek ECHOTYON ompö Usa akïtïgh nyinte, ompöwölo kighïtö ewunyi kïnam Santuku Muma, kïmeghchï nyinte kamasu Santukunoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.7",
            "verseOrgIds": [
              "2SA.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinarek Daudi ompöwölo kitïgh ECHOTYON Usa, akekurö atoni Peres Usa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:8",
              "type": "text"
            },
            {
              "text": "Peres Usa:",
              "type": "text"
            },
            {
              "text": "Ompö Eprania kelentöy, sito ECHOTYON.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nko ye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwagh Daudi ECHOTYON asisoni, akïlö, “Osïtan lö ne Santuku Muma kanasyantenyu?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kimököy nyu Daudi kïsïtöy Santuku Muma kutang kanasyantenyi. Kïrop kamas akïsïtï kö pö Oped Edom nyo le chi pö Kit. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.10",
            "verseOrgIds": [
              "2SA.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.4+1CH.26.5"
              },
              "items": [
                {
                  "text": "1Ot 26:4-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtöpö Santuku Muma kö pö Oped Edom chi pö Kit ompö aro sömök, kusoyön ECHOTYON nyinte nko katanyi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kemwochï pöytoghin Daudi lö, “Kesoyön ECHOTYON kö pö Oped Edom nko kïgh anka tïkwïl nyo le nyenyi akwompö Santukunay pö Muma.” Kïwö Daudi kïsïtunö Santukunay kö pö Oped Edom kutöngwï kanasyantenyi ompö ngörekyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.12",
            "verseOrgIds": [
              "2SA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kipa pïchay kelyön mut nko akonga kisïtöy Santuku Muma, kutö Daudi ECHOTYON amöros nyo pö kirïk nko sunet. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.13",
            "verseOrgIds": [
              "2SA.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnyolchï Daudi ECHOTYON ompö owesyenyi kïmïkul akinonoghchï muyenyi sïra katani nyo pö tïsï. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.14",
            "verseOrgIds": [
              "2SA.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïtï Daudi nko pipö Israel löwïr Santuku Muma akuteghyot akïkutöy kontin.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.15",
            "verseOrgIds": [
              "2SA.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.15",
            "verseOrgIds": [
              "2SA.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kitï Santuku Muma kanasyanta Daudi, kurumï Mikal chepö Saulö tïrisya akïsïwa pöytoghin Daudi kïnyolöy akudöngonyöy ompö ECHOTYON, kïsas nyinte nyoman. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.16",
            "verseOrgIds": [
              "2SA.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïtï chane Santuku Muma akutö ema nyo kökikïtek Daudi kutö Daudi ECHOTYON amörostin cho kïpelöy nko cho pö pöghisyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.17",
            "verseOrgIds": [
              "2SA.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kiwang Daudi kutötö amörostin cho kïpelöy nko cho pö pöghisyö, kusoyön pich ompö kaynata ECHOTYON Kimuktoghin. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.18",
            "verseOrgIds": [
              "2SA.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.16.43"
              },
              "items": [
                {
                  "text": "1Ot 16:43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïchöghchï chi anka tïkwïl ompö söpïch pö Israel cho kile mïrön nko kor makatyan nyo mïnïng nko peny kite nko makatyan nko akwa makany. Kïwö nyu chi anka tïkwïl katanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.19",
            "verseOrgIds": [
              "2SA.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmïla Daudi atökutakwes piko katanyi. Kungwïn Mikal chepö Saulö akïtarok nyinte akïlenchï, “Wechï kökwol kegh asete pöytoghinto pipö Israel akïnganyta kegh ompö tawu tipïn cho le mötwori pikachi le ato portoy sölwöy chïrutnönengwa!”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.20",
            "verseOrgIds": [
              "2SA.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.20",
            "verseOrgIds": [
              "2SA.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi Mikal, “Konyolchinan ECHOTYON nyo kikïlanïn aker papongu nko konyi alïkwan pöytoghinto pipö ECHOTYON Israel, kïlenyona onyolchinan ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.21",
            "verseOrgIds": [
              "2SA.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otöninan ye nyu kegh arasï tya kïtïl nyoni ntasasan kegh, wölo konyïtanïn tipichona tya.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.22",
            "verseOrgIds": [
              "2SA.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimösïknye monïng Mikal nyay le chepö Saulö ntökïrapas.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.23",
            "verseOrgIds": [
              "2SA.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngölyon nyo kömwochï Natan Daudi",
          "type": "text"
        }
      ]
    }
  ],
