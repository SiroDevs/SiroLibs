                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Ngo 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Onyïghitan mïkulöwu kisyonchin nko saghat pipö ara pöytoghin Daudi nko pipö kanasyanta Yerusalem. Ato topön chane nyinte nyo kipara chok, kïsönönchï le chi nyo sönönchini montanyi nyo le akonga atoma, anta le nyo kamegha poretyenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wow sönönöto asisoni ompö Yerusalem, lata nyo kimi kanasyanta Adad Rimon ompö mpöghoghöyi koro Mekido. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sönönöy ngwïnya akwighöy lenyoni ompö ortïn akwotini sönönöy mi korï opïn, kïmi mïron opïn, pipö ara pöytoghin Daudi nko pipö ara Natan nko korukwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pipö ara Lawi nko korukwa nko ara Syimey nko korukwa ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïlenyoni tïkwïl ompö pipö ortïne walaka cho köngötï.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
      ]
