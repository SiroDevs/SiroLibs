            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.12",
            "verseOrgIds": [
              "ZEC.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlechanïn, “Menkïtönyinye lö pö ne?” Osïrpönchan lö monkïtönye.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.13",
            "verseOrgIds": [
              "ZEC.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.13",
            "verseOrgIds": [
              "ZEC.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn, “Choni kï pich odeny cho kikïl ECHOTYON nyo pö ngwïny kïmïkul akuyila mwagh atökïpöghisyechi nyinte.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.14",
            "verseOrgIds": [
              "ZEC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayomis nyo kitö Tororöt Serupapel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
