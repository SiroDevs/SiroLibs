                  "text": "Ngo 11:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atepan ngat lö, “Pö ne ketichï pö sapipun le odeny, mi akong ewu löt kïmi anka ewu tagh nyo pö kikönöwonto ta nya? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.11",
            "verseOrgIds": [
              "ZEC.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwowo tïkwïl lö, pö ne morichona le odeny pö sapipun poyot nko mïricheni koltin cho kiyinuno mwaghpa sapipun?”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.12",
            "verseOrgIds": [
              "ZEC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
