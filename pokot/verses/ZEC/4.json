            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay kïlenchanïn, “Tatïnechoni le mut nko odeny kï konyi ECHOTYON cho le mut nko odeny cho topönöy ngwïny kïmïkul.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.10",
