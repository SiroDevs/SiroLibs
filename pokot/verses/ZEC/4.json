          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osïrpönchan lö, “Monkïtönye we apoy.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.5",
            "verseOrgIds": [
              "ZEC.4.5"
            ]
          }
        }
      ]
    },
