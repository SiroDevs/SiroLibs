        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.4",
            "verseOrgIds": [
              "ZEC.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn, “Menkïtönyinye so lö pö ne?”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.5",
            "verseOrgIds": [
              "ZEC.4.5"
            ]
          }
        }
      ]
    },
    {
