          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö chichay, “Ewo.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        }
