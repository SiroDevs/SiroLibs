              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kïtöpö kalya nko akwa lapay chona kalïkwï pipö Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.14",
            "verseOrgIds": [
