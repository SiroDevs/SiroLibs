                {
                  "text": "40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kingarakanïn werïnyo Silpano nyo onkïtön, aghönan, akir palalyantanete tangogh. Kakirwakwa atosïkö mïkulögh, asöwintönchï lö, nyete kï pöropcho Tororöt nyo pö man. Oghyongö nyu, achïchïm ompö pöropchononi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
        }
      ]
