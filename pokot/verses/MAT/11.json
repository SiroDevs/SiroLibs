          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanagha kat mchokinyan, anetenanïn kegh, ompöwölo ochan talase, apan kegh ngwïny, atosïkö kimïny ompö söponwekwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
