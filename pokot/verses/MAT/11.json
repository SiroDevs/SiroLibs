              "type": "text"
            }
          ]
        },
        {
          "text": "“Opkonchanïn pich löwïr cho osusöy kegh nko nïkisïntin atomunywok. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.28",
