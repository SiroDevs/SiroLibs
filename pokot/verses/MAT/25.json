            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Owirchï sany wölo tuw mötworintonï mötïnye kinyiwut. Riryegho pich wölini akïnyöghöy kelat ompö nyarïl.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
