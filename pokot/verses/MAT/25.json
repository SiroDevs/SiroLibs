              "type": "text"
            }
          ]
        },
        {
          "text": " Ompöwölo kitöni chi kïgh nyo tïng aketösyï kïchangit. Wölo nyo melö tïng kïgh, kesöro ompö nyini kötïng. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.29",
            "verseOrgIds": [
              "MAT.25.29"
            ]
          }
        },
        {
