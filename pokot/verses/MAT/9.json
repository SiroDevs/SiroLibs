          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "akwotini kikitul oyichay, kutor chichay kïngalan. Kïtöngönchï pich löwïr akïlö, “Tomönye kesöchinöcha kïgh nyo lata nyï koro Israel.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.33",
            "verseOrgIds": [
              "MAT.9.33"
            ]
          }
        },
