  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "MAT 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiwany Yeso kïmwa ngalechi löwïr, kïweghö Kalilaya kutang okumpö Yudea, lalwa Yordan antakwagh. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.1",
            "verseOrgIds": [
              "MAT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrïp söpïchis pö pich cho chang, kusop nyinte chane ompö wölini.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.2",
            "verseOrgIds": [
              "MAT.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.2",
            "verseOrgIds": [
              "MAT.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpechï Parisaytin* kïtyam nyinte kïtep lö, “Mwowune köny, chömu kirurut kutyoköy chi korkenyi ompö kïgh anka tïkwïl nya?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.3",
            "verseOrgIds": [
              "MAT.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.27"
              },
              "items": [
                {
                  "text": "Tow 1:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.5.2"
              },
              "items": [
                {
                  "text": "5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kuyokyï Yeso lö, “Tomönye so osomönökwa Kirurut cho Tïlilöch lö nyinte nyini kigh chi kïngeta towunöt kï kigh ngetat nko korka ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.4",
            "verseOrgIds": [
              "MAT.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.24"
              },
              "items": [
                {
                  "text": "Tow 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " akïlö, ‘Nka nyï pïstoy chi kwanta nko kame akïnomnyö nko korkenyi kïlïkwï chane kwodeny por akonga.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.5",
            "verseOrgIds": [
              "MAT.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, melö tö kwodeny chane ngat, wölo por akonga. Kïlenyona nyu melö tökupesyot chane cho kakutuyö Tororöt.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.6",
            "verseOrgIds": [
              "MAT.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.1+DEU.24.2+DEU.24.3+DEU.24.4"
              },
              "items": [
                {
                  "text": "Krt 24:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.31"
              },
              "items": [
                {
                  "text": "Mat 5:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïtep Parisaytin nyinte lö, “Kwompö ne tökïmwowecha Musa lö kitöni korka palalyanta kityakat atökeyon?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.7",
            "verseOrgIds": [
              "MAT.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Yeso chane lö, “Kichömwokwa Musa atyaka korukwo ompö oghïghyo mïkulöwekwa. Wölo melö kilata nyoni kïngeta towunöt. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.8",
            "verseOrgIds": [
              "MAT.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.32"
              },
              "items": [
                {
                  "text": "Mat 5:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.10+1CO.7.11"
              },
              "items": [
                {
                  "text": "1Kr 7:10-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wölo omwowokwa ye lö, ato tyak chi korkenyi, kïpoto ompö cheporesnan akwip korketö anka, kï kegh cheporesnan nyinte tïkwïl. Akï nyinte nyo ipöy korka nyo kaketyak, kï kegh cheporesnan.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.9",
            "verseOrgIds": [
              "MAT.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.9",
            "verseOrgIds": [
              "MAT.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï kinetankachi nyinte, “Kwoto lata nyoni ngala chi nko korkenyi, kïmömïchininye kekensyö.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.10",
            "verseOrgIds": [
              "MAT.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Yeso lö, “Melö pich lapay cho toköy kinetutchï kïpoto pich cho kakutö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.11",
            "verseOrgIds": [
              "MAT.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo mi ortïna cho chang cho ighöy pich memï kïkensyö: mi walaka cho kikïyï lenyoni, kïmi cho kigh pikö walaka lenyoni, kïmi cho machamcha kïkensyö akwompö Pöyunöto Yïm. Anka tïkwïl nyo muköy kïtoköy kinetutyononi akany kïtak.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.12",
            "verseOrgIds": [
              "MAT.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kesoyön Yeso monïng cho mïnkech",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.12",
            "verseOrgIds": [
              "MAT.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumïtyï pich monïng Yeso tökukanagh ewunechi parakungwa akïsoghchï, wölo kïtagha kinetankachi pïchini. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.13",
            "verseOrgIds": [
              "MAT.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Yeso, “Opïsunö monïng kïpka wölo omitan motögho, ompöwölo pö Pöyunöto Yïm pich cho lata monechï.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.14",
            "verseOrgIds": [
              "MAT.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukanagh nyu ewunechi akïnget kiwechï kegh.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.15",
            "verseOrgIds": [
              "MAT.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chi nyo le sïkön",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.15",
            "verseOrgIds": [
              "MAT.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwechi chi astanka Yeso akïtep lö, “Konetin, mïchini aghan kïgh ne nyo karam tonyorwan söpon pö kokay?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.16",
            "verseOrgIds": [
              "MAT.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yeso, “Ompö ne tetepenaninyi kïgh nyo karam nya? Möminye nyo karam kïpoto Tororöt. Ato imökenyi telïtö söpon ikaman kirurut.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.17",
            "verseOrgIds": [
              "MAT.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.12+EXO.20.13+EXO.20.14+EXO.20.15+EXO.20.16"
              },
              "items": [
                {
                  "text": "Wuw 20:12-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.17+DEU.5.18+DEU.5.19+DEU.5.20"
              },
              "items": [
                {
                  "text": "Krt 5:17-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïtep chichay lö, “Kirurut chono?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.18",
            "verseOrgIds": [
              "MAT.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yeso, “Chay lentöy, ‘Mepar chi, megh cheporesnan, mechorsyö, mesöwintönchï ngala putintön, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.18",
            "verseOrgIds": [
              "MAT.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.12"
              },
              "items": [
                {
                  "text": "Wuw 20:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Law 19:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.16"
              },
              "items": [
                {
                  "text": "Krt 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " itech kon nko komöt aicham pöröryengu le wölo ichömtoy kegh.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.19",
            "verseOrgIds": [
              "MAT.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï chichay lö, “Kyarïpan kirurutchï löwïr, ne nyo tökïrörchinanïn ngat?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.20",
            "verseOrgIds": [
              "MAT.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yeso nyinte, “Ato imököy tetena, iwö iyalta tïkuku cho itïng aitö ropïyeni mey atesïkö kaplawach ompö yïm aingwïn irïpanïn.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.21",
            "verseOrgIds": [
              "MAT.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kilïm mïrönonay lenyoni kïma mu, kïwö ompö nörekyö ompöwölo ki makos nyinte nyoman.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
            "verseOrgIds": [
              "MAT.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
            "verseOrgIds": [
              "MAT.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yeso kinetankachi, “Omwowokwa nyoman lö aghïgh tya ompö sïkön kïlït Pöyunöto Yïm. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.23",
            "verseOrgIds": [
              "MAT.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwowokwa ngat lö kwïskwïs tya kïlït tamas kongpa södök kïtïl kïlït sïkönö Pöyunöto Tororöt.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.24",
            "verseOrgIds": [
              "MAT.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.24",
            "verseOrgIds": [
              "MAT.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikany kïlïm kinetankachi lenyoni, kïtöngönchï nyoman akïtep lö, “Ngo nyu nya nyo kimuköy kesöru?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.25",
            "verseOrgIds": [
              "MAT.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kura Yeso chane latok akïlenchï, “Memukonye ngölyontonï ompö pich, wölo muko kïgh anka tïkwïl ompö Tororöt.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.26",
            "verseOrgIds": [
              "MAT.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.26",
            "verseOrgIds": [
              "MAT.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlö Petro, “Kïnyorucha ne nyu nya chï kakïpïstö tïkucho löwïr akerïpinyi?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.27",
            "verseOrgIds": [
              "MAT.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.31"
              },
              "items": [
                {
                  "text": "Mat 25:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.30"
              },
              "items": [
                {
                  "text": "Luk 22:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïlenchï Yeso chane, “Omwowokwa nyoman lö ato ngwïn Wero Chi kïtöpö ngacharunyi pö paytagh ompö ororyenyi ompö kor nyo rel, apkanakwa nyu cho orïpanïn kï taman nko odeny ompur tïkwïl ngöcherwo paytagh arwokyï ortïna pipö Israel kïtaman nko odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.28",
            "verseOrgIds": [
              "MAT.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwanka tïkwïl nyo köpïstö korichi anta werkökwa anta tipikwa anta kwanta anta kame anta monechi anta parenichi ompö ani, kïnyoru walaka kïnyïl 100 akïnyorï söpon pö kokay. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.29",
            "verseOrgIds": [
              "MAT.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.20.16"
              },
              "items": [
                {
                  "text": "Mat 20:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.30"
              },
              "items": [
                {
                  "text": "Luk 13:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ompö wölo lïku pich cho pö tagh cho pö löt akï lïku cho löt cho pö tagh.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.30",
            "verseOrgIds": [
              "MAT.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pich cho pöghisïyi ompö para sapipun",
          "type": "text"
        }
      ]
