      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuröy Yeso nömi kaghagh angwan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
