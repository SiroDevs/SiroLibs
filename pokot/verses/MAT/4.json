                  "text": "Yna 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay kingeta Nasaret kïwö kïmang Kapernaum, kanasyan nyo mi sörömu nanampa Kalilaya koro Saplon nko Naptali, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
            "verseOrgIds": [
              "MAT.4.13"
            ]
          }
        },
