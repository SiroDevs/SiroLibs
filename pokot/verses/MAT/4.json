              "items": [
                {
                  "text": "Krt 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wölo kuyokyï Yeso lö, “Kikikir lö, ‘Mösöponye chi makatyan onkït, wölo söpo chi ngölyon anka tïkwïl nyo ngwïno kuti Tororöt.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.4",
            "verseOrgIds": [
              "MAT.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
