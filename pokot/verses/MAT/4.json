            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kuyokyï Yeso lö, “Wïyö Onyötonï! Ompöwölo kikikir lö, ‘Sagha Echotyon Tororötïngu aipöghisyechï nyinte onkït.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.10",
            "verseOrgIds": [
              "MAT.4.10"
            ]
          }
        }
