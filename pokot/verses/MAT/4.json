              "type": "text"
            }
          ]
        },
        {
          "text": " Otini nyu kilïm Yeso lö kikïtorchï Yoana chela, kïwö kutang Kalilaya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.12",
