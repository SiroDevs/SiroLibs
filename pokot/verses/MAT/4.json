            "number": "8",
            "style": "v",
            "sid": "MAT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kumït Onyöto Yeso kïpus kutïng nyo kogh akuporchï pöyunötin cho pö ngwïny kïmïkul nko wölo teno ororyengwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.8",
            "verseOrgIds": [
              "MAT.4.8"
            ]
          }
        }
      ]
    },
