              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï, “Okoninyi chete löwïr ato ikïtïngönyi aisaghanïn.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.9",
            "verseOrgIds": [
              "MAT.4.9"
            ]
          }
        }
      ]
