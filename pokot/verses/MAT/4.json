            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïpïstö Onyötö Yeso, kïpka malayken kïpöghisyechï nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.11",
            "verseOrgIds": [
              "MAT.4.11"
            ]
          }
        }
      ]
    },
