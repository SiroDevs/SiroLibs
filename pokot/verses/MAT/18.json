                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay kïwechi Petro Yeso akïlenchï, “Ato lelwanïn werïncha, olöstoghchinan nyinte kïnyïl ata? Kïnyïl mut nko odeny?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.21",
            "verseOrgIds": [
              "MAT.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.3+LUK.17.4"
              },
              "items": [
                {
                  "text": "Luk 17:3-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kuyokyï Yeso lö, “Ewo, melö kïnyïl mut nko odeny, wölo 70 kïnyïl mut nko odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.22",
            "verseOrgIds": [
              "MAT.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo karkegh Pöyunöto Yïm nko pöytoghin nyo kimököy kunkïtu wölo kiriptoy mötworichi ropïyenichi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.23",
            "verseOrgIds": [
              "MAT.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo otini kitökïmi kwighöy lenyoni kemïtï nyinte akonga ompö mötworichi nyo kipösön ropïyen cho makïrar. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.24",
            "verseOrgIds": [
              "MAT.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimötïngnye mötworintonini ropïyen chonikïny cho kighoktegho pösöntanyi, kïlenyona kïmwatïta echotyontenyi kyalta kïlïkwï sekeyon, nyinte nko korkenyi nko monechi nko tïkwïn löwïr cho kitïng atökemï keghakta pösöntanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.25",
            "verseOrgIds": [
              "MAT.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupïtyï mötworintonay kelyo echotyontenyi akïlenchï, ‘Mïkukönwante atoghokun pösöntöngu kïmïkul!’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.26",
            "verseOrgIds": [
              "MAT.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusyonchï echotyontononi, akïmötochï ghosyonini akïpïstö kïwechï kegh.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.27",
            "verseOrgIds": [
              "MAT.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.27",
            "verseOrgIds": [
              "MAT.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo kïngeta mötworintonay ataye akïtuyeghö mötworintengwa anka nyo kighoköy nyinte ropïyen 100. Kïnam akuket kïlenchini, ‘Ghokunö pösöntönyan!’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.28",
            "verseOrgIds": [
              "MAT.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupïtï ngwïny mötworintonay kipöghisïyi tïkwïl akïsagh nyinte lö, ‘Mïkukönwante atoghokun pösöntöngu!’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.29",
            "verseOrgIds": [
              "MAT.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kimöternye akïnyinö kitömïkukönchini kutötö nyinte ketorchï chela ntökïtenö kïghokï pösönay. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.30",
            "verseOrgIds": [
              "MAT.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kisïwa mötwori walaka ngalechini kighisyö, kwotyö nyoman, kïpa akimwochï echotyontengwa ngalechini kighisyö. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.31",
            "verseOrgIds": [
              "MAT.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur nyu echotyontenyi mötworintonini kïwö kö ori akïlenchï, ‘Ichinyi mötworin nyo gha! Kyomötowunyi pösönay kïmïkul ompöwölo kisaghaninyi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.32",
            "verseOrgIds": [
              "MAT.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "melö so kitömïchininyi syonchinö mötworintonï kemitenyi tïkwïl le wölini kyosyonchinyi?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.33",
            "verseOrgIds": [
              "MAT.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnarek nyoman echotyontonay akutötö nyinte kenyaril kong ntökïtenö kïghokï pösöntö löwïr.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.34",
            "verseOrgIds": [
              "MAT.18.34"
            ]
          }
        }
      ]
    },
