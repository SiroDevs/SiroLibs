              "items": [
                {
                  "text": "Luk 17:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ato lelun werïngwo, iwö imwochï nyinte lelutyenyi ompö sison akwa opïn. Ato terunyi, kï kesörunyi werïngwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.15",
            "verseOrgIds": [
              "MAT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "Krt 19:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wölo ato möterunyinye, imït chi akonga anta pikö walaka odeny kïpa nko nyi atökechïchim ngölyon anka tïkwïl ompö kutïwa söwï odeny anta sömök. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.16",
            "verseOrgIds": [
              "MAT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato möterchïnye chane, imwochï kanisa. Kïkany ato möterchïnye kanisa, oyit nyu nyinte kïkarkegh nko chi nyo menkïtnye Tororöt akïkarkegh nko kwöghinto surï.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.17",
            "verseOrgIds": [
              "MAT.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ketagha nko kechömchï",
          "type": "text"
        }
      ]
    },
