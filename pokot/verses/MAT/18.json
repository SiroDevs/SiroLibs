              "MAT.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwany nyu Yeso kïlenchï pïchay, “Lenyoni asïyech wölo idoy Paponyan nyo mi yïm, chi anka tïkwïl nyo mölöstoghchininye werïngwa ompö mïkulöwunyi kïmïkul.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.35",
            "verseOrgIds": [
              "MAT.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kinet Yeso paraku kityakat ompö kensyö",
          "type": "text"
        }
      ]
    }
