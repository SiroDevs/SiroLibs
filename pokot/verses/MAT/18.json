            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.30"
              },
              "items": [
                {
                  "text": "Mat 5:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kïlenyona ato ighïn ewungu anta keltöngu igha ngokï, idingtö aiwirta! Karam ompö nyi nyorunö söpon kïpuryö egh anta kel kïtïl mitenö nko moriku kwodeny anta kelyeku kwodeny akewirchin mapa kokay. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.8",
            "verseOrgIds": [
              "MAT.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.29"
              },
              "items": [
                {
                  "text": "Mat 5:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akwoto ighïn kontangu igha ngokï, iködötï aiwirta! Karam ompö nyi nyoruno söpon ichï toler kïtïl mitenö nko konyiku kwodeny akewirchinyi mapa kokay.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.9",
            "verseOrgIds": [
              "MAT.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Körkeyïn pö kech nyo kipot",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
