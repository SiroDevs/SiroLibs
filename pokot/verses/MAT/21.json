        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.39",
            "verseOrgIds": [
              "MAT.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep nyu Yeso pïchini lö, “Ekwato itï chi pö par ido ne nya pïchay kimonokyï par?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.40",
            "verseOrgIds": [
              "MAT.21.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 21:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï lö, “Pöröy chi pö par pïchini ghach ompö parat nyo gha akumönokyï paranoni pö sapipun pikö walaka cho töni nyinte kareranto akweko parenyi otini ketïta asispa ilö.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.41",
            "verseOrgIds": [
              "MAT.21.41"
            ]
          }
        }
      ]
    },
