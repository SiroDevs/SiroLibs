          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akï ye monechu, otïpinö orinyi töto otini kechumï, kesïch nyakanat tömökïmi kïgh nyo ighecha kewïngena kegh nyinte ompö arasï ato itï Asisoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.28",
            "verseOrgIds": [
              "1JN.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1JN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïle wölini onkïtökwa lö pö man Kristo, kïmïchini tïkwïl onkïtunökwa lö anka tïkwïl nyo ighöy man, kï mompö Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.29",
            "verseOrgIds": [
              "1JN.2.29"
            ]
          }
        }
      ]
