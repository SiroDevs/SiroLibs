          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakirwakwa ngalechoni akwompö pich cho mököy kuryalakwa opotyenö. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.26",
            "verseOrgIds": [
              "1JN.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1JN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo mi nko akwa Mïkulögh nyo Tïlil nyo kikïmïlwokwa Kristo. Akwato töpö Mïkulögh nyo Tïlil orinkwa kïmelö totïngetenökwa machat nyo pö konetin anka. Ompöwölo netokwa Mïkulöwunoni tïkwïn lapay, akï kïgh anka tïkwïl nyo netöy nyinte kïpö man, melö putintön. Arïpa nyu kinetut pö Mïkulögh nyo Tïlil atïpï orito Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.27",
            "verseOrgIds": [
              "1JN.2.27"
            ]
          }
        }
      ]
    },
    {
