            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.33+LEV.23.34"
              },
              "items": [
                {
                  "text": "Law 23:33-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyomis pich löwïr Yeropoam kïrip asis nyo wow nyo pö saghat ompö asispa taman nko mut, nyo pö arawa mut nko sömök, kïle wölo kilata otöptino pipö Yuda. Kutötö Yeropoam amörostin asisoni wow kikïtuyegho kanasyanta Petel nyo kïsoghöy moghechay pö koltin kwigh nyinte, akutö tïsï Petel cho kipöghisïyi ompö atay kïsogho kitek nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwetöy Yeropoam Petel kutötoy ropöwontenyi ompö ato kïpelo amöros asispa taman nko mut nyo pö arawa mut nko sömök.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.33",
            "verseOrgIds": [
              "1KI.12.33"
            ]
          }
        }
