          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiwany Eliya kïngalan, kïkarer Aap sïrokachi akïngwïs akulach sarankwachtin. Melö kitökwomisyö atoni wölo kisïch nyarïl nyo wow.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
            "verseOrgIds": [
              "1KI.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
            "verseOrgIds": [
              "1KI.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïlenchï ECHOTYON Eliya, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kesïwenyi wölini karïng kegh Aap kïlïkwï ompö tawunyan? Melö topunan ye nyu kinyaratanoni otini tökïsöpöy nyinte ompöwölo kegh nyinte lenyoni, wölo opunan osisweko werkachi. Atoni ato owonyan pipö ara Aap.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.29",
            "verseOrgIds": [
              "1KI.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Körirchï werkoyon Mikaya Aap",
          "type": "text"
        }
      ]
    }
