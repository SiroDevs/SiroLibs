          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpayta nyu Solomon koro Israel kïmïkul. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.1",
            "verseOrgIds": [
              "1KI.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achï pikö cho kile yetïntin:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.2",
            "verseOrgIds": [
              "1KI.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.6",
            "verseOrgIds": [
              "1KI.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Solomon pich taman nko odeny cho kighyongchini koroswo Israel, akï pïchoni cho kighömïtu omisyewut cho kipkana koroswekwa cho kipöyitu pöytoghin nko piko katanyi. Kikïchöghchï kighyongtoghin anka tïkwïl kïghamïtï omisyö nyo kimïchï arawa akonga ompö köny akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.7",
            "verseOrgIds": [
              "1KI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achï kaynötutko pöytoghichoni le taman nko odeny nko koroswechini kighyongchini chane:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.8",
            "verseOrgIds": [
              "1KI.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö pïchoni le taman nko odeny, kimi pöytoghintö akong nyo kighyongchini koro Yuda kïmïkul.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.19",
            "verseOrgIds": [
              "1KI.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Könyorï paytaghpa Solomon kisoyönöt nyo wow",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.19",
            "verseOrgIds": [
              "1KI.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïchangit tya pipö Yuda nko Israel, kikarkegh chane nko ngayam cho mi sörömu nanam, kwomisyö akïgheghsyö akïngörekyö. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.20",
            "verseOrgIds": [
              "1KI.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.18"
              },
              "items": [
                {
                  "text": "Tow 15:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.26"
              },
              "items": [
                {
                  "text": "2Ot 9:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipayta Solomon punton löwïr, kïngeta lalwa Yuparet ntökwit koro pipö Pilisti akïnam rotyo koro Misri. Kïkwagh surï puntonichoni löwïr akwipchï Solomon. Kigh chane lenyoni kokay otini kitökïsöpöy Solomon.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.21",
            "verseOrgIds": [
              "1KI.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.21",
            "verseOrgIds": [
              "1KI.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achï tïkwïn cho kipöghisyegho Solomon asis anka tïkwïl: liten 5,000 cho pö pïsya nko liten 10,000 cho pö nkanun ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.22",
            "verseOrgIds": [
              "1KI.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko eghin taman cho okwoghöch nko eghin tömönut odeny cho kïronguno achey nko kechir 100 kïsis korinyoyï nko chemïloy nko chemnyökosen nko kokorochöy cho okwoghöch. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.23",
            "verseOrgIds": [
              "1KI.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipayta nyinte pipö punton cho kimi lalwa Yuparet okumpö kongasis, kïngeta Tipsa ntökwit Kasa, kimi kalya woptine tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.24",
            "verseOrgIds": [
              "1KI.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïpï pipö Yuda nko cho pö Israel ompö kalya kïngeta Dan ntökwit Persyepa otini kitökïsöpöy Solomon. Kitïng pich löwïr keti sapipun nko cho pö makany.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.25",
            "verseOrgIds": [
              "1KI.4.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
