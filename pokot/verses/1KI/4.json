              "items": [
                {
                  "text": "25:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SNG.1.1"
              },
              "items": [
                {
                  "text": "Tpt 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwa ngala ngötïnyö cho le 3,000 akïmïn tumwöy cho tïlöy 1,000. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingalana pitata ket, kïngeta tarakitpa Lepanon nko isop* nyo pito nïyet nko kyak nko törit nko tyonkïn cho chuto mutïn ngwïny nko kaghagh. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpka pipö ngwïny kïmïkul kïter ngöghomnyo Solomon nko cho kipka wölo mi pöytoghi ngwïny cho kilïm ngöghomnyenyi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.34",
            "verseOrgIds": [
              "1KI.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kamach Solomon kïtek Kö pö Tororöt*",
          "type": "text"
        }
      ]
    }
