          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmina nayatu Kö pö Tororöt okumpö sany nko okumpö ori körkeyïntino kerupimtin nko sos nko tapïkoy. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.29",
            "verseOrgIds": [
              "1KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
