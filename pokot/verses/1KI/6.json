          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki miten odeny kapepche anka tïkwïl ompö koghïn, ki miten angwan kïngata walta nyo pö kapep akonga ntökwit nyinö anka. Kikarkegh tyonchoni kwodeny laras. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.24+1KI.6.25+1KI.6.26",
            "verseOrgIds": [
              "1KI.6.24",
              "1KI.6.25",
              "1KI.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö kerupimtinechay nyo pö ori, akïkany kughïtö köpepokökwa. Kiswany kapepcheto anka nayat akonga, kïswany kapepcheto anka nayatu anka kïswany kegh köpepokökwa ompö kwenu köyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïmala koltin kerupimtinechoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
          }
        }
      ]
    },
