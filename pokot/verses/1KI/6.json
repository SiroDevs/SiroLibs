              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïtek kot nyo pö ori kuwit ortïn sömök cho pö koghïn cho kikipat nko ore akonga nyo pö keti tarakit.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
