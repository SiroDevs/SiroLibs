  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "1KI 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiweghö werkoyonta Yuda kutang Petel nyo kingölonchï ECHOTYON. Kwit otini kimi Yeropoam kughyongo ato kïpelo amöros atökutötö amörostanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.1",
            "verseOrgIds": [
              "1KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.15+2KI.23.16"
              },
              "items": [
                {
                  "text": "2Pöy 23:15-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïchïp chichay ato kïpelo amöros akïlö, “Heywey otï kïpelo amörostin! Heywey otï kïpelo amörostin! Lentöy ECHOTYON, ‘Kïyiyöy monïng ompö ka Daudi nyo kïkuro Yosia akï nyinte nyo tötoy tïsï cho pöghisyechini tororötin walaka le amörostin ompö nyi. Pelo yete nyu chichoni koyo pich löwïr.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.2",
            "verseOrgIds": [
              "1KI.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulet tagh werkoyontonay kïlö, “Anyï machey nyo poru, körero ato kïpelo amöros akïtoyö orechi. Atonkïtunökwa lö, ECHOTYON nyini kamwa ngalechoni.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.3",
            "verseOrgIds": [
              "1KI.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.3",
            "verseOrgIds": [
              "1KI.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kilïm pöytoghintö Yeropoam lenyoni, kungut werkoyontonay akïlö, “Anama nyinte!” Panini lawel kïmeyta ewunyi, amelö kitökumï kïnyakïm ngat. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.4",
            "verseOrgIds": [
              "1KI.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïpanini lawel kïkarera ato kïpelo amöros akïtoyö orechi kïrïp kegh nko ngölyontonay pö ECHOTYON kimwa werkoyontö. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.5",
            "verseOrgIds": [
              "1KI.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïlenchï pöytoghintonay werkoyontonay, “Kaykay soghwante ECHOTYON Tororötïngu kusop ewunyan!”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.6",
            "verseOrgIds": [
              "1KI.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsagh werkoyontonay ECHOTYON, kïsöp ewunay. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.6",
            "verseOrgIds": [
              "1KI.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï pöytoghintonay werkoyontonay, “Nyonö kepe katanyan kyomisyenö atokonïn ropöwon.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.7",
            "verseOrgIds": [
              "1KI.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.7",
            "verseOrgIds": [
              "1KI.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kuyokyï werkoyontonay lö, “Kïrkegh kekonaninyi kareran nyo pö mökosyengu, kïmelö owetan nko nyi anta omisïyi anta agheghsyö. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.8",
            "verseOrgIds": [
              "1KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kataghenanïn ECHOTYON am omisyö anta ogheghsyö anta amïla aranoni kangwïnan.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.9",
            "verseOrgIds": [
              "1KI.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kitökïmïla nyu nyinte aranini kingwïna, wölo kuwer are anka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.10",
            "verseOrgIds": [
              "1KI.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Werkoyon nyo le poyon nyo pö Petel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.10",
            "verseOrgIds": [
              "1KI.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi osiswechoni werkoyonta nyo le poyon nyo kimöngöy Petel. Kïpka werkachi akïmwochï nyinte ngala töngönchin cho kigh werkoyontonay ngwïno Yuda ompö Petel nko ngal cho kimwochï pöytoghin Yeropoam. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.11",
            "verseOrgIds": [
              "1KI.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep pontonay lö, “Aköwö chichoni or ne?” Kuporchï chane aranini köwö chichay pö Tororöt kingwïna Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.12",
            "verseOrgIds": [
              "1KI.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchï werkachi, “Orötwonte sïkïryenyan.” Kwigh chane lenyoni akïlany ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.13",
            "verseOrgIds": [
              "1KI.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïwö kïrïp werkoyontonay ngwïno Yuda. Kïnyorï nyinte kumungo ket, kïtep lö, “Ichinyi werkoyontonay kengwïna Yuda nya?”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.14",
            "verseOrgIds": [
              "1KI.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï lö, “Owöy, ani nyoni.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.14",
            "verseOrgIds": [
              "1KI.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.14",
            "verseOrgIds": [
              "1KI.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï pontonay le werkoyon nyinte, “Kemïlisyenö kepe katanyan kyomisyenö.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.15",
            "verseOrgIds": [
              "1KI.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.15",
            "verseOrgIds": [
              "1KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kuyokyï werkoyontonay pö Yuda lö, “Mowetanye nko nyi anta katangu omisiyi, momanye kïgh anta aghegh pögh ompö koronï, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.16",
            "verseOrgIds": [
              "1KI.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ompöwölo kimwowanïn ECHOTYON lö meam kïgh anta ighegha pögh koronï. Akïtaghenanïn amïla aranini kyangwïnan.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.17",
            "verseOrgIds": [
              "1KI.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.17",
            "verseOrgIds": [
              "1KI.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï werkyontonay pö Petel nyinte, “Ochan tïkwïl werkyon le nyi, kömwowanïn malaykayanta ECHOTYON lö, wïyö mïtuna nyi kïmïla aitö omisyö.” Wölo ki putin werkoyontononi le poyon.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.18",
            "verseOrgIds": [
              "1KI.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.18",
            "verseOrgIds": [
              "1KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, kïmïla werkoyontonay kingwïno Yuda ka werkoyontonay le poyon pö Petel akwomisyö nko nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.19",
            "verseOrgIds": [
              "1KI.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwotini kimi chane kwomisïyi, kungwïnchï ngölyonto ECHOTYON werkoyontonay le poyon ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.20",
            "verseOrgIds": [
              "1KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyo kilenchï werkoyontonay pö Yuda, “Kölö ECHOTYON kepenyanyi kiyomisötenyi amelö keghanyi kïgh nyo kömwowunyi nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.21",
            "verseOrgIds": [
              "1KI.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otï kemïlenyi aiyomisyö aigheghsyö ompö wölo kitagheninyi nyinte. Kïlenyona nyu ominyi ngötïny amelö kïtïpchininyi pïrïmpotiko papotïneku.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.22",
            "verseOrgIds": [
              "1KI.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.22",
            "verseOrgIds": [
              "1KI.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiwany kwomisyö, kïrötyï werkyontonay le poyon werkoyontonay kingwïno Yuda sïkïryenyi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.23",
            "verseOrgIds": [
              "1KI.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.23",
            "verseOrgIds": [
              "1KI.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwotini kimi pan, kïtuyö nko ngötïny kwam ngötïnyay chichay. Kimi portanyi arawet akimi sïkïryenyi nko ngötïnyay tïkwïl kughyongo kamasunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.24",
            "verseOrgIds": [
              "1KI.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpka pikö walaka akuwer atoni akïsöchï poray pö chi arawet nko ngötïny nyo kighyongo kamasunyi. Kïpa pïchay kimwatïta ompö kanasyanta Petel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.25",
            "verseOrgIds": [
              "1KI.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.25",
            "verseOrgIds": [
              "1KI.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kilïm werkyontonay le poyon ngalechoni, kïlö, “Werkoyontonay kipeny ngölyonto ECHOTYON nyoni! Nka nyoni köyonï ECHOTYON ngötïny kwam nyinte, kïrïp kegh nko ngölyonto ECHOTYON.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.26",
            "verseOrgIds": [
              "1KI.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchï werkachi, “Akarkara sïkïryenyan.” Kwigh chane lenyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.27",
            "verseOrgIds": [
              "1KI.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïweghö pontonay sïkïryenyi ntökïtuyeghö poray pö werkyon mi arawet kwen akitökïmi ngötïnytö nko sïkïrye kughyongo kamasunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.28",
            "verseOrgIds": [
              "1KI.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsït werkyontonay le poyon poray sïkïryenyi akïmïla kutang Petel atökïrirchï akïror. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.29",
            "verseOrgIds": [
              "1KI.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirorchï pïrïmpenyi akirirchï nko werkachi akimi kïlentöy, “Heywey werïnyo! Heywey werïnyo!” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.30",
            "verseOrgIds": [
              "1KI.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kiwany kïlenchï werkachi, “Ato arapasan, ororchanïn ato lekïto pïrïmponï pö werkoyon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.31",
            "verseOrgIds": [
              "1KI.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo itïtoy ngala cho kimwa nyinte ompö ECHOTYON kïchïp ato kïpelo amöros ompö Petel nko woptine walaka tïkwïl wölo kïsogho körkeyïntin ompö koro Samaria.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.32",
            "verseOrgIds": [
              "1KI.13.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngoki Yeropoam cho ghach",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.32",
            "verseOrgIds": [
              "1KI.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kitökïpïstö Yeropoam ortïnechi cho ghach, kitas tagh kïkïl tïsï kïpkana pich kïtïkon atökïpöghisyeghö ato kïsogho körkeyïntin. Kikïl nyinte chi nyo kimököy kïlïku tïsin. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.33",
            "verseOrgIds": [
              "1KI.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilïkwï ngokichoni ompö okuntanyi cho kiwany nyinte nko piko orengwa ompö ngwïny.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.34",
            "verseOrgIds": [
              "1KI.13.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Megha wero Yeropoam",
          "type": "text"
        }
      ]
    }
