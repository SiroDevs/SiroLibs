                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh ngat Solomon kipïchat anka tïkwïl nyo pö ECHOTYON kimina koltin ato kïpelo amöros akïmina koltin mesa nyo kitöni makatyan nyo kipöy tawu Echotyon ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
