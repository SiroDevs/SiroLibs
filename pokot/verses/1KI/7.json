          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31+EXO.25.32+EXO.25.33+EXO.25.34+EXO.25.35+EXO.25.36+EXO.25.37+EXO.25.38+EXO.25.39+EXO.25.40"
              },
              "items": [
                {
                  "text": "Wuw 25:31-40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïmina koltin cho pïchighöch karïn cho ghyongo tatïna kimi mutï okumpö tagh, kïmi mutï okumpö löt, ompö kot nyo mi ori akemina tapïkay nko tatïn nko nömöwo koltin ",
