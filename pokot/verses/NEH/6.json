    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kilïm Sanpalat nko Topiya nko Kesyem nyo le Marapyan nko pungköcha löwïr lö kyatekan nayatunay amelö tökïmi wölo pankas nko kimelö kyotönön tekech kukoti. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.1",
            "verseOrgIds": [
              "NEH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokwï kut Sanpalat nko Kesyem lö, “Nyonö keryamena kanasyan nyo mi tömko Ono.” Wölo kimököy chane kïrïmanïn. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.2",
            "verseOrgIds": [
              "NEH.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayontan kut olenchï, “Morökunanye wöloni, ompöwölo otïngetan ighisyö nyo wow akï ne topïstö ighisyö kughyö angwïn wölo omikwa.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.3",
            "verseOrgIds": [
              "NEH.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.3",
            "verseOrgIds": [
              "NEH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokwï kut ngat kïnyïl angwan le nyaye ayoktan kut tïkwïl le nyaye.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.4",
            "verseOrgIds": [
              "NEH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.4",
            "verseOrgIds": [
              "NEH.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokwï Sanpalat kut kïnyïl mut ompö palalyan nyo kipu mötworintenyi kï yatat ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.5",
            "verseOrgIds": [
              "NEH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyo kikir lö,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.6",
            "verseOrgIds": [
              "NEH.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.7",
            "verseOrgIds": [
              "NEH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olenchan nyinte, “Melö mi kïgh nyo lata nyoni ketamanyi chona onkït.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.8",
            "verseOrgIds": [
              "NEH.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.8",
            "verseOrgIds": [
              "NEH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimököy chane kwotyeghenecha lö, tökïmeghecha mutïnö mökïpöghisyö. “Wölo konante owesyö ye, we Tororöt!”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.9",
            "verseOrgIds": [
              "NEH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.9",
            "verseOrgIds": [
              "NEH.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owan nyu kö pö Syemaya wero Delaya wero Meetapel nyo kikïkörchï katanyi, kïlenchanïn, “Kepe kewïngena kegh Kö pö Tororöt* akekar kukoti, ompöwölo pkonöy kïpörinyi. Tïkon oghö nyo kapka kïparinyi.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.10",
            "verseOrgIds": [
              "NEH.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.10",
            "verseOrgIds": [
              "NEH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo olenchan, “Melö mïchini chi nyo lenye ani kuperta. Melö olentan towö Kö pö Tororöt lö tawïng kegh. Mowetanye.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.11",
            "verseOrgIds": [
              "NEH.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.11",
            "verseOrgIds": [
              "NEH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osöwan lö, melö köyonwanïn Tororöt Syemaya, wölo kal nyinte Topiya nko Sanpalat kungwïn kïmwowanïn ngalechï. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.12",
            "verseOrgIds": [
              "NEH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kikyal nyinte lö tökwotyeghenanïn ngalechoni aghan ngokï, atökïkonanïn kaynat nyo gha tökïmïnanïn.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.13",
            "verseOrgIds": [
              "NEH.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.13",
            "verseOrgIds": [
              "NEH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaghan lö, “We Tororötïnyu, rosa Topiya nko Sanpalat ompö ngalechï kegh chane nko Noadiya kokonï le werkoyon nko werkoy walaka cho mököy kwotyeghenanïn.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.14",
            "verseOrgIds": [
              "NEH.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiwangata teksyö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.14",
            "verseOrgIds": [
              "NEH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwany pipö Yaudi nayatunay ompö osis 52 asispa 25 nyo pö arawa Elul. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.15",
            "verseOrgIds": [
              "NEH.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kilïm pungköcha löwïr cho kiwitecha lenyoni, kuwöghisyö akïsïch arasï, ompöwölo kinkïtï lö kingarakecha Tororöt kewonyö ighisyonï.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.16",
            "verseOrgIds": [
              "NEH.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.16",
            "verseOrgIds": [
              "NEH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikirchini kegh palaltin chönökopïrtino Yuda nko Topiya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.17",
            "verseOrgIds": [
              "NEH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinomnyotö nyinte nko pipö Yuda walaka cho kile wökï, ompöwölo ki kapikoyo Syekania wero Ara akip werïnyi Yeoanan chepö Mesyulam wero Perekia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.18",
            "verseOrgIds": [
              "NEH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipka kïmwowanïn köromnyenyi akïpa kïmwochï nyinte ngalechan, kukirwanïn nyu Topiya palaltin kwotyeghenanïn.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.19",
            "verseOrgIds": [
              "NEH.6.19"
            ]
          }
        }
      ]
    }
