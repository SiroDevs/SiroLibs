          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlö pipö Lawi ompö Yeswö nko Kadmiel nko Pani nko Asyapneya nko Syerepiya nko Odia nko Syepania nko Petaya,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.5",
            "verseOrgIds": [
              "NEH.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sowut pö nganytaghata ngokï",
          "type": "text"
        }
      ]
    },
