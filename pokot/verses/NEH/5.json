          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kyalïman lokekwa anarekan nyoman ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.6",
            "verseOrgIds": [
              "NEH.5.6"
            ]
          }
        },
