          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwitï ngwïrngwïrönöto mïrön nko korukwa nyo akwompö pikökwa chini pö Yaudi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.1",
            "verseOrgIds": [
              "NEH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö walaka, “Anyï pöroyöch acha korïn kïmökecha omisyö nyo kïnömo monechï.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.2",
            "verseOrgIds": [
              "NEH.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.2",
            "verseOrgIds": [
              "NEH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlentöy walaka, “Kakitötecha parenicho nko pareni sapipun nko koricho tökenyorunö omisyö ompö kömöy.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.3",
            "verseOrgIds": [
              "NEH.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.3",
            "verseOrgIds": [
              "NEH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö walaka, “Kakïpösönöcha ropïyen tökekwaghteghena suru pöytoghin ompö parenicho nko pareni sapipun. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.4",
            "verseOrgIds": [
              "NEH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïchï so melö akonga kisönköcha nko chikwa? Anta mökörönye kegh so monekwa nko chicha? Akwanyï kakighacha monecho kïlïkwï sekey. Akikyaltecha tipicho walaka kïlïkwï sekey. Kikewongucha, ompöwölo kicheng pich walaka pareni nko pareni sapipun.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.5",
            "verseOrgIds": [
              "NEH.5.5"
            ]
          }
        }
      ]
    },
    {
