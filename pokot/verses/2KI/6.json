  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2KI 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipa asistanka werpö werkoy cho kintöghoghchini Elisya kïlenchï nyinte, “Kimarikit nyoman wölo kïmöngecha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.1",
            "verseOrgIds": [
              "2KI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pïswecha kepe Yordan ketörö ket atöketeka wölo kïmöngöy.” Kïlenchï Elisya chane, “Ape.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.2",
            "verseOrgIds": [
              "2KI.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.2",
            "verseOrgIds": [
              "2KI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsaghsagh akong Elisya ompö chane lö, “Nyonö kepe tïkwïl nko mötworiku.” Kïlö, “Owetan.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.3",
            "verseOrgIds": [
              "2KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïwö nko chane. Nyini kitïta chane Yordan, kïtör ket. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.4",
            "verseOrgIds": [
              "2KI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo otini kimi akong kïtöröy ket kïrarak oywenyi akïlït pögh kudong ketït. Kutegh lö, “Heywey, echotyontenyu! Kakïsom oywonini.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.5",
            "verseOrgIds": [
              "2KI.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.5",
            "verseOrgIds": [
              "2KI.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Elisya lö, “Onö otini köchïnchï nya?” Kuporchï chichay otini, kïrïny Elisya ket akïwirchï pöghechay, kïsyolï ketay oywonay kungwïn pögh parak. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.6",
            "verseOrgIds": [
              "2KI.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Elisya chichay, “Chengunö.” Kïchengwï chichay owyonay.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.7",
            "verseOrgIds": [
              "2KI.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakïrïnta lïko Sirya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.7",
            "verseOrgIds": [
              "2KI.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi asistanka ato kiporyot pöytoghinto Sirya nko Israel. Kurur kegh nko yetïntinekwa lö, “Kïteköy möngot atay syom.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.8",
            "verseOrgIds": [
              "2KI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïyonta Elisya chi wölo mi pöytoghinto Israel kïrirchï nyinte tömörik wöloni, ompöwölo mi pipö Sirya kusyepisyegho atoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.9",
            "verseOrgIds": [
              "2KI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta chi pöytoghinto Israel kïrirchï pipö wölaye kamwa Elisya. Kïtïpï chane kïpsach. Kirirchï lenyoni nyu, kesörï pöytoghintonay kïnyïl cho chang.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.10",
            "verseOrgIds": [
              "2KI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.10",
            "verseOrgIds": [
              "2KI.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtangany nyoman pöytoghinto Sirya ompö ngalechoni. Kïkur yetïntinechi akïtep lö, “Ngo ompö akwa nyo mi nko pöytoghinto Israel?” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.11",
            "verseOrgIds": [
              "2KI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï akong ompö chane lö, “Möminye chi, echotyon. Wölo werkoyon Elisya nyo mwochini pöytoghinto Israel kïgh anka tïkwïl nyo imwoghenyi, kïrkegh ngalanena kongu nyo pö ori.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.12",
            "verseOrgIds": [
              "2KI.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.12",
            "verseOrgIds": [
              "2KI.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï pöytoghintonay pikachi kïpa kïyar wölo mi Elisya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.13",
            "verseOrgIds": [
              "2KI.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kemwochï lö mi Elisya Dotan, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.13",
            "verseOrgIds": [
              "2KI.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïyonta pipö lïk cho chang, kïpa kanasyantanay oghökwen akurich. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.14",
            "verseOrgIds": [
              "2KI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kïnget mötworinto Elisya tökwoghö akïwö sany, kïlö arosïta kïsïwa pipö Sirya cho pö lïk, cho kimi nko angoletin nko nkarinekwa cho kirik kanasyantanay kuwit. Kïmïla akïlenchï Elisya, “Heywey echotyon! Kïlïku ne?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.15",
            "verseOrgIds": [
              "2KI.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.15",
            "verseOrgIds": [
              "2KI.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Elisya lö, “Mewöghisyö, kïtïngetecha söpïch nyo wow kïtïl cho tïng chane.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.16",
            "verseOrgIds": [
              "2KI.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïsagh Elisya lö, “Kaykay we ECHOTYON, yata konyichi atökïsïwa!” Kïyat ECHOTYON konyi mötworintonay kïsïwa lö kinyïghï angoletinö nko nkarino mot kutïng cho kiwit Elisya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.17",
            "verseOrgIds": [
              "2KI.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.17",
            "verseOrgIds": [
              "2KI.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kirökwï lïko pipö Sirya atökïporyö nko nyinte, kïsagh Elisya ECHOTYON lö, “Kaykay, ECHOTYON igha chane kïköryö!” Kwigh ECHOTYON pïchay kïköryö lenyini kigh Elisya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.18",
            "verseOrgIds": [
              "2KI.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Elisya akïlenchï chane, “Melö ore nyï amelö kanasyante nyete, apkana arïpkanïn, atoporwok chichini omörekwa.” Kumït chane kïpa Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.19",
            "verseOrgIds": [
              "2KI.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.19",
            "verseOrgIds": [
              "2KI.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kilït chane kanasyanta Samaria, kïsagh Elisya lö, “Kaykay yata konyikwa, we ECHOTYON, atökurosïta chane.” Kïyat ECHOTYON konyikwa, kïsïwa lö mi chane Samaria kwen.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.20",
            "verseOrgIds": [
              "2KI.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.20",
            "verseOrgIds": [
              "2KI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kisïwa pöytoghinto Israel lïkonay pö Sirya, kïtep Elisya lö, “Aparan chane? Aparanï?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.21",
            "verseOrgIds": [
              "2KI.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.21",
            "verseOrgIds": [
              "2KI.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Elisya lö, “Ewo, mepar chane. Mepara chokengu nko kïwantingu pich cho kenamanyi. Tönö chane makatin nko pögh aipïstö kïmïlonchö wölini mi echotyontengwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.22",
            "verseOrgIds": [
              "2KI.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwighchï nyu chane omisyö nyo wow, akwotini kiwany kwomisyö akïgheghsyö, kïpïstö kïpechï kegh, wölo mi echotyontengwa. Melö kitökïsetyï pipö Sirya ngat koro Israel kïngata atoni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.23",
            "verseOrgIds": [
              "2KI.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakirik kanasyanta Samaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.23",
            "verseOrgIds": [
              "2KI.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mi ato le löt, kïset pöytoghintö Pen Adad nyo pö Sirya tökïporyö nko Israel: kutö pikachi kusyep kanasyanta Samaria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.24",
            "verseOrgIds": [
              "2KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngwanit kömöy kanasyantanay tya ntökyaltegha möt pö sïkïryö ropïyeni silpa cho le 80, akyaltegha kïramtin 200 cho pö sïpöpö chepïrïm ropïyeni silpa cho le mut.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi asistanka ato kiwestoy pöytoghinto Israel kuweröy nayatu kanasyan, kïrirchï korka nyinte lö, “Ngarakante, we pöytoghin!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.26",
            "verseOrgIds": [
              "2KI.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.26",
            "verseOrgIds": [
              "2KI.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï pöytoghintonay nyinte lö, “Kingörokut ne nyo okoninyi atomengarakinyi ECHOTYON? Melö otïngetan nkanun anta dipay* cho okoninyi? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.27",
            "verseOrgIds": [
              "2KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nyo kesusinyi nya?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.28",
            "verseOrgIds": [
              "2KI.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö kokonay, “Kölenchanïn kokonï kyama werïngu asete atökyama nyinyan asista nyo rïptoy.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.28",
            "verseOrgIds": [
              "2KI.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.29",
            "verseOrgIds": [
              "2KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kilïm pöytoghintonay ngalechay, kïkarer sïrokachi kuporï nyarïltanyi, kïsïwa pich cho kilekïtö nayatunay lö kiloköy nyinte sarankwachtin ompö sïrokachi okumpö ori. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.30",
            "verseOrgIds": [
              "2KI.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö, “Osoghan Tororöt kïparanïn atomamutanye möt pö Elisya wero Syapat asisete!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi Elisya atoni kïtöpo konyi nko poy cho kirutochï nyinte. Otini kitomönye kwitï chichay kiyonï pöytoghintö, kïlenchï Elisya poyichay, “Köyonï pörintonay chi nyo ngwïnöy kïpöranïn. Akanyakwa nyu otini ketï yete akar kukat amopïsyï nyinte kïlïtï. Mi pöytoghintö kïrïpu nyinte.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.32",
            "verseOrgIds": [
              "2KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtomönye kuwany Elisya kïngalan, kwitï chichay kikiyokwï akïmwa lö, “ECHOTYON nyï kökonecha nyarïl nyo teno nyï! Tokönyan nyinte nyo pö ne?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        }
      ]
    }
