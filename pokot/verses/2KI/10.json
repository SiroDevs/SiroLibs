              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipayta Yeu Israel ompö Samaria könyis 28.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.36",
            "verseOrgIds": [
              "2KI.10.36"
            ]
