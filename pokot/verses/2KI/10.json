              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28+1KI.12.29+1KI.12.30"
              },
              "items": [
                {
                  "text": "1Pöy 12:28-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kipïstö Yeu ngoki Yeropoam wero Nepat nyo kigh pipö Israel kïsagh mogh nyo kikigha koltin ompö Petel nko Dan. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.29",
            "verseOrgIds": [
              "2KI.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Yeu, “Keghanyi nyo karam otini kerïpanyi ngalechan ipar pipö ara Aap. Nyo omwowunyi ye nyu lö oghan werïngu nyo pö pïnta nyo pö angwan kïlïku pöytoghinto Israel.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.30",
            "verseOrgIds": [
              "2KI.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kirïp Yeu ECHOTYON Tororöt pö Israel ompö mïkulöwunyi kïmïkul, melö kipïstö ngoki Yeropoam nyo kigh pipö Israel kwigh ngokï.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.31",
            "verseOrgIds": [
              "2KI.10.31"
            ]
          }
        }
      ]
    },
    {
