              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.24",
            "verseOrgIds": [
              "2KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kiwany Yeu kïropta amörostinechay kïpelöy, kïlenchï yetïntinechi, “Ape olïtö kö apar chane lömïs amakany kïchïwït ompö akong!” Kïpar askarinechay pïchay lömïs akuchutï mïntïruchkö kïpka sany. Atolapay kïlïtöy pïchay pö Yeu kot nyo pö saghat nyo pö ori, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.25",
            "verseOrgIds": [
              "2KI.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "akuchutï pchörï nyo kimi köyoni pö Paal akïpel. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.26",
            "verseOrgIds": [
              "2KI.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kunyar köyay kïsogho Paal akwigh kïlïkwï kö pö samï nko nyete le ye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.27",
            "verseOrgIds": [
              "2KI.10.27"
            ]
          }
        }
      ]
