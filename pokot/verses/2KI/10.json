          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmutïta ECHOTYON osiswechoni koro Israel kareran. Kirïnta pöytoghintö Asael koroswo Israel löwïr, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.32",
            "verseOrgIds": [
              "2KI.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "cho kimi lalwa Yordan antakwagh okumpö kongasis nko koro Kiliad nko nyo pö Kad nko nyo pö Rupen akïnam koro Manase kareran, kïngata Aroer nyo mi mpöghoghyo Arnon, nyoni kï Kiliad nko Pasyan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.33",
            "verseOrgIds": [
              "2KI.10.33"
            ]
          }
        }
      ]
    },
    {
