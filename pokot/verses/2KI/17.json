                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tökïrïpöy pïchoni otöptinechoni nko ye. Melö konyïtöy chane ECHOTYON anta rïp kirurutkachi löwïr cho kitö pipö ara Yakopo nyo kimïnchï nyinte kaynat anka kïkurö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 17:35"
          },
          "items": [
