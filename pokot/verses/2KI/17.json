              "items": [
                {
                  "text": "35:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kisagh pïchoni tïkwïl ECHOTYON akïkïl pich kïlïkwï tïsï ompö kwenungwa cho kitötoy ropöw ompö wölo kïsogho körkeyïntin. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.32",
            "verseOrgIds": [
              "2KI.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, kïkonyït chane ECHOTYON, wölo kisagh tororötinekwa tïkwïl kïrïp kegh nko otöptino pipö koroswechini kipkana chane.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        }
      ]
