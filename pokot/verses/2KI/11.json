      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kisïwa Atalia yoto Aasia lö kima werïnyi, kïmwatïta kepar monïng löwïr cho pö ara pöytoghintonay. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.1",
            "verseOrgIds": [
              "2KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïchïwït Yoas wero Aasia onkït. Kitökïpöröy nyinte tïkwïl, wölo kïsörï Yeosyepa chepö pöytoghin Yoram, chepkötanyi. Kingwïsa nyinte kwenu monïngo pöytoghi cho kirich kepar akïwö kïwïnchï pïrïnta nko chepto monïng tömapar Atalia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.2",
            "verseOrgIds": [
              "2KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpagh Yeosyepa monïngay ompö könyis mut nko akonga ompö Kö pö Tororöt otini kimi Atalia kïpöytoy.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo otini kitïta könyis mut nko odeny kïyonta tïsin Yeoyada chi kïkurï yetïntin cho kiripöy pöytoghin nko cho kiripöy kö pö soch kïpa Kö pö Tororöt akwigh chane kwam muma nyo pö kïgh nyo kimököy nyinte kwighöy, atolapay kuporchï chane weray pö pöytoghin Aasia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.4",
            "verseOrgIds": [
              "2KI.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïmwochï chane lö, “Ochöghekwa kïlïkwï söpïchis sömök cho oripsïyi, ripöy walaka kö pö pöytoghin ompö asispa Sapato,* ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.5",
            "verseOrgIds": [
              "2KI.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïrip walaka Kuka Sur, kïripsyeghö walaka kukat, lötu chay ripöy kö pö pöytoghin. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.6",
            "verseOrgIds": [
              "2KI.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ripsïyi söpïchischoni kwodeny, melö sïköy kimïny chane ompö asispa Sapato. Ripöy chane Kö pö Tororöt* nyo pö ECHOTYON atökïkarta pöytoghin. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.7",
            "verseOrgIds": [
              "2KI.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angwïsuna chokonikwo arip pöytoghin Yoas lasiny. Apar chi anka tïkwïl nyo lentöy olïtu kwenunkwa. Otïpï nko nyinte ompö wop anka tïkwïl wölo köwö.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.8",
            "verseOrgIds": [
              "2KI.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.8",
            "verseOrgIds": [
              "2KI.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh nyu yetïntinechay lenyini kömwochï tïsin Yeoyada akutötö pikökwa kïpa wölini kimi Yeoyada. Pich cho kitöpetöy kumungöy asispa Sapato nko cho kipetöy kïripsïyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.9",
            "verseOrgIds": [
              "2KI.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïropchï tïsin chane ngötwö nko longoy cho kipöghisyegho pöytoghintö Daudi cho kikïrorchï Kö pö Tororöt, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.10",
            "verseOrgIds": [
              "2KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïtïpïyö psach ripichay nko chokonikwa kïngata okumpö tagh nyo pö Kö pö Tororöt ntökwit okumpö ewu löt akuwit ato kïpelo amöros. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.11",
            "verseOrgIds": [
              "2KI.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kumït Yeoyada Yoas weray pö pöytoghin kïlït sany akulokyï mötïnyi kopïyö akutö palalyan nyo pö paytagh akwigh kïlïkwï pöytoghin, kuyila mwagh akurapach morïn akuteghyö lö, “Isöp nyo kogh, we pöytoghin!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.12",
            "verseOrgIds": [
              "2KI.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.12",
            "verseOrgIds": [
              "2KI.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kilïm pöytoghintö Atalia kiteghata ripï nko pich walaka, kurïp kutang Kö pö Tororöt wölo kimi söpïchoni, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.13",
            "verseOrgIds": [
              "2KI.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.3"
              },
              "items": [
                {
                  "text": "2Pöy 23:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kïsöchï köyoni pöytoghin nyo rel ghyongo atolekïto pchörï le wölo kilata osïltinekwa osiswechoni. Kiwit yetïntinö nyinte nko pich cho kikutöy kontin akimi pich kuteghyot ompö ngörekyö akïkutöy kontinekwa. Kïkarer Atalia sïrokachi ompö nyarïl akïrir lö, “Wököt! Wököt!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.14",
            "verseOrgIds": [
              "2KI.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.14",
            "verseOrgIds": [
              "2KI.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï tïsintonay le Yeoyada askarinechay kiripöy köyay pö ECHOTYON lö, “Onömunö nyinte kungwïna kwenu pich. Ato mi chi anka tïkwïl nyo lentöy otököwu nyinte apar tïkwïl.” Kimwa tïsintononi lenyoni ompöwölo melö kimököy kepörchini Ataliya Kö pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.15",
            "verseOrgIds": [
              "2KI.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnam chane kokonay, akuchut kutang kö pö soch, akïpa kïpörchï kukat nyo lïtöy angoletinö.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.16",
            "verseOrgIds": [
              "2KI.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kegh Yeoyada tïkwïn kuten",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.16",
            "verseOrgIds": [
              "2KI.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwam Yeoyada muma* nko ECHOTYON nko pöytoghin Yoas nko pïchoni lö lïku chane pipö ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.17",
            "verseOrgIds": [
              "2KI.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa nyu pïchoni löwïr kutang kö nyo kikïsogho Paal* akïngany, atolapay kurultö ato kïpelo amöros akunyar körkeyïntin cho kïsoghöy akïpar Matan tïsinto Paal ompö atoni kïpelo amörostin. Atolapay kutö tïsin Yeoyada ripï kïrip Kö pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.18",
            "verseOrgIds": [
              "2KI.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumïtuna yetïntino lïk nko askarin cho kiripöy pöytoghin nko cho kiripöy kö pö soch akumïtuna pöytoghintonay Kö pö Tororöt ntökwitï köyay pö soch, akimi pich löwïr kïrïpöy löt. Kïlït Yoas Kuka Ripï akïwö kïtöpö ngacharunyi nyo pö paytagh. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.19",
            "verseOrgIds": [
              "2KI.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingörekyö pich tïkwïl cho kimi kanasyan. Kïwïs kanasyantanay otini kikïpar Atalia ompö kö pö pöytoghin.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.20",
            "verseOrgIds": [
              "2KI.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.20",
            "verseOrgIds": [
              "2KI.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutor Yoas kïpayta koro Yuda otini kitïng könyis mut nko odeny.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.21",
            "verseOrgIds": [
              "2KI.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pöytoghin Yoas nyo pö Yuda",
          "type": "text"
        }
      ]
    }
  ],
