            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyokyï nyinte pipö Israel koroswekwa löwïr kïngata Amat ompö okumpö löt ntökwit nanampa Paryan, kïrïp kegh nko ngölyonto ECHOTYON, Tororöt pö Israel, nyo kimwochï mötworintenyi werkoyon Yona wero Amitay nyo kingwïno kanasyanta Kat Eper.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
              "2KI.14.25"
            ]
          }
        }
