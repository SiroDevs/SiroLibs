          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïma Yeropoam aketïpchï pïrïmpoti pöytoghï, kuker werïnyi Sakaria kïpayta.",
          "type": "text",
