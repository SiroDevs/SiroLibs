              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïwa ECHOTYON wölo kikichopta kong pipö Israel ato kö ratate anta tyakate kïmelö kimi chi nyo kingarak chane. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.26",
            "verseOrgIds": [
              "2KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kökimwa ECHOTYON lö, owongöy pipö Israel ompö ngwïny, kïlenyona kïsörï nyinte chane ompö Yeropoam wero Yoas.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        }
