          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kuyokyï Elisya lö, “Kile ato söpöy ECHOTYON nko nyi, melö opïstoninyi kokay.” Kïpa nyu chane kwodeny ntökwitïta Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        }
