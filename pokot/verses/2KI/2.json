          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Elisya kïpusta kutïng pö Karmel, atolapay kïmïla Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.25",
            "verseOrgIds": [
              "2KI.2.25"
            ]
          }
