                {
                  "text": "Esk 17:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimït Nepukadnesa Yeoyakin le mampusyon kutang Papilon nko kame nko koruchi nko kirwokotichi nko kintöghoghi koro Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.15",
            "verseOrgIds": [
              "2KI.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirang Nepukadnesa pich löwïr cho le nyökon, pich 7,000 nko cho le tïngon ompö ighisyeghut nko kitongï 1,000, pich löwïr cho owesöch akimuköy kïpetöy poryot. Kïrang pöytoghintö Nepukadnesa kutang Papilon.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.16",
            "verseOrgIds": [
              "2KI.24.16"
            ]
          }
        }
      ]
    },
