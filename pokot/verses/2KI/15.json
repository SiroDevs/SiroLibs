          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirapas Menaem ketïpchï pïrïmpoti papotïnechi, kuker werïnyi Pekaya kïpayta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.22",
