          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrïp Yotam otöpto paponyi Usia kwigh nyo karam ompö tawu ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.34",
