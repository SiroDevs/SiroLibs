              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrapas Yotam aketïpchï pïrïmpoti pöytoghï nyo kimi Kanasyanta Daudi, kuker werïnyi Aas kïpayta.",
          "type": "text",
          "attrs": {
