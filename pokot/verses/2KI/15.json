            }
          ]
        },
        {
          "text": "Kirote ighisyewut löwïr cho kigh Menaem kitapu “Otöptino osiswo pöytoghi Israel.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.21",
