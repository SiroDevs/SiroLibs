          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng nyinte könyis 25 atoni, kïpayta könyis 16 ompö Yerusalem. Kikuro kame Yerusya chepö Sadok. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.33",
            "verseOrgIds": [
