        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.11",
            "verseOrgIds": [
              "2KI.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwitïta nyu lö man ngölyonto ECHOTYON nyo kimwochï Yeu lö, “Lïku piko orenkwa pöytoghi Israel ntökuwer pïnwöy angwanï!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
            "verseOrgIds": [
              "2KI.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pöytoghin Syalum nyo pö Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
