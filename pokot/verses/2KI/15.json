          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilïkwï Sakaria wero Yeropoam pöytoghinto Israel ompö könyi 38 ompö paytaghpa Asaria pöytoghinto Yuda. Kipayta Sakaria aro mut nko akonga ompö Samaria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.8",
            "verseOrgIds": [
              "2KI.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh nyinte ngokï ompö tawu ECHOTYON le papotïnechi. Kichömchï nyinte pipö Israel kïsagh körkeyïntin le Yeropoam wero Nepat. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.9",
            "verseOrgIds": [
              "2KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwöch Syalum wero Yapes Sakaria akïpar ompö tawu pich ompö Ipleam akïpayta kuker nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.10",
            "verseOrgIds": [
              "2KI.15.10"
            ]
          }
        }
      ]
    },
    {
