          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh nyinte ngokï ompö tawu ECHOTYON, le pöytoghin Yeropoam wero Nepat nyo kigh pipö Israel kwigh ngokï. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
