            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.2+2CH.4.3+2CH.4.4+2CH.4.5+2CH.4.6"
              },
              "items": [
                {
                  "text": "2Ot 4:2-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngam pöytoghintö Aas söremwok pö ato kïpelo amörostin nyo kikigha taghoy akïcheng otupö ompö ori nko tanki tay nyo kighyongo paraku kir. Atolapay kutö koghïn cho kikïtat. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.17",
            "verseOrgIds": [
              "2KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimököy Aas ngat kwighöy pöytoghinto Asirya kïngarak, kïlenyona kïchenga Kö pö Tororöt kïgh nyo syolote nyo kipöghisyegho pöytoghintö akïkar kukat nyo kilïtöy pöytoghintö onkït asispa Sapato* otini wetöy Kö pö Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        }
      ]
    },
