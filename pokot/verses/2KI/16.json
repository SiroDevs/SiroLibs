            "sid": "2KI 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilïkwï Aas wero Yotam pöytoghinto Yuda ompö könyi 17 ompö paytaghpa Peka wero Remalia, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.1",
            "verseOrgIds": [
              "2KI.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kitïng nyinte könyis tömönut odeny. Kïpayta könyis 16 ompö Yerusalem. Wölo melö kigh nyo karam ompö tawu ECHOTYON Tororötïnyi le kwanta pöytoghin Daudi, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.2",
            "verseOrgIds": [
              "2KI.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.31"
              },
              "items": [
                {
                  "text": "Krt 12:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kirïp otöptino pöytoghi Israel. Kitötö nyini le werïnyi kegh kïlïkwï amöros le otöptino pipö punton cho kiyona ECHOTYON tawu pipö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.3",
            "verseOrgIds": [
              "2KI.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitötö Aas amörostin nko tïkwïn cho ngutoy cho onyïn ompö wölo kïsogho körkeyïntin nko kutïngkot nko ghïtwöyi ket cho nyörilöch.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.4",
            "verseOrgIds": [
              "2KI.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
