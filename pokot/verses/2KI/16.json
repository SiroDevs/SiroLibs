          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.4",
            "verseOrgIds": [
              "2KI.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.1"
              },
              "items": [
                {
                  "text": "Isa 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïporyeghö kanasyanta Yerusalem pöytoghinto Sirya nko Peka wero Remalia pöytoghinto Israel akurich, wölo melö kimï chane kïrïnta Aas. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnam Resin pöytoghinto Edom osiswechoni kanasyanta Ela akïyon pipö Yuda cho kimöngöy kanasyantanoni. Kïmang nyu pipö Edom Elat atökïmöngöy nko nyete le ye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta Aas pich wölo mi Tikla Pileser pöytoghinto Asirya akïlenchï, “Ochan mötworintengu, kïlenyona, nyonö sörwonte achïwïta pöytoghinto Sirya nko nyo pö Israel, mi chane kïporyot nko ani.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.7",
            "verseOrgIds": [
              "2KI.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcheng ngat Aas kari silpa nko koltin cho ki mi Kö pö Tororöt* nko cho kimi kö pö paytagh akïwö kïropchï pöytoghinto Asirya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kughönchï pöytoghintonay pö Asirya Aas ngalechi. Kïyonta söpïch pö lïk kïpa Damaska kïnam kanasyante akïpar pöytoghinte akïrany pikö kutang Kir.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kiwö pöytoghintö Aas ntökwit Damaska, atökïtuyö nko Tikla Pileser pöytoghinto Asirya, kïsöchï wöloni ato kïpelo amöros, kïcheng akuyoda kutö tïsin Uriya atökwigh anka nyo karkegh laras nko nyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.10",
            "verseOrgIds": [
              "2KI.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïtek Uriya tïsin ato kïpelo amöros nyo kikarkegh nko nyini kiyokunö pöytoghintö Damaska akuwany otini kitomönye kïmïla Aas. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.11",
            "verseOrgIds": [
              "2KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kimïlegha Aas Damaska, kïsïwa lö kiketek ato kïpelo amöros kuwonyö, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.12",
            "verseOrgIds": [
              "2KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïpela nyu atoni amörostino kyak akïropta pagh akïmïlchï dipay* atoni cho kïroptoy nko kisön cho pö pöghisyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.13",
            "verseOrgIds": [
              "2KI.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.1+EXO.27.2"
              },
              "items": [
                {
                  "text": "Wuw 27:1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.1"
              },
              "items": [
                {
                  "text": "2Ot 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinategha Aas ato kïpelo amöros nyo kimi tawu ECHOTYON ompö kwenu ato kïpelo amörostin nko Kö pö Tororöt, kutang ewu löt nyo pö ato kïpelo amöros nyo kötöketeköy. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïmwochï pöytoghintö Aas Uriya lö, “Pöghisyeghenö ato pöro kïpelo amöros katekan, pela amörostin tökwoghö nko ropöwo pagh cho pö nangat nko ropöwo kyak cho kïpelöy nko pagh cho kïroptoy cho pö pöytoghin nko pich nko cho pö pich cho kïroptoy ompö dipaytinekwa. Imïlchï atoni kisönko kyakichoni löwïr kïpelöy kïlïku amörostin. Wölo irip karïnanay pö taghoy kïpelo amöros atopöghisyeghan angora tïkwïn cho tökïpkonöy.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.15",
            "verseOrgIds": [
              "2KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh Uriya lenyini kömwochï pöytoghintö",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.16",
            "verseOrgIds": [
              "2KI.16.16"
            ]
          }
        }
      ]
    },
