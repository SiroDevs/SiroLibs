          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kilïm pipö Moap lö kipus pöytoghichoni kï sömök korengwa atökïporyeghö chane, kïkur pich löwïr cho kimuköy kïporyö, kïngata nyo wow tya ntökwit nyo mïnïng aketö chane kusyepisyeghö rotyo korengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.21",
            "verseOrgIds": [
              "2KI.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö kïnget ato le asïyech, kiköryol asis pögh kïpïröchitu le kisön! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.22",
            "verseOrgIds": [
              "2KI.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö chane, “Heywey! Kipka kisön! Töptoy kiporyö pöytoghichay akïpar kegh chane! Kepe nyu kechenga tïkukwa ompö wölini le möngengwa!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.23",
            "verseOrgIds": [
              "2KI.3.23"
            ]
          }
        }
      ]
    },
