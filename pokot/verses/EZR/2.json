              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monïngo tïsï walaka cho melö kirumï arengwa kï: Apaya nko Akos nko Parsilay (nyo kip korkenyi ompö tipi ara Parsilay nyo pö Kiliad akekurteghö nyinte kaynengwa.) ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.61",
            "verseOrgIds": [
              "EZR.2.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "EZR 2:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo melö kirumï arengwa ompö kitapun, kimelö kikïchömchï chane kïlïkwï tïsï. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.62",
            "verseOrgIds": [
              "EZR.2.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "EZR 2:63"
