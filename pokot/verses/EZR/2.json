        },
        {
          "text": "Kimïlisyeghö pïnotön pich cho chang cho kirang Nepukadnesa pöytoghinto Papilon korenyi Papilonia le ratan. Kimïlisyö Yerusalem nko Yuda akïwö chi tïkwïl kanasyantenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.1",
            "verseOrgIds": [
              "EZR.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kintöghoghikwa kï Serupapel nko Yoswö nko Neemia nko Seraya nko Reelaya nko Mordekay nko Pilsyan nko Mispar nko Pikpay nko Reum nko Paana. Achï pïpö artïna Israel löwïr cho kimïlisyeghö pïnotön:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.2",
            "verseOrgIds": [
              "EZR.2.2"
            ]
          }
        }
      ]
    },
