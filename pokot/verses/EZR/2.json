          },
          "items": [
            {
              "text": "69",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitötö nyu chane kïrïp kegh nko owesyengwa ompö ighisyononi, koltin kilen 500 nko silpa kilen 2,800 nko sïro pö tïsï 100.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.69",
