            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.24+JOS.7.25+JOS.7.26"
              },
              "items": [
                {
                  "text": "Yos 7:24-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Soghanïn chane akuyakwïy kechiryekwa nko twakwa kor nyo le tömkö nyo pö Syaron nyo mi okumpö ta akïpa ntökwitïta Mpöghogh Kömpölelyö nyo mi okumpö kongasis.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.10",
            "verseOrgIds": [
              "ISA.65.10"
            ]
          }
        }
      ]
