              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwochini ECHOTYON pikachi lö, “Otini kyalïkukwa sekey, melö kimi ropïyen cho kikïghakta töketyakakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwatanya kyapekwa amang koro Misri le pïnot, apekwa akwane ompö machatengwo kegh, wölo kipka pipö Asirya kïrangakwa ompö owesyö amelö kimi kïgh nyo kyalenakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.24"
              },
              "items": [
                {
                  "text": "Rum 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anyï ye nyu kegha kïgh nyo lata nyoni ompö koro Papilon. Ochikwa rötote akï möminye kïgh nyo kikyalenakwa. Kwolöy kegh pïchoni pöytonokwa akunisonchö akïsasanïn. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onkïtunekwa ompö osis cho pkonöy lö ochan Tororöt akwani nyo kongölonwokwa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
