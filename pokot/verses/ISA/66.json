                  "text": "Ist 7:49-50",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoghöy ECHOTYON lö, “Ngacharunyan wölnö le yïm akï kelto ngacharunyan ngwïnya. Kï kö nyo nen nyu nyo omukekwa otekwanïn? Akï yonö ato oghwanïkwa atamangan? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 66:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kegh nyo kyagh wölnö le mïröt kïmïkul! Ochan ngarakate ompö pich cho ipöy kegh ngwïny akïkötoy lelutkökwa akuwöghanïn akïterwanïn ngalechu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 66:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 66:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ighöy pich le wölo kömöktoy. Karkegh ompö chane ato kapar egh akwigh kïlïkwï amöros anta tötö ptangengmöt kïlïkwï amöros. Ato ketötö wawa kech anta karïng katpa kukïy. Ato ketötö pagh cho kïroptoy anta kisön pö nkïruwen. Ato ketötö mankoy cho ngutoy cho onyïn anta sagh körkeyïn. Pïlilöy chane nyoman ortïn cho kïrïpöy ato kïsoghöy. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 66:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona opchinan kiwurat nyo nyoruno tïkuchini otyegho chane, ompöwölo puryö chi nyo kingitön otini kyokursyan anta lïm ngölyontenyan otini kyongölonchan.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 66:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 66:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atere nyu chona opotonchot, ateköy ECHOTYON, kïgh nyo mwowokwa nyinte lö, “Wöchokwa pikökwa walaka ompöwölo oghönanïkwa amelö tïngenokwa kïgh chane. Ngemokwa chane kïlentöy, ‘Akanya kuporï ECHOTYON töroryenyi kïsörwokwa atökesïwenacha ato oturönchokwa.’ Wölo chane cho sïköy arasï! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 66:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atera kiteghat nyo kïlïmo kanasyan! Ngwïno kiteghatanoni Kö pö Tororöt.* Kechop kong ECHOTYON pungkachi nko nyoni pö kiteghatanoni!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.6",
            "verseOrgIds": [
              "ISA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 66:6"
