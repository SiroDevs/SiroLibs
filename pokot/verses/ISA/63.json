                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïmölyöngwï ECHOTYON lö, “Kopïrön pipö punton le sapipun amelö kimi chi nyo kingwïn kungarakanïn. Kyonyerön chane ompöwölo kyanarekan. Nka nyoni kighömï kisönkökwa sïroköchan. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 63:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyamwaghan lö kikwitïta ato kïsöru piköchan. Ketïta nyu ato kichopöy kong pungkökwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.4",
            "verseOrgIds": [
              "ISA.63.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 63:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.16"
              },
              "items": [
                {
                  "text": "Isa 59:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kyotöngönchan otini kimasïwanye chi nyo kingwïn kungarakanïn. Wölo kikonanïn nörekyenyan nyakanat, arïntan nyu ante poryenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.5",
            "verseOrgIds": [
              "ISA.63.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 63:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyatïkatïkan pipö punton kïmïkul ompö nörekyenyan, arïngarïngan chane, amïlchan kisönkökwa ngwïny.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.6",
            "verseOrgIds": [
              "ISA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Köromnyo ECHOTYON ompö Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 63:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.6",
            "verseOrgIds": [
              "ISA.63.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 63:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwotïtonan köromnyo ECHOTYON,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 63:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 63:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlö ECHOTYON, “Piköchan chane, melö lïsanïn.” Kïlenyona kisörunö chane ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.8",
            "verseOrgIds": [
              "ISA.63.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 63:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyarïltangwa. Melö ki malaykayan, wölo nyinte ECHOTYON nyo kisörï chane. Kisörï chane ompö chomnyenyi nko ompö kisyonötenyi. Kiripöy nyinte chane ato le tagh kïnomnyö, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 63:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wölo kïpeny ngalechi akwigh nyinte kuwongwï ompö chane. Nka nyoni kilïkwï ECHOTYON punyontengwo nyo kiporyeghö chane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.10",
            "verseOrgIds": [
              "ISA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 63:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.10",
            "verseOrgIds": [
              "ISA.63.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 63:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kunan nyinte osis cho kipö könyisyok, osiswo Musa, mötworinto ECHOTYON. Kïtep chane lö, “Köwö onö ye nyu ECHOTYON nyanya kisörï kintöghoghiko pikachi atanya kiweröy kwenu nanam? Köwö onö ECHOTYON nyanya kitö Musa Mïkulöwunyi nyo tïlil, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.11",
            "verseOrgIds": [
              "ISA.63.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 63:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.21"
              },
              "items": [
                {
                  "text": "Wuw 14:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nyanya kintöghoghchï ompö ewunyi nyo awes akwigh tïkwïn cho echön kuwerï Musa? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.12",
            "verseOrgIds": [
              "ISA.63.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 63:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyanya kipesyö pögho nanam akuntöghoghchï pikachi kuwer pögh ori atökïsïkï kegh öroryö nyo pö kokay?”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.13",
            "verseOrgIds": [
              "ISA.63.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 63:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kintöghoghchï ECHOTYON, kuwer chane pögh ori le angoletin cho weröy kor wölo le surkwen ompö kelyekwa akï melö pïtyot. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.13",
            "verseOrgIds": [
              "ISA.63.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 63:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïle ato kïrongöy tïch wölo wow suswon, kutö ECHOTYON pikachi kimïny lenyoni. Kintöghoghchï pikachi akutö konyït kaynatenyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.14",
            "verseOrgIds": [
              "ISA.63.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saghata kisyonöt nko kingarakat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 63:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.14",
            "verseOrgIds": [
              "ISA.63.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 63:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Topönö ngwïny ompö yïm, we ECHOTYON, aitopön ompö wölini le möngengu ompö tïlilyengu nko töroryengu. Köwö onö sïngatengu nyo wow ompö acha? Köwö onö owesyengu? Köwö onö chomnyengu nko kisyonötengu? Inanecha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.15",
            "verseOrgIds": [
              "ISA.63.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 63:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo ichinyi paponcha, kïrkegh kïmenkïtechanye kukötinecho ompö Apraam nko Yakopo, wölo nyi, we ECHOTYON nyo ichï paponcha. Nyi nyaye isörwecha kïnomnyö. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.16",
            "verseOrgIds": [
              "ISA.63.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 63:17"
          },
          "items": [
            {
              "text": "17",
