          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtepsyö pich lö, “Kï kölö ne tökelokyï sïro cho pïröch lö tök, le chi nyo pïröy pögho sapipun tökegh kïlïkwï dipay?”*",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.2",
            "verseOrgIds": [
              "ISA.63.2"
            ]
          }
        }
      ]
    },
    {
