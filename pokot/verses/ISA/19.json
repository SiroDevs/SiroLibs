                  "type": "text"
                }
              ]
            },
            {
              "text": "Esk 29:1–32:32.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anyï ngölyon nyo ngölono koro Misri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itu ECHOTYON koro Misri, akungwïno poltoy cho ryöghöy lawel. Potonchegho körkeyïntinö tawunyi cho soghöy pipö Misri. Wonyegho nyu nyakanat pïchoni pö Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owulyenan pipö Misri kïpar kegh chane nko chane. Poryot nyu chi anka tïkwïl nko werïngwa, akïporyö chi anka tïkwïl nko pöröryenyi, setïni kanasyanta kïpar kanasyante anka, akïpar kegh pöyunötö nko pöyunöte anka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonyegho sirmoy lakaw pipö Misri, akwanykwanyan kinonutkökwa, atökïpa chane kïtepata kapolöktin kungarak chane, akïpa kïtep akïsom kingarakat mïkulis pö pich cho mi ngwen. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otöninan pipö Misri chi nyo körom, pöytoghin nyo mötïngnye kisyonöt.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngörïngitu pögho Nile, akïtomönye kite kïtenyö, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.5",
            "verseOrgIds": [
              "ISA.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngutoy champilwoyichi kïtomö kïtenyö lakaw. Silonchot suswö cho pito sörömu lalwa Nile akïyomö. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.6",
            "verseOrgIds": [
              "ISA.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yomsot tïkwïl pagh löwïr cho kikïngor sörömu lalwa Nile akïkutata yomat. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riröy chi anka tïkwïl nyo le pöghisyenyi namata kaghagh ompö lalwa Nile. Puryö kïgh nyo tökwigho moyontinekwa nko netinekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.8",
            "verseOrgIds": [
              "ISA.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meghsot ngat mutïnö pich cho keghöy sïro pö katani, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.9",
            "verseOrgIds": [
              "ISA.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "meghsot mutïnö pich cho nöpöy sweten nko pich tïkwïl cho chïreröch cho nömöy mïsyara.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.10",
            "verseOrgIds": [
              "ISA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.10",
            "verseOrgIds": [
              "ISA.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wechï sölwöy kintöghoghi kanasyanta Soan! Ruröy pich pipö Misri cho ngöghomöch ompö ngala sölwontön! Muköy chane lö ne kïlenchini pöytoghintengwa, chane cho tïpisot ngöcherwo pipö köny cho ngöghomöch cho kile pöytoghï? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi onö piköku cho ngöghomöch cho ruröy pich, nya we pöytoghinto Misri? Töptoy muköy chane kïmwowunyi tötut cho tïng ECHOTYON Kimuktoghin ompö koro Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.12",
            "verseOrgIds": [
              "ISA.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sölwöy kintöghoghi Soan nko cho pö Mempis. Ki parakungwa kuntöghoghchï pikökwa, wölo kuntöghoghchï chane kïchumponchö. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.13",
            "verseOrgIds": [
              "ISA.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ECHOTYON nyo kegh chane kïkwanykwany kirurötengwa. Ato mi lötï, kwigh pipö Misri kïgh anka tïkwïl kunyara akïwestotö le chi nyo le ptamasyan nyo pïtyini wölini kengwunchï. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.14",
            "verseOrgIds": [
              "ISA.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möminye chi nyo le ompö akonga ompö koro Misri, nyo muköy kutöni chitö anka kingarakat, kïrkegh kö monkoryon anta meywon anta nyo pöyu pich anta nyo kötompöroryö.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.15",
            "verseOrgIds": [
              "ISA.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Soghöy pipö Misri ECHOTYON",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.15",
            "verseOrgIds": [
              "ISA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itu asis ato nyökoritu pipö Misri le kor. Mïghsot chane ompö otyogh otini kasïwa lö keghïtö ECHOTYON Kimuktoghin ewunyi atökunyaril kong chane. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.16",
            "verseOrgIds": [
              "ISA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïlïku koro Yuda otyogh ompö pipö Misri, wöghisïyi chi anka tïkwïl nyo kïmwochini ngalechoni, ompö kïgh nyo kikïtat ECHOTYON Kimuktoghin ompö chane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngölonöy asisoni kuti pipö Kanan kanastin mut ompö koro Misri akuwolwolsyö lö kïrïpöy ECHOTYON Kimuktoghin. Kuro kanasyan akonga, “Kanasyanta Asis.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato itï asisoni, kesöchï koro Misri wölo kïpelchinegho ECHOTYON amörostin nko kogh nyo le pchörï nyo kïropchini nyinte ompö rotyo korononi pö Misri, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.19",
            "verseOrgIds": [
              "ISA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "cho poru söwintön lö mito ECHOTYON Kimuktoghin koro Misri. Ato rirchï ECHOTYON ompö korononi cho kakichop kong, kïyonchï nyu chi chane nyo ghetöy. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porchini kegh ECHOTYON pipö Misri, atolapay kïwöghokisyö chane akïsagh nyinte, akïropchï nyinte ropöw nko amörostin. Atolapay kwomchï chane ECHOTYON muma akwigh kïrïp kegh nko kiyomisötengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Töni ECHOTYON nyarïl pipö Misri, wölo sopöy chane ato le lötï. Wöghökyini kegh nyinte, akïterchï chane sowutkökwa, akusop.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato itï asisoni, kïrumï or nyo wow nyo ngetuno koro Misri ntökwit koro Asirya, atökïpka pipö Asirya koro Misri, kïpa cho pö Misri koro Asirya. Soghöy nyu puntonichoni kwodeny tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.23",
            "verseOrgIds": [
              "ISA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato itï asisoni, kutuyö kegh pipö Israel nko cho pö Misri nko cho pö Asirya. Lïku puntonichoni kïsömök kisoyönöt ompö ngwïny kïmïkul. ",
          "type": "text",
