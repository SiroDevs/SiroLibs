              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.29",
            "verseOrgIds": [
              "ISA.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighöy ECHOTYON chi anka tïkwïl kïlïmöy kutinyi nyo pö töroryö atökuporchï chane wölo nïkis kïlïkwï nörekyenyi. Kïsïwïyi atoni lyopötin nko kiryal nko takarïstin nko rop nyo ipu chepkiriritin. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.30",
            "verseOrgIds": [
              "ISA.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otyot tya pipö Asirya atoni lïmöy kuti ECHOTYON nko nïkisïnto kichopatenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.31",
            "verseOrgIds": [
              "ISA.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumöy pipö ECHOTYON cho pöghisyegho tokigh nko pïkantis otini mito nyinte kulïwöy chane kuloyö. Nyinte Tororöt nyo poryegho pipö Asirya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.32",
            "verseOrgIds": [
              "ISA.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ISA 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikigh könyisyok wölo kinagha ma nyo wow nyo kïpelo pöytoghinto Asirya. Kiröytö to akïtapes, akenyïghit kwen kutïkumö. Kutini ECHOTYON kimïny nyo ngwïnöy le puseryonto ma nyo pelöy atoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.33",
            "verseOrgIds": [
              "ISA.30.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
