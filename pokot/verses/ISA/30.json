            "number": "27",
            "style": "v",
            "sid": "ISA 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsöchini owesyö ECHOTYON nko ororyenyi wölo low. Poru man nko ighot nörekyenyi. Ngölonu nyinte, kïwöghökisyö ngalechi kïpelsyö. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.27",
            "verseOrgIds": [
              "ISA.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutïtoy yomat ompö tawunyi nyo karkegh nko puseryon nyo chutöy kïgh anka tïkwïl. Chutöy pipö punton kïlïtöy wölo mi kiwurata atökuwany tötutkökwa cho ghach. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.28",
            "verseOrgIds": [
              "ISA.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ongörekyokwa cho ochï pipö Tororöt, atum le wölo odokwa nangat ato kyomöy akor nyo tïlil. Ongörekyenö le pich cho kutöy pkurerun akïpetöy kïpustoy Kö pö ECHOTYON Tororöt nyo le ghetöy Israel.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.29",
            "verseOrgIds": [
              "ISA.30.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 30:29"
          },
          "items": [
            {
