                "loc": "ISA.14.1+ISA.14.2+ISA.14.3+ISA.14.4+ISA.14.5+ISA.14.6+ISA.14.7+ISA.14.8+ISA.14.9+ISA.14.10+ISA.14.11+ISA.14.12+ISA.14.13+ISA.14.14+ISA.14.15"
              },
              "items": [
                {
                  "text": "Isa 14:1-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Yer 50:1–51:64.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyï ngölyon nyo ngölono Papilon nyo kimwochï Tororöt Isaya wero Amos.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.1",
            "verseOrgIds": [
              "ISA.13.1"
            ]
          }
        }
      ]
