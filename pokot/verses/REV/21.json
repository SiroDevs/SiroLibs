            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.15",
            "verseOrgIds": [
              "REV.21.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.3"
              },
              "items": [
                {
                  "text": "Esk 40:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitïng malaykayantanoni kingölonwanïn lïkïp nyo pö koltin nyo kipimtoy atökupima kanasyantanoni, kipima kukotichi nko nïyetkachi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.15",
            "verseOrgIds": [
              "REV.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwit kanasyantanoni nïyet angwan cho kikarkegh koghïntö nko töpesïntö. Kupima malaykayantanay kanasyantanay lïkïnyi akïnyorï lö kit kilomiten 2,400 ompö koghïn nyo kikarkegh nko töpesïn nko kepus parak. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.16",
            "verseOrgIds": [
              "REV.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupim tïkwïl malaykayantanay lö kiwö parak kïtya nayatu, kïnyorï lö ki miten 60, kïrïp kegh nko wölo pimtoy pich. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.17",
            "verseOrgIds": [
              "REV.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
