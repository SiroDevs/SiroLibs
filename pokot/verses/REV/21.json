                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Pestegho pipö ngwïny löpoyïntanyi akwipchini pöytoghi ngwïny mökosyengwa kanasyantanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.24",
            "verseOrgIds": [
              "REV.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "REV 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpïstö kukoti kanasyantanoni kïyotote kwimön ompöwölo melö tökïmi nangatï wöloni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.25",
            "verseOrgIds": [
              "REV.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
