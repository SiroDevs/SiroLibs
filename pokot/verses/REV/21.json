              "items": [
                {
                  "text": "2Pt 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay asïwan yïm nyo rel nko ngwïny nyo rel. Kikuwer yïmö nko ngwïny nyay pö tagh amelö kitökïmi nanam ngat. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.1",
            "verseOrgIds": [
              "REV.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.1"
              },
              "items": [
                {
                  "text": "Isa 52:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.10"
              },
              "items": [
                {
                  "text": "61:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.12"
              },
              "items": [
                {
                  "text": "Ngo 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Asïwan Kanasyan nyo tïlil, Yerusalem nyo rel, kïrökunö yïm wölo mi Tororöt, kanasyan nyo kikipïch lasiny akïmi kïpsach, le mïrar nyo nopchini kegh santenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.2",
            "verseOrgIds": [
              "REV.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.27"
              },
              "items": [
                {
                  "text": "Esk 37:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.11+LEV.26.12"
              },
              "items": [
                {
                  "text": "Law 26:11-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay alïman kut nyo wow nyo kingölonuno ngacharu pö paytagh kïlentöy, “Töngönchin ye nyu kwïle! Kömöngisyö Tororöt nko pich! Kömöngisyö nyinte nko chane atökïlïkwï chane pikachi, kïlïkwï nyinte Tororöt, Tororötïngwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.3",
            "verseOrgIds": [
              "REV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.25.8"
              },
              "items": [
                {
                  "text": "Isa 25:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.35.10"
              },
              "items": [
                {
                  "text": "35:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.19"
              },
              "items": [
                {
                  "text": "65:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Misöy nyinte Tororöt lok cho mi konyikwa akïmökïminye meghat kokay, amökïminye lok ompöwölo kama chi, anta rirat anta kichïr ompöwölo kikuwer tïkuchay pö tagh.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlö Tororöt kïtöpo ngacharu paytagh, “Arosa nyu! Kaghan ye tïkwïn lapay kïrelachitu!” Akïmwowanïn ngat lö, “Kira ngalechï komwowunyi ompöwölo ngal chete cho muköy pich kughan akï pö man.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.5",
            "verseOrgIds": [
              "REV.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.1"
              },
              "items": [
                {
                  "text": "Isa 55:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akïlenchanïn, “Kikwighisyö! Ochan Alpa nko Omeka towunöt nko söröm. Otöninan chi anka tïkwïl nyo amate maral kïgheghöy pögh kwïle cho pkono kongpa pögho söpon. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.6",
            "verseOrgIds": [
              "REV.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.14"
              },
              "items": [
                {
                  "text": "2Sam 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.26+PSA.89.27"
              },
              "items": [
                {
                  "text": "Tum 89:26-27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anka tïkwïl nyo rïntoy otöninan tïkuchete löwïr, alïkunan Tororötïnyi, kïlïkwï nyinte montönyan. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.7",
            "verseOrgIds": [
              "REV.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo cho nyökoröch nko cho melö tökughönöy Kristo* nko cho kisïmnyontön ngokï nko cho le pörï nko cho le cheporestin nko cho le ponï nko cho soghöy körkeyïntin nko putï löwïr. Wölo kimïchï kïpa pich cho lata choni kï nanam nyo nögho ma nko koghïn cho nöghsot akï nyoni kï meghat nyo pö odeny.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.8",
            "verseOrgIds": [
              "REV.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yerusalem nyo rel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.8",
            "verseOrgIds": [
              "REV.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kungwïn wölo omitan malaykayan nyo kile akonga ompö malaykenichay le mut nko odeny kitïng pakulin mut nko odeny cho kinyïghitate nyörïlwoktino söröm cho le mut nko odeny akïlö, “Nyonö yi, atoporun Mïrar nyo pö kensyo Wawa Kech.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.9",
            "verseOrgIds": [
              "REV.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.2"
              },
              "items": [
                {
                  "text": "Esk 40:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïnamanïn Mïkulöwu, Tororöt atolapay kumïtanïn malaykayantanay ntatan paraku kutïng nyo kogh tya. Kuporwanïn Yerusalem, Kanasyan nyo Tïlil nyo ngwïno yïm wölo mi Tororöt ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.10",
            "verseOrgIds": [
              "REV.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "akï nyo kilïwu ompö ororyo Tororöt. Kulïwï kanasyantanay le kogh pö olyot nyo wow nyo lata koghpa yaspi nyo lïwu le kiyö. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.11",
            "verseOrgIds": [
              "REV.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.48.30+EZK.48.31+EZK.48.32+EZK.48.33+EZK.48.34+EZK.48.35"
              },
              "items": [
                {
                  "text": "Esk 48:30-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kikiwita kanasyantanoni nayat nyo kogh akï wow nyo kimi ortïnechoni cho le taman nko odeny akimi malayken cho le taman nko odeny cho kiripöy ortïnechoni. Kikikirchï kukotichoni kaynötut pö pipö Israel kïtaman nko odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.12",
            "verseOrgIds": [
              "REV.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi kukot sömökï wop anka tïkwïl: kimi sömökï wölnö le kongasis, kïmi sömökï wölo porö, kïmi wölo toka sömökï, kïmi sömökï wölnö le to. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.13",
            "verseOrgIds": [
              "REV.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kighyongo nayatu kanasyantanoni koghi kitoröt cho le taman nko odeny cho kikikirchï kaynötut taman nko odeny cho pö kiyoktoghi Wawa Kech.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.14",
            "verseOrgIds": [
              "REV.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
