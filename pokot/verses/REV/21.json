          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipchini kanasyantanoni tïkwïn cho pïchighöch nko mökosyo pipö ngwïny. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.26",
            "verseOrgIds": [
              "REV.21.26"
            ]
          }
