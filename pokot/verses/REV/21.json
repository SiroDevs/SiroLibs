                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kimönyorchininye kanasyantanoni löpoyïntanyi asis anta arawa ompöwölo lïwchini nyinte ororyo Tororöt akï tayenyi kï Wawa Kech. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.23",
            "verseOrgIds": [
              "REV.21.23"
            ]
          }
        },
        {
