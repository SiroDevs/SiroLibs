                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kikïteka nayatunoni koghi chaspa cho pïroch cho pö olyot nyo wow, akikwigha kïgh anka tïkwïl ompö kanasyantanoni koltin cho tïlilöch cho kiryölöy le kïyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.18",
            "verseOrgIds": [
              "REV.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïmina koghi kitoröto nayatu kanasyantanoni koghïn cho sisinchö cho pö olyot nyo wow. Kado kitoröt nyo pö tagh kï ki yaspi, nyo pö odeny sapire, nyo pö sömök kalkedo, nyo pö angwan sumarakdo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.19",
            "verseOrgIds": [
              "REV.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyo pö mut sardoniki, nyo pö mu nko akonga sardio, nyo pö mut nko odeny krusolito, nyo pö mut nko sömök perual, nyo pö mut nko angwan topas, nyo pö taman krusopras, nyo pö taman nko akonga yasinto, nyo pö taman nko odeny ametusta. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.20",
            "verseOrgIds": [
              "REV.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukot cho kïlïto kanasyantanoni cho le taman nko odeny kï cho kikigha lulun akï kïgh anka tïkwïl ompö kanasyantanoni kï kikigha koltin cho pïchighöch cho kiryölöy le kiyo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.21",
            "verseOrgIds": [
              "REV.21.21"
            ]
          }
        }
      ]
