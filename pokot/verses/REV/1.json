              "type": "text"
            }
          ]
        },
        {
          "text": " akwighecha kelïkuna tïsï cho pöghisyechini Paponyi Tororöt. Nya nyu kïpöyit ororyö Yeso Kristo nko owesyö, kokay nko kokay! Amen.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
