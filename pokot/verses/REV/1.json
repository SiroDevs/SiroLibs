              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nko cho pkono Yeso Kristo, söwin nyo ghanate nyo pö tagh kututunö ngwen akï nyinte nyo pöytoy pöytoghi ngwïny kïmïkul.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
