              "type": "text"
            }
          ]
        },
        {
          "text": " Kilata kelyechi taghoy cho kikïsit nyoman, le cho kikisïta ma kïtïlilöchtu, kikarkegh kutinyi nko kiwumöto puseryon. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.15",
            "verseOrgIds": [
              "REV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinömo ewunyi nyo pö tagh kokel mut nko odeny, atolapay kungwïna kutinyi chok nyo ngatip woptine kwodeny. Kilïwu tokochunyi le asis nyo ngwan.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.16",
            "verseOrgIds": [
              "REV.1.16"
