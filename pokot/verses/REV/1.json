          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochan werïnkwa Yoana nyo oghömöy nyarïlwok ompö mïkukönöt nko akwa, cho nyoru pich cho kikïghömö nko Yeso akïpöyit Pöyunötenyi ompö. Kikitönanïn Patmos kor nyo kikwen nanam, ompöwölo kyomtonan ngölyonto Tororöt asöwintönchini Yeso. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.9",
            "verseOrgIds": [
              "REV.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki asispa Echotyon atoni kïnamanïn Mïkulögh alïman kut nyo wow nyo kichögh le kontï ompö lötunyan, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.10",
            "verseOrgIds": [
              "REV.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyo kilentöy, “Kirchinö kitapï ngal cho isïwïyenyi aipchï kanisenichay le mut nko odeny, kanisa: Epeso nko Smurna nko Perkamo nko Tuatira nko Sardis nko Piladelpia nko Laodikea.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.11",
            "verseOrgIds": [
              "REV.1.11"
            ]
          }
        }
      ]
