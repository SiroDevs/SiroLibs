            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtum chane tum nyo rel kïlentöy,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
