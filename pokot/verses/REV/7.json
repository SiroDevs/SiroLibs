              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.19"
              },
              "items": [
                {
                  "text": "Mrk 13:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Olenchan, “Monkïtönye echotyon, nyi nyo inkït.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn, “Pïchï chay kiwer kiwongunöt nyo ngwan. Kimwata chane sïrokökwa kisön pö Wawa Kech kïrelachitu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyï mi chane kughyongo tawu ngacharu paytaghpa Tororöt, kïpöghisyechini nyinte pöghet nko nangat ompö Konyi. Körtegho nyinte nyo töpo ngacharu paytagh chane emenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.10"
              },
              "items": [
                {
                  "text": "Isa 49:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Amökwomöcha kömöy chane ngat anta maral, amökïpelöcha chane asis ngat anta kilayat anka tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.16",
            "verseOrgIds": [
              "REV.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.23.1+PSA.23.2"
              },
              "items": [
                {
                  "text": "Tum 23:1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.25.8"
              },
              "items": [
                {
                  "text": "Isa 25:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.10"
              },
              "items": [
                {
                  "text": "49:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.23"
              },
              "items": [
                {
                  "text": "Esk 34:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ompöwölo lïku Wawa Kech nyo mi kwenu ngacharu paytagh mösöwontengwa akuntöghoghchini chane ntökwit wölo kosuno pögho söpon. Miso Tororöt lok konyikwa löwïr.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.17",
            "verseOrgIds": [
              "REV.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
