            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.16+EZK.26.17"
              },
              "items": [
                {
                  "text": "Esk 26:16-17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rirchini akïlokyï kanasyantanoni pö Papilon pöytoghi ngwïny cho kigh cheporesnan akïlït lö tïrpïl ngala pïrchin anka tïkwïl nko nyinte ato sïwa ighot kanasyantanoni kïnöghöy. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.9",
            "verseOrgIds": [
              "REV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghyongo pöytoghichoni ato low, ompöwölo wöghöy lö nyorwech ana nyarïl pö kanasyantanoni akïlö, “Heywey! Nyarïl nyo tya nya wey ompö kanasyantanï wow pö Papilon! Ompöwölo ketunyi lawel nyarïltangu ompö kirwoko Tororöt!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
