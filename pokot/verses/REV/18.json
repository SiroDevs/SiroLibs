            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay alïman kuti anka nyo kingwïna yïm nyo kilentöy,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.4",
            "verseOrgIds": [
