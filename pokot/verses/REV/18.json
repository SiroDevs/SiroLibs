                "loc": "EZK.27.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rirchini akïlokyï mïnchïrïs pö ngwïny tïkwïl nyinte, ompöwölo mököminye chi ngat nyo tökwolöy tïkukwa, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.11",
            "verseOrgIds": [
              "REV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.12+EZK.27.13"
              },
              "items": [
                {
                  "text": "Esk 27:12-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mökïminye chi nyo tökwolöy koltinekwa nko silpenikwa, koghikwa cho pö olyot nyo wow nko sanayikwa cho karamach nko sïrokökwa cho pö katani cho pïchighöch cho lata munyantengwa akwa lamay nko cho pö aririn cho pïröch lötok nko ket nyo karam tïkwïn lapay cho kikigha kela pelöw nko tïkwïn lapay cho kikighan ket cho pö olyot nyo wow tya nko cho pö taghoy nko cho pö karïn nko cho pö senkwet. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.12",
            "verseOrgIds": [
              "REV.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tïku walaka kï ompö kinamon nko tïkwïn cho kyonyïnito omisyewut nko köröstin nko mwagh nyo kiyiltoy nyo ngutoy nyo karam nko dipay* nko mwagh nko pïsya nkanun nko tïch nko kechir nko angoletin nko nkarinekwa nko, sekeykökwa chini le pich söpsot. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.13",
            "verseOrgIds": [
              "REV.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lenchini mïnchïrïschoni kanasyantanoni, “Kikïpa lö weng tïkuchay kikönenyi lö tosïch akikuwonyö mökosyengu nko tïkwïn cho kipïchighonyi kegh amenyorunenyinye tïkuchoni ngat!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.14",
            "verseOrgIds": [
              "REV.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.31"
              },
              "items": [
                {
                  "text": "Esk 27:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ghyongo ato low mïnchïrïschoni kimökosöchitunö kanasyantanoni, ompöwölo wöghöy lö nyorwech ana nyarïl pö kanasyantanoni. Riryot chane akïlokyot ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.15",
            "verseOrgIds": [
              "REV.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïlentöy, “Heywey! Nyarïl nyo tya nya wey ompö kanasyantanï wow! Kikinaghanyi ilokyï kegh sïro pö katani cho pïchighöch cho lata munyantenyi akwa lamay nko cho pïröch, aimineni kegh koltin nko koghïn cho pö olyot nyo wow nko sanay cho pïchighöch! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.23.14"
              },
              "items": [
                {
                  "text": "Isa 23:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.26+EZK.27.27+EZK.27.28+EZK.27.29+EZK.27.30"
              },
              "items": [
                {
                  "text": "Esk 27:26-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anyï ye lawel kangeteninyi mökosyengu lö weng!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.17",
            "verseOrgIds": [
              "REV.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kughyongö low ipi melin löwïr ato nko rutoghotkökwa nko pich löwïr cho sïngo ighisyö nanam ompö melin atökïnyorï omisyengwa, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.17",
            "verseOrgIds": [
              "REV.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïlokyï otini kisïwa kanasyantanoni kïnöghöy akïlö, “Akï kanasyan ne nyo kikongityot nko kanasyantanï wow pö Papilon nya?” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.18",
            "verseOrgIds": [
              "REV.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
