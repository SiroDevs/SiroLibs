              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany asïwan korkonay kitöpo tyonyay pïrir, asïwan malaykayante anka kirökuno yïm. Kitïng owesyö nyo wow, akulïwchï ororyenyi ngwïny kïmïkul. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.1",
            "verseOrgIds": [
              "REV.18.1"
            ]
          }
        },
        {
