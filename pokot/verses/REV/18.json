                  "text": "Ngo 14:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kuta ompö kut nyo wow lö, “Kikïrul! Kikïrul Papilon nyay wow! Kasor kïmang orinyi oy nko mïkulis cho le sïmnyon. Kalïkwï wölo wïnchini kegh mïkulis nko törit cho le sïmnyon. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.23.17"
              },
              "items": [
                {
                  "text": "Isa 23:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Yer 51:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ompöwölo kikigh pipö punton löwïr kitömesyeghö kumi pïrchin pö cheporesnanenyi. Akikwigh pöytoghi ngwïny cheporesnan nko nyinte, kïmökosöchitunö mïnchïrïs pö ngwïny pïrchinoghtanyi nyo kingwïna mïrö.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
              "REV.18.3"
            ]
          }
        }
      ]
    },
