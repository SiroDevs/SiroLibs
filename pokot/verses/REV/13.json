                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay asïwan tyony nyo kipusuna nanam nyo kitïng kuy taman nko mötöw mut nko odeny, akitïng kuyöghö anka tïkwïl tentenyi. Kikirchï kaynata kimwoghsyö mötöwechoni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.1",
            "verseOrgIds": [
              "REV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.4+DAN.7.5+DAN.7.6"
              },
              "items": [
                {
                  "text": "Dan 7:4-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kilata möril tyonyoni, wölo kilata kelyechi kelyo chepökerï, kïlata kutinyi nyo pö ngötïny. Atoni nyu kutö ntaranay tyonyoni owesyenyi nko ngacharu paytaghtanyi nko owesyö nyo wow. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.2",
            "verseOrgIds": [
              "REV.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirumunote mötït akong nyo pö tyonyoni lö kikikekotön nyoman, wölo kikakïsop moye. Kïtöngönchï pipö ngwïny kïmïkul akïrïp tyonyay. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.3",
            "verseOrgIds": [
              "REV.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsagh chane lapay ntaranay ompöwölo kitö owesyenyi tyonyoni. Kisagh pich tïkwïl tyonyoni kilenchini, “Ngo nyo awes le tyonyï nya? Akï ngo nyo muköy kïporyö tïkwïl?”",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.4",
            "verseOrgIds": [
              "REV.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
