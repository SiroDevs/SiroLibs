                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.36"
              },
              "items": [
                {
                  "text": "11:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay kepïsï tyonyay kïngalan ngala kinisanat nko cho mwoghöy Tororöt akechömchï kïsïch owesyö nyo pö aro cho le 42. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.5",
            "verseOrgIds": [
              "REV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö atoni nyu kutor kumwa Tororöt nko kaynenyi nko wölini möngöy nyinte nko chane löwïr cho möngöy yïm. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.6",
            "verseOrgIds": [
              "REV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.21"
              },
              "items": [
                {
                  "text": "Dan 7:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kechömchï tyonyay kïporyeghö pipö Tororöt ntökïrïnta aketö owesyö kïpöyï pipö puntoni ngwïny löwïr nko ortïn nko kutïwa pich löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.7",
            "verseOrgIds": [
              "REV.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.28"
              },
              "items": [
                {
                  "text": "Tum 69:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Soghöy pich cho mi ngwïny tyonyoni, kïpoto chona kikekirchï kaynötutkökwa kitapu söpon kïngeta towunöto ngwïny, nyoni kï kitapu Wawa Kech nyo kikïpar.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.8",
            "verseOrgIds": [
              "REV.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.8",
            "verseOrgIds": [
              "REV.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato itïng chi yit ilïm! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.9",
            "verseOrgIds": [
              "REV.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.2"
              },
              "items": [
                {
                  "text": "Yer 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.43.11"
              },
              "items": [
                {
                  "text": "43:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Chi nyo kakemutyï kenam akewuw, kenömöy akewuwöy lenyoni nyo mötïny. Akwanka tïkwïl nyo kakemutyï kepara chok, kepöro chok nyo mötïny. Kïlenyona, mïchini pipö Tororöt kïmïkukön ompö kighanat.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.10",
            "verseOrgIds": [
              "REV.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.10",
            "verseOrgIds": [
              "REV.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay asïwan tyontö anka nyo kimi kïpusuno ngwïny. Kitïng kuy odeny cho kilata kuyo wawa makal akïngölonöy le ntara. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.11",
            "verseOrgIds": [
              "REV.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipöghisyeghö nyinte owesyö nyo wow tya nyo kipö tyonyay pö tagh ompö otini le tawunyi. Kuchikyï ngwïny nko lapay cho mi orinyi kïsagh tyonyaye pö tagh, nyanya kökikïsöp moyenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.12",
            "verseOrgIds": [
              "REV.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh töngönchin cho owesöch tyonyoni pö odeny. Kigh ma kirökunö yïm kïrökyï ngwïny ompö tawu pich lapay. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.13",
            "verseOrgIds": [
              "REV.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlïs pich löwïr cho mi ngwïny ompö owesyo töngönchin nyo kikitö nyinte kwigha tawu tyonyay pö tagh. Kïmwochï tyonyay pipö ngwïny kwigh körkeyïn nyo kïsölo tyonyay kökiketörö chok akïsöp. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.14",
            "verseOrgIds": [
              "REV.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïchömchï tyonyay pö odeny kumunchï kimïny pö söpon körkeyïnay pö tyonto tagh, atökumï körkeyïnay kïngalan akïtïgh pich lapay cho kitagh kïsagh nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.15",
            "verseOrgIds": [
              "REV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchikyï tyonyay pich löwïr, cho echön nko cho mïnkech, monkor nko mey, sekey nko cho melö sekey ketö machey ewunekwa cho pö tagh anta tokochwekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.16",
            "verseOrgIds": [
              "REV.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimemukönye chi kwal kïgh anta alta kïpoto ato tïng nyinte macheyunoni, nyoni kï kaynata tyonyay pö tagh anta nampa nyo keröy otini mi kaynenyi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.17",
            "verseOrgIds": [
              "REV.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
