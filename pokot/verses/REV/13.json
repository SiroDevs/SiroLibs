          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.17",
            "verseOrgIds": [
              "REV.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïchini nyu ompö atoni kïpöghisyeghö chi ngöghomnyö! Anka tïkwïl nyo ngöghom kumuköy kunkïtu nampa nyo pö tyonyoni, ompöwölo poru lö kaynata chi nyoni. Nampanoni kï 666.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.18",
            "verseOrgIds": [
              "REV.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wawa Kech nko pikachi",
          "type": "text"
        }
      ]
    }
  ],
