              "type": "text"
            }
          ]
        },
        {
          "text": " Kingwïnchï ngölyonto ECHOTYON Osea wero Peeri, ompö osiswo Usia nko Yotam nko Aas nko Esekia pöytoghi Yuda nko ompö osiswo Yeropoam wero Yeoas pöytoghinto Israel.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Koko Osea nko monechi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 1:1"
          },
          "items": [
