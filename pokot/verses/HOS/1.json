              "HOS.1.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.26"
              },
              "items": [
                {
                  "text": "Rum 9:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo chongitu nyu pipö Israel le ngayam ompö sörömu nanam, cho mökimukönye kepim anta kiyit. Wölay kilenchï Tororöt chane, “Mochikwanye piköchan,” wölo itïtoy ato lenchini, “Ochikwa monïngo Tororöt nyo satate!” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kituyot nyu atoni pipö Yuda nko cho pö Israel, atolapay kegh chane kïkïlchï kintöghoghintengwa nyo le akonga, yetu chane akwowesöchitu ompö korengwa, ompöwölo lïku asispa Yesrel asis nyo wow!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
      ]
    }
