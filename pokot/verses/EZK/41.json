          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko tïrisyen cho mi kamas nko kamas akikïsïlosïlö nïyetwe sos.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.26",
            "verseOrgIds": [
