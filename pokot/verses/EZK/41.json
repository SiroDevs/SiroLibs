          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikigh tekechonto kuka Wölo Tïlil akemina sos nko kerupimtin le chay kikighchï nïyet, kimi ket nyo kirel nyo lenye nyay mi okumpö sany ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.25",
            "verseOrgIds": [
              "EZK.41.25"
            ]
          }
        },
        {
