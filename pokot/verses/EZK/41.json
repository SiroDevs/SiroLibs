              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi tekechonta sörömu apukenay lïtöy kutöngöy Wölo Tïlil nko wölo lïtöy Wölo Tïlil Tya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.23",
            "verseOrgIds": [
              "EZK.41.23"
            ]
          }
        },
