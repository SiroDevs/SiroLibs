          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki odeny tekech akeyotöy kwen kutang are kunto nko ore kumporö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.24",
            "verseOrgIds": [
              "EZK.41.24"
            ]
          }
        },
        {
          "name": "verse",
