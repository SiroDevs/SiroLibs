          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumïtanïn chichay olïtön kuka kongasis ntorelön okumpö ori, kupim kukanay kïkarkegh nko chay walaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.32",
            "verseOrgIds": [
              "EZK.40.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 40:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikarkegh korïn cho kikingar nko wölo kïlïtuno nko nïyetwo okumpö ori nko chay löwïr pö tagh, kiwit tïrisyen nko wölini kilïtuno, ki miten 25 ompö koghïn aki miten taman nko odeny ompö töpesïn. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.33",
            "verseOrgIds": [
              "EZK.40.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 40:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikighchï sos nïyetwo apuketino köyoni, kilongöy kelyön mut nko sömök.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.34",
            "verseOrgIds": [
              "EZK.40.34"
            ]
          }
        }
      ]
    },
