            "number": "24",
            "style": "v",
            "sid": "EZK 40:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kumïtanïn chichay atang okumpö tagh, kenyorucha are anka ompö onkunini, kupim nïyetwe okumpö ori wölini kilïtuno kïkarkegh. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.24",
            "verseOrgIds": [
              "EZK.40.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 40:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi tïrisyen apukenete le chay walaka. Ki miten 25 löwïr ompö koghïn aki miten taman nko odeny nko nïsï töpesïntö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.25",
            "verseOrgIds": [
              "EZK.40.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 40:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilongöy kelyon mut nko odeny akimi sörömu wölo kilïtuno. Kikikirchï sos nayatu okumpö ori kïparta apuke. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.26",
            "verseOrgIds": [
              "EZK.40.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 40:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi yete tïkwïl or nyo lïtöy kokwe nyo mi ori, kupim chichay apukenay kïlïkwï miten tömönut mut.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.27",
            "verseOrgIds": [
              "EZK.40.27"
            ]
          }
        }
      ]
    },
    {
