    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakirwokyï Yerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïtanïn mïkulögh yïm or nyo mi okumpö kongasis ompö Kö pö Tororöt. Kimi pich cho le 25 asïwan Yasania wero Asur nko Pelatia wero Penaya nyo kile yetïn pö pich.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.1",
            "verseOrgIds": [
              "EZK.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.1",
            "verseOrgIds": [
              "EZK.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn Tororöt, “Wero chi pïchï chay ighöy tötut cho ghach akurwokyï pich kïrïp or nyo gha ompö kanasyantanï. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.2",
            "verseOrgIds": [
              "EZK.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chane cho lentöy tomönye kwitïta ato kïteköy korïn, ‘Lenye kanasyanta tör nyo kighoghtoy kelatecha panye.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.3",
            "verseOrgIds": [
              "EZK.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kanya kïngor möt chane.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.4",
            "verseOrgIds": [
              "EZK.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.4",
            "verseOrgIds": [
              "EZK.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnamanïn mïkulöwu ECHOTYON akïlenchanïn mwagha lö lentöy ECHOTYON, “Onkïtön kïgh nyo ononekwa nko tötut cho olelekwa we pipö Israel ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.5",
            "verseOrgIds": [
              "EZK.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kotïghökwa pich cho kighömï ortïna ompö kanasyantanï.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.6",
            "verseOrgIds": [
              "EZK.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.6",
            "verseOrgIds": [
              "EZK.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïlenyona lentöy Echotyon TORORÖT pïchï kaparakwa kïrïkïsus kï töre kanasyanta wölo eyononekwa kanasyan ori. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.7",
            "verseOrgIds": [
              "EZK.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrkegh owoyekwa chok, wölo oyonchinokwa chok. Mwoghöy Echotyon TORORÖT. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.8",
            "verseOrgIds": [
              "EZK.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otulenokwa ori, atönokwa mori pipö sany tökurwokwekwa kirwoko meghat. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.9",
            "verseOrgIds": [
              "EZK.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owonyenekwa ompö chok aparakwa ompö rotyo Israel ato onkïtunökwa lö ochan ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.10",
            "verseOrgIds": [
              "EZK.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö lïku kanasyantanï törenkwa anta alïkukwa panye ompö ori. Wölo opörokwa ompö rotyo Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.11",
            "verseOrgIds": [
              "EZK.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato onkïtunökwa lö ochan ECHOTYON ompö melö kyarïpakwa kirurutköchan anta agh kiyomisutköchan, kyaghakwa kïrïp kegh nko kiyomisut pö puntonichï kiwitekwa.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.12",
            "verseOrgIds": [
              "EZK.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.12",
            "verseOrgIds": [
              "EZK.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kyomitan ongorsïyi, kupït akima Pelatia wero Penaya. Opïtyan oköpïghchï kegh ngwïny, ateghan ompö kut nyo wow lö, “Ewo we Echotyon TORORÖT! Imökenyi so wonye lömïs ngötunön pö pipö Israel?”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.13",
            "verseOrgIds": [
              "EZK.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayomis pö Tororöt ompö pïnot",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.13",
            "verseOrgIds": [
              "EZK.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïnchanïn ngölyonto ECHOTYON kïlenchanïn. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.14",
            "verseOrgIds": [
              "EZK.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wero chi, kangalan pikökwa chini le werkökwa cho möngöy Yerusalem, kïngalaneninyi nko pipö Israel löwïr cho mi pïnotön lö, ‘Ochikwa lowöch nyoman ompö ECHOTYON, akikïpïnchecha ye nyu koronï.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.15",
            "verseOrgIds": [
              "EZK.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona lenchinö chona le pïnot, lentöy Echotyon TORORÖT, ‘Kïrkegh kyopön chane koros cho lowöch, atoytoychï wölini, tomitan nyete le ye nko chane ompö koroswechoni kipa chane.’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.16",
            "verseOrgIds": [
              "EZK.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.16",
            "verseOrgIds": [
              "EZK.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lenchinö lentöy Echotyon TORORÖT, ‘Oghömïtokwa löwïr ompö koroswechoni kyapekwa, akonokwa ngat koro Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.17",
            "verseOrgIds": [
              "EZK.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kapka yi kunotegho tïkuchï ghach löwïr nko sïmnyontönengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.18",
            "verseOrgIds": [
              "EZK.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.26+EZK.36.27+EZK.36.28"
              },
              "items": [
                {
                  "text": "Esk 36:26-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otöninan chane mïkulögh akonga atönan mïkulögh nyo rel. Achengan mïkulögh nyo aghïgh ompö chane atolapay otönön mïkulögh nyo tapïlïl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.19",
            "verseOrgIds": [
              "EZK.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atökïrïp kirurutköchan akïrïp kiyomisutköchan akïtagh kïlïkwï nyu chane piköchan alïkwan Tororötïngwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.20",
            "verseOrgIds": [
              "EZK.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo chane cho tökïrïpöy tïkukwa cho ghach nko sïmnyontönengwa, oghchinan chane kïrïp kegh nko otöptinekwa.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.21",
            "verseOrgIds": [
              "EZK.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Köweghö ororyo ECHOTYON Yerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.21",
            "verseOrgIds": [
              "EZK.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.22",
            "verseOrgIds": [
              "EZK.11.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.2+EZK.43.3+EZK.43.4+EZK.43.5"
              },
              "items": [
                {
                  "text": "Esk 43:2-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay kïngany kerupimtinechay* köpepoykökwa nko koropetinechay mi kamasungwa, kimi ororyo Tororöt pö Israel parakungwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.22",
            "verseOrgIds": [
              "EZK.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïweghö ororyo ECHOTYON kanasyan ori akughyongö kutïng nyo mi kanasyan okumpö kongasis. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.23",
            "verseOrgIds": [
              "EZK.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
