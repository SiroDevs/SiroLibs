  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "EZK 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kumïtanïn chichay olïtön kiror, atangan kö nyo mi okumpö löt ompö Kö pö Tororöt.* ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.1",
            "verseOrgIds": [
              "EZK.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki miten tömönut mut köyï ompö koghïn kï miten 25 ompö töpesïn. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.2",
            "verseOrgIds": [
              "EZK.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiparta karerana okumpö Kö pö Tororöt wölo lyöghöy akï tïng pöroyïn pö miten taman kïrop Kö pö Tororöt, kïparta karerana wölo kilïto kö ompö okumpö sany. Kikïtek koropen sömök cho kitopön kegh. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.3",
            "verseOrgIds": [
              "EZK.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi apuke nyo kirop kö okumpö löt nyo le miten mut ompö töpesïn kï miten tömönut mut ompö koghïn nko kukoti cho mi onkunini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.4",
            "verseOrgIds": [
              "EZK.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmöriköch kori koropen cho mi wölo toka, ompö kip pöroyïn wölo le kimpuröy kïtïl korïn cho mi wölo porö nko cho mi kwen. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.5",
            "verseOrgIds": [
              "EZK.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi nayat okumpö sany nyo kitötöy kegh korïn nko kö ompö okumpö sany, nyo kirelo korïn miten 25. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.6+EZK.42.7",
            "verseOrgIds": [
              "EZK.42.6",
              "EZK.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilïkwï miten 25 ompö koghïn korichini mi kamasu kukanini nyoghöy kelïtyini ompö tawu Kö pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.8",
            "verseOrgIds": [
              "EZK.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng kukot korichini mi to ompö okumpö kongasis ato lïto chi onkunini nyoghöy kelïto.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.9",
            "verseOrgIds": [
              "EZK.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.9",
            "verseOrgIds": [
              "EZK.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi korïn cho kirop nayat ompö wölay nyoghöy kelïto ompö okumpö tagh ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.10",
            "verseOrgIds": [
              "EZK.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "cho kitïng apuke ompö tawungwa, karkegh korichï nko chay mi okumpö löt, karkegh ompö koghïn nko töpesïn nko kukot nko tekechkö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.11",
            "verseOrgIds": [
              "EZK.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi kukat ngwïny korichini mi okumpö tagh ompö teksyonay sörömu nayat otini ketorö ompö okumpö kongasis.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchanïn chichay, “Tïlilöch korichï mi okumpö löt nko okumpö tagh, wölo omo tïsï cho pöghisyewanïn amörostin cho tïlilöch tya. Töni chane wölini amörostin cho tïlilöch tya nko ropöwo pagh nko ropöwo ngokï nko ropöwo lelut, ompöwölo tïlil otini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.13",
            "verseOrgIds": [
              "EZK.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato lïtöy tïsï Wölo Tïlil kïmelö petöy sany kïtomö kïngwïs sïrochinö keloköy otini pöghisïyi, tïlilöch sïrochï. Ngwïstoy akulak sïrokö walaka tökïpa wölo mi pich.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiyitut pö kiror nyo pö Kö pö Tororöt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kiwany chichay kupim Kö pö Tororöt okumpö ori akumïtanïn orelön kuka okumpö kongasis, atolapay kïwö kupim okumpö sany. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.15",
            "verseOrgIds": [
              "EZK.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcheng kipimöwon akupim okumpö kongasis kïlïkwï miten 250. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.16",
            "verseOrgIds": [
              "EZK.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kupim okumpö löt kïlïkwï miten 250. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.17",
            "verseOrgIds": [
              "EZK.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupim okumpö tagh kïlïkwï miten 250. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.18",
            "verseOrgIds": [
              "EZK.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupim ngat okumpö ta kïlïkwï miten 250 ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.19",
            "verseOrgIds": [
              "EZK.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kikarkegh luchtina Kö pö Tororöt kwangwan, kipesyö nayat wölo tïlil nko wölo melö tïlil.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.20",
            "verseOrgIds": [
              "EZK.42.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kamïla ECHOTYON Kö pö Tororöt",
          "type": "text"
        }
      ]
    }
  ],
