                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.15"
              },
              "items": [
                {
                  "text": "Ngo 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " asïwan ororyo Tororöt pö Israel kungwïno kongasis, kilata kutinyi kighumöto puseryon, akulïwchï ngwïny ompö löpoyïn pö ororyenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.2",
            "verseOrgIds": [
              "EZK.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyasïwan sïwïyagh nyo lata nyo kyasïwan ato kingwïn Tororöt kunyar kanasyanta Yerusalem aki lata nyo kyasïwan ompö lalwa Kepar, apïtyan ngwïny oköpïghtö mu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.3",
            "verseOrgIds": [
              "EZK.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilït ororyo ECHOTYON Kö pö Tororöt* nyo kilïtunö kukat nyo pörtoy kongasis. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kisïtanïn mïkulöwu Tororöt yïm akwipanïn nko kö wölo le sany ompö ori onyorwan wölo kinyïghï ororyo ECHOTYON Kö pö Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.5",
            "verseOrgIds": [
              "EZK.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.5",
            "verseOrgIds": [
              "EZK.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kighyongö chichay kamasunyan alïman chi nyo kingölonwanïn ompö Kö pö Tororöt sany. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.6",
            "verseOrgIds": [
              "EZK.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn, “Wero chi, ngacharunyan nyï nyo pö paytagh aki wölo työköy kelyechan. Lïku wölo omöngan nko piköchan pö Israel kokay. Amelö tökusïmnyonöy pipö Israel kaynenyan anta pöytoghikwa ompö chepkartananengwa nko ompö mïntïruchko pöytoghikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.7",
            "verseOrgIds": [
              "EZK.43.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanget chane kïtekyï ghato pö pagh nko pölöwo kukoti korikwa otini lekïto ghatya pagh nko pölöwo kukoti Konyan nyo kemuryeghecha nayat. Kisïmnyon nyu kaynenyan ompö otöptinekwa choni ghach. Kïlenyona kyawangan chane ompö nörekyenyan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.8",
            "verseOrgIds": [
              "EZK.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kïpïstö ye nyu saghata körkeyïntin nko muntïruch pö pöytoghikwa tamangan nyu nko chane kokay.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.9",
            "verseOrgIds": [
              "EZK.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.9",
            "verseOrgIds": [
              "EZK.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ye o wero chi, mwochinö pipö Israel ngala Kö pö Tororöt wölo lata nko wölo tenö tökïnyorï chane arasï ompö ngokikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.10",
            "verseOrgIds": [
              "EZK.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini nyu könyorï chane arasï ompö tïkwïn cho kikwigh chane, iporchï nyu wölo kïtektoy Kö pö Tororöt. Porchinö wölo mi kukat nko apuketinechi nko wölo lata kö kïmïkul nko tötutkö walaka lapay atökumï kïrïp chane lasiny. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.11",
            "verseOrgIds": [
              "EZK.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyï kirurut nyo pö Kö pö Tororöt: mïchini kïtïlilit tya kiroryenyi kuwit ompö kutïng parak. Lenye nyu nyoni kirurut nyo pö Kö pö Tororöt.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.12",
            "verseOrgIds": [
              "EZK.43.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ato kïpelo amöros",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.12",
            "verseOrgIds": [
              "EZK.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.13",
            "verseOrgIds": [
              "EZK.43.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.1+EXO.27.2"
              },
              "items": [
                {
                  "text": "Wuw 27:1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.1"
              },
              "items": [
                {
                  "text": "2Ot 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Chï kï kipimöwo ato kïpelo amöros ompö miten, kikarkegh nko kipimöwo Kö pö Tororöt. Sentimiten tömönut mut otini kighyongo kïröytö akïlïkwï sentimiten tömönut mut ompö töpesïn nko kutïng pö korope nyo kiwit okumpö sany nyo le sentimiten 25 kutok. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.13",
            "verseOrgIds": [
              "EZK.43.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 43:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlïkwï mita akonga kötönke kïngeta tö parak, kingeta wölo katantanit ntökwit wölo porö kï sentimiten tömönut mut kuwit kïlïkwï miten odeny kutok. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.14",
            "verseOrgIds": [
              "EZK.43.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 43:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miten odeny wöloto wölnö kïpelo amörostin kutok, kikoghöch kïtïl kareran löwïr koneni angwanï. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.15",
            "verseOrgIds": [
              "EZK.43.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 43:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimiten mut nko akonga wölnö le park kuwit. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.16",
            "verseOrgIds": [
              "EZK.43.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kï miten mut nko odeny wölo le kwen kuwit, kimi koropa nyo kiwit parak nyo le miten sentimiten 25 kutok. Kiportoy wölo kïpustegho ato kïpelo amöros kongasis.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kitïlilöto ato kïpelo amöros",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 43:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïlenchanïn Echotyon TORORÖT, “Wero chi, tera ngalechï omwowunyi. Otini kateka ato kïpelo amöros, itïlil ipela amörostin aisö kisön pö kyakichinö kïroptoy. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.18",
            "verseOrgIds": [
              "EZK.43.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 43:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tïsï opïn cho le pipö Lawi cho pö ara Sadok cho pkonöy kïpöghisyewanïn. Ani Echotyon TORORÖT nyo kamwagh. Itöninenyi chane ngaryan kïlïkwï amöros pö ngokï. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.19",
            "verseOrgIds": [
              "EZK.43.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 43:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icheng kisönkö ainyïra kuyo ato kïpelo amöros kwa angwan nko koneni kwen kwangwan aitö kuwit söremwok löwïr. Itïlilenyi aisir ato kïpelo amöros ompö aranoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.20",
            "verseOrgIds": [
              "EZK.43.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 43:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichengenyi ngaryan nyo pö ngokï aiwö ipela Kö pö Tororöt ori wölo tïlil. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.21",
            "verseOrgIds": [
              "EZK.43.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 43:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini köpöghön asïyechu icheng kwagha nyo lïpop nyo pö ngokï aitïlilö ato kïpelo amöros, le wölay kikitïliltö ompö ngaryantanay. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.22",
            "verseOrgIds": [
              "EZK.43.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 43:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kewonyö kitïlilötö icheng ngaryan ngat nko mokol cho lïpopöch ompö okwot. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.23",
            "verseOrgIds": [
              "EZK.43.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 43:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipunyi nyu tawu ECHOTYON atolapay kupispisyï tïsï chane partin akïropta le amöros nyo kïpelöy ketöni ECHOTYON. ",
          "type": "text",
          "attrs": {
