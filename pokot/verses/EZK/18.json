            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.29",
            "verseOrgIds": [
              "EZK.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïlenyona, orwokyinokwa nyu we pipö Israel, orwokyinan chi anka tïkwïl kïrïp kegh nko ortïnechi. Nyo okötenö apïstö ngokikwo tömowonyö.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.30",
            "verseOrgIds": [
              "EZK.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.30",
            "verseOrgIds": [
              "EZK.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Opïstenö ngokï löwïr cho kaghakwa ompö tawunyan acheng mïkulögh nyo rel. Pö ne omeghenö nya we pipö Israel? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.31",
            "verseOrgIds": [
              "EZK.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwanyï melö ongörokyinan megha chi anka tïkwïl, kïlenyona owöghökisyenö tosöpchenö.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.32",
            "verseOrgIds": [
              "EZK.18.32"
            ]
          }
        }
