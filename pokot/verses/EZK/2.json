                {
                  "text": "Ngo 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyini kolan aros asïwan ewu chi nyo kyonkoghwanïn kitapï nyo kikikir ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.9",
            "verseOrgIds": [
              "EZK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kughïtö kitapï ompö tawunyan, kikikir mu nko patagh, kikikirchï ori ngala lok nko sönönöt nko nyörilwok.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.10",
            "verseOrgIds": [
              "EZK.2.10"
            ]
