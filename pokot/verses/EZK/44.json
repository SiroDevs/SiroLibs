          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.8+NUM.18.9+NUM.18.10+NUM.18.11+NUM.18.12+NUM.18.13+NUM.18.14+NUM.18.15+NUM.18.16+NUM.18.17+NUM.18.18+NUM.18.19"
              },
              "items": [
                {
                  "text": "Kiy 18:8-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lïku omisyengwa ropöwo pagh nko ropöw cho pö ngokï nko ropöw cho pö lelut nko kïgh anka tïkwïl nyo kakïngot ompö Israel kïlïkwï nyingwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.29",
            "verseOrgIds": [
              "EZK.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku chikwa akwa tagh löwïr nko ropöw kïtïkon ompö ropöwekwa löwïr. Otöninekwa tïsï omisyenkwa wölo tagh tökïtöpö kisoyönötenyan kestonikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.30",
            "verseOrgIds": [
              "EZK.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.22.8"
              },
              "items": [
                {
                  "text": "Law 22:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Momönye tïsï pempö kïgh anka tïkwïl nyo kama anta nyo kam tyony.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.31",
            "verseOrgIds": [
              "EZK.44.31"
            ]
          }
        }
