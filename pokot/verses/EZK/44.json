              "items": [
                {
                  "text": "Kiy 18:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Melö sïköy chane kor nyo lïku mïlatengwa, ochan mïlatengwa metö chane kor nyo lïku nyingwa ompö Israel. Ochan korengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.28",
            "verseOrgIds": [
              "EZK.44.28"
            ]
          }
        },
