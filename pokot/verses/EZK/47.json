                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.38"
              },
              "items": [
                {
                  "text": "Yna 7:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.1"
              },
              "items": [
                {
                  "text": "Ngo 22:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kumïtwanïn ngat nko kuka Kö pö Tororöt. Asïwan ompö wölo porö lalwa nyo yintoy kutöngöy kongasis ompö kuka Kö pö Tororöt. Kiyintoy pöghechoni ompö okumpö löt nyo pö Kö pö Tororöt akï okumpö löt ompö ato kïpelo amöros. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.1",
            "verseOrgIds": [
              "EZK.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwipanïn nyu chichay sany, kerelöcha ara okumpö tagh akewitacha or nyo portoy kongasis kïpkono okumpö löt.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.2",
            "verseOrgIds": [
              "EZK.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.2",
            "verseOrgIds": [
              "EZK.47.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwö kutang kongasis chichay nko kipimöwontenyi. Kupim champilwanay kutang kongasis miten 500, kumïtanïn kewutöcha champilwanay. Kitanïn pöghechoni kowo monion. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.3",
            "verseOrgIds": [
              "EZK.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupim ngat miten 500, kwitï pöghechay ani kutïng, kupim ngat miten 500 kïröytö kwitwanïn pögh kïrut. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.4",
            "verseOrgIds": [
              "EZK.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupim ngat miten 500 kïröytö nyu pöghechay tya mach kulumanïn, akupölanïn oweghö kïpoto ato kiwir kepegha parak tökyoghyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.5",
            "verseOrgIds": [
              "EZK.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn chichay, “Wero chi kesïwenyi chï?”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kemïlisyecha kewitï champilwanay. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kyatan wölini, asïwan ket cho möngörï cho kirop lalwa antakwagh nko ontökwowu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.7",
            "verseOrgIds": [
              "EZK.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn chichay, “Yintoy pöghechï kutöngöy okumpö kongasis akïröytö Arapa atolapay kïlït nanampa Paryan. Otini kilïtöy pöghechï nanam kïkaramachitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.8",
            "verseOrgIds": [
              "EZK.47.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölini kewerata pögh kïsöp kïgh anka tïkwïl nyo möngöy ori akïchangit kaghagh nyoman. Petöy pöghechï kugheghöy wölini tökïkaramachitu pögho nanampa Paryan. Kïlenyona möngöy kïgh anka tïkwïl wölini kewer lalwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.9",
            "verseOrgIds": [
              "EZK.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghyongo nomi kaghagh sörömu nanam, akïrumuno wölo kikörkorchini netin kïyomö kïngeta Enkedi ntökwit Eneklaim. Kïnyorchini kaghagh cho sisinchö cho tenö cho mi nanampa Kwen. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.10",
            "verseOrgIds": [
              "EZK.47.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö köromöchitu pögho wölo le nyonchön nko takaray cho lekïtinö nanam, kïpïsty kïlïkwï pögho paryan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.11",
            "verseOrgIds": [
              "EZK.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.2"
              },
              "items": [
                {
                  "text": "Ngo 22:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Pityegho ketï löwïr cho kyomöy lalwa antakwagh nko antakwagh. Melö rörochot sökekwa yinöy akwa kokay ompö arawa anka tïkwïl ompöwölo pkono pöghechini gheghöy chane Kö pö Tororöt, kyomöy akwekwa akïlïkwï sakït sökekwa.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.12",
            "verseOrgIds": [
              "EZK.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rotyotïno koros",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.12",
            "verseOrgIds": [
              "EZK.47.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lentöy Echotyon TORORÖT, “Chï kï rotyotïn cho irïpenyi asïyech ichöghchini ortïna pipö Israel taman nko odeny. Nyoru ara Yosep karerantin odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.13",
            "verseOrgIds": [
              "EZK.47.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichagh kïkarkegh, ompöwölo kyawalwalan lö otöninan papotïneku. Lïku koronï nyinkwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.14",
            "verseOrgIds": [
              "EZK.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.14",
            "verseOrgIds": [
              "EZK.47.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lenye nyï wölo lïku rotyotïno kor: Ompö okumpö löt, kïngeta nanampa Kwen ompö ara Etlon akuwer Lepo Amat ntökwit Sedad ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.15",
            "verseOrgIds": [
              "EZK.47.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 47:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Perota nko Sipraim (nyo mi kwenu rotyo Damaska nko Amat) akïwö lenyoni ntökwit Aser Atikon nyo mi rotyo Auran. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.16",
            "verseOrgIds": [
              "EZK.47.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïweghö rotyot nanampa Kwen ntökwit Asar Enon akïrop rotyo okumpö löt ompö Damaska kïmi rotyo Amat okumpö löt, lïku nyu nyoni rotyo okumpö löt.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.17",
            "verseOrgIds": [
              "EZK.47.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.17",
            "verseOrgIds": [
              "EZK.47.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngeto rotyot ompö kongasis kwenu Auran nko Damaska akïrop Yordan kumuryö Kiliad nko koro Israel ompö okumpö kongasis ntökwit Tamar ompö nanampa Paryan. Lïku nyoni rotyot.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.18",
            "verseOrgIds": [
              "EZK.47.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.18",
            "verseOrgIds": [
              "EZK.47.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngeto rotyot ompö okumpö tagh Tamar akïwö ntökïlït pögho Meripat Kades, atolapay kïrop rotyo Misri ntökwit nanampa Kwen. Lïku nyoni rotyot ompö okumpö tagh.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.19",
            "verseOrgIds": [
              "EZK.47.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.19",
            "verseOrgIds": [
              "EZK.47.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 47:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngeto rotyot nyo pö okumpö ta nanampa Kwen ntökwit sör ato topönöy kegh nko Lepo Amat, lïku nyoni rotyot nyo pö okumpö ta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.20",
            "verseOrgIds": [
              "EZK.47.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 47:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.20",
            "verseOrgIds": [
              "EZK.47.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 47:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ichöghenyi nyu koronï kïghömi ortïna pipö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.21",
            "verseOrgIds": [
              "EZK.47.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 47:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichöghenyi kïlïkwï mïlatenkwa nyo le nyinkwa nko to nko monekwa cho kikïyichï korenkwa kïnyorï tïkwïl mïlat kïkarkegh nko akwa. Lenye chane monïngo pipö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.22",
            "verseOrgIds": [
              "EZK.47.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 47:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichöghchinenyi ton anka tïkwïl kïnyorï mïlat ompö aranoni pö Israel möngöy nyinte tïkwïl.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.23",
            "verseOrgIds": [
              "EZK.47.23"
            ]
          }
        }
      ]
    },
    {
