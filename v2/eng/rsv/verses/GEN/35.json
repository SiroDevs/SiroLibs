          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now the days of Isaac were a hundred and eighty years. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.28",
            "verseOrgIds": [
              "GEN.35.28"
            ]
