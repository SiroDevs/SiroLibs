          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the angel of the ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.15",
            "verseOrgIds": [
              "GEN.22.15"
            ]
          }
        },
        {
          "text": " called to Abraham a second time from heaven, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.15",
            "verseOrgIds": [
              "GEN.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 22:16"
          },
