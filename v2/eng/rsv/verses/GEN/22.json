                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " and said, “By myself I have sworn, says the ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.16",
            "verseOrgIds": [
              "GEN.22.16"
            ]
          }
        },
        {
          "text": ", because you have done this, and have not withheld your son, your only son, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.16",
            "verseOrgIds": [
              "GEN.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will indeed bless you, and I will multiply your descendants as the stars of heaven and as the sand which is on the seashore. And your descendants shall possess the gate of their enemies, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.17",
            "verseOrgIds": [
              "GEN.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.25"
              },
              "items": [
                {
                  "text": "Acts 3.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.16"
              },
              "items": [
                {
                  "text": "Gal 3.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " and by your descendants shall all the nations of the earth bless themselves, because you have obeyed my voice.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.18",
            "verseOrgIds": [
              "GEN.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "So Abraham returned to his young men, and they arose and went together to Beer-sheba; and Abraham dwelt at Beer-sheba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.19",
            "verseOrgIds": [
              "GEN.22.19"
            ]
          }
        }
      ]
    },
