              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.19",
            "verseOrgIds": [
              "GEN.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now after these things it was told Abraham, “Behold, Milcah also has borne children to your brother Nahor: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.20",
            "verseOrgIds": [
              "GEN.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uz the first-born, Buz his brother, Kemuel the father of Aram, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.21",
            "verseOrgIds": [
              "GEN.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chesed, Hazo, Pildash, Jidlaph, and Bethuel.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.22",
            "verseOrgIds": [
              "GEN.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bethuel became the father of Rebekah. These eight Milcah bore to Nahor, Abraham's brother. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.23",
            "verseOrgIds": [
              "GEN.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moreover, his concubine, whose name was Reumah, bore Tebah, Gaham, Tahash, and Maacah.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.24",
            "verseOrgIds": [
              "GEN.22.24"
            ]
          }
        }
      ]
    }
  ],
