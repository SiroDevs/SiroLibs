            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.55",
            "verseOrgIds": [
              "GEN.31.55"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "31.55",
              "type": "text"
            },
            {
              "text": "Ch 32.1 in Heb",
              "type": "text"
            }
          ]
        },
        {
          "text": " Early in the morning Laban arose, and kissed his grandchildren and his daughters and blessed them; then he departed and returned home.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.55",
            "verseOrgIds": [
              "GEN.31.55"
            ]
          }
