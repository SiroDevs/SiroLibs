          "attrs": {
            "verseId": "GEN.15.7",
            "verseOrgIds": [
              "GEN.15.7"
            ]
          }
        },
        {
          "text": " who brought you from Ur of the Chaldeans, to give you this land to possess.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.7",
            "verseOrgIds": [
              "GEN.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
