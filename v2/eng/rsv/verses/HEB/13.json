            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.21",
            "verseOrgIds": [
              "HEB.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "I appeal to you, brethren, bear with my word of exhortation, for I have written to you briefly. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.22",
            "verseOrgIds": [
              "HEB.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "You should understand that our brother Timothy has been released, with whom I shall see you if he comes soon. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.23",
            "verseOrgIds": [
              "HEB.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Greet all your leaders and all the saints. Those who come from Italy send you greetings. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.24",
            "verseOrgIds": [
              "HEB.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Grace be with all of you. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.25",
            "verseOrgIds": [
              "HEB.13.25"
            ]
          }
        }
