            "number": "19",
            "style": "v",
            "sid": "JHN 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "If you were of the world, the world would love its own; but because you are not of the world, but I chose you out of the world, therefore the world hates you. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.19",
            "verseOrgIds": [
              "JHN.15.19"
            ]
          }
        },
