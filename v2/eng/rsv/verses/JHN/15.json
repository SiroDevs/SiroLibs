          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "He who hates me hates my Father also. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.23",
            "verseOrgIds": [
              "JHN.15.23"
            ]
          }
        },
        {
          "name": "verse",
