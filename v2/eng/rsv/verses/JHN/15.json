                  "text": "14.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.23"
              },
              "items": [
                {
                  "text": "16.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " You did not choose me, but I chose you and appointed you that you should go and bear fruit and that your fruit should abide; so that whatever you ask the Father in my name, he may give it to you. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.16",
            "verseOrgIds": [
              "JHN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "This I command you, to love one another.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.17",
            "verseOrgIds": [
              "JHN.15.17"
            ]
          }
        }
      ]
