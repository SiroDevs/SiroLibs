              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "After this Jesus revealed himself again to the disciples by the Sea of Tiberi-as; and he revealed himself in this way. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.1",
            "verseOrgIds": [
              "JHN.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.16"
              },
              "items": [
                {
                  "text": "Jn 11.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.45"
              },
              "items": [
                {
                  "text": "1.45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.10"
              },
              "items": [
                {
                  "text": "Lk 5.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Simon Peter, Thomas called the Twin, Nathana-el of Cana in Galilee, the sons of Zebedee, and two others of his disciples were together. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.2",
            "verseOrgIds": [
              "JHN.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.3+LUK.5.4+LUK.5.5+LUK.5.6+LUK.5.7"
              },
              "items": [
                {
                  "text": "Lk 5.3-7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Simon Peter said to them, “I am going fishing.” They said to him, “We will go with you.” They went out and got into the boat; but that night they caught nothing.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.3",
            "verseOrgIds": [
              "JHN.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.3",
            "verseOrgIds": [
              "JHN.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
