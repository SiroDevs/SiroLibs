                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.16"
              },
              "items": [
                {
                  "text": "Lk 24.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Just as day was breaking, Jesus stood on the beach; yet the disciples did not know that it was Jesus. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.4",
            "verseOrgIds": [
              "JHN.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.41"
              },
              "items": [
                {
                  "text": "Lk 24.41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jesus said to them, “Children, have you any fish?” They answered him, “No.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.5",
            "verseOrgIds": [
              "JHN.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "He said to them, “Cast the net on the right side of the boat, and you will find some.” So they cast it, and now they were not able to haul it in, for the quantity of fish. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.6",
            "verseOrgIds": [
              "JHN.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.23"
              },
              "items": [
                {
                  "text": "Jn 13.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.26"
              },
              "items": [
                {
                  "text": "19.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.2"
              },
              "items": [
                {
                  "text": "20.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.20"
              },
              "items": [
                {
                  "text": "21.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " That disciple whom Jesus loved said to Peter, “It is the Lord!” When Simon Peter heard that it was the Lord, he put on his clothes, for he was stripped for work, and sprang into the sea. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.7",
            "verseOrgIds": [
              "JHN.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "But the other disciples came in the boat, dragging the net full of fish, for they were not far from the land, but about a hundred yards",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.8",
            "verseOrgIds": [
              "JHN.21.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21.8",
              "type": "text"
            },
            {
              "text": "Greek",
              "type": "text"
            },
            {
              "text": "two hundred cubits",
              "type": "text"
            }
          ]
        },
        {
          "text": " off.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.8",
            "verseOrgIds": [
              "JHN.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.8",
            "verseOrgIds": [
              "JHN.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "When they got out on land, they saw a charcoal fire there, with fish lying on it, and bread. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.9",
            "verseOrgIds": [
              "JHN.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesus said to them, “Bring some of the fish that you have just caught.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.10",
            "verseOrgIds": [
              "JHN.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "So Simon Peter went aboard and hauled the net ashore, full of large fish, a hundred and fifty-three of them; and although there were so many, the net was not torn. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.11",
            "verseOrgIds": [
              "JHN.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesus said to them, “Come and have breakfast.” Now none of the disciples dared ask him, “Who are you?” They knew it was the Lord. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.12",
            "verseOrgIds": [
              "JHN.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesus came and took the bread and gave it to them, and so with the fish. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.13",
            "verseOrgIds": [
              "JHN.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.19"
              },
              "items": [
                {
                  "text": "Jn 20.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " This was now the third time that Jesus was revealed to the disciples after he was raised from the dead.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.14",
            "verseOrgIds": [
              "JHN.21.14"
            ]
          }
        }
      ]
    },
