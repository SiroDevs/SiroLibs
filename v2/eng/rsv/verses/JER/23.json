          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore thus says the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.15",
            "verseOrgIds": [
              "JER.23.15"
            ]
          }
        },
