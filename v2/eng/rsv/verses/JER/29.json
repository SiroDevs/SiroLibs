              "type": "text"
            },
            {
              "text": "Gk: Heb",
              "type": "text"
            },
            {
              "text": "and he shall not see",
              "type": "text"
            }
          ]
        },
        {
          "text": " the good that I will do to my people, says the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.32",
            "verseOrgIds": [
              "JER.29.32"
            ]
          }
        },
        {
          "text": ", for he has talked rebellion against the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.32",
            "verseOrgIds": [
              "JER.29.32"
            ]
          }
        },
        {
          "text": ".’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.32",
            "verseOrgIds": [
              "JER.29.32"
            ]
          }
        }
