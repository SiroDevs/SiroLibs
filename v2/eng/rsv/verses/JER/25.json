                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Thus the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.15",
            "verseOrgIds": [
              "JER.25.15"
            ]
          }
        },
        {
          "text": ", the God of Israel, said to me: “Take from my hand this cup of the wine of wrath, and make all the nations to whom I send you drink it. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.15",
            "verseOrgIds": [
              "JER.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "They shall drink and stagger and be crazed because of the sword which I am sending among them.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.16",
            "verseOrgIds": [
              "JER.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
