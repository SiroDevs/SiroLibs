              "type": "text"
            }
          ]
        },
        {
          "text": "“At that time, says the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.1",
            "verseOrgIds": [
              "JER.31.1"
            ]
          }
        },
        {
          "text": ", I will be the God of all the families of Israel, and they shall be my people.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.1",
            "verseOrgIds": [
              "JER.31.1"
            ]
          }
        }
