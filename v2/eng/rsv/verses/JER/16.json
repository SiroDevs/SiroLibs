          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.20",
            "verseOrgIds": [
              "JER.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Therefore, behold, I will make them know, this once I will make them know my power and my might, and they shall know that my name is the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.21",
            "verseOrgIds": [
              "JER.16.21"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.21",
            "verseOrgIds": [
              "JER.16.21"
            ]
          }
        }
      ]
    }
