            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A writing of Hezekiah king of Judah, after he had been sick and had recovered from his sickness:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.9",
            "verseOrgIds": [
              "ISA.38.9"
            ]
          }
        }
