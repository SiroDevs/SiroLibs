          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "And Moses sent to spy out Jazer; and they took its villages, and dispossessed the Amorites that were there. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.32",
            "verseOrgIds": [
              "NUM.21.32"
            ]
          }
        },
        {
