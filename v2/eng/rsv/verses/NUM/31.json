          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "The asses were thirty thousand five hundred, of which the ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
            "verseOrgIds": [
              "NUM.31.39"
            ]
          }
        },
        {
          "text": "'s tribute was sixty-one. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
            "verseOrgIds": [
              "NUM.31.39"
            ]
          }
        },
