          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "From the people of Israel's half, which Moses separated from that of the men who had gone to war— ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.42",
            "verseOrgIds": [
              "NUM.31.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 31:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "now the congregation's half was three hundred and thirty-seven thousand five hundred sheep, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.43",
            "verseOrgIds": [
              "NUM.31.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 31:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "thirty-six thousand cattle, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.44",
            "verseOrgIds": [
              "NUM.31.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 31:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "and thirty thousand five hundred asses, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.45",
            "verseOrgIds": [
              "NUM.31.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
