          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "and sixteen thousand persons— ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.46",
            "verseOrgIds": [
              "NUM.31.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
