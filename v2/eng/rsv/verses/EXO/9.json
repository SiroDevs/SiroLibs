        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.26",
            "verseOrgIds": [
              "EXO.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
