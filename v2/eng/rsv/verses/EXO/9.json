            "verseId": "EXO.9.27",
            "verseOrgIds": [
              "EXO.9.27"
            ]
          }
        },
        {
          "text": " is in the right, and I and my people are in the wrong. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.27",
            "verseOrgIds": [
