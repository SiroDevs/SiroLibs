          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "and set up the lamps before the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.25",
            "verseOrgIds": [
              "EXO.40.25"
            ]
          }
        },
