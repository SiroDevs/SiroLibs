            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And he set the laver between the tent of meeting and the altar, and put water in it for washing, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.30",
            "verseOrgIds": [
              "EXO.40.30"
            ]
          }
        },
