                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “And you shall command the people of Israel that they bring to you pure beaten olive oil for the light, that a lamp may be set up to burn continually. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.20",
            "verseOrgIds": [
              "EXO.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "In the tent of meeting, outside the veil which is before the testimony, Aaron and his sons shall tend it from evening to morning before the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.21",
            "verseOrgIds": [
              "EXO.27.21"
            ]
          }
        },
        {
          "text": ". It shall be a statute for ever to be observed throughout their generations by the people of Israel.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.21",
            "verseOrgIds": [
              "EXO.27.21"
            ]
          }
        }
      ]
    }
  ],
