          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.38.9+EXO.38.10+EXO.38.11+EXO.38.12+EXO.38.13+EXO.38.14+EXO.38.15+EXO.38.16+EXO.38.17+EXO.38.18+EXO.38.19+EXO.38.20"
              },
