              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Six days shall work be done, but on the seventh day you shall have a holy sabbath of solemn rest to the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.2",
            "verseOrgIds": [
              "EXO.35.2"
            ]
          }
        },
        {
