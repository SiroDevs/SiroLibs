        {
          "text": " Moses said to all the congregation of the people of Israel, “This is the thing which the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.4",
            "verseOrgIds": [
              "EXO.35.4"
            ]
          }
        },
