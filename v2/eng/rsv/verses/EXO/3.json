            },
            {
              "text": "Acts 3—13",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.32"
              },
              "items": [
                {
                  "text": "7.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And he said, “I am the God of your father, the God of Abraham, the God of Isaac, and the God of Jacob.” And Moses hid his face, for he was afraid to look at God.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.6",
            "verseOrgIds": [
              "EXO.3.6"
            ]
          }
        }
      ]
