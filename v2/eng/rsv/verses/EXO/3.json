                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And the angel of the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.2",
            "verseOrgIds": [
              "EXO.3.2"
            ]
          }
        },
        {
          "text": " appeared to him in a flame of fire out of the midst of a bush; and he looked, and lo, the bush was burning, yet it was not consumed. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.2",
            "verseOrgIds": [
              "EXO.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "And Moses said, “I will turn aside and see this great sight, why the bush is not burnt.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.3",
            "verseOrgIds": [
              "EXO.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "When the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.4",
            "verseOrgIds": [
              "EXO.3.4"
            ]
          }
        },
        {
          "text": " saw that he turned aside to see, God called to him out of the bush, “Moses, Moses!” And he said, “Here am I.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.4",
            "verseOrgIds": [
              "EXO.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.33"
              },
              "items": [
                {
                  "text": "Acts 7.33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Then he said, “Do not come near; put off your shoes from your feet, for the place on which you are standing is holy ground.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.5",
            "verseOrgIds": [
              "EXO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
