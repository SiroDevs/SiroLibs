                {
                  "text": "Acts 7.34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.19",
            "verseOrgIds": [
              "EXO.4.19"
            ]
          }
        },
        {
          "text": " said to Moses in Midian, “Go back to Egypt; for all the men who were seeking your life are dead.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.19",
            "verseOrgIds": [
              "EXO.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "So Moses took his wife and his sons and set them on an ass, and went back to the land of Egypt; and in his hand Moses took the rod of God.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.20",
            "verseOrgIds": [
              "EXO.4.20"
            ]
          }
        }
