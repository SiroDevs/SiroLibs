                {
                  "text": "1 Thess 1.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.17"
              },
              "items": [
                {
                  "text": "1 Cor 7.17",
