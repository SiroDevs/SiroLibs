              "type": "tag",
              "attrs": {
                "loc": "ACT.2.23"
              },
              "items": [
                {
                  "text": "Acts 2.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.52"
              },
              "items": [
                {
                  "text": "7.52",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " who killed both the Lord Jesus and the prophets, and drove us out, and displease God and oppose all men ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.15",
            "verseOrgIds": [
              "1TH.2.15"
            ]
          }
        },
