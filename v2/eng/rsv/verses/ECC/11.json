          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "As you do not know how the spirit comes to the bones in the womb",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        },
