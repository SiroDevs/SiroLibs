          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rejoice, O young man, in your youth, and let your heart cheer you in the days of your youth; walk in the ways of your heart and the sight of your eyes. But know that for all these things God will bring you into judgment.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
