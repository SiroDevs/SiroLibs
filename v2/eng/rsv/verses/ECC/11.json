            {
              "text": "11.5",
              "type": "text"
            },
            {
              "text": "Or",
              "type": "text"
            },
            {
              "text": "As you do not know the way of the wind, or how the bones grow in the womb",
              "type": "text"
            }
          ]
        },
        {
          "text": " of a woman with child, so you do not know the work of God who makes everything.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
