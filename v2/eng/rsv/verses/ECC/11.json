          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Light is sweet, and it is pleasant for the eyes to behold the sun.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.7",
            "verseOrgIds": [
              "ECC.11.7"
            ]
          }
        }
