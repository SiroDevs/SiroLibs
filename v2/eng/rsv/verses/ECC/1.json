            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "The words of the Preacher,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.1",
            "verseOrgIds": [
              "ECC.1.1"
            ]
          }
        },
        {
