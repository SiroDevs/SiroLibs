          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hurai of the brooks of Gaash, Abiel the Arbathite, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.32",
            "verseOrgIds": [
              "1CH.11.32"
            ]
          }
