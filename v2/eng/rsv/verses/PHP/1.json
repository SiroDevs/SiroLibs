              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "To all the saints in Christ Jesus who are at Philippi, with the bishops",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.1",
              "type": "text"
            },
            {
              "text": "Or",
              "type": "text"
            },
            {
              "text": "overseers",
              "type": "text"
            }
          ]
        },
        {
          "text": " and deacons:",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        }
      ]
    },
