        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.38",
            "verseOrgIds": [
              "NEH.9.38"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9.38",
              "type": "text"
            },
            {
              "text": "Ch 10.1 in Heb",
              "type": "text"
            }
          ]
        },
        {
          "text": " Because of all this we make a firm covenant and write it, and our princes, our Levites, and our priests set their seal to it.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.38",
            "verseOrgIds": [
              "NEH.9.38"
            ]
          }
