              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "in Ziklag, in Meconah and its villages, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.28",
            "verseOrgIds": [
              "NEH.11.28"
