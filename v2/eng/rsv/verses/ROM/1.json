            "sid": "ROM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "which he promised beforehand through his prophets in the holy scriptures, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.2",
            "verseOrgIds": [
              "ROM.1.2"
            ]
          }
        },
        {
