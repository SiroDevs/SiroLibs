              "type": "text"
            },
            {
              "text": "Or",
              "type": "text"
            },
            {
              "text": "slave",
              "type": "text"
            }
          ]
        },
        {
          "text": " of Jesus Christ, called to be an apostle, set apart for the gospel of God ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.1",
            "verseOrgIds": [
              "ROM.1.1"
            ]
