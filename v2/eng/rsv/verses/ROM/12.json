              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Do not be conformed to this world",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.2",
            "verseOrgIds": [
              "ROM.12.2"
            ]
          }
        },
        {
