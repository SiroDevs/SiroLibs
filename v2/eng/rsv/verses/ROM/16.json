              "ROM.16.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.2"
              },
              "items": [
                {
                  "text": "Acts 18.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Greet Prisca and Aquila, my fellow workers in Christ Jesus, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.3",
            "verseOrgIds": [
              "ROM.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "who risked their necks for my life, to whom not only I but also all the churches of the Gentiles give thanks; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.4",
            "verseOrgIds": [
              "ROM.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.19"
              },
              "items": [
                {
                  "text": "1 Cor 16.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " greet also the church in their house. Greet my beloved Epaenetus, who was the first convert in Asia for Christ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.5",
            "verseOrgIds": [
              "ROM.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Greet Mary, who has worked hard among you. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.6",
            "verseOrgIds": [
              "ROM.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Greet Andronicus and Junias, my kinsmen and my fellow prisoners; they are men of note among the apostles, and they were in Christ before me. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.7",
            "verseOrgIds": [
              "ROM.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Greet Ampliatus, my beloved in the Lord. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.8",
            "verseOrgIds": [
              "ROM.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Greet Urbanus, our fellow worker in Christ, and my beloved Stachys. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.9",
            "verseOrgIds": [
              "ROM.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Greet Apelles, who is approved in Christ. Greet those who belong to the family of Aristobulus. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.10",
            "verseOrgIds": [
              "ROM.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Greet my kinsman Herodion. Greet those in the Lord who belong to the family of Narcissus. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.11",
            "verseOrgIds": [
              "ROM.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Greet those workers in the Lord, Tryphaena and Tryphosa. Greet the beloved Persis, who has worked hard in the Lord. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.12",
            "verseOrgIds": [
              "ROM.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Greet Rufus, eminent in the Lord, also his mother and mine. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.13",
            "verseOrgIds": [
              "ROM.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Greet Asyncritus, Phlegon, Hermes, Patrobas, Hermas, and the brethren who are with them. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.14",
            "verseOrgIds": [
              "ROM.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Greet Philologus, Julia, Nereus and his sister, and Olympas, and all the saints who are with them. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.15",
            "verseOrgIds": [
              "ROM.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.12"
              },
              "items": [
                {
                  "text": "2 Cor 13.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.26"
              },
              "items": [
                {
                  "text": "1 Thess 5.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.14"
              },
              "items": [
                {
                  "text": "1 Pet 5.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Greet one another with a holy kiss. All the churches of Christ greet you.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.16",
            "verseOrgIds": [
              "ROM.16.16"
            ]
          }
        }
      ]
    },
