            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " For he is not a real Jew who is one outwardly, nor is true circumcision something external and physical. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.28",
            "verseOrgIds": [
              "ROM.2.28"
            ]
          }
        },
