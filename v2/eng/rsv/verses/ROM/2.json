                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Then those who are physically uncircumcised but keep the law will condemn you who have the written code and circumcision but break the law. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.27",
            "verseOrgIds": [
              "ROM.2.27"
            ]
          }
        },
