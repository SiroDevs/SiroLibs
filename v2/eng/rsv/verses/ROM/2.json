            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.25"
              },
              "items": [
                {
                  "text": "Jer 9.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Circumcision indeed is of value if you obey the law; but if you break the law, your circumcision becomes uncircumcision. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.25",
            "verseOrgIds": [
              "ROM.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.19"
