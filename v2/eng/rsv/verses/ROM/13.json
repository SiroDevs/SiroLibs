              "items": [
                {
                  "text": "1 Thess 5.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " the night is far gone, the day is at hand. Let us then cast off the works of darkness and put on the armor of light; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.12",
            "verseOrgIds": [
              "ROM.13.12"
            ]
          }
        },
        {
