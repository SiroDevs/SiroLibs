              "items": [
                {
                  "text": "Lev 19.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.19"
              },
              "items": [
                {
                  "text": "Mt 19.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " The commandments, “You shall not commit adultery, You shall not kill, You shall not steal, You shall not covet,” and any other commandment, are summed up in this sentence, “You shall love your neighbor as yourself.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.39+MAT.22.40"
              },
              "items": [
                {
                  "text": "Mt 22.39-40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.13.8"
              },
              "items": [
                {
                  "text": "Rom 13.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.14"
              },
              "items": [
                {
                  "text": "Gal 5.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.8"
              },
              "items": [
                {
                  "text": "Jas 2.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Love does no wrong to a neighbor; therefore love is the fulfilling of the law.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        }
