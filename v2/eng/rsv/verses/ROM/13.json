              "items": [
                {
                  "text": "Ex 20.13-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.17+DEU.5.18"
              },
              "items": [
                {
                  "text": "Deut 5.17-18",
                  "type": "text"
