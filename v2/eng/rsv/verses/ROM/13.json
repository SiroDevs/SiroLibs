                "loc": "MAT.22.21"
              },
              "items": [
                {
                  "text": "Mt 22.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.17"
              },
              "items": [
                {
                  "text": "Mk 12.17",
                  "type": "text"
                }
              ]
            },
            {
