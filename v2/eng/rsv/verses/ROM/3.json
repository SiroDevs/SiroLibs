          ]
        },
        {
          "text": " What then? Are we Jews any better off?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.9",
            "verseOrgIds": [
              "ROM.3.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.9",
              "type": "text"
            },
            {
              "text": "Or",
              "type": "text"
            },
            {
              "text": "at any disadvantage?",
              "type": "text"
            }
          ]
        },
        {
          "text": " No, not at all; for I",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.9",
            "verseOrgIds": [
              "ROM.3.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.9",
              "type": "text"
            },
            {
              "text": "Greek",
              "type": "text"
            },
            {
              "text": "we",
              "type": "text"
            }
          ]
        },
        {
          "text": " have already charged that all men, both Jews and Greeks, are under the power of sin, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.9",
            "verseOrgIds": [
              "ROM.3.9"
            ]
          }
        },
