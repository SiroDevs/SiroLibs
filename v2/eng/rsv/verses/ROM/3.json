                {
                  "text": "Eph 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " For we hold that a man is justified by faith apart from works of law. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.28",
            "verseOrgIds": [
              "ROM.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 3:29"
          },
          "items": [
