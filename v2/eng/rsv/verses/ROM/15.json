                  "text": "1 Cor 9.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " they were pleased to do it, and indeed they are in debt to them, for if the Gentiles have come to share in their spiritual blessings, they ought also to be of service to them in material blessings. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.27",
            "verseOrgIds": [
              "ROM.15.27"
            ]
