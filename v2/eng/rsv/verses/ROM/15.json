            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " At present, however, I am going to Jerusalem with aid for the saints. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.25",
            "verseOrgIds": [
              "ROM.15.25"
            ]
          }
        },
        {
