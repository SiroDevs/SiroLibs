          "items": [
            {
              "text": "15.28",
              "type": "text"
            },
            {
              "text": "Greek",
              "type": "text"
            },
            {
              "text": "sealed to them this fruit",
              "type": "text"
            }
          ]
        },
        {
          "text": " I shall go on by way of you to Spain; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.28",
            "verseOrgIds": [
              "ROM.15.28"
            ]
          }
        },
