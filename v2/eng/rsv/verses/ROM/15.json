          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.21",
            "verseOrgIds": [
              "ROM.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.22",
            "verseOrgIds": [
              "ROM.15.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.13"
              },
              "items": [
                {
                  "text": "Rom 1.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " This is the reason why I have so often been hindered from coming to you. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.22",
            "verseOrgIds": [
              "ROM.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.21"
              },
              "items": [
                {
                  "text": "Acts 19.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.10+ROM.1.11"
              },
              "items": [
                {
                  "text": "Rom 1.10-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.32"
              },
              "items": [
                {
                  "text": "15.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " But now, since I no longer have any room for work in these regions, and since I have longed for many years to come to you, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.23",
            "verseOrgIds": [
              "ROM.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.28"
              },
              "items": [
                {
                  "text": "Rom 15.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " I hope to see you in passing as I go to Spain, and to be sped on my journey there by you, once I have enjoyed your company for a little. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.24",
            "verseOrgIds": [
              "ROM.15.24"
            ]
          }
        },
        {
