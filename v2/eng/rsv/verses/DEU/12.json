              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "and offer your burnt offerings, the flesh and the blood, on the altar of the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
