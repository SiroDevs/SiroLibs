        },
        {
          "text": " “You shall not eat anything that dies of itself; you may give it to the alien who is within your towns, that he may eat it, or you may sell it to a foreigner; for you are a people holy to the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        },
        {
          "text": " your God.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        }
