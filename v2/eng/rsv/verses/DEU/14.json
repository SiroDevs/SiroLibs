                "loc": "NUM.18.21+NUM.18.22+NUM.18.23+NUM.18.24+NUM.18.25+NUM.18.26+NUM.18.27+NUM.18.28+NUM.18.29+NUM.18.30+NUM.18.31+NUM.18.32"
