        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.29",
            "verseOrgIds": [
              "DEU.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
