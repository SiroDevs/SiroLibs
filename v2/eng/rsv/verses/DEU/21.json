                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “And if a man has committed a crime punishable by death and he is put to death, and you hang him on a tree, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.22",
            "verseOrgIds": [
              "DEU.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.13"
              },
              "items": [
                {
                  "text": "Gal 3.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " his body shall not remain all night upon the tree, but you shall bury him the same day, for a hanged man is accursed by God; you shall not defile your land which the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.23",
            "verseOrgIds": [
              "DEU.21.23"
            ]
          }
        },
        {
          "text": " your God gives you for an inheritance.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.23",
            "verseOrgIds": [
              "DEU.21.23"
            ]
          }
        }
