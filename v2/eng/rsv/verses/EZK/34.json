              "type": "text"
            },
            {
              "text": "Gk Old Latin: Heb",
              "type": "text"
            },
            {
              "text": "pasture you are men",
              "type": "text"
            }
          ]
        },
        {
          "text": " and I am your God, says the Lord ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.31",
            "verseOrgIds": [
              "EZK.34.31"
            ]
          }
        },
        {
