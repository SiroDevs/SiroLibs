              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then he led me out into the inner",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.1",
            "verseOrgIds": [
              "EZK.42.1"
            ]
          }
        },
        {
