          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 44:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“They shall have no",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.28",
            "verseOrgIds": [
              "EZK.44.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "44.28",
              "type": "text"
            },
            {
              "text": "Vg: Heb",
              "type": "text"
            },
            {
              "text": "as an",
              "type": "text"
            }
          ]
        },
        {
          "text": " inheritance; I am their inheritance: and you shall give them no possession in Israel; I am their possession. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.28",
            "verseOrgIds": [
              "EZK.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "They shall eat the cereal offering, the sin offering, and the guilt offering; and every devoted thing in Israel shall be theirs. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.29",
            "verseOrgIds": [
              "EZK.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the first of all the first fruits of all kinds, and every offering of all kinds from all your offerings, shall belong to the priests; you shall also give to the priests the first of your coarse meal, that a blessing may rest on your house. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.30",
            "verseOrgIds": [
              "EZK.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "The priests shall not eat of anything, whether bird or beast, that has died of itself or is torn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.31",
            "verseOrgIds": [
              "EZK.44.31"
            ]
          }
        }
      ]
