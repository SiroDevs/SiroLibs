          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adjoining the territory of Issachar, from the east side to the west, Zebulun, one portion. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adjoining the territory of Zebulun, from the east side to the west, Gad, one portion. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
              "EZK.48.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 48:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "And adjoining the territory of Gad to the south, the boundary shall run from Tamar to the waters of Meribath-kadesh, thence along the Brook of Egypt to the Great Sea. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.28",
            "verseOrgIds": [
              "EZK.48.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 48:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "This is the land which you shall allot as an inheritance among the tribes of Israel, and these are their several portions, says the Lord ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.29",
            "verseOrgIds": [
              "EZK.48.29"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.29",
            "verseOrgIds": [
              "EZK.48.29"
            ]
          }
        }
      ]
