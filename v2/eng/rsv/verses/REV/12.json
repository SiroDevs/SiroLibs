              "REV.12.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.13"
              },
              "items": [
                {
                  "text": "Dan 10.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Now war arose in heaven, Michael and his angels fighting against the dragon; and the dragon and his angels fought, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.7",
            "verseOrgIds": [
              "REV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "but they were defeated and there was no longer any place for them in heaven. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.8",
            "verseOrgIds": [
              "REV.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1"
              },
              "items": [
                {
                  "text": "Gen 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.14+GEN.3.15"
              },
              "items": [
                {
                  "text": "14-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.1"
              },
              "items": [
                {
                  "text": "Zech 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And the great dragon was thrown down, that ancient serpent, who is called the Devil and Satan, the deceiver of the whole world—he was thrown down to the earth, and his angels were thrown down with him. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.9",
            "verseOrgIds": [
              "REV.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.9+JOB.1.10+JOB.1.11"
              },
              "items": [
                {
                  "text": "Job 1.9-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And I heard a loud voice in heaven, saying, “Now the salvation and the power and the kingdom of our God and the authority of his Christ have come, for the accuser of our brethren has been thrown down, who accuses them day and night before our God. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "And they have conquered him by the blood of the Lamb and by the word of their testimony, for they loved not their lives even unto death. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.23"
              },
              "items": [
                {
                  "text": "Is 44.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.13"
              },
              "items": [
                {
                  "text": "49.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rejoice then, O heaven and you that dwell therein! But woe to you, O earth and sea, for the devil has come down to you in great wrath, because he knows that his time is short!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "And when the dragon saw that he had been thrown down to the earth, he pursued the woman who had borne the male child. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.13",
            "verseOrgIds": [
              "REV.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.25"
              },
              "items": [
                {
                  "text": "Dan 7.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.7"
              },
              "items": [
                {
                  "text": "12.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " But the woman was given the two wings of the great eagle that she might fly from the serpent into the wilderness, to the place where she is to be nourished for a time, and times, and half a time. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.14",
            "verseOrgIds": [
              "REV.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "The serpent poured water like a river out of his mouth after the woman, to sweep her away with the flood. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.15",
            "verseOrgIds": [
              "REV.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "But the earth came to the help of the woman, and the earth opened its mouth and swallowed the river which the dragon had poured from his mouth. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.16",
            "verseOrgIds": [
              "REV.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the dragon was angry with the woman, and went off to make war on the rest of her offspring, on those who keep the commandments of God and bear testimony to Jesus. And he stood",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.17",
            "verseOrgIds": [
              "REV.12.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12.17",
              "type": "text"
            },
            {
              "text": "Other ancient authorities read",
              "type": "text"
            },
            {
              "text": "And I stood,",
              "type": "text"
            },
            {
              "text": "connecting the sentence with 13.1",
              "type": "text"
            }
          ]
        },
        {
          "text": " on the sand of the sea.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.17",
            "verseOrgIds": [
              "REV.12.17"
            ]
          }
        }
      ]
    }
