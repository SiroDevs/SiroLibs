            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " and from Jesus Christ the faithful witness, the first-born of the dead, and the ruler of kings on earth.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        }
