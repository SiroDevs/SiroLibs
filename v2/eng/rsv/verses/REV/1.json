                {
                  "text": "Zech 12.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Behold, he is coming with the clouds, and every eye will see him, every one who pierced him; and all tribes of the earth will wail on account of him. Even so. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
