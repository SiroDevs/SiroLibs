                  "text": "Mic 4.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " In that day, says the ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.10",
            "verseOrgIds": [
              "ZEC.3.10"
            ]
          }
        },
        {
          "text": " of hosts, every one of you will invite his neighbor under his vine and under his fig tree.”",
          "type": "text",
          "attrs": {
