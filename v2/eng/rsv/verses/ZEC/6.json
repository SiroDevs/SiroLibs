          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the word of the ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.9",
            "verseOrgIds": [
              "ZEC.6.9"
            ]
          }
        },
        {
          "text": " came to me: ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.9",
            "verseOrgIds": [
              "ZEC.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Take from the exiles Heldai, Tobijah, and Jedaiah, who have arrived from Babylon; and go the same day to the house of Josiah, the son of Zephaniah. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.10",
            "verseOrgIds": [
              "ZEC.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Take from them silver and gold, and make a crown,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.11",
            "verseOrgIds": [
              "ZEC.6.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6.11",
              "type": "text"
            },
            {
              "text": "Gk Mss: Heb",
              "type": "text"
            },
            {
              "text": "crowns",
              "type": "text"
            }
          ]
        },
        {
          "text": " and set it upon the head of Joshua, the son of Jehozadak, the high priest; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.11",
            "verseOrgIds": [
              "ZEC.6.11"
            ]
          }
        },
