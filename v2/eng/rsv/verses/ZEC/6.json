              "type": "text"
            },
            {
              "text": "crowns",
              "type": "text"
            }
          ]
        },
        {
          "text": " shall be in the temple of the ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.14",
            "verseOrgIds": [
              "ZEC.6.14"
            ]
          }
        },
        {
