        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "On that day there shall be neither cold nor frost.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.6",
            "verseOrgIds": [
              "ZEC.14.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14.6",
              "type": "text"
            },
            {
              "text": "Compare Gk Syr Vg Tg: Heb uncertain",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.6",
            "verseOrgIds": [
              "ZEC.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "And there shall be continuous day (it is known to the ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.7",
            "verseOrgIds": [
              "ZEC.14.7"
            ]
          }
        },
        {
          "text": "), not day and not night, for at evening time there shall be light.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.7",
            "verseOrgIds": [
              "ZEC.14.7"
            ]
          }
        }
      ]
    },
    {
