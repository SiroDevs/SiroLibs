          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "You shall take up Sakkuth your king, and Kaiwan your star-god, your images,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.26",
            "verseOrgIds": [
              "AMO.5.26"
