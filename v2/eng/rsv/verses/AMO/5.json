            },
            {
              "text": "your images, your star-god",
              "type": "text"
            }
          ]
        },
        {
          "text": " which you made for yourselves; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.26",
            "verseOrgIds": [
              "AMO.5.26"
            ]
          }
        },
