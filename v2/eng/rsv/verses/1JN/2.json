                "loc": "JHN.11.51+JHN.11.52"
              },
              "items": [
                {
                  "text": "11.51-52",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.10"
              },
              "items": [
                {
                  "text": "1 Jn 4.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " and he is the expiation for our sins, and not for ours only but also for the sins of the whole world. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.2",
            "verseOrgIds": [
              "1JN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.10"
              },
              "items": [
                {
                  "text": "Jn 15.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And by this we may be sure that we know him, if we keep his commandments. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.3",
            "verseOrgIds": [
              "1JN.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.1.6+1JN.1.7+1JN.1.8"
              },
              "items": [
                {
                  "text": "1 Jn 1.6-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.20"
              },
              "items": [
                {
                  "text": "4.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " He who says “I know him” but disobeys his commandments is a liar, and the truth is not in him; ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.4",
            "verseOrgIds": [
              "1JN.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.21"
              },
              "items": [
                {
                  "text": "Jn 14.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.3"
              },
              "items": [
                {
                  "text": "1 Jn 5.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " but whoever keeps his word, in him truly love for God is perfected. By this we may be sure that we are in him: ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.5",
            "verseOrgIds": [
              "1JN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.15"
              },
              "items": [
                {
                  "text": "Jn 13.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " he who says he abides in him ought to walk in the same way in which he walked.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.6",
            "verseOrgIds": [
              "1JN.2.6"
            ]
          }
        }
      ]
    },
    {
