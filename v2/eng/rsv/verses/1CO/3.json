              "attrs": {
                "loc": "1CO.1.12"
              },
              "items": [
                {
                  "text": "1 Cor 1.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " I planted, Apollos watered, but God gave the growth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.6",
            "verseOrgIds": [
              "1CO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "So neither he who plants nor he who waters is anything, but only God who gives the growth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.7",
            "verseOrgIds": [
              "1CO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "He who plants and he who waters are equal, and each shall receive his wages according to his labor. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.8",
            "verseOrgIds": [
              "1CO.3.8"
            ]
          }
        },
        {
