            "style": "v",
            "sid": "1KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.16",
            "verseOrgIds": [
              "1KI.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the word of the ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.17",
            "verseOrgIds": [
              "1KI.21.17"
            ]
          }
        },
        {
          "text": " came to Elijah the Tishbite, saying, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.17",
            "verseOrgIds": [
              "1KI.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Arise, go down to meet Ahab king of Israel, who is in Samaria; behold, he is in the vineyard of Naboth, where he has gone to take possession. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.18",
            "verseOrgIds": [
              "1KI.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.26"
              },
              "items": [
                {
                  "text": "2 Kings 9.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And you shall say to him, ‘Thus says the ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        },
        {
          "text": ", “Have you killed, and also taken possession?” ’ And you shall say to him, ‘Thus says the ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        },
        {
          "text": ": “In the place where dogs licked up the blood of Naboth shall dogs lick your own blood.” ’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahab said to Elijah, “Have you found me, O my enemy?” He answered, “I have found you, because you have sold yourself to do what is evil in the sight of the ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.20",
            "verseOrgIds": [
              "1KI.21.20"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.20",
            "verseOrgIds": [
              "1KI.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Behold, I will bring evil upon you; I will utterly sweep you away, and will cut off from Ahab every male, bond or free, in Israel; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.21",
            "verseOrgIds": [
              "1KI.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "and I will make your house like the house of Jeroboam the son of Nebat, and like the house of Baasha the son of Ahijah, for the anger to which you have provoked me, and because you have made Israel to sin. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.22",
            "verseOrgIds": [
              "1KI.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.36"
              },
              "items": [
                {
                  "text": "2 Kings 9.36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And of Jezebel the ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.23",
            "verseOrgIds": [
              "1KI.21.23"
            ]
          }
        },
        {
          "text": " also said, ‘The dogs shall eat Jezebel within the bounds of Jezreel.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.23",
            "verseOrgIds": [
              "1KI.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Any one belonging to Ahab who dies in the city the dogs shall eat; and any one of his who dies in the open country the birds of the air shall eat.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.24",
            "verseOrgIds": [
              "1KI.21.24"
            ]
          }
        }
      ]
    },
