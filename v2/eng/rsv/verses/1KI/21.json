            "sid": "1KI 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "(There was none who sold himself to do what was evil in the sight of the ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
          "text": " like Ahab, whom Jezebel his wife incited. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
