          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "And he looked up and said, “I see men; but they look like trees, walking.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.24",
            "verseOrgIds": [
              "MRK.8.24"
            ]
          }
        },
        {
          "name": "verse",
