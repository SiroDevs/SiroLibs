                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And he took the blind man by the hand, and led him out of the village; and when he had spit on his eyes and laid his hands upon him, he asked him, “Do you see anything?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.23",
            "verseOrgIds": [
              "MRK.8.23"
            ]
