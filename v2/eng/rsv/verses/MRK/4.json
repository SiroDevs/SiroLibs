            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And he said to them, “Is a lamp brought in to be put under a bushel, or under a bed, and not on a stand? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
