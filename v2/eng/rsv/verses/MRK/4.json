          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.26"
              },
              "items": [
                {
                  "text": "Mt 10.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.17"
              },
              "items": [
                {
                  "text": "Lk 8.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.2"
              },
              "items": [
                {
                  "text": "12.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " For there is nothing hid, except to be made manifest; nor is anything secret, except to come to light. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.22",
            "verseOrgIds": [
              "MRK.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
