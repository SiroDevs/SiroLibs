                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " and Judas Iscariot, who betrayed him.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.19",
            "verseOrgIds": [
              "MRK.3.19"
            ]
          }
