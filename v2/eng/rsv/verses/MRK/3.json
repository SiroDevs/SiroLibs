            {
              "text": "demons.",
              "type": "text"
            },
            {
              "text": "16",
              "type": "text"
            },
            {
              "text": "So he appointed the twelve: Simon",
              "type": "text"
            }
          ]
        },
        {
          "text": " whom he surnamed Peter; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.16",
            "verseOrgIds": [
              "MRK.3.16"
            ]
          }
        },
