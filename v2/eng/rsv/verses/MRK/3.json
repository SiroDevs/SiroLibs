              "items": [
                {
                  "text": "6.56",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " for he had healed many, so that all who had diseases pressed upon him to touch him. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.10",
            "verseOrgIds": [
              "MRK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "And whenever the unclean spirits beheld him, they fell down before him and cried out, “You are the Son of God.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.11",
            "verseOrgIds": [
              "MRK.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.45"
              },
              "items": [
                {
                  "text": "Mk 1.45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And he strictly ordered them not to make him known.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.12",
            "verseOrgIds": [
              "MRK.3.12"
            ]
          }
        }
