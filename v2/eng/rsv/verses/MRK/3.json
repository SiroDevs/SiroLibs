            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.14",
              "type": "text"
            },
            {
              "text": "Other ancient authorities add",
              "type": "text"
            },
            {
              "text": "whom also he named apostles",
              "type": "text"
            }
          ]
        },
        {
          "text": " to be with him, and to be sent out to preach ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.14",
            "verseOrgIds": [
              "MRK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
