            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And he appointed twelve,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.14",
            "verseOrgIds": [
              "MRK.3.14"
            ]
          }
