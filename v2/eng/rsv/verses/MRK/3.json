                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And the scribes who came down from Jerusalem said, “He is possessed by Be-elzebul, and by the prince of demons he casts out the demons.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.22",
            "verseOrgIds": [
              "MRK.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "And he called them to him, and said to them in parables, “How can Satan cast out Satan? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.23",
            "verseOrgIds": [
              "MRK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "If a kingdom is divided against itself, that kingdom cannot stand. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.24",
            "verseOrgIds": [
              "MRK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "And if a house is divided against itself, that house will not be able to stand. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.25",
            "verseOrgIds": [
              "MRK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "And if Satan has risen up against himself and is divided, he cannot stand, but is coming to an end. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.26",
            "verseOrgIds": [
              "MRK.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.24+ISA.49.25"
              },
              "items": [
                {
                  "text": "Is 49.24-25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " But no one can enter a strong man's house and plunder his goods, unless he first binds the strong man; then indeed he may plunder his house.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.27",
            "verseOrgIds": [
              "MRK.3.27"
            ]
          }
        }
      ]
