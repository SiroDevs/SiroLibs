              "attrs": {
                "loc": "MAT.21.18+MAT.21.19"
              },
              "items": [
                {
                  "text": "Mt 21.18-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.6+LUK.13.7+LUK.13.8+LUK.13.9"
