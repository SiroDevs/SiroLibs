            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And he entered Jerusalem, and went into the temple; and when he had looked round at everything, as it was already late, he went out to Bethany with the twelve.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.11",
            "verseOrgIds": [
              "MRK.11.11"
            ]
          }
        }
