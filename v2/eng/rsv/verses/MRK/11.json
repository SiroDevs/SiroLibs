                "loc": "PSA.118.26"
              },
              "items": [
                {
                  "text": "Ps 118.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.15"
              },
              "items": [
                {
                  "text": "Mt 21.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.39"
              },
              "items": [
                {
                  "text": "23.39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And those who went before and those who followed cried out, “Hosanna! Blessed is he who comes in the name of the Lord! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.9",
            "verseOrgIds": [
              "MRK.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Blessed is the kingdom of our father David that is coming! Hosanna in the highest!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.10",
            "verseOrgIds": [
              "MRK.11.10"
            ]
          }
        }
      ]
    },
