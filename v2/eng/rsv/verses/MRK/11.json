                "loc": "MAT.7.7+MAT.7.8+MAT.7.9+MAT.7.10+MAT.7.11"
              },
              "items": [
                {
                  "text": "Mt 7.7-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Therefore I tell you, whatever you ask in prayer, believe that you have received",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.24",
            "verseOrgIds": [
              "MRK.11.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11.24",
              "type": "text"
            },
            {
              "text": "Other ancient authorities read",
              "type": "text"
            },
            {
              "text": "are receiving",
              "type": "text"
            }
          ]
        },
        {
          "text": " it, and it will be yours. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.24",
            "verseOrgIds": [
              "MRK.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.14+MAT.6.15"
              },
              "items": [
                {
                  "text": "Mt 6.14-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.35"
              },
              "items": [
                {
                  "text": "18.35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And whenever you stand praying, forgive, if you have anything against any one; so that your Father also who is in heaven may forgive you your trespasses.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.25",
            "verseOrgIds": [
              "MRK.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11.26",
              "type": "text"
            },
            {
              "text": "Other ancient authorities add verse 26,",
              "type": "text"
            },
            {
              "text": "“But if you do not forgive, neither will your Father who is in heaven forgive your trespasses”",
              "type": "text"
            }
          ]
        }
      ]
