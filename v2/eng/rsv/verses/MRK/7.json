        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.24",
            "verseOrgIds": [
              "MRK.7.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
