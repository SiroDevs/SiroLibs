              "MRK.7.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.29+MAT.15.30+MAT.15.31"
              },
              "items": [
                {
                  "text": "Mt 15.29-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Then he returned from the region of Tyre, and went through Sidon to the Sea of Galilee, through the region of the Decapolis. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.31",
            "verseOrgIds": [
              "MRK.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.5.23"
              },
              "items": [
                {
                  "text": "Mk 5.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And they brought to him a man who was deaf and had an impediment in his speech; and they besought him to lay his hand upon him. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.32",
            "verseOrgIds": [
              "MRK.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.23"
              },
              "items": [
                {
                  "text": "Mk 8.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And taking him aside from the multitude privately, he put his fingers into his ears, and he spat and touched his tongue; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.33",
            "verseOrgIds": [
              "MRK.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "and looking up to heaven, he sighed, and said to him, “Ephphatha,” that is, “Be opened.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.34",
            "verseOrgIds": [
              "MRK.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "And his ears were opened, his tongue was released, and he spoke plainly. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.35",
            "verseOrgIds": [
              "MRK.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.44"
              },
              "items": [
                {
                  "text": "Mk 1.44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.5.43"
              },
              "items": [
                {
                  "text": "5.43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And he charged them to tell no one; but the more he charged them, the more zealously they proclaimed it. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.36",
            "verseOrgIds": [
              "MRK.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "And they were astonished beyond measure, saying, “He has done all things well; he even makes the deaf hear and the dumb speak.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.37",
            "verseOrgIds": [
              "MRK.7.37"
            ]
          }
        }
      ]
