              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " You shall have one law for the sojourner and for the native; for I am the ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.22",
            "verseOrgIds": [
              "LEV.24.22"
            ]
          }
        },
        {
          "text": " your God.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.22",
