          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "to make a distinction between the unclean and the clean and between the living creature that may be eaten and the living creature that may not be eaten.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.47",
            "verseOrgIds": [
