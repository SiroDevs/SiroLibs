                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " For I am the ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.44",
            "verseOrgIds": [
              "LEV.11.44"
            ]
          }
        },
        {
          "text": " your God; consecrate yourselves therefore, and be holy, for I am holy. You shall not defile yourselves with any swarming thing that crawls upon the earth. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.44",
            "verseOrgIds": [
              "LEV.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "For I am the ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.45",
            "verseOrgIds": [
              "LEV.11.45"
            ]
          }
        },
        {
          "text": " who brought you up out of the land of Egypt, to be your God; you shall therefore be holy, for I am holy.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.45",
            "verseOrgIds": [
              "LEV.11.45"
            ]
          }
        }
