              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.38",
            "verseOrgIds": [
              "LEV.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "“And if any animal of which you may eat dies, he who touches its carcass shall be unclean until the evening, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.39",
            "verseOrgIds": [
              "LEV.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "and he who eats of its carcass shall wash his clothes and be unclean until the evening; he also who carries the carcass shall wash his clothes and be unclean until the evening.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.40",
            "verseOrgIds": [
              "LEV.11.40"
            ]
          }
        }
      ]
    },
