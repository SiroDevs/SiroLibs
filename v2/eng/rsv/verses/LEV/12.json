                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " The ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.1",
            "verseOrgIds": [
              "LEV.12.1"
            ]
          }
        },
        {
          "text": " said to Moses, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.1",
            "verseOrgIds": [
              "LEV.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Say to the people of Israel, If a woman conceives, and bears a male child, then she shall be unclean seven days; as at the time of her menstruation, she shall be unclean. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.2",
            "verseOrgIds": [
              "LEV.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "And on the eighth day the flesh of his foreskin shall be circumcised. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.3",
            "verseOrgIds": [
              "LEV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then she shall continue for thirty-three days in the blood of her purifying; she shall not touch any hallowed thing, nor come into the sanctuary, until the days of her purifying are completed. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.4",
            "verseOrgIds": [
              "LEV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "But if she bears a female child, then she shall be unclean two weeks, as in her menstruation; and she shall continue in the blood of her purifying for sixty-six days.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“And when the days of her purifying are completed, whether for a son or for a daughter, she shall bring to the priest at the door of the tent of meeting a lamb a year old for a burnt offering, and a young pigeon or a turtledove for a sin offering, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.6",
            "verseOrgIds": [
              "LEV.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "and he shall offer it before the ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.7",
            "verseOrgIds": [
              "LEV.12.7"
            ]
          }
        },
        {
          "text": ", and make atonement for her; then she shall be clean from the flow of her blood. This is the law for her who bears a child, either male or female. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.7",
            "verseOrgIds": [
              "LEV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "And if she cannot afford a lamb, then she shall take two turtledoves or two young pigeons, one for a burnt offering and the other for a sin offering; and the priest shall make atonement for her, and she shall be clean.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.8",
            "verseOrgIds": [
              "LEV.12.8"
            ]
          }
        }
      ]
    }
  ],
