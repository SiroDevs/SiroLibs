            {
              "text": "23.34",
              "type": "text"
            },
            {
              "text": "Or",
              "type": "text"
            },
            {
              "text": "tabernacles",
              "type": "text"
            }
          ]
        },
        {
          "text": " to the ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.34",
            "verseOrgIds": [
              "LEV.23.34"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.34",
            "verseOrgIds": [
              "LEV.23.34"
            ]
          }
        },
        {
