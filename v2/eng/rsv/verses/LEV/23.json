          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "On the first day shall be a holy convocation; you shall do no laborious work. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.35",
            "verseOrgIds": [
              "LEV.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seven days you shall present offerings by fire to the ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        },
        {
          "text": "; on the eighth day you shall hold a holy convocation and present an offering by fire to the ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        },
        {
          "text": "; it is a solemn assembly; you shall do no laborious work.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        }
      ]
