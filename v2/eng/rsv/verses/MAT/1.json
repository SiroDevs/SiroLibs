            {
              "text": "Greek",
              "type": "text"
            },
            {
              "text": "Aram",
              "type": "text"
            }
          ]
        },
        {
          "text": " the father of Amminadab, and Amminadab the father of Nahshon, and Nahshon the father of Salmon, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.4",
            "verseOrgIds": [
              "MAT.1.4"
