          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "They said to him, “Lord, let our eyes be opened.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.33",
            "verseOrgIds": [
              "MAT.20.33"
            ]
          }
        },
