                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " They said to him, “He will put those wretches to a miserable death, and let out the vineyard to other tenants who will give him the fruits in their seasons.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.41",
            "verseOrgIds": [
              "MAT.21.41"
            ]
          }
        }
      ]
