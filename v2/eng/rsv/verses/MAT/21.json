            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jesus said to them, “Have you never read in the scriptures:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
