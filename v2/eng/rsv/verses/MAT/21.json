        {
          "text": " And Jesus entered the temple of God",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.12",
            "verseOrgIds": [
              "MAT.21.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21.12",
              "type": "text"
            },
            {
              "text": "Other ancient authorities omit",
              "type": "text"
            },
            {
              "text": "of God",
              "type": "text"
            }
          ]
        },
        {
          "text": " and drove out all who sold and bought in the temple, and he overturned the tables of the money-changers and the seats of those who sold pigeons. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.12",
            "verseOrgIds": [
              "MAT.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
