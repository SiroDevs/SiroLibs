              "type": "text"
            }
          ]
        },
        {
          "text": " But she came and knelt before him, saying, “Lord, help me.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.25",
            "verseOrgIds": [
              "MAT.15.25"
            ]
          }
        },
        {
