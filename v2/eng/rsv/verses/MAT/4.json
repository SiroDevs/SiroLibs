        {
          "text": " And he went about all Galilee, teaching in their synagogues and preaching the gospel of the kingdom and healing every disease and every infirmity among the people. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.23",
            "verseOrgIds": [
              "MAT.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
