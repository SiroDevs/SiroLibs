                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Now the eleven disciples went to Galilee, to the mountain to which Jesus had directed them. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.16",
            "verseOrgIds": [
              "MAT.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "And when they saw him they worshiped him; but some doubted. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.17",
            "verseOrgIds": [
              "MAT.28.17"
            ]
          }
        },
        {
