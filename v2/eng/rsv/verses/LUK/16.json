          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“There was a rich man, who was clothed in purple and fine linen and who feasted sumptuously every day. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.19",
            "verseOrgIds": [
              "LUK.16.19"
            ]
          }
        },
