                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " But Abraham said, ‘They have Moses and the prophets; let them hear them.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.29",
            "verseOrgIds": [
              "LUK.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.8"
              },
              "items": [
                {
                  "text": "Lk 3.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.9"
              },
              "items": [
                {
                  "text": "19.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And he said, ‘No, father Abraham; but if some one goes to them from the dead, they will repent.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.30",
            "verseOrgIds": [
              "LUK.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "He said to him, ‘If they do not hear Moses and the prophets, neither will they be convinced if some one should rise from the dead.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.31",
            "verseOrgIds": [
              "LUK.16.31"
            ]
          }
