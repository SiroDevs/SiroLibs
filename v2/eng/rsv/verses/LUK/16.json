        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.1+JHN.11.2+JHN.11.3+JHN.11.4+JHN.11.5+JHN.11.6+JHN.11.7+JHN.11.8+JHN.11.9+JHN.11.10+JHN.11.11+JHN.11.12+JHN.11.13+JHN.11.14+JHN.11.15+JHN.11.16+JHN.11.17+JHN.11.18+JHN.11.19+JHN.11.20+JHN.11.21+JHN.11.22+JHN.11.23+JHN.11.24+JHN.11.25+JHN.11.26+JHN.11.27+JHN.11.28+JHN.11.29+JHN.11.30+JHN.11.31+JHN.11.32+JHN.11.33+JHN.11.34+JHN.11.35+JHN.11.36+JHN.11.37+JHN.11.38+JHN.11.39+JHN.11.40+JHN.11.41+JHN.11.42+JHN.11.43+JHN.11.44"
              },
