          ]
        },
        {
          "text": " “Every one who divorces his wife and marries another commits adultery, and he who marries a woman divorced from her husband commits adultery.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
            "verseOrgIds": [
              "LUK.16.18"
            ]
          }
        }
