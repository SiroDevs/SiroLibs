            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
            "style": "v",
            "sid": "LUK 1:67"
          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "And his father Zechariah was filled with the Holy Spirit, and prophesied, saying,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.67",
            "verseOrgIds": [
              "LUK.1.67"
            ]
          }
        }
