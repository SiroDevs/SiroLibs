            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And again he said, “To what shall I compare the kingdom of God? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
              "LUK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "It is like leaven which a woman took and hid in three measures of flour, till it was all leavened.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.21",
            "verseOrgIds": [
              "LUK.13.21"
            ]
          }
        }
      ]
    },
