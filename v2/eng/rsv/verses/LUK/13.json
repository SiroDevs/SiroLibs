        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.17",
            "verseOrgIds": [
              "LUK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 13:18"
          },
          "items": [
