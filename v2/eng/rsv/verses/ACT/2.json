          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "and they sold their possessions and goods and distributed them to all, as any had need. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.45",
            "verseOrgIds": [
              "ACT.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
