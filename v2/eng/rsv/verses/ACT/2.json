                "loc": "ACT.4.32+ACT.4.33+ACT.4.34+ACT.4.35"
              },
              "items": [
                {
                  "text": "Acts 4.32-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And all who believed were together and had all things in common; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.44",
            "verseOrgIds": [
              "ACT.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
