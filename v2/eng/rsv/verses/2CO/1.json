          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "But I call God to witness against me—it was to spare you that I refrained from coming to Corinth. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.23",
            "verseOrgIds": [
              "2CO.1.23"
            ]
          }
        },
