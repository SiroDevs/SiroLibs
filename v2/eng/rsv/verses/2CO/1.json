          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "he has put his seal upon us and given us his Spirit in our hearts as a guarantee.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.22",
            "verseOrgIds": [
              "2CO.1.22"
            ]
          }
        }
