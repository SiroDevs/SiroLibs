            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Our mouth is open to you, Corinthians; our heart is wide. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.11",
            "verseOrgIds": [
              "2CO.6.11"
