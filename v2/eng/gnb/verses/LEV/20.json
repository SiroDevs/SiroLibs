              "items": [
                {
                  "text": "Mk 7.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.9",
            "verseOrgIds": [
              "LEV.20.9"
            ]
          }
        },
        {
          "text": " gave the following regulations. Anyone who curses his father or his mother shall be put to death; he is responsible for his own death.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.9",
            "verseOrgIds": [
              "LEV.20.9"
            ]
          }
        }
      ]
