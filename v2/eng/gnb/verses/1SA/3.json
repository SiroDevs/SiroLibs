          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "But Eli answered, “I didn't call you; go back to bed.” So Samuel went back to bed.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.5",
            "verseOrgIds": [
              "1SA.3.5"
            ]
          }
        }
