          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuel stayed in bed until morning; then he got up and opened the doors of the house of the ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.15",
            "verseOrgIds": [
              "1SA.3.15"
            ]
          }
        },
