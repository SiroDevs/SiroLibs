          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
            "verseOrgIds": [
              "1SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
