          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "David made this a rule, and it has been followed in Israel ever since.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.25",
            "verseOrgIds": [
              "1SA.30.25"
            ]
