            "verseOrgIds": [
              "1SA.12.23"
            ]
          }
        },
        {
          "text": " forbid that I should sin against him by no longer praying for you. Instead, I will teach you what is good and right for you to do. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.23",
            "verseOrgIds": [
              "1SA.12.23"
            ]
          }
        },
