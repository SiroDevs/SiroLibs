          "attrs": {
            "verseId": "1SA.12.24",
            "verseOrgIds": [
              "1SA.12.24"
            ]
          }
        },
        {
          "text": " and serve him faithfully with all your heart. Remember the great things he has done for you. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.24",
            "verseOrgIds": [
              "1SA.12.24"
            ]
          }
