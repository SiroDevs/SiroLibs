          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.5",
            "verseOrgIds": [
              "1SA.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
