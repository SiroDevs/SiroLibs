              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "David said to him, “When I saw Doeg there that day, I knew that he would be sure to tell Saul. So I am responsible",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.22",
            "verseOrgIds": [
