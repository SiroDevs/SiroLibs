              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "So the cook brought the choice piece of the leg and placed it before Saul. Samuel",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.24",
            "verseOrgIds": [
              "1SA.9.24"
            ]
