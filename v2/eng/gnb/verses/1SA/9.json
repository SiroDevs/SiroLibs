              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "So Saul ate with Samuel that day. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.24",
            "verseOrgIds": [
              "1SA.9.24"
            ]
          }
        },
