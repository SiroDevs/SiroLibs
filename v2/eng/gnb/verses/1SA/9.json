              "text": "9.25",
              "type": "text"
            },
            {
              "text": "One ancient translation",
              "type": "text"
            },
            {
              "text": "they made up a bed for Saul",
              "type": "text"
            },
            {
              "text": "; Hebrew",
              "type": "text"
            },
            {
              "text": "he spoke with Saul.",
              "type": "text"
            }
          ]
        },
        {
          "text": " on the roof,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.25",
