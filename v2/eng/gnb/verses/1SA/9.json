          ]
        },
        {
          "text": " said, “Look, here is the piece that was kept for you. Eat it. I saved it for you to eat at this time with the people I invited.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.24",
            "verseOrgIds": [
