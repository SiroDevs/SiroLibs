          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "I asked him for this child, and he gave me what I asked for. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.27",
            "verseOrgIds": [
              "1SA.1.27"
            ]
          }
        },
        {
