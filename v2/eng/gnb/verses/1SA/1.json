          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hannah said to him, “Excuse me, sir. Do you remember me? I am the woman you saw standing here, praying to the ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.26",
            "verseOrgIds": [
              "1SA.1.26"
            ]
