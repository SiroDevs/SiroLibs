          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "So I am dedicating him to the ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        },
        {
          "text": ". As long as he lives, he will belong to the ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        },
