        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.23",
            "verseOrgIds": [
              "1SA.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
