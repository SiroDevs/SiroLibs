          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bring King Agag here to me,” Samuel ordered. Agag came to him, trembling with fear, thinking to himself, “What a bitter thing it is to die!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.32",
            "verseOrgIds": [
              "1SA.15.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15.32",
              "type": "text"
            },
            {
              "text": "trembling with fear",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "die",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "confidently, thinking to himself, “Surely the bitter danger of death is past!”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.32",
            "verseOrgIds": [
              "1SA.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuel said, “As your sword has made many mothers childless, so now will your mother become childless.” And he cut Agag to pieces in front of the altar in Gilgal.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        }
      ]
