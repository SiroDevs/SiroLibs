            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.22"
              },
              "items": [
                {
                  "text": "Acts 15.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.40"
              },
              "items": [
                {
                  "text": "40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I write you this brief letter with the help of Silas, whom I regard as a faithful fellow-Christian. I want to encourage you and give my testimony that this is the true grace of God. Stand firm in it.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
        }
      ]
    },
