            "number": "6",
            "style": "v",
            "sid": "EZR 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Again, in the reign of Artaxerxes, emperor of Persia, Bishlam, Mithredath, Tabeel, and their associates wrote a letter to the emperor. The letter was written in Aramaic",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4.7",
              "type": "text"
            },
            {
              "text": "Aramaic",
              "type": "text"
            },
            {
              "text": ": From 4.8 to 6.18 this book is not in Hebrew, but Aramaic, the official language of the Persian Empire.",
              "type": "text"
            }
          ]
        },
        {
          "text": " and was to be translated when read.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4.7",
              "type": "text"
            },
            {
              "text": "The letter",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "read",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "It was in Aramaic and was written in the Aramaic script.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
