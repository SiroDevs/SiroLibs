          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Also Rehum, the governor, and Shimshai, the secretary of the province, wrote the following letter to Artaxerxes about Jerusalem:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        }
      ]
