            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "At the beginning of the reign of Xerxes the emperor, the enemies of the people living in Judah and Jerusalem brought written charges against them.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        }
      ]
    },
    {
