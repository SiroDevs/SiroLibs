          "attrs": {
            "verseId": "JOS.24.27",
            "verseOrgIds": [
              "JOS.24.27"
            ]
          }
        },
        {
          "text": " has spoken to us. So it will be a witness against you, to keep you from rebelling against your God.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.27",
            "verseOrgIds": [
              "JOS.24.27"
            ]
          }
        },
