{
  "id": "HAB.1",
  "number": "1",
  "bookId": "HAB",
  "reference": "Habakkuk 1",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
