          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "You will be destroyed by fire. Your blood will be shed in your own country, and no one will remember you any more.’ ” The ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.32",
            "verseOrgIds": [
