            "number": "31",
            "style": "v",
            "sid": "EZK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "You will feel my anger when I turn it loose on you like a blazing fire. And I will hand you over to brutal men, experts at destruction. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.31",
            "verseOrgIds": [
              "EZK.21.31"
            ]
          }
        },
