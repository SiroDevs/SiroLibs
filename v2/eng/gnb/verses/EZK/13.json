            "verseId": "EZK.13.1",
            "verseOrgIds": [
              "EZK.13.1"
            ]
          }
        },
        {
          "text": " spoke to me. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.1",
            "verseOrgIds": [
              "EZK.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mortal man,” he said, “denounce the prophets of Israel who make up their own prophecies. Tell them to listen to the word of the ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.2",
            "verseOrgIds": [
              "EZK.13.2"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.2",
            "verseOrgIds": [
              "EZK.13.2"
            ]
          }
        }
      ]
    },
    {
