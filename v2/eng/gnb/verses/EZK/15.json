              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.5",
            "verseOrgIds": [
              "EZK.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now this is what the Sovereign ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.6",
            "verseOrgIds": [
              "EZK.15.6"
            ]
          }
        },
        {
          "text": " is saying, “Just as a vine is taken from the forest and burnt, so I will take the people who live in Jerusalem ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.6",
            "verseOrgIds": [
              "EZK.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "and will punish them. They have escaped one fire, but now fire will burn them up. When I punish them, you will know that I am the ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.7",
            "verseOrgIds": [
              "EZK.15.7"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.7",
            "verseOrgIds": [
              "EZK.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "They have been unfaithful to me, and so I will make the country a wilderness.” The Sovereign ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.8",
            "verseOrgIds": [
              "EZK.15.8"
            ]
          }
        },
        {
          "text": " has spoken.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.8",
            "verseOrgIds": [
              "EZK.15.8"
            ]
          }
        }
