        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.8",
            "verseOrgIds": [
              "EZK.45.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Sovereign ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.9",
            "verseOrgIds": [
              "EZK.45.9"
            ]
          }
        },
        {
          "text": " said, “You have sinned too long, you rulers of Israel! Stop your violence and oppression. Do what is right and just. You must never again drive my people off their land. I, the Sovereign ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.9",
            "verseOrgIds": [
              "EZK.45.9"
            ]
          }
        },
        {
          "text": ", am telling you this.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.9",
            "verseOrgIds": [
              "EZK.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
