          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“This is the basis on which you are to make your offerings:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13+EZK.45.14+EZK.45.15",
            "verseOrgIds": [
              "EZK.45.13",
              "EZK.45.14",
              "EZK.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“You are to bring grain offerings, animals to be burnt whole, and animals for fellowship offerings, so that your sins will be forgiven. I, the Sovereign ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13+EZK.45.14+EZK.45.15",
            "verseOrgIds": [
              "EZK.45.13",
              "EZK.45.14",
              "EZK.45.15"
            ]
          }
        },
        {
          "text": ", command it.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13+EZK.45.14+EZK.45.15",
            "verseOrgIds": [
              "EZK.45.13",
              "EZK.45.14",
              "EZK.45.15"
            ]
          }
        }
      ]
    },
