            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        },
        {
          "text": " for dry measure is to be equal to the ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        },
        {
          "text": " for liquid measure. The standard is the ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45.11",
              "type": "text"
            },
            {
              "text": "homer",
              "type": "text"
            },
            {
              "text": ": A unit of dry or liquid measure, about 175 litres; so an",
              "type": "text"
            },
            {
              "text": "ephah",
              "type": "text"
            },
            {
              "text": "or a",
              "type": "text"
            },
            {
              "text": "bath",
              "type": "text"
            },
            {
              "text": "would be about 17.5 litres.",
              "type": "text"
            }
          ]
        },
        {
          "text": " The resulting measures are as follows:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        }
