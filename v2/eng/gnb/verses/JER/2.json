          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Sovereign ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.20",
            "verseOrgIds": [
              "JER.2.20"
            ]
          }
        },
        {
