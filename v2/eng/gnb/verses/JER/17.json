          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.13",
            "verseOrgIds": [
              "JER.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.14",
            "verseOrgIds": [
              "JER.17.14"
            ]
          }
        },
        {
          "text": ", heal me and I will be completely well; rescue me and I will be perfectly safe. You are the one I praise!",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.14",
            "verseOrgIds": [
              "JER.17.14"
            ]
          }
        }
