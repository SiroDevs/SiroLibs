        },
        {
          "text": "This book is the account of what was said by Jeremiah son of Hilkiah, one of the priests of the town of Anathoth in the territory of Benjamin. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
