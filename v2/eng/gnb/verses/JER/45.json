              "type": "text"
            }
          ]
        },
        {
          "text": "you are saying, ‘I give up! The ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        },
        {
