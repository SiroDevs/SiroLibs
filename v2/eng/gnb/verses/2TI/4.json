                "loc": "ACT.12.12"
              },
              "items": [
                {
                  "text": "Acts 12.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.13"
              },
              "items": [
                {
                  "text": "13.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.37+ACT.15.38+ACT.15.39"
              },
              "items": [
                {
                  "text": "15.37–39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.10"
              },
              "items": [
                {
                  "text": "Col 4.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Only Luke is with me. Get Mark and bring him with you, because he can help me in the work. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.11",
            "verseOrgIds": [
              "2TI.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.4"
              },
              "items": [
                {
                  "text": "Acts 20.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.21+EPH.6.22"
              },
              "items": [
                {
                  "text": "Eph 6.21–22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.7+COL.4.8"
              },
              "items": [
                {
                  "text": "Col 4.7–8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I sent Tychicus to Ephesus. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.12",
            "verseOrgIds": [
              "2TI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.6"
              },
              "items": [
                {
                  "text": "Acts 20.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "When you come, bring my coat that I left in Troas with Carpus; bring the books too, and especially the ones made of parchment.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.13",
            "verseOrgIds": [
              "2TI.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
