          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.2"
              },
              "items": [
                {
                  "text": "Acts 18.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.1.16+2TI.1.17"
              },
              "items": [
                {
                  "text": "2 Tim 1.16–17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I send greetings to Priscilla and Aquila and to the family of Onesiphorus. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.19",
            "verseOrgIds": [
              "2TI.4.19"
            ]
          }
        },
        {
          "name": "verse",
