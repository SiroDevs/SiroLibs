          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Job stood up and tore his clothes in grief. He shaved his head and threw himself face downwards on the ground. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.20",
            "verseOrgIds": [
              "JOB.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "He said, “I was born with nothing, and I will die with nothing. The ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.21",
            "verseOrgIds": [
              "JOB.1.21"
            ]
          }
        },
        {
          "text": " gave, and now he has taken away. May his name be praised!”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.21",
            "verseOrgIds": [
              "JOB.1.21"
            ]
          }
        }
      ]
