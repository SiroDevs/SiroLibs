              "items": [
                {
                  "text": "1 Pet 5.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "He has no use for conceited people, but shows favour to those who are humble. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.34",
            "verseOrgIds": [
              "PRO.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
