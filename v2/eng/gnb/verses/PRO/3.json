          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wise people will gain an honourable reputation, but stupid people will only add to their own disgrace.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.35",
            "verseOrgIds": [
              "PRO.3.35"
