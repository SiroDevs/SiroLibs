          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Better to live on the roof than share the house with a nagging wife.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.24",
            "verseOrgIds": [
              "PRO.25.24"
            ]
          }
        }
      ]
