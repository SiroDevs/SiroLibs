                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "If your enemies are hungry, feed them; if they are thirsty, give them a drink. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.21",
            "verseOrgIds": [
              "PRO.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "You will make them burn with shame, and the ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.22",
            "verseOrgIds": [
              "PRO.25.22"
            ]
          }
        },
        {
          "text": " will reward you.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.22",
            "verseOrgIds": [
              "PRO.25.22"
            ]
          }
        }
      ]
