          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "A good person who gives in to someone who is evil reminds you of a polluted spring or a poisoned well.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.26",
            "verseOrgIds": [
              "PRO.25.26"
            ]
          }
        }
      ]
    },
