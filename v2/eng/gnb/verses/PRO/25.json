          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.22",
            "verseOrgIds": [
              "PRO.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
