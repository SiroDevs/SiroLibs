          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gossip brings anger just as surely as the north wind brings rain.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.23",
            "verseOrgIds": [
              "PRO.25.23"
            ]
          }
        }
