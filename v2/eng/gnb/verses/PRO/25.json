          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finally, hearing good news from a distant land is like a drink of cold water when you are dry and thirsty.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.25",
            "verseOrgIds": [
              "PRO.25.25"
            ]
          }
        }
