          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Human desires are like the world of the dead — there is always room for more.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.20",
            "verseOrgIds": [
              "PRO.27.20"
            ]
          }
        }
