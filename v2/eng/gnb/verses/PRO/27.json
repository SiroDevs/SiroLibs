          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Even if you beat fools until they're half dead, you still can't beat their foolishness out of them.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.22",
            "verseOrgIds": [
              "PRO.27.22"
            ]
          }
        }
      ]
