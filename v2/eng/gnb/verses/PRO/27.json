          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fire tests gold and silver; a person's reputation can also be tested.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.21",
            "verseOrgIds": [
              "PRO.27.21"
            ]
          }
        }
