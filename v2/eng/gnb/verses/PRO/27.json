          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "It is your own face that you see reflected in the water and it is your own self that you see in your heart.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.19",
            "verseOrgIds": [
              "PRO.27.19"
            ]
          }
        }
      ]
