          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Take care of a fig tree and you will have figs to eat. Servants who take care of their master will be honoured.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.18",
            "verseOrgIds": [
              "PRO.27.18"
            ]
          }
        }
      ]
