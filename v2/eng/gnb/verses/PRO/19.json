          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "If someone has a hot temper, let him take the consequences. If you get him out of trouble once, you will have to do it again.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.19",
            "verseOrgIds": [
              "PRO.19.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19.19",
              "type": "text"
            },
            {
              "text": "get him out",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "again",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "try to get him out of trouble, you only make things worse.",
              "type": "text"
            }
          ]
        }
      ]
    },
