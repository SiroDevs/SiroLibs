          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.12",
            "verseOrgIds": [
              "PRO.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
