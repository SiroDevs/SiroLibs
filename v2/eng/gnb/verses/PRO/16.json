          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "It is better to have a little, honestly earned, than to have a large income gained dishonestly.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.8",
            "verseOrgIds": [
              "PRO.16.8"
            ]
          }
        }
      ]
    },
    {
