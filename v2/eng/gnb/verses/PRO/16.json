              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "You may think everything you do is right, but the ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.2",
            "verseOrgIds": [
              "PRO.16.2"
            ]
          }
        },
        {
          "text": " judges your motives.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.2",
            "verseOrgIds": [
              "PRO.16.2"
            ]
          }
        }
      ]
