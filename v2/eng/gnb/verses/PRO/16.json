          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.11",
            "verseOrgIds": [
              "PRO.16.11"
            ]
          }
        },
        {
          "text": " wants weights and measures to be honest and every sale to be fair.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.11",
            "verseOrgIds": [
              "PRO.16.11"
            ]
          }
        }
      ]
