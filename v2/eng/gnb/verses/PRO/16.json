          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be loyal and faithful, and God will forgive your sin. Obey the ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.6",
            "verseOrgIds": [
              "PRO.16.6"
            ]
          }
        },
        {
          "text": " and nothing evil will happen to you.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.6",
            "verseOrgIds": [
              "PRO.16.6"
            ]
          }
        }
      ]
    },
