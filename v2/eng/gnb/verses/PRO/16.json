          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "You may make your plans, but God directs your actions.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.9",
            "verseOrgIds": [
              "PRO.16.9"
            ]
          }
        }
      ]
    },
