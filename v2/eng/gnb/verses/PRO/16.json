              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "We may make our plans, but God has the last word.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.1",
            "verseOrgIds": [
              "PRO.16.1"
            ]
          }
        },
        {
