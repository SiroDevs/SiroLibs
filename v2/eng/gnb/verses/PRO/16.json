          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kings cannot tolerate evil,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.12",
            "verseOrgIds": [
              "PRO.16.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16.12",
              "type": "text"
            },
            {
              "text": "Kings",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "evil",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "It is intolerable for kings to do evil.",
              "type": "text"
            }
          ]
        },
        {
          "text": " because justice is what makes a government strong.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.12",
            "verseOrgIds": [
              "PRO.16.12"
            ]
          }
        }
      ]
    },
