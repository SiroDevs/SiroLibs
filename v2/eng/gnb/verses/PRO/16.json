          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ask the ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.3",
            "verseOrgIds": [
              "PRO.16.3"
            ]
          }
        },
        {
          "text": " to bless your plans, and you will be successful in carrying them out.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.3",
            "verseOrgIds": [
              "PRO.16.3"
            ]
          }
        }
      ]
    },
