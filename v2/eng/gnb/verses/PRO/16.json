          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16.1",
              "type": "text"
            },
            {
              "text": "God",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "word",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "God inspires our words.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
