          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "A wise person will try to keep the king happy; if the king becomes angry, someone may die.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.14",
            "verseOrgIds": [
              "PRO.16.14"
            ]
          }
        }
      ]
    },
