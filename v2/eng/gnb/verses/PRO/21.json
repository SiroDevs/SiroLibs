          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Better to live out in the desert than with a nagging, complaining wife.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.19",
            "verseOrgIds": [
              "PRO.21.19"
            ]
          }
        }
      ]
    },
