            "verseId": "PRO.21.27",
            "verseOrgIds": [
              "PRO.21.27"
            ]
          }
        },
        {
          "text": " hates it when wicked people offer him sacrifices, especially if they do it from evil motives.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.27",
            "verseOrgIds": [
              "PRO.21.27"
            ]
          }
        }
      ]
