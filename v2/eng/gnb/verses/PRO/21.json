          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wise people live in wealth and luxury, but stupid people spend their money as fast as they get it.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.20",
            "verseOrgIds": [
              "PRO.21.20"
            ]
          }
        }
      ]
    },
