          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "A shrewd general can take a city defended by strong men, and destroy the walls they relied on.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.22",
            "verseOrgIds": [
              "PRO.21.22"
            ]
          }
        }
