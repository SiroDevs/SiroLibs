          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be kind and honest and you will live a long life; others will respect you and treat you fairly.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.21",
            "verseOrgIds": [
              "PRO.21.21"
            ]
          }
        }
      ]
    },
