          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Show me a conceited person and I will show you someone who is arrogant, proud, and inconsiderate.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.24",
            "verseOrgIds": [
              "PRO.21.24"
            ]
          }
        }
      ]
