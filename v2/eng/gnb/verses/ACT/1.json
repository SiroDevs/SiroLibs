          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "All the people living in Jerusalem heard about it, and so in their own language they call that field Akeldama, which means “Field of Blood”.)",
