            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.21–22",
              "type": "text"
            },
            {
              "text": "John preached his message of baptism",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "John baptized him.",
              "type": "text"
            }
          ]
        },
        {
          "text": " until the day Jesus was taken up from us to heaven.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.21+ACT.1.22",
            "verseOrgIds": [
              "ACT.1.21",
              "ACT.1.22"
            ]
