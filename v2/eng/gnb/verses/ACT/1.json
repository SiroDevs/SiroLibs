          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "When the apostles met together with Jesus, they asked him, “Lord, will you at this time give the Kingdom back to Israel?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.6",
            "verseOrgIds": [
              "ACT.1.6"
            ]
          }
        }
      ]
