              "items": [
                {
                  "text": "Mt 27.3–8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "(With the money that Judas got for his evil act he bought a field, where he fell to his death; he burst open and all his bowels spilt out. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.18",
            "verseOrgIds": [
              "ACT.1.18"
            ]
          }
        },
        {
