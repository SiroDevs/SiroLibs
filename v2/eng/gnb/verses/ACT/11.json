          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
