              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 56:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        },
        {
          "text": " says to those foreigners who become part of his people, who love him and serve him, who observe the Sabbath and faithfully keep his covenant: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 56:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.13"
              },
              "items": [
                {
                  "text": "Mt 21.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.17"
              },
              "items": [
                {
                  "text": "Mk 11.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.46"
              },
              "items": [
                {
                  "text": "Lk 19.46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“I will bring you to Zion, my sacred hill,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "56.7",
              "type": "text"
            },
            {
              "text": "sacred hill",
              "type": "text"
            },
            {
              "text": ": See 2.3.",
              "type": "text"
            }
          ]
        },
        {
          "text": " give you joy in my house of prayer, and accept the sacrifices you offer on my altar. My Temple will be called a house of prayer for the people of all nations.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
    },
