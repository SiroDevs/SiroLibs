              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "About this time King Hezekiah fell ill and almost died. The prophet Isaiah son of Amoz went to see him and said to him, “The ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        },
        {
          "text": " tells you that you are to put everything in order because you will not recover. Get ready to die.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiah turned his face to the wall and prayed: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.2",
            "verseOrgIds": [
              "ISA.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Remember, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        },
        {
          "text": ", that I have served you faithfully and loyally, and that I have always tried to do what you wanted me to.” And he began to cry bitterly.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.4",
            "verseOrgIds": [
              "ISA.38.4"
            ]
          }
        },
        {
          "text": " commanded Isaiah ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.4",
            "verseOrgIds": [
              "ISA.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "to go back to Hezekiah and say to him, “I, the ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "text": ", the God of your ancestor David, have heard your prayer and seen your tears; I will let you live fifteen years longer. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will rescue you and this city of Jerusalem from the emperor of Assyria, and I will continue to protect the city.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.6",
            "verseOrgIds": [
              "ISA.38.6"
            ]
          }
        }
      ]
    },
