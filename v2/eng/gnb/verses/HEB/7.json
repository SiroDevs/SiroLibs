              "attrs": {
                "loc": "LEV.9.7"
              },
              "items": [
                {
                  "text": "Lev 9.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "He is not like other high priests; he does not need to offer sacrifices every day for his own sins first and then for the sins of the people. He offered one sacrifice, once and for all, when he offered himself. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.27",
            "verseOrgIds": [
              "HEB.7.27"
            ]
          }
        },
        {
          "name": "verse",
