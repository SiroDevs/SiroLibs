                {
                  "text": "1 Chr 17.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "For God never said to any of his angels:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
