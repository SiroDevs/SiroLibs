            }
          ]
        },
        {
          "text": "and said to him, “This is what the ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        },
        {
          "text": " says: ‘Because you sent messengers to consult Baalzebub, the god of Ekron — as if there were no god in Israel to consult — you will not get well; you will die!’ ”",
          "type": "text",
