              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "After the death of King Ahab of Israel, the country of Moab rebelled against Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.1",
            "verseOrgIds": [
              "2KI.1.1"
            ]
          }
        }
      ]
