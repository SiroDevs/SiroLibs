            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.1"
              },
              "items": [
                {
                  "text": "Jer 37.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.13"
              },
              "items": [
                {
                  "text": "Ezek 17.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nebuchadnezzar made Jehoiachin's uncle Mattaniah king of Judah and changed his name to Zedekiah.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.17",
            "verseOrgIds": [
              "2KI.24.17"
            ]
          }
        }
      ]
