          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.19",
            "verseOrgIds": [
              "2KI.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "The next morning, at the time of the regular morning sacrifice, water came flowing from the direction of Edom, and covered the ground.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.20",
            "verseOrgIds": [
              "2KI.3.20"
            ]
          }
        }
      ]
    },
