                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "who heard their groaning and remembered his covenant with Abraham, Isaac, and Jacob. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.24",
            "verseOrgIds": [
              "EXO.2.24"
