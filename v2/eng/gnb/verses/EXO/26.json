          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "For this curtain make five posts of acacia wood covered with gold and fitted with gold hooks; make five bronze bases for these posts.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.37",
            "verseOrgIds": [
