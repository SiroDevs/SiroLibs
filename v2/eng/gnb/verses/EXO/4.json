          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meanwhile the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.27",
            "verseOrgIds": [
              "EXO.4.27"
            ]
          }
        },
        {
          "text": " had said to Aaron, “Go into the desert to meet Moses.” So he went to meet him at the holy mountain; and when he met him, he kissed him. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.27",
            "verseOrgIds": [
              "EXO.4.27"
            ]
          }
        },
