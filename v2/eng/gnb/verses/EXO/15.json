              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Israelites walked through the sea on dry ground. But when the Egyptian chariots with their horses and drivers went into the sea, the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.19",
            "verseOrgIds": [
              "EXO.15.19"
            ]
          }
        },
        {
          "text": " brought the water back, and it covered them.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.19",
            "verseOrgIds": [
              "EXO.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
