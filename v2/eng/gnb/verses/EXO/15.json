          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "There the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
            "verseOrgIds": [
              "EXO.15.25"
            ]
          }
        },
        {
          "text": " gave them laws to live by, and there he also tested them. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
            "verseOrgIds": [
              "EXO.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "He said, “If you will obey me completely by doing what I consider right and by keeping my commands, I will not punish you with any of the diseases that I brought on the Egyptians. I am the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.26",
            "verseOrgIds": [
              "EXO.15.26"
            ]
          }
        },
        {
          "text": ", the one who heals you.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.26",
            "verseOrgIds": [
              "EXO.15.26"
            ]
          }
        }
      ]
    },
