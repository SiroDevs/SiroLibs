      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.11",
            "verseOrgIds": [
              "EXO.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.12",
            "verseOrgIds": [
              "EXO.24.12"
            ]
          }
        },
        {
          "text": " said to Moses, “Come up the mountain to me, and while you are here, I will give you two stone tablets which contain all the laws that I have written for the instruction of the people.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.12",
            "verseOrgIds": [
              "EXO.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moses and his helper Joshua got ready, and Moses began",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.13",
            "verseOrgIds": [
              "EXO.24.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "24.13",
              "type": "text"
            },
            {
              "text": "Moses began",
              "type": "text"
            },
            {
              "text": "; one ancient translation",
              "type": "text"
            },
            {
              "text": "they began.",
              "type": "text"
            }
          ]
        },
        {
          "text": " to go up the holy mountain. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.13",
            "verseOrgIds": [
              "EXO.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moses said to the leaders, “Wait here in the camp for us until we come back. Aaron and Hur are here with you; and so whoever has a dispute to settle can go to them.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.14",
            "verseOrgIds": [
              "EXO.24.14"
            ]
          }
        }
      ]
    },
