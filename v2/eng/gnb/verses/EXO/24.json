                  "text": "10.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Then Moses took the blood in the bowls and threw it on the people. He said, “This is the blood that seals the covenant which the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
            "verseOrgIds": [
              "EXO.24.8"
            ]
          }
        },
        {
          "text": " made with you when he gave all these commands.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
            "verseOrgIds": [
              "EXO.24.8"
            ]
          }
        }
      ]
