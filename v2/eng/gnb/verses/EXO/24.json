              "EXO.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moses went up Mount Sinai, and a cloud covered it. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.15",
            "verseOrgIds": [
              "EXO.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "The dazzling light of the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.16+EXO.24.17",
            "verseOrgIds": [
              "EXO.24.16",
              "EXO.24.17"
            ]
          }
        },
        {
          "text": "'s presence came down on the mountain. To the Israelites the light looked like a fire burning on top of the mountain. The cloud covered the mountain for six days, and on the seventh day the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.16+EXO.24.17",
            "verseOrgIds": [
              "EXO.24.16",
              "EXO.24.17"
            ]
          }
        },
        {
          "text": " called to Moses from the cloud. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.16+EXO.24.17",
            "verseOrgIds": [
              "EXO.24.16",
              "EXO.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.9"
              },
              "items": [
                {
                  "text": "Deut 9.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moses went on up the mountain into the cloud. There he stayed for forty days and nights.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.18",
            "verseOrgIds": [
              "EXO.24.18"
            ]
          }
        }
