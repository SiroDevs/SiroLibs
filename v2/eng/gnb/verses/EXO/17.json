              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "LORD",
              "type": "text"
            },
            {
              "text": "; Hebrew unclear.",
              "type": "text"
            }
          ]
        },
        {
          "text": " The ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        },
        {
