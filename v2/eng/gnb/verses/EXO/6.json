          ]
        },
        {
          "text": "Then the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        },
        {
          "text": " said to Moses, “Now you are going to see what I will do to the king. I will force him to let my people go. In fact, I will force him to drive them out of his land.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
