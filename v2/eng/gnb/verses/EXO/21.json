              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Whoever kidnaps someone, either to sell him or to keep him as a slave, is to be put to death.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.16",
            "verseOrgIds": [
              "EXO.21.16"
            ]
          }
        }
