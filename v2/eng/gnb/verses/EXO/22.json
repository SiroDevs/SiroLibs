          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Give me the firstborn of your cattle and your sheep. Let the firstborn male stay with its mother for seven days, and on the eighth day offer it to me.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.30"
            ]
