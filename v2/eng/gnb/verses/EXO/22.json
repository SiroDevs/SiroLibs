              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Give me your firstborn sons. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.29"
            ]
