                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“If a man seduces a virgin who is not engaged, he must pay the bride price for her and marry her. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "But if her father refuses to let him marry her, he must pay the father a sum of money equal to the bride price for a virgin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        }
      ]
    },
