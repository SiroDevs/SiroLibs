              "items": [
                {
                  "text": "Deut 24.10–13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "If you take someone's cloak as a pledge that he will pay you, you must give it back to him before the sun sets, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
              "EXO.22.26"
            ]
          }
        },
        {
