              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.29",
            "verseOrgIds": [
              "EXO.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "The next day Moses said to the people, “You have committed a terrible sin. But now I will again go up the mountain to the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.30",
            "verseOrgIds": [
              "EXO.32.30"
            ]
          }
        },
        {
          "text": "; perhaps I can obtain forgiveness for your sin.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.30",
            "verseOrgIds": [
              "EXO.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moses then returned to the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.31",
            "verseOrgIds": [
              "EXO.32.31"
            ]
          }
        },
        {
          "text": " and said, “These people have committed a terrible sin. They have made a god out of gold and worshipped it. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.31",
            "verseOrgIds": [
              "EXO.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.28"
              },
              "items": [
                {
                  "text": "Ps 69.28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.5"
              },
              "items": [
                {
                  "text": "Rev 3.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Please forgive their sin; but if you won't, then remove my name from the book in which you have written the names of your people.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.32",
            "verseOrgIds": [
              "EXO.32.32"
            ]
          }
        }
      ]
    },
