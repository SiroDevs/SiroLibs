            "number": "32",
            "style": "v",
            "sid": "EXO 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.32",
            "verseOrgIds": [
              "EXO.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.33",
            "verseOrgIds": [
              "EXO.32.33"
            ]
          }
        },
        {
          "text": " answered, “It is those who have sinned against me whose names I will remove from my book. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.33",
            "verseOrgIds": [
              "EXO.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now go, lead the people to the place I told you about. Remember that my angel will guide you, but the time is coming when I will punish these people for their sin.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.34",
            "verseOrgIds": [
              "EXO.32.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
