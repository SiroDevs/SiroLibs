        },
        {
          "text": "“If you happen to see your enemy's cow or donkey running loose, take it back to him. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "If his donkey has fallen under its load, help him get the donkey to its feet again; don't just walk off.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
      ]
