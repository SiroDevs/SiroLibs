              "items": [
                {
                  "text": "Num 28.26–31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Celebrate the Harvest Festival when you begin to harvest your crops.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Celebrate the Festival of Shelters in the autumn, when you gather the fruit from your vineyards and orchards. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Every year at these three festivals all your men must come to worship me, the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        },
        {
          "text": " your God.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Do not offer bread made with yeast when you sacrifice an animal to me. The fat of animals sacrificed to me during these festivals is not to be left until the following morning.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
            "verseOrgIds": [
              "EXO.23.18"
            ]
          }
        }
      ]
    },
    {
