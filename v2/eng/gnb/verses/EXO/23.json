        },
        {
          "text": "“Do not deny justice to a poor person when he appears in court. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.6",
            "verseOrgIds": [
              "EXO.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not make false accusations, and do not put an innocent person to death, for I will condemn anyone who does such an evil thing. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.7",
            "verseOrgIds": [
              "EXO.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not accept a bribe, for a bribe makes people blind to what is right and ruins the cause of those who are innocent.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.8",
            "verseOrgIds": [
              "EXO.23.8"
            ]
          }
        }
      ]
    },
