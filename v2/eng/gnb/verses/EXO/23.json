                  "text": "Num 28.17–25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "In the month of Abib, the month in which you left Egypt, celebrate the Festival of Unleavened Bread in the way that I commanded you. Do not eat any bread made with yeast during the seven days of this festival. Never come to worship me without bringing an offering.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.15",
            "verseOrgIds": [
              "EXO.23.15"
            ]
          }
        }
      ]
    },
