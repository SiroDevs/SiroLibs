                "loc": "LEV.19.15"
              },
              "items": [
                {
                  "text": "Lev 19.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Do not show partiality to a poor person at his trial.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
          }
        }
