                  "text": "Lk 11.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Some Pharisees came to Jesus and started to argue with him. They wanted to trap him, so they asked him to perform a miracle to show that God approved of him. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.11",
            "verseOrgIds": [
              "MRK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.39"
              },
              "items": [
                {
                  "text": "Mt 12.39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.29"
              },
              "items": [
                {
                  "text": "Lk 11.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "But Jesus gave a deep groan and said, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.12",
            "verseOrgIds": [
              "MRK.8.12"
            ]
          }
        }
      ]
