          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "His disciples asked him, “Where in this desert can anyone find enough food to feed all these people?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.4",
            "verseOrgIds": [
              "MRK.8.4"
            ]
          }
        }
      ]
    },
