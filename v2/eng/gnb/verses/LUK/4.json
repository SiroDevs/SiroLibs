              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "But Jesus answered, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.12",
            "verseOrgIds": [
              "LUK.4.12"
            ]
          }
        }
