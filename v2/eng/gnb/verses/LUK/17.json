        },
        {
          "text": "As Jesus made his way to Jerusalem, he went along the border between Samaria and Galilee. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.11",
            "verseOrgIds": [
              "LUK.17.11"
