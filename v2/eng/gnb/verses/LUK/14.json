                  "text": "Mt 12.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Then he said to them, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.5",
            "verseOrgIds": [
              "LUK.14.5"
            ]
          }
        }
