              "type": "text"
            }
          ]
        },
        {
          "text": "Return to the ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.2"
            ]
          }
        },
        {
          "text": ", and let this prayer be your offering to him: “Forgive all our sins and accept our prayer, and we will praise you as we have promised. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.2"
            ]
