              "type": "text"
            }
          ]
        },
        {
          "text": "Then the voice that I had heard speaking from heaven spoke to me again, saying, “Go and take the open scroll which is in the hand of the angel standing on the sea and on the land.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.8",
            "verseOrgIds": [
              "REV.10.8"
            ]
          }
        }
      ]
    },
