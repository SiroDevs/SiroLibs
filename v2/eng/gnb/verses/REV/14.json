              "items": [
                {
                  "text": "Rev 18.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A second angel followed the first one, saying, “She has fallen! Great Babylon has fallen! She made all peoples drink her wine — the strong wine of her immoral lust!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.8",
            "verseOrgIds": [
              "REV.14.8"
            ]
          }
        }
