              "type": "text"
            }
          ]
        },
        {
          "text": "Again I looked, and I heard angels, thousands and millions of them! They stood round the throne, the four living creatures, and the elders, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.11",
            "verseOrgIds": [
              "REV.5.11"
            ]
          }
        },
