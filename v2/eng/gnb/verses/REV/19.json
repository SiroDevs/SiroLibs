        },
        {
          "text": "Then I saw an angel standing on the sun. He shouted in a loud voice to all the birds flying in mid air: “Come and gather together for God's great feast! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.17",
            "verseOrgIds": [
              "REV.19.17"
            ]
          }
        },
