            }
          ]
        },
        {
          "text": "Then the angel said to me, “Write this: happy are those who have been invited to the wedding feast of the Lamb.” And the angel added, “These are the true words of God.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.9",
            "verseOrgIds": [
              "REV.19.9"
            ]
