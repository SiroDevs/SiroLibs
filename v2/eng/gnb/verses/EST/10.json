          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "King Xerxes imposed forced labour on the people of the coastal regions of his empire as well as on those of the interior. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "All the great and wonderful things he did, as well as the whole story of how he promoted Mordecai to high office, are recorded in the official records of the kings of Persia and Media. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mordecai the Jew was second in rank only to King Xerxes himself. He was honoured and well liked by his fellow-Jews. He worked for the good of his people and for the security of all their descendants.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
