                "loc": "MAT.12.40"
              },
              "items": [
                {
                  "text": "Mt 12.40",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "At the ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
            "verseOrgIds": [
              "JON.1.17"
            ]
          }
        },
        {
          "text": "'s command a large fish swallowed Jonah, and he was inside the fish for three days and nights.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
            "verseOrgIds": [
              "JON.1.17"
            ]
          }
        }
