            "number": "30",
            "style": "v",
            "sid": "JDG 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.30",
            "verseOrgIds": [
              "JDG.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "The next leader was Shamgar son of Anath. He too rescued Israel, and did so by killing 600 Philistines with an ox goad.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.31",
            "verseOrgIds": [
              "JDG.3.31"
            ]
          }
        }
