          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilate went back into the palace and called Jesus. “Are you the King of the Jews?” he asked him.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.33",
            "verseOrgIds": [
              "JHN.18.33"
            ]
          }
        }
