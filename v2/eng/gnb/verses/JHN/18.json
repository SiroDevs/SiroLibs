              },
              "items": [
                {
                  "text": "12.32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(This happened in order to make the words of Jesus come true, the words he used when he indicated the kind of death he would die.)",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.32",
            "verseOrgIds": [
              "JHN.18.32"
            ]
          }
        }
      ]
