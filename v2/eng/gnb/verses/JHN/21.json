              "type": "text"
            }
          ]
        },
        {
          "text": "Peter turned round and saw behind him that other disciple, whom Jesus loved — the one who had leaned close to Jesus at the meal and had asked, “Lord, who is going to betray you?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.20",
