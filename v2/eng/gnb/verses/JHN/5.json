        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.18",
            "verseOrgIds": [
              "JHN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
