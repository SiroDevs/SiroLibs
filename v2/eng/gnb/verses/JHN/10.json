          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "when the people gathered round him and asked, “How long are you going to keep us in suspense? Tell us the plain truth: are you the Messiah?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.24",
