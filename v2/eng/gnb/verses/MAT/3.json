              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.18"
              },
              "items": [
                {
                  "text": "Mt 12.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.5"
              },
              "items": [
                {
                  "text": "17.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.11"
              },
              "items": [
                {
                  "text": "Mk 1.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.35"
              },
              "items": [
                {
                  "text": "Lk 9.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Then a voice said from heaven, “This is my own dear Son, with whom I am pleased.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
            "verseOrgIds": [
              "MAT.3.17"
            ]
          }
        }
      ]
    }
