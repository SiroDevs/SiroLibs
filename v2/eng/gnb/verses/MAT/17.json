          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "When they returned to the crowd, a man came to Jesus, knelt before him, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.14",
            "verseOrgIds": [
              "MAT.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "and said, “Sir, have mercy on my son! He is an epileptic and has such terrible fits that he often falls in the fire or into water. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.15",
            "verseOrgIds": [
              "MAT.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "I brought him to your disciples, but they could not heal him.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.16",
            "verseOrgIds": [
              "MAT.17.16"
            ]
          }
        }
      ]
    },
