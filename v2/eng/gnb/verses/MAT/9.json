          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "The news about this spread all over that part of the country.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.26",
            "verseOrgIds": [
              "MAT.9.26"
            ]
          }
        }
