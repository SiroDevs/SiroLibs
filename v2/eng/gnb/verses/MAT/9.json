          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesus turned round and saw her, and said, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.22",
            "verseOrgIds": [
              "MAT.9.22"
            ]
          }
        },
