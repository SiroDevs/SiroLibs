          "items": [
            {
              "text": "9.1",
              "type": "text"
            },
            {
              "text": "his own town",
              "type": "text"
            },
            {
              "text": ": Capernaum (see 4.13).",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.1",
