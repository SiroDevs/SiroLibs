          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "When Jesus came down from the hill, large crowds followed him. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.1",
            "verseOrgIds": [
              "MAT.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then a man suffering from a dreaded skin disease came to him, knelt down before him, and said, “Sir, if you want to, you can make me clean.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.2",
            "verseOrgIds": [
              "MAT.8.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8.2",
              "type": "text"
            },
            {
              "text": "make me clean",
              "type": "text"
            },
            {
              "text": ": This disease was considered to make a person ritually unclean.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
