          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "A teacher of the Law came to him. “Teacher,” he said, “I am ready to go with you wherever you go.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.19",
            "verseOrgIds": [
              "MAT.8.19"
            ]
