              "items": [
                {
                  "text": "Is 53.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "He did this to make what the prophet Isaiah had said come true, “He himself took our sickness and carried away our diseases.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.17",
            "verseOrgIds": [
              "MAT.8.17"
            ]
          }
        }
      ]
