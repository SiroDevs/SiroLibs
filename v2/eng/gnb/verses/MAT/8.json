            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Another man, who was a disciple, said, “Sir, first let me go back and bury my father.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.21",
            "verseOrgIds": [
