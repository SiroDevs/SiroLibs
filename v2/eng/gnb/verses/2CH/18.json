          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Attack!” Micaiah answered. “Of course you'll win. The ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.14",
            "verseOrgIds": [
              "2CH.18.14"
            ]
          }
        },
        {
