          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meanwhile, the official who had gone to fetch Micaiah said to him, “All the other prophets have prophesied success for the king, and you had better do the same.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.12",
            "verseOrgIds": [
              "2CH.18.12"
            ]
          }
        }
