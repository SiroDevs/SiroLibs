          "type": "text",
          "attrs": {
            "verseId": "2CH.18.11",
            "verseOrgIds": [
              "2CH.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
