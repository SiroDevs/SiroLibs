          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "But Micaiah answered, “By the living ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.13",
            "verseOrgIds": [
              "2CH.18.13"
            ]
          }
