          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "When he appeared before King Ahab, the king asked him, “Micaiah, should King Jehoshaphat and I go and attack Ramoth, or not?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.14",
            "verseOrgIds": [
              "2CH.18.14"
            ]
          }
        }
      ]
