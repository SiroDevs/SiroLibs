            }
          ]
        },
        {
          "text": "Micaiah answered, “I can see the army of Israel scattered over the hills like sheep without a shepherd. And the ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.16",
            "verseOrgIds": [
              "2CH.18.16"
            ]
          }
        },
        {
          "text": " said, ‘These men have no leader; let them go home in peace.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.16",
            "verseOrgIds": [
              "2CH.18.16"
            ]
          }
        }
