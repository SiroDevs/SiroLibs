    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "The slave answered, “I wish that what has happened to him would happen to all your enemies, sir, and to all who rebel against you.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        }
