          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the Ethiopian",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18.31",
              "type": "text"
            },
            {
              "text": "Ethiopian",
              "type": "text"
            },
            {
              "text": ": See Word List.",
              "type": "text"
            }
          ]
        },
        {
          "text": " slave arrived and said to the king, “I have good news for Your Majesty! Today the ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        },
        {
          "text": " has given you victory over all who rebelled against you!”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        }
