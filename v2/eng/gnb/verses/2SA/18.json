          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Is the young man Absalom safe?” the king asked.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimaaz answered, “Sir, when your officer Joab sent me, I saw a great commotion, but I couldn't tell what it was.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        }
      ]
    },
