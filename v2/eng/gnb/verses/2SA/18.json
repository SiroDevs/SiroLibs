          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
