              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.19",
            "verseOrgIds": [
              "2SA.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Absalom turned to Ahithophel and said, “Now that we are here, what do you advise us to do?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.20",
            "verseOrgIds": [
              "2SA.16.20"
            ]
          }
        }
      ]
