            {
              "text": "You drove out",
              "type": "text"
            },
            {
              "text": "; Hebrew",
              "type": "text"
            },
            {
              "text": "for your land.",
              "type": "text"
            }
          ]
        },
        {
          "text": " other nations and their gods as your people advanced, the people whom you set free from Egypt to be your own. ",
          "type": "text",
