                {
                  "text": "Ps 112.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "As the scripture says:",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.9",
            "verseOrgIds": [
              "2CO.9.9"
            ]
          }
        }
      ]
    }
