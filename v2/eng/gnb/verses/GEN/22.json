              "type": "text"
            }
          ]
        },
        {
          "text": "Some time later God tested Abraham; he called to him, “Abraham!” And Abraham answered, “Yes, here I am!”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.1",
            "verseOrgIds": [
              "GEN.22.1"
            ]
          }
        }
      ]
    },
