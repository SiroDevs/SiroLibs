              "type": "text"
            }
          ]
        },
        {
          "text": "After this, Abram had a vision and heard the ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.1",
            "verseOrgIds": [
              "GEN.15.1"
            ]
          }
        },
        {
          "text": " say to him, “Do not be afraid, Abram. I will shield you from danger and give you a great reward.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.1",
            "verseOrgIds": [
              "GEN.15.1"
            ]
          }
        }
      ]
    },
    {
