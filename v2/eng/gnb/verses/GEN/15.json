        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.8",
            "verseOrgIds": [
              "GEN.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "He answered, “Bring me a cow, a goat, and a ram, each of them three years old, and a dove and a pigeon.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.9",
            "verseOrgIds": [
              "GEN.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abram brought the animals to God, cut them in half, and placed the halves opposite each other in two rows; but he did not cut up the birds. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.10",
            "verseOrgIds": [
              "GEN.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vultures came down on the bodies, but Abram drove them off.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.11",
            "verseOrgIds": [
              "GEN.15.11"
            ]
          }
        }
      ]
    },
