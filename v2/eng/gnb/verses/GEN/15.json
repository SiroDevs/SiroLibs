        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.16",
            "verseOrgIds": [
              "GEN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "When the sun had set and it was dark, a smoking fire-pot and a flaming torch suddenly appeared and passed between the pieces of the animals. ",
          "type": "text",
          "attrs": {
