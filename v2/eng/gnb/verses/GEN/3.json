              "text": "3.5",
              "type": "text"
            },
            {
              "text": "God",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "the gods.",
              "type": "text"
            }
          ]
        },
        {
          "text": " and know what is good and what is bad.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.5",
            "verseOrgIds": [
              "GEN.3.5"
            ]
          }
        },
