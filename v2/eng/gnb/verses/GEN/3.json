          },
          "items": [
            {
              "text": "3.22",
              "type": "text"
            },
            {
              "text": "knowledge of what is good and what is bad",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "knowledge of everything.",
              "type": "text"
            }
          ]
        },
        {
          "text": " He must not be allowed to take fruit from the tree that gives life, eat it, and live for ever.” ",
          "type": "text",
