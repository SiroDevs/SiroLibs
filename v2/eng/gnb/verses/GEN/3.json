              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then at the east side of the garden he put living creatures",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.24",
            "verseOrgIds": [
              "GEN.3.24"
            ]
