            "number": "3",
            "style": "v",
            "sid": "GEN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“except the tree in the middle of it. God told us not to eat the fruit of that tree or even touch it; if we do, we will die.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.3",
            "verseOrgIds": [
              "GEN.3.3"
            ]
          }
        }
      ]
