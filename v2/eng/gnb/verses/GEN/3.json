              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "So the ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
          "text": " God sent him out of the Garden of Eden and made him cultivate the soil from which he had been formed. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
