        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
