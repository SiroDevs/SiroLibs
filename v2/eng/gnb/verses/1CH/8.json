              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.6+1CH.8.7",
            "verseOrgIds": [
              "1CH.8.6",
              "1CH.8.7"
            ]
          }
        },
        {
          "name": "verse",
