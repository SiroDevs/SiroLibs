        },
        {
          "text": "Benjamin had five sons. In order of age they were Bela, Ashbel, Aharah, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.1",
            "verseOrgIds": [
              "1CH.8.1"
