              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "The descendants of Jether were Jephunneh, Pispa, and Ara, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.38",
            "verseOrgIds": [
              "1CH.7.38"
            ]
