          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.28",
            "verseOrgIds": [
              "1CH.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "The descendants of Manasseh controlled the cities of Beth Shan, Taanach, Megiddo, and Dor, and the towns round them.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.29",
            "verseOrgIds": [
              "1CH.7.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "All these are the places where the descendants of Joseph son of Jacob lived.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.29",
            "verseOrgIds": [
              "1CH.7.29"
            ]
          }
        }
      ]
    },
