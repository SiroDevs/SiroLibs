              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "The descendants of Zophah were Suah, Harnepher, Shual, Beri, Imrah, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.36",
            "verseOrgIds": [
