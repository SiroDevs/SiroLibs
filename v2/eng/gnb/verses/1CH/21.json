          ]
        },
        {
          "text": "but David was not able to go there to worship God, because he was afraid of the sword of the ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.30",
            "verseOrgIds": [
              "1CH.21.30"
            ]
          }
        },
