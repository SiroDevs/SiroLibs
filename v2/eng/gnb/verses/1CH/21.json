          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "He built an altar to the ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        },
        {
          "text": " there and offered burnt offerings and fellowship offerings. He prayed, and the ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        },
        {
          "text": " answered him by sending fire from heaven to burn the sacrifices on the altar.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        }
      ]
