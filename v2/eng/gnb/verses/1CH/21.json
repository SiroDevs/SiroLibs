            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
          "text": "'s presence which Moses had made in the wilderness, and the altar on which sacrifices were burnt were still at the place of worship at Gibeon at this time; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
