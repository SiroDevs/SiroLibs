          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "And he paid Araunah 600 gold coins for the threshing place. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.25",
            "verseOrgIds": [
              "1CH.21.25"
            ]
          }
        },
