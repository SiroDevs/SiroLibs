              "items": [
                {
                  "text": "Mt 24.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.14"
              },
              "items": [
                {
                  "text": "Mk 13.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“From the time the daily sacrifices are stopped, that is, from the time of The Awful Horror,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.11",
            "verseOrgIds": [
              "DAN.12.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12.11",
              "type": "text"
            },
            {
              "text": "The Awful Horror",
              "type": "text"
            },
            {
              "text": ": See 9.27.",
              "type": "text"
            }
          ]
        },
        {
          "text": " 1,290 days will pass. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.11",
            "verseOrgIds": [
              "DAN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Happy are those who remain faithful until 1,335 days are over!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.12",
            "verseOrgIds": [
              "DAN.12.12"
            ]
          }
        }
      ]
    },
