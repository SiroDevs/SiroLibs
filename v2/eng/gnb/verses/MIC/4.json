          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.12",
            "verseOrgIds": [
              "MIC.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.13",
            "verseOrgIds": [
              "MIC.4.13"
            ]
          }
        },
        {
          "text": " says, “People of Jerusalem, go and punish your enemies! I will make you as strong as a bull with iron horns and bronze hoofs. You will crush many nations, and the wealth they got by violence you will present to me, the Lord of the whole world.”",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.13",
            "verseOrgIds": [
              "MIC.4.13"
            ]
          }
        }
      ]
