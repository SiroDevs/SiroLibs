          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Each nation worships and obeys its own god, but we will worship and obey the ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        },
        {
          "text": " our God for ever and ever.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
