          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.11",
            "verseOrgIds": [
              "MIC.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.12",
            "verseOrgIds": [
              "MIC.3.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.18"
              },
              "items": [
                {
                  "text": "Jer 26.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "And so, because of you, Zion will be ploughed like a field, Jerusalem will become a pile of ruins, and the Temple hill will become a forest.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.12",
            "verseOrgIds": [
              "MIC.3.12"
            ]
          }
        }
      ]
    }
  ],
