            "style": "v",
            "sid": "DEU 32:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
              "DEU.32.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 32:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "When Moses had finished giving God's teachings to the people, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.45",
            "verseOrgIds": [
              "DEU.32.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 32:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "he said, “Make sure you obey all these commands that I have given you today. Repeat them to your children, so that they may faithfully obey all God's teachings. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.46",
            "verseOrgIds": [
              "DEU.32.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DEU 32:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "These teachings are not empty words; they are your very life. Obey them and you will live long in that land across the Jordan that you are about to occupy.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.47",
            "verseOrgIds": [
              "DEU.32.47"
            ]
          }
        }
      ]
    },
