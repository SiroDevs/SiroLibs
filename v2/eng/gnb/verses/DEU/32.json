          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moses and Joshua son of Nun recited this song, so that the people of Israel could hear it.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
              "DEU.32.44"
            ]
          }
        }
      ]
    },
