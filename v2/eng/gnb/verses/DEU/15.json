              "DEU.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 15:12"
          },
          "items": [
            {
              "text": "12",
