        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.7",
            "verseOrgIds": [
              "DEU.15.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
