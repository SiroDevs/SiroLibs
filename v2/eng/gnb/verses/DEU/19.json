            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.17"
              },
              "items": [
                {
                  "text": "Deut 27.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Do not move your neighbour's boundary mark, established long ago in the land that the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        },
        {
          "text": " your God is giving you.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
    },
