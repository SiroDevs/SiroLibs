            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Israel, remember this! The ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.4",
            "verseOrgIds": [
              "DEU.6.4"
            ]
          }
        },
        {
          "text": " — and the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.4",
            "verseOrgIds": [
              "DEU.6.4"
            ]
          }
        },
        {
          "text": " alone — is our God.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.4",
            "verseOrgIds": [
              "DEU.6.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6.4",
              "type": "text"
            },
            {
              "text": "The LORD",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "is our God",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "The LORD, our God, is the only God",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "The LORD our God is one.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.4",
            "verseOrgIds": [
              "DEU.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
