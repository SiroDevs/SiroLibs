              "items": [
                {
                  "text": "1 Pet 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Today the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.18",
            "verseOrgIds": [
              "DEU.26.18"
            ]
          }
        },
        {
          "text": " has accepted you as his own people, as he promised you; and he commands you to obey all his laws. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.18",
            "verseOrgIds": [
              "DEU.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "He will make you greater than any other nation that he has created, and you will bring praise and honour to his name.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.19",
            "verseOrgIds": [
              "DEU.26.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26.19",
              "type": "text"
            },
            {
              "text": "bring praise",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "name",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "receive praise and honour.",
              "type": "text"
            }
          ]
        },
        {
          "text": " You will be his own people, as he promised.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.19",
            "verseOrgIds": [
              "DEU.26.19"
            ]
          }
        }
