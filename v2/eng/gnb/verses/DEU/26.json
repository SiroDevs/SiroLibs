          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Today the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.16",
            "verseOrgIds": [
              "DEU.26.16"
            ]
          }
        },
        {
          "text": " your God commands you to obey all his laws; so obey them faithfully with all your heart. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.16",
            "verseOrgIds": [
              "DEU.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Today you have acknowledged the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.17",
            "verseOrgIds": [
              "DEU.26.17"
            ]
          }
        },
        {
          "text": " as your God; you have promised to obey him, to keep all his laws, and to do all that he commands. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.17",
            "verseOrgIds": [
              "DEU.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
