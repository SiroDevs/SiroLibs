            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18.15",
              "type": "text"
            },
            {
              "text": "a prophet",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "him",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "prophets",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "them.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
