              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“The priestly tribe of Levi is not to receive any share of land in Israel; instead, they are to live on the offerings and other sacrifices given to the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.1",
            "verseOrgIds": [
              "DEU.18.1"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.1",
            "verseOrgIds": [
              "DEU.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.20"
              },
              "items": [
                {
                  "text": "Num 18.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "They are to own no land, as the other tribes do; their share is the privilege of being the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.2",
            "verseOrgIds": [
              "DEU.18.2"
            ]
          }
        },
        {
          "text": "'s priests, as the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.2",
            "verseOrgIds": [
              "DEU.18.2"
            ]
          }
        },
        {
          "text": " has promised.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.2",
            "verseOrgIds": [
              "DEU.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
