            "sid": "DEU 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Any Levite who wants to may come from any town in Israel to the one place of worship ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.6",
            "verseOrgIds": [
              "DEU.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "and may serve there as a priest of the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.7",
            "verseOrgIds": [
              "DEU.18.7"
            ]
          }
        },
        {
          "text": " his God, like the other Levites who are serving there. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.7",
            "verseOrgIds": [
              "DEU.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "He is to receive the same amount of food as the other priests, and he may keep whatever his family sends him.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.8",
            "verseOrgIds": [
              "DEU.18.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18.8",
              "type": "text"
            },
            {
              "text": "Probable text",
              "type": "text"
            },
            {
              "text": "and he may keep",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "sends him",
              "type": "text"
            },
            {
              "text": "; Hebrew unclear.",
              "type": "text"
            }
          ]
        }
      ]
    },
