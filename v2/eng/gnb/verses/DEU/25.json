                "loc": "MAT.22.24"
              },
              "items": [
                {
                  "text": "Mt 22.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.19"
              },
              "items": [
                {
                  "text": "Mk 12.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.28"
              },
              "items": [
                {
                  "text": "Lk 20.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“If two brothers live on the same property and one of them dies, leaving no son, then his widow is not to be married to someone outside the family; it is the duty of the dead man's brother to marry her. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.5",
            "verseOrgIds": [
              "DEU.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "The first son that they have will be considered the son of the dead man, so that his family line will continue in Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.6",
            "verseOrgIds": [
              "DEU.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.7+RUT.4.8"
              },
              "items": [
                {
                  "text": "Ruth 4.7–8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "But if the dead man's brother does not want to marry her, she is to go before the town leaders and say, ‘My husband's brother will not do his duty; he refuses to give his brother a descendant among the people of Israel.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.7",
            "verseOrgIds": [
              "DEU.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the town leaders are to summon him and speak to him. If he still refuses to marry her, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.8",
            "verseOrgIds": [
              "DEU.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "his brother's widow is to go up to him in the presence of the town leaders, take off one of his sandals, spit in his face, and say, ‘This is what happens to the man who refuses to give his brother a descendant.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.9",
            "verseOrgIds": [
              "DEU.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "His family will be known in Israel as ‘the family of the man who had his sandal pulled off.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.10",
            "verseOrgIds": [
              "DEU.25.10"
            ]
          }
        }
      ]
    },
