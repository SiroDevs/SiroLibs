                  "text": "Lev 19.35–36",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Do not cheat when you use weights and measures. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.13+DEU.25.14",
            "verseOrgIds": [
              "DEU.25.13",
              "DEU.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Use true and honest weights and measures, so that you may live a long time in the land that the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.15",
            "verseOrgIds": [
              "DEU.25.15"
            ]
          }
        },
        {
          "text": " your God is giving you. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.15",
            "verseOrgIds": [
              "DEU.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.16",
            "verseOrgIds": [
              "DEU.25.16"
            ]
          }
        },
        {
          "text": " hates people who cheat.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.16",
            "verseOrgIds": [
              "DEU.25.16"
            ]
          }
        }
      ]
    },
