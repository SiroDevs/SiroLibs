              "items": [
                {
                  "text": "1 Tim 5.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Do not muzzle an ox when you are using it to thresh corn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.4",
            "verseOrgIds": [
              "DEU.25.4"
            ]
          }
        }
