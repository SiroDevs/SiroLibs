              "items": [
                {
                  "text": "Gen 21.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "At that time the son who was born in the usual way persecuted the one who was born because of God's Spirit; and it is the same now. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.29",
            "verseOrgIds": [
              "GAL.4.29"
            ]
