          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be silent, everyone, in the presence of the ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.13",
            "verseOrgIds": [
              "ZEC.2.13"
            ]
          }
        },
        {
          "text": ", for he is coming from his holy dwelling place.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.13",
            "verseOrgIds": [
              "ZEC.2.13"
            ]
          }
        }
      ]
