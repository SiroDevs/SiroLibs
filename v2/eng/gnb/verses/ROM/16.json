          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16.23",
              "type": "text"
            },
            {
              "text": "Some manuscripts add verse 24:",
              "type": "text"
            },
            {
              "text": "The grace of our Lord Jesus Christ be with you all. Amen",
              "type": "text"
            },
            {
              "text": "; others add this after verse 27.",
              "type": "text"
            }
          ]
        }
