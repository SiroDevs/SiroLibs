                }
              ]
            }
          ]
        },
        {
          "text": "My host Gaius, in whose house the church meets, sends you his greetings; Erastus, the city treasurer, and our brother Quartus send you their greetings.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.23",
            "verseOrgIds": [
              "ROM.16.23"
            ]
          }
        },
        {
