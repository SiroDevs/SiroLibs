          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remember that the Lord will give you as a reward what he has kept for his people. For Christ is the real Master you serve. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.24",
            "verseOrgIds": [
              "COL.3.24"
            ]
          }
        },
