                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.12"
              },
              "items": [
                {
                  "text": "Acts 12.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.13"
              },
              "items": [
                {
                  "text": "13.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.37+ACT.15.38+ACT.15.39"
              },
              "items": [
                {
                  "text": "15.37–39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aristarchus, who is in prison with me, sends you greetings, and so does Mark, the cousin of Barnabas. (You have already received instructions to welcome Mark if he comes your way.) ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.10",
            "verseOrgIds": [
              "COL.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua, also called Justus, sends greetings too. These three are the only Jewish believers who work with me for the Kingdom of God, and they have been a great help to me.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        }
      ]
    },
    {
