        },
        {
          "text": "The real mother, her heart full of love for her son, said to the king, “Please, Your Majesty, don't kill the child! Give it to her!”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.26",
            "verseOrgIds": [
              "1KI.3.26"
            ]
