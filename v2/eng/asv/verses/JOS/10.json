              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "And Joshua passed from Libnah, and all Israel with him, unto Lachish, and encamped against it, and fought against it: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.31",
            "verseOrgIds": [
              "JOS.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "and Jehovah delivered Lachish into the hand of Israel; and he took it on the second day, and smote it with the edge of the sword, and all the souls that were therein, according to all that he had done to Libnah.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.32",
            "verseOrgIds": [
              "JOS.10.32"
            ]
          }
        }
      ]
