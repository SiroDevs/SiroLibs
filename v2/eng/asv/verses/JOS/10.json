          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "and they took it on that day, and smote it with the edge of the sword; and all the souls that were therein he utterly destroyed that day, according to all that he had done to Lachish.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.35",
            "verseOrgIds": [
              "JOS.10.35"
            ]
          }
        }
