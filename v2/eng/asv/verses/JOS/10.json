            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "And Joshua passed from Lachish, and all Israel with him, unto Eglon; and they encamped against it, and fought against it; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.34",
            "verseOrgIds": [
              "JOS.10.34"
            ]
          }
        },
