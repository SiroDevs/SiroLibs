            "number": "35",
            "style": "v",
            "sid": "JHN 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "By this shall all men know that ye are my disciples, if ye have love one to another.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.35",
            "verseOrgIds": [
              "JHN.13.35"
            ]
