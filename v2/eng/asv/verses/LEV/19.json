          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye shall keep my sabbaths, and reverence my sanctuary: I am Jehovah.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.30",
            "verseOrgIds": [
              "LEV.19.30"
