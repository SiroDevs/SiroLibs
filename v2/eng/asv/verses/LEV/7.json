        },
        {
          "text": "For the wave-breast and the heave-thigh have I taken of the children of Israel out of the sacrifices of their peace-offerings, and have given them unto Aaron the priest and unto his sons as ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.34",
            "verseOrgIds": [
              "LEV.7.34"
            ]
          }
        },
        {
          "text": " portion for ever from the children of Israel.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.34",
            "verseOrgIds": [
              "LEV.7.34"
            ]
          }
        }
      ]
