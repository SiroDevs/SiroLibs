{
  "id": "EZK.40",
  "number": "40",
  "bookId": "EZK",
  "reference": "Ezekiel 40",
  "verseCount": 49,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
