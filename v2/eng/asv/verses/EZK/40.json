          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Four tables were on this side, and four tables on that side, by the side of the gate; eight tables, whereupon they slew ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.41",
            "verseOrgIds": [
              "EZK.40.41"
            ]
          }
