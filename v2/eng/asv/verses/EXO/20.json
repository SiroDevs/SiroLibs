              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remember the sabbath day, to keep it holy. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.8",
            "verseOrgIds": [
              "EXO.20.8"
            ]
          }
        },
        {
          "name": "verse",
