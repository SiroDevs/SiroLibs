            "number": "9",
            "style": "v",
            "sid": "EXO 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Six days shalt thou labor, and do all thy work; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.9",
            "verseOrgIds": [
              "EXO.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
