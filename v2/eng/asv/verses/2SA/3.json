              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "So Joab and Abishai his brother slew Abner, because he had killed their brother Asahel at Gibeon in the battle.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.30",
            "verseOrgIds": [
