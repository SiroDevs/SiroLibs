          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "awafariji mioyo yenu, na kuwafanya imara katika kila neno na tendo jema.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.17",
            "verseOrgIds": [
              "2TH.2.17"
            ]
          }
        }
