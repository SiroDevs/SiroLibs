                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini imetupasa sisi kumshukuru Mungu sikuzote kwa ajili yenu, ndugu mliopendwa na Bwana, kwa kuwa Mungu amewachagua tangu mwanzo mpate wokovu, katika kutakaswa na Roho, na kuiamini kweli; ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.13",
            "verseOrgIds": [
              "2TH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.4.7"
              },
              "items": [
                {
                  "text": "1 The 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.9"
              },
              "items": [
                {
                  "text": "5:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aliyowaitia ninyi kwa injili yetu, ili kuupata utukufu wa Bwana wetu Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.14",
            "verseOrgIds": [
              "2TH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, ndugu, simameni imara, mkayashike mapokeo mliyofundishwa, ama kwa maneno, ama kwa waraka wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.15",
            "verseOrgIds": [
              "2TH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.3.11+1TH.3.12+1TH.3.13"
              },
              "items": [
                {
                  "text": "1 The 3:11-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na Bwana wetu Yesu Kristo mwenyewe, na Mungu Baba yetu, aliyetupenda akatupa faraja ya milele na tumaini jema, katika neema, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.16",
            "verseOrgIds": [
              "2TH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
