            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, ndugu, tunakusihini, kwa habari ya kuja kwake Bwana wetu Yesu Kristo, na kukusanyika kwetu mbele zake, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.1",
            "verseOrgIds": [
              "2TH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwamba msifadhaishwe upesi hata kuiacha nia yenu, wala msisitushwe, kwa roho, wala kwa neno, wala kwa waraka unaodhaniwa kuwa ni wetu, kana kwamba siku ya Bwana imekwisha kuwapo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.2",
            "verseOrgIds": [
              "2TH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
