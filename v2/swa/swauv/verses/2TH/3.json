        },
        {
          "text": "Hatimaye, ndugu, tuombeeni, neno la Bwana liendelee, na kutukuzwa vile vile kama ilivyo kwenu; ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.1",
