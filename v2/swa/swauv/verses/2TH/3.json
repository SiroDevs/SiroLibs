                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nasi tumemtumaini Bwana kwa mambo yenu, kwamba mnayafanya tulivyowaagiza, tena kwamba mtayafanya. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.4",
            "verseOrgIds": [
              "2TH.3.4"
            ]
          }
        },
        {
