                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi twawaagiza hao, na kuwaonya katika Bwana Yesu Kristo, watende kazi kwa utulivu na kula chakula chao wenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.12",
            "verseOrgIds": [
