        },
        {
          "text": "Lakini, ndugu, tunataka mwatambue wale wanaojitaabisha kwa ajili yenu, na kuwasimamia ninyi katika Bwana, na kuwaonyeni; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.12",
