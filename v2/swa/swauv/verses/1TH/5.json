                {
                  "text": "2 The 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa kuwa Mungu hakutuweka kwa hasira yake, bali tupate wokovu, kwa Bwana wetu Yesu Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.9",
            "verseOrgIds": [
              "1TH.5.9"
            ]
