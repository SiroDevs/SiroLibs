        {
          "text": "Lakini sisi tulio wa mchana, tuwe na kiasi, hali tukijivika kifuani imani na upendo, na chapeo yetu iwe tumaini la wokovu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.8",
            "verseOrgIds": [
              "1TH.5.8"
            ]
          }
        },
