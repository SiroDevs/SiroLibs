          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mkawastahi sana katika upendo, kwa ajili ya kazi zao. Iweni na amani ninyi kwa ninyi.",
          "type": "text",
          "attrs": {
