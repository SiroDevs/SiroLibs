          "text": "ambaye alikufa kwa ajili yetu, ili tuishi pamoja naye, kwamba twakesha au kwamba twalala. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.10",
            "verseOrgIds": [
