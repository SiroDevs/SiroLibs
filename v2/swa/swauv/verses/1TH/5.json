                "loc": "ROM.13.12"
              },
              "items": [
                {
                  "text": "Rum 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.9"
              },
              "items": [
                {
                  "text": "Efe 5:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa kuwa ninyi nyote mmekuwa wana wa nuru, na wana wa mchana; sisi si wa usiku, wala wa giza. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.5",
            "verseOrgIds": [
              "1TH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi tusilale usingizi kama wengine, bali tukeshe, na kuwa na kiasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.6",
            "verseOrgIds": [
              "1TH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana walalao usingizi hulala usiku, pia na walewao hulewa usiku. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.7",
            "verseOrgIds": [
              "1TH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 5:8"
