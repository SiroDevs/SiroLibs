                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.34.8"
              },
              "items": [
                {
                  "text": "Kum 34:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Siku zake arobaini zikaisha, maana hivyo hutimizwa siku za kupaka dawa. Wamisri wakamlilia siku sabini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.3",
            "verseOrgIds": [
              "GEN.50.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.4.2"
              },
              "items": [
                {
                  "text": "Est 4:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Siku za kumlilia zilipopita, Yusufu alisema na watu wa nyumba ya Farao, akinena, Kama nimeona neema machoni penu, tafadhalini mkaseme masikioni mwa Farao, mkinena, Baba yangu aliniapisha, akisema, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.4",
            "verseOrgIds": [
              "GEN.50.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.16.14"
              },
              "items": [
                {
                  "text": "2 Nya 16:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.16"
              },
              "items": [
                {
                  "text": "Isa 22:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.60"
              },
              "items": [
                {
                  "text": "Mt 27:60",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mimi ni katika kufa, unizike katika kaburi langu nililojichimbia katika nchi ya Kanaani. Basi tafadhali uniruhusu niende sasa nikamzike babangu, nami nitarudi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.5",
            "verseOrgIds": [
              "GEN.50.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao akasema, Uende, ukamzike baba yako, kama alivyokuapisha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.6",
            "verseOrgIds": [
              "GEN.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.6",
            "verseOrgIds": [
              "GEN.50.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yusufu akaenda amzike babaye, na watumwa wote wa Farao wakaenda pamoja naye, wazee wa nyumbani mwake, na wazee wote wa nchi ya Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.7",
            "verseOrgIds": [
              "GEN.50.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nyumba yote ya Yusufu, na nduguze, na nyumba ya babaye; wakawaacha watoto wao tu, na kondoo zao, na ng’ombe zao, katika nchi ya Gosheni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.8",
            "verseOrgIds": [
              "GEN.50.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wakaenda pamoja naye wapanda farasi, na magari; wakawa jeshi kubwa sana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.9",
            "verseOrgIds": [
              "GEN.50.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.2"
              },
              "items": [
                {
                  "text": "Mdo 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.13"
              },
              "items": [
                {
                  "text": "1 Sam 31:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.2.13"
              },
              "items": [
                {
                  "text": "Ayu 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakaja mpaka sakafu ya Atadi, iliyo ng’ambo ya Yordani. Wakaomboleza huko maombolezo makuu, mazito sana. Akafanya matanga ya babaye siku saba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.10",
            "verseOrgIds": [
              "GEN.50.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao waliokaa katika nchi, wale Wakanaani, walipoyaona matanga katika sakafu ya Atadi, wakasema, Matanga haya ya Wamisri ni makuu kwa hiyo mahali pale paliitwa Abel-Misri, iliyo ng’ambo ya Yordani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.11",
            "verseOrgIds": [
              "GEN.50.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 50:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanawe wakamfanyia kama alivyo waagiza; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.12",
            "verseOrgIds": [
              "GEN.50.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 50:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.23.16"
              },
              "items": [
                {
                  "text": "Mwa 23:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.16"
              },
              "items": [
                {
                  "text": "Mdo 7:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kwa kuwa wanawe wakamchukuwa mpaka nchi ya Kanaani, nao wakamzika katika pango ya shamba la Makpela, iliyo mbele ya Mamre, aliyoinunua Ibrahimu pamoja na shamba kwa Efroni Mhiti, pawe milki yake pa kuzikia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.13",
            "verseOrgIds": [
              "GEN.50.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu akarudi Misri, yeye na ndugu zake, na wote waliyokwenda pamoja naye kumzika babaye, baada ya kumzika babaye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.14",
            "verseOrgIds": [
              "GEN.50.14"
            ]
          }
        }
      ]
    },
