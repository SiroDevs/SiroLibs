                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yusufu akawaagiza watumishi wake waganga, kwamba wampake baba yake dawa asioze. Waganga wakampaka dawa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.2",
            "verseOrgIds": [
              "GEN.50.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
