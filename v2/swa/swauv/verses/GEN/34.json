              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa siku ya tatu, walipokuwa wakiumwa sana, wana wawili wa Yakobo, Simeoni na Lawi, nduguze Dina, wakatwaa kila mtu upanga wake, wakaujia mji kwa ujasiri, wakawaua waume wote. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.25",
            "verseOrgIds": [
              "GEN.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakawaua Hamori, na Shekemu mwanawe, kwa makali ya upanga, wakamtwaa Dina katika nyumba ya Shekemu, wakatoka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.26",
            "verseOrgIds": [
              "GEN.34.26"
            ]
          }
        }
      ]
