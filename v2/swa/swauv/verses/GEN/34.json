                "loc": "TIT.2.5"
              },
              "items": [
                {
                  "text": "Tit 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Dina, binti Lea, ambaye Lea alimzalia Yakobo, akatoka kuwaona binti za nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.1",
            "verseOrgIds": [
              "GEN.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.2"
              },
              "items": [
                {
                  "text": "Mwa 6:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.14.1"
              },
              "items": [
                {
                  "text": "Amu 14:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Shekemu, mwana wa Hamori, Mhivi, mkuu wa nchi, akamwona akamtwaa, akalala naye, akambikiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.2",
            "verseOrgIds": [
              "GEN.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.2"
              },
              "items": [
                {
                  "text": "Isa 40:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.2.14"
              },
              "items": [
                {
                  "text": "Hos 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moyo wake ukaambatana na Dina binti Yakobo, akampenda huyu msichana, akasema na huyu msichana kwa maneno mazuri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.3",
            "verseOrgIds": [
              "GEN.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.14.2"
              },
              "items": [
                {
                  "text": "Amu 14:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Shekemu akamwambia Hamori, babaye, akasema, Unipatie msichana huyu awe mke wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.4",
            "verseOrgIds": [
              "GEN.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yakobo akasikia ya kwamba amembikiri Dina, binti yake. Na wanawe walikuwako pamoja na wanyama wake nyikani. Yakobo akanyamaza, hata walipokuja.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.5",
            "verseOrgIds": [
              "GEN.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
