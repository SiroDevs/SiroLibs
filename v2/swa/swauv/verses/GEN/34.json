                "loc": "2SA.13.24"
              },
              "items": [
                {
                  "text": "2 Sam 13:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Yakobo wakawajibu Shekemu na Hamori babaye, kwa hila, maana amemharibu Dina, umbu lao, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.13",
            "verseOrgIds": [
              "GEN.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.5.9"
              },
              "items": [
                {
                  "text": "Yos 5:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakawaambia, Hatuwezi kufanya neno hili, tumpe umbu letu mtu asiyetahiriwa; ingekuwa aibu kwetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.14",
            "verseOrgIds": [
              "GEN.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kwa sharti hii tu tutapatana nanyi; mkiwa kama sisi, akitahiriwa kila mwanamume wenu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.15",
            "verseOrgIds": [
              "GEN.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo tutawapa ninyi binti yetu, na sisi tutatwaa binti zenu tutakaa pamoja nanyi, nasi tutakuwa watu wamoja. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.16",
            "verseOrgIds": [
              "GEN.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kama hamtusikii na kutahiriwa, basi tutamtwaa umbu letu, nasi tutakwenda zetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.17",
            "verseOrgIds": [
              "GEN.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maneno yao yakawa mema machoni pa Hamori, na machoni pa Shekemu, mwana wa Hamori. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.18",
            "verseOrgIds": [
              "GEN.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.4.9"
              },
              "items": [
                {
                  "text": "1 Nya 4:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na yule kijana hakukawia kulifanya neno lile, maana amependezewa na binti Yakobo, naye alikuwa mwenye heshima kuliko wote nyumbani mwa babaye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.19",
            "verseOrgIds": [
              "GEN.34.19"
            ]
          }
        }
      ]
    },
    {
