                  "text": "Rut 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hamori, na Shekemu mwanawe, wakaja langoni pa mji wao, wakasema na watu wa mji wao, wakinena, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.20",
            "verseOrgIds": [
              "GEN.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu hawa wana amani nasi, basi na wakae katika nchi, na kufanya biashara humo; kwa maana nchi ni kubwa, yawatosha; na tuwatwae binti zao kuwa wake zetu, na binti zetu tuwape wao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.21",
            "verseOrgIds": [
              "GEN.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kwa sharti hiyo moja tu watapatana nasi wakae wote kwetu, tuwe watu wamoja, kama tukitahiriwa kila mwanamume, kama hawa walivyotahiriwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.22",
            "verseOrgIds": [
              "GEN.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Kondoo zao, na mali zao, na wanyama wao wote hawatakuwa mali zetu? Basi na tupatane nao tu, nao watakaa kwetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.23",
            "verseOrgIds": [
              "GEN.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.23.10"
              },
              "items": [
                {
                  "text": "Mwa 23:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakawasikia Hamori na Shekemu mwanawe, wote watokao katika lango la mji wake. Wakatahiriwa kila mwanamume, wote watokao katika lango la mji wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.24",
            "verseOrgIds": [
              "GEN.34.24"
            ]
          }
        }
      ]
