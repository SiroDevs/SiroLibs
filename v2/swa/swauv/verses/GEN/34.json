                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.17"
              },
              "items": [
                {
                  "text": "Kum 23:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wanawe Yakobo waliposikia hayo, wakaja kutoka nyikani; nao wakasikitika sana, wakakasirika mno, kwa sababu amefanya upumbavu katika Israeli kwa kulala na binti Yakobo, neno lisilojuzu kutendeka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.7",
            "verseOrgIds": [
              "GEN.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamori akasema nao, akinena, Roho ya Shekemu, mwanangu, inamtamani binti yenu, tafadhalini, mpeni amwoe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.8",
            "verseOrgIds": [
              "GEN.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.32"
              },
              "items": [
                {
                  "text": "Kut 23:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mkaoane na sisi, mtupe sisi binti zenu, nanyi mkatwae binti zetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.9",
            "verseOrgIds": [
              "GEN.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.9"
              },
              "items": [
                {
                  "text": "Mwa 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.15"
              },
              "items": [
                {
                  "text": "20:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.34"
              },
              "items": [
                {
                  "text": "42:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.47.27"
              },
              "items": [
                {
                  "text": "47:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nanyi mtakaa nasi, na nchi hii itakuwa mbele yenu; kaeni, na kufanya biashara humo, mkapate mali humo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.10",
            "verseOrgIds": [
              "GEN.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shekemu akamwambia babaye yule msichana na nduguze, Na nikubalike machoni penu, na mtakavyoniambia nitatoa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.11",
            "verseOrgIds": [
              "GEN.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.16"
              },
              "items": [
                {
                  "text": "Kut 22:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.29"
              },
              "items": [
                {
                  "text": "Kum 22:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.25"
              },
              "items": [
                {
                  "text": "1 Sam 18:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mjapoongeza sana mahari na zawadi, nitatoa kadiri ya mtakavyoniambia, lakini mnipe huyu msichana, awe mke wangu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.12",
            "verseOrgIds": [
              "GEN.34.12"
            ]
          }
        }
      ]
    },
