                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na mitume wakatoa ushuhuda wa kufufuka kwake Yesu kwa nguvu nyingi, na neema nyingi ikawa juu yao wote. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.33",
