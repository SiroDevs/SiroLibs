            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mtu mmoja, Farisayo, jina lake Gamalieli, mwalimu wa torati, mwenye kuheshimiwa na watu wote, akasimama katika baraza, akaamuru mitume wawekwe nje kitambo kidogo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.34",
            "verseOrgIds": [
              "ACT.5.34"
            ]
          }
        },
        {
          "name": "verse",
