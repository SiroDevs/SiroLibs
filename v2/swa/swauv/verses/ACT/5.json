                {
                  "text": "Mdo 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mungu wa baba zetu alimfufua Yesu, ambaye ninyi mlimwua mkimtundika katika mti. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.30",
