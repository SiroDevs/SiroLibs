                "loc": "ACT.4.18"
              },
              "items": [
                {
                  "text": "Mdo 4:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akisema, Je! Hatukuwaamuru ninyi kwa nguvu, msifundishe kwa jina hili? Nanyi, tazameni, mmeijaza Yerusalemu mafundisho yenu, na mnataka kuileta damu ya mtu yule juu yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.28",
            "verseOrgIds": [
              "ACT.5.28"
            ]
          }
        },
        {
