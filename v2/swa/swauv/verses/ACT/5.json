                  "text": "Mdo 9:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "lakini ikiwa imetoka kwa Mungu hamwezi kuivunja; msije mkaonekana kuwa mnapigana na Mungu. ",
          "type": "text",
