              },
              "items": [
                {
                  "text": "Mdo 21:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu kabla ya siku hizi aliondoka Theuda, akijidai ya kuwa yeye ni mtu mkuu, watu wapata mia nne wakashikamana naye; naye aliuawa na wote waliomsadiki wakatawanyika wakawa si kitu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.36",
            "verseOrgIds": [
              "ACT.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
