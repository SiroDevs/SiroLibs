              "items": [
                {
                  "text": "Dan 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Petro na mitume wakajibu, wakisema, Imetupasa kumtii Mungu kuliko wanadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.29",
            "verseOrgIds": [
              "ACT.5.29"
            ]
          }
        },
