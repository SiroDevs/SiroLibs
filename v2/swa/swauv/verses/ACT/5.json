                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akaondoka Kuhani Mkuu na wote waliokuwa pamoja naye, (hao ndio walio wa madhehebu ya Masadukayo), wamejaa wivu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.17",
            "verseOrgIds": [
              "ACT.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakawakamata mitume wakawaweka ndani ya gereza; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.18",
            "verseOrgIds": [
              "ACT.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.7"
              },
              "items": [
                {
                  "text": "Mdo 12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "lakini malaika wa Bwana akafungua milango ya gereza usiku, akawatoa, akasema, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.19",
            "verseOrgIds": [
              "ACT.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enendeni mkasimame hekaluni mkawaambie watu maneno yote ya Uzima huu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.20",
            "verseOrgIds": [
              "ACT.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao waliposikia wakaenda alfajiri hekaluni, wakaanza kufundisha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.21",
            "verseOrgIds": [
              "ACT.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaja Kuhani Mkuu nao waliokuwa pamoja naye, wakawakutanisha watu wa baraza, na wazee wote wa wana wa Israeli, wakatuma watu gerezani ili wawalete. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.21",
            "verseOrgIds": [
              "ACT.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata watumishi walipofika hawakuwaona gerezani, wakarudi wakatoa habari, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.22",
            "verseOrgIds": [
              "ACT.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
