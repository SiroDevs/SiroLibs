                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na sisi tu mashahidi wa mambo haya, pamoja na Roho Mtakatifu ambaye Mungu amewapa wote wamtiio. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.32",
