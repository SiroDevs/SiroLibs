              "items": [
                {
                  "text": "Mdo 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwa mikono ya mitume zikafanyika ishara na maajabu mengi katika watu; nao wote walikuwako kwa nia moja katika ukumbi wa Sulemani; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.12",
            "verseOrgIds": [
              "ACT.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na katika wote wengine hapana hata mmoja aliyethubutu kuambatana nao; ila watu waliwaadhimisha; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.13",
            "verseOrgIds": [
              "ACT.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
