                "loc": "LUK.2.2"
              },
              "items": [
                {
                  "text": "Lk 2:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Baada ya mtu huyo aliondoka Yuda Mgalilaya, siku zile za kuandikiwa orodha, akawavuta watu kadha wa kadha nyuma yake, naye pia akapotea na wote waliomsadiki wakatawanyika. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.37",
            "verseOrgIds": [
              "ACT.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
