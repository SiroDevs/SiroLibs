          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.47"
              },
              "items": [
                {
                  "text": "Mdo 2:47",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.6.7"
              },
              "items": [
                {
                  "text": "6:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.20"
              },
              "items": [
                {
                  "text": "21:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "walioamini wakazidi kuongezeka kwa Bwana, wengi, wanaume na wanawake; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.14",
            "verseOrgIds": [
              "ACT.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.11"
              },
              "items": [
                {
                  "text": "Mdo 19:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.56"
              },
              "items": [
                {
                  "text": "Mk 6:56",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "hata ikawa katika njia kuu hutoa nje wagonjwa, na kuwaweka juu ya majamvi na magodoro, ili Petro akija, ngawa kivuli chake kimwangukie mmojawapo wao. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.15",
            "verseOrgIds": [
              "ACT.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo makutano ya watu wa miji iliyoko kandokando ya Yerusalemu wakakutanika, wakileta wagonjwa, nao walioudhiwa na pepo wachafu; nao wote wakaponywa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.16",
            "verseOrgIds": [
              "ACT.5.16"
            ]
          }
        }
      ]
    },
