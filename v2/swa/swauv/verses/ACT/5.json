          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "akawaambia, Enyi waume wa Israeli, jihadharini jinsi mtakavyowatenda watu hawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.35",
            "verseOrgIds": [
              "ACT.5.35"
            ]
          }
