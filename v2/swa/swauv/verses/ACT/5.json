              "items": [
                {
                  "text": "Mt 15:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi sasa nawaambia, Jiepusheni na watu hawa, waacheni; kwa kuwa shauri hili au kazi hii ikiwa imetoka kwa binadamu, itavunjwa, ",
          "type": "text",
          "attrs": {
