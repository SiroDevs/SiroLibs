        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo Asafiri hadi Rumi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
