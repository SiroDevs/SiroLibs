                  "text": "Isa 38:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isaya nabii akamlilia BWANA; akakirudisha nyuma kile kivuli madaraja kumi, ambayo kilikuwa kimeshuka katika madaraja ya Ahazi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.11",
            "verseOrgIds": [
              "2KI.20.11"
            ]
          }
        }
