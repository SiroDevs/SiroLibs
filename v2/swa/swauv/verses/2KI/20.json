        },
        {
          "text": "Wakati huo Merodak-baladani mwana wa Baladani, Mfalme wa Babeli, alipeleka barua na zawadi kwa Hezekia; kwa maana alipata habari kwamba Hezekia ameugua. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.12",
            "verseOrgIds": [
              "2KI.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
