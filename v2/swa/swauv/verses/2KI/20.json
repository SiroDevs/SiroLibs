        },
        {
          "text": "Rudi, ukamwambie Hezekia, mkuu wa watu wangu, BWANA, Mungu wa Daudi baba yako asema hivi, Nimeyasikia maombi yako, na kuyaona machozi yako; tazama, nitakuponya; siku ya tatu utapanda nyumbani kwa BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.5",
            "verseOrgIds": [
              "2KI.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 20:6"
          },
          "items": [
            {
              "text": "6",
