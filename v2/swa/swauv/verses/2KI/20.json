              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa, kabla Isaya hajatoka katika mji wa kati, neno la BWANA likamjia, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.4",
