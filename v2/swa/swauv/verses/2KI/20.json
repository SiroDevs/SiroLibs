          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaya akamwambia Hezekia, Basi, lisikie neno la BWANA, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.16",
            "verseOrgIds": [
              "2KI.20.16"
            ]
          }
        },
