              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, wapenzi wangu, kwa kuwa tuna ahadi hizo, na tujitakase nafsi zetu na uchafu wote wa mwili na roho, huku tukitimiza utakatifu katika kumcha Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.1",
            "verseOrgIds": [
              "2CO.7.1"
            ]
          }
        }
      ]
    },
