                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana hata tulipokuwa tumefika Makedonia miili yetu haikupata nafuu; bali tulidhikika kote kote; nje palikuwa na vita, ndani hofu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.5",
            "verseOrgIds": [
              "2CO.7.5"
            ]
          }
        },
        {
