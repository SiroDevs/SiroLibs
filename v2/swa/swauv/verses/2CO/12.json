              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.13",
            "verseOrgIds": [
              "2CO.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.14",
            "verseOrgIds": [
              "2CO.12.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.1"
              },
              "items": [
                {
                  "text": "2 Kor 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama, hii ni mara ya tatu ya mimi kuwa tayari kuja kwenu, wala sitawalemea. Maana sivitafuti vitu vyenu, bali nawatafuta ninyi; maana haiwapasi watoto kuweka akiba kwa wazazi, bali wazazi kwa watoto. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.14",
            "verseOrgIds": [
              "2CO.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.17"
              },
              "items": [
                {
                  "text": "Flp 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami kwa furaha nyingi nitatapanya, tena nitatapanywa kwa ajili ya roho zenu. Je! Kadiri nizidivyo kuwapenda sana, ninapungukiwa kupendwa? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.15",
            "verseOrgIds": [
              "2CO.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini na iwe hivyo, mimi sikuwalemea; bali kwa kuwa mwerevu naliwapata kwa hila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.16",
            "verseOrgIds": [
              "2CO.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Mtu ye yote niliyemtuma kwenu, kwa mtu huyo naliwatoza kitu? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.17",
            "verseOrgIds": [
              "2CO.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.6"
              },
              "items": [
                {
                  "text": "2 Kor 8:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.16+2CO.8.17+2CO.8.18"
              },
              "items": [
                {
                  "text": "16-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nalimwonya Tito, nikamtuma ndugu yule pamoja naye. Je! Tito aliwatoza kitu? Je! Hatukuenenda kwa Roho yeye yule na katika nyayo zile zile?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.18",
            "verseOrgIds": [
              "2CO.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.18",
            "verseOrgIds": [
              "2CO.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwadhani hata sasa ya kuwa najidhuru kwenu! Mbele za Mungu twanena katika Kristo. Na hayo yote, wapenzi, ni kwa ajili ya kuwajenga ninyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.19",
            "verseOrgIds": [
              "2CO.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.2"
              },
              "items": [
                {
                  "text": "2 Kor 10:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.6"
              },
