        {
          "text": "Kisha akatwaa watu kumi miongoni mwa wazee wa mji, akawaambia, Ninyi nanyi, ketini hapa. Wakaketi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.2",
            "verseOrgIds": [
