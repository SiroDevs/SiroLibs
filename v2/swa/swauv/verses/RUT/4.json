              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akamwambia yule jamaa, Huyu Naomi, aliyerudi hapa kutoka nchi ya Moabu, anauza sehemu ya ardhi aliyokuwa nayo ndugu yetu, Elimeleki; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.3",
