        },
        {
          "text": "Ndipo Boazi aliposema, Siku ile utakapolinunua shamba mkononi mwa Naomi, unamnunua Ruthu pia, huyu Mmoabi, mkewe marehemu, ili makusudi umwinulie marehemu jina katika urithi wake. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.5",
            "verseOrgIds": [
              "RUT.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
