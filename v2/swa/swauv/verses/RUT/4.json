                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye atakurejezea uhai wako, na kukuangalia katika uzee wako; kwa maana mkweo, ambaye akupenda, naye anakufaa kuliko watoto saba, ndiye aliyemzaa.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.15",
