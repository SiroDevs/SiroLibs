          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa nne nyumba ya BWANA ilitiwa msingi, katika mwezi wa Zivu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata katika mwaka wa kumi na mmoja, katika mwezi wa Buli, ndio mwezi wa nane, nyumba ikaisha, mambo yake yote, na sharti zake zote. Basi muda wa miaka saba alikuwa katika kuijenga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        }
