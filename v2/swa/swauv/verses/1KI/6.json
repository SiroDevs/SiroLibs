                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akaweka tayari chumba cha ndani katikati ya nyumba ndani, ili atie humo sanduku la agano la BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
