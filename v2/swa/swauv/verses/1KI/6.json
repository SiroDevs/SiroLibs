                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitakaa katikati ya wana wa Israeli, wala sitawaacha watu wangu Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.13",
            "verseOrgIds": [
              "1KI.6.13"
            ]
          }
        }
      ]
