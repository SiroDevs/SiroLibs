                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na roho ya Mungu ikamjilia Sauli kwa nguvu, hapo alipoyasikia maneno yale, na hasira yake ikawaka sana. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.6",
            "verseOrgIds": [
              "1SA.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
