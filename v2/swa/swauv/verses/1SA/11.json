                }
              ]
            }
          ]
        },
        {
          "text": "Ikawa, kesho yake, Sauli akawapanga watu katika vikosi vitatu; nao wakaingia katikati ya marago kwenye zamu ya asubuhi, wakawapiga Waamoni hata wakati wa jua kali; kisha ikawa wale waliosalia wakatawanyika, hata wasiachwe wawili wao pamoja. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.11",
            "verseOrgIds": [
              "1SA.11.11"
            ]
          }
        },
