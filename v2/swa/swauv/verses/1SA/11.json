                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye akawahesabu huko Bezeki; Waisraeli walikuwa mia tatu elfu, na Wayuda thelathini elfu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.8",
            "verseOrgIds": [
              "1SA.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao wakawaambia hao wajumbe waliokuja, Waambieni watu wa Yabesh-gileadi, Kesho, wakati wa jua kali, mtapata wokovu. Basi wale wajumbe wakaenda, wakawaarifu watu wa Yabeshi; nao walifurahiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.9",
            "verseOrgIds": [
              "1SA.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo watu wa Yabeshi walisema, Kesho tutawatokea, nanyi mtatufanyia yote myaonayo kuwa ni mema. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.10",
            "verseOrgIds": [
              "1SA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 11:11"
          },
          "items": [
