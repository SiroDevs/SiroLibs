        },
        {
          "text": "Iweni hodari, na kufanya kiume enyi Wafilisti, msije mkawa watumwa wa Waebrania, kama wao walivyokuwa watumwa wenu; fanyeni kiume, mkapigane nao. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.9",
            "verseOrgIds": [
              "1SA.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
