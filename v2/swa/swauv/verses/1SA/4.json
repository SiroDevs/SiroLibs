              },
              "items": [
                {
                  "text": "64",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hilo sanduku la Mungu Likatwaliwa; na Hofni na Finehasi, wale wana wawili wa Eli, wakauawa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.11",
            "verseOrgIds": [
              "1SA.4.11"
            ]
          }
        }
      ]
