                "loc": "1SA.10.23"
              },
              "items": [
                {
                  "text": "1 Sam 10:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye alikuwa na mwana, aliyeitwa jina lake Sauli, kijana, tena mzuri; wala katika wana wa Israeli hakuwako mtu mzuri kuliko yeye; tangu mabega yake kwenda juu alikuwa mrefu kuliko watu wote. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.2",
            "verseOrgIds": [
              "1SA.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na punda za Kishi, baba yake Sauli, walikuwa wamepotea. Kishi akamwambia Sauli mwanawe, Haya basi, twaa mtumishi mmoja pamoja nawe, uondoke, uende ukawatafute punda hao. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.3",
            "verseOrgIds": [
              "1SA.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
