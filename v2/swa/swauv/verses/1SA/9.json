            }
          ]
        },
        {
          "text": "Nao wakawajibu, wakasema, Yuko; tazama, yuko huko mbele yako; fanyeni haraka sasa, maana hivi leo amekuja mjini; kwa sababu watu wana dhabihu leo katika mahali pa juu; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.12",
            "verseOrgIds": [
              "1SA.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
