        {
          "text": "Basi, kulikuwa na mtu mmoja wa Benyamini, jina lake akiitwa Kishi, mwana wa Abieli, mwana wa Serori, mwana wa Bekorathi, mwana wa Afia, mwana wa Mbenyamini, mtu shujaa, mwenye nguvu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.1",
            "verseOrgIds": [
              "1SA.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
