        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.26",
            "verseOrgIds": [
              "1SA.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata walipokuwa wakishuka mwisho wa mji, Samweli akamwambia Sauli, Mwambie mtumishi atangulie, (naye akatangulia), bali wewe simama hapa sasa, ili nikuambie neno la Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.27",
