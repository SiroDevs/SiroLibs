              },
              "items": [
                {
                  "text": "2 Fal 4:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye akapita kati ya nchi ya milima milima ya Efraimu, akapita na kati ya nchi ya Shalisha, lakini hawakuwaona; kisha wakapita kati ya nchi ya Shaalimu, wala huko hawakuwako; wakapita kati ya nchi ya Wabenyamini, lakini hawakuwapata. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.4",
            "verseOrgIds": [
              "1SA.9.4"
            ]
          }
        },
        {
          "name": "verse",
