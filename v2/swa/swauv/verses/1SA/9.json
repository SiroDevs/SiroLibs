          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Sauli akamwambia mtumishi wake, Umesema vema; haya! Twende. Wakaenda mpaka mji ule aliokuwamo mtu wa Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.10",
            "verseOrgIds": [
              "1SA.9.10"
            ]
          }
        }
