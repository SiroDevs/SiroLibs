        },
        {
          "text": "(Hapo zamani katika Israeli, mtu alipokwenda kuuliza neno kwa Mungu, husema hivi, Haya! Twende kwa mwonaji; maana mtu aitwaye sasa Nabii hapo zamani aliitwa Mwonaji.) ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.9",
            "verseOrgIds": [
              "1SA.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
