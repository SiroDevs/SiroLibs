                "loc": "HEB.4.14"
              },
              "items": [
                {
                  "text": "Ebr 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana ilitupasa sisi tuwe na kuhani mkuu wa namna hii aliye mtakatifu, asiyekuwa na uovu, asiyekuwa na waa lo lote, aliyetengwa na wakosaji, aliyekuwa juu kuliko mbingu; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.26",
            "verseOrgIds": [
              "HEB.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.9.7"
              },
              "items": [
                {
                  "text": "Law 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.6"
              },
              "items": [
                {
                  "text": "16:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ambaye hana haja kila siku, mfano wa wale makuhani wakuu wengine, kwanza kutoa dhabihu kwa ajili ya dhambi zake mwenyewe, kisha kwa ajili ya dhambi za hao watu; maana yeye alifanya hivi mara moja, alipojitoa nafsi yake. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.27",
            "verseOrgIds": [
              "HEB.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.5.1"
              },
              "items": [
                {
                  "text": "Ebr 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.5.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana torati yawaweka wanadamu walio na unyonge kuwa makuhani wakuu; bali hilo neno la kiapo kilichokuja baada ya torati limemweka Mwana, aliyekamilika hata milele.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.28",
            "verseOrgIds": [
              "HEB.7.28"
            ]
