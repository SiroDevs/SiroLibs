                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na juu yake makerubi ya utukufu, yakikitia kivuli kiti cha rehema; basi hatuna nafasi sasa ya kueleza habari za vitu hivi kimoja kimoja. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
