          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana agano la urithi lina nguvu palipotukia kufa kwa mtu; kwa kuwa halina nguvu kabisa, akiwa yu hai yeye aliyelifanya. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.17",
            "verseOrgIds": [
              "HEB.9.17"
            ]
          }
