        },
        {
          "text": "katika mwaka wa kwanza wa kumiliki kwake, mimi Danieli, kwa kuvisoma vitabu, nalifahamu hesabu ya miaka, ambayo neno la BWANA lilimjia Yeremia nabii, ya kuutimiza ukiwa wa Yerusalemu, yaani, miaka sabini. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.2",
            "verseOrgIds": [
              "DAN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikamwelekezea Bwana Mungu uso wangu, ili kutaka kwa maombi, na dua, pamoja na kufunga, na kuvaa nguo za magunia na majivu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.3",
            "verseOrgIds": [
              "DAN.9.3"
            ]
          }
        }
