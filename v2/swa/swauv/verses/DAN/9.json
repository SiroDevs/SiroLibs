              "attrs": {
                "loc": "2CH.36.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wala hatukuwasikiliza watumishi wako, manabii, ambao kwa jina lako walisema na wafalme wetu, na wakuu wetu, na baba zetu, na watu wote wa nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.6",
            "verseOrgIds": [
              "DAN.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Bwana, haki ina wewe, lakini kwetu sisi kuna haya ya uso, kama hivi leo; kwa watu wa Yuda, na kwa wenyeji wa Yerusalemu, na kwa Israeli wote, walio karibu na hao walio mbali, katika nchi zote ulikowafukuza, kwa sababu ya makosa yao waliyokukosa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.7",
            "verseOrgIds": [
              "DAN.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Bwana, kwetu sisi kuna haya ya uso, kwa wafalme wetu, na wakuu wetu, na baba zetu, kwa sababu tumekutenda dhambi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.8",
            "verseOrgIds": [
              "DAN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.6"
              },
              "items": [
                {
                  "text": "Kut 34:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.18"
              },
              "items": [
                {
                  "text": "Hes 14:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.9.17"
              },
              "items": [
                {
                  "text": "Neh 9:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.13"
              },
              "items": [
                {
                  "text": "Yoe 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rehema na msamaha ni kwa Bwana Mungu wetu, ingawa tumemwasi; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.9",
            "verseOrgIds": [
              "DAN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wala hatukuitii sauti ya BWANA, Mungu wetu, kwa kwenda katika sheria zake, alizoziweka mbele yetu kwa kinywa cha watumishi wake, manabii. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.10",
            "verseOrgIds": [
              "DAN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
