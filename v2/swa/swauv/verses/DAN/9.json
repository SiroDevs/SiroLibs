        },
        {
          "text": "tumefanya dhambi, tumefanya ukaidi, tumetenda maovu, tumeasi, naam, hata kwa kuyaacha maagizo yako na hukumu zako; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.5",
