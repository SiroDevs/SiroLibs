          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi hapo nilipokuwa nikisema, na kuomba, na kuiungama dhambi yangu, na dhambi ya watu wangu Israeli, na kuomba dua yangu mbele za BWANA, Mungu wangu, kwa ajili ya mlima mtakatifu wa Mungu wangu; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.20",
            "verseOrgIds": [
              "DAN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
