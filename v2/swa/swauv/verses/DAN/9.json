            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikamwomba BWANA, Mungu wangu, nikaungama, nikasema, Ee Bwana, Mungu mkuu, mwenye kutisha, ashikaye maagano na rehema kwao wampendao, na kuzishika amri zake; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.4",
