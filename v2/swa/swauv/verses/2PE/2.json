        },
        {
          "text": "Lakini hao kama wanyama wasio na akili, ambao walizaliwa kama wanyama tu wa kukamatwa na kupotezwa, wakikufuru katika mambo wasiyoyajua, wataangamizwa katika maangamizo yao; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.12",
            "verseOrgIds": [
              "2PE.2.12"
            ]
          }
        },
