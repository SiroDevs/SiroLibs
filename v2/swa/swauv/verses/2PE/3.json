              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, kwa kuwa vitu hivi vyote vitafumuliwa hivyo, imewapasa ninyi kuwa watu wa tabia gani katika mwenendo mtakatifu na utauwa, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.11",
            "verseOrgIds": [
              "2PE.3.11"
            ]
          }
        },
