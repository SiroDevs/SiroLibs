                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mpate kuyakumbuka yale maneno yaliyonenwa zamani na manabii watakatifu, na ile amri ya Bwana na Mwokozi iliyoletwa na mitume wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.2",
            "verseOrgIds": [
