                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mkijua kwanza neno hili ya kwamba katika siku za mwisho watakuja na dhihaka zao watu wenye kudhihaki, wafuatao tamaa zao wenyewe, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.3",
            "verseOrgIds": [
