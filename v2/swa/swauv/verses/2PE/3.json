        },
        {
          "text": "Lakini, wapenzi, msilisahau neno hili, kwamba kwa Bwana siku moja ni kama miaka elfu, na miaka elfu ni kama siku moja. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.8",
            "verseOrgIds": [
              "2PE.3.8"
            ]
          }
        },
