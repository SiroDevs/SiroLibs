                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nanyi uhesabuni uvumilivu wa Bwana wetu kuwa ni wokovu, kama vile na ndugu yetu mpenzi Paulo alivyowaandikia kwa hekima aliyopewa; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.15",
            "verseOrgIds": [
              "2PE.3.15"
            ]
          }
        },
