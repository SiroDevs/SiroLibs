        {
          "text": "Maana hufumba macho yao wasione neno hili ya kuwa zilikuwako mbingu tangu zamani, na nchi pia, imefanyizwa kutoka katika maji, na ndani ya maji, kwa neno la Mungu; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.5",
            "verseOrgIds": [
              "2PE.3.5"
            ]
          }
        },
