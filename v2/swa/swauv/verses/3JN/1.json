            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpenzi naomba ufanikiwe katika mambo yote na kuwa na afya yako, kama vile roho yako ifanikiwavyo. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.2",
            "verseOrgIds": [
              "3JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "3JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana nalifurahi mno walipokuja ndugu na kuishuhudia kweli yako, kama uendavyo katika kweli. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.3",
            "verseOrgIds": [
              "3JN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "3JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sina furaha iliyo kuu kuliko hii, kusikia ya kwamba watoto wangu wanakwenda katika kweli.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.4",
            "verseOrgIds": [
              "3JN.1.4"
            ]
          }
        }
      ]
    },
