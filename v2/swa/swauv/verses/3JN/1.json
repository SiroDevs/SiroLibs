                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana, kwa ajili ya Jina hilo, walitoka, wasipokee kitu kwa Mataifa. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.7",
            "verseOrgIds": [
              "3JN.1.7"
            ]
          }
        },
        {
