                }
              ]
            }
          ]
        },
        {
          "text": "Mpenzi, usiuige ubaya, bali uige wema. Yeye atendaye mema ni wa Mungu, bali yeye atendaye mabaya hakumwona Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.11",
            "verseOrgIds": [
              "3JN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
