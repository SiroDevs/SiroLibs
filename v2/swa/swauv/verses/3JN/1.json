              "type": "tag",
              "attrs": {
                "loc": "2JN.1.10"
              },
              "items": [
                {
                  "text": "2 Yoh 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi imetupasa sisi kuwakaribisha watu kama hao, ili tuwe watenda kazi pamoja na kweli.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.8",
            "verseOrgIds": [
              "3JN.1.8"
