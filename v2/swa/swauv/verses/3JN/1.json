                  "text": "Tit 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "waliokushuhudia upendo wako mbele ya kanisa; utafanya vizuri ukiwasafirisha kama ipasavyo kwa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.6",
            "verseOrgIds": [
              "3JN.1.6"
            ]
