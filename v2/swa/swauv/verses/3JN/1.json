              "type": "tag",
              "attrs": {
                "loc": "JHN.21.24"
              },
              "items": [
                {
                  "text": "21:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Demetrio ameshuhudiwa na watu wote, tena na ile kweli yenyewe. Nasi pia twashuhudia, nawe wajua ya kwamba ushuhuda wetu ni kweli.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.12",
            "verseOrgIds": [
              "3JN.1.12"
            ]
          }
        }
