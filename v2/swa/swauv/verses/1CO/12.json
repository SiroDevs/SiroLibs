                "loc": "MRK.9.39"
              },
              "items": [
                {
                  "text": "Mk 9:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.21"
              },
              "items": [
                {
                  "text": "Mt 7:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.2"
              },
              "items": [
                {
                  "text": "1 Yoh 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa hiyo nawaarifu, ya kwamba hakuna mtu anenaye katika Roho wa Mungu, kusema, Yesu amelaaniwa; wala hawezi mtu kusema, Yesu ni Bwana, isipokuwa katika Roho Mtakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.3",
            "verseOrgIds": [
              "1CO.12.3"
            ]
          }
        }
      ]
    },
    {
