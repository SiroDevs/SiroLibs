              },
              "items": [
                {
                  "text": "Efe 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi pana tofauti za karama; bali Roho ni yeye yule. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.4",
            "verseOrgIds": [
              "1CO.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.11"
              },
              "items": [
                {
                  "text": "Efe 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena pana tofauti za huduma, na Bwana ni yeye yule. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.5",
            "verseOrgIds": [
              "1CO.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha pana tofauti za kutenda kazi, bali Mungu ni yeye yule azitendaye kazi zote katika wote. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.6",
            "verseOrgIds": [
              "1CO.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.14.26"
              },
              "items": [
                {
                  "text": "1 Kor 14:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini kila mmoja hupewa ufunuo wa Roho kwa kufaidiana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.7",
            "verseOrgIds": [
              "1CO.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana mtu mmoja kwa Roho apewa neno la hekima; na mwingine neno la maarifa, apendavyo Roho yeye yule; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.8",
            "verseOrgIds": [
              "1CO.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwingine imani katika Roho yeye yule; na mwingine karama za kuponya katika Roho yule mmoja; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.9",
            "verseOrgIds": [
              "1CO.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.14.5"
              },
              "items": [
                {
                  "text": "1 Kor 14:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.4"
              },
              "items": [
                {
                  "text": "Mdo 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na mwingine matendo ya miujiza; na mwingine unabii; na mwingine kupambanua roho; mwingine aina za lugha; na mwingine tafsiri za lugha; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.10",
            "verseOrgIds": [
              "1CO.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.3"
              },
              "items": [
                {
                  "text": "Rum 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.7"
              },
              "items": [
                {
                  "text": "Efe 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.7"
              },
              "items": [
                {
                  "text": "1 Kor 7:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "lakini kazi hizi zote huzitenda Roho huyo mmoja, yeye yule, akimgawia kila mtu peke yake kama apendavyo yeye.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.11",
            "verseOrgIds": [
              "1CO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwili Mmoja wenye Viungo Vingi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
