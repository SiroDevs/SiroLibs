              "1CO.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na vile viungo vya mwili vidhaniwavyo kuwa havina heshima, viungo vile twavipa heshima zaidi; na viungo vyetu visivyo na uzuri vina uzuri zaidi sana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.23",
            "verseOrgIds": [
              "1CO.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana viungo vyetu vilivyo na uzuri havina uhitaji; bali Mungu ameuungamanisha mwili, na kukipa heshima zaidi kile kiungo kilichopungukiwa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.24",
            "verseOrgIds": [
              "1CO.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili kusiwe na faraka katika mwili, bali viungo vitunzane kila kiungo na mwenziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.25",
            "verseOrgIds": [
              "1CO.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kiungo kimoja kikiumia, viungo vyote huumia nacho, na kiungo kimoja kikitukuzwa, viungo vyote hufurahi pamoja nacho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.26",
            "verseOrgIds": [
              "1CO.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.5"
              },
              "items": [
                {
                  "text": "Rum 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.30"
              },
              "items": [
                {
                  "text": "Efe 5:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi ninyi mmekuwa mwili wa Kristo, na viungo kila kimoja peke yake.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.27",
            "verseOrgIds": [
              "1CO.12.27"
            ]
          }
        }
