              "items": [
                {
                  "text": "1 Kor 14:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Takeni sana karama zilizo kuu. Hata hivyo nawaonyesha njia iliyo bora.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.31",
            "verseOrgIds": [
