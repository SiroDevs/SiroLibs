                {
                  "text": "2 Yoh 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini, mambo yalivyo, naliwaandikia kwamba msichangamane na mtu aitwaye ndugu, akiwa ni mzinzi au mwenye kutamani au mwenye kuabudu sanamu au mtukanaji au mlevi au mnyang’anyi; mtu wa namna hii msikubali hata kula naye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.11",
            "verseOrgIds": [
              "1CO.5.11"
            ]
          }
        },
