          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanyi mwajivuna, wala hamkusikitika, ili kwamba aondolewe miongoni mwenu huyo aliyetenda jambo hilo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.2",
            "verseOrgIds": [
              "1CO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
