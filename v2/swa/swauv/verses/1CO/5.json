          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisemi msichangamane kabisa na wazinzi wa dunia hii, au na wenye kutamani, au na wanyang’anyi, au na wenye kuabudu sanamu; maana hapo ingewalazimu kutoka katika dunia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.10",
            "verseOrgIds": [
              "1CO.5.10"
            ]
          }
        },
