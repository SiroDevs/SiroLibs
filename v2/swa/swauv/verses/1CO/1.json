              },
              "items": [
                {
                  "text": "3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi ndugu, nawasihi, kwa jina la Bwana wetu Yesu Kristo, kwamba nyote mnene mamoja; wala pasiwe kwenu faraka, bali mhitimu katika nia moja na shauri moja. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.10",
            "verseOrgIds": [
              "1CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana, ndugu zangu, nimearifiwa habari zenu na wale walio wa nyumbani mwa Kloe, ya kwamba iko fitina kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.11",
            "verseOrgIds": [
              "1CO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
