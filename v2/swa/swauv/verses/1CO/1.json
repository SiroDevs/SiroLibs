              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.1.3"
              },
              "items": [
                {
                  "text": "1 Yoh 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mungu ni mwaminifu ambaye mliitwa na yeye mwingie katika ushirika wa Mwanawe, Yesu Kristo Bwana wetu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.9",
            "verseOrgIds": [
              "1CO.1.9"
            ]
          }
        }
      ]
    },
