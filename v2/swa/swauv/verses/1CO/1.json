                "loc": "1CO.16.15"
              },
              "items": [
                {
                  "text": "1 Kor 16:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena naliwabatiza watu wa nyumbani mwa Stefana; zaidi ya hao, sijui kama nalimbatiza mtu ye yote mwingine. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.16",
            "verseOrgIds": [
              "1CO.1.16"
            ]
          }
        },
