              "items": [
                {
                  "text": "Tit 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "hata hamkupungukiwa na karama yo yote, mkikutazamia sana kufunuliwa kwake Bwana wetu Yesu Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.7",
            "verseOrgIds": [
              "1CO.1.7"
            ]
          }
        },
