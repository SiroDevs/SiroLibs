              "items": [
                {
                  "text": "5:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ambaye atawathibitisha hata mwisho, ili msilaumiwe siku ile ya Bwana wetu Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.8",
            "verseOrgIds": [
              "1CO.1.8"
            ]
          }
        },
