          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa mfano wa sheria watakayokufunza, na kwa mfano wa hukumu watakayokuambia, fanya vivyo; usigeuke katika hukumu watakayokuonyesha, kwenda mkono wa kuume wala wa kushoto. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.11",
            "verseOrgIds": [
