              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawe fanya sawasawa na hukumu watakayokuonyesha mahali hapo atakapochagua BWANA; nawe tunza kufanya kwa mfano wa yote watakayokufunza; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.10",
            "verseOrgIds": [
