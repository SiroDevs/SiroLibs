              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wake wenu na watoto wenu, na wanyama wenu wa mji, (nawajua kwamba mna wanyama wengi), na wakae katika miji yenu niliyowapa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.19",
            "verseOrgIds": [
              "DEU.3.19"
            ]
          }
