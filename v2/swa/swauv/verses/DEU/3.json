          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwea katika kilele cha Pisga ukainue macho yako upande wa magharibi, na kaskazini, na kusini, na mashariki, ukatazame kwa macho yako, kwa maana huuvuki mto huu wa Yordani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.27",
            "verseOrgIds": [
              "DEU.3.27"
            ]
          }
        },
