            "number": "26",
            "style": "v",
            "sid": "DEU 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini BWANA alikuwa amenikasirikia kwa ajili yenu, asinisikize; BWANA akaniambia, Na ikutoshe, usinene nami zaidi jambo hili. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
              "DEU.3.26"
            ]
          }
        },
        {
