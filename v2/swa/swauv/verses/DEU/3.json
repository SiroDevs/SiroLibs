                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nakuomba nivuke, nikaione hiyo nchi nzuri iliyoko ng’ambo ya Jordani, mlima ule mzuri, na Lebanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        },
        {
