            "number": "1",
            "style": "v",
            "sid": "DEU 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo tukageuka, tukakwea njia ya Bashani; na Ogu, mfalme wa Bashani, akatutokea juu yetu, yeye na watu wake wote, kuja kupigana huko Edrei. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.1",
            "verseOrgIds": [
              "DEU.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.24"
              },
              "items": [
                {
                  "text": "Hes 21:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA akaniambia, Usimwogope; kwa kuwa nimemtia mkononi mwako, yeye na watu wake wote na nchi yake; nawe utamtenda mfano wa ulivyomtenda Sihoni, mfalme wa Waamori, aliyekuwa akikaa Heshboni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.2",
            "verseOrgIds": [
              "DEU.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi BWANA, Mungu wetu, akamtia mikononi mwetu na Ogu mfalme wa Bashani, na watu wake wote; tukampiga, asisaziwe cho chote. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.3",
            "verseOrgIds": [
              "DEU.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.8"
              },
              "items": [
                {
                  "text": "Kum 29:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.13"
              },
              "items": [
                {
                  "text": "1 Fal 4:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tukatwaa miji yake yote wakati huo; hapakuwa na mji tusiotwaa kwao miji sitini, nchi yote ya Argobu, ndio ufalme wa Ogu ulio katika Bashani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.4",
            "verseOrgIds": [
              "DEU.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miji hiyo yote ilikuwa yenye maboma marefu, na malango, na makomeo, pamoja na miji isiyokuwa na maboma, mingi sana. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.5",
            "verseOrgIds": [
              "DEU.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
