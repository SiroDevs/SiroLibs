              "items": [
                {
                  "text": "1 Fal 8:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi nikageuka nikashuka kutoka mlimani, nikazitia mbao ndani ya sanduku nililofanya; nazo zimo humo kama alivyoniamuru BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.5",
            "verseOrgIds": [
              "DEU.10.5"
            ]
          }
        },
