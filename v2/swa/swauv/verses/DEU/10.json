                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nikakaa mle mlimani kama hapo kwanza, siku arobaini usiku na mchana; BWANA akanisikiza wakati huo nao; asitake BWANA kukuangamiza. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.10",
            "verseOrgIds": [
              "DEU.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA akaniambia, Ondoka, ushike safari yako mbele ya watu; nao wataingia waimiliki nchi, niliyowaapia baba zao ya kuwa nitawapa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.11",
            "verseOrgIds": [
              "DEU.10.11"
            ]
          }
        }
      ]
