                "loc": "DEU.21.5"
              },
              "items": [
                {
                  "text": "Kum 21:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wakati huo BWANA aliitenga kabila ya Lawi ili walichukue lile sanduku la agano la BWANA, wasimame mbele ya BWANA kwa kumtumikia, na kuwabarikia watu kwa jina lake, hata hivi leo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
