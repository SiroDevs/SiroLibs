                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na sasa, Israeli, BWANA, Mungu wako, anataka nini kwako, ila umche BWANA, Mungu wako, na kwenda katika njia zake zote, na kumpenda, na kumtumikia BWANA, Mungu wako, kwa moyo wako wote, na kwa roho yako yote; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.12",
            "verseOrgIds": [
              "DEU.10.12"
            ]
          }
        },
        {
          "name": "verse",
