                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo asiwe na fungu Lawi, wala urithi pamoja na nduguze; BWANA ndiye urithi wake, kwa mfano wa vile alivyomwambia BWANA, Mungu wako.) ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
