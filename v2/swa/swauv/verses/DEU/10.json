                }
              ]
            }
          ]
        },
        {
          "text": "Huwafanyia yatima na mjane hukumu ya haki, naye humpenda mgeni, akimpa chakula na mavazi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.18",
