              },
              "items": [
                {
                  "text": "38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(Wana wa Israeli wakasafiri kutoka visima vya Bene-Yaakani kwenda Mosera; Haruni akafa huko, akazikwa huko; na Eleazari mwanawe alitumika utumishi wa ukuhani badala yake. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.6",
            "verseOrgIds": [
              "DEU.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakasafiri kutoka huko kwenda Gudgoda; wakatoka Gudgoda wakaenda Yotbatha, nayo ni nchi ya vijito vya maji. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.7",
            "verseOrgIds": [
              "DEU.10.7"
            ]
          }
        },
        {
