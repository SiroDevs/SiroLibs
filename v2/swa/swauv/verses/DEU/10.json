                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tazama, mbingu ni mali za BWANA, Mungu wako, na mbingu za mbingu, na nchi, na vitu vyote vilivyomo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.14",
