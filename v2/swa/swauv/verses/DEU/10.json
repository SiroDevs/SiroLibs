              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, mpendeni mgeni, kwa sababu ninyi wenyewe mlikuwa wageni katika nchi ya Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.19",
