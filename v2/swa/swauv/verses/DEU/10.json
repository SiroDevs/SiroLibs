                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye akaandika juu ya mbao mfano wa maandiko ya kwanza, zile amri kumi, alizowaambia BWANA huko mlimani toka kati ya moto siku ya mkutano; BWANA akanipa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.4",
            "verseOrgIds": [
              "DEU.10.4"
            ]
          }
        },
        {
          "name": "verse",
