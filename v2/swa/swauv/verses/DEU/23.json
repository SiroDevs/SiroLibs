        {
          "text": "Akiwa kwenu mtu awaye yote asiyekuwa ni tohara kwa ajili ya yaliyomtukia usiku, na atoke nje ya kituo, wala asiingie ndani ya kituo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.10",
            "verseOrgIds": [
              "DEU.23.10"
            ]
          }
        },
