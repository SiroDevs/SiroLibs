          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakini na iwe ikaribiapo jioni, yeye ataoga maji; na jua likiisha kuchwa ataingia ndani ya kituo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.11",
            "verseOrgIds": [
              "DEU.23.11"
            ]
          }
        },
