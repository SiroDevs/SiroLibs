        {
          "text": "Angalia, nimekuwekea leo mbele yako uzima na mema, na mauti na mabaya; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.15",
            "verseOrgIds": [
              "DEU.30.15"
            ]
          }
        },
        {
