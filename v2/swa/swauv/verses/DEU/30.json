                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nawe utakapomrudia BWANA, Mungu wako, na kuitii sauti yake, mfano wa yote nikuagizayo leo, wewe na wanao, kwa moyo wako wote, na kwa roho yako yote; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
