                }
              ]
            }
          ]
        },
        {
          "text": "Watu wako waliotawanyika wakiwako katika ncha za mbingu za mwisho, kutoka huko atakukusanya BWANA, Mungu wako; kutoka huko atakutwaa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.4",
            "verseOrgIds": [
              "DEU.30.4"
            ]
          }
        },
        {
