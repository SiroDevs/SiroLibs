                  "text": "Yn 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Si mbinguni, hata useme, Ni nani atakayetupandia mbinguni akatuletee, aje atuambie tusikie, tupate kuyafanya? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.12",
            "verseOrgIds": [
              "DEU.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wala si ng’ambo ya pili ya bahari, hata useme, Ni nani atakayetuvukia bahari, akatuletee, aje atuambie, tusikie, tupate kuyafanya? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.13",
            "verseOrgIds": [
              "DEU.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini neno li karibu nawe sana, li katika kinywa chako na moyo wako, upate kulifanya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.14",
            "verseOrgIds": [
              "DEU.30.14"
            ]
          }
        },
