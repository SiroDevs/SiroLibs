              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini moyo wako ukikengeuka, usipotaka kusikiza, lakini ukavutwa kando kwenda kuabudu miungu mingine, na kuitumikia; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.17",
            "verseOrgIds": [
              "DEU.30.17"
            ]
          }
        },
