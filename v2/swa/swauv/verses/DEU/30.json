          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukiwa utaifuata sauti ya BWANA, Mungu wako, kwa kuyashika maagizo yake, na amri zake zilizoandikwa katika chuo hiki cha torati; ukimwelekea BWANA, Mungu wako, kwa moyo wako wote, na kwa roho yako yote.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
