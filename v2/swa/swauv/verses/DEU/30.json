            }
          ]
        },
        {
          "text": "BWANA, Mungu wako, atautahiri moyo wako, na moyo wa uzao wako, ili umpende BWANA, Mungu wako, kwa moyo wako wote, na kwa roho yako yote, upate kuwa hai. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.6",
            "verseOrgIds": [
              "DEU.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na laana hizi zote BWANA, Mungu wako, atawatia adui zako na hao wakuchukiao, waliokuwa wakikutesa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.7",
            "verseOrgIds": [
              "DEU.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe utarudi, uitii sauti ya BWANA, na kuyafanya maagizo yake yote nikuagizayo leo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.8",
            "verseOrgIds": [
              "DEU.30.8"
            ]
          }
        },
