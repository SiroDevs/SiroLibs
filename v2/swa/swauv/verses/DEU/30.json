        },
        {
          "text": "Tena itakuwa, mambo haya yote yatakapokujilia, baraka na laana nilizoweka mbele yako, nawe utakapozikumbuka kati ya mataifa yote, huko atakakokupeleka BWANA, Mungu wako, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.1",
            "verseOrgIds": [
              "DEU.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
