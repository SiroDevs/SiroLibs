              "type": "text"
            }
          ]
        },
        {
          "text": "Umkopeshapo jirani yako cho chote kikopeshwacho usiingie katika nyumba yake kwenda kutwaa rehani kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.10",
            "verseOrgIds": [
