            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu atwaapo mke mpya, asiende vitani pamoja na jeshi, wala asipewe shughuli juu yake yo yote; akae faragha mwaka mmoja nyumbani mwake, apate mfurahisha mkewe aliyemtwaa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.47.2"
              },
              "items": [
                {
                  "text": "Isa 47:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mtu awaye yote asitwae jiwe la kusagia, la juu wala la chini, kuwa rehani; kwani hivi ni kutwaa maisha ya mtu kuwa rehani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
          }
        }
