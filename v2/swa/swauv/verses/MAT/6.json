                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waangalieni ndege wa angani, ya kwamba hawapandi, wala hawavuni, wala hawakusanyi ghalani; na Baba yenu wa mbinguni huwalisha hao. Ninyi je! Si bora kupita hao? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.26",
            "verseOrgIds": [
              "MAT.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni yupi kwenu ambaye akijisumbua aweza kujiongeza kimo chake hata mkono mmoja? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.27",
            "verseOrgIds": [
              "MAT.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mavazi, ya nini kuyasumbukia? Fikirini maua ya mashamba, jinsi yameavyo; hayafanyi kazi, wala hayasokoti ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.28",
            "verseOrgIds": [
              "MAT.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 6:29"
          },
          "items": [
