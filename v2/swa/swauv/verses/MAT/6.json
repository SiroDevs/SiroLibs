              "items": [
                {
                  "text": "Mt 6:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi msifanane na hao; maana Baba yenu anajua mnayohitaji kabla ninyi hamjamwomba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.8",
            "verseOrgIds": [
              "MAT.6.8"
            ]
          }
        },
