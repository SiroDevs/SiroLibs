            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angalieni msifanye wema wenu machoni pa watu, kusudi mtazamwe na wao; kwa maana mkifanya kama hayo, hampati thawabu kwa Baba yenu aliye mbinguni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.1",
            "verseOrgIds": [
              "MAT.6.1"
            ]
          }
        }
      ]
    },
    {
