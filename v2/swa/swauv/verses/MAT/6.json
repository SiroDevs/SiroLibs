                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena msalipo, msiwe kama wanafiki; kwa maana wao wapenda kusali hali wamesimama katika masinagogi na katika pembe za njia, ili waonekane na watu. Amin, nawaambia, Wamekwisha kupata thawabu yao. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.5",
            "verseOrgIds": [
              "MAT.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.33"
              },
              "items": [
                {
                  "text": "2 Fal 4:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bali wewe usalipo, ingia katika chumba chako cha ndani, na ukiisha kufunga mlango wako, usali mbele za Baba yako aliye sirini; na Baba yako aonaye sirini atakujazi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.6",
            "verseOrgIds": [
              "MAT.6.6"
            ]
          }
        }
      ]
