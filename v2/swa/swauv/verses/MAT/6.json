            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanyi mkiwa katika kusali, msipayuke-payuke, kama watu wa mataifa; maana wao hudhani ya kuwa watasikiwa kwa sababu ya maneno yao kuwa mengi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.7",
            "verseOrgIds": [
              "MAT.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 6:8"
          },
          "items": [
            {
              "text": "8",
