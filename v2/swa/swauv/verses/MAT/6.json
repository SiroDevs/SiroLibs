        },
        {
          "text": "Tena mfungapo, msiwe kama wanafiki wenye uso wa kukunjamana; maana hujiumbua nyuso zao, ili waonekane na watu kuwa wanafunga. Amin, nawaambia, wamekwisha kupata thawabu yao. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.16",
            "verseOrgIds": [
              "MAT.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
