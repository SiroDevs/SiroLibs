          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili usionekane na watu kuwa unafunga, ila na Baba yako aliye sirini; na Baba yako aonaye sirini atakujazi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.18",
            "verseOrgIds": [
              "MAT.6.18"
            ]
