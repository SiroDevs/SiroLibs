              "items": [
                {
                  "text": "Mt 27:53",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha Ibilisi akamchukua mpaka mji mtakatifu, akamweka juu ya kinara cha hekalu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.5",
            "verseOrgIds": [
              "MAT.4.5"
            ]
          }
        },
