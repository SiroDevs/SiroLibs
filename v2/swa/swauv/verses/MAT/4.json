          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.28"
              },
              "items": [
                {
                  "text": "Kut 34:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.8"
              },
              "items": [
                {
                  "text": "1 Fal 19:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akafunga siku arobaini mchana na usiku, mwisho akaona njaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.2",
            "verseOrgIds": [
              "MAT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 4:3"
          },
          "items": [
