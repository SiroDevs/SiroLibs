        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.8.3"
              },
              "items": [
                {
                  "text": "Kum 8:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye akajibu akasema, Imeandikwa, Mtu hataishi kwa mkate tu, ila kwa kila neno litokalo katika kinywa cha Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.4",
            "verseOrgIds": [
              "MAT.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
