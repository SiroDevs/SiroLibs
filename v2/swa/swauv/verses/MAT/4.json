        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1+GEN.3.2+GEN.3.3+GEN.3.4+GEN.3.5+GEN.3.6+GEN.3.7"
              },
              "items": [
                {
                  "text": "Mwa 3:1-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mjaribu akamjia akamwambia, Ukiwa ndiwe Mwana wa Mungu, amuru kwamba mawe haya yawe mikate. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.3",
            "verseOrgIds": [
              "MAT.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
