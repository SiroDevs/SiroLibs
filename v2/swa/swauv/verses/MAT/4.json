              "items": [
                {
                  "text": "Zab 91:11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akamwambia, Ukiwa ndiwe Mwana wa Mungu jitupe chini; kwa maana imeandikwa,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.6",
            "verseOrgIds": [
              "MAT.4.6"
