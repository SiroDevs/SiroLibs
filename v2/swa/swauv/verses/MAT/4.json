        },
        {
          "text": "Kisha Yesu alipandishwa na Roho nyikani, ili ajaribiwe na Ibilisi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.1",
            "verseOrgIds": [
              "MAT.4.1"
            ]
          }
        },
        {
