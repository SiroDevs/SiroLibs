                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "Kum 19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "La, kama hasikii, chukua pamoja nawe tena mtu mmoja au wawili, ili kwa vinywa vya mashahidi wawili au watatu kila neno lithibitike. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.16",
            "verseOrgIds": [
              "MAT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.13"
              },
              "items": [
                {
                  "text": "1 Kor 5:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na asipowasikiliza wao, liambie kanisa; na asipolisikiliza kanisa pia, na awe kwako kama mtu wa mataifa na mtoza ushuru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.17",
            "verseOrgIds": [
              "MAT.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
