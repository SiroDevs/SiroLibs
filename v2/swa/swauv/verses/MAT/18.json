                "loc": "LUK.17.3+LUK.17.4"
              },
              "items": [
                {
                  "text": "Lk 17:3-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Petro akamwendea akamwambia, Bwana, ndugu yangu anikose mara ngapi nami nimsamehe? Hata mara saba? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.21",
            "verseOrgIds": [
              "MAT.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamwambia, Sikuambii hata mara saba, bali hata saba mara sabini.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.22",
            "verseOrgIds": [
              "MAT.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mfano wa Mtumishi Asiyesamehe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.22",
            "verseOrgIds": [
              "MAT.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu hii ufalme wa mbinguni umefanana na mfalme mmoja aliyetaka kufanya hesabu na watumwa wake. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.23",
            "verseOrgIds": [
              "MAT.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipoanza kuifanya, aliletewa mtu mmoja awiwaye talanta",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.24",
            "verseOrgIds": [
              "MAT.18.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:24",
              "type": "text"
            },
            {
              "text": "Talanta moja ni kama shilingi 5,000.",
              "type": "text"
            }
          ]
        },
        {
          "text": " elfu kumi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.24",
            "verseOrgIds": [
              "MAT.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye alipokosa cha kulipa, bwana wake akaamuru auzwe, yeye na mkewe na watoto wake, na vitu vyote alivyo navyo, ikalipwe ile deni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.25",
            "verseOrgIds": [
              "MAT.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi yule mtumwa akaanguka, akamsujudia akisema, Bwana, nivumilie, nami nitakulipa yote pia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.26",
            "verseOrgIds": [
              "MAT.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana wa mtumwa yule akamhurumia, akamfungua, akamsamehe ile deni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.27",
            "verseOrgIds": [
              "MAT.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtumwa yule akatoka, akamwona mmoja wa wajoli wake, aliyemwia dinari",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.28",
            "verseOrgIds": [
              "MAT.18.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:28",
              "type": "text"
            },
            {
              "text": "Dinari moja ni kama senti 75.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mia; akamkamata, akamshika koo, akisema, Nilipe uwiwacho. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.28",
            "verseOrgIds": [
              "MAT.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi mjoli wake akaanguka miguuni pake, akamsihi, akisema, Nivumilie, nami nitakulipa yote pia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.29",
            "verseOrgIds": [
              "MAT.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini hakutaka, akaenda, akamtupa kifungoni, hata atakapoilipa ile deni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.30",
            "verseOrgIds": [
              "MAT.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wajoli wake walipoyaona yaliyotendeka, walisikitika sana, wakaenda wakamweleza bwana wao yote yaliyotendeka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.31",
            "verseOrgIds": [
              "MAT.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo bwana wake akamwita, akamwambia, Ewe mtumwa mwovu, nalikusamehe wewe deni ile yote, uliponisihi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.32",
            "verseOrgIds": [
              "MAT.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawe, je! Haikukupasa kumrehemu mjoli wako, kama mimi nilivyokurehemu wewe? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.33",
            "verseOrgIds": [
              "MAT.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.26"
              },
              "items": [
                {
                  "text": "Mt 5:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bwana wake akaghadhibika, akampeleka kwa watesaji, hata atakapoilipa deni ile yote. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.34",
            "verseOrgIds": [
              "MAT.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.14"
              },
              "items": [
                {
                  "text": "Mt 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndivyo na Baba yangu wa mbinguni atakavyowatenda ninyi, msiposamehe kwa mioyo yenu kila mtu ndugu yake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.35",
            "verseOrgIds": [
              "MAT.18.35"
            ]
          }
        }
      ]
    }
