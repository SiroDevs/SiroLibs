                  "text": "Gal 6:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na ndugu yako akikukosa, enenda ukamwonye, wewe na yeye peke yenu; akikusikia, umempata nduguyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.15",
            "verseOrgIds": [
              "MAT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
