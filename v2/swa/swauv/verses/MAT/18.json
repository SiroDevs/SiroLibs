                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akasema, Amin, nawaambia, Msipoongoka na kuwa kama vitoto, hamtaingia kamwe katika ufalme wa mbinguni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
