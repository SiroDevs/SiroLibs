        },
        {
          "text": "Hata Yesu alipofika nyumbani kwa Petro, akamwona mkwe wa Petro, mamaye mkewe, amelala kitandani hawezi homa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.14",
            "verseOrgIds": [
              "MAT.8.14"
            ]
          }
        },
