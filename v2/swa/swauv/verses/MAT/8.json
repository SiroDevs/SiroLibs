                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye Yesu akamwambia yule akida, Nenda zako; na iwe kwako kama ulivyoamini. Mtumishi wake akapona saa ile ile.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.13",
            "verseOrgIds": [
