                  "text": "1 Fal 19:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwingine katika wanafunzi wake akamwambia, Bwana, nipe ruhusa kwanza, niende nikamzike baba yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.21",
