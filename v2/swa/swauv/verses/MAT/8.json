            "number": "2",
            "style": "v",
            "sid": "MAT 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tazama, akaja mtu mwenye ukoma akamsujudia, akisema, Bwana, ukitaka, waweza kunitakasa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.2",
            "verseOrgIds": [
              "MAT.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akanyosha mkono, akamgusa, akisema Nataka; takasika. Na mara ukoma wake ukatakasika. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.3",
            "verseOrgIds": [
              "MAT.8.3"
            ]
          }
        },
        {
