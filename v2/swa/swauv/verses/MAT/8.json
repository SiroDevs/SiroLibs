                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bali wana wa ufalme watatupwa katika giza la nje, ndiko kutakuwako kilio na kusaga meno. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.12",
