            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.18+LUK.9.19+LUK.9.20+LUK.9.21"
              },
              "items": [
                {
                  "text": "Lk 9:18-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Yesu akaenda pande za Kaisaria-Filipi, akawauliza wanafunzi wake akasema, Watu hunena Mwana wa Adamu kuwa ni nani? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.13",
            "verseOrgIds": [
              "MAT.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.1+MAT.14.2"
              },
              "items": [
                {
                  "text": "Mt 14:1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.10"
              },
              "items": [
                {
                  "text": "17:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.14+MRK.6.15"
              },
              "items": [
                {
                  "text": "Mk 6:14-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.7+LUK.9.8"
              },
              "items": [
                {
                  "text": "Lk 9:7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakasema, Wengine hunena u Yohana Mbatizaji, wengine Eliya, wengine Yeremia au mmojawapo wa manabii. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.14",
            "verseOrgIds": [
              "MAT.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaambia, Nanyi mwaninena mimi kuwa ni nani? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.15",
            "verseOrgIds": [
              "MAT.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.68+JHN.6.69"
              },
              "items": [
                {
                  "text": "Yn 6:68-69",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Simoni Petro akajibu akasema, Wewe ndiwe Kristo, Mwana wa Mungu aliye hai. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.16",
            "verseOrgIds": [
              "MAT.16.16"
            ]
          }
        },
