              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akamchukua, akaanza kumkemea, akisema, Hasha, Bwana, hayo hayatakupata. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.22",
