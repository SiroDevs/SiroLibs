                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakamjia Mafarisayo na Masadukayo, wakamjaribu, wakamwomba awaonyeshe ishara itokayo mbinguni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.1",
            "verseOrgIds": [
              "MAT.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.54+LUK.12.55+LUK.12.56"
              },
              "items": [
                {
                  "text": "Lk 12:54-56",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akajibu, akawaambia, [Kukiwa jioni, mwasema, Kutakuwa na kianga; kwa maana mbingu ni nyekundu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.2",
            "verseOrgIds": [
              "MAT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.4"
              },
              "items": [
                {
                  "text": "Mt 11:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na asubuhi, mwasema, Leo kutakuwa na dhoruba; kwa maana mbingu ni nyekundu, tena kumetanda. Enyi wanafiki, mwajua kuutambua uso wa mbingu; lakini, je! Ishara za zamani hizi hamwezi kuzitambua?] ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.3",
            "verseOrgIds": [
              "MAT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.39"
              },
              "items": [
                {
                  "text": "Mt 12:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.29"
              },
              "items": [
                {
                  "text": "Lk 11:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JON.2.1"
              },
              "items": [
                {
                  "text": "Yon 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kizazi kibaya na cha zinaa chataka ishara; wala hakitapewa ishara, isipokuwa ishara ya Yona. Akawaacha, akaenda zake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.4",
            "verseOrgIds": [
              "MAT.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chachu ya Mafarisayo na Masadukayo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.4",
            "verseOrgIds": [
              "MAT.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao wanafunzi wakaenda hata ng’ambo, wakasahau kuchukua mikate. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.5",
            "verseOrgIds": [
              "MAT.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.1"
              },
              "items": [
                {
                  "text": "Lk 12:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu akawaambia, Angalieni, jilindeni na chachu ya Mafarisayo na Masadukayo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.6",
            "verseOrgIds": [
              "MAT.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabishana wao kwa wao, wakisema, Ni kwa sababu hatukuchukua mikate. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.7",
            "verseOrgIds": [
              "MAT.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.30"
              },
              "items": [
                {
                  "text": "Mt 6:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye Yesu akafahamu, akawaambia, Mbona mnabishana ninyi kwa ninyi, enyi wa imani chache, kwa sababu hamna mikate? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.8",
            "verseOrgIds": [
              "MAT.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.17+MAT.14.18+MAT.14.19+MAT.14.20+MAT.14.21"
              },
              "items": [
                {
                  "text": "Mt 14:17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hamjafahamu bado, wala hamkumbuki ile mikate mitano kwa wale elfu tano, na vikapu vingapi mlivyoviokota? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.9",
            "verseOrgIds": [
              "MAT.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.34+MAT.15.35+MAT.15.36+MAT.15.37+MAT.15.38"
              },
              "items": [
                {
                  "text": "Mt 15:34-38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wala ile mikate saba kwa watu elfu nne, na makanda mangapi mliyoyaokota? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.10",
            "verseOrgIds": [
              "MAT.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imekuwaje hamkufahamu ya kuwa si kwa sababu ya mkate naliwaambia? Ila jilindeni na chachu ya Mafarisayo na Masadukayo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.11",
            "verseOrgIds": [
              "MAT.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.27"
              },
              "items": [
                {
                  "text": "Yn 6:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo walipofahamu ya kuwa hakuwaambia kujilinda na chachu ya mkate, bali na mafundisho ya Mafarisayo na Masadukayo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.12",
            "verseOrgIds": [
              "MAT.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petro Amkiri Yesu kuwa Kristo",
          "type": "text"
        }
      ]
    },
    {
