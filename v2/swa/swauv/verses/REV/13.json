                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na watu wote wakaao juu ya nchi watamsujudu, kila ambaye jina lake halikuandikwa katika kitabu cha uzima cha Mwana-Kondoo, aliyechinjwa tangu kuwekwa misingi ya dunia. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.8",
            "verseOrgIds": [
              "REV.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu akiwa na sikio na asikie. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.9",
            "verseOrgIds": [
              "REV.13.9"
            ]
          }
        },
        {
