            }
          ]
        },
        {
          "text": "Mtu akichukua mateka, atachukuliwa mateka. Mtu akiua kwa upanga, atauawa kwa upanga. Hapa ndipo penye subira na imani ya watakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.10",
