          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye atumia uwezo wote wa mnyama yule wa kwanza mbele yake. Naye aifanya dunia na wote wakaao ndani yake wamsujudie mnyama wa kwanza, ambaye jeraha lake la mauti lilipona. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.12",
            "verseOrgIds": [
              "REV.13.12"
            ]
          }
        },
