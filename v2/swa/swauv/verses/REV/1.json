              "type": "text"
            }
          ]
        },
        {
          "text": "Nalikuwa katika Roho, siku ya Bwana; nikasikia sauti kuu nyuma yangu, kama sauti ya baragumu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.10",
