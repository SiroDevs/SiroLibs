              "items": [
                {
                  "text": "Kum 10:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na nafsi zile zote zilizotoka viunoni mwa Yakobo zilikuwa ni nafsi sabini; na huyo Yusufu alikuwa huko ndani ya Misri tangu hapo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.5",
            "verseOrgIds": [
              "EXO.1.5"
            ]
          }
        },
