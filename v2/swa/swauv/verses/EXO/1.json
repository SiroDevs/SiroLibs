        },
        {
          "text": "Basi majina ya wana wa Israeli walioingia Misri ni haya; kila mtu pamoja na jamaa zake walikuja pamoja na Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.1",
