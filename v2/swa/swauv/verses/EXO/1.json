              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kwa kadiri ya walivyowatesa ndivyo walivyoongezeka na kuzidi kuenea. Nao walichukiwa kwa sababu ya wana wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.12",
            "verseOrgIds": [
