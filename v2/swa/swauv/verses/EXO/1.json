          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reubeni, na Simeoni na Lawi, na Yuda; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.2",
            "verseOrgIds": [
              "EXO.1.2"
            ]
          }
