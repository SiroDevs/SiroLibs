                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yusufu akafa, na ndugu zake wote, na watu wote wa kizazi kile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.6",
            "verseOrgIds": [
              "EXO.1.6"
