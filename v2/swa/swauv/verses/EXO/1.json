              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Dani, na Naftali, na Gadi, na Asheri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.4",
            "verseOrgIds": [
              "EXO.1.4"
            ]
          }
        },
