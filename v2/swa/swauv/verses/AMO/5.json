                "loc": "2CH.15.2"
              },
              "items": [
                {
                  "text": "2 Nya 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.3"
              },
              "items": [
                {
                  "text": "Isa 55:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana BWANA awaambia hivi nyumba ya Israeli, Nitafuteni mimi, nanyi mtaishi; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.4",
            "verseOrgIds": [
              "AMO.5.4"
            ]
          }
        },
        {
