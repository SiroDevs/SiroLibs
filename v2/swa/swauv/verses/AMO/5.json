                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.30"
              },
              "items": [
                {
                  "text": "Kut 32:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yachukieni mabaya; yapendeni mema; mkaithibitishe haki langoni; yamkini kwamba BWANA, Mungu wa majeshi, atawafanyia fadhili mabaki ya Yusufu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.15",
            "verseOrgIds": [
              "AMO.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "AMO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.17"
              },
              "items": [
                {
                  "text": "Yer 9:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa ajili ya hayo, asema BWANA, Mungu wa majeshi, aliye Bwana; Kutakuwako maombolezo katika njia kuu zote; nao watasema katika njia zote, Ole! Ole! Nao watamwita mkulima aje kuombolea, na hao walio hodari wa kulia waje kuomboleza. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.16",
            "verseOrgIds": [
              "AMO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "AMO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.12"
              },
              "items": [
                {
                  "text": "Kut 12:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena katika mashamba yote ya mizabibu kutakuwako kulia; kwa maana mimi nitapita katikati yako, asema BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.17",
            "verseOrgIds": [
              "AMO.5.17"
            ]
          }
        }
      ]
    },
