          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa Bwana MUNGU asema hivi; Mji uliotoka nje wenye watu elfu, utasaziwa watu mia, na mji uliotoka wenye watu mia, utasaziwa watu kumi, kwa nyumba ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 5:4"
          },
          "items": [
            {
