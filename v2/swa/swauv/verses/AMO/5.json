              "type": "text"
            }
          ]
        },
        {
          "text": "Lisikieni neno hili nilitamkalo liwe maombolezo juu yenu, enyi nyumba ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.1",
