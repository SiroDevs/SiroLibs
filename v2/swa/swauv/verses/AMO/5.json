                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tafuteni mema, wala si mabaya, mpate kuishi; hivyo BWANA, Mungu wa majeshi, atakuwa pamoja nanyi, kama msemavyo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.14",
            "verseOrgIds": [
              "AMO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
