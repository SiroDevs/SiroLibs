            "style": "v",
            "sid": "AMO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.4.4"
              },
              "items": [
                {
                  "text": "Amo 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.8.14"
              },
              "items": [
                {
                  "text": "8:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bali msitafute Betheli, wala msiingie Gilgali, wala msipite kwenda Beer-sheba; kwani Gilgali hakika yake itakwenda utumwani, na Betheli itakuwa ubatili. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtafuteni BWANA, nanyi mtaishi; asije akawaka kama moto katika nyumba ya Yusufu, nao ukateketeza, asiwepo mtu awezaye kuuzima katika Betheli. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyi mnaogeuza hukumu kuwa uchungu, na kuiangusha haki chini, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.7",
            "verseOrgIds": [
              "AMO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 5:8"
          },
          "items": [
            {
