              },
              "items": [
                {
                  "text": "Amo 4:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mtafuteni yeye afanyaye Kilimia na Orioni, na kukigeuza kivuli cha mauti kuwa asubuhi, na kuufanya mchana kuwa giza kwa usiku; yeye ayaitaye maji ya bahari, na kuyamwaga juu ya uso wa nchi; BWANA, ndilo jina lake; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye aletaye uharibifu wa ghafula juu yao walio hodari, hata uharibifu uipate ngome. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.9",
            "verseOrgIds": [
              "AMO.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.21"
              },
              "items": [
                {
                  "text": "Isa 29:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.8"
              },
              "items": [
                {
                  "text": "1 Fal 22:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wao humchukia yeye akemeaye langoni, nao humzira anenaye maneno ya adili. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.10",
            "verseOrgIds": [
              "AMO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.6.15"
              },
              "items": [
                {
                  "text": "Mik 6:15",
                  "type": "text"
                }
              ]
            },
