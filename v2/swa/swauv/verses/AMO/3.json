                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.9"
              },
              "items": [
                {
                  "text": "Rum 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.17"
              },
              "items": [
                {
                  "text": "1 Pet 4:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ni ninyi tu niliowajua katika jamaa zote zilizo duniani; kwa sababu hiyo nitawapatiliza ninyi maovu yenu yote. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.2",
            "verseOrgIds": [
              "AMO.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Watu wawili waweza kutembea pamoja, wasipokuwa wamepatana? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.3",
            "verseOrgIds": [
              "AMO.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Simba atanguruma mwituni, asipokuwa na mawindo? Mwana-simba atalia pangoni mwake, ikiwa hakupata kitu? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.4",
            "verseOrgIds": [
              "AMO.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Ndege ataanguka mtegoni juu ya nchi, mahali asipotegewa tanzi? Mtego utafyatuka juu ya nchi, bila kunasa kitu cho chote? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.5",
            "verseOrgIds": [
              "AMO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.3"
              },
              "items": [
                {
                  "text": "Eze 33:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Je! Tarumbeta itapigwa mjini, watu wasiogope? Mji utapatikana na hali mbaya, asiyoileta BWANA? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.6",
            "verseOrgIds": [
              "AMO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.13"
              },
              "items": [
                {
                  "text": "Mwa 6:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.32"
              },
              "items": [
                {
                  "text": "Mit 3:32",
                  "type": "text"
                }
              ]
            },
