              "type": "text"
            }
          ]
        },
        {
          "text": "Lisikieni neno hili alilolisema BWANA juu yenu, enyi wana wa Israeli, juu ya jamaa yote niliowapandisha kutoka nchi ya Misri, nikisema, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.1",
            "verseOrgIds": [
              "AMO.3.1"
            ]
          }
        },
        {
          "name": "verse",
