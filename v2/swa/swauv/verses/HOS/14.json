            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.19"
              },
              "items": [
                {
                  "text": "Mt 11:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ni nani aliye na hekima, naye atayafahamu mambo haya? Ni nani aliye na busara, naye atayajua? Kwa maana njia za BWANA zimenyoka, nao wenye haki watakwenda katika njia hizo; bali waasio wataanguka ndani yake.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
