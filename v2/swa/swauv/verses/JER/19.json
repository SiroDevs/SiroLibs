        {
          "text": "nao wamemjengea Baali mahali pake palipo juu, ili kuwachoma moto wana wao, wawe sadaka za kuteketezwa kwa Baali; tendo nisiloliamuru mimi, wala kulinena, wala halikuingia moyoni mwangu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.5",
            "verseOrgIds": [
              "JER.19.5"
