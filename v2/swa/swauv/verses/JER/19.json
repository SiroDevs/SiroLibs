        {
          "text": "ukatoke uende mpaka bonde la mwana wa Hinomu lililo karibu na mahali pa kuingia kwa lango la vigae, ukahubiri huko maneno nitakayokuambia, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.2",
            "verseOrgIds": [
              "JER.19.2"
            ]
          }
        },
