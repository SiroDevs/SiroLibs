                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17"
              },
              "items": [
                {
                  "text": "2 Nya 36:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na baada ya hayo, asema BWANA, nitamtia Sedekia, mfalme wa Yuda, na watumishi wake, na watu wote waliosalia ndani ya mji huu, baada ya tauni ile, na upanga, na njaa, katika mkono wa Nebukadreza, mfalme wa Babeli, na katika mikono ya adui zao, na katika mikono ya watu wale wanaowatafuta roho zao; naye atawaua kwa ukali wa upanga; hatawaachilia, wala hatawahurumia, wala hatawarehemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.19"
              },
              "items": [
                {
                  "text": "Kum 30:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.19"
              },
              "items": [
                {
                  "text": "Isa 1:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nawe waambie watu hawa, BWANA asema hivi, Tazama naweka mbele yenu njia ya uzima, na njia ya mauti. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.38.2"
              },
              "items": [
                {
                  "text": "Yer 38:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.18"
              },
              "items": [
                {
                  "text": "39:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yeye atakayekaa katika mji huu atakufa kwa upanga, na kwa njaa, na kwa tauni; bali yeye atakayetoka, na kujitia pamoja na Wakaldayo wanaowahusuru, yeye ataishi, na maisha yake yatakuwa nyara kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.9",
            "verseOrgIds": [
              "JER.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
