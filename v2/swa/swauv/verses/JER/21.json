            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "2 Nya 36:17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tafadhali utuulizie habari kwa BWANA; kwa maana Nebukadreza, mfalme wa Babeli, analeta vita juu yetu; labda BWANA atatutendea sawasawa na kazi zake zote za ajabu, ili aende zake akatuache.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
