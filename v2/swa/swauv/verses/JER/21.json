              },
              "items": [
                {
                  "text": "37:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana nimeweka uso wangu juu ya mji huu niuletee mabaya, wala nisiuletee mema, asema BWANA; utatiwa katika mkono wa mfalme wa Babeli, naye atauteketeza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        }
      ]
    },
