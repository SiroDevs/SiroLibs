            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na katika habari za nyumba ya mfalme wa Yuda, lisikieni neno la BWANA, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
              "JER.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.101.8"
              },
              "items": [
                {
                  "text": "Zab 101:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ee nyumba ya Daudi, BWANA asema hivi, Hukumuni hukumu ya haki asubuhi, mkawaponye waliotekwa nyara na mkono wake aliyewadhulumu, ghadhabu yangu isije ikatoka kama moto, ikaunguza, asiweze mtu ye yote kuuzima, kwa sababu ya uovu wa matendo yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 21:13"
