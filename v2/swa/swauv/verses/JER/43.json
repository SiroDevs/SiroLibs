                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.18+EZK.29.19+EZK.29.20"
              },
              "items": [
                {
                  "text": "Eze 29:18-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ukawaambie, BWANA wa majeshi, Mungu wa Israeli, asema hivi, Tazama, nitatuma na kumtwaa Nebukadreza, mfalme wa Babeli, mtumishi wangu, nami nitaweka kiti chake cha enzi juu ya mawe haya niliyoyaficha; naye atatandaza hema yake ya fahari juu yake. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.10",
            "verseOrgIds": [
              "JER.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.44.13"
              },
              "items": [
                {
                  "text": "Yer 44:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.2"
              },
              "items": [
                {
                  "text": "15:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.11.9"
              },
              "items": [
                {
                  "text": "Zek 11:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye atakuja, na kuipiga nchi ya Misri; watu walioandikiwa kufa watakufa, nao walioandikiwa kuwa mateka watakuwa mateka, nao walioandikiwa kupigwa kwa upanga watapigwa kwa upanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.11",
            "verseOrgIds": [
              "JER.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.12"
              },
              "items": [
                {
                  "text": "Kut 12:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.19.1"
              },
              "items": [
                {
                  "text": "Isa 19:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.46.25"
              },
              "items": [
                {
                  "text": "Yer 46:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitawasha moto katika nyumba za miungu ya Misri, na kuziteketeza, na kuwachukua mateka; naye atajipamba kwa nchi ya Misri, kama vile mchungaji avaavyo nguo zake; naye atatoka huko na amani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.12",
            "verseOrgIds": [
              "JER.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye atazivunja nguzo za Bethshemeshi, iliyoko huko katika nchi ya Misri, na nyumba za miungu ya Misri ataziteketeza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.13",
            "verseOrgIds": [
              "JER.43.13"
            ]
          }
        }
