              "items": [
                {
                  "text": "Zek 7:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbona, basi, watu hawa wa Yerusalemu wamegeuka waende nyuma, wasikome kugeuka hivyo? Hushika udanganyifu sana, hukataa kurudi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.5",
            "verseOrgIds": [
              "JER.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
