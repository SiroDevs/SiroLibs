          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenye hekima wametahayari, wamefadhaika na kushikwa; tazama, wamelikataa neno la BWANA, wana akili gani ndani yao? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        },
