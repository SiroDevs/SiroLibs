        },
        {
          "text": "Tena utawaambia, BWANA asema hivi, Je! Watu wataanguka, wasisimame tena? Je! Mtu atageuka aende zake, asirudi tena? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.4",
            "verseOrgIds": [
              "JER.8.4"
            ]
          }
        },
