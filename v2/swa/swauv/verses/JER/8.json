              "items": [
                {
                  "text": "Yer 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Je! Walitahayarika, walipokuwa wametenda machukizo? La! Hawakutahayarika, wala hawakuweza kuona haya usoni; basi wataanguka miongoni mwao waangukao; wakati wa kujiliwa kwao wataangushwa chini, asema BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.12",
            "verseOrgIds": [
              "JER.8.12"
            ]
          }
        },
        {
