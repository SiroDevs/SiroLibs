              "items": [
                {
                  "text": "Hos 8:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwasemaje, Sisi tuna akili, na torati ya BWANA tunayo pamoja nasi? Lakini, tazama, kalamu yenye uongo ya waandishi imeifanya kuwa uongo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        },
        {
