                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA asema katika habari zenu, enyi mabaki ya Yuda, Msiingie Misri; jueni sana ya kuwa nimewashuhudia hivi leo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.19",
            "verseOrgIds": [
