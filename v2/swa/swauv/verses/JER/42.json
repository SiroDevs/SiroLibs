          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo akamwita Yohana, mwana wa Karea, na maakida wote wa majeshi waliokuwa pamoja naye, na watu wote tangu wadogo hata wakubwa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.8",
