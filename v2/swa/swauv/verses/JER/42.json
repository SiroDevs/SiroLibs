          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "akawaambia, BWANA, Mungu wa Israeli, ambaye mlinituma kwake, ili niyaweke maombi yenu mbele yake, asema hivi; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.9",
            "verseOrgIds": [
