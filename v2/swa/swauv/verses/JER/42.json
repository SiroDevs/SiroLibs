        {
          "text": "Ndipo Yeremia, nabii, akawaambia, Nimewasikia; tazama, nitamwomba BWANA, Mungu wenu, sawasawa na maneno yenu; tena itakuwa, neno lo lote ambalo BWANA atawajibu, nitawaambia; sitawazuilia neno liwalo lote. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.4",
            "verseOrgIds": [
              "JER.42.4"
            ]
          }
        },
        {
          "name": "verse",
