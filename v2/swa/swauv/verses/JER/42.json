              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamwambia Yeremia, BWANA na awe shahidi wa kweli na uaminifu kati yetu; ikiwa hatufanyi sawasawa na neno lile, ambalo BWANA, Mungu wako, atakutuma utuletee. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.5",
            "verseOrgIds": [
              "JER.42.5"
            ]
          }
        },
