              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini hata katika siku zile, asema BWANA, sitawakomesha ninyi kabisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.18",
