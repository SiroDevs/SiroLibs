                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Walikuwa kama farasi walioshiba wakati wa asubuhi; kila mmoja akalia kwa kutamani mke wa mwenzake. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.8",
