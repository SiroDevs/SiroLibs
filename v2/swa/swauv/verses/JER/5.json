                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo nikasema, Hakika, hawa ni maskini; ni wajinga hawa; maana hawaijui njia ya BWANA, wala hukumu ya Mungu wao; ",
          "type": "text",
          "attrs": {
