                "loc": "PSA.73.12"
              },
              "items": [
                {
                  "text": "Zab 73:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wamewanda sana, wang’aa; naam, wamepita kiasi kwa matendo maovu; hawatetei madai ya yatima, ili wapate kufanikiwa; wala hawaamui haki ya mhitaji. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.28",
            "verseOrgIds": [
              "JER.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 5:29"
          },
          "items": [
