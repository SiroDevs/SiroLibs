              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.5"
              },
              "items": [
                {
                  "text": "Mal 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Je! Nisiwapatilize kwa mambo hayo? Asema BWANA; na nafsi yangu, je! Nisijilipize kisasi juu ya taifa la namna hii?",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.29",
            "verseOrgIds": [
              "JER.5.29"
            ]
          }
        }
