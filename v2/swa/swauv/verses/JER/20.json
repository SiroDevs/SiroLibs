                {
                  "text": "1 Nya 24:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Pashuri, mwana wa Imeri, kuhani, aliyekuwa msimamizi mkuu katika nyumba ya BWANA, alimsikia Yeremia alipokuwa akitabiri maneno hayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.1",
            "verseOrgIds": [
              "JER.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Pashuri akampiga Yeremia, nabii, akamtia katika mkatale, uliokuwa pale penye lango la juu la Benyamini, lililokuwa katika nyumba ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.2",
            "verseOrgIds": [
              "JER.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata ikawa, asubuhi, Pashuri huyo akamtoa Yeremia katika mkatale. Ndipo Yeremia akamwambia, BWANA hakukuita jina lako Pashuri, bali Magor-misabibu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.3",
            "verseOrgIds": [
              "JER.20.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:3",
              "type": "text"
            },
            {
              "text": "Magor-misabibu",
              "type": "text"
            },
            {
              "text": "tafsiri yake ni Hofu ziko pande zote.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.3",
            "verseOrgIds": [
              "JER.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 20:4"
