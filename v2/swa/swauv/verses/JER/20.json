              "items": [
                {
                  "text": "Yer 6:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana kila ninenapo napiga kelele, nalia, Dhuluma na uharibifu! Kwa kuwa neno la BWANA limefanywa shutumu kwangu, na dhihaka, mchana kutwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        },
