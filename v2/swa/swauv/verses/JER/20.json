        },
        {
          "text": "Ee BWANA, umenihadaa, nami nimehadaika; wewe una nguvu kuliko mimi, ukashinda; nimekuwa kitu cha kuchekesha, mchana kutwa; kila mtu hunidhihaki. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
