                "loc": "JER.28.15"
              },
              "items": [
                {
                  "text": "28:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wewe, Pashuri, na watu wote wanaokaa katika nyumba yako, mtakwenda utumwani; nawe utafika Babeli, na huko utakufa, na huko utazikwa, wewe, na rafiki zako wote, uliowatabiria maneno ya uongo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.6",
            "verseOrgIds": [
              "JER.20.6"
            ]
          }
        }
