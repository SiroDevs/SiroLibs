          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wala usiingie ndani katika nyumba yenye karamu, kuketi pamoja nao, na kula na kunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.8",
