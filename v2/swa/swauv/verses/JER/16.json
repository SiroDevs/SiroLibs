                }
              ]
            }
          ]
        },
        {
          "text": "wala watu hawatamega mkate kwa ajili yao, wakati wa kuomboleza, ili kuwafariji kwa ajili yao waliokufa; wala watu hawatawapa kikombe cha faraja, wanywe kwa ajili ya baba yao au mama yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.7",
            "verseOrgIds": [
              "JER.16.7"
            ]
          }
        },
        {
