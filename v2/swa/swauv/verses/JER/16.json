              "items": [
                {
                  "text": "Isa 22:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakubwa kwa wadogo wote pia watakufa katika nchi hii; hawatazikwa, wala watu hawatawalilia, wala kujikata-kata kwa ajili yao, wala kujinyoa kwa ajili yao; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.6",
            "verseOrgIds": [
              "JER.16.6"
            ]
          }
        },
