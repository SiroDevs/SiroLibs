              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.14"
              },
              "items": [
                {
                  "text": "Mwa 19:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wewe hutaoa mke, wala hutakuwa na wana wala binti mahali hapa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.2",
            "verseOrgIds": [
              "JER.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana BWANA asema hivi, katika habari za wana, na katika habari za binti, wazaliwao mahali hapa, na katika habari za mama zao waliowazaa, na katika habari za baba zao waliowazaa, katika nchi hii; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.3",
            "verseOrgIds": [
              "JER.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "watakufa kwa maradhi mabaya; hawataliliwa, wala hawatazikwa; watakuwa kama samadi juu ya uso wa nchi; nao wataangamizwa kwa upanga, na kwa njaa; na mizoga yao itakuwa chakula cha ndege wa angani, na cha wanyama wa nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.4",
            "verseOrgIds": [
              "JER.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 16:5"
          },
          "items": [
            {
