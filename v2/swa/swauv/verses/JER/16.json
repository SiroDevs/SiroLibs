                "loc": "EZK.24.17"
              },
              "items": [
                {
                  "text": "Eze 24:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana BWANA asema hivi, Usiingie ndani ya nyumba yenye matanga, wala usiende kuwaombolezea, wala kuwalilia; maana nimewaondolea watu hawa amani yangu, asema BWANA, hata fadhili zangu na rehema zangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
