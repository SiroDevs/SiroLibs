                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.27.16+JER.27.17+JER.27.18+JER.27.19+JER.27.20+JER.27.21+JER.27.22"
              },
              "items": [
                {
                  "text": "Yer 27:16-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabla haujatimia muda wa miaka miwili mizima, nitavirudisha mahali hapa vyombo vyote vya nyumba ya BWANA, ambavyo Nebukadreza, mfalme wa Babeli, aliviondoa katika mahali hapa, akavichukua mpaka Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.3",
            "verseOrgIds": [
              "JER.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitamrudisha hapa Yekonia, mwana wa Yehoyakimu, mfalme wa Yuda, pamoja na mateka wote wa Yuda, waliokwenda Babeli, asema BWANA; maana nitaivunja nira ya mfalme wa Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.4",
            "verseOrgIds": [
              "JER.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nabii Yeremia akamwambia nabii Hanania, mbele ya makuhani, na mbele ya watu wote waliosimama ndani ya nyumba ya BWANA, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.5",
            "verseOrgIds": [
              "JER.28.5"
            ]
          }
        },
