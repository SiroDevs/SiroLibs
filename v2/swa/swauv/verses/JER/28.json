            }
          ]
        },
        {
          "text": "Ikawa, katika mwaka ule ule, mwanzo wa kutawala kwake Sedekia, mfalme wa Yuda, mwaka wa nne, mwezi wa tano, Hanania, mwana wa Azuri, nabii, wa Gibeoni, akasema nami ndani ya nyumba ya BWANA, mbele ya makuhani na watu wote, akisema, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.1",
            "verseOrgIds": [
              "JER.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
