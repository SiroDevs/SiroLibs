                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA wa majeshi, Mungu wa Israeli, asema hivi, Nimeivunja nira ya mfalme wa Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.2",
            "verseOrgIds": [
              "JER.28.2"
            ]
          }
        },
        {
