              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huwapa nguvu wazimiao, humwongezea nguvu yeye asiyekuwa na uwezo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.29",
            "verseOrgIds": [
