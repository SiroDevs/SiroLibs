              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watulizeni mioyo, watulizeni mioyo, watu wangu, asema Mungu wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.1",
            "verseOrgIds": [
              "ISA.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Semeni na moyo wa Yerusalemu, kauambieni kwa sauti kuu ya kwamba vita vyake vimekwisha, uovu wake umeachiliwa; kwa kuwa amepokea kwa mkono wa BWANA adhabu maradufu kwa dhambi zake zote.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.2",
            "verseOrgIds": [
              "ISA.40.2"
            ]
          }
        }
      ]
    },
