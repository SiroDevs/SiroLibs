              },
              "items": [
                {
                  "text": "Zab 73:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nimeziona njia zake; nami nitamponya; nitamwongoza pia, nitamrudishia faraja zake, yeye na hao wanaomlilia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.18",
            "verseOrgIds": [
