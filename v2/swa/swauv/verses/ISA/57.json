              "items": [
                {
                  "text": "Zab 37:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.37.9"
              },
              "items": [
                {
                  "text": "9",
