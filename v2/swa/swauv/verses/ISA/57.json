              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.31"
              },
              "items": [
                {
                  "text": "Eze 33:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu ya uovu wa kutamani kwake naliona hasira, nikampiga; nalificha uso wangu, nikaona ghadhabu; naye akaendelea kwa ukaidi, kuifuata njia ya moyo wake mwenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.17",
            "verseOrgIds": [
              "ISA.57.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 57:18"
          },
          "items": [
