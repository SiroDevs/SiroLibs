                  "text": "Ebr 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa kuwa sitashindana na watu siku zote, wala sitakuwa na hasira siku zote; maana roho ingezimia mbele zangu, na hizo nafsi nilizozifanya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.16",
            "verseOrgIds": [
              "ISA.57.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
