                  "text": "Hos 5:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA, katika taabu zao walikwenda kwako; waliomba maombi mengi wakati adhabu yako ilipokuwa juu yao. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.16",
            "verseOrgIds": [
              "ISA.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile mwanamke mwenye mimba anayekaribia wakati wake wa kuzaa, alivyo na utungu na kulia kwa sababu ya maumivu yake, ndivyo tulivyokuwa sisi mbele zako, Ee BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.17",
            "verseOrgIds": [
              "ISA.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
