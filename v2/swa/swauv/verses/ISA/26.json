                "loc": "PSA.17.14"
              },
              "items": [
                {
                  "text": "Zab 17:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tumekuwa na mimba, tumekuwa na utungu, tumekuwa kana kwamba tumezaa upepo; hatukufanya wokovu wo wote duniani, wala hawakuanguka wakaao duniani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.18",
            "verseOrgIds": [
              "ISA.26.18"
            ]
          }
        },
        {
