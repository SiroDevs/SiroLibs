                "loc": "EZK.14.13"
              },
              "items": [
                {
                  "text": "Eze 14:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana, tazama, Bwana, BWANA wa majeshi, awaondolea Yerusalemu na Yuda egemeo na tegemeo; tegemeo lote la chakula na tegemeo lote la maji; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mtu hodari na mtu wa vita; mwamuzi na nabii; mpiga ramli na mzee; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.2",
            "verseOrgIds": [
              "ISA.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "jemadari aliye juu ya watu hamsini, na mtu mstahifu, na mshauri, na fundi aliye mstadi, na mganga ajuaye uganga sana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.3",
            "verseOrgIds": [
              "ISA.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.10.16"
              },
              "items": [
                {
                  "text": "Mhu 10:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitawapa watoto kuwamiliki, na watoto wachanga kuwatawala. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.4",
            "verseOrgIds": [
              "ISA.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.1"
              },
              "items": [
                {
                  "text": "Mik 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.50"
              },
              "items": [
                {
                  "text": "Kum 28:50",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.4.16"
              },
              "items": [
                {
                  "text": "Omb 4:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao watu wataonewa, kila mtu na mwenziwe, na kila mtu na jirani yake; mtoto atajivuna mbele ya mzee, na mtu mnyonge mbele ya mtu mwenye heshima. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu atakapomshika ndugu yake ndani ya nyumba ya baba yake, akisema, Wewe una nguo, ututawale wewe; na mahali hapa palipobomoka pawe chini ya mkono wako; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "basi, siku ile atainua sauti yake, akisema, Mimi sitakuwa mponya watu; kwa maana ndani ya nyumba yangu hamna chakula wala mavazi; wala hamtanifanya kuwa mtawala juu ya watu hawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana Yerusalemu umebomolewa na Yuda wameanguka, kwa sababu ulimi wao na matendo yao ni kinyume cha BWANA, hata wayachukize macho ya utukufu wake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuonekana kwa nyuso zao kwashuhudia juu yao, wafunua dhambi yao kama Sodoma, hawaifichi. Ole wa nafsi zao, kwa maana wamejilipa nafsi zao uovu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waambieni wenye haki ya kuwa watakuwa heri, kwa maana watakula matunda ya matendo yao ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.10",
            "verseOrgIds": [
              "ISA.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ole wake mtu mbaya; shari itakuwa kwake, kwa maana atapewa ijara ya mikono yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.11",
            "verseOrgIds": [
              "ISA.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika habari za watu wangu, watoto ndio wanaowaonea, na wanawake ndio wanaowatawala. Enyi watu wangu, wakuongozao wakukosesha, waiharibu njia ya mapito yako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.12",
            "verseOrgIds": [
              "ISA.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA asimama ili atete, asimama ili awahukumu watu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.13",
            "verseOrgIds": [
              "ISA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.33"
              },
              "items": [
                {
                  "text": "Mt 21:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA ataingia katika kuwahukumu wazee wa watu wake na wakuu wao; Ninyi ndinyi mliokula shamba la mizabibu; vitu mlivyowateka maskini vi ndani ya nyumba zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.14",
            "verseOrgIds": [
              "ISA.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nini maana yake, ninyi kuwaonea watu wangu, na kuseta nyuso za maskini? Asema Bwana, BWANA wa majeshi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.15",
            "verseOrgIds": [
              "ISA.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.15",
            "verseOrgIds": [
              "ISA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA akasema tena, Kwa sababu binti za Sayuni wana kiburi, na kuenenda na shingo zilizonyoshwa, na macho ya kutamani, wakienenda kwa hatua za madaha, na kuliza njuga kwa miguu yao; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.16",
            "verseOrgIds": [
              "ISA.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, kwa hiyo, Bwana atawapiga binti za Sayuni kwa pele za utosini, na BWANA ataifunua aibu yao. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.17",
            "verseOrgIds": [
              "ISA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku hiyo BWANA atawaondolea uzuri wa njuga zao, na kaya zao; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.18",
            "verseOrgIds": [
              "ISA.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na pete za masikio, na vikuku, na taji zao; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.19",
            "verseOrgIds": [
              "ISA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "na dusumali, na mafurungu, na vitambi, na vibweta vya marashi, na matalasimu; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.20",
            "verseOrgIds": [
              "ISA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na pete, na azama, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.21",
            "verseOrgIds": [
              "ISA.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mavazi ya sikukuu, na debwani; na shali, na vifuko; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.22",
            "verseOrgIds": [
              "ISA.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "na vioo vidogo, na kitani nzuri, na vilemba, na utaji. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.23",
            "verseOrgIds": [
              "ISA.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata itakuwa ya kuwa badala ya manukato mazuri kutakuwa uvundo, na badala ya mishipi, kamba; na badala ya nywele zilizosukwa vizuri, upaa; na badala ya kisibau, mavazi ya kigunia; na kutiwa alama mwilini kwa moto badala ya uzuri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.24",
            "verseOrgIds": [
              "ISA.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wako waume wataanguka kwa upanga, na mashujaa wako vitani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.25",
            "verseOrgIds": [
              "ISA.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.14.2"
              },
              "items": [
                {
                  "text": "Yer 14:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.1.4"
              },
              "items": [
                {
                  "text": "Omb 1:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na malango yake yatalia na kuomboleza, naye atakuwa ukiwa, atakaa chini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.26",
            "verseOrgIds": [
              "ISA.3.26"
            ]
          }
        }
      ]
    }
  ],
