                  "text": "Kum 1:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena juu ya makao yote ya mlima Sayuni, na juu ya makusanyiko yake, BWANA ataumba wingu na moshi wakati wa mchana, na mwangaza wa miali ya moto wakati wa usiku; kwa maana juu ya utukufu wote itatandazwa sitara. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha kutakuwa na hema kuwa uvuli wakati wa mchana kwa sababu ya hari, na kuwa mahali pa kukimbilia na kujificha wakati wa tufani na mvua.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
          }
        }
