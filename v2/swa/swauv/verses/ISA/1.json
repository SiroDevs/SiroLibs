          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fedha yako imekuwa takataka, divai yako imechanganywa na maji. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.22",
            "verseOrgIds": [
              "ISA.1.22"
