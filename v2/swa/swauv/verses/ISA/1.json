              "items": [
                {
                  "text": "Mik 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "jifunzeni kutenda mema; takeni hukumu na haki; wasaidieni walioonewa; mpatieni yatima haki yake; mteteeni mjane.",
          "type": "text",
          "attrs": {
