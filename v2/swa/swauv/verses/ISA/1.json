            }
          ]
        },
        {
          "text": "Kwa hiyo, asema Bwana, BWANA wa majeshi, Mwenye enzi, wa Israeli, Nitapata faraja kwa hao wanipingao, nitatwaa kisasi kwa adui zangu; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.24",
            "verseOrgIds": [
              "ISA.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
