              "type": "text"
            }
          ]
        },
        {
          "text": "Mji huu uliokuwa mwaminifu umekuwaje kahaba! Yeye aliyejaa hukumu ya haki; haki ilikaa ndani yake, bali sasa wauaji! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.21",
            "verseOrgIds": [
              "ISA.1.21"
            ]
          }
