                }
              ]
            }
          ]
        },
        {
          "text": "Ole wake, taifa lenye dhambi, watu wanaochukua mzigo wa uovu, wazao wa watenda mabaya, watoto wanaoharibu; wamemwacha BWANA, wamemdharau yeye aliye Mtakatifu wa Israeli, wamefarakana naye na kurudi nyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.4",
            "verseOrgIds": [
              "ISA.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 1:5"
          },
          "items": [
