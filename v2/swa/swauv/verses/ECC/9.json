              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia nimeona hekima chini ya jua, nayo ni kama hivi, tena kwangu mimi ilionekana kuwa ni neno kubwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.13",
            "verseOrgIds": [
