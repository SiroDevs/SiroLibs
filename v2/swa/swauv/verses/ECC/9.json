                "loc": "2SA.20.16+2SA.20.17+2SA.20.18+2SA.20.19+2SA.20.20+2SA.20.21+2SA.20.22"
              },
              "items": [
                {
                  "text": "2 Sam 20:16-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Palikuwa na mji mdogo, na watu ndani yake walikuwa wachache; akaja mfalme mkuu juu yake, akauhusuru, akajenga ngome kubwa ili kuupiga. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.14",
            "verseOrgIds": [
              "ECC.9.14"
            ]
          }
        },
