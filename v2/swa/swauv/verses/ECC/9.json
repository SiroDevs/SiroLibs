                "loc": "ECC.2.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uishi kwa furaha pamoja na mke umpendaye, siku zote za maisha yako ya ubatili, ulizopewa chini ya jua; siku zote za ubatili wako, kwa maana huo ni sehemu yako ya maisha; na katika taabu zako ulizozitaabika chini ya jua. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.9",
            "verseOrgIds": [
              "ECC.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lo lote mkono wako utakalolipata kulifanya, ulifanye kwa nguvu zako; kwa kuwa hakuna kazi, wala shauri, wala maarifa, wala hekima, huko kuzimu uendako wewe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.10",
            "verseOrgIds": [
              "ECC.9.10"
            ]
          }
        }
      ]
