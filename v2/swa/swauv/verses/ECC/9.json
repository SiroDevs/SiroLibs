        },
        {
          "text": "Wewe enenda zako, ule chakula chako kwa furaha, unywe mvinyo yako kwa moyo wa kuchangamka; kwa kuwa Mungu amekwisha kuzikubali kazi zako. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.7",
            "verseOrgIds": [
              "ECC.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
