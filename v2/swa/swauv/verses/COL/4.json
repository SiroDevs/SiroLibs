                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Luka, yule tabibu mpendwa, na Dema, wanawasalimu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.14",
            "verseOrgIds": [
              "COL.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasalimuni ndugu walioko Laodikia, na Nimfa, na kanisa lililo katika nyumba yake. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.15",
            "verseOrgIds": [
              "COL.4.15"
            ]
          }
