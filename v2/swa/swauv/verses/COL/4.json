          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waraka huu ukiisha kusomwa kwenu fanyeni kwamba usomwe katika kanisa la Walaodikia pia; na ule wa Laodikia usomwe na ninyi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.16",
