                {
                  "text": "Kol 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.23"
              },
              "items": [
                {
                  "text": "Flm 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Epafra, aliye mtu wa kwenu, mtumwa wa Yesu Kristo, awasalimu, akifanya bidii siku zote kwa ajili yenu katika maombi yake, ili kwamba msimame wakamilifu na kuthibitika sana katika mapenzi yote ya Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
