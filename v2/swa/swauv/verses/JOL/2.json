              "type": "text"
            }
          ]
        },
        {
          "text": "Na sakafu za kupepetea zitajaa ngano, na mashinikizo yatafurika kwa divai na mafuta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.24",
