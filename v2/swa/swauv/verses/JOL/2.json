              "items": [
                {
                  "text": "Ufu 8:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nchi inatetemeka mbele yao; mbingu zinatetemeka; jua na mwezi hutiwa giza, na nyota huacha kuangaza; ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.10",
            "verseOrgIds": [
              "JOL.2.10"
            ]
