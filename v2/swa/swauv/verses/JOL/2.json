          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitawarudishia hiyo miaka iliyoliwa na nzige, na parare, na madumadu, na tunutu, jeshi langu kubwa nililotuma kati yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.25",
