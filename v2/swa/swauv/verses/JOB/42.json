                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.7.25"
              },
              "items": [
                {
                  "text": "Ebr 7:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.16"
              },
              "items": [
                {
                  "text": "Yak 5:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi sasa, jitwalieni ng’ombe waume saba, na kondoo waume saba, mkamwendee mtumishi wangu Ayubu, mjisongezee sadaka ya kuteketezwa; na huyo mtumishi wangu Ayubu atawaombea ninyi; kwa kuwa nitamridhia yeye, nisiwatende sawasawa na upumbavu wenu; kwani ninyi hamkunena maneno yaliyonyoka katika habari zangu, kama alivyonena mtumishi wangu Ayubu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Elifazi, Mtemani, na Bildadi, Mshuhi, na Sofari, Mnaamathi, wakaenda, wakafanya kama vile BWANA alivyowaamuru; naye BWANA akamridhia Ayubu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayubu Arejeshewa Mali yake Maradufu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
