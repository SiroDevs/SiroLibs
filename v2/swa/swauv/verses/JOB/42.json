              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Ayubu akamjibu BWANA, na kusema.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        }
