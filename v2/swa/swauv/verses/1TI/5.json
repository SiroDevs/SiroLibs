                "loc": "DEU.17.6"
              },
              "items": [
                {
                  "text": "Kum 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "19:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.16"
              },
              "items": [
                {
                  "text": "Mt 18:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.1"
              },
              "items": [
                {
                  "text": "2 Kor 13:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Usikubali mashitaka juu ya mzee, ila kwa vinywa vya mashahidi wawili au watatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.19",
            "verseOrgIds": [
              "1TI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.14"
              },
              "items": [
                {
                  "text": "Gal 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wale wadumuo kutenda dhambi uwakemee mbele ya wote, ili na wengine waogope. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.20",
            "verseOrgIds": [
              "1TI.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TI 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.26"
              },
              "items": [
                {
                  "text": "Lk 9:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nakuagiza mbele za Mungu, na mbele za Kristo Yesu, na mbele za malaika wateule, uyatende hayo pasipo kuhukumu kwa haraka; usifanye neno lo lote kwa upendeleo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.21",
            "verseOrgIds": [
              "1TI.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1TI 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
