                "loc": "1CO.9.9"
              },
              "items": [
                {
                  "text": "1 Kor 9:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.10"
