              },
              "items": [
                {
                  "text": "Flp 2:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wazee watawalao vema na wahesabiwe kustahili heshima maradufu; hasa wao wajitaabishao kwa kuhutubu na kufundisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.17",
            "verseOrgIds": [
              "1TI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
