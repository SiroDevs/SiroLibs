              "attrs": {
                "loc": "LUK.10.7"
              },
              "items": [
                {
                  "text": "Lk 10:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana andiko lasema, Usimfunge kinywa ng’ombe apurapo nafaka. Na tena, Mtenda kazi astahili ujira wake. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.18",
            "verseOrgIds": [
              "1TI.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
