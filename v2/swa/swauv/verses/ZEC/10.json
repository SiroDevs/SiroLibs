              "items": [
                {
                  "text": "Rum 11:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.26"
              },
              "items": [
                {
                  "text": "Kut 14:26",
