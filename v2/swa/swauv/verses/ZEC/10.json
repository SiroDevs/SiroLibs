                {
                  "text": "Mt 9:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.34"
              },
              "items": [
                {
                  "text": "Mk 6:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana vinyago vimenena maneno ya ubatili, nao waaguzi wameona uongo; nao wameleta habari za ndoto za uongo, wafariji bure; kwa sababu hiyo waenda zao kama kondoo, wateswa, kwa sababu hapana mchungaji. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        },
        {
          "name": "verse",
