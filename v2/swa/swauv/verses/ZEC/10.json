                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwombeni BWANA mvua wakati wa masika, naam, BWANA afanyaye umeme, naye atawapa manyunyu ya mvua, kila mtu atapewa nyasi kondeni. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
