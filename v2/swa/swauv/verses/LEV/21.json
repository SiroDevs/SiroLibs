        {
          "text": "Kisha BWANA akamwambia Musa, Nena na hao makuhani, wana wa Haruni, uwaambie, Mtu asijinajisi kwa ajili ya wafu katika watu wake; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.1",
            "verseOrgIds": [
              "LEV.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "isipokuwa ni kwa ajili ya jamaa yake wa karibu, kwa ajili ya mama yake, na kwa ajili baba yake, na kwa ajili ya mwanawe, na kwa ajili ya binti yake, na kwa ajili ya nduguye mwanamume; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.2",
            "verseOrgIds": [
              "LEV.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kwa ajili ya umbu lake aliye mwanamwali, aliye wa udugu kwake, ambaye hajaolewa na mume; ana ruhusa kujitia unajisi kwa ajili yake huyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.3",
            "verseOrgIds": [
              "LEV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asijitie unajisi, ijapokuwa ni mkubwa katika watu wake, hata akajinajisi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.4",
            "verseOrgIds": [
              "LEV.21.4"
            ]
          }
        },
        {
