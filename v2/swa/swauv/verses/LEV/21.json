              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "au mtu aliyevunjika mguu, au aliyevunjika mkono, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.19",
            "verseOrgIds": [
              "LEV.21.19"
            ]
