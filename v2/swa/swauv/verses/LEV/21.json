                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "au aliye na kijongo, au aliye kibeti, au aliye na kilema cha jichoni, au aliye na upele, au mwenye buba, au aliyevunjika mapumbu; ",
          "type": "text",
