                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa hiyo basi utamtakasa; kwa kuwa yeye husongeza chakula cha Mungu wako; atakuwa mtakatifu kwako wewe; kwa kuwa mimi BWANA niwatakasaye ninyi ni mtakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.8",
            "verseOrgIds": [
              "LEV.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
