                  "text": "Hes 18:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atakula chakula cha Mungu wake, katika hicho kilicho kitakatifu sana, na hicho kilicho kitakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.22",
            "verseOrgIds": [
