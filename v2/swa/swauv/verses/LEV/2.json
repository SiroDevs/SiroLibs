              "items": [
                {
                  "text": "Rum 12:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha kuhani atatwaa humo huo ukumbusho wa sadaka ya unga, naye atauteketeza juu ya madhabahu; ni kafara ya kusongezwa kwa njia ya moto, ya harufu ya kupendeza kwa BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.9",
            "verseOrgIds": [
              "LEV.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
