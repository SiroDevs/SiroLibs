                }
              ]
            }
          ]
        },
        {
          "text": "Na hicho kitakachosalia katika sadaka ya unga kitakuwa cha Haruni na wanawe; ni kitu kitakatifu sana katika sadaka zilizosongezwa kwa BWANA kwa njia ya moto. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.10",
            "verseOrgIds": [
