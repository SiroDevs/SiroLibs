            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tangu sasa mtu asinitaabishe; kwa maana ninachukua mwilini mwangu chapa zake Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
