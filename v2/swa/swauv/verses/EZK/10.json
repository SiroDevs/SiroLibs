            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.7.20+EZK.7.21+EZK.7.22"
              },
              "items": [
                {
                  "text": "Eze 7:20-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha huo utukufu wa BWANA ukatoka pale juu ya kizingiti cha nyumba, ukasimama juu ya makerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.18",
            "verseOrgIds": [
              "EZK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 10:19"
          },
