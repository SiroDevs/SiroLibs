                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo nikaangalia, na tazama, katika anga lililokuwa juu ya vichwa vya makerubi, kulionekana juu yao kana kwamba ni yakuti samawi, kuonekana kama mfano wa kiti cha enzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
