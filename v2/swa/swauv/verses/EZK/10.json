                "loc": "DAN.9.21"
              },
              "items": [
                {
                  "text": "Dan 9:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.14.17"
              },
              "items": [
                {
                  "text": "2 Sam 14:17",
