            "number": "6",
            "style": "v",
            "sid": "EZK 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA asema hivi; Nao pia wanaoitegemeza Misri wataanguka, na kiburi cha uwezo wake kitashuka; toka Migdoli hata Sewene, wataanguka ndani yake kwa upanga, asema Bwana MUNGU. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.6",
            "verseOrgIds": [
              "EZK.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.12"
              },
              "items": [
                {
                  "text": "Eze 29:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao watakuwa ukiwa, kati ya nchi zilizo ukiwa, na miji yake itakuwamo kati ya miji iliyoharibika. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.7",
            "verseOrgIds": [
              "EZK.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao watajua ya kuwa mimi ndimi BWANA, nitakapoweka moto katika Misri, na hao wote wamsaidiao watakapoangamia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.8",
            "verseOrgIds": [
              "EZK.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
