                  "text": "2 Fal 24:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Bwana MUNGU asema hivi; Tazama, mimi ni juu ya Farao, mfalme wa Misri, nami nitamvunja mikono yake, mkono ulio wenye nguvu, na huo uliovunjika, nami nitauangusha upanga ulio katika mkono wake. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.22",
            "verseOrgIds": [
              "EZK.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 30:23"
          },
          "items": [
