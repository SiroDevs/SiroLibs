                  "text": "46:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwanadamu, nimeuvunja mkono wa Farao, mfalme wa Misri, na tazama, haukufungwa ili kuutia dawa, haukuzongwa kwa kitambaa, upate kuwa na nguvu za kushika upanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.21",
            "verseOrgIds": [
