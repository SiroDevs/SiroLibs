              "type": "text"
            }
          ]
        },
        {
          "text": "Neno la BWANA likanijia tena, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.1",
            "verseOrgIds": [
              "EZK.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.6"
              },
              "items": [
                {
                  "text": "Isa 13:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwanadamu, tabiri, useme, Bwana MUNGU asema hivi; Pigeni makelele ya uchungu, Ole wa siku ile! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.7.7"
              },
              "items": [
                {
                  "text": "Eze 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.1"
              },
              "items": [
                {
                  "text": "Yoe 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana siku ile i karibu, siku ile ya BWANA i karibu, siku ya mawingu; itakuwa wakati wa mataifa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.3",
            "verseOrgIds": [
              "EZK.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.19"
              },
              "items": [
                {
                  "text": "Eze 29:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.15"
              },
              "items": [
                {
                  "text": "Yer 50:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na upanga utakuja juu ya Misri, na dhiki itakuwa katika Kushi, watakapoanguka watu waliouawa katika Misri, nao watauondoa wingi wa watu wake, na misingi yake itabomolewa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.20"
              },
              "items": [
                {
                  "text": "Yer 25:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kushi, na Putu, na Ludi, na watu wote waliochanganyika, na Kubu, na wana wa nchi ya agano, wataanguka kwa upanga pamoja nao.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.5",
            "verseOrgIds": [
              "EZK.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
