              "items": [
                {
                  "text": "Eze 26:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Katika siku hiyo watatoka wajumbe mbele zangu katika merikebu, ili kuwatia hofu Wakushi, wanaojiona kuwa salama, na dhiki itakuwa juu yao, vile vile kama katika siku ya Misri; kwa maana, tazama, inakuja.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.9",
            "verseOrgIds": [
              "EZK.30.9"
            ]
          }
        }
