            "number": "24",
            "style": "v",
            "sid": "EZK 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitaitia nguvu mikono ya mfalme wa Babeli, na kuutia upanga wangu katika mkono wake, bali mikono ya Farao nitaivunja, naye ataugua mbele yake, kwa mauguzi ya mtu aliyetiwa jeraha ya kumfisha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.24",
            "verseOrgIds": [
