                "loc": "EZK.29.19"
              },
              "items": [
                {
                  "text": "Eze 29:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana MUNGU asema hivi; Pia nitaukomesha wingi wa watu wa Misri, kwa mkono wa Nebukadreza, mfalme wa Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.10",
            "verseOrgIds": [
              "EZK.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.7"
              },
              "items": [
                {
                  "text": "Eze 28:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yeye, na watu wake pamoja naye, watu wa mataifa watishao, wataletwa waingie katika nchi waiharibu, nao watafuta panga zao wapigane na Misri, na kuijaza nchi wale waliouawa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.11",
            "verseOrgIds": [
              "EZK.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.19.4"
              },
              "items": [
                {
                  "text": "Isa 19:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitaikausha mito, na kuiuza nchi, na kuitia katika mikono ya watu wabaya; nami nitaifanya nchi kuwa ukiwa, na watu wote walio ndani yake, kwa mkono wa wageni; mimi, BWANA, nimenena neno hili.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.12",
            "verseOrgIds": [
              "EZK.30.12"
            ]
          }
        }
      ]
