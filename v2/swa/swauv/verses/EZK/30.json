              "items": [
                {
                  "text": "Eze 29:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitawatawanya Wamisri kati ya mataifa, na kuwatapanya kati ya nchi mbalimbali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.23",
            "verseOrgIds": [
              "EZK.30.23"
            ]
          }
