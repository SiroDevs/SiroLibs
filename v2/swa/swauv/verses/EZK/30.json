              "items": [
                {
                  "text": "Yer 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Huko Tapanesi nako mchana utakuwa giza, nitakapovunja huko kongwa za Misri, na kiburi cha uwezo wake kitakoma ndani yake, na katika habari zake, wingu litaifunika, na binti zake watakwenda utumwani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.18",
            "verseOrgIds": [
              "EZK.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo ndivyo nitakavyotekeleza hukumu katika Misri; nao watajua ya kuwa mimi ndimi BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.19",
            "verseOrgIds": [
              "EZK.30.19"
            ]
          }
        }
      ]
    },
