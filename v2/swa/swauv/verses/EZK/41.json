                "loc": "1KI.6.31+1KI.6.32+1KI.6.33+1KI.6.34+1KI.6.35"
              },
              "items": [
                {
                  "text": "1 Fal 6:31-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nalo hekalu na patakatifu palikuwa na milango miwili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.23",
            "verseOrgIds": [
              "EZK.41.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na milango hiyo, kila mmoja ulikuwa na mbao mbili; mbao mbili zigeukazo; mbao mbili za mlango mmoja, na mbao mbili za mlango wa pili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.24",
            "verseOrgIds": [
              "EZK.41.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na milango ya hekalu ilifanyiziwa makerubi na mitende vile vile, kama zile kuta zilivyofanyiziwa; tena palikuwa na boriti nene juu ya uso wa ukumbi, nje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.25",
            "verseOrgIds": [
              "EZK.41.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.16"
              },
              "items": [
                {
                  "text": "Eze 40:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena palikuwa na madirisha yaliyofungwa, na mitende, upande huu na upande huu, katika pande za ukumbi; ndiyo habari ya vyumba vya mbavuni vya nyumba hiyo, na vya boriti zile nene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.26",
            "verseOrgIds": [
              "EZK.41.26"
            ]
          }
