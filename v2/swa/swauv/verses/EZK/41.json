          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaupima urefu wa jengo lile lililokabili mahali palipotengeka, palipokuwa nyuma yake, na baraza zake upande huu na upande huu, dhiraa mia; na hekalu la ndani, na kumbi za ua; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.15",
            "verseOrgIds": [
              "EZK.41.15"
            ]
          }
        },
        {
