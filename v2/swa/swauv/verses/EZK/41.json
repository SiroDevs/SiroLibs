              "items": [
                {
                  "text": "1 Kor 13:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na vizingiti, na madirisha yaliyofungwa, na baraza za pande zote za orofa zile tatu, zilizokikabili kizingiti, zilitiwa mabamba ya mti pande zote; na toka chini hata madirishani; (nayo madirisha yamefunikwa); ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.16",
            "verseOrgIds": [
              "EZK.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mpaka juu ya mlango hata nyumba ya ndani, na nje, na juu ya kuta zote pande zote, katika nyumba ya ndani, na ya nje, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.17",
            "verseOrgIds": [
              "EZK.41.17"
            ]
          }
        },
