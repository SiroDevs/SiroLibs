        },
        {
          "text": "kulipambwa kwa makerubi na mitende; mtende mmoja kati ya kerubi na kerubi, na kila kerubi lilikuwa na nyuso mbili; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.18",
            "verseOrgIds": [
              "EZK.41.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
