                }
              ]
            }
          ]
        },
        {
          "text": "Madhabahu ilikuwa ni ya miti, kimo chake dhiraa tatu, na urefu wake dhiraa mbili; na pembe zake, na msingi wake, na kuta zake zilikuwa za miti; akaniambia, Hii ndiyo meza iliyo mbele za BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.22",
            "verseOrgIds": [
              "EZK.41.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 41:23"
          },
          "items": [
