                }
              ]
            }
          ]
        },
        {
          "text": "Tena neno la BWANA likanijia, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.1",
            "verseOrgIds": [
              "EZK.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.11"
              },
              "items": [
                {
                  "text": "Amo 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "OBA.1.10"
              },
              "items": [
                {
                  "text": "Oba 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwanadamu, kaza uso wako juu ya mlima Seiri, ukatabiri juu yake, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.2",
            "verseOrgIds": [
              "EZK.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uuambie, Bwana MUNGU asema hivi; Tazama, mimi ni juu yako, Ee mlima Seiri, nami nitaunyosha mkono wangu juu yako, nami nitakufanya kuwa ukiwa na ajabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.3",
            "verseOrgIds": [
              "EZK.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miji yako nitaiharibu, nawe utakuwa ukiwa; nawe utajua ya kuwa mimi ndimi BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.4",
            "verseOrgIds": [
              "EZK.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.137.7"
              },
              "items": [
                {
                  "text": "Zab 137:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa kuwa umekuwa na uadui usiokoma, nawe umewatoa wana wa Israeli wapigwe kwa nguvu za upanga, wakati wa msiba wao, wakati wa mwisho wa uovu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.5",
            "verseOrgIds": [
              "EZK.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.109.17"
              },
              "items": [
                {
                  "text": "Zab 109:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi, kama mimi niishivyo, asema Bwana MUNGU, nitakuweka tayari kwa damu, na damu itakufuatia; ikiwa hukuchukia damu, basi damu itakufuatia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.6",
            "verseOrgIds": [
              "EZK.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo ndivyo nitakavyoufanya mlima Seiri kuwa ajabu na ukiwa; nami nitakatilia mbali nao mtu apitaye, na mtu arejeaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.7",
            "verseOrgIds": [
              "EZK.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitaijaza milima yake watu wake waliouawa; katika milima yako, na katika mabonde yako, na katika mifereji yako ya maji yote, wataanguka wao watakaouawa kwa upanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.8",
            "verseOrgIds": [
              "EZK.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.49.17"
              },
              "items": [
                {
                  "text": "Yer 49:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.3"
              },
              "items": [
                {
                  "text": "Mal 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nitakufanya kuwa ukiwa wa daima, na miji yako haitakaliwa na watu; nanyi mtajua ya kuwa mimi ndimi BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.9",
            "verseOrgIds": [
              "EZK.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.83.4"
              },
              "items": [
                {
                  "text": "Zab 83:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu umesema, Mataifa haya mawili na nchi hizi mbili zitakuwa zangu, nasi tutazimiliki, ijapokuwa BWANA alikuwako huko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.10",
            "verseOrgIds": [
              "EZK.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.2"
              },
              "items": [
                {
                  "text": "Mt 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.9"
              },
              "items": [
                {
                  "text": "Isa 26:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi, kama mimi niishivyo, asema Bwana MUNGU, nitatenda kwa kadiri ya hasira yako, na kwa kadiri ya wivu wako, ulioudhihirisha kwa kuwachukia; nami nitajidhihirisha kwao, nitakapokuhukumu wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.11",
            "verseOrgIds": [
              "EZK.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.9.16"
              },
              "items": [
                {
                  "text": "Zab 9:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nawe utajua ya kuwa mimi, BWANA, nimeyasikia matukano yako yote, uliyoyanena juu ya milima ya Israeli, ukisema, Wamefanyika ukiwa, wametiwa katika mikono yetu tuwale. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.12",
            "verseOrgIds": [
              "EZK.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanyi mmejitukuza juu yangu kwa vinywa vyenu, na kuyaongeza maneno juu yangu; nimesikia mimi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.13",
            "verseOrgIds": [
              "EZK.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.7"
              },
              "items": [
                {
                  "text": "Isa 14:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bwana MUNGU asema hivi; Dunia yote itakapofurahi, nitakufanya kuwa ukiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.14",
            "verseOrgIds": [
              "EZK.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.17.5"
              },
              "items": [
                {
                  "text": "Mit 17:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "OBA.1.12"
              },
              "items": [
                {
                  "text": "Oba 1:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kama vile ulivyofurahi juu ya urithi wa nyumba ya Israeli, kwa sababu ilikuwa ukiwa, ndivyo nitakavyokutenda wewe; utakuwa ukiwa, Ee mlima Seiri, na Edomu yote, naam, yote pia; nao watajua ya kuwa mimi ndimi BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.15",
            "verseOrgIds": [
              "EZK.35.15"
            ]
          }
        }
      ]
    }
