                "loc": "MAL.3.10"
              },
              "items": [
                {
                  "text": "Mal 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azaria kuhani mkuu, wa nyumba ya Sadoki, akamjibu, akasema, Tangu watu walipoanza kuleta matoleo nyumbani kwa BWANA, tumekula na kushiba, na kusaza tele; kwa kuwa BWANA amewabariki watu wake; na kilichosalia ndiyo akiba hii kubwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        }
      ]
    },
    {
