        },
        {
          "text": "Nao wana wa Israeli na Yuda, waliokaa mijini mwa Yuda, wakaleta pia zaka za ng’ombe na kondoo, na zaka za vitu vilivyowekwa wakfu, alivyowekewa BWANA, Mungu wao, wakaviweka chungu chungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwezi wa tatu wakaanza kuweka misingi ya hizo chungu, wakazimaliza katika mwezi wa saba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
