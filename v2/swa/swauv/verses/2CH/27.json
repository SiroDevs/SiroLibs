              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.14"
              },
              "items": [
                {
                  "text": "2 Nya 33:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.3.26"
              },
              "items": [
                {
                  "text": "Neh 3:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndiye aliyelijenga lango la juu la nyumba ya BWANA, na juu ya ukuta wa Ofeli akajenga sana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.3",
            "verseOrgIds": [
              "2CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena akajenga miji katika milima ya Yuda, na mwituni akajenga ngome na minara. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.4",
            "verseOrgIds": [
              "2CH.27.4"
            ]
          }
        },
        {
          "name": "verse",
