                }
              ]
            }
          ]
        },
        {
          "text": "Akafanya yaliyo ya adili machoni pa BWANA, sawasawa na yote aliyoyafanya Uzia babaye; isipokuwa hakuingia hekaluni mwa BWANA. Lakini watu walikuwa wakali kufanya maovu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.2",
            "verseOrgIds": [
              "2CH.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 27:3"
          },
          "items": [
