                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nikizifunga mbingu isiwe mvua, tena nikiamuru nzige kula nchi, au nikiwapelekea watu wangu tauni; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.13",
            "verseOrgIds": [
              "2CH.7.13"
            ]
          }
        },
