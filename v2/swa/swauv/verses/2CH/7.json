          ]
        },
        {
          "text": "Hivyo Sulemani akaimaliza nyumba ya BWANA, na nyumba ya mfalme; na yote yaliyomwingia Sulemani moyoni ayafanye nyumbani mwa BWANA, na nyumbani mwake mwenyewe, akayafanikisha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        }
      ]
    },
