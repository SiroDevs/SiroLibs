        },
        {
          "text": "Basi Sulemani alipokwisha maombi hayo, moto ukashuka kutoka mbinguni, ukateketeza sadaka ya kuteketezwa na dhabihu; utukufu wa BWANA ukaijaza nyumba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.5.14"
              },
              "items": [
                {
                  "text": "2 Nya 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wala makuhani hawakuweza kuingia nyumbani mwa BWANA, kwa kuwa utukufu wa BWANA umeijaza nyumba ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 7:3"
          },
          "items": [
