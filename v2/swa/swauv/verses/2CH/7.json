                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena Sulemani akaitakasa behewa katikati, iliyokuwa mbele ya nyumba ya BWANA; kwa kuwa hapo ndipo alipotoa sadaka za kuteketezwa, na mafuta ya sadaka za amani; kwa sababu ile madhabahu ya shaba aliyoifanya Sulemani haikutosha kuzipokea sadaka ya kuteketezwa, na sadaka ya unga, na mafuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.65"
