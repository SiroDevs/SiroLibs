                  "text": "2 Nya 6:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sasa macho yangu yatafumbuka, na masikio yangu yatasikiliza maombi ya watu waombao mahali hapa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.15",
            "verseOrgIds": [
