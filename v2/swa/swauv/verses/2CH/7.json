                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ikiwa watu wangu, walioitwa kwa jina langu, watajinyenyekesha, na kuomba, na kunitafuta uso, na kuziacha njia zao mbaya; basi, nitasikia toka mbinguni, na kuwasamehe dhambi yao, na kuiponya nchi yao. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.14",
            "verseOrgIds": [
