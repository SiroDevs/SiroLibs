                  "text": "Yos 13:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi, wakati ule Sulemani akafanya sikukuu, na Israeli wote pamoja naye, kusanyiko kubwa sana, toka maingilio ya Hamathi mpaka kijito cha Misri, muda wa siku saba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.8",
            "verseOrgIds": [
              "2CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata siku ya nane wakaita kusanyiko la makini; kwa maana walishika kuitakasa madhabahu siku saba, na sikukuu siku saba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.9",
            "verseOrgIds": [
              "2CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.66"
              },
              "items": [
                {
                  "text": "1 Fal 8:66",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akawaruhusu watu waende hemani kwao siku ya ishirini na tatu, ya mwezi wa saba, wakifurahi na kuchangamka mioyoni kwa wema wote BWANA aliomfanyia Daudi, na Sulemani, na Israeli watu wake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        }
      ]
    },
