        {
          "text": "Mfalme Rehoboamu akafanya ngao za shaba mahali pake, akawakabidhi wakuu wa walinzi, waliongoja mlangoni pa nyumba ya mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.10",
