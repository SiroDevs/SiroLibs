                {
                  "text": "2 Pet 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "2 Fal 22:1—23:30; 2 Nya 34:1—35:27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno la BWANA lililomjia Sefania, mwana wa Kushi, mwana wa Gedalia, mwana wa Amaria, mwana wa Hezekia; katika siku za Yosia, mwana wa Amoni, mfalme wa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.1",
            "verseOrgIds": [
              "ZEP.1.1"
            ]
          }
        }
