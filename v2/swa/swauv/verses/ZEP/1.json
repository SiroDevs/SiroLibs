            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.7.19"
              },
              "items": [
                {
                  "text": "Eze 7:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.8"
              },
              "items": [
                {
                  "text": "Sef 3:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Fedha yao wala dhahabu yao havitaweza kuwaokoa katika siku ile ya ghadhabu ya BWANA; bali nchi yote pia itateketezwa kwa moto wa wivu wake; maana atawakomesha watu wote wakaao katika nchi hii, naam, ukomo wa kutisha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.18",
            "verseOrgIds": [
              "ZEP.1.18"
            ]
