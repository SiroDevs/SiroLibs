          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitawaletea wanadamu dhiki, hata watakwenda kama vipofu, kwa sababu wamemtenda BWANA dhambi; na damu yao itamwagwa kama mavumbi, na nyama yao kama mavi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.17",
            "verseOrgIds": [
              "ZEP.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
