                }
              ]
            }
          ]
        },
        {
          "text": "Na mpaka wa wana wa Efraimu kwa kuandama jamaa zao ulikuwa hivi; mpaka na urithi wao upande wa mashariki ulikuwa ni Ataroth-adari, hata Beth-horoni wa juu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.5",
            "verseOrgIds": [
              "JOS.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
