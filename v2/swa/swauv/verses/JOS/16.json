                  "text": "1 Nya 7:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kisha ulitelemka kutoka Yanoa hata Atarothi, na Naara, kisha ukafikilia Yeriko, na kutokea hapo penye mto wa Yordani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.7",
            "verseOrgIds": [
              "JOS.16.7"
            ]
          }
        },
        {
