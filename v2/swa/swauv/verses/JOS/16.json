                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kisha ikatelemkia upande wa magharibi hata kuufikilia mpaka wa Wayafleti, hata mpaka wa Beth-horoni ya chini, hata kufikilia Gezeri; na matokeo yake yalikuwa hapo baharini. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.3",
            "verseOrgIds": [
              "JOS.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
