                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kisha ikatoka huko Betheli kwendelea Luzu, kisha ikaendelea hata kuufikilia mpaka wa Waarki mpaka Atarothi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.2",
