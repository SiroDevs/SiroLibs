              "items": [
                {
                  "text": "Yos 17:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wana wa Yusufu, Manase na Efraimu, walitwaa urithi wao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.4",
            "verseOrgIds": [
              "JOS.16.4"
            ]
          }
        },
        {
