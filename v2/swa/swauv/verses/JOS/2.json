              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.17.19"
              },
              "items": [
                {
                  "text": "2 Sam 17:19",
                  "type": "text"
                }
              ]
            },
            {
