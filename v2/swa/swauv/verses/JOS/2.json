              },
              "items": [
                {
                  "text": "Mit 21:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mfalme wa Yeriko akaambiwa, kusema, Tazama, watu wawili wa wana wa Israeli wameingia humu leo usiku, ili kuipeleleza nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.2",
            "verseOrgIds": [
              "JOS.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme wa Yeriko akatuma watu kwa Rahabu, akasema, Watoe watu wale waliokuja kwako, walioingia ndani ya nyumba yako, maana wamekuja ili kuipeleleza nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.3",
            "verseOrgIds": [
              "JOS.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 2:4"
          },
          "items": [
