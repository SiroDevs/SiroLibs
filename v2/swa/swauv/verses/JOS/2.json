        },
        {
          "text": "Ndipo akawashusha kwa kamba dirishani, maana nyumba yake ilikuwa katika ukuta wa mji; naye alikaa ukutani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.15",
