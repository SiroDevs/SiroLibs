              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wewe ukitangaza habari yetu hii, ndipo tutakuwa hatuna hatia, katika kiapo hiki ulichotuapisha. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.20",
            "verseOrgIds": [
              "JOS.2.20"
            ]
          }
        },
