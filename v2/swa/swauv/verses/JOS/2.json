              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wale watu wakarudi, wakatelemka mlimani, wakavuka, wakamwendea Yoshua, mwana wa Nuni, nao wakamwambia habari za mambo yote yaliyowapata. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.23",
            "verseOrgIds": [
