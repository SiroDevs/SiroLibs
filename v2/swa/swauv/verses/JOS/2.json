              "items": [
                {
                  "text": "2 Fal 6:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yule mwanamke akawatwaa wale watu wawili, akawaficha, akasema, Naam, wale watu walikuja kwangu, lakini sikujua walikotoka; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.4",
            "verseOrgIds": [
              "JOS.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikawa kama wakati wa kufungwa lango la mji, kulipokuwa giza, watu wale wakatoka, wala sijui walikokwenda; wafuateni upesi, maana mtawapata. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.5",
            "verseOrgIds": [
              "JOS.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.17"
              },
              "items": [
                {
                  "text": "Kut 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini yeye alikuwa amewapandisha darini, akawaficha kwa mabua ya kitani, aliyokuwa ameyatandika juu ya dari. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.6",
            "verseOrgIds": [
              "JOS.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi hao watu wakawafuata kwa njia iendayo Yordani mpaka vivukoni; na mara wale watu waliowafuatia walipokwisha kutoka, wakalifunga lango. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.7",
            "verseOrgIds": [
              "JOS.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena kabla hawajalala akawaendea juu darini, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.8",
            "verseOrgIds": [
              "JOS.2.8"
            ]
