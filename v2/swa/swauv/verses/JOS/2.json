        {
          "text": "Basi sasa, nawasihi, niapieni kwa BWANA, kwa kuwa nimewatendea ihisani, ya kwamba ninyi nanyi mtaitendea ihisani nyumba ya baba yangu; tena nipeni alama ya uaminifu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.12",
            "verseOrgIds": [
              "JOS.2.12"
            ]
          }
        },
