              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya kwamba mtawaponya hai baba yangu na mama yangu, na ndugu zangu wanaume na wanawake, na vitu vyote walivyo navyo, na kutuokoa roho zetu na kufa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.13",
            "verseOrgIds": [
