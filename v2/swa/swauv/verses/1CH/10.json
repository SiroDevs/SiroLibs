                {
                  "text": "15:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "asiulize kwa BWANA; kwa hiyo akamwua, na ufalme akamgeuzia Daudi, mwana wa Yese.",
