                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.13.5"
              },
              "items": [
                {
                  "text": "13:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.1"
              },
              "items": [
                {
                  "text": "31:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Wafilisti wakapigana juu ya Israeli; nao watu wa Israeli wakakimbia mbele ya Wafilisti, wakaanguka wameuawa katika mlima Gilboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.1",
            "verseOrgIds": [
              "1CH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Wafilisti wakamfuatia sana Sauli na wanawe; Wafilisti wakawaua Yonathani, na Abinadabu, na Malkishua, wana wa Sauli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.2",
            "verseOrgIds": [
              "1CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena vita vilikuwa vikali sana juu ya Sauli, na wapiga upinde wakampata; hata akafadhaika sana kwa sababu ya wapiga upinde. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.3",
            "verseOrgIds": [
              "1CH.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.16.21"
              },
              "items": [
                {
                  "text": "Amu 16:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo Sauli akamwambia yule mchukua silaha zake, Futa upanga wako, unichome nao, wasije watu hawa wasiotahiriwa wakanisimanga. Lakini huyo mchukua silaha zake akakataa; kwa sababu aliogopa sana. Basi Sauli akautwaa upanga wake, akauangukia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.4",
            "verseOrgIds": [
              "1CH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mchukua silaha zake alipoona ya kuwa Sauli amekufa, yeye naye akauangukia upanga wake, akafa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.5",
            "verseOrgIds": [
              "1CH.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Sauli akafa, na wanawe watatu; na nyumba yake yote wakafa pamoja. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.6",
            "verseOrgIds": [
              "1CH.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha watu wote wa Israeli, waliokuwa huko bondeni, walipoona ya kuwa wamekimbia, na ya kuwa Sauli na wanawe wamekufa, wakaiacha miji yao, wakakimbia; nao Wafilisti wakaenda wakakaa humo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.7",
            "verseOrgIds": [
              "1CH.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.7",
            "verseOrgIds": [
              "1CH.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata ikawa siku ya pili yake Wafilisti walipokwenda kuwateka nyara hao waliouawa, walimwona Sauli na wanawe wameanguka juu ya mlima Gilboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.8",
            "verseOrgIds": [
              "1CH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamvua mavazi, wakamtwalia kichwa, na silaha zake, kisha wakapeleka wajumbe kwenda nchi ya Wafilisti pande zote, ili kutangaza habari kwa sanamu zao, na kwa watu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.9",
            "verseOrgIds": [
              "1CH.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.10"
              },
              "items": [
                {
                  "text": "1 Sam 31:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.48.5"
              },
              "items": [
                {
                  "text": "Isa 48:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakaziweka silaha zake nyumbani mwa miungu yao, wakakikaza kichwa chake nyumbani mwa Dagoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.10",
            "verseOrgIds": [
              "1CH.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na watu wote wa Yabesh-gileadi waliposikia hayo yote Wafilisti waliyomtenda Sauli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.11",
            "verseOrgIds": [
              "1CH.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakainuka mashujaa wote, wakautwaa mwili wake Sauli, na miili ya wanawe, wakaileta Yabeshi, wakaizika mifupa yao chini ya mwaloni huko Yabeshi, nao wakafunga muda wa siku saba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.12",
            "verseOrgIds": [
              "1CH.10.12"
            ]
          }
        },
