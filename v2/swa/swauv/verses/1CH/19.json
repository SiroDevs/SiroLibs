                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.15.2"
              },
              "items": [
                {
                  "text": "Isa 15:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi wakajiajiria magari thelathini na mbili elfu, na mfalme wa Maaka na watu wake; nao walikuja wakatua mbele ya Medeba. Na wana wa Amoni wakakusanyika kutoka miji yao, wakaja vitani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.7",
            "verseOrgIds": [
              "1CH.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Daudi aliposikia habari akamtuma Yoabu, na jeshi lote la mashujaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.8",
            "verseOrgIds": [
              "1CH.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.11.1"
              },
              "items": [
                {
                  "text": "2 Sam 11:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakatoka wana wa Amoni, wakapanga vita langoni pa mji; na hao wafalme waliokuja walikuwa peke yao uwandani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.9",
            "verseOrgIds": [
              "1CH.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yoabu alipoona ya kwamba uso wa vita umekuwa juu yake mbele na nyuma, akachagua baadhi ya wateule wote wa Israeli, akawapanga juu ya Washami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.10",
            "verseOrgIds": [
              "1CH.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hao watu waliosalia akawatia mikononi mwa Abishai, nduguye, nao wakajipanga juu ya wana wa Amoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.11",
            "verseOrgIds": [
              "1CH.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasema, Wakiwa Washami ni hodari mno kwangu, ndipo wewe utanisaidia; lakini wana wa Amoni wakiwa ni hodari mno kwako, ndipo mimi nitakusaidia wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.12",
            "verseOrgIds": [
              "1CH.19.12"
            ]
          }
        },
