              "attrs": {
                "loc": "1KI.16.34"
              },
              "items": [
                {
                  "text": "1 Fal 16:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakaenda watu wakamwambia Daudi jinsi walivyotendewa wale watu. Naye akatuma watu kuwalaki; kwa sababu watu hao walikuwa wametahayarika sana. Mfalme akasema, Ngojeni Yeriko, hata mtakapoota ndevu zenu, ndipo mrudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.5",
            "verseOrgIds": [
              "1CH.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 19:6"
          },
          "items": [
