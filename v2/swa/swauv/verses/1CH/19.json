                }
              ]
            }
          ]
        },
        {
          "text": "Uwe hodari, tukajitie moyo mkuu kwa ajili ya watu wetu, na kwa ajili ya miji ya Mungu wetu; naye BWANA afanye yaliyo mema machoni pake. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.13",
            "verseOrgIds": [
              "1CH.19.13"
            ]
          }
        },
        {
