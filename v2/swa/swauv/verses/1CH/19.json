                  "text": "Kum 28:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Yoabu, na watu waliokuwa pamoja naye, wakakaribia kupigana na Washami; nao wakakimbia mbele yake. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.14",
            "verseOrgIds": [
              "1CH.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wana wa Amoni walipoona ya kwamba Washami wamekimbia, wakakimbia nao mbele ya Abishai, nduguye, wakaingia mjini. Ndipo Yoabu akaja Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.15",
            "verseOrgIds": [
              "1CH.19.15"
            ]
          }
        }
      ]
