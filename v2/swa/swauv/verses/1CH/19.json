            }
          ]
        },
        {
          "text": "Na wana wa Amoni walipoona ya kuwa wamekuwa machukizo kwa Daudi, Hanuni na wana wa Amoni wakapeleka talanta elfu za fedha ili kujiajiria magari na wapanda farasi kutoka Mesopotamia, na kutoka Atam-maaka, na kutoka Soba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.6",
            "verseOrgIds": [
              "1CH.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.30"
              },
              "items": [
                {
                  "text": "Hes 21:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.9"
              },
              "items": [
                {
                  "text": "Yos 13:9",
