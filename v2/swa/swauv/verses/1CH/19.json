              },
              "items": [
                {
                  "text": "2 Sam 10:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Washami walipojiona kuwa wameshindwa mbele ya Israeli, wakapeleka wajumbe, wakawavuta Washami walioko ng’ambo ya Mto, na Shobaki, jemadari wa jeshi la Hadadezeri, akawaongoza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.16",
            "verseOrgIds": [
              "1CH.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipoambiwa Daudi; akakusanya Israeli wote, akavuka Yordani, akawajia, akapanga vita juu yao. Basi Daudi alipopanga vita juu ya Washami, wakapigana naye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.17",
            "verseOrgIds": [
              "1CH.19.17"
            ]
          }
