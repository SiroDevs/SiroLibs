                }
              ]
            }
          ]
        },
        {
          "text": "Akaweka ngome katika Edomu; na Waedomi wote wakawa watumwa wa Daudi. Naye BWANA akampa Daudi kushinda, kila alikokwenda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
