            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.21.31"
              },
              "items": [
                {
                  "text": "Mit 21:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo Daudi akaweka ngome katika Shamu ya Dameski; nao Washami wakawa watumwa wa Daudi, wakaleta zawadi. Naye BWANA akampa Daudi kushinda kila alikokwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.6",
            "verseOrgIds": [
              "1CH.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena Daudi akazitwaa ngao za dhahabu zilizovaliwa na watumishi wa Hadadezeri akazileta Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.7",
            "verseOrgIds": [
              "1CH.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
