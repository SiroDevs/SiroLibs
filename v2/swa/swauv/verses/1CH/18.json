                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.12+2CH.4.13+2CH.4.14+2CH.4.15+2CH.4.16"
              },
              "items": [
                {
                  "text": "2 Nya 4:12-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena toka Tibhathi, na toka Berothai, miji ya Hadadezeri, Daudi akatwaa shaba nyingi mno, aliyofanyizia Sulemani ile bahari ya shaba, na zile nguzo, na vile vyombo vya shaba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.8",
            "verseOrgIds": [
              "1CH.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.9"
              },
              "items": [
                {
                  "text": "2 Sam 8:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hata aliposikia Tou, mfalme wa Hamathi, ya kuwa Daudi amewapiga jeshi lote la Hadadezeri, mfalme wa Soba, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.9",
            "verseOrgIds": [
              "1CH.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.10"
              },
              "items": [
                {
                  "text": "2 Sam 8:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akampeleka mwanawe Hadoramu kwa mfalme Daudi, ili kumsalimia, na kumbarikia, kwa sababu alikuwa amepigana na Hadadezeri, na kumpiga; kwa maana Hadadezeri alikuwa amepigana vita juu ya Tou; naye akaleta vyombo vya dhahabu, na fedha, na shaba, vya namna zote. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.10",
            "verseOrgIds": [
              "1CH.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivi pia mfalme Daudi akavifanya wakfu kwa BWANA, pamoja na hiyo fedha na dhahabu, aliyoteka nyara kwa mataifa yote; kwa Edomu, na kwa Moabu, na kwa wana wa Amoni, na kwa Wafilisti, na kwa Amaleki. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.11",
            "verseOrgIds": [
              "1CH.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.13"
              },
              "items": [
                {
                  "text": "2 Sam 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.7"
