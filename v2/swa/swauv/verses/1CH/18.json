              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa baadaye, Daudi akawapiga Wafilisti, akawashinda, akautwaa Gathi na vijiji vyake mikononi mwa Wafilisti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.1",
            "verseOrgIds": [
              "1CH.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.24.17"
              },
              "items": [
                {
                  "text": "Hes 24:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akapiga Moabu; na hao Wamoabi wakawa watumwa wa Daudi wakaleta zawadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.2",
            "verseOrgIds": [
              "1CH.18.2"
            ]
          }
        },
        {
          "name": "verse",
