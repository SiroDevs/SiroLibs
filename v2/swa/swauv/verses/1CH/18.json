                "loc": "2CH.25.11"
              },
              "items": [
                {
                  "text": "2 Nya 25:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena Abishai, mwana wa Seruya, akawapiga wa Waedomi katika Bonde la Chumvi watu kumi na nane elfu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
            "verseOrgIds": [
              "1CH.18.12"
            ]
          }
        },
