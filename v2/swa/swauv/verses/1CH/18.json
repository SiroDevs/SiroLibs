              },
              "items": [
                {
                  "text": "Kum 11:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena Daudi akampiga Hadadezeri, mfalme wa Soba, mpaka Hamathi, alipokwenda kujisimamishia mamlaka yake kwenye mto wa Frati. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.3",
            "verseOrgIds": [
              "1CH.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.4"
              },
              "items": [
                {
                  "text": "2 Sam 8:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi akampokonya magari elfu, na wapanda farasi saba elfu, na askari waendao kwa miguu ishirini elfu; Daudi akawakata mshipa farasi wote wa magari, ila wa magari mia akawaweka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.4",
            "verseOrgIds": [
              "1CH.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Washami wa Dameski walipokuja wamsaidie Hadadezeri, mfalme wa Soba, Daudi akapiga katika hao Washami watu ishirini na mbili elfu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.5",
            "verseOrgIds": [
              "1CH.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.17.8"
              },
              "items": [
                {
                  "text": "1 Nya 17:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.91.14"
              },
              "items": [
                {
                  "text": "Zab 91:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
