                }
              ]
            }
          ]
        },
        {
          "text": "Na wana wa Mika; Pithoni, na Meleki, na Tarea, na Ahazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.35",
            "verseOrgIds": [
