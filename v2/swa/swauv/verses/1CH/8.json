              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ahazi akamzaa Yara; na Yara akamzaa Alemethi, na Azmawethi, na Zimri; na Zimri akamzaa Mosa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.36",
