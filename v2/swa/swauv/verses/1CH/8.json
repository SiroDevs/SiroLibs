              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Mosa akamzaa Binea; na mwanawe huyo alikuwa Refaya, na mwanawe huyo ni Ekasa, na mwanawe huyo ni Aseli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.37",
