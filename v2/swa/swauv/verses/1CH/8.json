            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi huko Gibea alikaa babaye Gibea, jina lake Yeieli, ambaye jina la mkewe aliitwa Maaka; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.29",
            "verseOrgIds": [
              "1CH.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mwanawe, mzaliwa wake wa kwanza, alikuwa Abdoni, na Suri, na Kishi, na Baali,",
          "type": "text",
          "attrs": {
