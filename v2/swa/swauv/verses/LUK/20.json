              "LUK.20.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.54"
              },
              "items": [
                {
                  "text": "Lk 11:54",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamvizia-vizia, wakatuma wapelelezi waliojifanya kuwa watu wa haki, ili wamnase katika maneno yake, wapate kumtia katika enzi na mamlaka ya liwali. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.20",
            "verseOrgIds": [
              "LUK.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamwuliza, wakisema, Mwalimu, twajua ya kwamba wasema na kufundisha yaliyo ya haki, wala hujali cheo cha mtu, bali unafundisha njia ya Mungu kwa kweli. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.21",
            "verseOrgIds": [
              "LUK.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Ni halali tumpe Kaisari kodi, au sivyo? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.22",
            "verseOrgIds": [
              "LUK.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini yeye alitambua hila yao, akawaambia, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.23",
            "verseOrgIds": [
              "LUK.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nionyesheni dinari. Ina sura na anwani ya nani? Wakamjibu, Ya Kaisari. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.24",
