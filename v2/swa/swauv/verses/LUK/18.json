                "loc": "LUK.9.44"
              },
              "items": [
                {
                  "text": "44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akawachukua wale Thenashara, akawaambia, Tazameni, tunapanda kwenda Yerusalemu, na mambo yote yatatimizwa, Mwana wa Adamu aliyoandikiwa na manabii. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.31",
            "verseOrgIds": [
              "LUK.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa atatiwa mikononi mwa Mataifa, atafanyiwa dhihaka; atatendwa jeuri, na kutemewa mate; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.32",
            "verseOrgIds": [
              "LUK.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao watampiga mijeledi, kisha watamwua; na siku ya tatu atafufuka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.33",
            "verseOrgIds": [
              "LUK.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.32"
              },
              "items": [
                {
                  "text": "Mk 9:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Walakini hawakuelewa maneno hayo hata kidogo, na jambo hilo lilikuwa limefichwa kwao, wala hawakufahamu yaliyonenwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.34",
            "verseOrgIds": [
              "LUK.18.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Amponya Mwombaji Kipofu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
