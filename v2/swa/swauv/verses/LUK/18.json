                  "text": "Mk 10:13-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakamletea na watoto wachanga ili awaguse; lakini wanafunzi walipoona waliwakemea. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.15",
            "verseOrgIds": [
              "LUK.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali Yesu akawaita waje kwake, akasema, Waacheni watoto wadogo waje kwangu, wala msiwazuie, kwa kuwa watu kama hao ufalme wa Mungu ni wao. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.16",
            "verseOrgIds": [
              "LUK.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.3"
              },
              "items": [
                {
                  "text": "Mt 18:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amin, nawaambia, Mtu ye yote asiyeupokea ufalme wa Mungu kama mtoto mdogo hauingii kamwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.17",
            "verseOrgIds": [
              "LUK.18.17"
            ]
          }
        }
      ]
    },
