            "number": "18",
            "style": "v",
            "sid": "ISA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fedha utakayopata itawekwa wakfu kwa Mwenyezi-Mungu. Mji wenyewe hautafaidika kwa fedha hiyo ila wale wanaomwabudu Mwenyezi-Mungu wataitumia kununulia chakula kingi na mavazi mazuri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.18",
            "verseOrgIds": [
              "ISA.23.18"
            ]
