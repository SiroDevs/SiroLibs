            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya miaka hiyo sabini, Mwenyezi-Mungu atauadhibu mji wa Tiro, nao utarudia kufanya uzinzi kwa kujiuza kwa mataifa yote ya dunia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
              "ISA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
