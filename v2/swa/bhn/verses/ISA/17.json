          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku hiyo miji yao imara itaachwa mahame, kama miji ambayo Wahivi na Waamori",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:9",
              "type": "text"
            },
            {
              "text": "Waamori:",
              "type": "text"
            },
            {
              "text": "Kadiri ya Septuaginta; Kiebrania: Kama magofu ya msitu na kilele cha mlima.",
              "type": "text"
            }
          ]
        },
        {
          "text": " waliihama walipokuwa wakiwakimbia wazawa wa Israeli. Kila kitu kitakuwa uharibifu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        }
      ]
