              "type": "text"
            }
          ]
        },
        {
          "text": "“Siku hiyo, fahari ya Yakobo itaporomoshwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.4",
            "verseOrgIds": [
              "ISA.17.4"
            ]
