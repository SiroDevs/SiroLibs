          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe Israeli, wakati Mwenyezi-Mungu atakapokufariji baada ya mateso, misukosuko na utumwa uliofanyiwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.3",
            "verseOrgIds": [
              "ISA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "utaimba utenzi huu wa kumdhihaki mfalme wa Babuloni:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.4",
            "verseOrgIds": [
              "ISA.14.4"
            ]
          }
        }
      ]
    },
    {
