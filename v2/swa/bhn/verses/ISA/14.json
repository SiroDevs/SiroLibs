        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu wa majeshi asema hivi: “Nitaushambulia mji wa Babuloni na kuuangamiza kabisa. Nitaharibu kila kitu, mji wote, watoto na yeyote aliyebaki hai. Mimi Mwenyezi-Mungu nimenena. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.22",
            "verseOrgIds": [
              "ISA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitaufanya kuwa makao ya nungunungu, na utakuwa madimbwi ya maji. Nami nitaufagilia mbali kwa ufagio wa maangamizi. Mimi Mwenyezi-Mungu wa majeshi nimenena.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.23",
            "verseOrgIds": [
              "ISA.14.23"
            ]
          }
        }
      ]
    },
