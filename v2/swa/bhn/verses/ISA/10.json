          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adui amepanda kutoka Rimoni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.27",
            "verseOrgIds": [
              "ISA.10.27"
            ]
          }
        }
      ]
