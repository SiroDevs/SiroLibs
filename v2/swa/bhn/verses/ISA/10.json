              "ISA.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati Mwenyezi-Mungu atakapomaliza kazi zake zote mlimani Siyoni na mjini Yerusalemu, atamwadhibu mfalme wa Ashuru, kwa sababu ya majivuno na kiburi chake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.12",
            "verseOrgIds": [
              "ISA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.19",
            "verseOrgIds": [
              "ISA.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ile wazawa wa Yakobo watakaobaki, naam, Waisraeli watakaosalia hawatalitegemea tena taifa lililowaadhibu, bali watamtegemea kabisa Mwenyezi-Mungu, Mtakatifu wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.20",
            "verseOrgIds": [
              "ISA.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wazawa wa Yakobo wachache watakaobaki watamrudia Mungu Mkuu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.21",
            "verseOrgIds": [
              "ISA.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:22 Taz Roma 9:27",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maana, hata kama sasa Waisraeli ni wengi kama mchanga wa pwani, ni wachache tu watakaorudi. Maangamizi yamepangwa yafanyike, nayo yatafanyika kwa haki tupu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.22",
            "verseOrgIds": [
              "ISA.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naam! Bwana, Mwenyezi-Mungu wa majeshi, atakamilisha kabisa katika nchi yote jambo aliloamua kutenda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.23",
            "verseOrgIds": [
              "ISA.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.23",
            "verseOrgIds": [
              "ISA.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo, Bwana Mwenyezi-Mungu wa majeshi asema hivi: “Enyi watu wangu mnaokaa Siyoni msiwaogope Waashuru ambao wanawapiga kwa fimbo, wakiinua mikongojo yao dhidi yenu kama walivyofanya Wamisri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.24",
            "verseOrgIds": [
              "ISA.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana bado kitambo, nayo hasira yangu itapita na ghadhabu yangu itawageukia Waashuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.25",
            "verseOrgIds": [
              "ISA.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi Mwenyezi-Mungu wa majeshi na nitawachapa kama nilivyowachapa Wamidiani kwenye jabali la Orebu. Nitanyosha fimbo yangu juu ya bahari kuwachapa kama nilivyowafanya Wamisri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.26",
            "verseOrgIds": [
              "ISA.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo, mzigo waliowabebesha nitauondoa na nira waliyowatia shingoni mwenu itavunjwa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.27",
            "verseOrgIds": [
              "ISA.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
