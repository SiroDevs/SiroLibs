          },
          "items": [
            {
              "text": "27:1 Taz Yobu 41:1; Zab 74:14; 104:26",
              "type": "text"
            }
          ]
        },
        {
          "text": " Siku hiyo, Mwenyezi-Mungu atautwaa upanga wake mkubwa, mkali na imara, na kuliadhibu dude Lewiyathani",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:1",
              "type": "text"
            },
            {
              "text": "Lewiyathani:",
              "type": "text"
            },
            {
              "text": "Joka la kutisha katika hadithi za kale, hapa latumiwa kutajia mataifa yaliyokandamiza Israeli.",
              "type": "text"
            }
          ]
        },
        {
          "text": " joka lirukalo na danganyifu; Mwenyezi-Mungu ataliua joka liishilo baharini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
