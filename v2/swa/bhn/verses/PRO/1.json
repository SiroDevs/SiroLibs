          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanangu, sikiliza mwongozo wa baba yako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.8",
            "verseOrgIds": [
              "PRO.1.8"
