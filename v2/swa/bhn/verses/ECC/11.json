          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ondoa mahangaiko moyoni mwako, jikinge, usipate maumivu mwilini kwa sababu ujana na mwisho wa maisha ni bure kabisa.",
          "type": "text",
          "attrs": {
