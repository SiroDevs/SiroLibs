              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkumbuke Muumba wako siku za ujana wako,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        }
