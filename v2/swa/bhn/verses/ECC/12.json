            "style": "v",
            "sid": "ECC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.12",
            "verseOrgIds": [
              "ECC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya hayo yote yaliyokwisha semwa bado kuna hili linalotakiwa: Mche Mungu, na uzishike amri zake; kwa sababu hilo ndilo jukumu aliloumbiwa binadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.13",
            "verseOrgIds": [
              "ECC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana, Mungu atahukumu matendo yetu yote, hata yale yanayotendwa kwa siri, yawe mema au mabaya.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.14",
            "verseOrgIds": [
              "ECC.12.14"
            ]
          }
        }
      ]
    }
