          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu mwenyewe anayetupatia amani awatakase nyinyi kabisa kwa kila namna na kuzilinda nafsi zenu – roho, mioyo na miili yenu – mbali na hatia yoyote wakati wa kuja kwake Bwana wetu Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.23",
            "verseOrgIds": [
              "1TH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye anayewaita nyinyi atafanya hivyo kwani ni mwaminifu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.24",
            "verseOrgIds": [
              "1TH.5.24"
            ]
          }
        }
      ]
    },
