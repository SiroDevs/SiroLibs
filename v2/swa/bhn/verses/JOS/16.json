      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sehemu waliyogawiwa wazawa wa Yosefu kwa kura ilianzia karibu na mto Yordani, mashariki ya chemchemi ya Yeriko, na kupitia jangwani, hadi kwenye sehemu za milima mpaka Betheli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.1",
            "verseOrgIds": [
              "JOS.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka Betheli mpaka ulielekea Luzu ukapita Atarothi ambako waliishi Waarki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.2",
            "verseOrgIds": [
              "JOS.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha ukashuka magharibi katika nchi ya Wayafleti hadi Beth-horoni ya Chini na Gezeri na kuishia kwenye bahari ya Mediteranea. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.3",
            "verseOrgIds": [
              "JOS.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wazawa wa Yosefu, yaani kabila la Manase na kabila la Efraimu, walipewa nchi hiyo kuwa milki yao.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.4",
            "verseOrgIds": [
              "JOS.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.4",
            "verseOrgIds": [
              "JOS.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa kabila la Efraimu kulingana na jamaa zao walipata sehemu yao ambayo mpaka wake upande wa mashariki ulipita Ataroth-adari hadi Beth-horoni ya Juu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.5",
            "verseOrgIds": [
              "JOS.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuishia bahari ya Mediteranea. Kwa upande wa kaskazini mpaka ulipita Mikmethathi na kwa mashariki yake ulizunguka na kuelekea Taanath-shilo ambako ulipita upande wa mashariki hadi Yanoa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.6",
            "verseOrgIds": [
              "JOS.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka Yanoa ulikwenda hadi Atarothi na Naara, hata kufika Yeriko, ambako uliishia katika mto Yordani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.7",
            "verseOrgIds": [
              "JOS.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka Tapua, mpaka ulikwenda magharibi hadi kijito cha Kana na kuishia bahari ya Mediteranea. Hii ndiyo nchi waliyopewa watu wa kabila la Efraimu kulingana na jamaa zao, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.8",
            "verseOrgIds": [
              "JOS.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamoja na miji na vijiji ambavyo waliongezewa kutoka kwenye nchi ya kabila la Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.9",
            "verseOrgIds": [
              "JOS.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Amu 1:29",
              "type": "text"
            }
          ]
        },
        {
          "text": " Waefraimu hawakuwafukuza Wakanaani walioishi Gezeri. Wakanaani hao waliendelea kukaa miongoni mwa watu wa Efraimu mpaka leo, wakiwa watumwa wa kuwafanyia kazi za kulazimishwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.10",
            "verseOrgIds": [
              "JOS.16.10"
            ]
          }
        }
      ]
    }
