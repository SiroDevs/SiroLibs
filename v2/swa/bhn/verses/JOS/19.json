          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eneo la nchi yao lilikuwa na miji ya Sora, Eshtaoli, Ir-shemeshi ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.41",
            "verseOrgIds": [
              "JOS.19.41"
            ]
          }
        },
