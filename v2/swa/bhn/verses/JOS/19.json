            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kura ya saba ilizipata koo za kabila la Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.40",
            "verseOrgIds": [
              "JOS.19.40"
            ]
          }
