          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipomaliza kugawiana sehemu zote za nchi, Waisraeli walimpa Yoshua, mwana wa Nuni, sehemu yake katikati yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
            "verseOrgIds": [
              "JOS.19.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulingana na amri ya Mwenyezi-Mungu walimpa mji ambao aliuchagua yeye mwenyewe, yaani Timnath-sera, ambao ulikuwa katika nchi ya milima ya Efraimu. Naye Yoshua akaujenga upya mji huo na kukaa humo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        }
      ]
    },
