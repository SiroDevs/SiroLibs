      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.40",
            "verseOrgIds": [
              "JOS.21.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 21:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jumla ya miji yote ambayo Walawi walipewa katika maeneo ya Waisraeli ilikuwa arubaini na minane pamoja na mbuga zao za malisho. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.41",
            "verseOrgIds": [
              "JOS.21.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila mmoja kati ya miji hii ulizungukwa na mbuga za malisho.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.42",
            "verseOrgIds": [
              "JOS.21.42"
            ]
          }
        }
      ]
    },
    {
