          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miji ya nyikani ilikuwa Beth-araba, Midini, Sekaka, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.61",
            "verseOrgIds": [
              "JOS.15.61"
            ]
          }
        },
