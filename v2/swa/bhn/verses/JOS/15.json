          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "JOS 15:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibshani, Mji wa Chumvi na Engedi. Jumla ya miji waliyopewa ni sita pamoja na vijiji vyake.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.62",
            "verseOrgIds": [
              "JOS.15.62"
            ]
          }
        }
