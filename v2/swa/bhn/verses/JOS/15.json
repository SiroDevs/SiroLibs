          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipewa pia miji ya Senani, Hadasha, Migdal-gadi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.37",
            "verseOrgIds": [
              "JOS.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dileani, Mizpa, Yoktheeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.38",
            "verseOrgIds": [
              "JOS.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakishi, Boskathi, Egloni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.39",
            "verseOrgIds": [
              "JOS.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaboni, Lahmamu, Kithlishi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.40",
            "verseOrgIds": [
              "JOS.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gederothi, Beth-dagoni, Naama na Makeda. Jumla ya miji waliyopewa ni kumi na sita pamoja na vijiji vyake. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.41",
            "verseOrgIds": [
              "JOS.15.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 15:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena walipewa miji ya Libna, Etheri, Ashani, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.42",
            "verseOrgIds": [
              "JOS.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yifta, Ashna, Nezibu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.43",
            "verseOrgIds": [
              "JOS.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keila, Akzibu na Maresha. Jumla ya miji waliyopewa ni tisa pamoja na vijiji vyake. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.44",
            "verseOrgIds": [
              "JOS.15.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vilevile walipewa Ekroni pamoja na miji yake midogo na vijiji, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.45",
            "verseOrgIds": [
              "JOS.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "miji yote na vijiji vilivyokuwa karibu na Ashdodi kati ya Ekroni na bahari, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.46",
            "verseOrgIds": [
              "JOS.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashdodi na Gaza pamoja na miji na vijiji vyake, mpaka kijito cha Misri hadi pwani ya bahari ya Mediteranea.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.47",
            "verseOrgIds": [
              "JOS.15.47"
            ]
          }
        }
      ]
