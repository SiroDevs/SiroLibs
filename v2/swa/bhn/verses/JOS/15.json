          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miji iliyokuwa kwenye eneo la milimani ni Shamiri, Yatiri, Soko, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.48",
            "verseOrgIds": [
              "JOS.15.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JOS 15:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dana, Kiriath-sana (yaani Debiri), ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.49",
            "verseOrgIds": [
              "JOS.15.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 15:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anabu, Eshtemoa, Animu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.50",
            "verseOrgIds": [
              "JOS.15.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 15:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosheni, Holoni na Gilo. Jumla ya miji waliyopewa ni kumi na mmoja pamoja na vijiji vyake. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.51",
            "verseOrgIds": [
              "JOS.15.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JOS 15:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipewa pia miji ya Arabu, Duma, Eshani, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.52",
            "verseOrgIds": [
              "JOS.15.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JOS 15:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yanimu, Beth-tapua, Afeka, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.53",
            "verseOrgIds": [
              "JOS.15.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JOS 15:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Humta, Kiriath-arba (yaani Hebroni) na Siori. Jumla ya miji waliyopewa ni tisa pamoja na vijiji vyake. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.54",
            "verseOrgIds": [
              "JOS.15.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JOS 15:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia walipewa miji ya Maoni, Karmeli, Zifu, Yuta, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.55",
            "verseOrgIds": [
              "JOS.15.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JOS 15:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yezreeli, Yokdeamu, Zanoa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.56",
            "verseOrgIds": [
              "JOS.15.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JOS 15:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaini, Gibea na Timna. Jumla ya miji waliyopewa ni kumi pamoja na vijiji vyake. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.57",
            "verseOrgIds": [
              "JOS.15.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JOS 15:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vilevile miji ya Halhuli, Beth-suri, Gedori, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.58",
            "verseOrgIds": [
              "JOS.15.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JOS 15:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maarathi, Beth-anothi na Eltekoni. Jumla ya miji waliyopewa ni sita pamoja na vijiji vyake. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.59",
            "verseOrgIds": [
              "JOS.15.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "JOS 15:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadhalika walipewa Kiriath-baali, uitwao pia Kiriath-yearimu, na Raba. Jumla ya miji waliyopewa ni miwili pamoja na vijiji vyake.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.60",
            "verseOrgIds": [
              "JOS.15.60"
            ]
          }
        }
      ]
