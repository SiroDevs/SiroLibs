          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waisraeli walimtumikia Mwenyezi-Mungu muda wote wa uhai wa Yoshua, na baada ya kifo chake, waliendelea kumtumikia kwa muda walioishi wale wazee waliokuwa wameona kwa macho yao mambo yale Mwenyezi-Mungu aliyowatendea Waisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        }
