              "type": "text"
            }
          ]
        },
        {
          "text": "“Kama sadaka yake ni mbuzi, basi, atamtolea mbele ya Mwenyezi-Mungu ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.12",
            "verseOrgIds": [
              "LEV.3.12"
