          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "akiweka mkono wake juu ya kichwa cha mnyama huyo na kumchinja mbele ya hema la mkutano. Wazawa wa Aroni watainyunyizia madhabahu damu yake pande zake zote. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.13",
            "verseOrgIds": [
              "LEV.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
