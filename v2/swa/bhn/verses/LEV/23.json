            "style": "v",
            "sid": "LEV 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.8",
            "verseOrgIds": [
              "LEV.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu alimwambia Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.9",
            "verseOrgIds": [
              "LEV.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Waambie Waisraeli hivi: Mtakapoingia katika nchi ambayo ninawapeni mkavuna mazao yake, mtamletea kuhani mganda wa mavuno ya kwanza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.10",
            "verseOrgIds": [
              "LEV.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhani atafanya nayo ishara ya kunitolea siku inayofuata siku ya Sabato ili mpate kukubaliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.11",
            "verseOrgIds": [
              "LEV.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku hiyo mnapofanya ishara ya kutoa huo mganda mbele yangu mtanitolea mimi Mwenyezi-Mungu sadaka ya kuteketezwa ya mwanakondoo dume wa mwaka mmoja asiye na dosari. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.12",
            "verseOrgIds": [
              "LEV.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamoja na sadaka hiyo, mtatoa sadaka ya nafaka ya kilo mbili za unga laini uliochanganywa na mafuta ambayo mtanitolea mimi Mwenyezi-Mungu kwa moto, na harufu yake itanipendeza. Sadaka yake ya kinywaji ni lita moja ya divai. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.13",
            "verseOrgIds": [
              "LEV.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabla ya siku hiyo ya kuniletea mimi Mungu wenu sadaka hiyo, hamruhusiwi kula mazao ya kwanza ya mavuno yenu, yawe mabichi, yamekaangwa au yemeokwa kuwa mikate. Hili ni sharti la kufuata milele katika vizazi vyenu mahali popote mtakapoishi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.14",
            "verseOrgIds": [
              "LEV.23.14"
            ]
          }
        }
      ]
    },
