        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Lawi 19:9-10; Kumb 24:19-20",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Unapovuna mavuno yako shambani, kamwe usivune kabisa hadi mpakani mwa shamba lako wala usirudi nyuma kukusanya masalio. Utawaachia hayo maskini na wageni. Mimi ndimi Mwenyezi-Mungu, Mungu wenu.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
            "verseOrgIds": [
              "LEV.23.22"
            ]
          }
        }
      ]
