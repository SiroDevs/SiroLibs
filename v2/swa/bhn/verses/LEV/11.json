              "LEV.11.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyo basi, ndiyo sheria kuhusu wanyama, ndege na viumbe vyote hai ambavyo huishi majini na nchi kavu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili kupambanua kati ya kisicho najisi na kilicho najisi; kinachoweza kuliwa na kisichoweza kuliwa.",
          "type": "text",
          "attrs": {
