        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Lawi 3:1-11",
              "type": "text"
            }
          ]
        },
        {
          "text": " Halafu Aroni akamchinja pia fahali na yule kondoo dume wa sadaka za amani kwa ajili ya watu. Wanawe wakamletea damu ambayo aliinyunyizia madhabahu pande zote. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.18",
            "verseOrgIds": [
              "LEV.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuta ya fahali huyo na kondoo dume, mkia wa kondoo, mafuta yaliyofunika matumbo, figo na sehemu bora ya ini ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.19",
            "verseOrgIds": [
              "LEV.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakayaweka juu ya vidari, naye akaviteketeza kwenye madhabahu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.20",
            "verseOrgIds": [
              "LEV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini vile vidari na ule mguu wa nyuma wa kulia, Aroni alifanya navyo ishara ya kumtolea Mwenyezi-Mungu, kama Mose alivyoamuru.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        }
      ]
