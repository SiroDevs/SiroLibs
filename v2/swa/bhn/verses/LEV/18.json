        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Lawi 20:1-5",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kamwe usimtoe mtoto wako yeyote kuwa sadaka kwa mungu Moleki maana kufanya hivyo utalikufuru jina langu mimi Mungu wako. Mimi ndimi Mwenyezi-Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
              "LEV.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
