              "LEV.18.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Neh 9:29; Eze 18:9; 20:11-13; Luka 10:28; Roma 10:5; Gal 3:12",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kamwe usilale na mwanamke awapo mwezini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.19",
            "verseOrgIds": [
              "LEV.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Lawi 20:10",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kamwe usilale na mke wa jirani yako na hivyo kujitia mwenyewe najisi naye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.20",
            "verseOrgIds": [
              "LEV.18.20"
            ]
          }
        }
      ]
    },
