          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msilikufuru jina langu takatifu, kwani ni lazima niheshimiwe miongoni mwa watu wa Israeli. Mimi Mwenyezi-Mungu ndiye ninayewaweka wakfu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
        {
