              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwa hiyo mtazishika na kuzitekeleza amri zangu. Mimi ndimi Mwenyezi-Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
