            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Mwa 9:4; Lawi 7:26-27; 17:10-14; Kumb 12:16,23; 15:23; 18:10",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Msile nyama yoyote yenye damu. Msipige bao wala kufanya uchawi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.26",
            "verseOrgIds": [
              "LEV.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Lawi 2:5; Kumb 14;1",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nywele zenu msizikate pembeni wala kunyoa ndevu zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.27",
            "verseOrgIds": [
              "LEV.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msijitie alama zozote mwilini mwenu kwa ajili ya kuomboleza au kujikatakata mwilini au kujichanja chale. Mimi ndimi Mwenyezi-Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.28",
            "verseOrgIds": [
              "LEV.19.28"
            ]
          }
        }
