            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Kut 22:21; Kumb 24:14-18; 27:19",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Usikose kamwe kuamua kwa haki kuhusu vipimo vya urefu, uzito na ujazo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.35",
            "verseOrgIds": [
              "LEV.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni lazima mtumie mizani halali, na vipimo vilivyo halali. Mimi ndimi Mwenyezi-Mungu, Mungu wenu, niliyewatoa katika nchi ya Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni lazima kuyashika na kuyatekeleza masharti yangu na maagizo yangu. Mimi ndimi Mwenyezi-Mungu.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.37",
            "verseOrgIds": [
              "LEV.19.37"
            ]
          }
