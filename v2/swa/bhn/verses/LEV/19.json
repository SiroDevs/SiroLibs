            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kama kuna mgeni katika nchi yako usimtendee vibaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.33",
            "verseOrgIds": [
              "LEV.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huyo mgeni anayekaa nawe atakuwa kwako kama mwenyeji nawe utampenda kama unavyojipenda mwenyewe, kwa kuwa nawe ulikuwa mgeni katika nchi ya Misri. Mimi ndimi Mwenyezi-Mungu, Mungu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.34",
            "verseOrgIds": [
              "LEV.19.34"
            ]
          }
        }
      ]
    },
