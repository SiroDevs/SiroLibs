            "verseOrgIds": [
              "LEV.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uwapo mbele ya mzee ni lazima usimame ili kumpa heshima yake; nawe umche Mungu wako. Mimi ndimi Mwenyezi-Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.32",
            "verseOrgIds": [
              "LEV.19.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
