            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Kumb 18:11; 1Sam 28:3; 2Fal 23:4; Isa 8:19",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Msiwaendee waaguzi wa mizimu wala wachawi ili kuwaomba wawaagulie na hivyo mkajitia najisi. Mimi ndimi Mwenyezi-Mungu, Mungu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.31",
            "verseOrgIds": [
              "LEV.19.31"
            ]
          }
        }
