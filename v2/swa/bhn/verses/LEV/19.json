              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanamume huyo ataleta mbele ya hema la mkutano sadaka yake ya kondoo dume ya kuondoa hatia na kunitolea mimi Mwenyezi-Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.21",
            "verseOrgIds": [
              "LEV.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhani atamfanyia ibada ya upatanisho kwa kutumia kondoo huyo mbele ya Mwenyezi-Mungu kwa ajili ya dhambi aliyotenda; naye atasamehewa dhambi hiyo aliyotenda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.22",
            "verseOrgIds": [
              "LEV.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.22",
            "verseOrgIds": [
              "LEV.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mtakapofika katika nchi ya Kanaani na kupanda aina zote za miti ya matunda, matunda hayo hamtayala; hamtaruhusiwa kuyala kwa muda wa miaka mitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.23",
            "verseOrgIds": [
              "LEV.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnamo mwaka wa nne matunda yake yote yatakuwa matakatifu, yatatolewa kuwa sadaka ya sifa,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.24",
            "verseOrgIds": [
              "LEV.19.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:24",
              "type": "text"
            },
            {
              "text": "sifa:",
              "type": "text"
            },
            {
              "text": "Au shukrani.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwa Mwenyezi-Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.24",
            "verseOrgIds": [
              "LEV.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini matunda ya kuanzia mwaka wa tano hayo mnaweza kula, na mavuno yenu yataongezeka. Mimi ndimi Mwenyezi-Mungu, Mungu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.25",
            "verseOrgIds": [
              "LEV.19.25"
            ]
          }
        }
      ]
    },
