          },
          "items": [
            {
              "text": "Taz Kumb 23:17",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Usimchafue binti yako kwa kumfanya kahaba, nchi nzima isije ikaangukia katika ukahaba na hivyo kujaa uovu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.29",
            "verseOrgIds": [
