              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Mat 5:43",
              "type": "text"
            }
          ]
        },
        {
          "text": " Usijilipize kisasi au kuwa na kinyongo dhidi ya wazawa wa watu wako bali umpende jirani yako kama unavyojipenda wewe mwenyewe. Mimi ndimi Mwenyezi-Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.18",
