            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Kut 23:6-8; Kumb 16:19",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Unapotoa hukumu uamue kwa haki; usimpendelee maskini wala kumwogopa mwenye cheo. Bali ni lazima kumwamua jirani kwa haki. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.15",
            "verseOrgIds": [
              "LEV.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamwe usipitepite ukiwachongea watu wa jamaa yako. Usiyatie maisha ya jirani yako katika hatari ya kifo kwa maneno yako. Mimi ndimi Mwenyezi-Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        }
      ]
    },
