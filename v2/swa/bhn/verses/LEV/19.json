          "items": [
            {
              "text": "Taz Mat 18:15",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Usimwekee kisasi ndugu yako moyoni mwako, bali upatane daima na jirani yako ili usije ukatenda dhambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.17",
            "verseOrgIds": [
              "LEV.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
