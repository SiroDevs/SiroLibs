        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Kut 20:15-16; Kumb 5:19-20; Kut 20:7; Kumb 5:11; Mat 5:33",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Msiibe, msidanganye wala kuambiana uongo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.11",
            "verseOrgIds": [
              "LEV.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msiape uongo kwa jina langu hata kulikufuru jina la Mungu wenu. Mimi ndimi Mwenyezi-Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.12",
            "verseOrgIds": [
              "LEV.19.12"
            ]
          }
        }
      ]
    },
