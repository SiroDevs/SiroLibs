            "sid": "LEV 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwanamume akilala na mwanamke mtumwa ambaye ameposwa na mwanamume mwingine, lakini bado hajakombolewa wala kupewa uhuru, uchunguzi ufanywe. Lakini wasiuawe kwa sababu mwanamke huyo hakuwa bado huru. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.20",
            "verseOrgIds": [
              "LEV.19.20"
            ]
          }
        },
        {
