          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Maana kila mmoja atatiwa chumvi kwa moto. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.49",
            "verseOrgIds": [
              "MRK.9.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MRK 9:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chumvi ni nzuri, lakini ikipoteza ladha yake, itakolezwa na nini? Muwe na chumvi ndani yenu na kudumisha amani kati yenu.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.50",
            "verseOrgIds": [
              "MRK.9.50"
            ]
          }
        }
      ]
