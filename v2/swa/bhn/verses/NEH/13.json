          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmoja kati ya wana wa Yoyada, mwana wa kuhani mkuu Eliashibu, alioa binti Sanbalati kutoka mji wa Beth-horoni; kwa sababu hiyo nilimfukuza kutoka mbele yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
            "verseOrgIds": [
              "NEH.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, kumbuka jinsi watu walivyochafua ukuhani na agano la kikuhani na la Walawi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        }
      ]
    },
