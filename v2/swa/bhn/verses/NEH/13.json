              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niliwatakasa watu kutokana na chochote kilichokuwa cha kigeni. Nikatayarisha mwongozo kwa ajili ya makuhani na Walawi kuhusu kazi ya kila mmoja wao. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
              "NEH.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
