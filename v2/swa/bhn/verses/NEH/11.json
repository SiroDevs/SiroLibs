          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa kabila la Benyamini walikaa Geba, Mikmashi, Ai, Betheli na vijiji vinavyoizunguka. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.31",
            "verseOrgIds": [
              "NEH.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wengine walikaa Anathothi, Nobu, Anania, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.32",
            "verseOrgIds": [
              "NEH.11.32"
            ]
          }
        },
