          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazori, Rama, Gitaimu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.33",
            "verseOrgIds": [
              "NEH.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
