        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.27",
            "verseOrgIds": [
              "NEH.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisi sote watu wa Israeli, makuhani, Walawi, wangoja malango, waimbaji, watumishi wa hekalu na watu wote waliojitenga na mataifa jirani kufuata sheria ya Mungu pamoja na wake zao, wana wao na binti zao, wote wenye maarifa na fahamu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.28",
            "verseOrgIds": [
              "NEH.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "tunaungana na ndugu zetu, wakuu wetu, katika kula kiapo na kwamba tukivunja kiapo hiki tutaapizwa, na twaapa kuwa tutaishi kwa kufuata sheria ya Mungu ambayo aliitoa kwa njia ya Mose, mtumishi wake. Tena tutatii yote ambayo Mwenyezi-Mungu, Mungu wetu, anatuamuru, na kuwa tutashika maagizo yake na kufuata masharti yake. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.29",
            "verseOrgIds": [
              "NEH.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binti zetu hatutawaoza kwa watu wa nchi hii na wala wana wetu hawataoa kwao. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
            "verseOrgIds": [
              "NEH.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiwa watu hao wanaleta bidhaa au nafaka kuuza siku ya Sabato, sisi hatutanunua siku hiyo wala siku nyingine yoyote iliyo takatifu. Mwaka wa saba hatutailima ardhi na madeni yote tutayafuta.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
