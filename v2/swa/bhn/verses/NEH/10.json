              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunajiwekea sheria kwamba kwa mwaka tutatoa theluthi moja ya shekeli kwa ajili ya gharama za huduma ya nyumba ya Mungu: ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikate mitakatifu, sadaka za nafaka za kawaida, sadaka za kuteketezwa za kawaida, sadaka za siku za Sabato, sikukuu za mwandamo wa mwezi, sikukuu nyingine zilizowekwa, vitu vingine vitakatifu, sadaka za kuondoa dhambi, ili kuwafanyia upatanisho watu wa Israeli na kazi nyingine zozote za nyumba ya Mungu wetu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisi sote, watu wote, makuhani na Walawi tutapiga kura kila mwaka ili kuchagua ukoo utakaoleta kuni za kuteketeza tambiko madhabahuni pa Mwenyezi-Mungu, Mungu wetu, kama sheria ilivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunaahidi kuleta kila mwaka malimbuko yetu ya mazao na ya matunda ya kila mti kwenye nyumba ya Mwenyezi-Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kufuata ilivyoandikwa katika sheria kila mzaliwa wa kwanza wa kiume, katika nyumba zetu, atapelekwa katika nyumba ya Mungu wetu kwa makuhani wanaohudumu humo, pia tutapeleka kila mtoto wa kwanza wa kiume wa ng'ombe wetu, mbuzi wetu na kondoo wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.36",
            "verseOrgIds": [
              "NEH.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila unga wetu wa kwanza, matoleo yetu, matunda ya miti, divai na mafuta tutavileta kwa kuhani kwenye vyumba vya nyumba ya Mungu wetu. Tena tutaleta zaka zetu za mazao yetu kwa Walawi, kwani ndio wanaohusika na ukusanyaji wa zaka hizo katika vijiji vyetu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.37",
            "verseOrgIds": [
              "NEH.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhani, mzawa wa Aroni, atakuwa na Walawi wanapopokea zaka. Halafu Walawi watapeleka sehemu ya kumi ya zaka zote zilizotolewa katika nyumba ya Mungu kwenye vyumba na ghala. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.38",
            "verseOrgIds": [
              "NEH.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa Israeli na Walawi watayapeleka matoleo ya nafaka, divai na mafuta ya zeituni kwenye vyumba ambamo vyombo vya patakatifu vinatunzwa na ambamo makuhani, wangoja malango na waimbaji wana vyumba vyao. Na daima tutaijali nyumba ya Mungu wetu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.39",
            "verseOrgIds": [
              "NEH.10.39"
            ]
          }
        }
      ]
    }
