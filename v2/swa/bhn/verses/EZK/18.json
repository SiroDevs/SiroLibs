            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:2 Taz Eze 31:29",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kwa nini mnarudiarudia methali hii katika nchi ya Israeli:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        }
