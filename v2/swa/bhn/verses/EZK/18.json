        },
        {
          "text": "Neno la Mwenyezi-Mungu lilinijia: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.1",
            "verseOrgIds": [
              "EZK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 18:2"
          },
          "items": [
