        {
          "text": " Juu ya vichwa vya hao viumbe hai kulikuwa na kitu mfano wa anga, kinangaa kama kioo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.22",
            "verseOrgIds": [
              "EZK.1.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
