        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:8-11 Taz Isa 15:1--16:14; 25:10-12; Yer 48:1-47; Amo 2:1-3; Sef 2:8-11",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwana Mwenyezi-Mungu alisema: “Kwa kuwa Moabu imesema kuwa Yuda ni sawa tu na mataifa mengine, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.8",
            "verseOrgIds": [
              "EZK.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mimi nitaifanya miji inayolinda mipaka ya Moabu ishambuliwe, hata miji ile bora kabisa, yaani Beth-yeshimothi, Baal-meoni na Kiriathaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.9",
            "verseOrgIds": [
              "EZK.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitaitia nchi hiyo pamoja na nchi ya Amoni mikononi mwa watu wa mashariki iwe mali yao. Nchi ya Moabu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.10",
            "verseOrgIds": [
              "EZK.25.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:10",
              "type": "text"
            },
            {
              "text": "makala ya Kiebrania ni: Amoni.",
              "type": "text"
            }
          ]
        },
        {
          "text": " haitakuwa taifa tena. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.10",
            "verseOrgIds": [
              "EZK.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi nitaiadhibu nchi ya Moabu, nao watatambua kuwa mimi ni Mwenyezi-Mungu.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.11",
            "verseOrgIds": [
              "EZK.25.11"
            ]
          }
        }
      ]
