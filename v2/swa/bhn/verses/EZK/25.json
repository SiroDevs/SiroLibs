              "EZK.25.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:12-14 Taz Isa 34:5-17; 63:1-6; Yer 49:7-22 Eze 35:1-15; Amo 1:11-12; Oba",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bwana Mwenyezi-Mungu alisema hivi: “Kwa kuwa Waedomu wamefanya kisasi na Yuda, wakawalipiza watu wa Yuda kisasi kibaya sana ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.12",
            "verseOrgIds": [
              "EZK.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "basi, mimi Bwana Mwenyezi-Mungu nasema: Nitanyosha mkono dhidi ya nchi ya Edomu na kuwaua watu wote na wanyama. Nitaifanya kuwa ukiwa kutoka mji wa Temani hadi mji wa Dedani, watu watauawa kwa upanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.13",
            "verseOrgIds": [
              "EZK.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitawafanya watu wangu Israeli walipize kisasi juu ya Waedomu nao watawatenda Waedomu kadiri ya hasira na ghadhabu yangu. Ndipo Waedomu watakapotambua uzito wa kisasi changu. Mimi Bwana Mwenyezi-Mungu, nimesema.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.14",
            "verseOrgIds": [
              "EZK.25.14"
            ]
          }
        }
      ]
    },
