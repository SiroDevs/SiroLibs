        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.30",
            "verseOrgIds": [
              "EZK.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nyinyi, kundi la kondoo wangu, ni nyinyi watu wangu, nami ni Mungu wenu. Mimi Bwana Mwenyezi-Mungu nimesema.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.31",
            "verseOrgIds": [
              "EZK.34.31"
            ]
