              "EZK.20.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EZK 20:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.45",
            "verseOrgIds": [
              "EZK.20.45"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:45",
              "type": "text"
            },
            {
              "text": "katika makala ya Kiebrania sura 21 yaanzia hapa.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno la Mwenyezi-Mungu lilinijia: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.45",
            "verseOrgIds": [
              "EZK.20.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EZK 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wewe mtu, geukia upande wa kusini uhubiri dhidi ya nchi ya kusini, dhidi ya wakazi wa msitu wa Negebu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.46",
            "verseOrgIds": [
              "EZK.20.46"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:46",
              "type": "text"
            },
            {
              "text": "msitu wa Negebu:",
              "type": "text"
            },
            {
              "text": "Au Msitu wa kusini msemo ambao labda wahusu nchi yote ya Yuda.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.46",
            "verseOrgIds": [
              "EZK.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EZK 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waambie wasikilize neno langu mimi Mwenyezi-Mungu. Mimi Bwana Mwenyezi-Mungu nasema: Nitawasha moto kwako, nao utateketeza miti yote, mibichi na mikavu; utaenea tangu kusini mpaka kaskazini wala hakuna atakayeweza kuzima miali yake. Kila mtu atausikia mchomo wake. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.47",
            "verseOrgIds": [
              "EZK.20.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EZK 20:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wote watajua kwamba ni mimi Mwenyezi-Mungu niliyeuwasha na hautazimika.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.48",
            "verseOrgIds": [
              "EZK.20.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EZK 20:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nami nikasema, “Ee Bwana Mwenyezi-Mungu! Watu wanalalamika juu yangu na kusema: ‘Huyu akisema, ni mafumbo tu!’”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.49",
            "verseOrgIds": [
              "EZK.20.49"
            ]
          }
        }
      ]
    }
