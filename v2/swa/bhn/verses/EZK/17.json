        },
        {
          "text": "Neno la Mwenyezi-Mungu lilinijia: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.1",
            "verseOrgIds": [
              "EZK.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
