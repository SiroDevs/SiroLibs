            "number": "2",
            "style": "v",
            "sid": "EZK 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wewe mtu! Tega kitendawili, uwaambie fumbo Waisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.2",
            "verseOrgIds": [
              "EZK.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waambie kuwa mimi Bwana Mwenyezi-Mungu nasema hivi:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.3",
            "verseOrgIds": [
              "EZK.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.10",
            "verseOrgIds": [
              "EZK.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha neno la Mwenyezi-Mungu likanijia: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.11",
            "verseOrgIds": [
              "EZK.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:12-15 Taz 2Fal 24:15-20; 2Nya 36:10:13",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Sasa waulize hao watu waasi kama wanaelewa maana ya mfano huo. Waambie kuwa, mfalme wa Babuloni alikuja Yerusalemu, akamwondoa mfalme na viongozi wake, akawapeleka Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.12",
            "verseOrgIds": [
              "EZK.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akamtawaza mmoja wa jamaa ya kifalme, akafanya naye mapatano, akamwapisha. Aliwaondoa humo nchini watu mashujaa akawapeleka mbali ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.13",
            "verseOrgIds": [
              "EZK.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili utawala huo uwe dhaifu na uzingatie agano lake mfalme wa Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.14",
            "verseOrgIds": [
              "EZK.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini yule mfalme mpya alimwasi mfalme wa Babuloni kwa kuwatuma wajumbe Misri kuomba farasi na askari wengi. Je, mfalme huyo atafaulu? Je, anayefanya hivyo na kuvunja agano lake ataweza kuepa adhabu?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.15",
            "verseOrgIds": [
              "EZK.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.15",
            "verseOrgIds": [
              "EZK.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mimi Mwenyezi-Mungu naapa kwamba, kama niishivyo, mfalme huyu atafia katika nchi ya Babuloni, nchi ya mfalme yule aliyemweka awe mfalme, na ambaye amedharau kile kiapo na kuvunja lile agano alilofanya naye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.16",
            "verseOrgIds": [
              "EZK.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakika, Farao pamoja na jeshi lake kubwa hataweza kumsaidia vitani wakati Wababuloni watakapomzungushia ngome na kuta ili kuwaua watu wengi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.17",
            "verseOrgIds": [
              "EZK.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa alikidharau kile kiapo na kuvunja lile agano ambalo aliahidi kwa mkono wake mwenyewe na kufanya mambo haya yote, hakika hataokoka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.18",
            "verseOrgIds": [
              "EZK.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.18",
            "verseOrgIds": [
              "EZK.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwa hiyo, mimi Bwana Mwenyezi-Mungu nasema, kama niishivyo, kwa vile amekidharau kiapo alichoapa kwa jina langu na agano langu akalivunja, hakika nitamwadhibu vikali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.19",
            "verseOrgIds": [
              "EZK.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitatandaza wavu wangu juu yake, naye atanaswa katika mtego wangu; nitampeleka mpaka Babuloni na kumhukumu kwa sababu ya uhaini alioufanya dhidi yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.20",
            "verseOrgIds": [
              "EZK.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Majeshi yake hodari yatauawa kwa upanga na watakaosalia hai watatawanyika pande zote. Hapo mtatambua kuwa mimi, naam, mimi Mwenyezi-Mungu nimesema.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.21",
            "verseOrgIds": [
              "EZK.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.21",
            "verseOrgIds": [
              "EZK.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana Mwenyezi-Mungu asema hivi: “Mimi mwenyewe nitachukua kisehemu cha ncha ya juu ya mwerezi, naam, nitavunja tawi changa kutoka matawi yake ya juu na kulipanda juu ya mlima mrefu sana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.22",
            "verseOrgIds": [
              "EZK.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naam, nitalipanda juu ya mlima mrefu wa Israeli ili lichanue na kuzaa matunda. Litakuwa mwerezi mzuri, na ndege wa aina zote watakaa chini yake pia watajenga viota vyao katika matawi yake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.23",
            "verseOrgIds": [
              "EZK.17.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:23",
              "type": "text"
            },
            {
              "text": "Kigiriki: Lakini maneno na wanyama wa kila aina watakaa chini yake.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.23",
            "verseOrgIds": [
              "EZK.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo miti yote nchini itajua kuwa mimi Mwenyezi-Mungu huiporomosha miti mirefu na kuikuza miti mifupi. Mimi hukausha miti mibichi na kustawisha miti mikavu. Mimi Mwenyezi-Mungu nimesema hayo na nitayafanya.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.24",
            "verseOrgIds": [
              "EZK.17.24"
            ]
          }
        }
      ]
    }
  ],
