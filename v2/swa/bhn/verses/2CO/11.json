          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilipokuwa Damasko, mkuu wa mkoa, aliyekuwa chini ya mfalme Areta, alikuwa akiulinda mji wa Damasko ili anikamate. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
            "verseOrgIds": [
              "2CO.11.32"
            ]
          }
        },
