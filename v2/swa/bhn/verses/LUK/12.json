            "number": "58",
            "style": "v",
            "sid": "LUK 12:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana kama mshtaki wako anakupeleka mahakamani, ingekuwa afadhali kwako kupatana naye mkiwa bado njiani, ili asije akakupeleka mbele ya hakimu, naye hakimu akakutoa kwa polisi, nao wakakutia ndani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.58",
            "verseOrgIds": [
              "LUK.12.58"
            ]
          }
        },
