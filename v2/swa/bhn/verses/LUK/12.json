              "type": "text"
            }
          ]
        },
        {
          "text": "“Na kwa nini hamwezi kujiamulia wenyewe jambo jema la kufanya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.57",
            "verseOrgIds": [
              "LUK.12.57"
            ]
          }
        },
        {
          "name": "verse",
