        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.20",
            "verseOrgIds": [
              "1KI.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, Elisha akamwacha Elia, akairudia jozi yake ya ng'ombe, akawachinja ng'ombe hao na kuwapika akitumia miti ya nira kama kuni, akawapa watu, wakala. Kisha akaondoka, akamfuata Elia na kuwa mtumishi wake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.21",
            "verseOrgIds": [
              "1KI.19.21"
            ]
          }
        }
