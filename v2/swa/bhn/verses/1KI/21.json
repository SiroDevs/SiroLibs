              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, ujumbe huu wa Mwenyezi-Mungu ukamjia Elia wa Tishbe: ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
