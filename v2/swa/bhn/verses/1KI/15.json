          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matendo mengine ya Nadabu, yote yameandikwa katika Kitabu cha Mambo ya Nyakati ya Wafalme wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme Asa wa Yuda na mfalme Baasha wa Israeli walikuwa na vita kati yao wakati wote walipokuwa wakitawala.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
            "verseOrgIds": [
              "1KI.15.32"
            ]
          }
        }
      ]
