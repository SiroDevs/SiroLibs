          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnamo mwaka wa tatu wa utawala wa Asa mfalme wa Yuda, Baasha mwana wa Ahiya, alianza kutawala Israeli kutoka Tirza. Alitawala kwa muda wa miaka ishirini na minne. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
            "verseOrgIds": [
              "1KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
