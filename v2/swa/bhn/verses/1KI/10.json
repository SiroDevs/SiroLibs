          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila mmoja wao alimletea zawadi: Vyombo vya fedha, vya dhahabu, mavazi, manemane,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:25",
              "type": "text"
            },
            {
              "text": "manemane:",
              "type": "text"
            },
            {
              "text": "Au silaha.",
              "type": "text"
            }
          ]
        },
        {
          "text": " manukato, farasi na nyumbu. Zawadi hizi alizipokea kila mwaka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
