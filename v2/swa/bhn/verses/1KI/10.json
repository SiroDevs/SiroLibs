            {
              "text": "Mungu:",
              "type": "text"
            },
            {
              "text": "Septuaginta: Mwenyezi-Mungu, au Bwana.",
              "type": "text"
            }
          ]
        },
        {
          "text": " alikuwa amemjalia. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
