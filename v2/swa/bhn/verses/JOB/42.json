            }
          ]
        },
        {
          "text": "Kisha Yobu akamjibu Mwenyezi-Mungu:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        }
      ]
    },
    {
