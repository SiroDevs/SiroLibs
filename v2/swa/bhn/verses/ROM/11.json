        },
        {
          "text": "Hali kadhalika, kutokana na huruma mliyojaliwa nyinyi, Wayahudi wanamwasi Mungu sasa ili nao pia wapokee sasa huruma ya Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.31",
            "verseOrgIds": [
