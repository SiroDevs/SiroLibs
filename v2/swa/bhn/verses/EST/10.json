        {
          "text": "Mfalme Ahasuero alitoza kodi watu wa bara na pwani. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
