          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helebu mwana wa Baana, Mnetofathi; Itai mwana wa Ribai, toka Gibea katika Benyamini; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.29",
            "verseOrgIds": [
              "2SA.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya, Mpirathoni; Hidai, wa vijito vya Gaashi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.30",
            "verseOrgIds": [
              "2SA.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abialboni, Mwarbathi; Azmawethi, Mbahurimu; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.31",
            "verseOrgIds": [
              "2SA.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliaba, Mshaalboni; wana wa Yasheni; Yonathani; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.32",
            "verseOrgIds": [
              "2SA.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shama, Mharari; Ahimu mwana wa Sharari, Mharari; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.33",
            "verseOrgIds": [
              "2SA.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elifeleti mwana wa Ahasbai, Mmaaka; Eliamu mwana wa Ahithofeli, Mgiloni; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.34",
            "verseOrgIds": [
              "2SA.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesrawi, Mkarmeli; Paarai, Mwarbi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.35",
            "verseOrgIds": [
              "2SA.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igali mwana wa Nathani, Msoba; Bani, Mgadi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.36",
            "verseOrgIds": [
              "2SA.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seleki, Mwamoni; Naharai, Mbeerothi aliyekuwa mbeba silaha wa Yoabu mwana wa Seruya; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.37",
            "verseOrgIds": [
              "2SA.23.37"
            ]
          }
        },
