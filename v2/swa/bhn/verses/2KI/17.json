  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "2KI 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa kumi na mbili wa enzi ya mfalme Ahazi wa Yuda, Hoshea mwana wa Ela alianza kutawala Israeli, akatawala huko Samaria kwa miaka tisa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.1",
            "verseOrgIds": [
              "2KI.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alitenda dhambi mbele ya Mwenyezi-Mungu ingawa siyo kama wafalme wa Israeli waliomtangulia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.2",
            "verseOrgIds": [
              "2KI.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme Shalmanesa wa Ashuru alimshambulia; naye Hoshea akawa mtumishi wake na kumlipa ushuru. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.3",
            "verseOrgIds": [
              "2KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wakati mmoja Hoshea alituma wajumbe kwa mfalme wa Misri akiomba msaada; ndipo akaacha kulipa ushuru kwa mfalme Shalmanesa wa Ashuru kama alivyozoea kufanya kila mwaka. Shalmanesa alipoona hivi alimfunga Hoshea kwa minyororo na kumweka gerezani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha mfalme wa Ashuru akaivamia nchi nzima na kuufikia mji wa Samaria na kuuzingira kwa muda wa miaka mitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.5",
            "verseOrgIds": [
              "2KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa tisa wa utawala wa Hoshea, mfalme wa Ashuru aliuteka Samaria, na kuwachukua watu wa Israeli mateka mpaka Ashuru, baadhi yao akawaweka katika mji wa Hala, wengine karibu na mto Habori, mto Gozani na wengine katika miji ya Media.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya yote yalitendeka kwa sababu watu wa Israeli walimwasi Mwenyezi-Mungu, Mungu wao, ambaye aliwatoa kutoka mikononi mwa mfalme wa Misri, pia waliabudu miungu mingine, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.7",
            "verseOrgIds": [
              "2KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kufuata njia za mataifa ambayo Mwenyezi-Mungu aliyafukuza mbele ya Waisraeli, na kufanya matendo ya wafalme wa Israeli waliyoyaingiza nchini. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.8",
            "verseOrgIds": [
              "2KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa Israeli walitenda kwa siri mambo yasiyokuwa mema mbele ya Mwenyezi-Mungu, Mungu wao. Walijenga mahali pa juu pa kuabudia miungu ya uongo katika kila mji, kuanzia mnara wa walinzi mashambani hadi katika mji wenye ngome. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.9",
            "verseOrgIds": [
              "2KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juu ya kila kilima na chini ya kila mti wenye majani mabichi, walijenga nguzo za mawe na sanamu za mungu wa kike Ashera, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.10",
            "verseOrgIds": [
              "2KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na wakafukiza ubani kwenye madhabahu zote za miungu ya uongo kufuatia desturi za mataifa ambayo yalifukuzwa na Mwenyezi-Mungu. Walimkasirisha Mwenyezi-Mungu kwa matendo yao maovu, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na walitumikia sanamu ambazo Mwenyezi-Mungu alikuwa amewakataza, akisema, “Msifanye hivyo.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu alituma manabii na waonaji kuionya Israeli na Yuda akisema, “Acheni njia zenu mbaya mkatii amri zangu na maagizo yangu kufuatana na sheria nilizowapa babu zenu, na ambazo niliwapeni kupitia kwa watumishi wangu manabii.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.13",
            "verseOrgIds": [
              "2KI.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wao hawakutii; walikuwa wagumu kama babu zao ambao hawakumwamini Mwenyezi-Mungu, Mungu wao. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.14",
            "verseOrgIds": [
              "2KI.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walikataa kutii maagizo yake; hawakushika agano alilofanya na babu zao; licha ya kupuuza maonyo yake, waliabudu sanamu zisizokuwa na maana mpaka hata wao wenyewe hawakuwa na maana tena; walifuata desturi za mataifa yaliyowazunguka: Walipuuza amri za Mwenyezi-Mungu; wala hawakuzizingatia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walivunja amri zote za Mwenyezi-Mungu, Mungu wao, wakatengeneza sanamu za miungu ya ndama wawili wa kusubu; vilevile wakatengeneza sanamu za mungu wa kike Ashera wakaabudu na vitu vyote vya angani na wakamtumikia Baali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.16",
            "verseOrgIds": [
              "2KI.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliwatambika watoto wao wa kiume na wa kike kwa miungu ya uongo; wakataka shauri kwa watabiri na wachawi. Walinuia kabisa kutenda maovu mbele ya Mwenyezi-Mungu, wakamkasirisha sana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.17",
            "verseOrgIds": [
              "2KI.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, Mwenyezi-Mungu akawakasirikia sana watu wa Israeli na kuwafukuza kabisa mbele yake; hakuacha mtu isipokuwa kabila la Yuda peke yake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini hata watu wa Yuda hawakutii amri za Mwenyezi-Mungu, Mungu wao; bali walifuata desturi zilizoletwa na watu wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.19",
            "verseOrgIds": [
              "2KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu aliwakataa Waisraeli wote; akawaadhibu na kuwaacha mikononi mwa adui wakali, na kisha akawafukuza mbele yake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya Mwenyezi-Mungu kutenga watu wa Israeli kutoka ukoo wa Daudi, walimtawaza Yeroboamu mwana wa Nebati kuwa mfalme. Naye Yeroboamu aliwafanya watu wa Israeli kumwacha Mwenyezi-Mungu na kutenda dhambi kubwa sana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.21",
            "verseOrgIds": [
              "2KI.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waisraeli walitenda dhambi alizotenda Yeroboamu; hawakuweza kuziacha, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.22",
            "verseOrgIds": [
              "2KI.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "hadi hatimaye Mwenyezi-Mungu akawafukuza kutoka mbele yake, kama vile alivyokuwa amesema kupitia kwa watumishi wake wote manabii. Kwa hiyo watu wa Israeli walichukuliwa mateka kutoka nchi yao wenyewe mpaka Ashuru ambako wanakaa hata sasa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha mfalme wa Ashuru akachukua watu kutoka Babuloni, Kutha, Ava, Hamathi na Sefarvaimu na kuwaweka katika miji ya Samaria mahali pa watu wa Israeli waliopelekwa uhamishoni. Wakaitwaa miji hiyo na kukaa humo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.24",
            "verseOrgIds": [
              "2KI.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi ilitokea kwamba walipoanza kukaa humo, hawakumwabudu Mwenyezi-Mungu, kwa hiyo Mwenyezi-Mungu akatuma simba miongoni mwao, nao wakawaua baadhi yao. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.25",
            "verseOrgIds": [
              "2KI.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halafu watu walimwambia mfalme wa Ashuru, “Mataifa uliyochukua na kuyaweka katika miji ya Samaria hayakujua hukumu za Mungu wa nchi hiyo, kwa hiyo Mungu huyo alituma simba ambao wanawaua.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.26",
            "verseOrgIds": [
              "2KI.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mfalme wa Ashuru akaamuru, “Mrudishe kuhani mmoja kati ya wale tuliowaleta mateka; mrudishe aende na kukaa huko, ili awafundishe watu sheria ya Mungu wa nchi hiyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.27",
            "verseOrgIds": [
              "2KI.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo mmoja wa makuhani waliotekwa nyara toka Samaria alikwenda na kukaa Betheli, na huko aliwafundisha watu jinsi ya kumwabudu Mwenyezi-Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mataifa yote katika miji yalimoishi yalijitengenezea miungu yao na kuiweka mahali pa juu ambako watu wa Samaria walikuwa wametengeneza. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.29",
            "verseOrgIds": [
              "2KI.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa Babuloni walitengeneza vinyago vya Sukoth-benothi; Wakuthi vinyago vya Nergali; Wahamathi vinyago vya Ashima; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.30",
            "verseOrgIds": [
              "2KI.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waiva vinyago vya Nibhazi na Tartaki; na Wasefarvaimu walitoa watoto wao kuwa sadaka za kuteketezwa kwa miungu yao Adrameleki na Anameleki. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.31",
            "verseOrgIds": [
              "2KI.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu hawa vilevile walimwabudu Mwenyezi-Mungu. Waliteua kutoka kati yao watu wa kila aina na kuwafanya makuhani kutumika katika mahali pa juu na kutoa sadaka huko kwa niaba yao. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.32",
            "verseOrgIds": [
              "2KI.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivi walimwabudu Mwenyezi-Mungu, lakini wakati huohuo waliwaabudu pia miungu yao waliyoichukua kutoka nchi zao.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata sasa wanatenda kama walivyofanya hapo awali. Hawamwabudu Mwenyezi-Mungu, na wala hawafuati masharti, maagizo, sheria au amri ambazo yeye Mwenyezi-Mungu aliwaamuru wana wa Yakobo; ambaye alimpa jina Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu alikuwa amefanya agano nao na kuwaamuru, “Msiabudu miungu mingine; msiisujudie, msiitumikie wala msiitambikie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.35",
            "verseOrgIds": [
              "2KI.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtaniabudu mimi Mwenyezi-Mungu, ambaye niliwatoa huko Misri kwa uwezo na nguvu nyingi. Mtanisujudia mimi na kunitolea sadaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.36",
            "verseOrgIds": [
              "2KI.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wote mtatii masharti, maongozi, sheria na amri ambazo niliandika kwa ajili yenu, siku zote mtakuwa waangalifu kuzitenda. Msiiabudu miungu mingine, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.37",
            "verseOrgIds": [
              "2KI.17.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 17:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "wala msisahau agano nililofanya nanyi; msiiabudu miungu mingine, bali ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.38",
            "verseOrgIds": [
              "2KI.17.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2KI 17:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "mtaniabudu mimi Mwenyezi-Mungu, Mungu wenu, nami nitawaokoa kutoka mikononi mwa adui zenu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.39",
            "verseOrgIds": [
              "2KI.17.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 17:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini watu hao hawakusikiliza, bali waliendelea kutenda kama walivyofanya hapo awali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.40",
            "verseOrgIds": [
              "2KI.17.40"
            ]
          }
        }
      ]
    },
