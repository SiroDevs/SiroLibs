          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matendo mengine ya Yothamu na yote aliyofanya yameandikwa katika Kitabu cha Mambo ya Nyakati za Wafalme wa Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.36",
            "verseOrgIds": [
              "2KI.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wa enzi ya Yothamu, Mwenyezi-Mungu alianza kutuma mfalme Resini wa Aramu na mfalme Peka wa Israeli ili kushambulia Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yothamu akafariki na kuzikwa katika makaburi ya kifalme katika mji wa Daudi. Mwanae Ahazi alitawala mahali pake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.38",
            "verseOrgIds": [
              "2KI.15.38"
            ]
          }
