          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matendo mengine yote ya Menahemu yameandikwa katika Kitabu cha Mambo ya Nyakati za Wafalme wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.21",
            "verseOrgIds": [
              "2KI.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemu alifariki, naye mwanawe Pekahia alitawala mahali pake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.22",
            "verseOrgIds": [
              "2KI.15.22"
            ]
          }
        }
