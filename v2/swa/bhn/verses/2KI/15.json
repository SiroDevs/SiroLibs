          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa ishirini wa utawala wa Yothamu mwana wa Uzia mfalme wa Yuda, Hoshea mwana wa Ela alikula njama dhidi ya Peka, mwana wa Remalia, na akamuua, kisha akatawala mahali pake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.30",
            "verseOrgIds": [
              "2KI.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matendo mengine ya Peka na yote aliyoyafanya yameandikwa katika Kitabu cha Mambo ya Nyakati za Wafalme wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.31",
            "verseOrgIds": [
              "2KI.15.31"
            ]
          }
        }
      ]
