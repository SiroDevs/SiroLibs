          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwasi Mwenyezi-Mungu kwa kufuata mfano mbaya wa mfalme Yeroboamu mwana wa Nebati, aliyewafanya watu wa Israeli watende dhambi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.28",
