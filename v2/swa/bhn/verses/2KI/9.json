              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.26",
            "verseOrgIds": [
              "2KI.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazia mfalme wa Yuda alipoona yaliyotukia alikimbia akielekea Nyumba ya Bustani, huku akifuatwa na Yehu. Yehu akawaamuru watu wake, “Muueni naye pia!” Nao wakampiga mshale akiwa garini kwenye njia ya kupanda Guri karibu na mji wa Ibleamu. Halafu alikimbilia Megido na kufia huko. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.27",
            "verseOrgIds": [
              "2KI.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maofisa wake wakaichukua maiti yake ndani ya gari lake na kuipeleka Yerusalemu; na huko akazikwa katika makaburi ya kifalme katika mji wa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.28",
            "verseOrgIds": [
              "2KI.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
