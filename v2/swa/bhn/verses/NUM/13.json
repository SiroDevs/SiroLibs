            }
          ]
        },
        {
          "text": "Haya ndiyo majina ya watu ambao Mose aliwatuma kwenda kuipeleleza nchi ya Kanaani. Mose alimpa Hoshea mwana wa Nuni jina jipya, akamwita Yoshua.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.16",
            "verseOrgIds": [
              "NUM.13.16"
            ]
          }
        }
