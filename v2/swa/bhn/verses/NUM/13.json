              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu akamwambia Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.1",
            "verseOrgIds": [
              "NUM.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tuma watu waende wakaipeleleze nchi ya Kanaani ambayo ninawapa wana wa Israeli. Utatuma mtu mmoja kutoka katika kila kabila, na mtu huyo lazima awe kiongozi katika kabila lake.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.2",
            "verseOrgIds": [
              "NUM.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
