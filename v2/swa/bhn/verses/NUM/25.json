          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu akamwambia Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.16",
            "verseOrgIds": [
              "NUM.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wachokoze Wamidiani na kuwaangamiza, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.17",
            "verseOrgIds": [
              "NUM.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa sababu waliwachokoza nyinyi kwa hila zao, wakawadanganya kuhusu jambo la Peori, na kwa sababu ya Kozbi, binti yao, aliyeuawa wakati maradhi mabaya yalipozuka kule Peori.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.18",
            "verseOrgIds": [
              "NUM.25.18"
            ]
          }
        }
      ]
