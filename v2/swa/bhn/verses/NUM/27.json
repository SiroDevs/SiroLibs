              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.18",
            "verseOrgIds": [
              "NUM.27.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Kut 24:13",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwenyezi-Mungu akamwambia Mose, “Mtwae Yoshua mwana wa Nuni, mtu mwenye roho nzuri, kisha umwekee mikono, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.18",
            "verseOrgIds": [
              "NUM.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kumsimamisha mbele ya kuhani Eleazari na jumuiya yote, umkabidhi jukumu hilo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.19",
            "verseOrgIds": [
              "NUM.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe sehemu ya mamlaka yako ili jumuiya yote ya Waisraeli imtii. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.20",
            "verseOrgIds": [
              "NUM.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Kut 28:30; 1Sam 14:41; 28:6",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yeye atamtegemea kuhani Eleazari ambaye atamjulisha matakwa yangu kwa kutumia jiwe la kauli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.21",
            "verseOrgIds": [
              "NUM.27.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:21",
              "type": "text"
            },
            {
              "text": "jiwe la kauli:",
              "type": "text"
            },
            {
              "text": "Kiebrania: Urimu, moja ya mawe mawili yaliyotumiwa na kuhani kujua matakwa ya Mungu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwa njia hii, Eleazari atamwongoza Yoshua na jumuiya yote ya Waisraeli wanapotoka na wanapoingia.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.21",
            "verseOrgIds": [
              "NUM.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akafanya kama alivyoamriwa na Mwenyezi-Mungu. Alimtwaa Yoshua na kumsimamisha mbele ya kuhani Eleazari na jumuiya yote ya Waisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.22",
            "verseOrgIds": [
              "NUM.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Kumb 31:23",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kisha akamwekea mikono kichwani na kumpa mamlaka kama alivyoagizwa na Mwenyezi-Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.23",
            "verseOrgIds": [
              "NUM.27.23"
            ]
          }
        }
      ]
