              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.49",
            "verseOrgIds": [
              "NUM.33.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 33:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika tambarare za Moabu, ngambo ya mto Yordani karibu na Yeriko, Mwenyezi-Mungu alimwambia Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.50",
            "verseOrgIds": [
              "NUM.33.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 33:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Waambie Waisraeli kwamba mtakapovuka mto Yordani na kuingia katika nchi ya Kanaani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.51",
            "verseOrgIds": [
              "NUM.33.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 33:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "wafukuzeni wenyeji wote wa nchi hiyo mbele yenu. Mtaziharibu sanamu zao zote za mawe na za kusubu na kupabomoa kila mahali pao pa juu pa ibada. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.52",
            "verseOrgIds": [
              "NUM.33.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 33:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtaichukua nchi hiyo na kukaa humo kwa sababu nimewapeni muimiliki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.53",
            "verseOrgIds": [
              "NUM.33.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 33:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Hes 26:54-56",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mtaigawanya nchi hiyo kwa kura kufuata familia zenu; eneo kubwa kwa kabila kubwa na eneo dogo kwa kabila dogo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.54",
            "verseOrgIds": [
              "NUM.33.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "NUM 33:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kama msipowafukuza wenyeji wa nchi hiyo kwanza, basi wale mtakaowaacha watakuwa kama vibanzi machoni mwenu au miiba kila upande, na watawasumbua. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.55",
            "verseOrgIds": [
              "NUM.33.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "NUM 33:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitawafanyeni nyinyi kama nilivyokusudia kuwafanya wao.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.56",
            "verseOrgIds": [
              "NUM.33.56"
            ]
          }
        }
      ]
