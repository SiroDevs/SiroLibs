          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme wa Aradi, Mkanaani, aliyekaa Negebu katika nchi ya Kanaani, alipata habari kwamba Waisraeli walikuwa wanakuja.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.40",
            "verseOrgIds": [
              "NUM.33.40"
            ]
          }
        }
      ]
