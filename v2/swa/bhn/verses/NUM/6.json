          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwambie Aroni na wanawe kwamba hivi ndivyo mtakavyowabariki Waisraeli: Mtawaambia,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.23",
