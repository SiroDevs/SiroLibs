              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Mose alituma watu wapeleleze mji wa Yazeri; wakauteka pamoja na vitongoji vyake, wakawafukuza Waamori waliokaa humo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.32",
            "verseOrgIds": [
              "NUM.21.32"
            ]
          }
        }
