          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, Mose na Aroni wakawachukua watu hawa waliotajwa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.17",
            "verseOrgIds": [
              "NUM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mnamo siku ya kwanza ya mwezi wa pili, wakaikusanya jumuiya yote ya watu waliokuwa wamehesabiwa kila mmoja kulingana na familia yake na ukoo wake. Kufuatana na majina ya watu waliokuwa na umri wa miaka ishirini na zaidi, mmojammoja, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.18",
            "verseOrgIds": [
              "NUM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kama Mwenyezi-Mungu alivyomwamuru Mose. Mose akawahesabu watu hawa kule jangwani Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.19",
            "verseOrgIds": [
              "NUM.1.19"
            ]
          }
        }
      ]
    },
