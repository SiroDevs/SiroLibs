          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo jumla ya wanaume wote wa Israeli wenye umri kuanzia miaka ishirini na zaidi, waliofaa kuingia jeshini nchini Israeli ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.45",
            "verseOrgIds": [
              "NUM.1.45"
            ]
          }
        },
