            "number": "29",
            "style": "v",
            "sid": "NUM 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Familia za wana wa Kohathi zilitakiwa kupiga kambi yao upande wa kusini wa mahali patakatifu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.29",
            "verseOrgIds": [
