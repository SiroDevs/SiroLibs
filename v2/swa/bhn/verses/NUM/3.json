          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Eleazari mwana wa kuhani Aroni aliwekwa kuwa mkuu wa wakuu wa Walawi, na msimamizi wa wahudumu wote wa mahali patakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        }
