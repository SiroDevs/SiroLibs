          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wajibu wao ulikuwa kulitunza sanduku la agano, meza, kinara cha taa, madhabahu, vyombo wanavyotumia makuhani mahali patakatifu na pazia; huduma zote zilizohusu vitu hivi zilikuwa zao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.31",
            "verseOrgIds": [
              "NUM.3.31"
            ]
          }
        }
      ]
