              "type": "text"
            }
          ]
        },
        {
          "text": "ilikuwa kondoo 337,500, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.43",
            "verseOrgIds": [
              "NUM.31.43"
            ]
          }
        },
        {
