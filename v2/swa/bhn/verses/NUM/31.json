          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nusu yake, sehemu ambayo iligawiwa wanajeshi waliokwenda vitani, ilikuwa kondoo 337,500, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.36",
