            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka lile fungu la jumuiya nzima, chukua sehemu moja ya kila hamsini, iwe ni watu, ng'ombe, punda, kondoo na mbuzi. Hivyo utawapa Walawi ambao wana wajibu wa kuhudumu katika hema la Mwenyezi-Mungu.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.30",
            "verseOrgIds": [
              "NUM.31.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose na kuhani Eleazari walifanya kama Mwenyezi-Mungu alivyomwamuru Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.31",
            "verseOrgIds": [
              "NUM.31.31"
            ]
          }
        }
      ]
