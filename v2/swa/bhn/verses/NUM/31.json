          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu walikuwa 16,000, na katika hao sehemu ya Mwenyezi-Mungu ilikuwa ni watu thelathini na wawili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.40",
            "verseOrgIds": [
              "NUM.31.40"
            ]
          }
        },
        {
