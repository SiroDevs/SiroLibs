          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, Mose akampa kuhani Eleazari zaka hiyo iliyotolewa kwa Mwenyezi-Mungu, kama Mwenyezi-Mungu alivyomwamuru Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.41",
            "verseOrgIds": [
              "NUM.31.41"
            ]
          }
