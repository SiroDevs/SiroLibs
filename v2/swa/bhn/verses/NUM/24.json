          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu akamjibu Balaki, “Je, sikuwaambia wajumbe uliowatuma kwangu ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.12",
            "verseOrgIds": [
              "NUM.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwamba hata kama ungenipa nyumba yako imejaa fedha na dhahabu, mimi sitaweza kukiuka agizo la Mwenyezi-Mungu, kwa kufanya jambo lolote, jema au baya kwa hiari yangu mwenyewe? Nilisema, atakachosema Mwenyezi-Mungu ndicho nitakachokisema.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        }
      ]
    },
    {
