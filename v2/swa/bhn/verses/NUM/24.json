          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sasa ninarudi kwa watu wangu, lakini kabla sijaondoka, acha nikuambie mambo ambayo watu hao watawatendea watu wako siku zijazo.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.14",
            "verseOrgIds": [
              "NUM.24.14"
            ]
          }
        },
        {
