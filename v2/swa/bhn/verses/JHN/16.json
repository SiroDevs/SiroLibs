              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati unakuja, tena umekwisha fika, ambapo nyinyi nyote mtatawanywa kila mtu kwake, nami nitaachwa peke yangu. Kumbe, lakini mimi siko peke yangu, maana Baba yu pamoja nami. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.32",
            "verseOrgIds": [
              "JHN.16.32"
            ]
          }
        },
