              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.18",
            "verseOrgIds": [
              "DAN.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kisha nikataka nielezwe juu ya yule mnyama wa nne, ambaye alikuwa tofauti kabisa na wale wengine, wa ajabu na wa kutisha sana, ambaye meno yake yalikuwa ya chuma na makucha yake ya shaba. Aliyatumia meno hayo kula na kuvunjavunja, na mabaki aliyakanyagakanyaga kwa nyayo zake. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.19",
            "verseOrgIds": [
