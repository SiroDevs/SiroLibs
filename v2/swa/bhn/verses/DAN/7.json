          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Ufu 20:4",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lakini yule ‘Mzee wa kale na kale’ akainuka, akawapa haki watakatifu wa Mungu na wakati ulipotimia, hao watakatifu wakapewa ufalme.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.22",
