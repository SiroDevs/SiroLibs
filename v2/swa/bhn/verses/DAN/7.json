              "DAN.7.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Ufu 20:4; 1:14",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Nikiwa bado naangalia, viti vya enzi viliwekwa hapo, kisha ‘Mzee wa kale na kale’ akaja, akaketi. Alikuwa amevaa vazi jeupe kama theluji; nywele zake zilikuwa kama sufu safi. Kiti chake cha enzi kilikuwa cha miali ya moto na magurudumu ya kiti chake yalikuwa ya moto uwakao. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.9",
            "verseOrgIds": [
              "DAN.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Ufu 5:11; 20:12",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kutoka kiti hicho kijito cha moto kilibubujika, kikatiririka. Maelfu walimtumikia, na mamilioni walisimama mbele yake. Mahakama ikawa tayari kwa kikao, na vitabu vikafunguliwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.10",
            "verseOrgIds": [
              "DAN.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.10",
            "verseOrgIds": [
              "DAN.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kutokana na maneno ya kujigamba yaliyokuwa yanasemwa na ile pembe, nikatazama. Nikiwa natazama, huyo mnyama wa nne aliuawa, mwili wake ukaharibiwa na kutolewa uchomwe moto. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.11",
            "verseOrgIds": [
              "DAN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale wanyama wengine walinyanganywa mamlaka yao, lakini wao wenyewe wakaachwa waendelee kuishi kwa muda fulani.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.12",
            "verseOrgIds": [
              "DAN.7.12"
            ]
          }
        }
      ]
    },
