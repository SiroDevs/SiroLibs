          "items": [
            {
              "text": "Taz Ufu 13:7",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Nikiwa bado naangalia, pembe hiyo ilipigana vita na watakatifu, nayo ikawashinda. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.21",
            "verseOrgIds": [
              "DAN.7.21"
            ]
