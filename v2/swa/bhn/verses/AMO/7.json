          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, Amazia kuhani wa mji wa Betheli, akampelekea mfalme Yeroboamu wa Israeli habari hizi: “Amosi analeta fitina juu yako katika ufalme wa Israeli. Hotuba zake ni hatari kwa nchi hii. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.10",
            "verseOrgIds": [
              "AMO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anachosema ni hiki:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
