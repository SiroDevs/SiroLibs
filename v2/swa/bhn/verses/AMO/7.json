            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu alinijalia tena maono mengine: Nilimwona Mwenyezi-Mungu amesimama karibu na ukuta, ameshika mkononi mwake uzi wenye timazi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.7",
            "verseOrgIds": [
              "AMO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye akaniuliza: “Amosi, unaona nini?” Nikamjibu, “Naona timazi.” Kisha Mwenyezi-Mungu akasema:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        }
      ]
    },
    {
