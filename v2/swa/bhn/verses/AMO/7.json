              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku moja, Bwana Mwenyezi-Mungu alinijalia maono: Nilimwona Mungu anaumba nzige kundi zima, mara baada ya watu kumaliza kukata nyasi kwa ajili ya wanyama wa mfalme. Wakati huo, nyasi zilikuwa ndio zinaanza kuchipua tena. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.1",
            "verseOrgIds": [
              "AMO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niliwaona nzige hao wakila na kumaliza kila jani katika nchi. Ndipo nikasema:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.2",
            "verseOrgIds": [
              "AMO.7.2"
            ]
          }
        }
      ]
    },
