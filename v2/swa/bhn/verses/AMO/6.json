              "type": "text"
            }
          ]
        },
        {
          "text": "Kama wakibaki watu kumi katika nyumba moja, wote watakufa. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
            "verseOrgIds": [
