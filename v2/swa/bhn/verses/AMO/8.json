              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana Mwenyezi-Mungu alinijalia maono mengine: Niliona kikapu kilichojaa matunda ya kiangazi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.1",
            "verseOrgIds": [
              "AMO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Mwenyezi-Mungu akaniuliza: “Amosi, unaona nini?” Nami nikamjibu, “Naona kikapu cha matunda ya kiangazi.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:2",
              "type": "text"
            },
            {
              "text": "Maneno “matunda ya kiangazi” na neno “mwisho” katika Kiebrania yanakaribiana sana kimatamshi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kisha Mwenyezi-Mungu akaniambia:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
