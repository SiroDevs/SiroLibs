            "sid": "EZR 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena wakati wa utawala wa Artashasta, mfalme wa Persia, Bishlamu, Mithredathi, Tabeeli na rafiki zao, walimwandikia barua mfalme Artashasta. Barua hiyo iliandikwa kwa herufi za Kiaramu na kutafsiriwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:7",
              "type": "text"
            },
            {
              "text": "Kiebrania si dhahiri.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
