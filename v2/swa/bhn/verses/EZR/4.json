          "items": [
            {
              "text": "Taz Esta 1:1",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwanzoni mwa utawala wa mfalme Ahasuero, maadui wa watu waliokaa Yuda na Yerusalemu waliandika mashtaka dhidi yao.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        }
