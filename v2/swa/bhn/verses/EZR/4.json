          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia mtawala Rehumu na Shimshai, katibu wa mkoa, walimwandikia Artashasta barua ifuatayo dhidi ya Yerusalemu:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        }
      ]
