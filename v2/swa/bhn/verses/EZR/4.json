              "EZR.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara tu waliposomewa barua hii kutoka kwa Artashasta, Rehumu, katibu Shimshai na wenzao waliharakisha kwenda Yerusalemu na kuwalazimisha kwa nguvu Wayahudi waache kuujenga mji.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kazi ya kuijenga upya nyumba ya Mungu mjini Yerusalemu ilisimama, na hali hiyo iliendelea mpaka mwaka wa pili wa utawala wa Dario, mfalme wa Persia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.24",
            "verseOrgIds": [
              "EZR.4.24"
            ]
          }
        }
