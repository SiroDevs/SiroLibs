              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnamo mwaka wa kwanza wa utawala wa Koreshi, mfalme wa Persia, ili neno la Mwenyezi-Mungu alilolinena kwa njia ya nabii Yeremia litimie, Mwenyezi-Mungu alimfanya Koreshi, mfalme wa Persia, atangaze amri ifuatayo katika ufalme wake na kuiweka katika maandishi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
