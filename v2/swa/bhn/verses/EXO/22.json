          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyinyi mtakuwa watu waliowekwa wakfu kwangu. Kwa hiyo hamtakula nyama ya mnyama aliyeuawa na mnyama wa porini. Nyama hiyo mtawatupia mbwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.31",
            "verseOrgIds": [
