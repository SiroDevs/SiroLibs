          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Usimtukane Mungu, wala kumlaani mkuu wa watu wako.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.28",
            "verseOrgIds": [
              "EXO.22.28"
            ]
          }
        }
