          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ukimkopesha fedha mtu yeyote miongoni mwa watu wangu walio maskini, usiwe kwake kama mdai, wala usimtoze riba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.25",
            "verseOrgIds": [
              "EXO.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukilichukua vazi la mwenzako kuliweka rehani, lazima umrudishie kabla ya jua kutua, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
              "EXO.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kuwa hiyo ndiyo nguo yake ya pekee; ndiyo atakayojifunika nayo. Au wadhani atalalia nini? Akinililia nitamsikiliza, maana mimi ni mwenye huruma.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.27",
            "verseOrgIds": [
              "EXO.22.27"
            ]
          }
        }
      ]
