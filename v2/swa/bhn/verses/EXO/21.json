          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wanaume wakipigana na kumwumiza mwanamke mjamzito, hata mimba yake ikaharibika bila madhara mengine zaidi, yule aliyemwumiza atatozwa faini kama atakavyodai mumewe mwanamke huyo na kama mahakimu watakavyoamua. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.22",
            "verseOrgIds": [
              "EXO.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kama yatakuwapo madhara mengine, basi, lazima amlipe uhai kwa uhai, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.23",
            "verseOrgIds": [
              "EXO.21.23"
            ]
          }
        },
