          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Watu wawili wakigombana, kisha mmoja akampiga mwenzake jiwe au ngumi bila kumwua, lakini akamjeruhi kiasi cha kumfanya augue na kulala kitandani, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.18",
            "verseOrgIds": [
              "EXO.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "iwapo huyo aliyepigwa atapata nafuu na kuweza kutembea kwa kutegemea fimbo, huyo aliyemjeruhi atasamehewa. Lakini, atamlipa fidia ya muda alioupoteza kitandani, na kuhakikisha amemwuguza mpaka apone kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
              "EXO.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
