          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Lawi 24:19-20; Kumb 19:21; Mat 5:38",
              "type": "text"
            }
          ]
        },
        {
          "text": " jicho kwa jicho, jino kwa jino, mkono kwa mkono, mguu kwa mguu, ",
          "type": "text",
          "attrs": {
