          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
              "EXO.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mtu akimpiga mtumwa wake wa kiume au wa kike kwa fimbo na kumwua papo hapo, ni lazima aadhibiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.20",
            "verseOrgIds": [
              "EXO.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mtumwa huyo akibaki hai siku moja au mbili, bwana wake hataadhibiwa, kwani huyo alikuwa ni mali yake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
            "verseOrgIds": [
              "EXO.21.21"
            ]
          }
        }
      ]
    },
    {
