            {
              "text": "Taz Lawi 24:17",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ampigaye mtu na kumwua, lazima auawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.12",
            "verseOrgIds": [
              "EXO.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kama hakuwa amemvizia, bali ni kwa ajali, basi, huyo mwuaji ataweza kukimbilia usalama mahali nitakapowachagulieni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mtu akimshambulia mwenzake makusudi na kumwua kwa ujeuri, hata kama atakimbilia kwenye madhabahu, mtamtoa huko madhabahuni pangu na kumwua.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
      ]
    },
