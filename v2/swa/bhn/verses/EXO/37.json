            {
              "text": "Taz Kut 30:22-38",
              "type": "text"
            }
          ]
        },
        {
          "text": " Alitengeneza mafuta matakatifu ya kupaka, na ubani safi wenye harufu nzuri uliochanganywa vizuri kama manukato.",
          "type": "text",
          "attrs": {
