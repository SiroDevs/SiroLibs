              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo kulikuwa na mbao nane na vikalio vyake vya fedha kumi na sita, vikalio viwili chini ya kila ubao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.30",
