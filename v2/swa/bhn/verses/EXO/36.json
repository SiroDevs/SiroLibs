            "sid": "EXO 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alitengeneza pia pau za mjohoro: Pau tano kwa ajili ya mbao za upande mmoja wa hema, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.31",
            "verseOrgIds": [
              "EXO.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "pau tano kwa ajili ya upande wa pili wa hema, na pau tano kwa ajili ya mbao za upande wa nyuma wa hema, ulio magharibi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.32",
            "verseOrgIds": [
              "EXO.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alitengeneza upau wa katikati uliofika nusu ya jengo la hema ambao ulipenya katikati kutoka mwisho hadi mwisho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.33",
            "verseOrgIds": [
              "EXO.36.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbao zote alizipaka dhahabu, akazitengeneza na pete za dhahabu za kushikilia pau hizo ambazo pia alizipaka dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.34",
            "verseOrgIds": [
              "EXO.36.34"
            ]
          }
        }
