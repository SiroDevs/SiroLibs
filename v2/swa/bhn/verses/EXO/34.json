          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara tatu kwa mwaka wanaume wote watakusanyika mbele yangu mimi Bwana Mwenyezi-Mungu, Mungu wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
