              "EXO.34.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Kut 20:4; Lawi 19:4; Kumb 5:8; 27:15",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Msijifanyie miungu ya uongo ya chuma.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.17",
            "verseOrgIds": [
              "EXO.34.17"
            ]
          }
        }
