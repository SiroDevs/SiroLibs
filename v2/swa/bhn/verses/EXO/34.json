          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu alimwambia Mose, “Andika maneno haya, maana kulingana na maneno haya, ninafanya agano nawe na watu wa Israeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.27",
            "verseOrgIds": [
              "EXO.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose alikaa huko mlimani pamoja na Mwenyezi-Mungu siku arubaini, mchana na usiku; hakula chakula wala kunywa maji. Aliandika maneno yote ya agano na zile amri kumi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.28",
            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        }
      ]
