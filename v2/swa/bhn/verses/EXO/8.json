          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, Mose akaondoka nyumbani kwa Farao, akamwomba Mwenyezi-Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu akafanya kama Mose alivyomwomba, wale nzi wakatoweka kutoka kwa Farao, maofisa wake na watu wake, wala hakusalia hata mmoja. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.31",
            "verseOrgIds": [
              "EXO.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini hata safari hii Farao alikuwa mkaidi, wala hakuwaruhusu Waisraeli kuondoka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.32",
            "verseOrgIds": [
              "EXO.8.32"
            ]
          }
        }
