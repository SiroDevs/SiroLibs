          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Kitani na mimea ya shayiri vyote vilikuwa vimeharibiwa, kwa sababu shayiri ilikuwa na masuke, na kitani ilikuwa imechanua maua. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.31",
            "verseOrgIds": [
              "EXO.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ngano na jamii nyingine ya ngano havikuharibiwa kwa kuwa hiyo huchelewa kukomaa).",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
            "verseOrgIds": [
              "EXO.9.32"
            ]
          }
        }
      ]
    },
