          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Mwenyezi-Mungu akamfanya Farao kuwa mkaidi, akakataa kuwaachia Waisraeli waondoke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
              "EXO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao akamwambia Mose, “Toka mbele yangu. Jihadhari sana. Usije kuniona tena, maana siku utakapokuja tena mbele yangu, utakufa!” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.28",
            "verseOrgIds": [
              "EXO.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose naye akamwambia, “Sawa! Kama ulivyosema sitakuja kukuona tena.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.29",
            "verseOrgIds": [
              "EXO.10.29"
            ]
          }
        }
