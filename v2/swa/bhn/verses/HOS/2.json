              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, waiteni kaka zenu, “Watu wangu,” na dada zenu, “Waliohurumiwa.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
            "verseOrgIds": [
              "HOS.2.1"
            ]
          }
        }
      ]
    },
    {
