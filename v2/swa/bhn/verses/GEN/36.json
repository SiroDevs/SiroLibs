          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dishoni, Eseri na Dishani; kila mmoja wao akiwa mkuu wa kabila lake katika nchi ya Seiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.30",
