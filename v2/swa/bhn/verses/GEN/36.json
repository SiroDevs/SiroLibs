        },
        {
          "text": "Wakuu wa makabila yaliyotokana na Esau, kadiri ya makabila yao na makazi yao walikuwa: Timna, Alva, Yethethi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.40",
