  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "GEN 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu alimkumbuka Sara, akamtendea kama alivyoahidi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.1",
            "verseOrgIds": [
              "GEN.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, Abrahamu akiwa mzee, Sara akapata mimba, akamzalia mtoto wa kiume, wakati uleule Mungu alioutaja. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.2",
            "verseOrgIds": [
              "GEN.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu akampa huyo mwanawe ambaye Sara alimzalia jina Isaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.3",
            "verseOrgIds": [
              "GEN.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka alipotimiza umri wa siku nane, Abrahamu akamtahiri kama alivyoamriwa na Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.4",
            "verseOrgIds": [
              "GEN.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu alikuwa na umri wa miaka 100 wakati mwanawe Isaka alipozaliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.5",
            "verseOrgIds": [
              "GEN.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Sara akasema, “Mungu amenipatia kicheko",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.6",
            "verseOrgIds": [
              "GEN.21.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:6",
              "type": "text"
            },
            {
              "text": "kicheko:",
              "type": "text"
            },
            {
              "text": "Jina Isaka Kiebrania maana yake ni “Hucheka” (taz pia 17:17-19).",
              "type": "text"
            }
          ]
        },
        {
          "text": "; yeyote atakayesikia habari hizi, atacheka pamoja nami.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.6",
            "verseOrgIds": [
              "GEN.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akaongeza, “Ni nani angeweza kumwambia Abrahamu kwamba mimi Sara nitanyonyesha watoto? Tena nimemzalia mtoto wa kiume katika uzee wake!”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.7",
            "verseOrgIds": [
              "GEN.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.7",
            "verseOrgIds": [
              "GEN.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka akaendelea kukua, na siku alipoachishwa kunyonya, Abrahamu akafanya sherehe kubwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.8",
            "verseOrgIds": [
              "GEN.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.8",
            "verseOrgIds": [
              "GEN.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baadaye Sara alimwona Ishmaeli, mtoto wa Abrahamu aliyezaliwa na Hagari, Mmisri, akicheza na Isaka mwanawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.9",
            "verseOrgIds": [
              "GEN.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, Sara akamwambia Abrahamu, “Mfukuzie mbali mjakazi huyu na mwanawe. Haiwezekani kabisa mtoto wa mjakazi kurithi pamoja na mwanangu Isaka.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.10",
            "verseOrgIds": [
              "GEN.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jambo hili lilimhuzunisha sana Abrahamu kwa kuwa Ishmaeli pia alikuwa mtoto wake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.11",
            "verseOrgIds": [
              "GEN.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Mungu akamwambia Abrahamu, “Usihuzunike kwa sababu ya mtoto huyu, wala huyo mtumwa wako wa kike. Lolote akuambialo Sara lifanye; kwa kweli wazawa wako watatokana na Isaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.12",
            "verseOrgIds": [
              "GEN.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kuhusu huyo mwana wa mjakazi wako, nitamfanya awe baba wa taifa kubwa kwa kuwa yeye pia ni mtoto wako.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.13",
            "verseOrgIds": [
              "GEN.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.13",
            "verseOrgIds": [
              "GEN.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo, asubuhi na mapema, Abrahamu akachukua chakula na kiriba cha maji, akampa Hagari na kumtwika begani; akamfukuza pamoja na mwanawe. Hagari akaondoka, akawa anatangatanga nyikani Beer-sheba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.14",
            "verseOrgIds": [
              "GEN.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.14",
            "verseOrgIds": [
              "GEN.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa maji yalipomwishia katika kile kiriba, Hagari akamlaza mwanawe chini ya mti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.15",
            "verseOrgIds": [
              "GEN.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye akaenda kando, akaketi umbali wa kama mita 100 hivi, akisema moyoni mwake, “Heri nisimwone mwanangu akifa.” Na alipokuwa ameketi hapo, mtoto",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.16",
            "verseOrgIds": [
              "GEN.21.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:16",
              "type": "text"
            },
            {
              "text": "mtoto:",
              "type": "text"
            },
            {
              "text": "Tafsiri moja ya awali ina Hagari.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akalia kwa sauti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.16",
            "verseOrgIds": [
              "GEN.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.16",
            "verseOrgIds": [
              "GEN.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu akamsikia mtoto huyo akilia, na malaika wa Mungu akamwita Hagari kutoka mbinguni, akamwambia, “Una shida gani Hagari? Usiogope; Mungu amesikia sauti ya mtoto huko alipo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.17",
            "verseOrgIds": [
              "GEN.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simama umwinue mtoto na kumshika vizuri mikononi mwako, kwani nitamfanya awe baba wa taifa kubwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.18",
            "verseOrgIds": [
              "GEN.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu akamfumbua Hagari macho, naye akaona kisima cha maji. Akaenda akajaza kiriba maji, akamnywesha mtoto wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.19",
            "verseOrgIds": [
              "GEN.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.19",
            "verseOrgIds": [
              "GEN.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu akawa pamoja na huyo mtoto, naye akaendelea kukua. Alikaa nyikani na akawa mpiga upinde hodari sana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.20",
            "verseOrgIds": [
              "GEN.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alikuwa akikaa katika nyika za Parani, na mama yake akamwoza mke kutoka nchi ya Misri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.21",
            "verseOrgIds": [
              "GEN.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.21",
            "verseOrgIds": [
              "GEN.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo, Abimeleki pamoja na Fikoli, mkuu wa jeshi lake, alimwendea Abrahamu, akamwambia, “Mungu yuko pamoja nawe katika kila kitu unachofanya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.22",
            "verseOrgIds": [
              "GEN.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo niapie kwa jina la Mungu kwamba hutanifanyia hila mimi au watoto wangu au wazawa wangu. Kadiri mimi nilivyokuwa mwaminifu kwako, vivyo hivyo nawe uwe mwaminifu kwangu na kwa nchi hii unamokaa.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.23",
            "verseOrgIds": [
              "GEN.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu akasema, “Naapa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.24",
            "verseOrgIds": [
              "GEN.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.24",
            "verseOrgIds": [
              "GEN.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo Abrahamu alikuwa amemlalamikia Abimeleki juu ya kisima cha maji ambacho watumishi wa Abimeleki walikuwa wamemnyanganya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.25",
            "verseOrgIds": [
              "GEN.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki akamwambia, “Mimi sijui nani aliyefanya hivyo; mpaka leo hii wewe hukuniambia; wala mimi sijapata kusikia habari hizi hadi leo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.26",
            "verseOrgIds": [
              "GEN.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, Abrahamu akachukua kondoo na ng'ombe akampa Abimeleki nao wawili wakafanya agano baina yao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.27",
            "verseOrgIds": [
              "GEN.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu akatenga wanakondoo wa kike saba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.28",
            "verseOrgIds": [
              "GEN.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki akamwuliza Abrahamu, “Kwa nini unawatenga hao wanakondoo wa kike saba?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.29",
            "verseOrgIds": [
              "GEN.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu akamjibu, “Hawa wanakondoo wa kike saba ninakupa kwa mkono wangu mwenyewe kama shahidi wangu kwamba mimi ndimi niliyechimba kisima hiki.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.30",
            "verseOrgIds": [
              "GEN.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo kisima hicho kikaitwa Beer-sheba,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.31",
            "verseOrgIds": [
              "GEN.21.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:31",
              "type": "text"
            },
            {
              "text": "Beer-sheba:",
              "type": "text"
            },
            {
              "text": "Kiebrania maana yake ni “Kisima cha Kiapo” au “Kisima cha Wale Saba” (taz pia 26:33).",
              "type": "text"
            }
          ]
        },
        {
          "text": " maana wote wawili walikula kiapo mahali hapo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.31",
            "verseOrgIds": [
              "GEN.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo, wakafanya agano huko Beer-sheba. Abimeleki na Fikoli, mkuu wa jeshi lake, akaondoka na kurudi katika nchi ya Wafilisti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.32",
            "verseOrgIds": [
              "GEN.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu akapanda mkwaju huko Beer-sheba, akaomba kwa jina la Mwenyezi-Mungu, akamwabudu Mungu, Mungu wa milele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.33",
            "verseOrgIds": [
              "GEN.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu alikaa katika nchi ya Wafilisti muda mrefu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.34",
            "verseOrgIds": [
              "GEN.21.34"
            ]
          }
        }
      ]
    }
