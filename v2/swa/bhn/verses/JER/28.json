          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.16",
            "verseOrgIds": [
              "JER.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka huohuo, mnamo mwezi wa saba, nabii Hanania akafa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.17",
            "verseOrgIds": [
              "JER.28.17"
            ]
          }
        }
