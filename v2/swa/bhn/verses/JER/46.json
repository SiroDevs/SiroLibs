          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu wa majeshi, Mungu wa Israeli, alisema: “Tazama, mimi nitamwadhibu Amoni mungu wa Thebesi, nitaiadhibu Misri na miungu yake na wafalme wake, nitamwadhibu Farao na wote wanaomtegemea. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.25",
            "verseOrgIds": [
              "JER.46.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 46:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitawatia mikononi mwa wale wanaotaka kuyaangamiza maisha yao, yaani Nebukadneza mfalme wa Babuloni na maofisa wake. Baadaye, nchi ya Misri itakaliwa na watu kama ilivyokuwa hapo zamani. Mimi Mwenyezi-Mungu nimesema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.26",
            "verseOrgIds": [
              "JER.46.26"
            ]
          }
        }
      ]
