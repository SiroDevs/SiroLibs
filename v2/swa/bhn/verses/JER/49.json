          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhusu Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.7",
            "verseOrgIds": [
              "JER.49.7"
            ]
          }
        }
