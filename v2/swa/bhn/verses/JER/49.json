        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.22",
            "verseOrgIds": [
              "JER.49.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
