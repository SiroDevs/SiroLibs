            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu asema hivi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
