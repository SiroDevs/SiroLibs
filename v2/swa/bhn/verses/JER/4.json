          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu asema hivi: “Siku hiyo, mfalme na wakuu watakufa moyo; makuhani watapigwa na bumbuazi, na manabii watashangaa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.9",
            "verseOrgIds": [
              "JER.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikasema: “Aa, Mwenyezi-Mungu, hakika umewadanganya kabisa watu hawa na mji wa Yerusalemu! Uliwaambia mambo yatawaendea vema, kumbe maisha yao yamo hatarini kabisa!”",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.10",
            "verseOrgIds": [
              "JER.4.10"
            ]
          }
        }
      ]
    },
