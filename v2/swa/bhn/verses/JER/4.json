            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo, wataambiwa hivi watu hawa pamoja na mji wa Yerusalemu, “Upepo wa hari kutoka vilele vikavu vya jangwani utawavumia watu wangu. Huo si upepo wa kupepeta au kusafisha, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.11",
            "verseOrgIds": [
              "JER.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bali ni upepo mkali sana utokao kwangu. Ni mimi Mwenyezi-Mungu nitakayetoa hukumu juu yao.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.12",
            "verseOrgIds": [
              "JER.4.12"
            ]
          }
        }
      ]
    },
