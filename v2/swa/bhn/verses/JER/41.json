          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, wakaenda zao, wakakaa huko Geruthi Kimahamu karibu na Bethlehemu, wakikusudia kuingia katika nchi ya Misri, kwa sababu ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "walikuwa wanawaogopa Wakaldayo tangu wakati Ishmaeli mwana wa Nethania, alipomuua Gedalia mwana wa Ahikamu ambaye mfalme wa Babuloni alikuwa amemteua kuwa mtawala wa nchi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.18",
