          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nitaiadhibu Babuloni na wakazi wote wa Kaldayo mkiona kwa macho yenu wenyewe, kwa sababu ya uovu wote walioufanya katika Siyoni. Mimi Mwenyezi-Mungu nimesema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.24",
            "verseOrgIds": [
              "JER.51.24"
            ]
