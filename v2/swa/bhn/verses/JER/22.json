          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ole wako Yehoyakimu",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.13",
            "verseOrgIds": [
              "JER.22.13"
            ]
          }
        }
