        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.5",
            "verseOrgIds": [
              "JER.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
