        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.10",
            "verseOrgIds": [
              "JER.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana, Mwenyezi-Mungu asema hivi juu ya Shalumu mwana wa Yosia, mfalme wa Yuda, aliyetawala baada ya Yosia baba yake, na ambaye aliondoka mahali hapa: “Shalumu hatarudi tena mahali hapa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bali atafia hukohuko walikomchukua utumwani. Kamwe hataiona tena nchi hii.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        }
      ]
    },
