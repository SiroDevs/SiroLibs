      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.23",
            "verseOrgIds": [
              "JER.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kuhusu Konia mfalme wa Yuda, mwanawe Yehoyakimu, Mwenyezi-Mungu asema hivi: “Naapa kwa nafsi yangu mimi Mwenyezi-Mungu kwamba hata kama wewe Konia mwana wa Yehoyakimu, mfalme wa Yuda, ungekuwa pete yangu ya mhuri katika mkono wangu wa kulia, ningekuvulia mbali. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.24",
            "verseOrgIds": [
              "JER.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitakutia mikononi mwa wale wanaotaka kuyamaliza maisha yako; naam, mikononi mwa wale unaowaogopa, mikononi mwa Nebukadneza, mfalme wa Babuloni; naam, mikononi mwa Wakaldayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.25",
            "verseOrgIds": [
              "JER.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitakufukuzia mbali katika nchi ya kigeni, wewe pamoja na mama yako mzazi. Mtakuwa watumwa katika nchi hiyo ambamo nyote wawili hamkuzaliwa, nanyi mtafia hukohuko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.26",
            "verseOrgIds": [
              "JER.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtatamani kwa hamu kubwa kurudi katika nchi hii, lakini hamtarudi kamwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.27",
            "verseOrgIds": [
              "JER.22.27"
            ]
          }
        }
      ]
    }
