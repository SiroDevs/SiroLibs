  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1CH 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Yuda walikuwa Peresi, Hesroni, Karmi, Huri na Shobali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.1",
            "verseOrgIds": [
              "1CH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reaya, mwana wa Shobali, alimzaa Yahathi, aliyekuwa baba yake Ahumai na Lahadi, hizo ndizo jamaa za Wasorathi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.2",
            "verseOrgIds": [
              "1CH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Etamu walikuwa Yezreeli, Ishma na Idbashi. Walikuwa na dada mmoja aliyeitwa Haselelponi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.3",
            "verseOrgIds": [
              "1CH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Penueli aliwazaa Gedori na Ezeri, na Ezeri akamzaa Husha. Hao ndio wazawa wa Huri mzaliwa wa kwanza wa Efratha, baba yake Bethlehemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.4",
            "verseOrgIds": [
              "1CH.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.4",
            "verseOrgIds": [
              "1CH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuru, mwanzilishi wa mji wa Tekoa, alikuwa na wake wawili: Hela na Naara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.5",
            "verseOrgIds": [
              "1CH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naara alimzalia wana wanne: Ahuzamu, Heferi, Temeni na Haahashtari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.6",
            "verseOrgIds": [
              "1CH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela alimzalia wana watatu: Serethi, Ishari na Ethnani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.7",
            "verseOrgIds": [
              "1CH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakosi aliwazaa Anubi na Sobeba, na ndiye aliyekuwa baba wa jamaa za wazawa wa Aharheli, mwana wa Harumu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.8",
            "verseOrgIds": [
              "1CH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.8",
            "verseOrgIds": [
              "1CH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulikuwa na mtu mmoja jina lake Yabesi, aliyeheshimiwa kuliko ndugu zake wote. Mama yake alimpa jina la Yabesi kwa sababu alimzaa kwa maumivu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.9",
            "verseOrgIds": [
              "1CH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Yabesi alimwomba Mungu wa Israeli akisema, “Ee Mungu, nakusihi unibariki na kuipanua mipaka yangu. Mkono wako uwe pamoja nami na unilinde kutokana na jambo lolote ovu, lisiniumize.” Naye Mungu akamjalia yale aliyoomba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.10",
            "verseOrgIds": [
              "1CH.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.10",
            "verseOrgIds": [
              "1CH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kelubu, nduguye Shuha, alimzaa Mehiri na Mehiri akamzaa Eshtoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.11",
            "verseOrgIds": [
              "1CH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshtoni alikuwa na wana watatu: Beth-rafa, Pasea na Tehina. Tehina alikuwa mwanzilishi wa mji wa Ir-nahashi. Wazawa wa watu hawa waliishi Reka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.12",
            "verseOrgIds": [
              "1CH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.12",
            "verseOrgIds": [
              "1CH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Kenazi walikuwa: Othnieli na Seraya; na wana wa Othnieli walikuwa Hathathi na Meonothai.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.13",
            "verseOrgIds": [
              "1CH.4.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:13",
              "type": "text"
            },
            {
              "text": "Meonothai:",
              "type": "text"
            },
            {
              "text": "Makala ya Kiebrania haina Meonothai.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.13",
            "verseOrgIds": [
              "1CH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meonothai alimzaa Ofra. Seraya alimzaa Yoabu, mwanzilishi wa Bonde la Mafundi, lililopewa jina hilo kwa sababu wote waliokuwa humo walikuwa mafundi stadi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.14",
            "verseOrgIds": [
              "1CH.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.14",
            "verseOrgIds": [
              "1CH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu mwana wa Yefune alikuwa na wana watatu: Iru, Ela na Naamu. Na mwana wa Ela alikuwa Kenazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.15",
            "verseOrgIds": [
              "1CH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Yehaleli walikuwa Zifu, Zifa, Tiria na Asareli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.16",
            "verseOrgIds": [
              "1CH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Ezra walikuwa Yetheri, Meredi, Eferi na Yaloni. Meredi alimwoa Bithia, bintiye Farao, na hawa ndio wana aliomzalia Meredi: Miriamu, Shamai na Ishba, mwanzilishi wa mji wa Eshtemoa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.17",
            "verseOrgIds": [
              "1CH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meredi alikuwa na mke mwingine Myahudi. Huyu alimzalia Yeredi, mwanzilishi wa Mji wa Gedori, Heberi, mwanzilishi wa mji wa Soko, na Yekuthieli, mwanzilishi wa Mji wa Zanoa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.18",
            "verseOrgIds": [
              "1CH.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.18",
            "verseOrgIds": [
              "1CH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hodia alimwoa dada yake Nahamu ambaye wazawa wake ndio waanzilishi wa kabila la Garmi, lililoishi katika mji wa Keila, na kabila la Maakathi, lililoishi katika mji wa Eshtemoa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.19",
            "verseOrgIds": [
              "1CH.4.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:19",
              "type": "text"
            },
            {
              "text": "aya hii Kiebrania si dhahiri.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.19",
            "verseOrgIds": [
              "1CH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Shimoni walikuwa Amnoni, Rina, Ben-hanani na Tiloni. Ishi alikuwa na wana wawili: Zohethi na Ben-zohethi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.20",
            "verseOrgIds": [
              "1CH.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.20",
            "verseOrgIds": [
              "1CH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Shela, mwana wa Yuda, walikuwa Eri, mwanzilishi wa mji wa Leka, Laada, mwanzilishi wa mji Maresha; ukoo wa wafuma nguo za kitani waliokuwa wakiishi katika mji wa Beth-ashbea; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.21",
            "verseOrgIds": [
              "1CH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokimu na watu walioishi katika mji wa Kozeba; na Yoashi na Sarafi waliotawala huko Moabu na wakarejea Lehemu. (Taarifa hizi ni za zamani sana.) ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.22",
            "verseOrgIds": [
              "1CH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa ndio wafinyanzi walioishi katika miji ya Netaimu na Gedera, wakimhudumia mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.23",
            "verseOrgIds": [
              "1CH.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.23",
            "verseOrgIds": [
              "1CH.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simeoni alikuwa na wana watano: Nemueli, Yamini, Yaribu, Zera na Shauli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.24",
            "verseOrgIds": [
              "1CH.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa Shauli alikuwa Shalumu; Shalumu alimzaa Mibsamu na Mibsamu akamzaa Mishma. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.25",
            "verseOrgIds": [
              "1CH.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mishma alimzaa Hamueli, aliyemzaa Zakuri, na Zakuri akamzaa Shimei. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.26",
            "verseOrgIds": [
              "1CH.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei alikuwa na wana kumi na sita na binti sita, lakini ndugu zake hawakuwa na wana wengi, na jamii yake pia haikuongezeka kama kabila la Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.27",
            "verseOrgIds": [
              "1CH.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.27",
            "verseOrgIds": [
              "1CH.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miji walimokuwa wakiishi ilikuwa Beer-sheba, Molada, Hasar-shuali, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.28",
            "verseOrgIds": [
              "1CH.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilha, Ezemu, Toladi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.29",
            "verseOrgIds": [
              "1CH.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bethueli, Horma, Siklagi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.30",
            "verseOrgIds": [
              "1CH.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beth-markabothi, Hazar-susimu, Beth-biri na Shaaraimu. Hiyo ndiyo miji yao mpaka wakati wa utawala wa mfalme Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.31",
            "verseOrgIds": [
              "1CH.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia, waliishi katika miji mingine mitano: Etamu, Aini, Rimoni, Tokeni na Ashani, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.32",
            "verseOrgIds": [
              "1CH.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamoja na vijiji kandokando ya miji hiyo huko Baali. Hayo ndiyo yaliyokuwa makao yao, nao waliweka kumbukumbu ya nasaba yao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.33",
            "verseOrgIds": [
              "1CH.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wafuatao walikuwa wakuu wa koo zao: Meshobabu, Yamleki, Yosha mwana wa Amazia, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.34",
            "verseOrgIds": [
              "1CH.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoeli, Yehu (mwana wa Yoshibia, mwana wa Seraya, mwana wa Asieli.) ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.35",
            "verseOrgIds": [
              "1CH.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliehonai, Yaakoba, Yeshohaya, Asaya, Adieli, Yesimieli, Benaya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.36",
            "verseOrgIds": [
              "1CH.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziza (mwana wa Shifi, mwana wa Aloni, mwana wa Yedaya, mwana wa Shimri na mwana wa Shemaya). ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.37",
            "verseOrgIds": [
              "1CH.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jamaa zao waliendelea kuongezeka kwa wingi sana. Hawa waliotajwa majina ni wakuu katika jamaa zao na koo zao ziliongezeka sana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.38",
            "verseOrgIds": [
              "1CH.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walienea hadi kwenye lango la mji wa Gedori, upande wa mashariki wa bonde, ili kuwatafutia kondoo wao malisho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.39",
            "verseOrgIds": [
              "1CH.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapo, walipata malisho tele, tena mazuri sana na pia nchi ilikuwa wazi, tulivu na yenye amani, kwani wenyeji wa nchi hiyo wa hapo awali walikuwa Wahamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.40",
            "verseOrgIds": [
              "1CH.4.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.40",
            "verseOrgIds": [
              "1CH.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku za mfalme Hezekia wa Yuda, watu hao waliotajwa majina yao walikwenda huko Gedori, wakaharibu hema za Wameuni waliokuwa wakiishi huko na kuwafukuza kabisa mpaka leo. Walifanya makao yao ya kudumu huko kwa sababu kulikuwa na malisho tele kwa ajili ya kondoo wao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.41",
            "verseOrgIds": [
              "1CH.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wengine wa kabila la Simeoni wapatao 500 walikwenda mpaka kwenye mlima Seiri. Waliongozwa na Pelatia, Nearia, Refaya na Uzieli, wana wa Ishi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.42",
            "verseOrgIds": [
              "1CH.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapo waliwaua Waamaleki waliosalia baada ya kunusurika, na wakaishi huko mpaka leo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.43",
            "verseOrgIds": [
              "1CH.4.43"
            ]
          }
        }
      ]
    }
