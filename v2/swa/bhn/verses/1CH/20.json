              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya hayo, kulitokea vita na Wafilisti huko Gezeri. Sibekai, Mhushathi, akamuua Sipai aliyekuwa mmojawapo wa wazawa wa Warefai;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.4",
            "verseOrgIds": [
              "1CH.20.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:4",
              "type": "text"
            },
            {
              "text": "wazawa wa majitu:",
              "type": "text"
            },
            {
              "text": "Kiebrania: Warefai.",
              "type": "text"
            }
          ]
        },
        {
          "text": " hivyo Wafilisti wakawa wameshindwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.4",
            "verseOrgIds": [
              "1CH.20.4"
            ]
          }
        }
      ]
    },
    {
