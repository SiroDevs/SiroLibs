            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.18",
            "verseOrgIds": [
              "1CH.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa waliandikishwa kulingana na kazi zao kuingia katika nyumba ya Mwenyezi-Mungu kutoa huduma, kadiri ya utaratibu waliowekewa na Aroni babu yao, kama alivyoamriwa na Mwenyezi-Mungu, Mungu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa ndio wazawa wengine wa Lawi: Mmoja wa wazawa wa Amramu alikuwa Shubaeli; wa Shubaeli alikuwa Yedeya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.20",
            "verseOrgIds": [
              "1CH.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmoja wa wazawa wa Rehabia alikuwa Ishio kiongozi wa ukoo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.21",
            "verseOrgIds": [
              "1CH.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmoja wa wazawa wa Ishio alikuwa Shelomithi na wa wazawa wa Shelomithi alikuwa Yahathi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.22",
            "verseOrgIds": [
              "1CH.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Hebroni walikuwa: Yeria wa kwanza, Amaria wa pili, Yahazieli wa tatu, Yakameamu wa nne. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.23",
            "verseOrgIds": [
              "1CH.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmoja wa wana wa Uzieli alikuwa Mika. Mmoja wa wazawa wa Mika alikuwa Shamire. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.24",
            "verseOrgIds": [
              "1CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmoja wa wazawa wa Ishia nduguye Mika alikuwa Zekaria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.25",
            "verseOrgIds": [
              "1CH.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Merari: Mahli, Mushi na Yaazia; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.26",
            "verseOrgIds": [
              "1CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "wazawa wa Merari kwa mwanawe Yaazia: Shohamu, Zakuri na Ibri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.27",
            "verseOrgIds": [
              "1CH.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Mahli: Eleazari ambaye hakupata mtoto, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.28",
            "verseOrgIds": [
              "1CH.24.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kishi ambaye alikuwa na mwana mmoja: Yerameeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.29",
            "verseOrgIds": [
              "1CH.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushi alikuwa na wana watatu: Mahli, Ederi na Yeremothi. Wao ni wazawa wa Lawi kulingana na koo zao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.30",
            "verseOrgIds": [
              "1CH.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia hao wote walipiga kura kufuatana na ukoo wa kila mkuu na mdogo wake, kama wazawa wa Aroni walivyofanya. Walipiga kura mbele ya mfalme Daudi, Sadoki, Ahimeleki na viongozi wa jamaa za makuhani na za Walawi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.31",
            "verseOrgIds": [
              "1CH.24.31"
            ]
          }
        }
      ]
    }
