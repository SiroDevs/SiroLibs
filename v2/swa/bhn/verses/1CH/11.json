  "reference": "1 Mambo Ya Nyakati 11",
  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "1CH 11"
      },
      "items": [
        {
          "text": "11",
