              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halafu, Mose akakariri maneno ya wimbo huu mbele ya kusanyiko lote la Waisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.30",
