              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwanamume huyo alimshika kwa nguvu huyo msichana huko mbugani, na ingawa alipiga kelele kuomba msaada hapakuwa na mtu wa kumsaidia.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
            "verseOrgIds": [
