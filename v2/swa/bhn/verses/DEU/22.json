            }
          ]
        },
        {
          "text": "mtawatoa wote wawili nje ya mji na kuwapiga mawe mpaka wafe. Msichana huyo lazima auawe kwa kuwa hakupiga kelele asaidiwe ingawa alikuwa mjini; naye mwanamume lazima auawe kwa kuwa amemchafua mchumba wa jirani yake. Ndivyo mtakavyokomesha uovu huo miongoni mwenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
