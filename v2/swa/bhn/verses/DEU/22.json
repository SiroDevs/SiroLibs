          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msimtendee huyo msichana chochote; yeye hana kosa linalostahili adhabu ya kifo. Tukio hili ni sawa na la mtu anayemshambulia mtu mwingine na kumwua, kwa sababu ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.26",
            "verseOrgIds": [
