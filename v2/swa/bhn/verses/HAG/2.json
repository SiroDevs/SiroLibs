              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.5",
            "verseOrgIds": [
              "HAG.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAG 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.6",
            "verseOrgIds": [
              "HAG.2.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Ebr 12:26",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Naam, mimi Mwenyezi-Mungu wa majeshi nasema, hivi karibuni nitazitikisa mbingu na dunia, bahari na nchi kavu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.6",
            "verseOrgIds": [
              "HAG.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitayatikisa mataifa yote na hazina zao zote zitaletwa humu, nami nitalifanya hekalu hili kuwa la fahari. Mimi nimesema. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.7",
            "verseOrgIds": [
              "HAG.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fedha na dhahabu yote duniani ni mali yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.8",
            "verseOrgIds": [
              "HAG.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hekalu jipya litakuwa lenye fahari zaidi kuliko lile la awali, na mahali hapo ndipo nitakapowapa watu wangu fanaka.” Asema Mwenyezi-Mungu wa majeshi.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.9",
            "verseOrgIds": [
              "HAG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.9",
            "verseOrgIds": [
              "HAG.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnamo siku ya ishirini na nne ya mwezi wa tisa, katika mwaka wa pili wa utawala wa Dario, neno la Mwenyezi-Mungu wa majeshi lilimjia nabii Hagai, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.10",
            "verseOrgIds": [
              "HAG.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAG 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "akamwambia: “Waambie makuhani watoe uamuzi juu ya jambo hili: ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.11",
            "verseOrgIds": [
              "HAG.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAG 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mtu akichukua nyama takatifu katika upindo wa vazi lake, kisha akagusa kwa upindo wa vazi hilo mkate au chakula kilichopikwa, au divai, au mafuta au chakula cha aina yoyote ile, je, chakula hicho kitakuwa kitakatifu?” Makuhani wakamjibu, “La, hasha.” ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.12",
            "verseOrgIds": [
              "HAG.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAG 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Hes 19:11-22",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hagai akawauliza tena, “Je, mtu aliye najisi kwa kugusa maiti, akigusa baadhi ya vyakula hivi, chakula hicho kitakuwa najisi?” Makuhani wakamjibu, “Ndiyo, kitakuwa najisi.” ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.13",
            "verseOrgIds": [
              "HAG.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAG 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapo Hagai akawaambia, “Mwenyezi-Mungu asema kwamba, hivyo ndivyo ilivyo kwa watu wa taifa hili na kila kitu wanachofanya; kadhalika na kila wanachotoa madhabahuni ni najisi.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.14",
            "verseOrgIds": [
              "HAG.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAG 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.14",
            "verseOrgIds": [
              "HAG.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lakini sasa angalieni mambo yatakayotukia. Kabla ya kuanza kujenga upya hekalu langu, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.15",
            "verseOrgIds": [
              "HAG.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HAG 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "hali yenu ilikuwaje? Mliliendea fungu la nafaka mkitarajia kupata vipimo ishirini, lakini kulikuwa na vipimo kumi tu. Mliliendea pipa la divai mkitarajia kujaza vyombo hamsini, lakini mlikuta ishirini tu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.16",
            "verseOrgIds": [
              "HAG.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HAG 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niliwapiga kwa ukame, ukungu na mvua ya mawe, nikaharibu kila mlichojaribu kupanda, lakini hata hivyo hamkunirudia. Nasema mimi Mwenyezi-Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.17",
            "verseOrgIds": [
              "HAG.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HAG 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leo ni siku ya ishirini na nne ya mwezi wa tisa, siku ambayo msingi wa hekalu umekamilika. Basi, ngojeni mwone yale yatakayotokea tangu leo. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.18",
            "verseOrgIds": [
              "HAG.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HAG 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingawa sasa hamna nafaka ghalani, nayo mizabibu, mitini, mikomamanga na mizeituni haijazaa kitu, lakini tangu leo, nitawabariki.”",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.19",
            "verseOrgIds": [
              "HAG.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HAG 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.19",
            "verseOrgIds": [
              "HAG.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HAG 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku hiyohiyo ya ishirini na nne, mwezi wa tisa, neno la Mwenyezi-Mungu lilimjia Hagai mara ya pili: ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.20",
            "verseOrgIds": [
              "HAG.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HAG 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ongea na Zerubabeli mkuu wa Yuda, umwambie hivi: Niko karibu kuzitikisa mbingu na dunia, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.21",
            "verseOrgIds": [
              "HAG.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HAG 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuangusha falme na kukomesha nguvu zao. Nitayapindua magari yao ya farasi na wapandafarasi wake, nao wataanguka na kuuana wao kwa wao. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.22",
            "verseOrgIds": [
              "HAG.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HAG 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku hiyo, nitakuchukua wewe mtumishi wangu Zerubabeli mwana wa Shealtieli, na kukuteua ili utawale kwa jina langu. Wewe ndiwe niliyekuchagua.” Mwenyezi-Mungu wa majeshi amesema.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.23",
            "verseOrgIds": [
              "HAG.2.23"
            ]
          }
        }
      ]
    }
  ],
