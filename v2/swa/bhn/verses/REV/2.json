          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi pia nimepokea mamlaka hayo kutoka kwa Baba yangu. Tena nitampa nyota ya asubuhi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.28",
            "verseOrgIds": [
