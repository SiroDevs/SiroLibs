            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Zab 7:9; 62:12",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tena nitawaua wafuasi wake, ili makanisa yote yatambue kwamba mimi ndiye ninayechunguza mioyo na fikira za watu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.23",
            "verseOrgIds": [
              "REV.2.23"
            ]
          }
        }
