        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.6",
            "verseOrgIds": [
              "REV.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aliye na masikio, basi, na asikie yale Roho anayoyaambia makanisa!",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mshindi nitamjalia kula matunda ya mti wa uhai ulioko ndani ya bustani ya Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
          }
        }
      ]
    },
    {
