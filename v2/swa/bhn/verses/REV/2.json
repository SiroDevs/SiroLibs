              "text": "Taz Zab 2:8-9",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mshindi na mwenye kuzingatia mpaka mwisho mambo ninayotaka, nitampa mamlaka juu ya watu wa mataifa: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.26",
