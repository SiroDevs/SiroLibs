          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.20",
            "verseOrgIds": [
              "REV.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawatakieni nyote neema ya Bwana Yesu. Amina.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.21",
            "verseOrgIds": [
              "REV.22.21"
            ]
          }
        }
      ]
