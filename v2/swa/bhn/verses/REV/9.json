            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Zab 115:4-7; 135:15-17",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wanadamu wengine waliobaki ambao hawakuuawa na mabaa hayo, hawakutubu na kuviacha vitu walivyokuwa wametengeneza kwa mikono yao wenyewe; wala kuacha kuabudu pepo, sanamu za dhahabu, fedha, shaba, mawe na miti, vitu ambavyo haviwezi kuona, kusikia wala kutembea. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.20",
            "verseOrgIds": [
              "REV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wala hawakutubu na kuacha kufanya mauaji, uchawi, uzinzi, na wizi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.21",
            "verseOrgIds": [
              "REV.9.21"
            ]
          }
        }
      ]
    }
  ],
