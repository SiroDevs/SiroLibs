          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkewe Shauli aliitwa Ahinoamu binti Ahimaasi. Kamanda wa jeshi la Shauli aliitwa Abneri, mwana wa Neri, mjomba wa Shauli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.50",
            "verseOrgIds": [
              "1SA.14.50"
            ]
          }
        },
