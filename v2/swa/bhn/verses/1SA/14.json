          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1SA 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba wa Shauli alikuwa Kishi na baba wa Abneri alikuwa Neri mwana wa Abieli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.51",
            "verseOrgIds": [
              "1SA.14.51"
            ]
