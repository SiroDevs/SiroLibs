              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.44",
            "verseOrgIds": [
              "1SA.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1SA 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini watu wakamwambia Shauli, “Mbona Yonathani aliyeiletea Israeli ushindi huu mkubwa, auawe? Jambo hilo liwe mbali. Twaapa kwa Mwenyezi-Mungu aliye hai, hata unywele wa kichwa chake hautaanguka chini. Alichokifanya leo, amekifanya kwa msaada wa Mwenyezi-Mungu.” Hivyo, watu walimkomboa Yonathani naye hakuuawa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.45",
            "verseOrgIds": [
              "1SA.14.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1SA 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.45",
            "verseOrgIds": [
              "1SA.14.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Shauli aliacha kuwafuatia Wafilisti, nao Wafilisti wakarudi makwao.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.46",
            "verseOrgIds": [
              "1SA.14.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.46",
            "verseOrgIds": [
              "1SA.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1SA 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya Shauli kuwa mfalme wa Israeli, alipigana na adui zake kila upande: Wamoabu, Waamoni, Waedomu, wafalme wa Soba, na Wafilisti. Kila alipopigana vita, alishinda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.47",
            "verseOrgIds": [
              "1SA.14.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipigana kwa uhodari, akawashinda Waamaleki. Aliwaokoa Waisraeli kutoka kwa watu wote waliowashambulia.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.48",
            "verseOrgIds": [
              "1SA.14.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
