{
  "id": "1SA.12",
  "number": "12",
  "bookId": "1SA",
  "reference": "1 Samueli 12",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
