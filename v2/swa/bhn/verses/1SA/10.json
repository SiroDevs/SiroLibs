          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia, Shauli pamoja na wapiganaji hodari ambao awali Mungu aligusa mioyo yao, alikwenda nyumbani kwake huko mjini Gibea. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.26",
            "verseOrgIds": [
              "1SA.10.26"
            ]
          }
        },
