        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.12",
            "verseOrgIds": [
              "HEB.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kusema juu ya agano jipya, Mungu alilichakaza lile la kwanza; na chochote kinachochakaa na kuwa kikuukuu kitatoweka karibuni.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.13",
