              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.1",
            "verseOrgIds": [
              "MAL.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.2",
            "verseOrgIds": [
              "MAL.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Yoe 2:11; Ufu 6:17",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lakini ni nani atakayestahimili siku hiyo atakapokuja? Ni nani atakayesimama kustahimili atakapotokea? Yeye ni kama moto mkali usafishao chuma; ni kama sabuni ya dobi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.2",
            "verseOrgIds": [
              "MAL.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye atakuja kuhukumu kama mtu asafishaye na kutakasa fedha. Atawasafisha wazawa wa Lawi, kama mtu afuavyo dhahabu au fedha, mpaka wamtolee Mwenyezi-Mungu tambiko zinazokubalika. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.3",
            "verseOrgIds": [
              "MAL.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo, tambiko za watu wa Yuda na wa Yerusalemu zitampendeza Mwenyezi-Mungu kama za watu wa kale; kama katika miaka ya zamani.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.4",
            "verseOrgIds": [
              "MAL.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.4",
            "verseOrgIds": [
              "MAL.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu wa majeshi asema: “Kisha nitawakaribia ili kuwahukumu. Sitasita kutoa ushahidi dhidi ya wachawi, wazinzi, watoa ushahidi wa uongo, wanaowapunja waajiriwa, wanaowadhulumu wageni na wale wasionicha mimi.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.5",
            "verseOrgIds": [
              "MAL.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.5",
            "verseOrgIds": [
              "MAL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mimi ni Mwenyezi-Mungu, mimi sibadiliki. Lakini nyinyi, nyinyi wazawa wa Yakobo hamjatoweka bado. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.6",
            "verseOrgIds": [
              "MAL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tangu wakati wa wazee wenu, mmezidharau kanuni zangu wala hamkuzifuata. Basi, mimi Mwenyezi-Mungu, Mungu Mkuu nasema: Nirudieni, nami nitawageukieni. Lakini nyinyi mnauliza, ‘Tutakurudia namna gani?’ Nami nawaulizeni, ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.7",
            "verseOrgIds": [
              "MAL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, ni sawa mtu kumdanganya Mungu? La! Lakini nyinyi mnanidanganya! Walakini nyinyi mwauliza: ‘Tunakudanganya kwa namna gani?’ Naam! Mnanidanganya kuhusu zaka na tambiko zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.8",
            "verseOrgIds": [
              "MAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyinyi na taifa lenu lote mmelaaniwa kwa sababu ya kunidanganya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.9",
            "verseOrgIds": [
              "MAL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Taz Lawi 27:30; Hes 18:21-24; Kumb 12:6; 14:22-29; Neh 13:12",
              "type": "text"
            }
          ]
        },
        {
          "text": " Leteni ghalani mwangu zaka yote, ili nyumbani mwangu kuwe na chakula cha kutosha. Kisha mwaweza kunijaribu. Nijaribuni namna hiyo nanyi mtaona kama sitayafungua madirisha ya mbinguni na kuwatiririshia baraka tele. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.10",
            "verseOrgIds": [
              "MAL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadudu waharibifu nitawakemea wasiyaharibu tena mazao yenu. Mizabibu yenu mashambani haitaacha kuzaa matunda. Mimi Mwenyezi-Mungu wa majeshi nimesema. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.11",
            "verseOrgIds": [
              "MAL.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mataifa yote yatawaita nyinyi watu waliobarikiwa, maana nchi yenu itakuwa nchi ya furaha. Mimi Mwenyezi-Mungu, Mungu Mkuu nimesema.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.12",
            "verseOrgIds": [
              "MAL.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.12",
            "verseOrgIds": [
              "MAL.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi-Mungu asema hivi: “Maneno yenu yamekuwa mzigo kwangu. Hata hivyo mnasema, ‘Tumesema nini dhidi yako?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.13",
            "verseOrgIds": [
              "MAL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyinyi mmesema, ‘Kumtumikia Mungu hakuna faida. Kuna faida gani kuyatii maagizo ya Mwenyezi-Mungu wa majeshi, au kujaribu kumwonesha kuwa tumekosa mbele yake kwa kutembea kama watu wanaoomboleza? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.14",
            "verseOrgIds": [
              "MAL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuonavyo sisi, ni kwamba, wenye kiburi ndio wenye furaha daima. Watu waovu, licha ya kustawi, hata wanapomjaribu Mungu, hawapati adhabu.’”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.15",
            "verseOrgIds": [
              "MAL.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.15",
            "verseOrgIds": [
              "MAL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo watu wanaomcha Mwenyezi-Mungu walipozungumza wao kwa wao, naye Mwenyezi-Mungu akasikia mazungumzo yao. Mbele yake kikawekwa kitabu ambamo iliandikwa kumbukumbu ya wale wanaomcha na kumheshimu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.16",
            "verseOrgIds": [
              "MAL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iliandikwa hivi: Mwenyezi-Mungu asema: “Hao watakuwa watu wangu. Watakuwa urithi wangu maalumu siku ile nitakapoinuka kufanya ninalokusudia. Sitawadhuru kama vile baba asivyomdhuru mwanawe anayemtumikia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.17",
            "verseOrgIds": [
              "MAL.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAL 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapo ndipo mtakapotambua tena tofauti iliyopo kati ya waadilifu na waovu; naam, kati ya mtu anayemtumikia Mungu na asiyemtumikia.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.18",
            "verseOrgIds": [
              "MAL.3.18"
            ]
          }
        }
      ]
    }
  ],
