              "2CH.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matendo mengine ya Solomoni, kutoka mwanzo hadi mwisho, yameandikwa katika kitabu cha “Historia ya Nabii Nathani,” katika “Unabii wa Ahiya wa Shilo,” na katika “Maono ya Ido” mwonaji, ambayo yahusu pia Yeroboamu mwana wa Nebati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni alitawala nchi yote ya Israeli kwa miaka arubaini. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatimaye Solomoni alifariki dunia na kuzikwa katika mji wa Daudi baba yake. Rehoboamu, mwanawe, akatawala mahali pake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
          }
        }
