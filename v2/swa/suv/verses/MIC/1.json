            {
              "text": "28:1—32:33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hili ndilo neno la BWANA lililomjia Mika, Mmorashti, katika siku za Yothamu, na Ahazi, na Hezekia, wafalme wa Yuda; maono aliyoyaona katika habari za Samaria, na Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.1",
            "verseOrgIds": [
              "MIC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hukumu Yatangazwa dhidi ya Samaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
