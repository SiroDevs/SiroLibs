                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kama vile Mungu Baba alivyotangulia kuwajua katika kutakaswa na Roho, hata mkapata kutii na kununyiziwa damu ya Yesu Kristo. Neema na amani na ziongezwe kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
