          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitaitakasa damu yao ambayo sijaitakasa; kwa maana BWANA ndiye akaaye Sayuni.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.21",
