            }
          ]
        },
        {
          "text": "nitakusanya mataifa yote, nami nitawaleta chini katika bonde la Yehoshafau, na huko nitawahukumu kwa ajili ya watu wangu, na kwa ajili ya urithi wangu, Israeli, ambao wamewatawanya kati ya mataifa, na kuigawanya nchi yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
