            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tangazeni haya kati ya mataifa; takaseni vita; waamsheni mashujaa; watu wa vita na wakaribie; na wapande juu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
              "JOL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOL 3:10"
          },
          "items": [
            {
