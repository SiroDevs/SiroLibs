              "items": [
                {
                  "text": "Zab 96:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mataifa na wajihimize, wakapande juu katika bonde la Yehoshafau; maana huko ndiko nitakakoketi niwahukumu mataifa yote yaliyo pande zote. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.12",
            "verseOrgIds": [
              "JOL.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOL 3:13"
          },
          "items": [
