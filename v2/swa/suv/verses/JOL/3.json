              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.8"
              },
              "items": [
                {
                  "text": "Zek 12:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.4"
              },
              "items": [
                {
                  "text": "Isa 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.4.3"
              },
              "items": [
                {
                  "text": "Mik 4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yafueni majembe yenu yawe panga, na miundu yenu iwe mikuki; aliye dhaifu na aseme, Mimi ni hodari. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.10",
            "verseOrgIds": [
              "JOL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fanyeni haraka, mje, enyi mataifa yote, wa pande zote, jikusanyeni pamoja; na huko watelemshe mashujaa wako wote, Ee BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.11",
            "verseOrgIds": [
              "JOL.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.26"
              },
              "items": [
                {
                  "text": "2 Nya 20:26",
                  "type": "text"
