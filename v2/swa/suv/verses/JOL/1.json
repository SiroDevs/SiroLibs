                }
              ]
            }
          ]
        },
        {
          "text": "Je! Chakula hakikukatiliwa mbali mbele ya macho yetu? Naam, furaha na kicheko mbali na nyumba ya Mungu wetu? ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.16",
            "verseOrgIds": [
              "JOL.1.16"
            ]
          }
