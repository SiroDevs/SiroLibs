          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbegu zinaoza chini ya udongo wake; ghala zimeachwa ukiwa; mabanda yamevunjika; kwa maana nafaka imekauka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.17",
            "verseOrgIds": [
