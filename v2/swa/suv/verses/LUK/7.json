                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.1"
              },
              "items": [
                {
                  "text": "61:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo alipojibu, akawaambia, Nendeni mkamweleze Yohana hayo mliyoyaona na kuyasikia; vipofu wanapata kuona, viwete wanatembea, wenye ukoma wanatakasika, viziwi wanasikia, wafu wanafufuliwa, maskini wanahubiriwa habari njema. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.22",
            "verseOrgIds": [
              "LUK.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye heri mtu ye yote asiyechukizwa nami.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.23",
            "verseOrgIds": [
              "LUK.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.23",
            "verseOrgIds": [
              "LUK.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, wajumbe wa Yohana walipokwisha ondoka, alianza kuwaambia makutano habari za Yohana, Mlitoka kwenda nyikani kutazama nini? Unyasi ukitikiswa na upepo? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.24",
            "verseOrgIds": [
              "LUK.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mlitoka kwenda kuona nini? Mtu aliyevikwa mavazi mororo? Jueni, watu wenye mavazi ya utukufu, wanaokula raha, wamo katika majumba ya kifalme. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.25",
            "verseOrgIds": [
              "LUK.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.76"
              },
              "items": [
                {
                  "text": "Lk 1:76",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini, mlitoka kwenda kuona nini? Nabii? Naam, nawaambia, na aliye zaidi ya nabii. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.26",
            "verseOrgIds": [
              "LUK.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.1"
              },
              "items": [
                {
                  "text": "Mal 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Huyo ndiye aliyeandikiwa haya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.27",
            "verseOrgIds": [
              "LUK.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwanamke mwenye Dhambi Asamehewa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.35",
            "verseOrgIds": [
              "LUK.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.36",
            "verseOrgIds": [
              "LUK.7.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.37"
              },
              "items": [
                {
                  "text": "Lk 11:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu mmoja katika Mafarisayo alimwalika ale chakula kwake; akaingia katika nyumba yake yule Farisayo, akaketi chakulani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.36",
            "verseOrgIds": [
              "LUK.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.7+MAT.26.8+MAT.26.9+MAT.26.10+MAT.26.11+MAT.26.12+MAT.26.13"
              },
              "items": [
                {
                  "text": "Mt 26:7-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.14.3"
              },
              "items": [
                {
                  "text": "Mk 14:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.3+JHN.12.4+JHN.12.5+JHN.12.6+JHN.12.7+JHN.12.8"
              },
              "items": [
                {
                  "text": "Yn 12:3-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na tazama, mwanamke mmoja wa mji ule, aliyekuwa mwenye dhambi, alipopata habari ya kuwa ameketi chakulani katika nyumba ya yule Farisayo, alileta chupa ya marimari yenye marhamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.37",
            "verseOrgIds": [
              "LUK.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.7+MAT.26.8+MAT.26.9+MAT.26.10+MAT.26.11+MAT.26.12+MAT.26.13"
              },
              "items": [
                {
                  "text": "Mt 26:7-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.3+JHN.12.4+JHN.12.5+JHN.12.6+JHN.12.7+JHN.12.8"
              },
              "items": [
                {
                  "text": "Yn 12:3-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akasimama nyuma karibu na miguu yake, akilia, akaanza kumdondoshea miguu machozi yake, na kuipangusa kwa nywele za kichwa chake, akiibusu-busu miguu yake na kuipaka yale marhamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.38",
            "verseOrgIds": [
              "LUK.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, yule Farisayo aliyemwalika alipoona vile, alisema moyoni mwake, Mtu huyu kama angekuwa nabii, angemtambua mwanamke huyu amgusaye, ni nani, naye ni wa namna gani, ya kwamba ni mwenye dhambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.39",
            "verseOrgIds": [
              "LUK.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akajibu akamwambia, Simoni, nina neno nitakalo kukuambia. Akasema, Mwalimu, nena. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.40",
            "verseOrgIds": [
              "LUK.7.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasema, Mtu mmoja mkopeshaji alikuwa na wadeni wawili; mmoja amwia dinari mia tano, na wa pili hamsini. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.41",
            "verseOrgIds": [
              "LUK.7.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao walipokuwa hawana cha kumlipa, aliwasamehe wote wawili. Katika hao wawili ni yupi atakayempenda zaidi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.42",
            "verseOrgIds": [
              "LUK.7.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni akajibu akasema, Nadhani ni yule ambaye alimsamehe nyingi. Akamwambia, Umeamua haki. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.43",
            "verseOrgIds": [
              "LUK.7.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.4"
              },
              "items": [
                {
                  "text": "Mwa 18:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akamgeukia yule mwanamke, akamwambia Simoni, Wamwona mwanamke huyu? Niliingia nyumbani kwako, hukunipa maji kwa miguu yangu; bali huyu amenidondoshea machozi miguu yangu, na kuipangusa kwa nywele za kichwa chake. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.44",
            "verseOrgIds": [
              "LUK.7.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.16"
              },
              "items": [
                {
                  "text": "Rum 16:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wewe hukunibusu; lakini huyu tangu nilipoingia hakuacha kunibusu sana miguu yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.45",
            "verseOrgIds": [
              "LUK.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hukunipaka kichwa changu mafuta; bali huyu amenipaka miguu yangu marhamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.46",
            "verseOrgIds": [
              "LUK.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa ajili ya hayo nakuambia, Amesamehewa dhambi zake ambazo ni nyingi, kwa kuwa amependa sana; lakini asamehewaye kidogo, huyo hupenda kidogo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.47",
            "verseOrgIds": [
              "LUK.7.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.20"
              },
              "items": [
                {
                  "text": "Lk 5:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha alimwambia mwanamke, Umesamehewa dhambi zako. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.48",
            "verseOrgIds": [
              "LUK.7.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 7:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo wale walioketi chakulani pamoja naye walianza kusema mioyoni mwao, Ni nani huyu hata asamehe dhambi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.49",
            "verseOrgIds": [
              "LUK.7.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.48"
              },
              "items": [
                {
                  "text": "Lk 8:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.19"
              },
              "items": [
                {
                  "text": "17:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.42"
              },
              "items": [
                {
                  "text": "18:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akamwambia yule mwanamke, Imani yako imekuokoa, enenda zako kwa amani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.50",
            "verseOrgIds": [
              "LUK.7.50"
            ]
          }
        }
      ]
    }
