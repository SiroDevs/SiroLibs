                {
                  "text": "Mt 8:5-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipokwisha kuyamaliza maneno yake yote masikioni mwa watu, aliingia Kapernaumu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.1",
            "verseOrgIds": [
              "LUK.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.1",
            "verseOrgIds": [
              "LUK.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.2",
            "verseOrgIds": [
              "LUK.7.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.47"
              },
              "items": [
                {
                  "text": "Yn 4:47",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mtumwa wake akida mmoja alikuwa hawezi, karibu na kufa; naye ni mtu aliyempenda sana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.2",
            "verseOrgIds": [
              "LUK.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliposikia habari za Yesu, alituma wazee wa Wayahudi kwake kumwomba aje amponye mtumwa wake. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.3",
            "verseOrgIds": [
              "LUK.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao walipofika kwa Yesu, walimsihi sana wakisema, Amestahili huyu umtendee neno hili; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.4",
            "verseOrgIds": [
              "LUK.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "maana, analipenda taifa letu, naye alitujengea sinagogi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.5",
            "verseOrgIds": [
              "LUK.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yesu akaenda pamoja nao. Hata alipokuwa si mbali na nyumba yake, yule akida alituma rafiki kwake, akamwambia, Bwana, usijisumbue, maana mimi sistahili wewe uingie chini ya dari yangu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.6",
            "verseOrgIds": [
              "LUK.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa hiyo nilijiona sistahili mwenyewe kuja kwako; lakini, sema neno tu, na mtumwa wangu atapona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.7",
            "verseOrgIds": [
              "LUK.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana mimi nami ni mtu niliyewekwa chini ya mamlaka, mwenye askari chini yangu; nikimwambia huyu, Nenda, huenda; na huyu, Njoo, huja; na mtumwa wangu, Fanya hivi, hufanya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.8",
            "verseOrgIds": [
              "LUK.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aliposikia hayo alimstaajabia, akaugeukia mkutano uliokuwa ukimfuata, akasema, Nawaambia, hata katika Israeli sijaona imani kubwa namna hii. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.9",
            "verseOrgIds": [
              "LUK.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wale waliotumwa waliporudi nyumbani, wakamkuta yule mtumwa ni mzima.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.10",
            "verseOrgIds": [
              "LUK.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Amfufua Mtoto wa Mama Mjane",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.10",
            "verseOrgIds": [
              "LUK.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baadaye kidogo alikwenda mpaka mji mmoja uitwao Naini, na wanafunzi wake walifuatana naye pamoja na mkutano mkubwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.11",
            "verseOrgIds": [
              "LUK.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.42"
              },
              "items": [
                {
                  "text": "Lk 8:42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.17"
              },
              "items": [
                {
                  "text": "1 Fal 17:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na alipolikaribia lango la mji, hapo palikuwa na maiti anachukuliwa nje, ni mwana pekee wa mamaye ambaye ni mjane, na watu wa mjini wengi walikuwa pamoja naye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.12",
            "verseOrgIds": [
              "LUK.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana alipomwona alimwonea huruma, akamwambia, Usilie. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.13",
            "verseOrgIds": [
              "LUK.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakaribia, akaligusa jeneza; wale waliokuwa wakilichukua wakasimama. Akasema, Kijana, nakuambia, Inuka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.14",
            "verseOrgIds": [
              "LUK.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.23"
              },
              "items": [
                {
                  "text": "1 Fal 17:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.36"
              },
              "items": [
                {
                  "text": "2 Fal 4:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yule maiti akainuka, akaketi, akaanza kusema. Akampa mama yake. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.15",
            "verseOrgIds": [
              "LUK.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.68"
              },
              "items": [
                {
                  "text": "Lk 1:68",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.44"
              },
              "items": [
                {
                  "text": "19:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hofu ikawashika wote, wakamtukuza Mungu, wakisema, Nabii mkuu ametokea kwetu; na, Mungu amewaangalia watu wake. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.16",
            "verseOrgIds": [
              "LUK.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habari hii yake ikaenea katika Uyahudi wote, na katika nchi zote za kando kando.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.17",
            "verseOrgIds": [
              "LUK.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ujumbe kutoka kwa Yohana Mbatizaji",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.17",
            "verseOrgIds": [
              "LUK.7.17"
            ]
          }
        },
        {
