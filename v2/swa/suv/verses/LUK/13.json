                "loc": "LUK.3.9"
              },
              "items": [
                {
                  "text": "Lk 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.10"
              },
              "items": [
                {
                  "text": "Mt 3:10",
