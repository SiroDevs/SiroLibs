              "type": "tag",
              "attrs": {
                "loc": "MAT.13.31+MAT.13.32+MAT.13.33"
              },
              "items": [
                {
                  "text": "Mt 13:31-33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.30+MRK.4.31+MRK.4.32"
              },
              "items": [
                {
                  "text": "Mk 4:30-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha alisema, Ufalme wa Mungu umefanana na nini? Nami niufananishe na nini? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
          }
        },
