        },
        {
          "text": "Saa ile ile Mafarisayo kadha wa kadha walimwendea, wakamwambia, Toka hapa, uende mahali pengine, kwa sababu Herode anataka kukuua. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.31",
            "verseOrgIds": [
