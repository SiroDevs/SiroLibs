          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamoja na hayo imenipasa kushika njia yangu leo na kesho na kesho kutwa; kwa kuwa haimkini nabii aangamie nje ya Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.33",
            "verseOrgIds": [
