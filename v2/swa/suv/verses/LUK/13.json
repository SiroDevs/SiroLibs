                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.13"
              },
              "items": [
                {
                  "text": "Mk 11:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akanena mfano huu; Mtu mmoja alikuwa na mtini umepandwa katika shamba lake la mizabibu; akaenda akitafuta matunda juu yake, asipate. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamwambia mtunzaji wa shamba la mizabibu, Tazama, miaka mitatu hii naja nikitafuta matunda juu ya mtini huu, nisipate kitu; uukate, mbona hata nchi unaiharibu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.7",
            "verseOrgIds": [
              "LUK.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.9"
              },
              "items": [
                {
                  "text": "2 Pet 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akajibu akamwambia, Bwana, uuache mwaka huu nao, hata niupalilie, niutilie samadi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.8",
            "verseOrgIds": [
              "LUK.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao ukizaa matunda baadaye, vema! La, usipozaa, ndipo uukate.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.9",
            "verseOrgIds": [
              "LUK.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Amponya Mwanamke Mlemavu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.9",
            "verseOrgIds": [
              "LUK.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ya sabato alikuwa akifundisha katika sinagogi mojawapo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.10",
            "verseOrgIds": [
              "LUK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tazama, palikuwa na mwanamke aliyekuwa na pepo wa udhaifu muda wa miaka kumi na minane, naye amepindana, hawezi kujinyosha kabisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.11",
            "verseOrgIds": [
              "LUK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alipomwona alimwita, akamwambia, Mama, umefunguliwa katika udhaifu wako. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.12",
            "verseOrgIds": [
              "LUK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.32"
              },
              "items": [
                {
                  "text": "Mk 7:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akaweka mikono yake juu yake, naye akanyoka mara hiyo, akamtukuza Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.13",
            "verseOrgIds": [
              "LUK.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.9+EXO.20.10"
              },
              "items": [
                {
                  "text": "Kut 20:9-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Kum 5:13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi mkuu wa sinagogi alikasirika kwa sababu Yesu amemponya mtu siku ya sabato, akajibu, akawaambia mkutano, Kuna siku sita zifaazo kufanya kazi, basi njoni mponywe katika siku hizo, wala si katika siku ya sabato. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.14",
            "verseOrgIds": [
              "LUK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.5"
              },
              "items": [
                {
                  "text": "Lk 14:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini Bwana akajibu akasema, Enyi wanafiki, kila mmoja wenu, je! Hamfungui ng’ombe wake au punda wake siku ya sabato katika zizi, aende naye kumnywesha? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.15",
            "verseOrgIds": [
              "LUK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.9"
              },
              "items": [
                {
                  "text": "Lk 19:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.25"
              },
              "items": [
                {
                  "text": "Mdo 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na huyu mwanamke, aliye wa uzao wa Ibrahimu, ambaye Shetani amemfunga miaka kumi na minane hii, haikupasa afunguliwe kifungo hiki siku ya sabato? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.16",
            "verseOrgIds": [
              "LUK.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliposema haya wakatahayari wote walioshindana naye; mkutano wote wakafurahi kwa sababu ya mambo matukufu yaliyotendwa na yeye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.17",
            "verseOrgIds": [
              "LUK.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mfano wa Punje ya Haradali",
          "type": "text"
        }
      ]
    },
