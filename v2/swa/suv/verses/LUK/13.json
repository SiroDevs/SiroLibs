          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaambia, Nendeni, mkamwambie yule mbweha, Tazama, leo na kesho natoa pepo na kuponya wagonjwa, siku ya tatu nakamilika. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
