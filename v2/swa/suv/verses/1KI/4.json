              "items": [
                {
                  "text": "Kum 3:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Geberi mwana wa Uri, katika nchi ya Gileadi, nchi ya Sihoni mfalme wa Waamori, na Ogu mfalme wa Bashani; naye alikuwa akida wa pekee katika nchi hiyo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.19",
            "verseOrgIds": [
              "1KI.4.19"
            ]
          }
        }
      ]
    },
