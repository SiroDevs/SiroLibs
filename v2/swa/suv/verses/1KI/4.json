                "loc": "1KI.2.27"
              },
              "items": [
                {
                  "text": "2:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na Benaya mwana wa Yehoyada alikuwa juu ya jeshi; na Sadoki na Abiathari walikuwa makuhani; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.4",
            "verseOrgIds": [
              "1KI.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
