              "items": [
                {
                  "text": "Ebr 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye akajinyosha akalala chini ya mretemu; na tazama, malaika akamgusa, akamwambia, Inuka, ule. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.5",
            "verseOrgIds": [
              "1KI.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatazama, kumbe! Pana mkate umeokwa juu ya makaa, na gudulia la maji, kichwani pake. Akala, akanywa, akajinyosha tena. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.6",
            "verseOrgIds": [
              "1KI.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa BWANA akamwendea mara ya pili, akamgusa, akasema, Inuka, ule; maana safari hii ni kubwa mno kwako. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.7",
            "verseOrgIds": [
              "1KI.19.7"
            ]
          }
        },
        {
