        },
        {
          "text": "Ndipo Yezebeli akampelekea Eliya mjumbe, kusema, Miungu wanifanyie hivyo na kuzidi, nisipokufanya roho yako kesho, panapo wakati huu, kama roho ya mmojawapo wa hao. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.2",
            "verseOrgIds": [
              "1KI.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye alipoona hayo, aliondoka, akaenda aihifadhi roho yake, akafika Beer-sheba, mji wa Yuda, akamwacha mtumishi wake huko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.3",
            "verseOrgIds": [
              "1KI.19.3"
            ]
          }
        }
      ]
    },
