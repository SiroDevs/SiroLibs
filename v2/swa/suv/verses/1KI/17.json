              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipokuwa akienda kuleta, akamwita akasema, Niletee, nakuomba, kipande cha mkate mkononi mwako. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.11",
            "verseOrgIds": [
