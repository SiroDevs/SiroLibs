        },
        {
          "text": "Lile pipa la unga halikupunguka, wala ile chupa ya mafuta haikuisha, sawasawa na neno la BWANA alilolinena kwa kinywa cha Eliya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.16",
            "verseOrgIds": [
