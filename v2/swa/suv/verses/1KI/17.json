              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya akamtwaa mtoto, akamchukua toka orofani mpaka chini ya nyumba ile, akampa mama yake. Eliya akanena, Tazama, mwanao yu hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.23",
