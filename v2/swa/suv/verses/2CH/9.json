                "loc": "PSA.68.29"
              },
              "items": [
                {
                  "text": "Zab 68:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.10"
              },
              "items": [
                {
                  "text": "72:10",
                  "type": "text"
                }
