                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.24"
              },
              "items": [
                {
                  "text": "Yer 25:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mbali na ile waliyoileta wachuuzi na wafanya biashara; tena wafalme wote wa Arabuni, na maliwali wa nchi wakamletea Sulemani dhahabu na fedha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.14",
            "verseOrgIds": [
              "2CH.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme Sulemani akafanya ngao mia mbili za dhahabu iliyofuliwa; ngao moja hupata shekeli mia sita za dhahabu iliyofuliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.15",
            "verseOrgIds": [
              "2CH.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na vigao mia tatu vya dhahabu iliyofuliwa; kigao kimoja hupata shekeli mia tatu za dhahabu; mfalme akaviweka katika nyumba ya mwitu wa Lebanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.16",
            "verseOrgIds": [
              "2CH.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena mfalme akafanya kiti cha enzi kikubwa cha pembe, akakifunikiza kwa dhahabu iliyo safi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.17",
            "verseOrgIds": [
              "2CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiti kile kilikuwa na daraja sita, tena na kikao cha miguu cha dhahabu, navyo vilikuwa vimeshikamana na kiti; na mikono huko na huko mahali pa kuketi, na simba wawili wakisimama kando ya hiyo mikono. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.18",
            "verseOrgIds": [
              "2CH.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na simba kumi na wawili wamesimama juu ya daraja sita, huko na huko; wala hakikufanyika kwa mfano wake katika ufalme wo wote. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.19",
            "verseOrgIds": [
              "2CH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na vyombo vyote vya kunywea vya mfalme Sulemani vilikuwa vya dhahabu, na vyombo vyote vya nyumba ya mwitu wa Lebanoni vilikuwa vya dhahabu iliyosafika; fedha haikuhesabiwa kuwa kitu siku za Sulemani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.20",
            "verseOrgIds": [
              "2CH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
