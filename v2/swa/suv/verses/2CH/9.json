          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafalme wote wa duniani wakamtafuta Sulemani uso wake, ili waisikie hekima yake, Mungu aliyomtia moyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.23",
            "verseOrgIds": [
