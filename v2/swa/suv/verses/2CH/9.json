        {
          "text": "Akatawala Sulemani katika Yerusalemu juu ya Israeli wote miaka arobaini. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
