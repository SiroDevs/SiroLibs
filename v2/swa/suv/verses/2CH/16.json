                }
              ]
            }
          ]
        },
        {
          "text": "Akashikwa Asa na ugonjwa wa miguu katika mwaka wa thelathini na kenda wa kumiliki kwake; ugonjwa wake ukazidi sana; lakini hakumtafuta BWANA katika ugonjwa wake, bali waganga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.12",
            "verseOrgIds": [
              "2CH.16.12"
            ]
          }
        },
        {
