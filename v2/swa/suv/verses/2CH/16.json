              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa akalala na babaze, akafa katika mwaka wa arobaini na mmoja wa kumiliki kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.13",
            "verseOrgIds": [
              "2CH.16.13"
            ]
          }
        },
