          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.15"
              },
              "items": [
                {
                  "text": "1 Nya 22:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Unipelekee basi mtu mstadi wa kazi ya dhahabu, na ya fedha, na ya shaba, na ya chuma, na ya urujuani, na nyekundu, na samawi, mwenye kujua kuchora machoro, pamoja na wastadi walioko Yuda na Yerusalemu pamoja nami, aliowaweka baba yangu Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.7",
            "verseOrgIds": [
              "2CH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 2:8"
          },
          "items": [
