        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:3",
              "type": "text"
            },
            {
              "text": "Au, Huramu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mfalme wa Tiro, akisema, Kama ulivyomtendea baba yangu Daudi, na kumletea mierezi, ajijengee nyumba ya kukaa, unitendee na mimi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.3",
            "verseOrgIds": [
              "2CH.2.3"
            ]
          }
        },
