                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo Hiramu mfalme wa Tiro akajibu kwa waraka, aliompelekea Sulemani, Ni kwa sababu BWANA awapenda watu wake, amekufanya uwe mfalme juu yao. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.11",
            "verseOrgIds": [
              "2CH.2.11"
            ]
