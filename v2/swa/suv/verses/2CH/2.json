              "items": [
                {
                  "text": "Isa 66:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini ni nani awezaye kumjengea nyumba, ikiwa mbingu hazimtoshi, wala mbingu za mbingu? Nami ni nani basi, hata nimjengee nyumba, isipokuwa kwa ajili ya kufukizia fukizo mbele zake? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.6",
            "verseOrgIds": [
              "2CH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
