              "items": [
                {
                  "text": "Yer 10:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nayo nyumba nitakayoijenga ni kubwa; kwa sababu Mungu wetu ndiye mkuu juu ya miungu yote. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.5",
            "verseOrgIds": [
              "2CH.2.5"
            ]
          }
        },
        {
