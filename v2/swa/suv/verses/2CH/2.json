                "loc": "1KI.5.15"
              },
              "items": [
                {
                  "text": "1 Fal 5:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sulemani akahesabu watu sabini elfu wawe wachukuzi wa mizigo, na watu themanini elfu wawe wachongaji milimani, na elfu tatu na mia sita wawe wasimamizi wao.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.2",
            "verseOrgIds": [
              "2CH.2.2"
            ]
          }
        }
