              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemani akatuma watu kwa Hiramu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.3",
            "verseOrgIds": [
              "2CH.2.3"
            ]
