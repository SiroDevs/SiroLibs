          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawe utakuwa na ugonjwa mkuu kwa maradhi ya matumbo, yatakapotokea matumbo yako kwa sababu ya ugonjwa huo siku kwa siku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.15",
            "verseOrgIds": [
              "2CH.21.15"
            ]
          }
        },
