          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likamjia andiko kutoka kwa Eliya nabii, kusema, BWANA, Mungu wa Daudi baba yako, asema hivi, Kwa sababu hukuziendea njia za Yehoshafati baba yako, wala njia za Asa mfalme wa Yuda; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.12",
            "verseOrgIds": [
              "2CH.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
