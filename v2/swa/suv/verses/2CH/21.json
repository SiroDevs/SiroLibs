                  "text": "2 Fal 9:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "lakini umeiendea njia ya wafalme wa Israeli, ukawaendesha katika uasherati Yuda na wenyeji wa Yerusalemu, kama walivyofanya nyumba ya Ahabu; tena umewaua ndugu zako wa nyumba ya baba yako, waliokuwa wema kuliko wewe; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.13",
            "verseOrgIds": [
              "2CH.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
