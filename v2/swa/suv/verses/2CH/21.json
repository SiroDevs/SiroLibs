              "items": [
                {
                  "text": "Neh 13:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akaiendea njia ya wafalme wa Israeli, kama walivyofanya nyumba ya Ahabu; kwa kuwa alikuwa amemwoa binti Ahabu; akafanya maovu machoni pa BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.6",
            "verseOrgIds": [
              "2CH.21.6"
            ]
          }
        },
        {
