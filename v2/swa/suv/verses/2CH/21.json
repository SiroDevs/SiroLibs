          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "tazama, BWANA atawapiga pigo kubwa watu wako, na watoto wako, na wake zako, na mali yako yote; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.14",
            "verseOrgIds": [
              "2CH.21.14"
            ]
          }
        },
        {
