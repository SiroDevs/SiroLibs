                "loc": "1JN.3.12"
              },
              "items": [
                {
                  "text": "1 Yoh 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Yehoramu alipoinuliwa juu ya ufalme wa babaye, na kujitia nguvu, akawaua nduguze wote kwa upanga, na baadhi ya wakuu wa Israeli pia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.4",
            "verseOrgIds": [
              "2CH.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoramu alikuwa na umri wa miaka thelathini na miwili alipoanza kutawala, akatawala miaka minane huko Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.5",
            "verseOrgIds": [
              "2CH.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 21:6"
          },
