        },
        {
          "text": "Tena ndiye aliyefanya mahali pa juu milimani pa Yuda, na kuwaendesha katika uasherati wenyeji wa Yerusalemu, na kuwakosesha Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.11",
            "verseOrgIds": [
