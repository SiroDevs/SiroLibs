        },
        {
          "text": "Hili ndilo neno mtakalolifanya; theluthi yenu, ninyi mwingiao siku ya sabato, wa makuhani, na wa Walawi, mtalinda milangoni; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.4",
            "verseOrgIds": [
              "2CH.23.4"
            ]
          }
        },
        {
