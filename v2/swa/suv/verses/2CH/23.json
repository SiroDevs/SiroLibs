        },
        {
          "text": "Naye Yehoyada kuhani akawapa maakida wa mamia mikuki, na ngao, na vigao, vilivyokuwa vya mfalme Daudi, vilivyokuwamo nyumbani mwa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.9",
            "verseOrgIds": [
              "2CH.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
