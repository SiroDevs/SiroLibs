              },
              "items": [
                {
                  "text": "Zab 112:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakazunguka katikati ya Yuda, wakawakusanya Walawi kutoka katika miji yote ya Yuda, na wakuu wa nyumba za mababa wa Israeli, wakaja Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.2",
            "verseOrgIds": [
              "2CH.23.2"
            ]
          }
        },
