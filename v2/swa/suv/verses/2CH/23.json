            "number": "10",
            "style": "v",
            "sid": "2CH 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawasimamisha watu wote, kila mtu mwenye silaha yake mkononi, toka pembe ya kuume ya nyumba mpaka pembe ya kushoto, upande wa madhabahu na nyumba, kumzunguka mfalme pande zote. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.10",
            "verseOrgIds": [
              "2CH.23.10"
            ]
