                  "text": "Mdo 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na theluthi nyumbani pa mfalme; na theluthi mlangoni pa msingi; na watu wote watakuwapo nyuani mwa nyumba ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.5",
            "verseOrgIds": [
