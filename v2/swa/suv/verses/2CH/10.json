            }
          ]
        },
        {
          "text": "Basi Yeroboamu na watu wote wakamjia Rehoboamu siku ya tatu, kama mfalme alivyoamuru, akisema, Mnirudie siku ya tatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.12",
            "verseOrgIds": [
              "2CH.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 10:13"
          },
          "items": [
            {
