              },
              "items": [
                {
                  "text": "1 Fal 11:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikawa Yeroboamu mwana wa Nebati aliposikia, (maana alikuwako Misri, ambako amekimbilia mbele ya mfalme Sulemani), Yeroboamu akarudi kutoka Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.2",
            "verseOrgIds": [
              "2CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakapeleka ujumbe, wakamwita, Yeroboamu akaja na Israeli wote, wakamwambia Rehoboamu, wakasema, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.3",
            "verseOrgIds": [
              "2CH.10.3"
            ]
          }
        },
