            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.12.13"
              },
              "items": [
                {
                  "text": "Mit 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.14.16"
              },
              "items": [
                {
                  "text": "14:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mfalme akawajibu kwa ukali; mfalme Rehoboamu akaliacha shauri la wazee, akasema nao kwa shauri la vijana, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.13",
            "verseOrgIds": [
              "2CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akinena, Baba yangu aliwafanyia kongwa zito, nami nitawaongezea; baba yangu aliwapiga kwa mijeledi, lakini mimi nitawapiga kwa nge. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.14",
