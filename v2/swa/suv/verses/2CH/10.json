              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamu akaenda Shekemu; maana Israeli wote walikuwa wamekuja Shekemu, ili wamfanye mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.1",
