        },
        {
          "text": "Baba yako alilifanya zito kongwa letu; basi sasa upunguze utumwa mgumu wa baba yako, na kongwa lake zito alilotutwika, nasi tutakutumikia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.4",
            "verseOrgIds": [
              "2CH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaambia, Mnirudie baada ya siku tatu. Watu wakaenda zao. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.5",
            "verseOrgIds": [
              "2CH.10.5"
            ]
