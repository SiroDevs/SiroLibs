          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kama ninyi hamsamehe, wala Baba yenu aliye mbinguni hatawasamehe ninyi makosa yenu.]",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.26",
