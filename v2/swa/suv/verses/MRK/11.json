                  "text": "16:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu hiyo nawaambia, Yo yote myaombayo mkisali, aminini ya kwamba mnayapokea, nayo yatakuwa yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.24",
            "verseOrgIds": [
              "MRK.11.24"
            ]
