              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na asubuhi walipokuwa wakipita, waliuona ule mtini umenyauka toka shinani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.20",
            "verseOrgIds": [
              "MRK.11.20"
            ]
          }
