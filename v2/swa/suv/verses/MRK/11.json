          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akakumbuka habari yake, akamwambia, Rabi, tazama, mtini ulioulaani umenyauka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.21",
            "verseOrgIds": [
              "MRK.11.21"
            ]
          }
        },
        {
