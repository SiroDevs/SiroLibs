        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.35"
              },
              "items": [
                {
                  "text": "Mit 3:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.12"
              },
              "items": [
                {
                  "text": "Dan 5:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Danieli huyo alipata sifa kuliko wakubwa na maliwali, kwa kuwa roho bora ilikuwa ndani yake; naye mfalme akaazimu kumweka juu ya ufalme wote.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.3",
            "verseOrgIds": [
              "DAN.6.3"
            ]
          }
        }
