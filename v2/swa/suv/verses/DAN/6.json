        },
        {
          "text": "Ilimpendeza Dario kuweka juu ya ufalme maliwali mia na ishirini, wawe juu ya ufalme wote; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.1",
            "verseOrgIds": [
              "DAN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.30"
              },
              "items": [
                {
                  "text": "1 Sam 2:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na juu yao akaweka wakubwa watatu, na Danieli alikuwa mmoja wao; ili maliwali hawa watoe hesabu kwao, mfalme asipate hasara. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.2",
            "verseOrgIds": [
              "DAN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 6:3"
          },
          "items": [
