          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi hao watu wakasimama mbali, naye Musa akalikaribia lile giza kuu Mungu alipokuwapo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.21",
