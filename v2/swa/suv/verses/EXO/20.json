        {
          "text": "BWANA akamwambia Musa, Waambie wana wa Israeli hivi, Ninyi wenyewe mmeona ya kuwa nimenena nanyi kutoka mbinguni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.22",
