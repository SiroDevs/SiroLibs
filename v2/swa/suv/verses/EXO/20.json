              },
              "items": [
                {
                  "text": "Mit 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musa akawaambia watu, Msiogope, maana Mungu amekuja ili awajaribu, na utisho wake uwe mbele yenu, ili kwamba msifanye dhambi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.20",
            "verseOrgIds": [
              "EXO.20.20"
            ]
          }
        },
