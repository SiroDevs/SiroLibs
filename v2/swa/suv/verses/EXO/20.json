                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nawe ukinifanyia madhabahu ya mawe, hutaijenga ya mawe yaliyochongwa; kwa kuwa ukiwa wewe umetumia chombo chako katika kuichonga umeitia unajisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.25",
            "verseOrgIds": [
              "EXO.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
