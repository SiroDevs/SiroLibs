                  "text": "Gal 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakamwambia Musa, Sema nasi wewe, nasi tutasikia, bali Mungu asiseme nasi, tusije tukafa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.19",
            "verseOrgIds": [
              "EXO.20.19"
            ]
          }
        },
