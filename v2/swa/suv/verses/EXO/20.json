          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena hutapanda kwenda madhabahuni kwangu kwa daraja, uchi wako usidhihirike juu yake.",
          "type": "text",
