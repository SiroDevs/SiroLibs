          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msifanye miungu mingine pamoja nami; miungu ya fedha, wala miungu ya dhahabu, msijifanyie. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.23",
