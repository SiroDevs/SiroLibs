              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akasema, Ni lazima utupe mikononi mwetu na wanyama wa dhabihu na wa sadaka za kuteketezwa, ili tupate kumchinjia BWANA Mungu wetu dhabihu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.25",
            "verseOrgIds": [
