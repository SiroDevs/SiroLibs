          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Musa akainyosha fimbo yake juu ya nchi ya Misri, na BWANA akaleta upepo kutoka mashariki juu ya nchi, mchana kutwa, na usiku kucha; kulipopambazuka ule upepo wa mashariki ukawaleta nzige. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.13",
            "verseOrgIds": [
              "EXO.10.13"
            ]
          }
        },
