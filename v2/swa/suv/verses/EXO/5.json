          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakakutana na Musa na Haruni, waliokuwa wanasimama njiani, hapo walipotoka kwa Farao; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.20",
            "verseOrgIds": [
              "EXO.5.20"
            ]
          }
        },
