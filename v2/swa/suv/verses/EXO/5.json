            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.10",
            "verseOrgIds": [
              "EXO.5.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.29.12"
              },
              "items": [
                {
                  "text": "Mit 29:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hao wasimamizi wa watu na wanyapara wao wakatoka, wakasema na watu, wakanena, Farao asema hivi, Mimi siwapi majani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.10",
            "verseOrgIds": [
              "EXO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enendeni wenyewe, jipatieni majani hapo mtakapoyaona; kwa maana kazi yenu haitapunguzwa hata kidogo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.11",
            "verseOrgIds": [
              "EXO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi hao watu wakatawanyika katika nchi yote ya Misri ili wapate kukusanya matakataka ya mashamba badala ya majani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.12",
            "verseOrgIds": [
              "EXO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasimamizi wao wakawahimiza, wakisema, Timizeni kazi zenu, shughuli zenu za kila siku, kama wakati ule majani yalipokuwapo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.13",
            "verseOrgIds": [
              "EXO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.13"
              },
              "items": [
                {
                  "text": "Mwa 15:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wanyapara wa wana wa Israeli, ambao wasimamizi wa Farao wamewaweka juu yao, wakapigwa, wakiambiwa, Kwa nini hamkutimiza kazi yenu jana na leo; kwa kufanya matofali kama hapo kwanza? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.14",
            "verseOrgIds": [
              "EXO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wanyapara wa wana wa Israeli wakaenda, wakamlilia Farao, wakisema, Mbona umetutendea hivi, sisi watumwa wako? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.15",
            "verseOrgIds": [
              "EXO.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watumwa wako hawapewi majani, nao wanatuambia, Fanyeni matofali; na tazama, watumwa wako wapigwa; lakini kosa hilo ni la watu wako mwenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.16",
            "verseOrgIds": [
              "EXO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasema, Wavivu ninyi; wavivu; kwa ajili hii mwasema, Tupe ruhusa twende kumtolea BWANA dhabihu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.17",
            "verseOrgIds": [
              "EXO.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, enendeni sasa, mkafanye kazi; kwa maana hamtapewa majani, na pamoja na hayo mtaleta hesabu ile ile ya matofali. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.18",
            "verseOrgIds": [
              "EXO.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wanyapara wa wana wa Israeli wakaona ya kwamba wa katika hali mbaya, walipoambiwa, Hamtapunguza hesabu ya matofali yenu hata kidogo; ndizo shughuli zenu za kila siku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.19",
            "verseOrgIds": [
              "EXO.5.19"
            ]
          }
        }
      ]
    },
