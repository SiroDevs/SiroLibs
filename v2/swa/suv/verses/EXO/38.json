        },
        {
          "text": "Kisha akafanya hilo birika la shaba, na tako lake la shaba; shaba hiyo ilikuwa ni ya vioo vya wanawake wenye kutumika, waliokuwa wakitumika mlangoni mwa hema ya kukutania.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.8",
            "verseOrgIds": [
              "EXO.38.8"
            ]
          }
        }
      ]
    },
