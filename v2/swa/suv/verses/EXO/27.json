                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nawe fanya madhabahu ya mti wa mshita; urefu wake utakuwa ni dhiraa tano, na upana wake dhiraa tano; hiyo madhabahu itakuwa mraba; na kwenda juu kwake kutakuwa dhiraa tatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.1",
            "verseOrgIds": [
              "EXO.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
