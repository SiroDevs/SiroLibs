                "loc": "ACT.7.44"
              },
              "items": [
                {
                  "text": "Mdo 7:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uifanye ya mbao, yenye mvungu ndani yake; kama ulivyoonyeshwa mlimani, ndivyo watakavyoifanya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.8",
            "verseOrgIds": [
              "EXO.27.8"
            ]
          }
        }
      ]
    },
    {
