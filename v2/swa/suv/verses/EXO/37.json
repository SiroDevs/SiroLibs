                }
              ]
            }
          ]
        },
        {
          "text": "Kisha akakifanya kile kinara cha taa cha dhahabu safi, akakifanya kile kinara cha taa cha kazi ya kufua, tako lake, na mti wake; vikombe vyake, na matovu yake, na maua yake, vyote vilikuwa vya kitu kimoja nacho, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.17",
            "verseOrgIds": [
              "EXO.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nacho kilikuwa na matawi sita yaliyotoka ubavuni mwake; matawi matatu ya kinara yalikuwa upande huu, na matawi matatu ya kinara yalikuwa upande huu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.18",
            "verseOrgIds": [
              "EXO.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "vikombe vitatu, vilivyofanywa mfano wa maua ya mlozi vilikuwa katika tawi moja, tovu na ua; na vikombe vitatu, vilivyofanywa mfano wa maua ya mlozi, katika tawi la pili, tovu na ua; yalikuwa ni vivyo hivyo yale matawi sita yaliyokuwa katika hicho kinara. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.19",
            "verseOrgIds": [
              "EXO.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.17.8"
