            }
          ]
        },
        {
          "text": "Na hayo makerubi yakayanyosha mabawa yao juu, na kukifunika hicho kiti cha rehema kwa mabawa yao, na nyuso zao zilikuwa zaelekeana hili na hili; nyuso za hayo makerubi zilikuwa zikielekea kiti cha rehema.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.9",
            "verseOrgIds": [
              "EXO.37.9"
            ]
          }
        }
      ]
    },
