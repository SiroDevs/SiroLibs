              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na Haruni wakafanya vivyo; kama BWANA alivyowaambia, ndivyo walivyofanya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.6",
            "verseOrgIds": [
