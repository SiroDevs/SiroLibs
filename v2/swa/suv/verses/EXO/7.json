        {
          "text": "Na Wamisri watajua ya kuwa mimi ndimi BWANA, hapo nitakapounyosha mkono wangu juu ya Misri na kuwatoa wana wa Israeli watoke kati yao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.5",
            "verseOrgIds": [
              "EXO.7.5"
            ]
          }
