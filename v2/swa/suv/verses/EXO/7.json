                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na hao samaki walio mtoni watakufa, na huo mto utatoa uvundo; nao Wamisri watachukizwa kuyanywa maji ya mtoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.18",
