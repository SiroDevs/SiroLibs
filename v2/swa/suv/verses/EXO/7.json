            }
          ]
        },
        {
          "text": "Lakini Farao hatawasikiza ninyi, nami nitaweka mkono wangu juu ya Misri, na kuyatoa majeshi yangu, watu wangu, hao wana wa Israeli, watoke nchi ya Misri kwa hukumu zilizo kuu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.4",
            "verseOrgIds": [
              "EXO.7.4"
            ]
          }
        },
