        },
        {
          "text": "BWANA akamwambia Musa, Angalia, nimekufanya wewe kuwa kama Mungu kwa Farao; na huyo ndugu yako Haruni atakuwa nabii wako. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.1",
            "verseOrgIds": [
              "EXO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utanena hayo yote nikuagizayo; na ndugu yako Haruni atanena na Farao, ili awape wana wa Israeli ruhusa watoke nchi yake. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.2",
            "verseOrgIds": [
              "EXO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
