                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitaufanya mgumu moyo wa Farao, nami nitazifanya kuwa nyingi ishara zangu na ajabu zangu katika nchi ya Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.3",
            "verseOrgIds": [
