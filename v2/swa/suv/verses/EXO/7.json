                  "text": "Mit 29:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Farao akazunguka na kuingia nyumbani mwake, wala hata hilo hakuliweka moyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.23",
            "verseOrgIds": [
              "EXO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamisri wote wakachimba-chimba kando ya mto ili wapate maji ya kunywa; maana, hawakuweza kuyanywa yale maji ya mtoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
            "verseOrgIds": [
              "EXO.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zikatimia siku saba, baada ya BWANA kuupiga ule mto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.25",
            "verseOrgIds": [
              "EXO.7.25"
            ]
