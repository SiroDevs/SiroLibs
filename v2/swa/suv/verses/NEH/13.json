              "items": [
                {
                  "text": "Hes 35:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena nikaona ya kwamba Walawi hawakupewa sehemu zao; basi wamekimbia Walawi na waimbaji, waliofanya kazi, kila mtu shambani kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.10",
            "verseOrgIds": [
              "NEH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 13:11"
          },
          "items": [
            {
              "text": "11",
