                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kwa sababu hawakuwalaki wana wa Israeli kwa chakula na maji, bali walimwajiri Balaamu juu yao ili awalaani; lakini Mungu aliigeuza ile laana kuwa baraka. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.2",
            "verseOrgIds": [
              "NEH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
