          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena siku zizo hizo nikawaona wale Wayahudi waliokuwa wameoa wanawake wa Ashdodi, na Amoni, na Moabu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.23",
            "verseOrgIds": [
              "NEH.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "na watoto wao wakanena nusu kwa lugha ya Ashdodi, wala hawakuweza kunena kwa Kiyahudi, bali kwa lugha ya watu hao mojawapo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.24",
            "verseOrgIds": [
              "NEH.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
