              "items": [
                {
                  "text": "Neh 10:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.10.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nikagombana nao, nikawalaani, nikawapiga baadhi yao, na kuwang’oa nywele zao; nikawaapisha kwa Mungu, nikasema, Msiwaoze wana wao binti zenu, wala msiwatwae binti zao ili waolewe na wana wenu, wala na ninyi wenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.25",
            "verseOrgIds": [
              "NEH.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.1"
              },
              "items": [
                {
                  "text": "1 Fal 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.24"
              },
              "items": [
                {
                  "text": "2 Sam 12:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Je! Sulemani, mwana wa Daudi, hakufanya dhambi kwa kutenda hayo? Lakini katika mataifa mengi hapakuwa na mfalme mwingine mfano wake. Tena alipendwa na Mungu wake, naye Mungu akamfanya mfalme juu ya Israeli; walakini wanawake wageni walimkosesha hata yeye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.26",
            "verseOrgIds": [
              "NEH.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.10.2"
              },
              "items": [
                {
                  "text": "Ezr 10:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi, na sisi, je! Tuwasikilize ninyi kutenda neno hili baya, hata kumhalifu Mungu wetu kwa kuwaoa wanawake wageni? ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.27",
            "verseOrgIds": [
              "NEH.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.10"
              },
              "items": [
                {
                  "text": "Neh 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na mwana mmoja wa Yoyada, mwana wa Eliashibu, kuhani mkuu, alikuwa mkwewe Sanbalati, Mhoroni, basi nikamfukuza kwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
            "verseOrgIds": [
              "NEH.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.6.14"
              },
              "items": [
                {
                  "text": "Neh 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.2.4"
              },
              "items": [
                {
                  "text": "Mal 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uwakumbuke, Ee Mungu wangu, jinsi walivyounajisi ukuhani, na agano la ukuhani na la Walawi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.10.30"
              },
              "items": [
                {
                  "text": "Neh 10:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.1"
              },
              "items": [
                {
                  "text": "12:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hivyo nikawatakasa na kila kitu kigeni, nami nikawaagizia zamu makuhani na Walawi, kila mtu kazini mwake; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
              "NEH.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na matoleo ya kuni nyakati zilizoamriwa, na malimbuko. Nikumbuke, Ee Mungu wangu, ili unitendee mema.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
            "verseOrgIds": [
              "NEH.13.31"
            ]
          }
        }
