              "items": [
                {
                  "text": "Neh 9:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.27"
              },
              "items": [
                {
                  "text": "Yak 1:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikawa walipoisikia torati, wakawatenga Israeli na umati wa watu waliochanganyika nao.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        }
