          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nikafika kwa maliwali walio ng’ambo ya Mto, nikawapa hizo nyaraka za mfalme. Naye mfalme alikuwa amepeleka maakida wa jeshi lake na wapanda farasi pamoja nami. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.9",
            "verseOrgIds": [
              "NEH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata Sanbalati, Mhoroni, na Tobia, mtumishi wake, Mwamoni, waliposikia habari hizi, ziliwahuzunisha sana, kwa kuwa amekuja mtu kuwatakia heri wana wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.10",
            "verseOrgIds": [
              "NEH.2.10"
            ]
          }
        }
      ]
    },
