              "items": [
                {
                  "text": "Yn 18:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha nikapanda usiku kando ya kijito, nikautazama ukuta; kisha nikarudi nyuma, nikaingia kwa lango la bondeni, nikarejea hivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.15",
            "verseOrgIds": [
              "NEH.2.15"
