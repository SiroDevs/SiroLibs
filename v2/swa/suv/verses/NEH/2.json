                "loc": "JER.5.10"
              },
              "items": [
                {
                  "text": "Yer 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nikatoka nje usiku, kwa njia ya lango la bondeni, nikashika njia iendayo kisima cha joka, na lango la jaa; nikazitazama kuta za Yerusalemu, zilizokuwa zimebomoka; na malango yake yameteketezwa kwa moto. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.13",
            "verseOrgIds": [
              "NEH.2.13"
            ]
          }
        },
        {
