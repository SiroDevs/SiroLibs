              "items": [
                {
                  "text": "Neh 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha nikaendelea mpaka lango la chemchemi, na ziwa la mfalme; lakini hapakuwa na nafasi ya kupita kwa yule mnyama aliyekuwa chini yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.14",
            "verseOrgIds": [
              "NEH.2.14"
            ]
          }
        },
