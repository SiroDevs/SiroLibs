                  "text": "Mdo 7:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nipewe na waraka kwa Asafu, mwenye kuutunza mwitu wa mfalme, ili anipe miti ya kufanyizia boriti kwa malango ya ngome ya nyumba, na kwa ukuta wa mji; na kwa nyumba ile nitakayoingia mimi. Naye mfalme akanipa, kama mkono mwema wa Mungu wangu ulivyokuwa juu yangu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.8",
            "verseOrgIds": [
              "NEH.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
