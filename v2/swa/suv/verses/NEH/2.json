                {
                  "text": "Ezr 8:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi nikafika Yerusalemu, nikakaa huko muda wa siku tatu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.11",
            "verseOrgIds": [
              "NEH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikaondoka usiku, mimi na watu wachache pamoja nami; wala sikumwambia mtu neno hili alilolitia Mungu wangu moyoni mwangu, nilitende kwa ajili ya Yerusalemu; wala hapakuwa na mnyama pamoja nami, ila mnyama yule niliyempanda mwenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.12",
            "verseOrgIds": [
              "NEH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 2:13"
          },
          "items": [
