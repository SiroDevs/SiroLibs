              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada yake akafanyiza Meremothi, mwana wa Uria, mwana wa Hakosi, sehemu nyingine, toka mlango wa nyumba ya Eliashibu mpaka mwisho wa nyumba ya Eliashibu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
