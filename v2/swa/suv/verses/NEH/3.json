                }
              ]
            }
          ]
        },
        {
          "text": "Na baada yao wakafanyiza Melatia, Mgibeoni, na Yadoni, Mmeronothi, watu wa Gibeoni, na wa Mispa, raia wa kiti cha enzi cha liwali wa ng’ambo ya Mto. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.7",
            "verseOrgIds": [
              "NEH.3.7"
            ]
          }
