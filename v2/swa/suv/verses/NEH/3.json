                  "text": "1 Sam 23:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Baada yake wakafanyiza ndugu zao, Binui, mwana wa Henadadi, akida wa nusu ya mtaa wa Keila. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.18",
