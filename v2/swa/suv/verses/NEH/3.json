                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Malkiya, mwana wa Harimu, na Hashubu, mwana wa Pahath-moabu, wakafanyiza sehemu nyingine, na mnara wa tanuu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.11",
