          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada yake wakafanyiza Hanania, mwana wa Shelemia, na Hanuni, mwana wa sita wa Salafu, sehemu nyingine. Baada yake akafanyiza Meshulamu, mwana wa Berekia, sehemu nyingine kuelekea chumba chake. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.30",
            "verseOrgIds": [
              "NEH.3.30"
            ]
          }
        },
