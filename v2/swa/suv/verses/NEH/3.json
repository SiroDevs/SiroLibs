                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na baada yake akafanyiza Shemaya, mwana wa Shekania, mlinzi wa lango la mashariki. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.29",
            "verseOrgIds": [
