              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada yake wakafanyiza Walawi, Rehumi, mwana wa Bani. Baada yake akafanyiza Hashabia, akida wa nusu ya mtaa wa Keila, kwa mtaa wake. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.17",
            "verseOrgIds": [
              "NEH.3.17"
            ]
          }
        },
