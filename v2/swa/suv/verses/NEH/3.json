              "items": [
                {
                  "text": "Amu 5:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na baada yao wakafanyiza Watekoi; lakini wakuu wao hawakutia shingo zao kazini mwa bwana wao. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        },
        {
          "name": "verse",
