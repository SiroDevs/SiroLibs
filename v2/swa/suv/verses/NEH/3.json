        },
        {
          "text": "Na baada yake akafanyiza Shalumu, mwana wa Haloheshi, akida wa nusu ya Yerusalemu, yeye na binti zake. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
