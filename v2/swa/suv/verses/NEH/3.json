          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada yake akafanyiza Malkiya, mmoja wa mafundi wa dhahabu, mpaka nyumba ya Wanethini, na ya wafanya biashara, kulielekea lango la gereza, na mpaka chumba cha juu cha pembeni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.31",
            "verseOrgIds": [
              "NEH.3.31"
            ]
          }
        },
