        {
          "text": "Ndipo akaondoka Eliashibu, kuhani mkuu, pamoja na nduguze makuhani, wakalijenga lango la kondoo; wakazitia boriti zake, wakaisimamisha milango yake; mpaka mnara wa Hamea wakalitakasa, mpaka mnara wa Hananeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.1",
            "verseOrgIds": [
              "NEH.3.1"
            ]
          }
        },
