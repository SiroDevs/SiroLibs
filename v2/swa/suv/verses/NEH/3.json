                }
              ]
            }
          ]
        },
        {
          "text": "Na baada yao akafanyiza Uzieli, mwana wa Harhaya, mmoja wa mafundi wa dhahabu. Na baada yake akafanyiza Hanania, mmoja wa mafundi wa manukato, nao wakaujengea Yerusalemu buruji mpaka ule ukuta mpana. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.8",
            "verseOrgIds": [
              "NEH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na baada yao akafanyiza Refaya, mwana wa Huri, akida wa nusu ya Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.9",
            "verseOrgIds": [
              "NEH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na baada yao akafanyiza Yedaya, mwana wa Harumafu, kuielekea nyumba yake. Na baada yake akafanyiza Hatushi, mwana wa Hashabneya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.10",
            "verseOrgIds": [
              "NEH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
