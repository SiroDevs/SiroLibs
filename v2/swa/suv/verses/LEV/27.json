              },
              "items": [
                {
                  "text": "Eze 45:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na hesabu yako itakuwa kwa mtu mume, tokea aliye na umri wa miaka ishirini hata umri wa miaka sitini, hesabu yako itakuwa shekeli hamsini za fedha, kwa shekeli ya mahali patakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.3",
            "verseOrgIds": [
              "LEV.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ni mwanamke, hesabu yako itakuwa shekeli thelathini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.4",
            "verseOrgIds": [
              "LEV.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena akiwa mwenye umri wa miaka mitano hata umri wa miaka ishirini, ndipo hesabu yako itakuwa shekeli ishirini kwa mwanamume, na shekeli kumi kwa mwanamke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.5",
            "verseOrgIds": [
              "LEV.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena akiwa mwenye umri wa mwezi mmoja hata umri wa miaka mitano, ndipo hesabu yako itakuwa shekeli tano za fedha kwa mwanamume, na hesabu yako itakuwa shekeli tatu za fedha kwa mwanamke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.6",
            "verseOrgIds": [
              "LEV.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena akiwa mwenye umri wa miaka sitini na kuzidi; kama ni mwanamume, hesabu yako itakuwa shekeli kumi na tano, na kwa mwanamke shekeli kumi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.7",
            "verseOrgIds": [
              "LEV.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
