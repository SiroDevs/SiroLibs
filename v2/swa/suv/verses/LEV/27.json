            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.12"
              },
              "items": [
                {
                  "text": "2 Kor 8:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini kwamba ni maskini zaidi ya kuhesabu kwako, ndipo atawekwa mbele ya kuhani, na huyo kuhani atamtia kima; kama uwezo wake huyo aliyeweka nadhiri ulivyo, ndivyo kuhani atakavyomtia kima.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.8",
            "verseOrgIds": [
              "LEV.27.8"
            ]
          }
        }
      ]
