              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila aliyewekwa wakfu, aliyewekwa wakfu na binadamu, hatakombolewa; sharti atauawa.",
          "type": "text",
          "attrs": {
