        {
          "text": "Nena na wana wa Israeli, uwaambie, Hapo mtu atakapoondoa nadhiri, hizo nafsi za watu zitakuwa kwa BWANA, kama utakavyowahesabia wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.2",
            "verseOrgIds": [
              "LEV.27.2"
            ]
          }
        },
        {
