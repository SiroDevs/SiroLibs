                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ni haki ya Mungu iliyo kwa njia ya imani katika Yesu Kristo kwa wote waaminio. Maana hakuna tofauti; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.22",
