              "type": "text"
            },
            {
              "text": "Upatanisho",
              "type": "text"
            },
            {
              "text": "hapa maana yake ni, Kiti cha rehema.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwa njia ya imani katika damu yake, ili aonyeshe haki yake, kwa sababu ya kuziachilia katika ustahimili wa Mungu dhambi zote zilizotangulia kufanywa; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.25",
            "verseOrgIds": [
              "ROM.3.25"
            ]
          }
        },
        {
