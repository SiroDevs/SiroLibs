              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "apate kuonyesha haki yake wakati huu, ili awe mwenye haki na mwenye kumhesabu haki yeye amwaminiye Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.26",
