                "loc": "1CO.12.4+1CO.12.5+1CO.12.6+1CO.12.7+1CO.12.8+1CO.12.9+1CO.12.10+1CO.12.11"
              },
              "items": [
                {
                  "text": "1 Kor 12:4-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi kwa kuwa tuna karama zilizo mbalimbali, kwa kadiri ya neema mliyopewa; ikiwa unabii, tutoe unabii kwa kadiri ya imani; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.6",
            "verseOrgIds": [
              "ROM.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
