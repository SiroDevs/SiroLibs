              "attrs": {
                "loc": "EPH.4.25"
              },
              "items": [
                {
                  "text": "Efe 4:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Vivyo hivyo na sisi tulio wengi tu mwili mmoja katika Kristo, na viungo, kila mmoja kwa mwenzake. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.5",
            "verseOrgIds": [
              "ROM.12.5"
            ]
