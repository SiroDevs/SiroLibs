                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ikiwa huduma, tuwemo katika huduma yetu; mwenye kufundisha, katika kufundisha kwake; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.7",
            "verseOrgIds": [
              "ROM.12.7"
