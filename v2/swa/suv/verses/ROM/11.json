              "items": [
                {
                  "text": "Ebr 3:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tazama, basi, wema na ukali wa Mungu; kwa wale walioanguka, ukali, bali kwako wewe wema wa Mungu, ukikaa katika wema huo; kama sivyo, wewe nawe utakatiliwa mbali. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.22",
            "verseOrgIds": [
              "ROM.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 11:23"
