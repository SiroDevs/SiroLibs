              "items": [
                {
                  "text": "Rum 12:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Vema. Yalikatwa kwa kutokuamini kwao, na wewe wasimama kwa imani yako. Usijivune, bali uogope. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.20",
            "verseOrgIds": [
              "ROM.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana ikiwa Mungu hakuyaachia matawi ya asili, wala hatakuachia wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.21",
            "verseOrgIds": [
              "ROM.11.21"
            ]
          }
        },
        {
