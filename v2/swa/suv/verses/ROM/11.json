              "ROM.11.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.21"
              },
              "items": [
                {
                  "text": "Kum 32:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.46"
              },
              "items": [
                {
                  "text": "Mdo 13:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.19"
              },
              "items": [
                {
                  "text": "Rum 10:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi nasema, Je! Wamejikwaa hata waanguke kabisa? Hasha! Lakini kwa kosa lao wokovu umewafikilia Mataifa, ili wao wenyewe watiwe wivu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.11",
            "verseOrgIds": [
              "ROM.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, ikiwa kosa lao limekuwa utajiri wa ulimwengu, na upungufu wao umekuwa utajiri wa Mataifa, je! Si zaidi sana utimilifu wao?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.12",
            "verseOrgIds": [
              "ROM.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.12",
            "verseOrgIds": [
              "ROM.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini nasema na ninyi, mlio watu wa Mataifa. Basi, kwa kadiri nilivyo mtume wa watu wa Mataifa, naitukuza huduma iliyo yangu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.13",
            "verseOrgIds": [
              "ROM.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.16"
              },
              "items": [
                {
                  "text": "1 Tim 4:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nipate kuwatia wivu walio damu moja na mimi na kuwaokoa baadhi yao. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.14",
            "verseOrgIds": [
              "ROM.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana ikiwa kutupwa kwao kumeleta upatanisho kwa ulimwengu, je! Kukubaliwa kwao kutakuwa nini kama si uhai baada ya kufa? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.15",
            "verseOrgIds": [
              "ROM.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.17+NUM.15.18+NUM.15.19+NUM.15.20+NUM.15.21"
              },
              "items": [
                {
                  "text": "Hes 15:17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena malimbuko yakiwa matakatifu, kadhalika na donge lote; na shina likiwa takatifu, matawi nayo kadhalika. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.16",
            "verseOrgIds": [
              "ROM.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.11+EPH.2.12+EPH.2.13+EPH.2.14+EPH.2.15+EPH.2.16+EPH.2.17+EPH.2.18+EPH.2.19"
              },
              "items": [
                {
                  "text": "Efe 2:11-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini iwapo matawi mengine yamekatwa, na wewe mzeituni mwitu ulipandikizwa kati yao, ukawa mshirika wa shina la mzeituni na unono wake, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.17",
            "verseOrgIds": [
              "ROM.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.22"
              },
              "items": [
                {
                  "text": "Yn 4:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "usijisifu juu ya matawi yale; au ikiwa wajisifu, si wewe ulichukuaye shina, bali ni shina likuchukualo wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.18",
            "verseOrgIds": [
              "ROM.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi utasema, Matawi yale yalikatwa kusudi ili nipandikizwe mimi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.19",
            "verseOrgIds": [
              "ROM.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
