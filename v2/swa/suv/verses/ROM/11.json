                  "text": "2 Kor 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na hao pia, wasipokaa katika kutokuamini kwao, watapandikizwa; kwa kuwa Mungu aweza kuwapandikiza tena. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.23",
            "verseOrgIds": [
              "ROM.11.23"
            ]
          }
        },
        {
