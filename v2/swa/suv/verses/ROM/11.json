          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana ikiwa wewe ulikatwa ukatolewa katika mzeituni, ulio mzeituni mwitu kwa asili yake, kisha ukapandikizwa, kinyume cha asili, katika mzeituni ulio mwema, si zaidi sana wale walio wa asili kuweza kupandikizwa katika mzeituni wao wenyewe?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.24",
            "verseOrgIds": [
              "ROM.11.24"
            ]
          }
        }
