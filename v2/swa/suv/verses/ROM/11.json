                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.37"
              },
              "items": [
                {
                  "text": "Yer 31:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi, nauliza, Je! Mungu aliwasukumia mbali watu wake? Hasha! Kwa kuwa mimi nami ni Mwisraeli, mmoja wa wazao wa Ibrahimu, mtu wa kabila ya Benyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.1",
            "verseOrgIds": [
              "ROM.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.10"
              },
              "items": [
                {
                  "text": "1 Fal 19:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mungu hakuwasukumia mbali watu wake aliowajua tokea awali. Au hamjui yale yaliyonenwa na maandiko juu ya Eliya? Jinsi anavyowashitaki Waisraeli mbele za Mungu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.2",
            "verseOrgIds": [
              "ROM.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.10"
              },
              "items": [
                {
                  "text": "1 Fal 19:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bwana, wamewaua manabii wako, wamezibomoa madhabahu zako, nami nimesalia peke yangu, nao wananitafuta roho yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.3",
            "verseOrgIds": [
              "ROM.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.18"
              },
              "items": [
                {
                  "text": "1 Fal 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini ile jawabu ya Mungu yamwambiaje? Nimejisazia watu elfu saba wasiopiga goti mbele ya Baali. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.4",
            "verseOrgIds": [
              "ROM.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.27"
              },
              "items": [
                {
                  "text": "Rum 9:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi ni vivi hivi wakati huu wa sasa, yako mabaki waliochaguliwa kwa neema. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.5",
            "verseOrgIds": [
              "ROM.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.18"
              },
              "items": [
                {
                  "text": "Gal 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini ikiwa ni kwa neema, haiwi kwa matendo tena, au hapo neema isingekuwa neema. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.6",
            "verseOrgIds": [
              "ROM.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.31"
              },
              "items": [
                {
                  "text": "Rum 9:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Imekuwaje basi? Kitu kile ambacho Israeli alikuwa akikitafuta hakukipata; lakini wale waliochaguliwa walikipata, na wengine walitiwa uzito. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.7",
            "verseOrgIds": [
              "ROM.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.4"
              },
              "items": [
                {
                  "text": "Kum 29:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.10"
              },
              "items": [
                {
                  "text": "Isa 29:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kama ilivyoandikwa, Mungu aliwapa roho ya usingizi, macho hata wasione, na masikio hata wasisikie, hata siku hii ya leo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.8",
            "verseOrgIds": [
              "ROM.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.22+PSA.69.23"
              },
              "items": [
                {
                  "text": "Zab 69:22-23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.35.8"
              },
              "items": [
                {
                  "text": "35:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na Daudi asema,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.9",
            "verseOrgIds": [
              "ROM.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuokolewa kwa Mataifa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
