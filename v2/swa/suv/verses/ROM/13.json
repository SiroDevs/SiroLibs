              "items": [
                {
                  "text": "Mt 22:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wapeni wote haki zao; mtu wa kodi, kodi; mtu wa ushuru, ushuru; astahiliye hofu, hofu; astahiliye heshima, heshima.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.7",
            "verseOrgIds": [
              "ROM.13.7"
            ]
