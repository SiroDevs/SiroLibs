                "loc": "1PE.2.13"
              },
              "items": [
                {
                  "text": "1 Pet 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.14"
