                  "text": "2 Tim 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Usiku umeendelea sana, mchana umekaribia, basi na tuyavue matendo ya giza, na kuzivaa silaha za nuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.12",
