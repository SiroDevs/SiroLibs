                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kila mtu na aitii mamlaka iliyo kuu; kwa maana hakuna mamlaka isiyotoka kwa Mungu; na ile iliyopo umeamriwa na Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.1",
            "verseOrgIds": [
              "ROM.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo amwasiye mwenye mamlaka hushindana na agizo la Mungu; nao washindanao watajipatia hukumu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.2",
            "verseOrgIds": [
              "ROM.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
