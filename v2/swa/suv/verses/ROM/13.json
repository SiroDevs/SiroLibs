                "loc": "LUK.20.25"
              },
              "items": [
                {
                  "text": "Lk 20:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu hiyo tena mwalipa kodi; kwa kuwa wao ni wahudumu wa Mungu, wakidumu katika kazi iyo hiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.6",
            "verseOrgIds": [
              "ROM.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
