              },
              "items": [
                {
                  "text": "3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana watawalao hawatishi watu kwa sababu ya matendo mema, bali kwa sababu ya matendo mabaya. Basi, wataka usimwogope mwenye mamlaka? Fanya mema, nawe utapata sifa kwake; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.3",
            "verseOrgIds": [
              "ROM.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 13:4"
          },
          "items": [
