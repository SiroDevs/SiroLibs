              "items": [
                {
                  "text": "Mt 22:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pendo halimfanyii jirani neno baya; basi pendo ndilo utimilifu wa sheria.",
          "type": "text",
