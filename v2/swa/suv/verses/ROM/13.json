              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.82.6"
              },
              "items": [
                {
                  "text": "Zab 82:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.19"
              },
              "items": [
                {
                  "text": "Rum 12:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kwa kuwa yeye ni mtumishi wa Mungu kwako kwa ajili ya mema. Lakini ufanyapo mabaya, ogopa; kwa maana hauchukui upanga bure; kwa kuwa ni mtumishi wa Mungu, amlipizaye kisasi mtenda mabaya kwa ajili ya ghadhabu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.4",
            "verseOrgIds": [
              "ROM.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo ni lazima kutii, si kwa sababu ya ile ghadhabu tu, ila na kwa sababu ya dhamiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.5",
            "verseOrgIds": [
              "ROM.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.21"
              },
              "items": [
                {
                  "text": "Mt 22:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.17"
              },
              "items": [
                {
                  "text": "Mk 12:17",
