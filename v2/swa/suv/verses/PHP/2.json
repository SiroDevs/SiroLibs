                "loc": "GAL.5.26"
              },
              "items": [
                {
                  "text": "Gal 5:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.10"
              },
              "items": [
                {
                  "text": "Rum 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Msitende neno lo lote kwa kushindana wala kwa majivuno; bali kwa unyenyekevu, kila mtu na amhesabu mwenziwe kuwa bora kuliko nafsi yake. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.3",
            "verseOrgIds": [
              "PHP.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
