          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana kwa ajili ya kazi ya Kristo alikaribia kufa akaponza roho yake; ili kusudi ayatimize yaliyopungua katika huduma yenu kwangu.",
          "type": "text",
          "attrs": {
