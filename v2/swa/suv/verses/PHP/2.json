          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ila mwajua sifa yake, ya kuwa ametumika pamoja nami kwa ajili ya Injili, kama mwana na baba yake. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.22",
            "verseOrgIds": [
              "PHP.2.22"
            ]
          }
        },
