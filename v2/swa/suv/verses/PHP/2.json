                  "text": "1 Tim 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpokeeni, basi, katika Bwana, kwa furaha yote, mkawahesabu watu kama huyu kuwa watu wa kuheshimiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.29",
            "verseOrgIds": [
              "PHP.2.29"
            ]
          }
        },
