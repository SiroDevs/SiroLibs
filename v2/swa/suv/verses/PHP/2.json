            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi ikiwako faraja yo yote katika Kristo, yakiwako matulizo yo yote ya mapenzi, ukiwako ushirika wo wote wa Roho, ikiwako huruma yo yote na rehema, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.1",
            "verseOrgIds": [
              "PHP.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ijalizeni furaha yangu, ili mwe na nia moja, wenye mapenzi mamoja, wenye roho moja, mkinia mamoja. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.2",
            "verseOrgIds": [
              "PHP.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
