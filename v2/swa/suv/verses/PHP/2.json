                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana wote wanatafuta vyao wenyewe, sivyo vya Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.21",
            "verseOrgIds": [
              "PHP.2.21"
            ]
          }
        },
        {
