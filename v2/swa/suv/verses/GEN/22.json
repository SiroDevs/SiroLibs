                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.12+JAS.1.13+JAS.1.14"
              },
              "items": [
                {
                  "text": "Yak 1:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikawa baada ya mambo hayo Mungu alimjaribu Ibrahimu, akamwambia, Ee Ibrahimu! Naye akasema, Mimi hapa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.1",
            "verseOrgIds": [
              "GEN.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.3.1"
              },
              "items": [
                {
                  "text": "2 Nya 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.16"
              },
              "items": [
                {
                  "text": "Yn 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akasema, Umchukue mwanao, mwana wako wa pekee, umpendaye, Isaka, ukaende zako mpaka nchi ya Moria, ukamtoe sadaka ya kuteketezwa huko juu ya mlima mmojawapo nitakaokuambia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.2",
            "verseOrgIds": [
              "GEN.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.17+HEB.11.18+HEB.11.19"
              },
              "items": [
                {
                  "text": "Ebr 11:17-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ibrahimu akaondoka alfajiri, akatandika punda wake, akachukua vijana wawili pamoja naye, na Isaka mwanawe, akachanja kuni kwa ajili ya hiyo sadaka ya kuteketezwa, akaondoka, akaenda mpaka mahali alipoambiwa na Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.3",
            "verseOrgIds": [
              "GEN.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ya tatu Ibrahimu akainua macho yake, akapaona mahali pakali mbali. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.4",
            "verseOrgIds": [
              "GEN.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibrahimu akawaambia vijana wake, Kaeni ninyi hapa pamoja na punda, na mimi na kijana tutakwenda kule, tukaabudu, na kuwarudia tena. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.5",
            "verseOrgIds": [
              "GEN.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.17"
              },
              "items": [
                {
                  "text": "Yn 19:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.24"
              },
              "items": [
                {
                  "text": "1 Pet 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Ibrahimu akazitwaa kuni za hiyo sadaka, akamtwika Isaka mwanawe; akatwaa moto na kisu mkononi mwake, wakaenda wote wawili pamoja. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.6",
            "verseOrgIds": [
              "GEN.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka akasema na Ibrahimu baba yake, akinena, Babangu! Naye akasema, Mimi hapa, mwanangu. Akasema, Tazama! Moto upo, na kuni zipo, lakini yuko wapi mwana-kondoo kwa sadaka ya kuteketezwa? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.19"
              },
              "items": [
                {
                  "text": "1 Pet 1:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ibrahimu akasema, Mungu atajipatia mwana-kondoo kwa hiyo sadaka, mwanangu. Basi wakaendelea wote wawili pamoja. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.8",
            "verseOrgIds": [
              "GEN.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.21"
              },
              "items": [
                {
                  "text": "Yak 2:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.17"
              },
              "items": [
                {
                  "text": "Yn 10:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.17"
              },
              "items": [
                {
                  "text": "Ebr 11:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakafika mahali pale alipoambiwa na Mungu, Ibrahimu akajenga madhabahu huko, akaziweka tayari kuni, kisha akamfunga Isaka mwanawe, akamweka juu ya madhabahu, juu ya zile kuni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.9",
            "verseOrgIds": [
              "GEN.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.6+ISA.53.7+ISA.53.8+ISA.53.9+ISA.53.10+ISA.53.11+ISA.53.12"
              },
              "items": [
                {
                  "text": "Isa 53:6-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ibrahimu akanyosha mkono wake, akakitwaa kisu ili amchinje mwanawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.10",
            "verseOrgIds": [
              "GEN.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo malaika wa BWANA akamwita kutoka mbinguni, akasema, Ibrahimu! Ibrahimu! Naye akasema, Mimi hapa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.22"
              },
              "items": [
                {
                  "text": "1 Sam 15:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.5"
              },
              "items": [
                {
                  "text": "Mwa 26:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.32"
              },
              "items": [
                {
                  "text": "Rum 8:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.22"
              },
              "items": [
                {
                  "text": "Yak 2:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akasema, Usimnyoshee kijana mkono wako, wala usimtendee neno; kwa maana sasa ninajua ya kuwa unamcha Mungu, iwapo hukunizuilia mwanao, mwanao wa pekee. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.12",
            "verseOrgIds": [
              "GEN.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.7"
              },
              "items": [
                {
                  "text": "1 Kor 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ibrahimu akainua macho yake, akaangalia, na tazama, kondoo mume yuko nyuma yake, amenaswa pembe zake katika kichaka. Basi Ibrahimu akaenda akamtwaa huyo kondoo, akamtoa awe sadaka ya kuteketezwa badala ya mwanawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.13",
            "verseOrgIds": [
              "GEN.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibrahimu akapaita mahali hapo Yehova-yire,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22:14",
              "type": "text"
            },
            {
              "text": "Yehova-yire",
              "type": "text"
            },
            {
              "text": "maana yake ni BWANA atapata.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kama watu wasemavyo hata leo, Katika mlima wa BWANA itapatikana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        }
      ]
    },
