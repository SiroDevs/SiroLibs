            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.17",
            "verseOrgIds": [
              "GEN.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA Mungu akasema, Si vema huyo mtu awe peke yake, nitamfanyia msaidizi wa kufanana naye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.18",
            "verseOrgIds": [
              "GEN.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.8.6"
              },
              "items": [
                {
                  "text": "Zab 8:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA Mungu akafanyiza kutoka katika ardhi kila mnyama wa msituni, na kila ndege wa angani, akamletea Adamu ili aone atawaitaje; kila kiumbe hai, jina alilokiita Adamu likawa ndilo jina lake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.19",
            "verseOrgIds": [
              "GEN.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu akawapa majina yao kila mnyama wa kufugwa, na ndege wa angani, na kila mnyama wa mwituni; lakini hakuonekana wa kumsaidia Adamu aliyefanana naye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.20",
            "verseOrgIds": [
              "GEN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.12"
              },
              "items": [
                {
                  "text": "Mwa 15:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA Mungu akamletea Adamu usingizi mzito, naye akalala; kisha akatwaa ubavu wake mmoja, akafunika nyama mahali pake, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.21",
            "verseOrgIds": [
              "GEN.2.21"
            ]
          }
        },
        {
