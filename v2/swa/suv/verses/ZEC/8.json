              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naam, watu wa kabila nyingi na mataifa hodari watakuja Yerusalemu kumtafuta BWANA wa majeshi, na kuomba fadhili za BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.22",
            "verseOrgIds": [
              "ZEC.8.22"
            ]
          }
        },
