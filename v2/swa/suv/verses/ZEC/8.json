              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA wa majeshi asema hivi, Tazama, nitawaokoa watu wangu toka nchi ya mashariki, na toka nchi ya magharibi; ",
          "type": "text",
          "attrs": {
