          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana kabla ya siku zile hapakuwa na ijara kwa mwanadamu, wala hapakuwa na ijara kwa mnyama; wala hapakuwa na amani kwake yeye aliyetoka, wala kwake yeye aliyeingia, kwa sababu ya adui; nami nalimwacha kila mtu kugombana na jirani yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.10",
            "verseOrgIds": [
              "ZEC.8.10"
            ]
          }
        },
        {
