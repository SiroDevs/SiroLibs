        },
        {
          "text": "BWANA wa majeshi asema hivi, Itatokea halafu ya kwamba watakuja mataifa na wenyeji wa miji mingi; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.20",
            "verseOrgIds": [
