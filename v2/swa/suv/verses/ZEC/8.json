              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini sasa sitakuwa kwa mabaki ya watu hawa kama nilivyokuwa siku zile za kwanza, asema BWANA wa majeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.11",
            "verseOrgIds": [
              "ZEC.8.11"
            ]
