          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "wenyeji wa mji huu watauendea mji huu, wakisema, Haya! Twendeni zetu kwa haraka tuombe fadhili za BWANA, na kumtafuta BWANA wa majeshi; Mimi nami nitakwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.21",
            "verseOrgIds": [
              "ZEC.8.21"
            ]
          }
        },
        {
