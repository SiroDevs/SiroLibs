                  "text": "Yak 5:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nitaituma itokee, asema BWANA wa majeshi, nayo itaingia katika nyumba ya mwivi, na katika nyumba yake yeye aapaye kwa uongo kwa jina langu; nayo itakaa katikati ya nyumba yake, na kuiteketeza, pamoja na boriti zake na mawe yake.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.4",
            "verseOrgIds": [
              "ZEC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maono ya Saba: Mwanamke akiwa katika Kikapu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.4",
            "verseOrgIds": [
              "ZEC.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo yule malaika aliyesema nami akatokea, akaniambia, Inua macho yako sasa, uone ni kitu gani kitokeacho. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.5",
            "verseOrgIds": [
              "ZEC.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikasema, Ni kitu gani? Akasema, Kitu hiki ni efa itokeayo. Tena akasema, Huu ndio uovu wao katika nchi hii yote; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.6",
            "verseOrgIds": [
              "ZEC.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na tazama, talanta ya risasi iliinuliwa; na tazama, mwanamke akaaye katikati ya hiyo efa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.7",
            "verseOrgIds": [
              "ZEC.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasema, Huyu ni Uovu; akamtupa chini katikati ya ile efa; akalitupa lile jiwe la risasi juu ya mdomo wa ile efa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.8",
            "verseOrgIds": [
              "ZEC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nikainua macho yangu, nikaona, na tazama, wanawake wawili walitokea, nao upepo ulikuwa katika mabawa yao; na mabawa yao yalikuwa kama mabawa ya korongo; wakaiinua ile efa kati ya dunia na mbingu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.9",
            "verseOrgIds": [
              "ZEC.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nikamwambia yule malaika aliyesema nami, Hawa wanaipeleka wapi efa hii? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.10",
            "verseOrgIds": [
              "ZEC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.5"
              },
              "items": [
                {
                  "text": "Yer 29:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akaniambia, Wanakwenda kumjengea nyumba katika nchi ya Shinari; tena ikiisha kutengenezwa, atawekwa huko mahali pake mwenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.11",
            "verseOrgIds": [
              "ZEC.5.11"
            ]
          }
        }
