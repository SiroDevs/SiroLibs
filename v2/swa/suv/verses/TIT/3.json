                }
              ]
            }
          ]
        },
        {
          "text": "ili tukihesabiwa haki kwa neema yake, tupate kufanywa warithi wa uzima wa milele, kama lilivyo tumaini letu. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.7",
            "verseOrgIds": [
