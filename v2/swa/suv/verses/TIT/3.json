                "loc": "1TI.4.7"
              },
              "items": [
                {
                  "text": "1 Tim 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini maswali ya upuzi ujiepushe nayo, na nasaba, na magomvi, na mashindano ya sheria. Kwa kuwa hayana faida, tena hayana maana. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.9",
            "verseOrgIds": [
              "TIT.3.9"
            ]
          }
        },
