                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mtu aliye mzushi, baada ya kumwonya mara ya kwanza na mara ya pili, mkatae; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.10",
            "verseOrgIds": [
