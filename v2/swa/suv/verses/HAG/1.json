                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi, kwa ajili yenu mbingu zimezuiliwa zisitoe umande, nayo nchi imezuiliwa isitoe matunda yake. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.10",
            "verseOrgIds": [
              "HAG.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
