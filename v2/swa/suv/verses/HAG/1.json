                {
                  "text": "1 Fal 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.2.17"
              },
              "items": [
                {
                  "text": "Hag 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nikaita wakati wa joto uje juu ya nchi, na juu ya milima, na juu ya nafaka, na juu ya divai mpya, na juu ya mafuta, na juu ya kila kitu itoacho nchi, na juu ya wanadamu, na juu ya wanyama, na juu ya kazi zote za mikono.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.11",
            "verseOrgIds": [
              "HAG.1.11"
            ]
          }
        }
