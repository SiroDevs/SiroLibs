                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.3.17"
              },
              "items": [
                {
                  "text": "1 Nya 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.15"
              },
              "items": [
                {
                  "text": "6:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Katika mwaka wa pili wa Dario mfalme, mwezi wa sita, siku ya kwanza ya mwezi, neno la BWANA lilimjia Zerubabeli, mwana wa Shealtieli, liwali wa Yuda, na Yoshua, mwana wa Yehosadaki, kuhani mkuu, kwa kinywa chake Hagai nabii, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.1",
            "verseOrgIds": [
              "HAG.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA wa majeshi asema hivi, ya kwamba, Watu hawa husema, Huu sio wakati utupasao kuja, huu sio wakati wa kujenga nyumba ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.2",
            "verseOrgIds": [
              "HAG.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.5.1"
              },
              "items": [
                {
                  "text": "Ezr 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo neno la BWANA lilikuja kwa kinywa cha nabii Hagai, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.3",
            "verseOrgIds": [
              "HAG.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Huu ndio wakati wa ninyi kukaa katika nyumba zenye mapambo ya mbao, iwapo nyumba hii inakaa hali ya kuharibika? ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.4",
            "verseOrgIds": [
              "HAG.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi sasa, BWANA wa majeshi asema hivi, Zitafakarini njia zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.5",
            "verseOrgIds": [
              "HAG.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmepanda mbegu nyingi mkavuna kidogo; mnakula lakini hamshibi; mnakunywa lakini hamkujazwa na vinywaji; mnajivika nguo lakini hapana aonaye moto; na yeye apataye mshahara apata mshahara ili kuutia katika mfuko uliotoboka-toboka. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.6",
            "verseOrgIds": [
              "HAG.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA wa majeshi asema hivi, Zitafakarini njia zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.7",
            "verseOrgIds": [
              "HAG.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandeni milimani, mkalete miti, mkaijenge nyumba; nami nitaifurahia, nami nitatukuzwa, asema BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.8",
            "verseOrgIds": [
              "HAG.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlitazamia vingi, kumbe vikatokea vichache; tena mlipovileta nyumbani nikavipeperusha. Ni kwa sababu gani? Asema BWANA wa majeshi. Ni kwa sababu ya nyumba yangu inayokaa hali ya kuharibika, wakati ambapo ninyi mnakimbilia kila mtu nyumbani kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.9",
            "verseOrgIds": [
              "HAG.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
