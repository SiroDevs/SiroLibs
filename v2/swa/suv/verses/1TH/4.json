              "items": [
                {
                  "text": "37:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi yeye anayekataa, hakatai mwanadamu bali Mungu, anayewapa ninyi Roho wake Mtakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.8",
