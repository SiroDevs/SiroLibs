        },
        {
          "text": "Tena mjitahidi kutulia, na kutenda shughuli zenu, na kufanya kazi kwa mikono yenu wenyewe, kama tulivyowaagiza; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.11",
            "verseOrgIds": [
