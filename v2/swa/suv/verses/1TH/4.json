              "type": "tag",
              "attrs": {
                "loc": "1CO.6.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kila mmoja wenu ajue kuuweza mwili wake katika utakatifu na heshima; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.4",
            "verseOrgIds": [
              "1TH.4.4"
            ]
