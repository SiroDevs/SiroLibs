                "loc": "1PE.1.16"
              },
              "items": [
                {
                  "text": "1 Pet 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana haya ndiyo mapenzi ya Mungu, kutakaswa kwenu, mwepukane na uasherati; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.3",
            "verseOrgIds": [
              "1TH.4.3"
            ]
          }
        },
