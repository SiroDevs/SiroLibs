              "type": "text"
            }
          ]
        },
        {
          "text": "Iliyobaki, ndugu, tunakusihini na kuwaonya kwamba mwenende katika Bwana Yesu; kama mlivyopokea kwetu jinsi iwapasavyo kuenenda na kumpendeza Mungu, kama nanyi mnavyoenenda, vivyo hivyo mpate kuzidi sana. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.1",
            "verseOrgIds": [
              "1TH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa mnajua ni maagizo gani tuliyowapa kwa Bwana Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.2",
            "verseOrgIds": [
              "1TH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
