              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana Mungu hakutuitia uchafu, bali tuwe katika utakaso. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.7",
            "verseOrgIds": [
              "1TH.4.7"
            ]
          }
        },
