              "type": "tag",
              "attrs": {
                "loc": "2CO.7.13"
              },
              "items": [
                {
                  "text": "2 Kor 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.12.18"
              },
