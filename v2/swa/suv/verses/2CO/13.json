          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neema ya Bwana Yesu Kristo, na pendo la Mungu, na ushirika wa Roho Mtakatifu ukae nanyi nyote.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.14",
            "verseOrgIds": [
              "2CO.13.14"
            ]
