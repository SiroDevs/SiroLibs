                "loc": "1TI.5.19"
              },
              "items": [
                {
                  "text": "1 Tim 5:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hii ndiyo mara ya tatu ya mimi kuja kwenu. Kwa vinywa vya mashahidi wawili au watatu kila neno litathibitishwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.1",
            "verseOrgIds": [
              "2CO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimetangulia kuwaambia; na, kama vile nilipokuwapo mara ya pili, vivyo hivyo sasa nisipokuwapo, nawaambia wazi wao waliotenda dhambi tangu hapo, na wengine wote, ya kwamba, nikija, sitahurumia; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.2",
            "verseOrgIds": [
              "2CO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kuwa mnatafuta dalili ya Kristo, asemaye ndani yangu, ambaye si dhaifu kwenu, bali ana uweza ndani yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.3",
            "verseOrgIds": [
              "2CO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.7"
              },
              "items": [
                {
                  "text": "Flp 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana, alisulibiwa katika udhaifu, lakini anaishi kwa nguvu za Mungu. Maana sisi nasi tu dhaifu katika yeye; lakini tutaishi pamoja naye kwa uweza wa Mungu ulio kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.4",
            "verseOrgIds": [
              "2CO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.11.28"
              },
              "items": [
                {
                  "text": "1 Kor 11:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jijaribuni wenyewe kwamba mmekuwa katika imani; jithibitisheni wenyewe. Au hamjijui wenyewe, kwamba Yesu Kristo yu ndani yenu? Isipokuwa mmekataliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.5",
            "verseOrgIds": [
              "2CO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini natumaini kama mtajua ya kuwa sisi hatukukataliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.6",
            "verseOrgIds": [
              "2CO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi twamwomba Mungu, msifanye lo lote lililo baya; si kwamba sisi tuonekane tumekubaliwa, lakini ninyi mfanye lile lililo jema, tujapokuwa sisi tu kama waliokataliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.7",
            "verseOrgIds": [
              "2CO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.6"
              },
              "items": [
                {
                  "text": "1 Kor 13:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana hatuwezi kutenda neno lo lote kinyume cha kweli, bali kwa ajili ya kweli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.8",
            "verseOrgIds": [
              "2CO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana twafurahi, iwapo sisi tu dhaifu, nanyi mmekuwa hodari. Tena twaomba hili nalo, kutimilika kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.9",
            "verseOrgIds": [
              "2CO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.3"
              },
              "items": [
                {
                  "text": "2 Kor 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.8"
              },
              "items": [
                {
                  "text": "10:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu hiyo, naandika haya nisipokuwapo, ili, nikiwapo, nisiutumie ukali kwa kadiri ya uwezo ule niliopewa na Bwana, kwa kujenga wala si kwa kubomoa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.10",
            "verseOrgIds": [
              "2CO.13.10"
            ]
          }
        }
      ]
    },
