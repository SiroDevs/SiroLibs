              "items": [
                {
                  "text": "Rum 15:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hatimaye, ndugu, kwaherini; mtimilike, mfarijike, nieni mamoja, mkae katika amani; na Mungu wa upendo na amani atakuwa pamoja nanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.11",
            "verseOrgIds": [
              "2CO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.20"
              },
              "items": [
                {
                  "text": "1 Kor 16:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Salimianeni kwa busu takatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.12",
            "verseOrgIds": [
              "2CO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watakatifu wote wawasalimu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.13",
            "verseOrgIds": [
              "2CO.13.13"
            ]
          }
        }
      ]
