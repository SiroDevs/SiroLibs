                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana sisi tulio hai, siku zote twatolewa tufe kwa ajili ya Yesu, ili uzima wa Yesu nao udhihirishwe katika miili yetu ipatikanayo na mauti. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.11",
            "verseOrgIds": [
              "2CO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi hapo mauti hufanya kazi ndani yetu, bali uzima ndani yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.12",
            "verseOrgIds": [
              "2CO.4.12"
            ]
          }
        },
