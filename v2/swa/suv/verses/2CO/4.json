                  "text": "1 Kor 6:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "tukijua ya kwamba yeye aliyemfufua Bwana Yesu atatufufua sisi nasi pamoja na Yesu, na kutuhudhurisha pamoja nanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.14",
