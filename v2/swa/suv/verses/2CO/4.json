                  "text": "7:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pande zote twadhikika, bali hatusongwi; twaona shaka, bali hatukati tamaa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.8",
            "verseOrgIds": [
