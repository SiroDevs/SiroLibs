                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "siku zote twachukua katika mwili kuuawa kwake Yesu, ili uzima wa Yesu nao udhihirishwe katika miili yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.10",
            "verseOrgIds": [
