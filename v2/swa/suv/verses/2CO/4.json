              "items": [
                {
                  "text": "2 Kor 1:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana hatujihubiri wenyewe, bali Kristo Yesu ya kuwa ni Bwana; na sisi wenyewe kuwa tu watumishi wenu kwa ajili ya Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.5",
            "verseOrgIds": [
