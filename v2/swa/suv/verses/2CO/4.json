                }
              ]
            }
          ]
        },
        {
          "text": "lakini tumekataa mambo ya aibu yaliyositirika, wala hatuenendi kwa hila, wala kulichanganya neno la Mungu na uongo; bali kwa kuidhihirisha iliyo kweli twajionyesha kuwa na haki, dhamiri za watu zikitushuhudia mbele za Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.2",
            "verseOrgIds": [
