                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ambao ndani yao mungu wa dunia hii amepofusha fikira zao wasioamini, isiwazukie nuru ya injili ya utukufu wake Kristo aliye sura yake Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.4",
            "verseOrgIds": [
