          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "twaudhiwa, bali hatuachwi; twatupwa chini, bali hatuangamizwi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.9",
            "verseOrgIds": [
              "2CO.4.9"
            ]
