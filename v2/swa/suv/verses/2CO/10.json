              },
              "items": [
                {
                  "text": "1 Kor 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana mtu mwenye kukubaliwa si yeye ajisifuye, bali yeye asifiwaye na Bwana.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.18",
