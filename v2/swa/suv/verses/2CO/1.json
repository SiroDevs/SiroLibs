                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na ahimidiwe Mungu, Baba wa Bwana wetu Yesu Kristo, Baba wa rehema, Mungu wa faraja yote; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.3",
            "verseOrgIds": [
              "2CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "atufarijiye katika dhiki zetu zote ili nasi tupate kuwafariji wale walio katika dhiki za namna zote, kwa faraja hizo, tunazofarijiwa na Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.4",
            "verseOrgIds": [
              "2CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 1:5"
          },
          "items": [
