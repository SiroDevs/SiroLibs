              "attrs": {
                "loc": "PSA.94.19"
              },
              "items": [
                {
                  "text": "94:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa kuwa kama vile mateso ya Kristo yanavyozidi kwetu, vivyo hivyo faraja yetu inazidi kwa njia ya Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.5",
            "verseOrgIds": [
              "2CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
