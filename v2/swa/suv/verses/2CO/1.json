                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana ahadi zote za Mungu zilizopo katika yeye ni Ndiyo; tena kwa hiyo katika yeye ni Amin; Mungu apate kutukuzwa kwa sisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.20",
            "verseOrgIds": [
