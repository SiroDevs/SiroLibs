          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninyi nanyi mkisaidiana nasi kwa ajili yetu katika kuomba, ili, kwa sababu ya ile karama tupewayo sisi kwa msaada wa watu wengi, watu wengi watoe shukrani kwa ajili yetu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
