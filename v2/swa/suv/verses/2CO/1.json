        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.15"
              },
              "items": [
                {
                  "text": "2 Kor 4:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini ikiwa sisi tu katika dhiki, ni kwa ajili ya faraja yenu na wokovu wenu; au ikiwa twafarijiwa, ni kwa ajili ya faraja yenu; ambayo hutenda kazi yake kwa kustahimili mateso yale yale tuteswayo na sisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.6",
            "verseOrgIds": [
              "2CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tumaini letu kwa ajili yenu ni imara, tukijua ya kuwa kama vile mlivyo washiriki wa yale mateso, vivyo hivyo mmekuwa washiriki wa zile faraja.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        }
