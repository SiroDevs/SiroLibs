                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana Mwana wa Mungu, Kristo Yesu, aliyehubiriwa katikati yenu na sisi, yaani, mimi na Silwano na Timotheo, hakuwa Ndiyo na siyo; bali katika yeye ni Ndiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.19",
            "verseOrgIds": [
              "2CO.1.19"
            ]
          }
        },
        {
          "name": "verse",
