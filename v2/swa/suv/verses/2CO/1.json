          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naam, sisi wenyewe tulikuwa na hukumu ya mauti katika nafsi zetu ili tusijitumainie nafsi zetu, bali tumtumaini Mungu, awafufuaye wafu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.9",
            "verseOrgIds": [
              "2CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
