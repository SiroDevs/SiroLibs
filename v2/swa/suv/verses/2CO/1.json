                "loc": "2TI.4.18"
              },
              "items": [
                {
                  "text": "2 Tim 4:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aliyetuokoa sisi katika mauti kuu namna ile; tena atatuokoa; ambaye tumemtumaini kwamba atazidi kutuokoa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.10",
            "verseOrgIds": [
              "2CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
