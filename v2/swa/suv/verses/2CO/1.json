              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana hatuwaandikii ninyi neno, ila yale msomayo, au kuyakiri; nami nataraji ya kuwa mtayakiri hayo hata mwisho; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.13",
