                "loc": "1CO.4.21"
              },
              "items": [
                {
                  "text": "1 Kor 4:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini nafsini mwangu nalikusudia hivi, nisije kwenu tena kwa huzuni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.1",
            "verseOrgIds": [
              "2CO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana mimi nikiwatia huzuni, basi ni nani anifurahishaye mimi ila yeye ahuzunishwaye nami? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.2",
            "verseOrgIds": [
              "2CO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami naliwaandikia neno lilo hilo, ili nijapo nisitiwe huzuni na wale ambao ilinipasa kuwafurahia; nikiwatumaini ninyi nyote kwamba furaha yangu ni yenu nyote pia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.3",
            "verseOrgIds": [
              "2CO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.31"
              },
              "items": [
                {
                  "text": "Mdo 20:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana katika dhiki nyingi na taabu ya moyo niliwaandikia na machozi mengi; si kwamba mhuzunishwe, bali mpate kujua upendo wangu nilio nao kwenu jinsi ulivyo mwingi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.4",
            "verseOrgIds": [
              "2CO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Msamaha kwa Mkosaji",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
