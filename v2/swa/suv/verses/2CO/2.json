                "loc": "1CO.16.9"
              },
              "items": [
                {
                  "text": "1 Kor 16:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi nilipofika Troa kwa ajili ya Injili ya Kristo, nikafunguliwa mlango katika Bwana, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.12",
            "verseOrgIds": [
              "2CO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "sikuona raha nafsini mwangu, kwa sababu sikumwona Tito ndugu yangu, bali niliagana nao, nikaondoka kwenda Makedonia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ila Mungu ashukuriwe, anayetushangiliza daima katika Kristo, na kuidhihirisha harufu ya kumjua yeye kila mahali kwa kazi yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.14",
            "verseOrgIds": [
              "2CO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.18"
              },
              "items": [
                {
                  "text": "1 Kor 1:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana sisi tu manukato ya Kristo, mbele za Mungu, katika wao wanaookolewa, na katika wao wanaopotea; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.15",
            "verseOrgIds": [
              "2CO.2.15"
            ]
          }
        },
        {
