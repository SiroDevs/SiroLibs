                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.34"
              },
              "items": [
                {
                  "text": "Lk 2:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "katika hao wa pili harufu ya mauti iletayo mauti; katika hao wa kwanza harufu ya uzima iletayo uzima. Naye ni nani atoshaye kwa mambo hayo? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.16",
            "verseOrgIds": [
              "2CO.2.16"
            ]
          }
        },
        {
