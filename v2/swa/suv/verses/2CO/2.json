          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.1.12"
              },
              "items": [
                {
                  "text": "2 Kor 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.11"
              },
              "items": [
                {
                  "text": "1 Pet 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana sisi si kama walio wengi, walighoshio neno la Mungu; bali kama kwa weupe wa moyo, kama kutoka kwa Mungu, mbele za Mungu, twanena katika Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.17",
            "verseOrgIds": [
              "2CO.2.17"
            ]
          }
        }
