            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Katika habari za Misri; habari za jeshi la Farao Neko, mfalme wa Misri, lililokuwa karibu na mto Frati katika Karkemishi, ambalo Nebukadreza, mfalme wa Babeli, alilipiga katika mwaka wa nne wa Yehoyakimu, mwana wa Yosia, mfalme wa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.2",
            "verseOrgIds": [
              "JER.46.2"
            ]
          }
        }
      ]
