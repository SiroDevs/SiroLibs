            {
              "text": "Eze 29 na 30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno hili ndilo ambalo BWANA alimwambia Yeremia, nabii, kueleza jinsi Nebukadreza, mfalme wa Babeli, atakavyokuja na kuipiga nchi ya Misri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.13",
