                  "text": "Isa 47:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Panda uende Gileadi, ukatwae zeri, Ee binti, bikira wa Misri; unatumia dawa nyingi bure tu; hupati kupona kamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.11",
            "verseOrgIds": [
              "JER.46.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataifa wamesikia habari za aibu yako, nayo dunia imejaa kilio chako; maana shujaa amejikwaa juu ya shujaa mwenzake, wameanguka wote wawili pamoja.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.12",
            "verseOrgIds": [
              "JER.46.12"
            ]
          }
        }
      ]
