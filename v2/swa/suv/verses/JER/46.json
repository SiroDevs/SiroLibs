              "type": "text"
            }
          ]
        },
        {
          "text": "Neno la BWANA lililomjia Yeremia, nabii, katika habari za mataifa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.1",
            "verseOrgIds": [
              "JER.46.1"
            ]
