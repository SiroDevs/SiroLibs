                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tengenezeni kigao na ngao, mkakaribie ili kupigana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.3",
            "verseOrgIds": [
              "JER.46.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watandikeni farasi; pandeni, enyi mpandao farasi; simameni na chapeo zenu, isugueni mikuki; zivaeni dirii. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.4",
            "verseOrgIds": [
              "JER.46.4"
            ]
          }
        },
        {
