              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.15+REV.6.16+REV.6.17"
              },
              "items": [
                {
                  "text": "Ufu 6:15-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nimeyaona haya kwa sababu gani? Wamefadhaika, wamerudi nyuma; mashujaa wao wamevunjika-vunjika; wanakimbia upesi sana, hawatazami nyuma; hofu ziko pande zote; asema BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.5",
            "verseOrgIds": [
              "JER.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.19"
              },
              "items": [
                {
                  "text": "Dan 11:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mtu mwepesi asikimbie, wala shujaa asiokoke; pande za kaskazini karibu na mto Frati wamejikwaa na kuanguka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.6",
            "verseOrgIds": [
              "JER.46.6"
            ]
          }
        }
