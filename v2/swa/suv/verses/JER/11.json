        },
        {
          "text": "Naye BWANA akaniambia, Hubiri maneno haya yote katika miji ya Yuda, na katika njia kuu za Yerusalemu, ukisema, Yasikieni maneno ya maagano haya, mkayafanye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.6",
            "verseOrgIds": [
              "JER.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
