                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "niliyowaamuru baba zenu, siku ile nilipowatoa katika nchi ya Misri, katika tanuru ya chuma, nikisema, Itiini sauti yangu, mkafanye sawasawa na yote niwaagizayo ninyi; ndivyo mtakavyokuwa watu wangu, nami nitakuwa Mungu wenu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.4",
            "verseOrgIds": [
              "JER.11.4"
            ]
          }
