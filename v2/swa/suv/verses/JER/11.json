                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo miji ya Yuda, na wenyeji wa Yerusalemu, watakwenda na kuwalilia miungu wawafukiziao uvumba; lakini hawatawaokoa hata kidogo wakati wa taabu yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.12",
            "verseOrgIds": [
              "JER.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
