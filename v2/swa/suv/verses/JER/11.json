                  "text": "Gal 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ukawaambie, BWANA, Mungu wa Israeli, asema hivi, Na alaaniwe mtu asiyeyasikia maneno ya maagano haya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.3",
            "verseOrgIds": [
