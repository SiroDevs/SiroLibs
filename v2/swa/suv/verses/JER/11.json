              "items": [
                {
                  "text": "Yer 7:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi, usiwaombee watu hawa, wala usipaze sauti yako, wala kuwaombea dua watu hawa; maana sitawasikia wakati watakaponililia kwa ajili ya taabu yao.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.14",
            "verseOrgIds": [
