                "loc": "EZK.20.18"
              },
              "items": [
                {
                  "text": "Eze 20:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wameyarudia maovu ya baba zao, waliokataa kusikia maneno yangu; wamewafuata miungu mingine na kuwatumikia; nyumba ya Israeli, na nyumba ya Yuda, wameyavunja maagano yangu niliyoyafanya na baba zao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.10",
            "verseOrgIds": [
