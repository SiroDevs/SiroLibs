            "number": "7",
            "style": "v",
            "sid": "JER 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana naliwashuhudia sana baba zenu, siku ile nilipowatoa katika nchi ya Misri, hata leo, nikiamka mapema na kuwashuhudia, nikisema, Itiini sauti yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.7",
            "verseOrgIds": [
              "JER.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini hawakutii, wala kutega masikio yao, bali walikwenda kila mtu katika ushupavu wa moyo wake mbaya; kwa hiyo nimeleta juu yao maneno yote ya maagano haya, niliyowaamuru wayafanye; lakini hawakuyafanya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.8",
            "verseOrgIds": [
              "JER.11.8"
            ]
          }
        }
      ]
    },
