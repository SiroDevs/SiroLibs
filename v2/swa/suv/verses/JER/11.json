                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye BWANA akaniambia, Fitina imeonekana katika watu wa Yuda, na katika wenyeji wa Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.9",
