        },
        {
          "text": "Ole wangu, mama yangu, kwa kuwa umenizaa mtu wa kuteta, na mtu wa kushindana na dunia yote! Mimi sikukopesha kwa riba, wala watu hawakunikopesha kwa riba; lakini kila mmoja wao hunilaani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA akasema, Hakika nitakutia nguvu upate mema; hakika nitamlazimisha adui akusihi wakati wa uovu, na wakati wa taabu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        }
      ]
