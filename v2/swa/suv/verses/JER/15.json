              "items": [
                {
                  "text": "Amo 8:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwanamke aliyezaa watoto saba anazimia; ametoa roho; jua lake limekuchwa, ungali ni wakati wa mchana; ametahayarika na kufedheheka; na mabaki yao nitawatoa kwa upanga mbele ya adui zao, asema BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
