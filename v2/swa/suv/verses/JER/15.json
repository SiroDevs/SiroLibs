              "items": [
                {
                  "text": "Ufu 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha itakuwa, hapo watakapokuambia, Tutoke, tuende wapi? Utawaambia, BWANA asema hivi, Walioandikiwa kufa, watakwenda kufa; au kufa kwa upanga, watakufa kwa upanga; au kufa kwa njaa, watakufa kwa njaa, au kutekwa nyara, watakuwa mateka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
