                "loc": "HOS.13.14"
              },
              "items": [
                {
                  "text": "Hos 13:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umenikataa mimi, asema BWANA, umerudi nyuma; ndiyo maana nimenyosha mkono wangu juu yako, na kukuangamiza; nimechoka kwa kughairi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        },
        {
