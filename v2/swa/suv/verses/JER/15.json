              "items": [
                {
                  "text": "Kum 28:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitaamrisha juu yao namna nne, asema BWANA; upanga uue, na mbwa wararue, na ndege wa angani, na wanyama wakali wa nchi, wale na kuangamiza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
