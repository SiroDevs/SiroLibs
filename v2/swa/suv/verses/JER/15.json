              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Mtu aweza kuvunja chuma, naam, chuma kitokacho kaskazini, au shaba? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
