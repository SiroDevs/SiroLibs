              "items": [
                {
                  "text": "Kum 32:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitakulazimisha kuwatumikia adui zako katika nchi usiyoijua; maana moto umewashwa katika hasira yangu, utakaowateketeza ninyi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
