                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitawafanya kuwa kitu cha kutisha katika falme zote za duniani, kwa sababu ya Manase, mwana wa Hezekia mfalme wa Yuda, kwa sababu ya mambo aliyoyatenda katika Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.4",
            "verseOrgIds": [
              "JER.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.51.19"
              },
              "items": [
                {
                  "text": "Isa 51:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana ni nani atakayekuhurumia, Ee Yerusalemu? Au ni nani atakayekulilia? Au ni nani atakayegeuka upande ili kuuliza habari za hali yako? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
