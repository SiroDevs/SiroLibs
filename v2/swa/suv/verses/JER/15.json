              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.3"
              },
              "items": [
                {
                  "text": "Yer 5:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nimewapepea kwa kipepeo katika malango ya nchi nimewaondolea watoto wao, nimewaharibu watu wangu; hata hivyo hawakurudi na kuziacha njia zao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wajane wao wameongezeka kwangu kuliko mchanga wa bahari; nimeleta mwenye kuteka wakati wa adhuhuri juu ya mama wa vijana; nimeleta hamu na maogofyo yampate ghafula. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.5"
              },
              "items": [
                {
                  "text": "1 Sam 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.47.9"
