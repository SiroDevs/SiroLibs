              "attrs": {
                "loc": "JER.17.3"
              },
              "items": [
                {
                  "text": "Yer 17:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mali yako na hazina zako nitazitoa kuwa nyara, bila kulipwa thamani yake; naam, kwa sababu ya dhambi zako zote, hata katika mipaka yako yote. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
            "verseOrgIds": [
              "JER.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
