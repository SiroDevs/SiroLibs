              "items": [
                {
                  "text": "2 The 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nikasema, Aa, Bwana MUNGU! Hakika umewadanganya sana watu hawa na Yerusalemu, ukisema, Mtakuwa na amani lakini upanga umeingia katika nafsi za watu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.10",
            "verseOrgIds": [
              "JER.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.27.8"
              },
              "items": [
                {
                  "text": "Isa 27:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.1"
