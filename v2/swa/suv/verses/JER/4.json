              "items": [
                {
                  "text": "Sef 2:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jitahirini kwa BWANA, mkaziondoe govi za mioyo yenu, enyi watu wa Yuda na wenyeji wa Yerusalemu; ghadhabu yangu isije ikatoka kama moto, ikawaka hata mtu asiweze kuizima, kwa sababu ya uovu wa matendo yenu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.4",
            "verseOrgIds": [
              "JER.4.4"
            ]
          }
        }
