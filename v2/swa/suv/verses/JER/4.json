                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tazama atapanda juu kama mawingu, na magari yake ya vita yatakuwa kama kisulisuli; farasi zake ni wepesi kuliko tai. Ole wetu, kwa sababu tumeharibika. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.13",
            "verseOrgIds": [
              "JER.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
