                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana BWANA awaambia hivi watu wa Yuda na Yerusalemu Ulimeni udongo katika konde zenu, wala msipande mbegu kati ya miiba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.3",
