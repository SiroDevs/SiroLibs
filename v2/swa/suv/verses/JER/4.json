          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.16"
              },
              "items": [
                {
                  "text": "Isa 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.4.8"
              },
              "items": [
                {
                  "text": "Yak 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ee Yerusalemu, jioshe moyo wako usiwe na uovu, upate kuokoka. Mawazo yako mabaya yatakaa ndani yako hata lini? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.14",
            "verseOrgIds": [
              "JER.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.16"
              },
              "items": [
                {
                  "text": "Yer 8:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana sauti yatangaza habari toka Dani, yahubiri uovu toka vilima vya Efraimu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.15",
            "verseOrgIds": [
              "JER.4.15"
            ]
          }
        },
        {
