              "type": "tag",
              "attrs": {
                "loc": "HOS.13.5"
              },
              "items": [
                {
                  "text": "Hos 13:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakati ule watu hawa na Yerusalemu wataambiwa neno hili, Upepo wa moto utokao katika vilele vya nyikani visivyo na miti, ukimwelekea binti ya watu wangu, hauwi upepo wa kupepeta, wala upepo wa kutakasa; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.11",
            "verseOrgIds": [
              "JER.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni upepo wa nguvu kuliko hizo utakaokuja kwa ajili yangu; sasa mimi nitatoa hukumu juu yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.12",
            "verseOrgIds": [
              "JER.4.12"
            ]
          }
        },
