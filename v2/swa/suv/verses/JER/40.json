            }
          ]
        },
        {
          "text": "Kisha, wakuu wote wa majeshi waliokuwa katika bara, wao na watu wao, waliposikia kwamba mfalme wa Babeli amemweka Gedalia, mwana wa Ahikamu, kuwa liwali juu ya nchi, na kwamba amemkabidhi wanaume na wanawake na watoto, na baadhi ya maskini wa nchi wasiochukuliwa mateka Babeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.7",
            "verseOrgIds": [
              "JER.40.7"
            ]
          }
        },
