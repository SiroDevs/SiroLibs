                  "text": "Hos 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa ajili ya hayo, mimi nami nitayafunua marinda yako mbele ya uso wako, na aibu yako itaonekana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.26",
