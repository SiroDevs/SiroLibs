              "items": [
                {
                  "text": "Mik 3:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hiyo ndiyo kura yako, fungu lako ulilopimiwa na mimi, asema BWANA; kwa kuwa umenisahau, na kuutumainia uongo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.25",
            "verseOrgIds": [
              "JER.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 13:26"
          },
          "items": [
