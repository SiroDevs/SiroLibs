                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikilizeni ninyi, kategeni masikio yenu; msifanye kiburi; maana BWANA amenena. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        },
