              "items": [
                {
                  "text": "Yer 25:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.23.32+EZK.23.33+EZK.23.34"
              },
              "items": [
                {
                  "text": "Eze 23:32-34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.10"
              },
              "items": [
                {
                  "text": "Ufu 14:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo utakapowaambia, BWANA asema hivi, Tazama, nitawajaza ulevi wenyeji wote wa nchi hii, hata wafalme wanaoketi katika kiti cha enzi cha Daudi, na makuhani, na manabii, na wenyeji wote wa Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.13",
            "verseOrgIds": [
              "JER.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitawagonganisha, mtu na mwenzake, naam, baba za watu na watoto wao pamoja, asema BWANA; sitahurumia, wala sitaachilia, wala sitarehemu, hata nisiwaangamize.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.14",
            "verseOrgIds": [
              "JER.13.14"
            ]
          }
        }
      ]
    },
    {
