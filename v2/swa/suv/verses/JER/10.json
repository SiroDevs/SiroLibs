              "items": [
                {
                  "text": "2 The 1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hasira yako uwamwagie mataifa wasiokujua, na jamaa zao wasioliitia jina lako; kwa maana wamemla Yakobo, naam, wamemla kabisa na kumwangamiza, na kuyafanya makao yake kuwa ukiwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.25",
            "verseOrgIds": [
