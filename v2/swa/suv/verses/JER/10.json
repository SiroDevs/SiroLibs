            "number": "1",
            "style": "v",
            "sid": "JER 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyi nyumba ya Israeli, lisikieni neno awaambialo BWANA; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.1",
            "verseOrgIds": [
              "JER.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.23"
              },
              "items": [
                {
                  "text": "Law 20:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA asema hivi, Msijifunze njia ya mataifa, wala msishangae kwa sababu ya ishara za mbinguni; maana mataifa hushangaa kwa sababu ya ishara hizo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.2",
            "verseOrgIds": [
              "JER.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana desturi za watu hao ni ubatili, maana mtu mmoja hukata mti mwituni, kazi ya mikono ya fundi na shoka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.3",
            "verseOrgIds": [
              "JER.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huupamba kwa fedha na dhahabu; huukaza kwa misumari na nyundo, usitikisike. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.4",
            "verseOrgIds": [
              "JER.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.115.5"
              },
              "items": [
                {
                  "text": "Zab 115:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.115.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.19"
              },
              "items": [
                {
                  "text": "Hab 2:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mfano wao ni mfano wa mtende, kazi ya cherehani, hawasemi; hawana budi kuchukuliwa, kwa sababu hawawezi kwenda. Usiwaogope; kwa maana hawawezi kutenda uovu, wala hawana uwezo wa kutenda mema. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.8.9"
              },
              "items": [
                {
                  "text": "Kut 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.86.8"
              },
              "items": [
                {
                  "text": "Zab 86:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.86.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hapana hata mmoja aliye kama wewe, Ee BWANA; wewe ndiwe uliye mkuu, na jina lako ni kuu katika uweza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.6",
            "verseOrgIds": [
              "JER.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.15.4"
              },
              "items": [
                {
                  "text": "Ufu 15:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ni nani asiyekucha wewe, Ee mfalme wa mataifa? Maana hii ni sifa yako wewe; kwa kuwa miongoni mwa wenye hekima wote wa mataifa, na katika hali yao ya enzi yote pia, hapana hata mmoja kama wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wote pia huwa kama wanyama, ni wapumbavu. Haya ni maelezo ya sanamu, ni shina la mti tu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.8",
            "verseOrgIds": [
              "JER.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.5"
              },
              "items": [
                {
                  "text": "Dan 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Iko fedha iliyofuliwa ikawa mabamba, iliyoletwa kutoka Tarshishi, na dhahabu kutoka Ufazi, kazi ya stadi na ya mikono ya mfua dhahabu; mavazi yao ni rangi ya samawi na urujuani; hayo yote ni kazi ya mafundi yao.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtawaambia hivi, Miungu hiyo isiyofanya mbingu na nchi, hiyo itaangamia katika nchi, nayo itatoweka chini ya mbingu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.11",
            "verseOrgIds": [
              "JER.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uhamisho Ujao",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.16",
            "verseOrgIds": [
              "JER.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya! Kusanya bidhaa yako katika nchi, wewe ukaaye katika mazingiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.17",
            "verseOrgIds": [
              "JER.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.10"
              },
              "items": [
                {
                  "text": "Eze 6:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana BWANA asema hivi, Tazama, wakati huu nitawatupa wenyeji wa nchi hii kama kwa kombeo, nitawataabisha, wapate kuona taabu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.18",
            "verseOrgIds": [
              "JER.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.9"
              },
              "items": [
                {
                  "text": "Mik 7:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ole wangu, kwa sababu ya jeraha yangu! Pigo langu laumia; lakini nalisema, Kweli, ni huzuni yangu mimi, nami sina budi kuivumilia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.19",
            "verseOrgIds": [
              "JER.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hema yangu umetekwa nyara, kamba zangu zote zimekatika; watoto wangu wameniacha na kwenda zao, pia hawako. Hapana mtu atakayenitandikia tena hema yangu, na kuyatundika mapazia yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.20",
            "verseOrgIds": [
              "JER.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu wachungaji wamekuwa kama wanyama, wala hawakuuliza kwa BWANA; basi hawakufanikiwa, na makundi yao yote yametawanyika. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.21",
            "verseOrgIds": [
              "JER.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauti imesikiwa, Tazama, inakuja; mshindo mkuu kutoka nchi ya kaskazini, ili kuifanya miji ya Yuda kuwa ukiwa, makao ya mbweha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.22",
            "verseOrgIds": [
              "JER.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.17.5"
              },
              "items": [
                {
                  "text": "Zab 17:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.119.116"
              },
              "items": [
                {
                  "text": "119:116",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.119.117"
              },
              "items": [
                {
                  "text": "117",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.1"
              },
              "items": [
                {
                  "text": "Mit 16:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ee BWANA, najua ya kuwa njia ya mwanadamu haimo katika nafsi yake; kuelekeza hatua zake si katika uwezo wa mwanadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.23",
            "verseOrgIds": [
              "JER.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.6.1"
              },
              "items": [
                {
                  "text": "Zab 6:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.30.11"
              },
              "items": [
                {
                  "text": "Yer 30:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.3.2"
              },
              "items": [
                {
                  "text": "Hab 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ee BWANA, unirudi kwa haki; si kwa hasira yako, usije ukaniangamiza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.24",
            "verseOrgIds": [
              "JER.10.24"
            ]
          }
        },
        {
