                }
              ]
            }
          ]
        },
        {
          "text": "BWANA awaambia watu hawa hivi, Hivyo ndivyo walivyopenda kutanga-tanga; hawakuizuia miguu yao; basi, BWANA hawakubali; sasa ataukumbuka uovu wao, atawapatiliza dhambi zao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
