        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.7.15"
              },
              "items": [
                {
                  "text": "Eze 7:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nikitoka kwenda shambani, tazama, wako huko waliouawa kwa upanga! Na nikiingia mjini, tazama, wamo humo wanaougua kwa sababu ya njaa! Maana nabii na kuhani, wote wawili, huenda huko na huko katika nchi, wala hawana maarifa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
