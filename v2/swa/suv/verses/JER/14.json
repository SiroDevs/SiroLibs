                  "text": "Kut 32:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye BWANA akaniambia, Usiwaombee watu hawa wapate heri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.11",
            "verseOrgIds": [
