        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.1.16"
              },
              "items": [
                {
                  "text": "Omb 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.21"
              },
              "items": [
                {
                  "text": "Yer 8:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nawe utawaambia neno hili, Macho yangu na yatiririke machozi, usiku na mchana, wala yasikome; kwa maana bikira, binti ya watu wangu, amevunjika mavunjiko makuu, kwa jeraha isiyoponyeka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 14:18"
