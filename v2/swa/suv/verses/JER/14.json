          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nikasema, Aa, Bwana, MUNGU! Tazama, manabii huwaambia, Hamtauona upanga, wala hamtakuwa na njaa; bali nitawapa amani iliyo thabiti mahali hapa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.13",
            "verseOrgIds": [
              "JER.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
