            }
          ]
        },
        {
          "text": "Wafungapo, mimi sitasikia kilio chao; na watoapo sadaka za kuteketezwa na sadaka ya unga, sitazitakabali; bali nitawaangamiza kwa upanga, na kwa njaa, na kwa tauni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.12",
            "verseOrgIds": [
              "JER.14.12"
            ]
          }
        }
