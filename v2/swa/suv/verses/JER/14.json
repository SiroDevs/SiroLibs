              "items": [
                {
                  "text": "Kut 29:45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa nini wewe umekuwa kama mtu aliyesituka, kama shujaa asiyeweza kuokoa? Lakini wewe, BWANA, u katikati yetu, nasi tunaitwa kwa jina lako; usituache.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
