                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.3"
              },
              "items": [
                {
                  "text": "2 Tim 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Niseme na nani na kushuhudia, wapate kusikia? Tazama, sikio lao halikutahiriwa, wala hawawezi kusikiliza; tazama, neno la BWANA limekuwa matukano kwao; hawalifurahii. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.10",
            "verseOrgIds": [
              "JER.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.10"
              },
              "items": [
                {
                  "text": "Yer 8:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.1.13"
              },
              "items": [
                {
                  "text": "Sef 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini nimejaa ghadhabu ya BWANA; nimechoka kwa kujizuia; imwageni juu ya watoto walio njiani, na juu ya kusanyiko la vijana pia; maana hata mume atatwaliwa pamoja na mkewe, mzee pamoja na yeye aliyetimiza siku zake. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.11",
            "verseOrgIds": [
              "JER.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.10+JER.8.11+JER.8.12"
              },
              "items": [
                {
                  "text": "Yer 8:10-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.1.13"
              },
              "items": [
                {
                  "text": "Sef 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na nyumba zao zitakuwa mali za watu wengine, mashamba yao na wake zao pamoja; kwa kuwa nitaunyosha mkono wangu juu ya wenyeji wa nchi hii, asema BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.12",
            "verseOrgIds": [
              "JER.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.11"
              },
              "items": [
                {
                  "text": "Isa 56:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.5"
              },
              "items": [
                {
                  "text": "Mik 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana, tangu aliye mdogo hata aliye mkubwa miongoni mwao, kila mmoja ni mtamanifu; na, tangu nabii hata kuhani, kila mmoja hutenda mambo ya udanganyifu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.13",
            "verseOrgIds": [
              "JER.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.13.10"
              },
              "items": [
                {
                  "text": "Eze 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wameiponya jeraha ya watu wangu kwa juu juu tu, wakisema, Amani, Amani, wala hapana amani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.14",
            "verseOrgIds": [
              "JER.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.3"
              },
              "items": [
                {
                  "text": "Yer 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Je! Walitahayarika, walipokuwa wameunda machukizo? La, hawakutahayarika hata kidogo, wala hawakuweza kuona haya usoni; basi, wataanguka miongoni mwa hao waangukao; wakati nitakapowajilia wataangushwa chini, asema BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.15",
            "verseOrgIds": [
              "JER.6.15"
            ]
          }
        }
      ]
    },
