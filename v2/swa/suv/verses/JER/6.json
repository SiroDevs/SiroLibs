              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu hiyo sikilizeni, enyi mataifa, mkajue, Ee kusanyiko, ni jambo gani litokealo kati yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.18",
