              "items": [
                {
                  "text": "Yer 7:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.20.8"
              },
              "items": [
                {
                  "text": "20:8",
