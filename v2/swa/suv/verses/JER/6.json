          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA wa majeshi asema hivi, Wataokota mabaki ya Israeli kama mzabibu; rudisha mkono wako ndani ya vikapu, kama mchuma zabibu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.9",
            "verseOrgIds": [
              "JER.6.9"
            ]
          }
        },
        {
          "name": "verse",
