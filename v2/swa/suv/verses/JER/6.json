                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.2"
              },
              "items": [
                {
                  "text": "Mik 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kama vile kisima kitoavyo maji yake, ndivyo utoavyo uovu wake; jeuri na kuharibu kwasikiwa ndani yake; ugonjwa na jeraha zi mbele zangu daima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.7",
            "verseOrgIds": [
              "JER.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.23.18"
              },
              "items": [
                {
                  "text": "Eze 23:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.12"
              },
              "items": [
                {
                  "text": "Hos 9:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uadhibishwe, Ee Yerusalemu, nafsi yangu, isije ikafarakana nawe; nisije nikakufanya ukiwa, nchi isiyokaliwa na watu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.8",
            "verseOrgIds": [
              "JER.6.8"
            ]
          }
        }
      ]
    },
    {
