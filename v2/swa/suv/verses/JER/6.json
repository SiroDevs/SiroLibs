          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.6.12"
              },
              "items": [
                {
                  "text": "Kut 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.60"
              },
              "items": [
                {
                  "text": "Mdo 7:60",
