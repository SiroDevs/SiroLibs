            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.38.18"
              },
              "items": [
                {
                  "text": "Yer 38:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao Wakaldayo wakaiteketeza nyumba ya mfalme, na nyumba za watu kwa moto, wakazibomoa kuta za Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.8",
