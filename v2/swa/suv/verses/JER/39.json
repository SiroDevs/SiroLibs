          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Nebukadreza, mfalme wa Babeli, akamwagiza Nebuzaradani, amiri wa askari walinzi, katika habari za Yeremia, akisema, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.11",
            "verseOrgIds": [
              "JER.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtwae, umtunze sana, wala usimtende neno baya lo lote; lakini umtendee kama atakavyokuambia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.12",
            "verseOrgIds": [
              "JER.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Nebuzaradani, amiri wa askari walinzi, na Nebu-Shazbani, mkuu wa matowashi, na Nergal-Shareza, mkuu wa wanajimu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.13",
            "verseOrgIds": [
              "JER.39.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "39:13",
              "type": "text"
            },
            {
              "text": "Au, Nebu-Shazbani, na Rab-sarisi, na Nergal-Shareza, na Rab-magi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na maakida wakuu wote wa mfalme wa Babeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.13",
            "verseOrgIds": [
              "JER.39.13"
            ]
          }
        },
