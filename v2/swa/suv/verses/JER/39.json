                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hata ikawa, Yerusalemu ulipotwaliwa, (katika mwaka wa kenda wa Sedekia, mfalme wa Yuda, katika mwezi wa kumi, Nebukadreza, mfalme wa Babeli, na jeshi lake lote, wakaja juu ya Yerusalemu, wakauhusuru; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.1",
            "verseOrgIds": [
              "JER.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "katika mwaka wa kumi na mmoja wa Sedekia, mwezi wa nne, siku ya kenda ya mwezi, sehemu ya ukuta wa mji ilibomolewa;) ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.2",
            "verseOrgIds": [
              "JER.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakuu wote wa mfalme wa Babeli wakaingia, wakaketi katika lango la katikati, yaani, Nergal-Shareza, mnyweshaji, Nebu-Sarseki, mkuu wa matowashi, Nergal-Shareza, mkuu wa wanajimu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.3",
            "verseOrgIds": [
              "JER.39.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "39:3",
              "type": "text"
            },
            {
              "text": "Au hivi, Nergal-Shareza, na Samgar-nebo, na Sarseki, na Rab-sarisi, na Nergal-Shareza, na Rab-magi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " pamoja na wakuu wengine wote wa mfalme wa Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.3",
            "verseOrgIds": [
              "JER.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa Sedekia, mfalme wa Yuda, na watu wote wa vita walipowaona, ndipo wakakimbia, wakatoka mjini usiku, kwa njia ya bustani ya mfalme, kwa lango lililokuwa kati ya zile kuta mbili; naye akatoka kwa njia ya Araba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.4",
            "verseOrgIds": [
              "JER.39.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "39:4",
              "type": "text"
            },
            {
              "text": "Araba",
              "type": "text"
            },
            {
              "text": "maana yake ni lile Bonde la mto wa Yordani na Bahari ya Chumvi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.4",
            "verseOrgIds": [
              "JER.39.4"
            ]
          }
        },
        {
          "name": "verse",
