              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi neno la BWANA likamjia Yeremia, wakati ule alipokuwa amefungwa katika uwanda wa walinzi, kusema, ",
          "type": "text",
          "attrs": {
