                  "text": "26:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakatuma watu wakamwondoa Yeremia katika uwanda wa walinzi, wakamweka katika mikono ya Gedalia, mwana wa Ahikamu, mwana wa Shafani, ili ampeleke nyumbani kwake; basi akakaa pamoja na hao watu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.14",
