                {
                  "text": "52:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pamoja na hayo akampofusha macho Sedekia, akamfunga kwa pingu ili amchukue mpaka Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.7",
            "verseOrgIds": [
              "JER.39.7"
            ]
          }
        },
