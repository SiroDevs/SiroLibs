              },
              "items": [
                {
                  "text": "Yer 35:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini wakasema, Hatutakunywa divai; kwa maana Yonadabu, mwana wa Rekabu, baba yetu, alituamuru, akisema, Msinywe divai, ninyi wala wana wenu, hata milele; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.6",
            "verseOrgIds": [
              "JER.35.6"
            ]
          }
        },
        {
