            }
          ]
        },
        {
          "text": "Nasi tumeitii sauti ya Yonadabu, mwana wa Rekabu, baba yetu, katika yote aliyotuamuru, kwamba tusinywe divai siku zetu zote, sisi, na wake zetu, na wana wetu, na binti zetu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.8",
            "verseOrgIds": [
              "JER.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "wala tusijijengee nyumba za kukaa; wala hatuna shamba la mizabibu, wala konde, wala mbegu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.9",
            "verseOrgIds": [
              "JER.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "bali tumekaa katika hema, nasi tumetii; tukafanya sawasawa na yote aliyotuamuru Yonadabu, baba yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.10",
            "verseOrgIds": [
              "JER.35.10"
            ]
          }
        },
        {
