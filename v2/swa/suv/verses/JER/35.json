                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini ikawa, Nebukadreza, mfalme wa Babeli, alipopanda akaingia nchi hii, ndipo tukasema, Haya! Twende Yerusalemu, tukiliogopa jeshi la Wakaldayo, na tukiliogopa jeshi la Washami; basi hivyo tunakaa Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        }
