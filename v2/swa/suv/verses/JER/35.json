        },
        {
          "text": "wala msijenge nyumba, wala msipande mbegu, wala msipande mizabibu, wala msiwe nayo; bali siku zenu zote mtakaa katika hema; mpate kuishi siku nyingi katika nchi ambayo mtakaa ndani yake hali ya wageni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.7",
            "verseOrgIds": [
              "JER.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 35:8"
