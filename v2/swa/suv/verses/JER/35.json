                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nikawaleta ndani ya nyumba ya BWANA, ndani ya chumba cha wana wa Hanani, mwana wa Igdalia, mtu wa Mungu, kilichokuwa karibu na chumba cha wakuu, nacho kilikuwa juu ya chumba cha Maaseya, mwana wa Shalumu, bawabu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.4",
            "verseOrgIds": [
              "JER.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikaweka mabakuli yaliyojaa divai, na vikombe, mbele ya wana wa nyumba ya Warekabi, nikawaambia, Nyweni divai. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.5",
            "verseOrgIds": [
              "JER.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
