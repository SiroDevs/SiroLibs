          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, kwa kuwa wana wa Yonadabu, mwana wa Rekabu, wameitimiza amri ya baba yao aliyowaamuru, lakini watu hawa hawakunisikiliza mimi; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.16",
            "verseOrgIds": [
              "JER.35.16"
            ]
          }
        },
        {
          "name": "verse",
