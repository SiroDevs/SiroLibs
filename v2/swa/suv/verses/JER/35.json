              "items": [
                {
                  "text": "Yer 32:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA wa majeshi, Mungu wa Israeli, asema hivi, Enenda ukawaambie wana wa Yuda, na wenyeji wa Yerusalemu, Je! Hamtaki kupokea mafundisho, myasikilize maneno yangu? Asema BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.13",
            "verseOrgIds": [
              "JER.35.13"
            ]
          }
        },
        {
