              "items": [
                {
                  "text": "Yer 7:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maneno ya Yonadabu, mwana wa Rekabu, aliyowaamuru wanawe, kwamba wasinywe divai, yametimizwa, na hata leo hawanywi; maana waitii hiyo amri ya baba yao; lakini mimi nimesema nanyi, nikiamka mapema na kunena, bali ninyi hamkunisikiliza mimi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.14",
            "verseOrgIds": [
              "JER.35.14"
            ]
          }
        },
