                }
              ]
            }
          ]
        },
        {
          "text": "Enenda nyumbani kwa Warekabi, ukanene nao, ukawalete nyumbani kwa BWANA, katika chumba kimoja, ukawape divai wanywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.2",
            "verseOrgIds": [
              "JER.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi nikamtwaa Yaazania, mwana wa Yeremia, mwana wa Habasinia, na ndugu zake, na wanawe wote, na nyumba yote ya Warekabi; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.3",
            "verseOrgIds": [
              "JER.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
