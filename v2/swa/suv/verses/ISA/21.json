                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufunuo juu ya bara ya bahari. Kama tufani za Negebu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:1",
              "type": "text"
            },
            {
              "text": "Negebu",
              "type": "text"
            },
            {
              "text": "tafsiri yake ni Nchi za kusini.",
              "type": "text"
            }
          ]
        },
        {
          "text": " zikaribiavyo kwa kasi, inakuja kutoka bara, toka nchi itishayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
