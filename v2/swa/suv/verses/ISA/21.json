                "loc": "1SA.24.13"
              },
              "items": [
                {
                  "text": "1 Sam 24:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.49.34"
              },
              "items": [
                {
                  "text": "Yer 49:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.24.16"
              },
              "items": [
                {
                  "text": "Isa 24:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.17"
              },
              "items": [
                {
                  "text": "13:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nimeonyeshwa maono magumu; atendaye hila anatenda hila, mharibu anaharibu. Panda juu, Ee Elamu; husuru, Ee Umedi; mimi ninakomesha maombolezo yake yote. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu hiyo viuno vyangu vimejaa maumivu, utungu umenishika, kama utungu wa mwanamke azaaye; ninaumwa sana, nisiweze kusikia; nimefadhaishwa wa hofu, nisiweze kuona. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.67"
              },
              "items": [
                {
                  "text": "Kum 28:67",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moyo wangu unapiga-piga, utisho umenitaabisha, gizagiza la jioni nilipendalo limegeuka likanitetemesha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.5"
              },
              "items": [
                {
                  "text": "Dan 5:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wanaandika meza, wanaweka ulinzi, wanakula, wanakunywa. Simameni, enyi wakuu, itieni ngao mafuta. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana Bwana ameniambia hivi, Enenda, weka mlinzi; aonayo na ayatangaze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.6",
            "verseOrgIds": [
              "ISA.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye akiona kundi la wapanda farasi, wakienda wawili wawili, na kundi la punda, na kundi la ngamia; asikilize sana, akijitahidi kusikiliza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.1"
              },
              "items": [
                {
                  "text": "Hab 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo akalia kama simba, Ee Bwana, mimi nasimama daima juu ya mnara wakati wa mchana, na kila usiku ninakaa katika zamu ya ulinzi wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.8",
            "verseOrgIds": [
              "ISA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.19"
              },
              "items": [
                {
                  "text": "Isa 13:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.2"
