                "loc": "MAT.13.14+MAT.13.15"
              },
              "items": [
                {
                  "text": "Mt 13:14-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.12"
