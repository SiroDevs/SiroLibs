                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.40"
              },
              "items": [
                {
                  "text": "Yn 12:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.28.26+ACT.28.27"
              },
              "items": [
                {
                  "text": "Mdo 28:26-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye akaniambia, Enenda, ukawaambie watu hawa, Fulizeni kusikia, lakini msifahamu; fulizeni kutazama, lakini msione. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.9",
            "verseOrgIds": [
              "ISA.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uunoneshe moyo wa watu hawa, ukayatie uzito masikio yao, ukayafumbe macho yao; wasije wakaona kwa macho yao, na kusikia kwa masikio yao, na kufahamu kwa mioyo yao, na kurejea na kuponywa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.10",
            "verseOrgIds": [
              "ISA.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nilipouliza, Ee Bwana, hata lini? Naye akanijibu, Hata miji itakapokuwa ukiwa, haina wenyeji, na nyumba zitakapokuwa hazina watu, na nchi hii itakapokuwa ganjo kabisa; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.11",
            "verseOrgIds": [
              "ISA.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.64"
              },
              "items": [
                {
                  "text": "Kum 28:64",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "hata BWANA atakapowahamisha watu waende mbali sana, na mahame yatakapokuwa mengi ndani ya nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.12",
            "verseOrgIds": [
              "ISA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.5"
              },
              "items": [
                {
                  "text": "Rum 11:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na ijapokuwa imebaki sehemu moja katika sehemu kumi ndani yake, italiwa hii nayo; kama mvinje na kama mwaloni, ambao shina lake limebaki, ingawa imekatwa; kadhalika mbegu takatifu ndiyo shina lake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.13",
            "verseOrgIds": [
              "ISA.6.13"
            ]
          }
