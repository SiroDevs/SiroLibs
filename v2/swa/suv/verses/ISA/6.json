                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikaisikia sauti ya Bwana, akisema, Nimtume nani, naye ni nani atakayekwenda kwa ajili yetu? Ndipo niliposema, Mimi hapa, nitume mimi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.8",
            "verseOrgIds": [
              "ISA.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
