                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu hiyo ubaya utakupata; wala hutajua kutopoa kwake; na msiba utakuangukia; hutaweza kuuondoa; na ukiwa utakupata kwa ghafula, usioujua. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        },
        {
          "name": "verse",
