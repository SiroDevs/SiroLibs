              "items": [
                {
                  "text": "Mal 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tazama, watakuwa kama mabua makavu; moto utawateketeza; hawatajiokoa na nguvu za mwali wa moto; hautakuwa kaa la kukota moto, wala moto wa kukaa karibu nao. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
