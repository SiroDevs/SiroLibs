              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simama sasa na uganga wako, na wingi wa uchawi wako, uliojitaabisha nao tangu ujana wako; labda utaweza kupata faida, labda utaweza kushinda. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.12",
            "verseOrgIds": [
              "ISA.47.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umechoka kwa wingi wa mashauri yako; basi, na wasimame hao wajuao falaki, wazitazamao nyota, watabirio kila mwezi mambo ya mwezi huo, wakakuokoe na mambo yatakayokupata. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
