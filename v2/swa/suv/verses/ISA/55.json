              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana mawazo yangu si mawazo yenu, wala njia zenu si njia zangu; asema BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.8",
            "verseOrgIds": [
              "ISA.55.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 55:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana kama vile mbingu zilivyo juu sana kuliko nchi, kadhalika njia zangu zi juu sana kuliko njia zenu, na mawazo yangu kuliko mawazo yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 55:10"
          },
          "items": [
