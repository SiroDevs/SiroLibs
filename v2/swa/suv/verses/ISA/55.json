              },
              "items": [
                {
                  "text": "2 Kor 9:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana kama vile mvua ishukavyo, na theluji, kutoka mbinguni, wala hairudi huko; bali huinywesha ardhi, na kuizalisha na kuichipuza, ikampa mtu apandaye mbegu, na mtu alaye chakula; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
