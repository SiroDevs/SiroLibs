              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndivyo litakavyokuwa neno langu, litokalo katika kinywa changu; halitanirudia bure, bali litatimiza mapenzi yangu, nalo litafanikiwa katika mambo yale niliyolituma.",
          "type": "text",
          "attrs": {
