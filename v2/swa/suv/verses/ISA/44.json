                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA, aliyekufanya, na kukuumba toka tumboni, yeye atakayekusaidia, asema hivi; Usiogope, Ee Yakobo, mtumishi wangu; na wewe, Yeshuruni, niliyekuchagua. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.2",
            "verseOrgIds": [
              "ISA.44.2"
            ]
          }
        },
        {
