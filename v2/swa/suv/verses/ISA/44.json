                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.22.32"
              },
              "items": [
                {
                  "text": "2 Sam 22:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Msiogope wala msifanye hofu; je! Sikukuhubiri haya zamani na kuyaonyesha? Na ninyi ni mashahidi wangu. Je! Yuko Mungu zaidi yangu mimi? Hakika hapana Mwamba; mimi sijui mwingine.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.8",
            "verseOrgIds": [
              "ISA.44.8"
            ]
          }
        }
      ]
    },
