                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wachongao sanamu, wote ni ubatili; wala mambo yao yawapendezayo hayatafaa kitu; wala mashahidi wao wenyewe hawaoni, wala hawajui; ili watahayarike. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.9",
            "verseOrgIds": [
              "ISA.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.10.5"
              },
              "items": [
                {
                  "text": "Yer 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.18"
              },
              "items": [
                {
                  "text": "Hab 2:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ni nani aliyejichongea mungu mmoja, au aliyesubu sanamu isiyofaa kitu? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.10",
            "verseOrgIds": [
              "ISA.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.97.7"
              },
              "items": [
                {
                  "text": "Zab 97:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.17"
              },
              "items": [
                {
                  "text": "Isa 42:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tazama, wenziwe wote watatahayari; na mafundi, hao ni wanadamu; na wakusanyike pamoja, wakasimame; wataogopa na kutahayari pamoja. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.11",
            "verseOrgIds": [
              "ISA.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.19"
              },
              "items": [
                {
                  "text": "Isa 40:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mfua chuma hufanza shoka, hufanya kazi kwa makaa, huitengeneza sanamu kwa nyundo, huifanyiza kwa nguvu za mkono wake; naam, huona njaa, nguvu zake zikampungukia; asipokunywa maji huzimia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.12",
            "verseOrgIds": [
              "ISA.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seremala hunyosha uzi; huiandika kwa kalamu ya mate; huitengeneza kwa randa, huiandika kwa bikari, huifanza kwa mfano wa mwanadamu, sawasawa na uzuri wa mwanadamu, ili ikae nyumbani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.13",
            "verseOrgIds": [
              "ISA.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye hujikatia mierezi, hutwaa mtiriza, na mwaloni, hujichagulia mti mmoja katika miti ya msituni; hupanda mvinje, mvua ikausitawisha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.14",
            "verseOrgIds": [
              "ISA.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha utamfaa mwanadamu kwa kuni; hutwaa kipande, akaota moto; naam, huuwasha moto, akaoka mkate; naam, huufanya mungu, akauabudu; huifanya sanamu ya kuchonga, akaisujudia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.15",
            "verseOrgIds": [
              "ISA.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sehemu moja huiteketeza; kwa sehemu nyingine hula nyama; huoka chakula kiokwacho, akashiba; naam, huota moto, akasema, Aha, nimeota moto, nimeona moto; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.16",
            "verseOrgIds": [
              "ISA.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kwa sehemu iliyobakia hufanya mungu, yaani, sanamu yake ya kuchonga; husujudu mbele yake akaiabudu, akaiomba, akasema, Uniokoe; maana wewe u mungu wangu. ",
