                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.38"
              },
              "items": [
                {
                  "text": "Yn 7:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana nitamimina maji juu yake aliye na kiu, na vijito vya maji juu ya mahali pakavu; nitamwaga roho yangu juu ya wazao wako, na baraka yangu juu yao utakaowazaa; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.3",
            "verseOrgIds": [
              "ISA.44.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao watatokea katika manyasi, kama mierebi karibu na mifereji ya maji. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.4",
            "verseOrgIds": [
              "ISA.44.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
