        },
        {
          "text": "Lakini sikia sasa, Ee Yakobo, mtumishi wangu; na Israeli, niliyekuchagua; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.1",
            "verseOrgIds": [
