              "items": [
                {
                  "text": "Kut 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.9.38"
              },
              "items": [
                {
                  "text": "Neh 9:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mmoja atasema, Mimi ni wa BWANA; na mwingine atajiita kwa jina la Yakobo; na mwingine ataandika juu ya mkono wake, Kwa BWANA, na kujiita kwa jina la Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.5",
            "verseOrgIds": [
              "ISA.44.5"
            ]
          }
        }
