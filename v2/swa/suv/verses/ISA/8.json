              "items": [
                {
                  "text": "Ebr 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitamngojea BWANA, awafichaye uso wake nyumba ya Yakobo, nami nitamtazamia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.17",
            "verseOrgIds": [
              "ISA.8.17"
            ]
          }
        },
        {
