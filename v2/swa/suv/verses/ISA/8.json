              "type": "text"
            }
          ]
        },
        {
          "text": "Ufunge huo ushuhuda, ukaitie muhuri sheria kati ya wanafunzi wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.16",
            "verseOrgIds": [
