          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana BWANA aliniambia hivi, kwa mkono hodari, akanifundisha nisiende katika njia ya watu hawa, akisema, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.11",
            "verseOrgIds": [
              "ISA.8.11"
            ]
