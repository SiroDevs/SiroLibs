          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.3.15"
              },
              "items": [
                {
                  "text": "Neh 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.9.7"
              },
              "items": [
                {
                  "text": "Yn 9:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu watu hawa wameyakataa maji ya Shiloa yapitayo polepole, na kufurahi kwa ajili ya Resini na huyo mwana wa Remalia, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "basi sasa angalia; Bwana aleta juu yao maji ya huo Mto, yenye nguvu, mengi sana, nayo ni mfalme wa Ashuru na utukufu wake wote; naye atakuja, na kupita juu ya mifereji yake yote, atafurika juu ya kingo zake zote; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.14"
              },
              "items": [
                {
                  "text": "Isa 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.23"
              },
              "items": [
                {
                  "text": "Mt 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "naye atapita, atapita kwa kasi na kuingia Yuda; atafurika na kupita katikati, atafika hata shingoni; na kule kuyanyosha mabawa yake kutaujaza upana wa nchi yako, Ee Imanueli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
