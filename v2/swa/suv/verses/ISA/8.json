                {
                  "text": "Zek 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.13"
              },
              "items": [
                {
                  "text": "Ebr 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Angalieni, mimi na watoto hawa niliopewa na BWANA tu ishara na ajabu katika Israeli, zitokazo kwa BWANA wa majeshi, yeye akaaye katika mlima Sayuni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.18",
            "verseOrgIds": [
