            "sid": "ISA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA akaniambia, Ujipatie ubao mkubwa ukaandike juu yake kwa kalamu ya binadamu, Kwa Maher-shalal-hash-bazi; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.1",
            "verseOrgIds": [
              "ISA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.16.10"
              },
              "items": [
                {
                  "text": "2 Fal 16:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nami nitajipatia mashahidi waaminifu ili kuandika habari, yaani, Uria, kuhani, na Zekaria, mwana wa Yeberekia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.2",
            "verseOrgIds": [
              "ISA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nikamwendea huyo nabii mke, naye akapata mimba, akazaa mtoto mwanamume. Kisha BWANA akaniambia, Mwite jina lake Maher-shalal-hash-bazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.3",
            "verseOrgIds": [
              "ISA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.16"
              },
              "items": [
                {
                  "text": "Isa 7:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana kabla mtoto huyo hajapata kujua kusema, Baba yangu, na Mama yangu, hazina za Dameski na mateka ya Samaria yatachukuliwa mbele ya mfalme wa Ashuru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.4",
            "verseOrgIds": [
              "ISA.8.4"
            ]
          }
        }
      ]
    },
    {
