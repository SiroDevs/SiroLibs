        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.14+1PE.3.15"
              },
              "items": [
                {
                  "text": "1 Pet 3:14-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Msiseme, Ni fitina, katika habari za mambo yote ambayo watu hawa watasema, Ni fitina; msihofu kwa hofu yao, wala msiogope. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.12"
              },
              "items": [
                {
                  "text": "Hes 20:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.5"
              },
              "items": [
                {
                  "text": "Lk 12:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA wa majeshi ndiye mtakayemtakasa; na awe yeye hofu yenu, na awe yeye utisho wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        },
        {
