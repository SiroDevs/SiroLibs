        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.18"
              },
              "items": [
                {
                  "text": "Lk 20:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wengi watajikwaa juu yake, na kuanguka na kuvunjika, na kunaswa na kukamatwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.15",
            "verseOrgIds": [
              "ISA.8.15"
            ]
          }
        }
      ]
