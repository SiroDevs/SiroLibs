                "loc": "1PE.2.8"
              },
              "items": [
                {
                  "text": "1 Pet 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye atakuwa ni mahali patakatifu; bali ni jiwe la kujikwaza na mwamba wa kujikwaa kwa nyumba za Israeli zote mbili, na mtego na tanzi kwa wenyeji wa Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
