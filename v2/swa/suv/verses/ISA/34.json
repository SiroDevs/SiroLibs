              "items": [
                {
                  "text": "Ufu 6:13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na jeshi lote la mbinguni litafumuliwa, na mbingu zitakunjwa kama karatasi, na jeshi lao lote litanyauka kama vile jani la mzabibu linyaukavyo na kupukutika, na kama jani la mtini linyaukavyo na kupukutika. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        },
