        },
        {
          "text": "watu wanikasirishao mbele za uso wangu daima, wakitoa dhabihu katika bustani zao, na kufukiza uvumba juu ya matofali; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.3",
            "verseOrgIds": [
              "ISA.65.3"
            ]
