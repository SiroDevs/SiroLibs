                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitaleta uzao toka Yakobo, na mrithi wa milima yangu toka Yuda, na mteule wangu atairithi, na watumishi wangu watakaa huko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.9",
            "verseOrgIds": [
