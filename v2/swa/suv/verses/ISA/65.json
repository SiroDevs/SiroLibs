                }
              ]
            }
          ]
        },
        {
          "text": "Nanyi mtaliacha jina lenu kuwa laana kwa wateule wangu. Na Bwana MUNGU atakuua; naye atawaita watumishi wake kwa jina lingine. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.15",
