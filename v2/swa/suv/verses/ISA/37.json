              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.35"
              },
              "items": [
                {
                  "text": "2 Fal 19:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi malaika wa BWANA alitoka, akaua watu mia na themanini na tano elfu katika kituo cha Waashuri, na watu walipoamka asubuhi na mapema, kumbe, hao walikuwa maiti wote pia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.36",
            "verseOrgIds": [
              "ISA.37.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ISA 37:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Senakeribu, mfalme wa Ashuru akaenda zake, akarudi Ninawi, akakaa huko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.37",
            "verseOrgIds": [
              "ISA.37.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ISA 37:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa alipokuwa akiabudu katika nyumba ya Nisroki, mungu wake, Adrameleki na Shareza, wanawe, wakampiga kwa upanga; wakakimbilia nchi ya Ararati; naye Esar-hadoni, mwanawe, akamiliki badala yake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.38",
            "verseOrgIds": [
              "ISA.37.38"
            ]
          }
        }
      ]
