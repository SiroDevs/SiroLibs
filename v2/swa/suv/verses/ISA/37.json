                "loc": "1SA.7.8"
              },
              "items": [
                {
                  "text": "1 Sam 7:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.4"
