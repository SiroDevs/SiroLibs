        },
        {
          "text": "Ikawa mfalme Hezekia aliposikia hayo, alizirarua nguo zake, akajivika nguo za magunia, akaingia katika nyumba ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.1",
            "verseOrgIds": [
              "ISA.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.22.14"
              },
              "items": [
                {
                  "text": "2 Fal 22:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akamtuma Eliakimu aliyekuwa msimamizi wa nyumba yake na Shebna, mwandishi, na wazee wa makuhani, wamejivika nguo za magunia, waende kwa Isaya nabii, mwana wa Amozi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.2",
            "verseOrgIds": [
              "ISA.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
