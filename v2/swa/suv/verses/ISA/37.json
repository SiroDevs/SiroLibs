                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakamwambia, Hezekia asema hivi, Siku hii ni siku ya dhiki, na aibu, na matukano; maana watoto wa tayari kuzaliwa, wala hapana nguvu za kuwazaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.3",
            "verseOrgIds": [
              "ISA.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
