                "loc": "JAS.5.14"
              },
              "items": [
                {
                  "text": "Yak 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yamkini BWANA, Mungu wako, atayasikia maneno ya huyo amiri ambaye mfalme wa Ashuru, bwana wake, amemtuma ili amtukane Mungu aliye hai; na BWANA, Mungu wako atayakemea maneno aliyoyasikia; basi, inua dua yako kwa ajili ya mabaki yaliyobakia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.4",
            "verseOrgIds": [
              "ISA.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, watumishi wa mfalme Hezekia wakaenda kwa Isaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.5",
            "verseOrgIds": [
              "ISA.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaya akawaambia, Mwambieni bwana wenu maneno haya; BWANA asema hivi, Usiyaogope maneno uliyoyasikia, ambayo watumishi wa mfalme wa Ashuru wamenitukana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.6",
            "verseOrgIds": [
              "ISA.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama, nitatia roho ndani yake, naye atasikia kivumi, na kurudi hata nchi yake mwenyewe, nami nitamwangusha kwa upanga katika nchi yake mwenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.7",
            "verseOrgIds": [
              "ISA.37.7"
            ]
          }
        }
      ]
    },
