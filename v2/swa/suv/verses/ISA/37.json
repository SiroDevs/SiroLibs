                  "text": "Yer 34:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi yule amiri akarudi, akamkuta mfalme wa Ashuru anafanya vita juu ya Libna; kwa maana alikuwa amesikia ya kwamba ameondoka, akaacha Lakishi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.8",
            "verseOrgIds": [
              "ISA.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye alisikia habari ya Tirhaka, mfalme wa Kushi, ya kwamba, Ametoka ili kupigana nawe; naye aliposikia hayo, akatuma wajumbe kwa Hezekia, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.9",
            "verseOrgIds": [
              "ISA.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwambieni Hezekia, mfalme wa Yuda, maneno haya, mkisema, Asikudanganye Mungu wako unayemtumaini, akisema, Yerusalemu hautatiwa katika mikono ya mfalme wa Ashuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.10",
            "verseOrgIds": [
              "ISA.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama, umesikia habari ya mambo yote, ambayo wafalme wa Ashuru wamezitenda nchi zote, kwa kuziangamiza kabisa je! Utaokoka wewe? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.11",
            "verseOrgIds": [
              "ISA.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.11.31"
              },
              "items": [
                {
                  "text": "Mwa 11:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Je! Miungu ya mataifa, ambao baba zangu waliwaangamiza, wamewaokoa? Gozani, na Harani, na Resefu, na wana wa Adini waliokuwa katika Telasari? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.12",
            "verseOrgIds": [
              "ISA.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.49.23"
              },
              "items": [
                {
                  "text": "Yer 49:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yuko wapi mfalme wa Hamathi, na mfalme wa Arpadi, na mfalme wa mji wa Sefarvaimu, wa Hena, na wa Iva?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.13",
            "verseOrgIds": [
              "ISA.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ombi la Hezekia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.13",
            "verseOrgIds": [
              "ISA.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Hezekia akaupokea waraka katika mikono ya wale wajumbe, akausoma; kisha Hezekia akapanda, akaingia katika nyumba ya BWANA, akaukunjua mbele za BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.14",
            "verseOrgIds": [
              "ISA.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia akamwomba BWANA, akisema, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.15",
            "verseOrgIds": [
              "ISA.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.22"
              },
              "items": [
                {
                  "text": "Kut 25:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ee BWANA wa majeshi, Mungu wa Israeli, ukaaye juu ya makerubi, wewe, naam, wewe peke yako, ndiwe Mungu wa falme zote za dunia. Wewe ndiwe uliyeziumba mbingu na nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.16",
            "verseOrgIds": [
              "ISA.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.18"
              },
              "items": [
                {
                  "text": "Dan 9:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tega sikio lako, BWANA, usikie; funua macho yako, BWANA, uone; uyasikie maneno ya Senakeribu, aliyopeleka ili kumtukana Mungu aliye hai. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.17",
            "verseOrgIds": [
              "ISA.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni kweli, BWANA, wafalme wa Ashuru wameziharibu nchi zote, na mashamba yao, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.18",
            "verseOrgIds": [
              "ISA.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuwatupa miungu yao motoni; kwa maana hao hawakuwa miungu, bali kazi ya mikono ya wanadamu; walikuwa miti na mawe, ndiyo sababu wakawaharibu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.19",
            "verseOrgIds": [
              "ISA.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi sasa, BWANA, Mungu wetu, utuokoe na mkono wake, falme zote za dunia zipate kujua ya kuwa wewe ndiwe BWANA, wewe peke yako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.20",
            "verseOrgIds": [
              "ISA.37.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.20",
            "verseOrgIds": [
              "ISA.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Isaya, mwana wa Amozi, akapeleka ujumbe kwa Hezekia, akisema, BWANA, Mungu wa Israeli, asema hivi, Kwa kuwa umeniomba juu ya Senakeribu, mfalme wa Ashuru, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.21",
            "verseOrgIds": [
              "ISA.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "tamko alilolitamka BWANA katika habari zake ndilo hili; Bikira, binti Sayuni, anakudharau, anakudhihaki sana; binti Yerusalemu anatikisa kichwa chake juu yako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.22",
            "verseOrgIds": [
              "ISA.37.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nani uliyemshutumu na kumtukana? Umeinua sauti yako juu ya nani, na kuinua macho yako juu? Juu ya Mtakatifu wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.23",
            "verseOrgIds": [
              "ISA.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umemshutumu Bwana kwa watumishi wako, kwa kuwa umesema, Kwa wingi wa magari yangu nimepanda juu ya vilele vya milima, mpaka mahali pa ndani ya Lebanoni; nami nitaikata mierezi yake mirefu, na misunobari yake mizuri, nami nitaingia ndani ya mahali pake palipoinuka, palipo mbali sana, msitu wa shamba lake lizaalo sana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.24",
            "verseOrgIds": [
              "ISA.37.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimechimba na kunywa maji, na kwa nyayo za miguu yangu nitaikausha mito yote ya Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.25",
            "verseOrgIds": [
              "ISA.37.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Hukusikia? Ni mimi niliyeyatenda hayo tokea zamani, na kuyafanya tokea siku za kale; nikayatimiza sasa, iwe kazi yako kuangamiza miji yenye boma, ikawe chungu na magofu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.26",
            "verseOrgIds": [
              "ISA.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiyo sababu wenyeji wao wakawa hawana nguvu, na kufadhaika, na kuhangaika, wakawa kama majani ya mashamba, kama miche mibichi, kama majani juu ya dari, kama shamba la ngano kabla haijaiva. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.27",
            "verseOrgIds": [
              "ISA.37.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini nakujua, kuketi kwako, na kutoka kwako, na kuingia kwako; na ghadhabu yako uliyonighadhibikia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.28",
            "verseOrgIds": [
              "ISA.37.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 37:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.41.2"
              },
              "items": [
                {
                  "text": "Ayu 41:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.32.9"
              },
              "items": [
                {
                  "text": "Zab 32:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.28"
              },
              "items": [
                {
                  "text": "Isa 30:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.4"
              },
              "items": [
                {
                  "text": "Eze 29:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.4.2"
              },
              "items": [
                {
                  "text": "Amo 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.3.3"
              },
              "items": [
                {
                  "text": "Yak 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu ya kunighadhibikia kwako, na kwa sababu kutakabari kwako kumefika masikioni mwangu, nitatia kulabu yangu katika pua yako, na hatamu yangu midomoni mwako, nami nitakurudisha kwa njia ile ile uliyoijia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.29",
            "verseOrgIds": [
              "ISA.37.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 37:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwako wewe dalili ndiyo hii; mwaka huu mtakula vitu vimeavyo vyenyewe; na mwaka wa pili mtakula mazao ya mbegu za vitu hivyo; na mwaka wa tatu pandeni mbegu, kavuneni; mkapande mizabibu katika mashamba, mkale matunda yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.30",
            "verseOrgIds": [
              "ISA.37.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 37:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mabaki yaliyookoka, yaliyobakia ya nyumba ya Yuda, yatatia mizizi chini, na kuzaa matunda juu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.31",
            "verseOrgIds": [
              "ISA.37.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 37:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.31"
              },
              "items": [
                {
                  "text": "2 Fal 19:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana katika Yerusalemu yatatoka mabaki, nao watakaookoka katika mlima Sayuni; wivu wa BWANA wa majeshi utatimiza mambo hayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.32",
            "verseOrgIds": [
              "ISA.37.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ISA 37:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, BWANA asema hivi katika habari za mfalme wa Ashuru, Yeye hataingia ndani ya mji huu, wala hatapiga mshale hapa, wala hatakuja mbele yake kwa ngao, wala hatajenga boma juu yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.33",
            "verseOrgIds": [
              "ISA.37.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ISA 37:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njia ile ile aliyoijia, kwa njia hiyo atarudi zake, wala hataingia ndani ya mji huu; asema BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.34",
            "verseOrgIds": [
              "ISA.37.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ISA 37:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.20.6"
              },
              "items": [
                {
                  "text": "2 Fal 20:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.27.3"
              },
              "items": [
                {
                  "text": "Isa 27:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitaulinda mji huu, niuokoe kwa ajili yangu mwenyewe, na kwa ajili ya Daudi, mtumishi wangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.35",
            "verseOrgIds": [
              "ISA.37.35"
            ]
          }
        }
      ]
    },
