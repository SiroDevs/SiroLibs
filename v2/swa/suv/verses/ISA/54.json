            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe uliyeteswa, uliyerushwa na tufani, usiyetulizwa, tazama, nitaweka mawe yako kwa rangi nzuri, nitaweka misingi yako kwa yakuti samawi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.11",
            "verseOrgIds": [
              "ISA.54.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 54:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitaifanya minara yako ya akiki nyekundu, na malango yako ya almasi, na mipaka yako yote ya mawe yapendezayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.12",
            "verseOrgIds": [
              "ISA.54.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 54:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
