              "items": [
                {
                  "text": "Yer 31:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.9.8+GEN.9.9+GEN.9.10+GEN.9.11+GEN.9.12+GEN.9.13+GEN.9.14+GEN.9.15+GEN.9.16+GEN.9.17"
              },
              "items": [
                {
                  "text": "Mwa 9:8-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana jambo hili limekuwa kama maji ya Nuhu kwangu; maana kama nilivyoapa ya kwamba maji ya Nuhu hayatapita juu ya dunia tena, kadhalika nimeapa ya kwamba sitakuonea hasira, wala kukukemea. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 54:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.46.2"
              },
              "items": [
                {
                  "text": "Zab 46:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.33"
              },
              "items": [
                {
                  "text": "89:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana milima itaondoka, na vilima vitaondolewa; bali wema wangu hautaondoka kwako, wala agano langu la amani halitaondolewa; asema BWANA akurehemuye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.10",
            "verseOrgIds": [
              "ISA.54.10"
            ]
          }
        }
      ]
