                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.1.5"
              },
              "items": [
                {
                  "text": "Sef 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sikieni haya, enyi watu wa nyumba ya Yakobo, mnaoitwa kwa jina la Israeli, mliotoka katika maji ya Yuda; mnaoapa kwa jina la BWANA, na kumtaja Mungu wa Israeli, lakini si kwa kweli, wala si kwa haki. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.11"
              },
              "items": [
                {
                  "text": "Mik 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.17"
              },
              "items": [
                {
                  "text": "Rum 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana hujiita wenyeji wa mji mtakatifu, hujitegemeza juu ya Mungu wa Israeli; BWANA wa majeshi ni jina lake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.21.45"
              },
              "items": [
                {
                  "text": "Yos 21:45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mimi nimehubiri mambo ya kale tangu zamani; naam, yalitoka katika kinywa changu, nikayadhihirisha; naliyatenda kwa ghafula, yakatokea. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.9"
              },
              "items": [
                {
                  "text": "Kut 32:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.27"
              },
              "items": [
                {
                  "text": "Kum 31:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu nalijua ya kuwa wewe u mkaidi, na shingo yako ni shingo ya chuma, na kipaji cha uso wako ni shaba; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "basi nimekuonyesha tangu zamani; kabla hayajatukia nalikuonyesha; usije ukasema, Sanamu yangu imetenda haya; sanamu yangu ya kuchonga, na sanamu yangu ya kuyeyusha, imeyaamuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umesikia haya; tazama haya yote; nanyi, je! Hamtayahubiri? Nimekuonyesha mambo mapya tangu wakati huu, naam, mambo yaliyofichwa, usiyoyajua. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yameumbwa sasa, wala si tokea zamani; na kabla ya siku hii ya leo hukusikia habari yake; usije ukasema, Tazama, naliyajua. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.58.3"
              },
              "items": [
                {
                  "text": "Zab 58:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naam, hukusikia; naam, hukujua; naam, tokea zamani sikio lako halikuzibuka; maana nalijua ya kuwa wewe watenda kwa hila nyingi, nawe umeitwa mkosaji tangu kuzaliwa kwako; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.9"
              },
              "items": [
                {
                  "text": "Yos 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.8"
              },
              "items": [
                {
                  "text": "Zab 106:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kwa ajili ya jina langu nitaahirisha hasira yangu, na kwa ajili yako nitajizuia, ili nisifiwe, wala nisikukatilie mbali. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.66.10"
              },
              "items": [
                {
                  "text": "Zab 66:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.25"
              },
              "items": [
                {
                  "text": "Isa 1:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.3"
              },
              "items": [
                {
                  "text": "Mal 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tazama, nimekusafisha, lakini si kama fedha; nimekuchagua katika tanuru ya mateso. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.10",
            "verseOrgIds": [
              "ISA.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.26"
              },
              "items": [
                {
                  "text": "Kum 32:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.8"
              },
              "items": [
                {
                  "text": "Isa 42:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa ajili ya nafsi yangu, kwa ajili ya nafsi yangu, nitatenda haya; je! Litiwe unajisi jina langu? Wala sitampa mwingine utukufu wangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.11",
            "verseOrgIds": [
              "ISA.48.11"
            ]
          }
        }
      ]
    },
    {
