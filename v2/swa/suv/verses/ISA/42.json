              "items": [
                {
                  "text": "Isa 48:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mimi ni BWANA; ndilo jina langu; na utukufu wangu sitampa mwingine, wala sitawapa sanamu sifa zangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama, mambo ya kwanza yamekuwa, nami nayahubiri mambo mapya; kabla hayajatokea nawapasheni habari zake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
