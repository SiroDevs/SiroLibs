        },
        {
          "text": "kuyafunua macho ya vipofu, kuwatoa gerezani waliofungwa, kuwatoa wale walioketi gizani katika nyumba ya kufungwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        },
        {
          "name": "verse",
