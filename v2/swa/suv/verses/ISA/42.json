              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikilizeni, enyi viziwi; tazameni, enyi vipofu, mpate kuona. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.18",
            "verseOrgIds": [
