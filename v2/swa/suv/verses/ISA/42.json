              },
              "items": [
                {
                  "text": "Rum 2:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Unaona mambo mengi, lakini huyatii moyoni; masikio yake ya wazi, lakini hasikii.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.20",
            "verseOrgIds": [
              "ISA.42.20"
            ]
          }
        }
      ]
    },
