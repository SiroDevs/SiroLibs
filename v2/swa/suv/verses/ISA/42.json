        "style": "s1"
      },
      "items": [
        {
          "text": "Uasi wa Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
