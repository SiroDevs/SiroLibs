                  "text": "Mwa 49:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hatazimia, wala hatakata tamaa, hata atakapoweka hukumu duniani; na visiwa vitaingojea sheria yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
