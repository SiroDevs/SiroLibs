        },
        {
          "text": "Mimi, BWANA, nimekuita katika haki, nami nitakushika mkono, na kukulinda, na kukutoa uwe agano la watu, na nuru ya mataifa; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        },
