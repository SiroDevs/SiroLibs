            "number": "1",
            "style": "v",
            "sid": "ISA 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamazeni mbele zangu, enyi visiwa, na mataifa wajipatie nguvu mpya; na waje karibu wakanene; na tukaribiane pamoja kwa hukumu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.1",
            "verseOrgIds": [
              "ISA.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.46.11"
              },
              "items": [
                {
                  "text": "Isa 46:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.45.1"
              },
              "items": [
                {
                  "text": "45:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ni nani aliyemwinua mmoja atokaye mashariki, ambaye katika haki amemwita mguuni pake? Ampa mataifa mbele yake, na kumtawaza juu ya wafalme; awatoa wawe kama mavumbi kwa upanga wake, kama makapi yaliyopeperushwa kwa upinde wake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.2",
            "verseOrgIds": [
              "ISA.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awafuatia, apita salama hata kwa njia asiyoikanyaga kamwe kwa miguu yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.3",
            "verseOrgIds": [
              "ISA.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.7"
              },
              "items": [
                {
                  "text": "Isa 44:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.43.10"
              },
              "items": [
                {
                  "text": "43:10",
                  "type": "text"
                }
