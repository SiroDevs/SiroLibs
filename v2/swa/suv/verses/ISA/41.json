              "items": [
                {
                  "text": "Zab 107:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nitafunua vijito vya maji juu ya vilima, na chemchemi katikati ya mabonde; nitageuza jangwa kuwa ziwa la maji, na mahali pakavu kuwa vijito vya maji.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.18",
            "verseOrgIds": [
              "ISA.41.18"
            ]
          }
        }
