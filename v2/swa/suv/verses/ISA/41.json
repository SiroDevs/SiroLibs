          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitapanda katika jangwa mwerezi, mshita, mhadasi, na mbono; nitatia katika nyika mberoshi, mtidhari, na mteashuri pamoja; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.19",
            "verseOrgIds": [
              "ISA.41.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
