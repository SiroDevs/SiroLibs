              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.22"
              },
              "items": [
                {
                  "text": "Kum 18:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.10.5"
              },
              "items": [
                {
                  "text": "Yer 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tujulisheni yatakayokuwa baadaye, nasi tutakiri ya kuwa ninyi ni miungu; naam, tendeni mema au tendeni mabaya, ili tujipime, tukaone pamoja. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.23",
            "verseOrgIds": [
              "ISA.41.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazameni, ninyi si kitu, tena kazi yenu si kitu; awachaguaye ninyi ni chukizo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.24",
            "verseOrgIds": [
              "ISA.41.24"
            ]
          }
        }
      ]
