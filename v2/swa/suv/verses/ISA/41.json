                {
                  "text": "Ezr 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimemwinua mtu toka kaskazini, naye amekuja; toka maawio ya jua amekuja anitajaye jina langu; naye atawajilia maliwali kama akanyagaye matope, na kama mfinyanzi afinyangaye udongo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.25",
            "verseOrgIds": [
              "ISA.41.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nani aliyeihubiri habari tokea mwanzo, tupate kuijua? Na tokea zamani, tupate kusema, Yeye ni mwenye haki? Naam, hapana hata mmoja aliyetujulisha; naam, hapana hata mmoja aliyetuonyesha; naam, hapana hata mmoja aliyesikia maneno yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.26",
            "verseOrgIds": [
              "ISA.41.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 41:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi kwanza nitauambia Sayuni, Tazama; hawa ndio; nami nitampa Yerusalemu mletaji wa habari njema. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.27",
            "verseOrgIds": [
              "ISA.41.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 41:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.63.5"
              },
              "items": [
                {
                  "text": "Isa 63:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.10"
              },
              "items": [
                {
                  "text": "Dan 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na nitazamapo, hapana mtu, hata katika watu hao hapana mshauri mmoja, ambaye, nikimwuliza, aweza kunijibu neno. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.28",
            "verseOrgIds": [
              "ISA.41.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 41:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama, hao wote ni ubatili; kazi zao si kitu; sanamu zao ni upepo na fujo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.29",
            "verseOrgIds": [
              "ISA.41.29"
            ]
          }
        }
