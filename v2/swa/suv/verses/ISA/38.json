                "loc": "2CH.32.24"
              },
              "items": [
                {
                  "text": "2 Nya 32:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Siku hizo Hezekia aliugua, akawa katika hatari ya kufa; na Isaya nabii, mwana wa Amozi, akaenda kwa mfalme, akamwambia, BWANA asema hivi, Tengeneza mambo ya nyumba yako; maana utakufa, wala hutapona. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Hezekia akajigeuza, akaelekeza uso wake ukutani, akamwomba BWANA, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.2",
            "verseOrgIds": [
              "ISA.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.5.19"
              },
              "items": [
                {
                  "text": "Neh 5:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akasema, Ee BWANA, kumbuka haya, nakusihi, kwamba nimekwenda mbele zako katika kweli na kwa moyo mkamilifu, na kutenda yaliyo mema machoni pako. Hezekia akalia sana sana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa, neno la BWANA likamjia Isaya, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.4",
            "verseOrgIds": [
              "ISA.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enenda ukamwambie Hezekia, BWANA, Mungu wa Daudi, baba yako, asema hivi, Mimi nimeyasikia maombi yako, nimeyaona machozi yako; tazama, nitaziongeza siku zako, kiasi cha miaka kumi na mitano. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.35"
              },
              "items": [
                {
                  "text": "Isa 37:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitakuokoa wewe, na mji huu, na mkono wa mfalme wa Ashuru, nami nitaulinda mji huu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.6",
            "verseOrgIds": [
              "ISA.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.20.8"
              },
              "items": [
                {
                  "text": "2 Fal 20:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.30"
              },
              "items": [
                {
                  "text": "Isa 37:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jambo hili liwe ishara kwako, itokayo kwa BWANA, ya kuwa BWANA atalitimiza jambo hili alilolisema; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama, nitakirudisha nyuma kivuli madaraja kumi, ambayo kilishuka juu ya duara ya Ahazi kwa sababu ya jua. Basi jua likarudi madaraja kumi katika hiyo duara, ambayo limekwisha kushuka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
          }
        }
      ]
    },
    {
