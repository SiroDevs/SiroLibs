          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya ndiyo maandiko ya Hezekia, mfalme wa Yuda, alipokuwa hawezi, naye akapona ugonjwa wake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.9",
            "verseOrgIds": [
              "ISA.38.9"
            ]
          }
        }
      ]
    },
