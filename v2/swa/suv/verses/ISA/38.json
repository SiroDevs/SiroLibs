            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana Isaya amesema, Na watwae mkate wa tini, wakauweke juu ya jipu, naye atapona. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.21",
            "verseOrgIds": [
              "ISA.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena Hezekia alikuwa amesema, Iko ishara gani ya kunionyesha ya kuwa nitapanda niingie nyumbani mwa BWANA?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.22",
            "verseOrgIds": [
              "ISA.38.22"
            ]
          }
        }
      ]
