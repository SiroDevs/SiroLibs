              "items": [
                {
                  "text": "Mit 22:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwani BWANA, Mungu wako, atakubarikia, kama alivyokuahidi; nawe utakopesha mataifa mengi, lakini hutakopa; tena utayatawala mataifa mengi, usitawaliwe na wao.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        }
