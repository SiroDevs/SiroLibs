              },
              "items": [
                {
                  "text": "Kum 17:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini akiwa na kilema, akichechea, au akiwa kipofu, au mwenye kilema kibaya cho chote, usimsongezee BWANA, Mungu wako, sadaka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
