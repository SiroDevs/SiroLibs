              },
              "items": [
                {
                  "text": "16:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utamla mbele za BWANA, Mungu wako, mwaka hata mwaka mahali atakapochagua BWANA, wewe na nyumba yako. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
              "DEU.15.20"
            ]
          }
        },
