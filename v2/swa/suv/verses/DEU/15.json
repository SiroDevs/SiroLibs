                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kila miaka saba, mwisho wake, fanya maachilio. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.1",
            "verseOrgIds": [
              "DEU.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na jinsi ya maachilio ni hii, kila mkopeshaji na akiache alichomkopesha mwenziwe, wala asimlipize mwenziwe wala nduguye; kwa kuwa imepigwa mbiu ya maachilio ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.2",
            "verseOrgIds": [
              "DEU.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.20"
              },
              "items": [
                {
                  "text": "Kum 23:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waweza kumtoza mgeni; lakini kila uwiacho kwa nduguyo mkono wako utamwachilia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.3",
            "verseOrgIds": [
              "DEU.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
