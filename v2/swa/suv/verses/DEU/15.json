              "items": [
                {
                  "text": "Isa 16:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.21.16"
              },
              "items": [
                {
                  "text": "21:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wala usione ugumu, utakapomwacha huru kuondoka kwako; kwani amekutumikia miaka sita kwa ujira mara mbili wa mwajiriwa; na BWANA, Mungu wako, atakubarikia kwa yote utakayofanya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.18",
            "verseOrgIds": [
              "DEU.15.18"
            ]
          }
        }
