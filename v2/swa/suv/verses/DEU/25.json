              "items": [
                {
                  "text": "1 Tim 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na jina lake katika Israeli liitwe, Nyumba ya mvuliwa kiatu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.10",
            "verseOrgIds": [
