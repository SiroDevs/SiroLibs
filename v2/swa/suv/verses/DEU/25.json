                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na iwe, ikimpasa kupigwa yule mwovu, alazwe chini na mwamuzi, na kupigwa mbele ya uso wake, kwa kadiri ya uovu wake, kwa kuhesabu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.2",
            "verseOrgIds": [
              "DEU.25.2"
            ]
          }
        },
