                  "text": "Rut 1:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Watakapoketi pamoja mtu na nduguye, mmojawapo akafa, wala hana mwana wa kiume, mke wa yule aliyekufa asiolewe nje na mgeni; nduguye yule mumewe amwingilie amweke kwake awe mkewe, kumfanyia yampasayo nduguye mumewe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.5",
            "verseOrgIds": [
              "DEU.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.9"
              },
              "items": [
                {
                  "text": "Mwa 38:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na iwe, yule mzaliwa wa kwanza atakayemzaa, amfuate nduguye aliyekufa kwa jina lake, lisije likafutwa jina lake katika Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.6",
            "verseOrgIds": [
              "DEU.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.7+RUT.4.8"
              },
              "items": [
                {
                  "text": "Rut 4:7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na yule mtu kwamba hapendi kumtwaa mke wa nduguye, aende huyo mke wa nduguye langoni kwa wazee, akawaambie, Nduguye mume wangu yuakataa kumsimamishia nduguye jina katika Israeli, hataki kunitimizia yampasayo nduguye mume wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.7",
            "verseOrgIds": [
              "DEU.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo wamwite wazee wa mji wake waseme naye; naye akisimama na kusema, Sitaki mimi kumtwaa mwanamke huyu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.8",
            "verseOrgIds": [
              "DEU.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.7"
              },
              "items": [
                {
                  "text": "Rut 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.20.2"
              },
              "items": [
                {
                  "text": "Isa 20:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ndipo mke wa nduguye amkaribie mbele ya hao wazee, amvue kiatu chake mguuni mwake, na kumtemea mate ya uso; kisha atajibu yule mwanamke, aseme, Mume akataaye kumjengea nduguye nyumba yake na afanywe hivi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.9",
            "verseOrgIds": [
              "DEU.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
