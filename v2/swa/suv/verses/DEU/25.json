        {
          "text": "Usiwe na mawe ya kupimia mbalimbali, kubwa na dogo, katika mfuko wako. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.13",
            "verseOrgIds": [
              "DEU.25.13"
            ]
