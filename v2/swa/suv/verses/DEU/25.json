                {
                  "text": "Ayu 18:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aweza kumpiga fimbo arobaini asizidishe asije akaonekana nduguyo kuwa amedharauliwa kwako, azidishapo kwa kumpiga fimbo nyingi juu ya hizi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.3",
            "verseOrgIds": [
              "DEU.25.3"
            ]
          }
        }
