                "loc": "EXO.21.12"
              },
              "items": [
                {
                  "text": "Kut 21:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.35.16"
