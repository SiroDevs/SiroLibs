              "items": [
                {
                  "text": "Zab 27:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.13"
              },
              "items": [
                {
                  "text": "1 Fal 21:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Shahidi mdhalimu akimwinukia mtu ye yote na kushuhudia juu yake ya upotoe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.16",
            "verseOrgIds": [
              "DEU.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo wale watu washindanao kwa mambo yale na wasimame wote wawili mbele za BWANA, mbele ya makuhani na waamuzi watakaokuwapo siku hizo; ",
          "type": "text",
          "attrs": {
