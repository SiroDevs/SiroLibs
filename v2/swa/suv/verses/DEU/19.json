              "items": [
                {
                  "text": "1 Yoh 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini mtu awaye yote akimchukia mwenziwe na kumwotea na kumwinukia, akampiga hata akafa; naye akakimbilia miji hii mmojawapo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.11",
            "verseOrgIds": [
              "DEU.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo wazee wa mji wake wapeleke ujumbe kumtwaa huko, na kumuua katika mkono wa mwenye kulipiza kisasi cha damu, apate kufa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.12",
            "verseOrgIds": [
              "DEU.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.31"
              },
              "items": [
                {
                  "text": "1 Fal 2:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jicho lako lisimhurumie, lakini uondoe damu ya asiye makosa katika Israeli, ili upate kufanikiwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.13",
            "verseOrgIds": [
              "DEU.19.13"
            ]
          }
        }
      ]
