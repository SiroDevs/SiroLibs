                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na maneno haya ninayokuamuru leo, yatakuwa katika moyo wako; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.6",
            "verseOrgIds": [
