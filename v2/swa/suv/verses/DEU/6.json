                {
                  "text": "1 Kor 10:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Msimjaribu BWANA, Mungu wenu, kama mlivyomjaribu huko Masa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
