              "items": [
                {
                  "text": "Yer 25:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Msifuate miungu mingine katika miungu ya mataifa wawazungukao; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.14",
            "verseOrgIds": [
              "DEU.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
