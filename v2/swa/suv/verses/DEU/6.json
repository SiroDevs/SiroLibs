        {
          "text": "upate kumcha BWANA, Mungu wako, kushika amri zake zote, na sheria zake, ninazokuamuru, wewe na mwanao, na mwana wa mwanao, siku zote za maisha yako; tena siku zako ziongezwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.2",
            "verseOrgIds": [
              "DEU.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
