          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nyumba zimejaa vitu vyema vyote usizojaza wewe, na visima vimefukuliwa usivyofukua wewe, mashamba ya mizabibu na mizeituni usiyoipanda wewe, nawe utakula na kushiba; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.11",
            "verseOrgIds": [
              "DEU.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
