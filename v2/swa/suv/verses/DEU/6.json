            "number": "3",
            "style": "v",
            "sid": "DEU 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikiza basi, Ee Israeli, ukaangalie kuzitenda; upate kufanikiwa, mpate kuongezeka sana, kama BWANA, Mungu wa baba zako, alivyokuahidi, katika nchi ijaayo maziwa na asali.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.3",
            "verseOrgIds": [
              "DEU.6.3"
            ]
