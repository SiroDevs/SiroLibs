                "loc": "PSA.119.4"
              },
              "items": [
                {
                  "text": "Zab 119:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zishikeni kwa bidii sheria za BWANA, Mungu wenu, na mashuhudizo yake, na amri zake alizokuagiza. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.17",
            "verseOrgIds": [
              "DEU.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe fanya yaliyo sawa, na mema, machoni pa BWANA; ili mpate kufanikiwa, nawe upate kuingia na kuimiliki nchi nzuri BWANA aliyowaapia baba zako, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.18",
            "verseOrgIds": [
              "DEU.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya kuwa atawasukumia nje adui zako wote mbele yako, kama alivyosema BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
          }
        }
      ]
