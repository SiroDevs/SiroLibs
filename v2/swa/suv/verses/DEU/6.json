          "text": "Mche BWANA, Mungu wako; ndiye utakayemtumikia, na kuapa kwa jina lake. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.13",
            "verseOrgIds": [
              "DEU.6.13"
            ]
          }
        },
        {
