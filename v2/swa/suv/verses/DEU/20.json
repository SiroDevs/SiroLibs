                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utakaposongea karibu ya mji kwenda kupigana juu yake, ndipo utakapowapigia ukelele wa amani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.10",
            "verseOrgIds": [
              "DEU.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.21"
              },
              "items": [
                {
                  "text": "1 Fal 9:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Itakuwa utakapokujibu kwa amani, na kukufungulia, ndipo watu wote watakaoonekana humo watakufanyia kazi ya shokoa, na kukutumikia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.11",
            "verseOrgIds": [
              "DEU.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwamba hautaki kufanya amani nawe, lakini utafanya vita juu yako, ndipo uuhusuru; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.12",
            "verseOrgIds": [
              "DEU.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.31.7"
              },
              "items": [
                {
                  "text": "Hes 31:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na BWANA, Mungu wako, autiapo mkononi mwako, mpige kila mume aliyemo kwa makali ya upanga; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.13",
            "verseOrgIds": [
              "DEU.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.2"
              },
              "items": [
                {
                  "text": "Yos 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.22.8"
              },
              "items": [
                {
                  "text": "22:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "lakini wanawake na watoto, na wanyama wa miji, na vilivyo mjini vyote, navyo ni nyara zake zote, uvitwae viwe mateka kwako; nawe utakula nyara za adui zako alizokupa BWANA, Mungu wako. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.14",
            "verseOrgIds": [
              "DEU.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utaifanyia vivyo miji yote iliyo mbali sana nawe, isiyokuwa miji ya mataifa haya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.15",
            "verseOrgIds": [
              "DEU.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
