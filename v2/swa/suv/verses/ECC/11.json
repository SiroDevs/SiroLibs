            "number": "8",
            "style": "v",
            "sid": "ECC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naam, mtu akiishi miaka mingi, na aifurahie yote; lakini na azikumbuke siku zijazo za giza, kwa maana zitakuwa nyingi. Mambo yote yajayo ni ubatili. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        },
