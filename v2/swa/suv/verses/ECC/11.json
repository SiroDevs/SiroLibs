              "type": "text"
            }
          ]
        },
        {
          "text": "Kweli nuru ni tamu, tena ni jambo la kupendeza macho kutazama jua. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.7",
            "verseOrgIds": [
              "ECC.11.7"
            ]
          }
        },
        {
          "name": "verse",
