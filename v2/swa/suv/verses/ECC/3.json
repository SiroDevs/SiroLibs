            }
          ]
        },
        {
          "text": "Je! Mtendaji anayo faida gani katika yale anayojishughulisha nayo? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.9",
            "verseOrgIds": [
              "ECC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.1.13"
              },
              "items": [
                {
                  "text": "Mhu 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nimeiona taabu ambayo Mungu amewapa wanadamu, ili kutaabika ndani yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.10",
            "verseOrgIds": [
              "ECC.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
