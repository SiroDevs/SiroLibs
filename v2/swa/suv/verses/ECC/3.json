                "loc": "ROM.11.33"
              },
              "items": [
                {
                  "text": "Rum 11:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kila kitu amekifanya kizuri kwa wakati wake; tena ameiweka hiyo milele ndani ya mioyo yao; ila kwa jinsi mwanadamu asivyoweza kuivumbua kazi ya Mungu anayoifanya, tangu mwanzo hata mwisho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.11",
            "verseOrgIds": [
              "ECC.3.11"
            ]
          }
        }
      ]
    },
    {
