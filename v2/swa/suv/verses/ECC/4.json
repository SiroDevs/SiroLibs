              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana wakianguka, mmoja wao atamwinua mwenzake; lakini ole wake aliye peke yake aangukapo, wala hana mwingine wa kumwinua! ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena, wawili wakilala pamoja, hapo watapata moto; lakini mmoja aliye peke yake tu awezaje kuona moto? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.11",
            "verseOrgIds": [
              "ECC.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata ikiwa mtu aweza kumshinda yule aliye peke yake, wawili watampinga; wala kamba ya nyuzi tatu haikatiki upesi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
