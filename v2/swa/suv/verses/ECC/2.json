        {
          "text": "Nikasema juu ya kicheko, Ni wazimu; na juu ya furaha, Yafaa nini? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.2",
            "verseOrgIds": [
              "ECC.2.2"
            ]
          }
