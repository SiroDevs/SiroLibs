              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.22+2CH.9.23+2CH.9.24+2CH.9.25+2CH.9.26+2CH.9.27"
              },
              "items": [
                {
                  "text": "2 Nya 9:22-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nikajifanyizia kazi zilizo kubwa; nikajijengea nyumba; nikajipandia mashamba ya mizabibu; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.4",
            "verseOrgIds": [
              "ECC.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikajifanyizia bustani na viunga, na kuipanda humo miti yenye matunda ya kila namna; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.5",
            "verseOrgIds": [
              "ECC.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikajifanyizia birika za maji, ya kuunyweshea mwitu mlimopandwa miti michanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.6",
            "verseOrgIds": [
              "ECC.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.23"
              },
              "items": [
                {
                  "text": "1 Fal 4:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nikanunua watumwa na wajakazi, nikawa na wazalia nyumbani mwangu; tena nikawa na mali nyingi za ng’ombe na kondoo, kupita wote walionitangulia katika Yerusalemu; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.7",
            "verseOrgIds": [
              "ECC.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
