          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana ni nani awezaye kula au kujiburudisha kuliko mimi? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.25",
            "verseOrgIds": [
