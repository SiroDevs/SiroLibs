              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nikaichukia kazi yangu yote niliyojishughulisha nayo chini ya jua; maana sina budi kumwachia yeye atakayenifuata. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.18",
            "verseOrgIds": [
