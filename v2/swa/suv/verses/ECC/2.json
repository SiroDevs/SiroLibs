              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.7"
              },
              "items": [
                {
                  "text": "Ayu 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.14.1"
              },
              "items": [
                {
                  "text": "14:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa kuwa siku zake zote ni masikitiko, na kazi yake ni huzuni; naam, hata usiku moyoni mwake hamna raha. Hayo nayo ni ubatili.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.23",
            "verseOrgIds": [
              "ECC.2.23"
            ]
          }
        }
