              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.28"
              },
              "items": [
                {
                  "text": "9:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "tena nikajikusanyia fedha na dhahabu, na tunu za kifalme na za kutoka katika majimbo. Nikajipatia waimbaji, waume kwa wake, nao wale ambao wanadamu wanawatunuka, masuria wengi sana. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.8",
            "verseOrgIds": [
              "ECC.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.25"
              },
              "items": [
                {
                  "text": "1 Nya 29:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.1.16"
              },
              "items": [
                {
                  "text": "Mhu 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi nikawa mkuu, nikaongezeka kupita wote walionitangulia katika Yerusalemu; pia hekima yangu nikakaa nayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.9",
            "verseOrgIds": [
              "ECC.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.3.22"
              },
              "items": [
                {
                  "text": "Mhu 3:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wala sikuyanyima macho yangu cho chote yalichokitamani; wala sikuuzuia moyo wangu katika furaha yo yote; maana moyo wangu ulifurahi kwa sababu ya kazi yangu yote, na hii ilikuwa sehemu yangu katika kazi yangu yote. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.10",
            "verseOrgIds": [
              "ECC.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikaziangalia kazi zote zilizofanywa kwa mikono yangu, na taabu yote niliyotaabika katika kuzitenda; na tazama, yote ni ubatili na kujilisha upepo, wala faida hakuna chini ya jua.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.11",
            "verseOrgIds": [
              "ECC.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hekima na Shangwe Apewayo Mtu Anayemfurahisha Mungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
