              "ECC.2.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.1.17"
              },
              "items": [
                {
                  "text": "Mhu 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikageuka ili kuipambanua hekima, na wazimu na upumbavu. Kwa maana mtu amfuataye mfalme afanye nini? Lilo hilo tu lililokwisha kufanywa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.12",
            "verseOrgIds": [
              "ECC.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nilipoona ya kuwa kweli hekima hupita upumbavu, kwa kadiri nuru ipitavyo giza; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.13",
            "verseOrgIds": [
              "ECC.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.8.1"
              },
              "items": [
                {
                  "text": "Mhu 8:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.9.2"
              },
              "items": [
                {
                  "text": "9:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "macho yake mwenye hekima yamo kichwani mwake, lakini mpumbavu huenda gizani; ila hata hivyo nikatambua ya kwamba ni tukio moja la mwisho liwapatalo wote sawasawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.14",
            "verseOrgIds": [
              "ECC.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikasema moyoni mwangu, Kama limpatavyo mpumbavu, ndivyo litakavyonipata mimi nami; basi, kwa nini nikawa na hekima zaidi? Nikasema moyoni mwangu ya kuwa hayo nayo ni ubatili. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.15",
            "verseOrgIds": [
              "ECC.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana hakuna kumbukumbu la milele la mwenye hekima, wala la mpumbavu; kwa sababu siku zijazo wote pia watakuwa wamekwisha kusahauliwa. Na mwenye hekima, jinsi gani anavyokufa sawasawa na mpumbavu! ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.16",
            "verseOrgIds": [
              "ECC.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, nikauchukia uhai; kwa sababu kazi inayotendeka chini ya jua ilikuwa mbaya kwangu; yaani, mambo yote ni ubatili na kujilisha upepo.",
          "type": "text",
          "attrs": {
