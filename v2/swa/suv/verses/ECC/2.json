        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.23+1KI.10.24+1KI.10.25+1KI.10.26+1KI.10.27"
              },
              "items": [
                {
                  "text": "1 Fal 10:23-27",
                  "type": "text"
