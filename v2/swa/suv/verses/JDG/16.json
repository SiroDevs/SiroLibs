              "type": "tag",
              "attrs": {
                "loc": "JDG.13.25"
              },
              "items": [
                {
                  "text": "Amu 13:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo ndugu zake, na watu wote wa nyumba ya baba yake wakatelemka, wakamtwaa wakamchukua, wakamzika kati ya Sora na Eshtaoli, katika kiwanja cha kuzikia cha Manoa baba yake. Naye alikuwa mwamuzi wa Israeli muda wa miaka ishirini.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
