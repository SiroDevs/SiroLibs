              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafilisti wakamkamata, wakamng’oa macho; wakatelemka naye mpaka Gaza, wakamfunga kwa vifungo vya shaba; naye alikuwa akisaga ngano katika gereza. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.21",
            "verseOrgIds": [
              "JDG.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
