          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini zile nywele za kichwa chake zikaanza kukua tena baada ya kunyolewa kwake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.22",
            "verseOrgIds": [
              "JDG.16.22"
            ]
