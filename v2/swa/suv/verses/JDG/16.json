                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.32"
              },
              "items": [
                {
                  "text": "2 Kor 11:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.33"
              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Watu wa Gaza wakaambiwa, ya kwamba, huyo Samsoni amekuja huku. Wakamzingira, wakamvizia usiku kucha, penye lango la mji, wakanyamaza kimya usiku kucha, wakisema, Na tungoje mpaka mapambazuko, ndipo tutamwua. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.2",
            "verseOrgIds": [
              "JDG.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Samsoni akalala hata usiku wa manane, akaondoka katikati ya usiku, akaishika milango ya lango la mji, na miimo yake miwili, akaing’oa pamoja na komeo lake, akajitwika mabegani, akavichukua hata kilele cha mlima ule unaokabili Hebroni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.3",
            "verseOrgIds": [
              "JDG.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.3",
            "verseOrgIds": [
              "JDG.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa baada ya hayo akampenda mwanamke mmoja katika bonde la Soreki, jina lake akiitwa Delila. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.4",
            "verseOrgIds": [
              "JDG.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.14.15"
              },
              "items": [
                {
                  "text": "Amu 14:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.2.16+PRO.2.17+PRO.2.18+PRO.2.19"
              },
              "items": [
                {
                  "text": "Mit 2:16-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.5.3"
              },
              "items": [
                {
                  "text": "5:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao wakuu wa Wafilisti wakamwendea, wakamwambia, Mbembeleze, upate kujua asili ya nguvu zake nyingi, na jinsi tutakavyoweza kumshinda, tupate kumfunga na kumtesa; nasi tutakupa kila mtu fedha elfu na mia moja. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.5",
            "verseOrgIds": [
              "JDG.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delila akamwambia Samsoni, Tafadhali uniambie asili ya nguvu zako nyingi, na jinsi uwezavyo kufungwa, ili uteswe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.6",
            "verseOrgIds": [
              "JDG.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samsoni akamwambia, Wakinifunga kwa kamba mbichi saba ambazo hazijakauka bado, hapo ndipo nitakuwa dhaifu, nitakuwa kama wanadamu wenzangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.7",
            "verseOrgIds": [
              "JDG.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.6.24+PRO.6.25+PRO.6.26"
              },
              "items": [
                {
                  "text": "Mit 6:24-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo wakuu wa Wafilisti wakamletea kamba mbichi saba zisizokauka, naye akamfunga nazo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.8",
            "verseOrgIds": [
              "JDG.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.14"
              },
              "items": [
                {
                  "text": "Yn 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na yule mwanamke alikuwa na watu katika chumba cha ndani, wakimwotea. Basi akamwambia Samsoni, Wafilisti wanakujia. Ndipo akazikata zile kamba kama vile uzi wa pamba ukatwavyo ukiguswa na moto. Basi hiyo asili ya nguvu zake haikujulikana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.9",
            "verseOrgIds": [
              "JDG.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delila akamwambia Samsoni, Tazama, umenidhihaki, na kuniambia uongo; sasa tafadhali, niambie, waweza kufungwa kwa kitu gani? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.10",
            "verseOrgIds": [
              "JDG.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamwambia Wakinifunga tu kwa kamba mpya ambazo mtu hakufanya kazi nazo, hapo ndipo nitakuwa dhaifu, nitakuwa kama wanadamu wenzangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.11",
            "verseOrgIds": [
              "JDG.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.7.22"
              },
              "items": [
                {
                  "text": "Mit 7:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Delila akatwaa kamba mpya akamfunga nazo, akamwambia, Wafilisti wanakujia, Samsoni. Na wale wenye kuotea walikuwa katika chumba cha ndani. Naye akazikata, akazitupa kutoka mikononi mwake kama uzi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.12",
            "verseOrgIds": [
              "JDG.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delila akamwambia Samsoni, Hata sasa umenidhihaki, umeniambia maneno ya uongo; niambie sasa, waweza kufungwa kwa kitu gani? Akamwambia, Ukivifuma hivi vishungi saba vya nywele za kichwa changu katika mtande wa nguo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.13",
            "verseOrgIds": [
              "JDG.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi akazifunga kwa msumari, akamwambia Samsoni, Wafilisti wanakujia. Naye akaamka usingizini, akaung’oa ule msumari, na ule mtande.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.14",
            "verseOrgIds": [
              "JDG.16.14"
            ]
          }
        }
      ]
    },
