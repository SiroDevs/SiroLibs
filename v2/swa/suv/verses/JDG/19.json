              },
              "items": [
                {
                  "text": "2 Sam 13:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye mtu mwenye nyumba akawatokea hapo nje, na kuwaambia, La, sivyo, ndugu zangu nawasihi msifanye uovu jinsi hii; kwa kuwa mtu huyu ameingia ndani ya nyumba yangu, msifanye upumbavu huu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.23",
            "verseOrgIds": [
              "JDG.19.23"
            ]
          }
        },
