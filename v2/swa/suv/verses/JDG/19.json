                "loc": "DEU.21.14"
              },
              "items": [
                {
                  "text": "Kum 21:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tazama, binti yangu yupo hapa, ni mwanamwali, na suria wake huyo mtu; nitawaleta hapa nje sasa nanyi watwezeni, na kuwatenda hayo myaonayo kuwa ni mema; lakini mtu huyu msimtende jambo la upumbavu namna hii. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.24",
            "verseOrgIds": [
              "JDG.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.4.1"
              },
              "items": [
                {
                  "text": "Mwa 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini hao watu hawakukubali kumsikia; basi mtu huyo akamshika suria wake, na kumleta nje kwao; nao wakamjua, na kumtenda uovu usiku kucha hata asubuhi kisha kulipoanza kupambauka wakamwacha aende zake. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.25",
            "verseOrgIds": [
              "JDG.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo huyo mwanamke akaja alfajiri, akaanguka chini mlangoni pa nyumba ya mtu yule alimokuwamo bwana wake, hata kulipokucha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.26",
            "verseOrgIds": [
              "JDG.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana wake akaondoka asubuhi, akaifungua milango ya nyumba, akatoka nje ili aende zake, na tazama, huyo mwanamke suria yake alikuwa ameanguka pale mlangoni pa nyumba, na mikono yake ilikuwa i pale kizingitini. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.27",
            "verseOrgIds": [
              "JDG.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.20.5"
              },
              "items": [
                {
                  "text": "Amu 20:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akamwambia, Haya ondoka, twende zetu; lakini hakuna aliyemjibu; ndipo akamwinua akamweka juu ya punda; mtu huyo akaondoka, akaenda mahali pake mwenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.28",
            "verseOrgIds": [
              "JDG.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 19:29"
          },
          "items": [
