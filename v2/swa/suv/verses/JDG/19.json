            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.6"
              },
              "items": [
                {
                  "text": "2 Sam 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini huyo mtu hakukubali kukaa usiku huo, ila akainuka, akaenda zake, akafika mkabala wa Yebusi (huo ndio Yerusalemu); nao walikuwako pamoja naye punda wawili waliotandikwa; suria yake naye alikuwa pamoja naye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.10",
            "verseOrgIds": [
              "JDG.19.10"
            ]
          }
        },
