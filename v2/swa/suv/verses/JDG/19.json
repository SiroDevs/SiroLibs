                "loc": "HOS.5.8"
              },
              "items": [
                {
                  "text": "Hos 5:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bwana wake akamwambia, Hatutageuka sisi kuingia mji wa wageni, ambao si wa wana wa Israeli; lakini tutapita mpaka Gibea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.12",
            "verseOrgIds": [
              "JDG.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akamwambia mtumishi wake, Haya, tuifikilie miji hii mmojawapo nasi tutalala katika Gibea au katika Rama. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.13",
            "verseOrgIds": [
              "JDG.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wakashika njia kwenda zao mbele; jua likawachwea walipokuwa karibu na Gibea, ambao ni mji wa Benyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.14",
            "verseOrgIds": [
              "JDG.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.43"
              },
              "items": [
                {
                  "text": "Mt 25:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.2"
              },
              "items": [
                {
                  "text": "Ebr 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakageuka huko, wapate kuingia na kulala katika Gibea; akaingia ndani, akaketi katika njia kuu ya mji; kwa kuwa hapakuwa na mtu awaye yote aliyewakaribisha nyumbani kwake kulala.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.15",
            "verseOrgIds": [
              "JDG.19.15"
            ]
          }
        }
