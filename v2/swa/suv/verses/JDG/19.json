              "items": [
                {
                  "text": "1 Sam 11:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.20.6"
              },
              "items": [
                {
                  "text": "Amu 20:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye alipokwisha kuingia nyumbani mwake, akatwaa kisu, kisha akamshika huyo suria yake, akampasua kiungo kwa kiungo, vipande kumi na viwili akampeleka katika mipaka yote ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.29",
            "verseOrgIds": [
              "JDG.19.29"
            ]
          }
        },
        {
