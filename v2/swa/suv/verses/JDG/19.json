                "loc": "JDG.17.6"
              },
              "items": [
                {
                  "text": "Amu 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.17.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikawa katika siku hizo, hapo kulipokuwa hapana mfalme katika Israeli, alikuwapo Mlawi mmoja aliyekuwa akikaa hali ya ugeni upande wa mbele wa nchi ya vilima vilima ya Efraimu, aliyejitwalia suria katika Bethlehemu-yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.1",
            "verseOrgIds": [
              "JDG.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha huyo suria yake akaandama ukahaba kinyume chake, kumwacha kwenda nyumbani kwa baba yake huko Bethlehemu-yuda, akakaa kuko muda wa miezi minne. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.2",
            "verseOrgIds": [
              "JDG.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha mumewe akainuka akamfuata, aseme naye kwa upendo, ili apate kumrudisha tena, naye alikuwa na mtumishi wake pamoja naye na punda wawili; huyo mwanamke akamkaribisha katika nyumba ya baba yake; naye baba yake alipomwona akafurahi kuonana naye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.3",
            "verseOrgIds": [
              "JDG.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha mkwewe, babaye huyo mwanamke, akamzuia; akakaa naye siku tatu; basi wakala na kunywa na kulala kuko. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.4",
            "verseOrgIds": [
              "JDG.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.5"
              },
              "items": [
                {
                  "text": "Mwa 18:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha ilikuwa siku ya nne, wakaamka asubuhi na mapema, naye akaondoka ili aende zake; baba yake huyo mwanamke akamwambia mkwewe, Tuza moyo wako, ule chakula kidogo, kisha baadaye mtakwenda zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.5",
            "verseOrgIds": [
              "JDG.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wakaketi, wakala na kunywa wote wawili pamoja; kisha baba yake mwanamke akamwambia huyo mtu, Uwe radhi, tafadhali, ukae usiku kucha, na moyo wako na ufurahi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.6",
            "verseOrgIds": [
              "JDG.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule mtu akainuka ili aondoke; lakini mkwewe akamsihi-sihi, naye akalala kuko tena. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.7",
            "verseOrgIds": [
              "JDG.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi akaamka asubuhi na mapema siku ya tano ili aende zake; na baba yake mwanamke akasema, Tuza moyo wako, tafadhali, ukae hata jua lipinduke; nao wakala chakula wote wawili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.8",
            "verseOrgIds": [
              "JDG.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha hapo mtu huyo alipoinuka ili aende zake, yeye na suria yake, na mtumishi wake, huyo mkwewe, baba yake mwanamke, akamwambia, Tazama mchana wakaribia jioni, tafadhali kaa usiku kucha; tazama mchana wakaribia mwisho wake, lala hapa, ili moyo wako ufurahi; hata kesho uende zako asubuhi na mapema, ili upate kwenda kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.9",
            "verseOrgIds": [
              "JDG.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.18.28"
              },
              "items": [
                {
                  "text": "Yos 18:28",
