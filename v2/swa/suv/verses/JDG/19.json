                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi hapo walipokuwa karibu na Yebusi, mchana ulikuwa umeendelea mno; yule mtumishi akamwambia bwana wake, Haya, tafadhali, tugeuke kando na kuingia mji huu wa Wayebusi, tulale humu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.11",
            "verseOrgIds": [
              "JDG.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 19:12"
