        },
        {
          "text": "Kisha ikawa siku ya pili yake, hao watu wakaamka asubuhi na mapema, wakajenga madhabahu huko, wakasongeza sadaka za kuteketezwa na sadaka za amani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.4",
            "verseOrgIds": [
              "JDG.21.4"
            ]
          }
        },
