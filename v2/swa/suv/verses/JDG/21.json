              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.15",
            "verseOrgIds": [
              "JDG.21.15"
            ]
          }
        },
        {
          "name": "verse",
