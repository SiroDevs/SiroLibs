                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wana wa Benyamini wakafanya vivyo, wakajitwalia wake, sawasawa na hesabu yao, katika hao waliocheza, wakawachukua wakaenda nao; kisha wakaenda kuurudia urithi wao, na kuijenga miji na kuikaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.23",
            "verseOrgIds": [
              "JDG.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao wana wa Israeli wakati huo wakaenda zao, kila mtu akaenda kwa kabila yake na kwa jamaa yake; nao wakatoka huko, waende kila mtu kuuendea urithi wake. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.24",
            "verseOrgIds": [
              "JDG.21.24"
            ]
          }
