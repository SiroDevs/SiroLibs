                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na jambo mtakalotenda ni hili; mtamwangamiza kila mume kabisa, na kila mwanamke ambaye amelala na mume. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.11",
