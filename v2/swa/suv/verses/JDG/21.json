                }
              ]
            }
          ]
        },
        {
          "text": "Basi mkutano walipeleka huko watu kumi na mbili elfu wa hao waliokuwa mashujaa sana, kisha wakawaamuru, wakisema, Endeni mkawapige wenyeji wa Yabesh-gileadi kwa makali ya upanga, na hata wanawake na watoto wadogo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.10",
            "verseOrgIds": [
              "JDG.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 21:11"
          },
          "items": [
