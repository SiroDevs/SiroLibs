                }
              ]
            }
          ]
        },
        {
          "text": "Hao Wasidoni nao, na Waamaleki, na Wamaoni, waliwaonea, nanyi mlinililia, nami niliwaokoa na mikono yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.12",
            "verseOrgIds": [
              "JDG.10.12"
            ]
          }
        },
