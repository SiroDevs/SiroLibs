        },
        {
          "text": "Naye BWANA akawaambia wana wa Israeli, Je! Sikuwaokoa ninyi na hao Wamisri, na Waamori, na wana wa Amoni, na Wafilisti? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.11",
            "verseOrgIds": [
              "JDG.10.11"
            ]
          }
        },
