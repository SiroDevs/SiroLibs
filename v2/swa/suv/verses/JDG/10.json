                  "text": "2 Fal 17:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha wana wa Israeli walifanya tena yaliyo maovu mbele za macho ya BWANA, wakawatumikia Mabaali, na Maashtorethi, na miungu ya Shamu, na miungu ya Sidoni, na miungu ya Moabu, na miungu ya wana wa Amoni, na miungu ya Wafilisti; nao wakamwacha BWANA, wala hawakumtumikia yeye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.6",
            "verseOrgIds": [
              "JDG.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.12.9"
              },
              "items": [
                {
                  "text": "1 Sam 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hasira za BWANA ziliwaka juu ya Israeli, akawauza na kuwaua mikononi mwa Wafilisti, na mikononi mwa wana wa Amoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.7",
            "verseOrgIds": [
              "JDG.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao wakawasumbua na kuwaonea wana wa Israeli mwaka huo; waliwaonea wana wa Israeli wote waliokuwa ng’ambo ya pili ya Yordani katika nchi ya Waamori, iliyoko huko Gileadi, muda wa miaka kumi na minane. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.8",
            "verseOrgIds": [
              "JDG.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Amoni nao wakavuka Yordani ili wapigane na Yuda, na kupigana na Benyamini, na nyumba ya Efraimu; basi hivyo Israeli walikuwa wanasumbuliwa sana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.9",
            "verseOrgIds": [
              "JDG.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.12.10"
              },
              "items": [
                {
                  "text": "1 Sam 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo wana wa Israeli wakamlilia BWANA, wakisema, Sisi tumekufanyia dhambi, kwa sababu tumemwacha Mungu wetu, na kuyatumikia Mabaali. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.10",
            "verseOrgIds": [
              "JDG.10.10"
            ]
          }
        },
        {
