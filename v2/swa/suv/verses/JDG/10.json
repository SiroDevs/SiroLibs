                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wana wa Israeli wakamwambia BWANA Tumefanya dhambi; utufanyie yote uyaonayo kuwa ni mema; lakini tuokoe, twakusihi, siku hii ya leo, haya tu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.15",
            "verseOrgIds": [
              "JDG.10.15"
            ]
          }
        },
