              },
              "items": [
                {
                  "text": "2 Fal 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Haya, endeni mkaililie hiyo miungu mliyoichagua; na hiyo iwaokoe wakati wa kusumbuka kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.14",
            "verseOrgIds": [
              "JDG.10.14"
            ]
          }
        },
