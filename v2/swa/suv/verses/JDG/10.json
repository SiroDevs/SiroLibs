              "items": [
                {
                  "text": "Amu 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.14"
              },
              "items": [
                {
                  "text": "Kum 3:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Huyo alikuwa na wana thelathini waliokuwa wakipanda wana-punda thelathini, nao walikuwa na miji thelathini, ambayo inaitwa Hawoth-yairi hata hivi leo, nayo iko katika nchi ya Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.4",
            "verseOrgIds": [
              "JDG.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yairi akafa, akazikwa huko Kamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.5",
            "verseOrgIds": [
              "JDG.10.5"
            ]
          }
        }
      ]
    },
