                {
                  "text": "Yer 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini mmeniacha mimi, na kuitumikia miungu mingine; basi kwa ajili ya hayo mimi sitawaokoa tena. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.13",
            "verseOrgIds": [
              "JDG.10.13"
            ]
          }
        },
        {
