              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada yake huyo akainuka Yairi, Mgileadi; naye akawa mwamuzi wa Israeli muda wa miaka ishirini na miwili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.3",
            "verseOrgIds": [
              "JDG.10.3"
            ]
          }
        },
        {
