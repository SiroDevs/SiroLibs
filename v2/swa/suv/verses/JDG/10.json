        },
        {
          "text": "Baada yake Abimeleki, akainuka Tola mwana wa Pua, mwana wa Dodo, mtu wa Isakari, kuwaokoa Israeli; naye alikuwa akikaa Shamiri, katika nchi ya vilima vilima ya Efraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.1",
            "verseOrgIds": [
              "JDG.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huyo akawa mwamuzi wa Israeli muda wa miaka ishirini na mitatu, akafa, akazikwa katika Shamiri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.2",
            "verseOrgIds": [
              "JDG.10.2"
            ]
          }
        }
      ]
    },
