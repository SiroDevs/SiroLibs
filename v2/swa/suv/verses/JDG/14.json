              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.34.4"
              },
              "items": [
                {
                  "text": "34:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha akapanda, akawaambia baba yake na mama yake, akasema, Nimemwona mwanamke huko Timna, mmojawapo wa binti za Wafilisti; basi mnipatie, nimwoe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.2",
            "verseOrgIds": [
              "JDG.14.2"
            ]
          }
        },
        {
