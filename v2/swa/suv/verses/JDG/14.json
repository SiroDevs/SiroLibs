              },
              "items": [
                {
                  "text": "Kum 7:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo baba yake na mama yake wakamwambia, Je! Hapana mwanamke hata mmoja katika ndugu zako, au katika jamaa zangu zote, hata uende kumwoa mwanamke kwa hawa Wafilisti wasiotahiriwa? Samsoni akamwambia baba yake; Mnipatie huyo, kwa maana ananipendeza sana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.3",
            "verseOrgIds": [
              "JDG.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.11.20"
              },
              "items": [
                {
                  "text": "Yos 11:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.10.15"
              },
              "items": [
                {
                  "text": "2 Nya 10:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini baba yake na mama yake hawakujua ya kuwa jambo hili ni la BWANA; maana alitaka kisa juu ya Wafilisti. Basi wakati ule Wafilisti walikuwa wakiwatawala Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.4",
            "verseOrgIds": [
              "JDG.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
