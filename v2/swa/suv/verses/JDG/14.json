            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.22"
              },
              "items": [
                {
                  "text": "2 Fal 5:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Samsoni akawaambia, Mimi nitawategea ninyi kitendawili; kama mwaweza kunionyesha katika hizo siku saba za karamu, na kukitambua, ndipo hapo nitawapa mavazi thelathini ya kitani na mavao mengine thelathini; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.12",
            "verseOrgIds": [
              "JDG.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakini msipoweza kunionyesha ndipo hapo ninyi mtanipa mimi mavazi thelathini ya kitani na mavao mengine thelathini. Basi wakamwambia, Haya, tega kitendawili chako, ili tupate kukisikia. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.13",
            "verseOrgIds": [
              "JDG.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye akawaambia,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
