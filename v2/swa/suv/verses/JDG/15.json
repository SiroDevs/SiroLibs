            "number": "9",
            "style": "v",
            "sid": "JDG 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Wafilisti wakapanda wakapiga kambi yao katika Yuda, wakajieneza katika Lehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.9",
            "verseOrgIds": [
              "JDG.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa Yuda wakasema, Mbona mmekuja kupigana nasi? Wakasema, Tumepanda ili kumfunga Samsoni, kumtenda yeye kama alivyotutenda sisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.10",
            "verseOrgIds": [
              "JDG.15.10"
            ]
          }
        },
