                {
                  "text": "1 Sam 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.2.16"
              },
              "items": [
                {
                  "text": "Amu 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye huyo Samweli akawaamua Israeli siku zote za maisha yake. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.15",
            "verseOrgIds": [
              "1SA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye huenda mwaka kwa mwaka kuzunguka mpaka Betheli, na Gilgali, na Mispa; akawaamua Israeli mahali hapo pote. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.16",
            "verseOrgIds": [
              "1SA.7.16"
            ]
          }
        },
        {
