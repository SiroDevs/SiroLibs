        },
        {
          "text": "Wakakusanyika huko Mispa, wakateka maji na kuyamimina mbele za BWANA; wakafunga siku ile, wakasema huko, Tumemfanyia BWANA dhambi. Samweli akawaamua wana wa Israeli huko Mispa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
