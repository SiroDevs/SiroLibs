        {
          "text": "Basi Samweli akawaambia nyumba yote ya Israeli, akasema, Ikiwa mnamrudia BWANA kwa mioyo yenu yote, basi, iondoleeni mbali miungu migeni, nayo Maashtorethi yatoke kwenu, mkamtengenezee BWANA mioyo yenu, mkamtumikie yeye peke yake; naye atawaokoa katika mikono ya Wafilisti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
