                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo Samweli akatwaa mwana-kondoo mchanga, akamtolea BWANA sadaka ya kuteketezwa nzima; Samweli akamlilia BWANA kwa ajili ya Israeli; BWANA akamwitikia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
