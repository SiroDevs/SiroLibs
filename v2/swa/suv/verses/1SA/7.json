            "number": "7",
            "style": "v",
            "sid": "1SA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata Wafilisti waliposikia ya kuwa wana wa Israeli wamekusanyika huko Mispa, mashehe wa Wafilisti walipanda juu ili kupigana na Israeli. Nao wana wa Israeli waliposikia, wakawaogopa Wafilisti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.7",
            "verseOrgIds": [
              "1SA.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
