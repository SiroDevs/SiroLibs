              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.4"
              },
              "items": [
                {
                  "text": "Isa 37:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wana wa Israeli wakamwambia Samweli, Usiache kumlilia BWANA, Mungu wetu, kwa ajili yetu, kwamba atuokoe na mikono ya Wafilisti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
        },
