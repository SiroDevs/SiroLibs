        {
          "text": "Ikawa, tangu siku hiyo ambayo sanduku lilikaa Kiriath-yearimu wakati ulikuwa mwingi; kwa maana ulikuwa miaka ishirini; na nyumba yote ya Israeli wakamwombolezea BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        }
