        },
        {
          "text": "Hata Samweli alipokuwa akiitoa hiyo sadaka ya kuteketezwa, Wafilisti wakakaribia ili kupigana na Israeli; walakini BWANA akapiga ngurumo, mshindo mkubwa sana, juu ya Wafilisti siku ile, akawafadhaisha; nao wakaangamizwa mbele ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.10",
            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao watu wa Israeli wakatoka Mispa, wakawafuatia Wafilisti, wakawapiga, hata walipofika chini ya Beth-kari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        }
