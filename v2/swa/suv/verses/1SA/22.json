                "loc": "1SA.8.14"
              },
              "items": [
                {
                  "text": "1 Sam 8:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye Sauli akawaambia watumishi wake waliomzunguka, Sikieni sasa, enyi Wabenyamini; je! Huyu mwana wa Yese atawapa ninyi kila mmoja mashamba, na mashamba ya mizabibu, atawafanya kuwa maakida wa watu elfu, na maakida wa watu mia; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.7",
            "verseOrgIds": [
              "1SA.22.7"
            ]
          }
        },
