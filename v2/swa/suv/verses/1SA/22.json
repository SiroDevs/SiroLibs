                "loc": "JDG.11.3"
              },
              "items": [
                {
                  "text": "Amu 11:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na kila mtu aliyekuwa katika hali ya dhiki, na kila mtu aliyekuwa na deni, na watu wote wenye uchungu mioyoni mwao, wakakusanyika kwake; naye akawa jemadari wao; nao waliokuwa pamoja naye walipata kama watu mia nne.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.2",
            "verseOrgIds": [
              "1SA.22.2"
            ]
          }
        }
