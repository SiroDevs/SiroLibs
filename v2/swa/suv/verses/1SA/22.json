                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.21.6"
              },
              "items": [
                {
                  "text": "1 Sam 21:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.21.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye akamwuliza BWANA kwa ajili yake, akampa vyakula, akampa na ule upanga wa Goliathi, Mfilisti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.10",
            "verseOrgIds": [
              "1SA.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mfalme akatuma watu waende kumwita Ahimeleki, kuhani, mwana wa Ahitubu, na jamaa yote ya baba yake, hao makuhani, waliokuwako huko Nobu; nao wakaenda kwa mfalme wote pia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.11",
            "verseOrgIds": [
              "1SA.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli akasema, Sikia sasa, Ewe mwana wa Ahitubu. Naye akaitika, Mimi hapa, bwana wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.12",
            "verseOrgIds": [
              "1SA.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli akamwuliza, Mbona mmefanya fitina juu yangu, wewe na mwana wa Yese? Kwa maana umempa mikate, na upanga, nawe umemwuliza Mungu kwa ajili yake, ili aniondokee na kunivizia kama hivi leo? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.13",
            "verseOrgIds": [
              "1SA.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
