                  "text": "14:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo akajibu Doegi, Mwedomi, aliyesimama karibu na watumishi wa Sauli, akasema, Mimi nalimwona mwana wa Yese akienda Nobu, kwa Ahimeleki, mwana wa Ahitubu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.9",
            "verseOrgIds": [
              "1SA.22.9"
            ]
          }
        },
        {
