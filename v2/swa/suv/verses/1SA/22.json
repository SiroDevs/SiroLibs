              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Abiathari akamweleza Daudi ya kwamba Sauli amewaua makuhani wa BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.21",
            "verseOrgIds": [
              "1SA.22.21"
            ]
          }
        },
