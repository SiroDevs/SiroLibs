          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Mimi nimeanza leo tu kumwuliza Mungu kwa ajili yake? Hasha! Mfalme asinidhanie mimi, mtumishi wake neno hili, Wala jamaa yote ya baba yangu, kwa maana mimi, mtumishi wako siyajui hayo yote, yaliyopungua au yaliyozidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.15",
            "verseOrgIds": [
              "1SA.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mfalme akasema, Kufa utakufa, Ahimeleki, wewe na jamaa yote ya baba yako.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.16",
            "verseOrgIds": [
              "1SA.22.16"
            ]
          }
        }
