              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Sauli akasikia ya kwamba Daudi ameonekana, na wale watu waliokuwa pamoja naye. Basi Sauli alikuwa akikaa Gibea, chini ya mkwaju katika mahali palipoinuka, naye alikuwa na mkuki wake mkononi, na watumishi wake wote wakimzunguka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.6",
            "verseOrgIds": [
              "1SA.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
