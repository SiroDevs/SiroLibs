        },
        {
          "text": "Basi hao Wafilisti wakakusanya majeshi yao yote huko Afeki; nao Waisraeli wakafanya kambi karibu na chemchemi iliyoko Yezreeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.1",
            "verseOrgIds": [
              "1SA.29.1"
            ]
          }
        },
