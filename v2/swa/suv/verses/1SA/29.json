          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.1"
              },
              "items": [
                {
                  "text": "1 Sam 28:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao mashehe wa Wafilisti wakapita mbele, mia kwa mia, na elfu kwa elfu; naye Daudi na watu wake wakapita wa mwisho pamoja na Akishi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.2",
            "verseOrgIds": [
              "1SA.29.2"
            ]
          }
        },
        {
