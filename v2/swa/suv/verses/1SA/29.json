                "loc": "1PE.3.16"
              },
              "items": [
                {
                  "text": "1 Pet 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo wakuu wa Wafilisti wakasema, Waebrania hawa wafanyani hapa? Naye Akishi akawaambia wakuu wa Wafilisti, Je! Siye huyu Daudi, yule mtumishi wa Sauli, mfalme wa Israeli, ambaye amefuatana na mimi siku hizi, naam, miaka hii, wala mimi nisione hatia kwake, tangu hapo aliponiangukia mimi hata leo? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 29:4"
          },
          "items": [
