        },
        {
          "text": "Je! Siye huyo Daudi, ambaye waliimbiana habari zake katika michezo, wakisema,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
