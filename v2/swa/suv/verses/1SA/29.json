                  "text": "Isa 37:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo Akishi akamwita Daudi, akamwambia, Aishivyo BWANA, wewe umekuwa mwenye adili, tena kutoka kwako na kuingia kwako pamoja nami katika jeshi ni kwema machoni pangu; kwa sababu mimi sikuona uovu ndani yako tangu siku ile uliponijia hata leo; walakini hao wakuu hawakuridhii. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.6",
            "verseOrgIds": [
              "1SA.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi sasa urudi, uende zako kwa amani, ili usiwachukize hao mashehe wa Wafilisti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.7",
            "verseOrgIds": [
              "1SA.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Daudi akamwambia Akishi, Lakini mimi nimefanyaje? Nawe umeona nini kwangu mimi mtumwa wako, muda wote niliokaa mbele yako hata leo, nisipate ruhusa niende na kupigana na adui za bwana wangu mfalme? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.8",
            "verseOrgIds": [
              "1SA.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.14.17"
              },
              "items": [
                {
                  "text": "2 Sam 14:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.27"
              },
              "items": [
                {
                  "text": "19:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akishi akajibu, akamwambia Daudi, Mimi najua ya kuwa u mwema machoni pangu, kama malaika wa Mungu; ila hao wakuu wa Wafilisti wamesema, Huyu hatakwea pamoja nasi kwenda vitani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.9",
            "verseOrgIds": [
              "1SA.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo sasa amka asubuhi na mapema, wewe na watumwa wa bwana wako waliokuja pamoja nawe; nanyi mtakapoamka asubuhi na mapema, na kupata mwanga, nendeni zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.10",
            "verseOrgIds": [
              "1SA.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
