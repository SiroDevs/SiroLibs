            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Samweli akalala hata asubuhi, akaifungua milango ya nyumba ya BWANA. Samweli akaogopa kumjulisha Eli maono hayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.15",
            "verseOrgIds": [
              "1SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Eli akamwita Samweli, akasema, Samweli, mwanangu. Naye akajibu, Mimi hapa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.16",
            "verseOrgIds": [
              "1SA.3.16"
            ]
          }
        },
