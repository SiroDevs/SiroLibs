              "items": [
                {
                  "text": "Mt 26:63",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akamwuliza, Ni neno gani alilosema nawe? Nakusihi, usinifiche; Mungu akufanyie vivyo hivyo, na kuzidi, ukinificha lo lote katika hayo yote BWANA aliyosema nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.17",
            "verseOrgIds": [
              "1SA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
