                  "text": "Ebr 10:26-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na kwa hiyo nimeapa juu ya nyumba ya Eli, ya kwamba uovu wa nyumba ya Eli hautasafika kwa dhabihu wala kwa sadaka hata milele.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.14",
            "verseOrgIds": [
              "1SA.3.14"
            ]
