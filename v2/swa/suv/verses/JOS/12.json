                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na nchi ya Araba mpaka bahari ya Kinerethi, kuelekea mashariki, tena mpaka bahari ya Ataba, mpaka Bahari ya Chumvi, kwendea mashariki, njia ya kwendea Beth-yeshimothi; tena upande wa kusini, chini ya matelemko ya Pisga; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.3",
            "verseOrgIds": [
              "JOS.12.3"
            ]
          }
        },
