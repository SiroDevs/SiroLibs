            "number": "2",
            "style": "v",
            "sid": "JOS 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sihoni mfalme wa Waamori, aliyekaa huko Heshboni, naye ndiye aliyetawala toka Aroeri, ulioko kando ya bonde la Arnoni, na toka huo mji ulio katikati ya bonde, na nusu ya Gileadi, hata kuufikilia mto wa Yaboki, mpaka wa hao wana wa Amoni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.2",
            "verseOrgIds": [
              "JOS.12.2"
            ]
          }
        },
        {
          "name": "verse",
