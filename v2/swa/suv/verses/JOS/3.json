              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe uwaamuru hao makuhani walichukuao sanduku la agano, ukawaambie, Mtakapofika ukingo wa maji ya Yordani, simameni katika Yordani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.8",
