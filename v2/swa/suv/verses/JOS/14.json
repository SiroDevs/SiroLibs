                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini wale ndugu zangu waliokwea kwenda pamoja nami waliiyeyusha mioyo ya watu; ila mimi nilimfuata BWANA, Mungu wangu, kwa utimilifu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
