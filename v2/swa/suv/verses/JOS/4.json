        {
          "text": "Na hao watu wakakwea kutoka Yordani siku ya kumi ya mwezi wa kwanza, wakapiga kambi Gilgali, katika mpaka wa mashariki wa Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.19",
            "verseOrgIds": [
              "JOS.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
