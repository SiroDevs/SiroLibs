          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yale mawe kumi na mawili waliyoyatwaa katikati ya Yordani Yoshua akayasimamisha Gilgali. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.20",
            "verseOrgIds": [
              "JOS.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaambia wana wa Israeli, akasema, Watoto wenu watakapowauliza baba zao katika siku zijazo, wakisema, Mawe haya maana yake ni nini? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.21",
            "verseOrgIds": [
              "JOS.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mtakapowaarifu watoto wenu mkisema, Israeli walivuka mto huu wa Yordani, kwa njia ya nchi kavu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.22",
            "verseOrgIds": [
              "JOS.4.22"
            ]
          }
        },
