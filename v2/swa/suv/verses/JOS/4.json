        },
        {
          "text": "Basi Yoshua akawaamuru hao makuhani, akawaambia, Haya, kweeni mtoke Yordani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.17",
            "verseOrgIds": [
              "JOS.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilikuwa, hapo hao makuhani waliolichukua sanduku la agano la BWANA walipokwea juu kutoka mle kati ya Yordani, na nyayo za miguu yao hao makuhani zilipoinuliwa na kutiwa katika nchi kavu, ndipo maji ya Yordani yaliporudi mahali pake, na kujaa na kuipita mipaka yake, kama yalivyokuwa hapo kwanza.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        }
      ]
