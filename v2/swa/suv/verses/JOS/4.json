        {
          "text": "ili kwamba jambo hili liwe ishara kati yenu, hapo watoto wenu watakapowauliza ninyi katika siku zijazo, wakisema, Ni nini maana yake mawe haya? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.6",
            "verseOrgIds": [
              "JOS.4.6"
            ]
