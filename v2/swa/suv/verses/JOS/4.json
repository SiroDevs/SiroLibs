        },
        {
          "text": "Haya, twaeni watu waume kumi na wawili katika hao watu, kila kabila mtu mmoja, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.2",
            "verseOrgIds": [
              "JOS.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kisha uwaamrishe, kusema, Twaeni mawe kumi na mawili, hapo katikati ya Yordani, mahali hapo miguu ya hao makuhani iliposimama imara, mwende nayo mawe hayo, mkayaweke nchi kambini, hapo mtakapolala usiku huu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.3",
            "verseOrgIds": [
              "JOS.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yoshua akawaita hao watu kumi na wawili, aliokuwa amewaweka tayari tangu hapo, katika wana wa Israeli, kila kabila mtu mmoja; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.4",
            "verseOrgIds": [
              "JOS.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye Yoshua akawaambia, Haya, piteni ninyi mtangulie mbele ya sanduku la BWANA, Mungu wenu, mwende pale katikati ya Yordani, mkatwae kila mtu wenu jiwe moja begani mwake, kwa kadiri ya hesabu ya kabila za wana wa Israeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.5",
            "verseOrgIds": [
              "JOS.4.5"
            ]
          }
        },
