              "items": [
                {
                  "text": "Hes 33:52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini wana wa Manase hawakuweza kuwafukuza wenyeji wa miji hiyo; bali hao Wakanaani walijikaza ili wakae katika nchi hiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
