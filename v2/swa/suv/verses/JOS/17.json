                "loc": "JOS.16.10"
              },
              "items": [
                {
                  "text": "Yos 16:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha ikawa, hapo hao wana wa Israeli walipokuwa wamepata nguvu zaidi, ndipo wakawatenza nguvu hao Wakanaani wafanye kazi ya shokoa, wala hawakuwafukuza kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        }
      ]
