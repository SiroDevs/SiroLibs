                "loc": "MAT.7.15"
              },
              "items": [
                {
                  "text": "Mt 7:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wapenzi, msiiamini kila roho, bali zijaribuni hizo roho, kwamba zimetokana na Mungu; kwa sababu manabii wa uongo wengi wametokea duniani. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.1",
            "verseOrgIds": [
              "1JN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.3"
              },
              "items": [
                {
                  "text": "1 Kor 12:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Katika hili mwamjua Roho wa Mungu; kila roho ikiriyo kwamba Yesu Kristo amekuja katika mwili yatokana na Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.2",
            "verseOrgIds": [
              "1JN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.18"
              },
              "items": [
                {
                  "text": "1 Yoh 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.17"
              },
              "items": [
                {
                  "text": "Yn 8:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na kila roho isiyomkiri Yesu haitokani na Mungu. Na hii ndiyo roho ya mpinga Kristo ambayo mmesikia kwamba yaja; na sasa imekwisha kuwako duniani. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.3",
            "verseOrgIds": [
              "1JN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.29"
              },
              "items": [
                {
                  "text": "Mt 12:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ninyi, watoto wadogo, mwatokana na Mungu nanyi mmewashinda, kwa sababu yeye aliye ndani yenu ni mkuu kuliko yeye aliye katika dunia. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.4",
            "verseOrgIds": [
              "1JN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.19"
              },
              "items": [
                {
                  "text": "Yn 15:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hao ni wa dunia; kwa hiyo wanena ya dunia na dunia huwasikia ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.5",
            "verseOrgIds": [
              "1JN.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.47"
              },
              "items": [
                {
                  "text": "Yn 8:47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sisi twatokana na Mungu. Yeye amjuaye Mungu atusikia; yeye asiyetokana na Mungu hatusikii. Katika hili twamjua Roho wa kweli, na roho ya upotevu.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.6",
            "verseOrgIds": [
              "1JN.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mungu ni Upendo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
