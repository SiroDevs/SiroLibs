        },
        {
          "text": "Atukuzwe Mungu, Baba wa Bwana wetu Yesu Kristo, aliyetubariki kwa baraka zote za rohoni, katika ulimwengu wa roho, ndani yake Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.3",
            "verseOrgIds": [
              "EPH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
