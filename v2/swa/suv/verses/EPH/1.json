            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.29"
              },
              "items": [
                {
                  "text": "Rum 8:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kama vile alivyotuchagua katika yeye kabla ya kuwekwa misingi ya ulimwengu, ili tuwe watakatifu, watu wasio na hatia mbele zake katika pendo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.4",
            "verseOrgIds": [
              "EPH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.12"
              },
              "items": [
                {
                  "text": "Yn 1:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa kuwa alitangulia kutuchagua, ili tufanywe wanawe kwa njia ya Yesu Kristo, sawasawa na uradhi wa mapenzi yake. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.5",
            "verseOrgIds": [
              "EPH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
