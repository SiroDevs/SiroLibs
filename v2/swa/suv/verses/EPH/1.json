        },
        {
          "text": "Paulo, mtume wa Kristo Yesu, kwa mapenzi ya Mungu; kwa watakatifu walioko [Efeso] wanaomwamini Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.1",
            "verseOrgIds": [
              "EPH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.2"
              },
              "items": [
                {
                  "text": "Kol 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Neema na iwe kwenu na amani zitokazo kwa Mungu Baba yetu na kwa Bwana Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.2",
            "verseOrgIds": [
              "EPH.1.2"
            ]
          }
        }
      ]
    },
