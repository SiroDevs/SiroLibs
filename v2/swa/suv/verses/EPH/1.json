        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.17"
              },
              "items": [
                {
                  "text": "Mt 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.13"
              },
              "items": [
                {
                  "text": "Kol 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na usifiwe utukufu wa neema yake, ambayo ametuneemesha katika huyo Mpendwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.6",
            "verseOrgIds": [
              "EPH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
