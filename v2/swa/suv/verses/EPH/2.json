                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "hata wakati ule tulipokuwa wafu kwa sababu ya makosa yetu; alituhuisha pamoja na Kristo; yaani, tumeokolewa kwa neema. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.5",
            "verseOrgIds": [
