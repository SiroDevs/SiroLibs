              "items": [
                {
                  "text": "Tit 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana tu kazi yake, tuliumbwa katika Kristo Yesu, tutende matendo mema, ambayo tokea awali Mungu aliyatengeneza ili tuenende nayo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.10",
