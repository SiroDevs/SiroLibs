                "loc": "COL.3.6"
              },
              "items": [
                {
                  "text": "Kol 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ambao zamani, sisi sote nasi tulienenda kati yao, katika tamaa za miili yetu, tulipoyatimiza mapenzi ya mwili na ya nia, tukawa kwa tabia yetu watoto wa hasira kama na hao wengine. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.3",
            "verseOrgIds": [
              "EPH.2.3"
            ]
          }
        },
        {
          "name": "verse",
