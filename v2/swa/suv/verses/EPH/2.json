          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Mungu, kwa kuwa ni mwingi wa rehema, kwa mapenzi yake makuu aliyotupenda; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.4",
            "verseOrgIds": [
              "EPH.2.4"
            ]
          }
        },
