                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini sasa, katika Kristo Yesu, ninyi mliokuwa mbali hapo kwanza mmekuwa karibu kwa damu yake Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.13",
