        {
          "text": "ambazo mliziendea zamani kwa kuifuata kawaida ya ulimwengu huu, na kwa kumfuata mfalme wa uwezo wa anga, roho yule atendaye kazi sasa katika wana wa kuasi; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.2",
            "verseOrgIds": [
              "EPH.2.2"
            ]
          }
        },
        {
