        },
        {
          "text": "ya kwamba kwa kufunuliwa nalijulishwa siri hiyo, kama nilivyotangulia kuandika kwa maneno machache. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.3",
            "verseOrgIds": [
              "EPH.3.3"
            ]
          }
