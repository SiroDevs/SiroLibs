              },
              "items": [
                {
                  "text": "Kol 1:26-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa hayo, myasomapo, mtaweza kuutambua ufahamu wangu katika siri yake Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.4",
            "verseOrgIds": [
              "EPH.3.4"
            ]
          }
        },
