                  "text": "Gal 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mvue kwa habari ya mwenendo wa kwanza utu wa zamani, unaoharibika kwa kuzifuata tamaa zenye kudanganya; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.22",
