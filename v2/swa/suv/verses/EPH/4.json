                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ambao wakiisha kufa ganzi wanajitia katika mambo ya ufisadi wapate kufanyiza kila namna ya uchafu kwa kutamani. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.19",
            "verseOrgIds": [
              "EPH.4.19"
            ]
          }
        },
