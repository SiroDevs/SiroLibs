              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo nawasihi, mimi niliye mfungwa katika Bwana, mwenende kama inavyoustahili wito wenu mlioitiwa; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.1",
            "verseOrgIds": [
              "EPH.4.1"
            ]
