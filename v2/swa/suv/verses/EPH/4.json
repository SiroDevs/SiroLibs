              "items": [
                {
                  "text": "1 Kor 12:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mungu mmoja, naye ni Baba wa wote, aliye juu ya yote na katika yote na ndani ya yote. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.6",
            "verseOrgIds": [
