          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.12+COL.3.13"
              },
              "items": [
                {
                  "text": "Kol 3:12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kwa unyenyekevu wote na upole, kwa uvumilivu, mkichukuliana katika upendo; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.2",
            "verseOrgIds": [
              "EPH.4.2"
            ]
          }
        },
        {
