                  "text": "1 Kor 12:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini kila mmoja wetu alipewa neema kwa kadiri ya kipimo cha kipawa chake Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.7",
            "verseOrgIds": [
