                "loc": "REV.20.1"
              },
              "items": [
                {
                  "text": "20:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Malaika wa tano akapiga baragumu, nikaona nyota iliyotoka mbinguni, imeanguka juu ya nchi; naye akapewa ufunguo wa shimo la kuzimu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.1",
            "verseOrgIds": [
              "REV.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.28"
              },
              "items": [
                {
                  "text": "Mwa 19:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.18"
              },
              "items": [
                {
                  "text": "Kut 19:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.2"
              },
              "items": [
                {
                  "text": "Yoe 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akalifungua shimo la kuzimu; moshi ukapanda kutoka mle shimoni kama moshi wa tanuru kubwa; jua na anga vikatiwa giza kwa sababu ya ule moshi wa shimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.2",
            "verseOrgIds": [
              "REV.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.10.12+EXO.10.13+EXO.10.14+EXO.10.15"
              },
              "items": [
                {
                  "text": "Kut 10:12-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nzige wakatoka katika ule moshi, wakaenda juu ya nchi, wakapewa nguvu kama nguvu waliyo nayo nge wa nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.3",
            "verseOrgIds": [
              "REV.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Eze 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.3"
              },
              "items": [
                {
                  "text": "Ufu 7:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakaambiwa wasiyadhuru majani ya nchi, wala kitu cho chote kilicho kibichi, wala mti wo wote, ila wale watu wasio na muhuri ya Mungu katika vipaji vya nyuso zao. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.4",
            "verseOrgIds": [
              "REV.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakapewa amri kwamba wasiwaue, bali wateswe miezi mitano. Na maumivu yao yalikuwa kama kuumwa na nge, aumapo mwanadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.5",
            "verseOrgIds": [
              "REV.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.3.21"
              },
              "items": [
                {
                  "text": "Ayu 3:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.3"
              },
              "items": [
                {
                  "text": "Yer 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.30"
              },
              "items": [
                {
                  "text": "Lk 23:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na siku zile wanadamu watatafuta mauti, wala hawataiona kamwe. Nao watatamani kufa, nayo mauti itawakimbia. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.6",
            "verseOrgIds": [
              "REV.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.4"
              },
              "items": [
                {
                  "text": "Yoe 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na maumbo ya hao nzige yalikuwa kama farasi waliowekwa tayari kwa vita, na juu ya vichwa vyao kama taji, mfano wa dhahabu, na nyuso zao zilikuwa kama nyuso za wanadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.7",
            "verseOrgIds": [
              "REV.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.1.6"
              },
              "items": [
                {
                  "text": "Yoe 1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao walikuwa na nywele kama nywele za wanawake. Na meno yao yalikuwa kama meno ya simba. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.8",
            "verseOrgIds": [
              "REV.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.5"
              },
              "items": [
                {
                  "text": "Yoe 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao walikuwa na dirii kifuani kama dirii za chuma. Na sauti ya mabawa yao ilikuwa kama sauti ya magari, ya farasi wengi waendao kasi vitani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.9",
            "verseOrgIds": [
              "REV.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao wana mikia kama ya nge, na miiba; na nguvu yao ya kuwadhuru wanadamu miezi mitano ilikuwa katika mikia yao. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.10",
            "verseOrgIds": [
              "REV.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na juu yao wanaye mfalme, naye ni malaika wa kuzimu, jina lake kwa Kiebrania ni Abadoni, na kwa Kiyunani analo jina lake Apolioni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.11",
            "verseOrgIds": [
              "REV.9.11"
            ]
          }
        }
      ]
    },
