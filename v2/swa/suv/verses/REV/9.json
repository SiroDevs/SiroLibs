                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.14"
              },
              "items": [
                {
                  "text": "11:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ole wa kwanza umekwisha pita. Tazama, bado ziko ole mbili, zinakuja baadaye.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.12",
            "verseOrgIds": [
              "REV.9.12"
            ]
          }
        }
