            "number": "19",
            "style": "v",
            "sid": "REV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana nguvu za hao farasi ni katika vinywa vyao, na katika mikia yao; maana mikia yao ni mfano wa nyoka, ina vichwa, nao wanadhuru kwa hivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.19",
