                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na yeye aliyesema nami alikuwa na mwanzi wa dhahabu, apate kuupima huo mji, na milango yake, na ukuta wake. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.15",
            "verseOrgIds": [
              "REV.21.15"
            ]
          }
        },
