                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wenye utukufu wa Mungu, na mwangaza wake ulikuwa mfano wa kito chenye thamani nyingi kama kito cha yaspi, safi kama bilauri; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.11",
            "verseOrgIds": [
              "REV.21.11"
            ]
          }
        },
        {
