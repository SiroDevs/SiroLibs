                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na majenzi ya ule ukuta wake yalikuwa ya yaspi, na mji ule ulikuwa wa dhahabu safi, mfano wa kioo safi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.18",
            "verseOrgIds": [
              "REV.21.18"
            ]
          }
        },
