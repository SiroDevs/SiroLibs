          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaupima ukuta wake, ukapata dhiraa mia na arobaini na nne, kwa kipimo cha kibinadamu, maana yake, cha malaika. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.17",
            "verseOrgIds": [
              "REV.21.17"
            ]
          }
        },
        {
