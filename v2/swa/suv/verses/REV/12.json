              "items": [
                {
                  "text": "Ufu 11:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.31"
              },
              "items": [
                {
                  "text": "Lk 22:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nikasikia sauti kuu mbinguni, ikisema, Sasa kumekuwa wokovu, na nguvu, na ufalme wa Mungu wetu, na mamlaka ya Kristo wake; kwa maana ametupwa chini mshitaki wa ndugu zetu, yeye awashitakiye mbele za Mungu wetu, mchana na usiku. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.37"
              },
              "items": [
                {
                  "text": "Rum 8:37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.14"
              },
              "items": [
                {
                  "text": "Ufu 7:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao wakamshinda kwa damu ya Mwana-Kondoo, na kwa neno la ushuhuda wao; ambao hawakupenda maisha yao hata kufa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.23"
              },
              "items": [
                {
                  "text": "Isa 44:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.13"
              },
              "items": [
                {
                  "text": "49:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa hiyo shangilieni, enyi mbingu, nanyi mkaao humo. Ole wa nchi na bahari! Kwa maana yule Ibilisi ameshuka kwenu mwenye ghadhabu nyingi, akijua ya kuwa ana wakati mchache tu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joka Anapigana tena katika Dunia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na joka yule alipoona ya kuwa ametupwa katika nchi, alimwudhi mwanamke yule aliyemzaa mtoto mwanamume. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.13",
            "verseOrgIds": [
              "REV.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.25"
              },
              "items": [
                {
                  "text": "Dan 7:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.7"
              },
              "items": [
                {
                  "text": "12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwanamke yule akapewa mabawa mawili ya tai yule mkubwa, ili aruke, aende zake nyikani hata mahali pake, hapo alishwapo kwa wakati na nyakati na nusu ya wakati, mbali na nyoka huyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.14",
            "verseOrgIds": [
              "REV.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyoka akatoa katika kinywa chake, nyuma ya huyo mwanamke, maji kama mto, amfanye kuchukuliwa na mto ule. ",
          "type": "text",
          "attrs": {
