                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kulikuwa na vita mbinguni; Mikaeli na malaika zake wakapigana na yule joka, yule joka naye akapigana nao pamoja na malaika zake; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.7",
            "verseOrgIds": [
              "REV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao hawakushinda, wala mahali pao hapakuonekana tena mbinguni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.8",
            "verseOrgIds": [
              "REV.12.8"
            ]
          }
        },
        {
          "name": "verse",
