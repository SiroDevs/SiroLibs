              "items": [
                {
                  "text": "Zek 14:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wala hapatakuwa na laana yo yote tena. Na kiti cha enzi cha Mungu na cha Mwana-Kondoo kitakuwamo ndani yake. Na watumwa wake watamtumikia; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.3",
            "verseOrgIds": [
              "REV.22.3"
            ]
          }
        },
