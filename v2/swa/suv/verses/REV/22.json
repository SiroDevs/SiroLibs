                {
                  "text": "1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na tazama, naja upesi; heri yeye ayashikaye maneno ya unabii wa kitabu hiki.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.7",
            "verseOrgIds": [
