              "items": [
                {
                  "text": "Ufu 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nao watamwona uso wake, na jina lake litakuwa katika vipaji vya nyuso zao. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.4",
            "verseOrgIds": [
              "REV.22.4"
            ]
          }
        },
