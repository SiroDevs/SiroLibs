                  "text": "Dan 7:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akanichukua katika Roho hata jangwani, nikaona mwanamke, ameketi juu ya mnyama mwekundu sana, mwenye kujaa majina ya makufuru, mwenye vichwa saba na pembe kumi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.3",
            "verseOrgIds": [
              "REV.17.3"
            ]
          }
        },
        {
