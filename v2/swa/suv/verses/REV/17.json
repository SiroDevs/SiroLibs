                }
              ]
            }
          ]
        },
        {
          "text": "Na zile pembe kumi ulizoziona ni wafalme kumi, ambao hawajapokea ufalme bado, lakini wapokea mamlaka kama wafalme muda wa saa moja pamoja na yule mnyama. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.12",
            "verseOrgIds": [
              "REV.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa wana shauri moja, nao wampa yule mnyama nguvu zao na mamlaka yao. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.13",
            "verseOrgIds": [
              "REV.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
