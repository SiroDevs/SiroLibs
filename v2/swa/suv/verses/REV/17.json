                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Yer 51:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.13"
              },
              "items": [
                {
                  "text": "Eze 28:13",
                  "type": "text"
