              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na mwanamke yule alikuwa amevikwa nguo ya rangi ya zambarau, na nyekundu, amepambwa kwa dhahabu, na kito cha thamani, na lulu, naye alikuwa na kikombe cha dhahabu mkononi mwake, kilichojawa na machukizo, na machafu ya uasherati wake. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.4",
            "verseOrgIds": [
              "REV.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
