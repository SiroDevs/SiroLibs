              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hapo ndipo penye akili zenye hekima. Vile vichwa saba ni milima saba anayokalia mwanamke huyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.9",
            "verseOrgIds": [
              "REV.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navyo ni wafalme saba. Watano wamekwisha kuanguka, na mmoja yupo, na mwingine hajaja bado. Naye atakapokuja imempasa kukaa muda mchache. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.10",
            "verseOrgIds": [
              "REV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.20"
              },
              "items": [
                {
                  "text": "Ufu 19:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na yule mnyama aliyekuwako naye hayuko, yeye ndiye wa nane, naye ni mmoja wa wale saba, naye aenenda kwenye uharibifu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.11",
            "verseOrgIds": [
              "REV.17.11"
            ]
          }
        }
      ]
