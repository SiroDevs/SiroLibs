                  "text": "16:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na katika kipaji cha uso wake alikuwa na jina limeandikwa, la siri, BABELI MKUU, MAMA WA MAKAHABA NA MACHUKIZO YA NCHI. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.5",
            "verseOrgIds": [
              "REV.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.24"
              },
              "items": [
                {
                  "text": "Ufu 18:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nikamwona yule mwanamke amelewa kwa damu ya watakatifu, na kwa damu ya mashahidi wa Yesu. Nami nilipomwona nikastaajabu ajabu kuu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.6",
            "verseOrgIds": [
              "REV.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yule malaika akaniambia, Kwani kustaajabu? Nitakuambia siri ya mwanamke huyu, na ya mnyama huyu amchukuaye, mwenye vile vichwa saba na zile pembe kumi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.7",
            "verseOrgIds": [
              "REV.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
