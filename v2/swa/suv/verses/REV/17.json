                  "text": "Zab 69:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yule mnyama uliyemwona alikuwako, naye hayuko, naye yu tayari kupanda kutoka kuzimu na kwenda kwenye uharibifu. Na hao wakaao juu ya nchi, wasioandikwa majina yao katika kitabu cha uzima tangu kuwekwa misingi ya ulimwengu, watastaajabu wamwonapo yule mnyama, ya kwamba alikuwako, naye hayuko, naye atakuwako. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.8",
            "verseOrgIds": [
              "REV.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 17:9"
          },
          "items": [
            {
