              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Shela, mwana wa Yuda; Eri, babaye Leka, na Laada, babaye Maresha, na jamaa zao wa mbari ya wafuma nguo za kitani safi, wa mbari ya Ashbea; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.21",
            "verseOrgIds": [
              "1CH.4.21"
            ]
          }
        },
