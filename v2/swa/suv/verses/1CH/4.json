            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.12"
              },
              "items": [
                {
                  "text": "2 Sam 8:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao wakawapiga mabaki ya Waamaleki waliookoka, wakakaa huko, hata siku hii ya leo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.43",
