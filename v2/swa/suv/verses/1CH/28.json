        },
        {
          "text": "Nawe, Sulemani mwanangu, mjue Mungu wa baba yako, ukamtumikie kwa moyo mkamilifu, na kwa nia ya kumkubali; kwa kuwa BWANA hutafuta-tafuta mioyo yote, na kuyatambua mawazo yote ya fikira; ukimtafuta, ataonekana nawe; ukimwacha, atakutupa milele. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.9",
            "verseOrgIds": [
              "1CH.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
