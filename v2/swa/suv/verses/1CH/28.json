          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya dhahabu kwa uzani kwa vyombo vya dhahabu, kwa vyombo vyote vya utumishi wa kila namna; ya fedha kwa uzani kwa vyombo vyote vya fedha, kwa vyombo vyote vya utumishi wa kila namna; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.14",
            "verseOrgIds": [
              "1CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
