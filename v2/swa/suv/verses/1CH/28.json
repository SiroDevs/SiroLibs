              "items": [
                {
                  "text": "1 Fal 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.11"
              },
              "items": [
                {
                  "text": "11:11",
