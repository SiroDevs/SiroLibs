                }
              ]
            }
          ]
        },
        {
          "text": "Walakini BWANA, Mungu wa Israeli, alinichagua katika nyumba yote ya babangu kuwa mfalme juu ya Israeli milele, kwa kuwa amemchagua Yuda awe mkuu; na katika nyumba ya Yuda, alichagua nyumba ya babangu, na miongoni mwa wana wa babangu, aliniridhia mimi ili kunitawaza niwe mfalme juu ya Israeli wote; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.4",
            "verseOrgIds": [
              "1CH.28.4"
            ]
          }
        },
        {
