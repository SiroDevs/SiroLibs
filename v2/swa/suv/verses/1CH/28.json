          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa uzani tena kwa vinara vya dhahabu, na kwa taa zake za dhahabu, kwa uzani, kwa kila kinara, na kwa taa zake; na kwa vinara vya fedha, kwa uzani kwa kila kinara na kwa taa zake, kwa kadiri ya matumizi ya kila kinara; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.15",
            "verseOrgIds": [
              "1CH.28.15"
            ]
          }
        },
