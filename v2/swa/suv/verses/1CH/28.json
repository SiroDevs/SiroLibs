              "items": [
                {
                  "text": "2 Nya 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akaniambia, Sulemani, mwanao, ndiye atakayeijenga nyumba yangu na nyua zangu; kwa kuwa nimemchagua awe mwanangu, nami nitakuwa babaye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.6",
            "verseOrgIds": [
              "1CH.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 28:7"
