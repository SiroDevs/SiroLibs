              "items": [
                {
                  "text": "22:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "tena katika wana wangu wote (kwani BWANA amenipa wana wengi), amemchagua Sulemani mwanangu ili aketi juu ya kiti cha enzi cha ufalme wa BWANA, juu ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.5",
            "verseOrgIds": [
              "1CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 28:6"
