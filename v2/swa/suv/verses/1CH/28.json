        },
        {
          "text": "Lakini Mungu akaniambia, Wewe hutajenga nyumba kwa ajili ya jina langu, kwa sababu umekuwa mtu wa vita, nawe umemwaga damu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.3",
            "verseOrgIds": [
              "1CH.28.3"
            ]
          }
        },
