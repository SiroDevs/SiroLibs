          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "tena katika habari ya zamu za makuhani na Walawi, na ya kazi yote ya huo utumishi wa nyumba ya BWANA, na ya vyombo vyote vya utumishi nyumbani mwa BWANA; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.13",
            "verseOrgIds": [
              "1CH.28.13"
            ]
          }
        },
        {
          "name": "verse",
