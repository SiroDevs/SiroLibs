              "items": [
                {
                  "text": "1 Nya 22:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na ufalme wake nitauweka imara milele, akijitia kwa bidii kuzitenda amri zangu na hukumu zangu, kama hivi leo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.7",
            "verseOrgIds": [
              "1CH.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 28:8"
