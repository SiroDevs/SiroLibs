                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikawa, Daudi alipokuwa akikaa nyumbani mwake, Daudi akamwambia nabii Nathani, Angalia, mimi ninakaa katika nyumba ya mwerezi, bali sanduku la agano la BWANA linakaa chini ya mapazia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.1",
            "verseOrgIds": [
              "1CH.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Nathani akamwambia Daudi, Haya, fanya yote yaliyomo moyoni mwako; kwa maana Mungu yu pamoja nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.2",
            "verseOrgIds": [
              "1CH.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa usiku uo huo, neno la Mungu likamjia Nathani, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.3",
            "verseOrgIds": [
              "1CH.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenda, kamwambie mtumishi wangu, Daudi, BWANA asema hivi, Wewe hutanijengea nyumba ya kukaa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.4",
            "verseOrgIds": [
              "1CH.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.40.2"
              },
              "items": [
                {
                  "text": "Kut 40:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.17"
              },
              "items": [
                {
                  "text": "2 Sam 6:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.4"
              },
              "items": [
                {
                  "text": "1 Fal 8:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kwa maana sikukaa ndani ya nyumba tangu siku ile nilipowaleta Israeli huku hata leo; lakini hema kwa hema nimehamia, na maskani kwa maskani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.5",
            "verseOrgIds": [
              "1CH.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mahali mwote nilimokwenda na Israeli wote, je! Nimesema neno lo lote na mtu ye yote wa waamuzi wa Israeli, niliowaagiza kuwalisha watu wangu, nikisema, Mbona hamkunijengea nyumba ya mwerezi? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.6",
            "verseOrgIds": [
              "1CH.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi sasa ndivyo utakavyomwambia mtumishi wangu Daudi, BWANA wa majeshi asema hivi, Nalikutwaa katika zizi la kondoo, katika kuwaandama kondoo ili uwe mkuu juu ya watu wangu Israeli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.7",
            "verseOrgIds": [
              "1CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami nimekuwa pamoja nawe kila ulikokwenda, na kuwakatilia mbali adui zako wote mbele yako; nami nitakufanyia jina, kama jina la hao wakuu walioko duniani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.8",
            "verseOrgIds": [
              "1CH.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
