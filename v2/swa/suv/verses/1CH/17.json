          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena jambo hili lilikuwa dogo machoni pako, Ee Mungu; hata umeleta habari ya nyumba yangu mimi, mtumwa wako, kwa miaka mingi inayokuja, nawe umeniangalia sawasawa na hali ya mtu mwenye cheo, Ee BWANA Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.17",
            "verseOrgIds": [
              "1CH.17.17"
            ]
          }
        },
        {
