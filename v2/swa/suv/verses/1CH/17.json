        {
          "text": "Nitakuwa baba yake, naye atakuwa mwanangu; wala sitamwondolea fadhili zangu, kama nilivyomwondolea yeye aliyekuwa kabla yako; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.13",
