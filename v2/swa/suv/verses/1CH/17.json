                  "text": "Efe 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ee BWANA, kwa ajili ya mtumwa wako, na kwa moyo wako mwenyewe, umeyatenda hayo makuu yote, ili yajulikane hayo matendo makuu yote. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.19",
            "verseOrgIds": [
