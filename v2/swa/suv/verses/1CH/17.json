                  "text": "Zab 86:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ee BWANA, hakuna mwingine kama wewe, wala hakuna Mungu mwingine ila wewe, kwa kadiri tulivyosikia kwa masikio yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.20",
            "verseOrgIds": [
