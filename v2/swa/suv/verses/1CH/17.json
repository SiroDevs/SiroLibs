                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na Daudi akuambie nini tena zaidi kwa habari ya heshima aliyotendewa mtumwa wako? Kwa maana wewe umemjua mtumwa wako. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.18",
            "verseOrgIds": [
              "1CH.17.18"
            ]
          }
        },
