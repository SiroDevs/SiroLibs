                }
              ]
            }
          ]
        },
        {
          "text": "ila nitamstarehesha katika nyumba yangu na katika ufalme wangu milele; na kiti chake cha enzi kitathibitishwa milele. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.14",
            "verseOrgIds": [
              "1CH.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maneno hayo yote, na kwa maono hayo yote, ndivyo Nathani alivyonena na Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.15",
            "verseOrgIds": [
              "1CH.17.15"
            ]
          }
        }
