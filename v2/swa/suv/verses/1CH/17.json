                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jina lako na liwe imara, likatukuzwe milele, kusema, BWANA wa majeshi ndiye Mungu wa Israeli, naam, Mungu juu ya Israeli; na hiyo nyumba ya Daudi mtumwa wako imefanywa imara mbele zako. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.24",
            "verseOrgIds": [
              "1CH.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
