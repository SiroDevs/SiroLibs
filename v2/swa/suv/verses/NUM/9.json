              "items": [
                {
                  "text": "Yos 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao wakaishika Pasaka katika mwezi wa kwanza, siku ya kumi na nne ya mwezi, wakati wa jioni, katika bara ya Sinai vile vile kama hayo yote BWANA aliyomwagiza Musa, ndivyo walivyofanya wana wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.5",
            "verseOrgIds": [
              "NUM.9.5"
            ]
          }
        }
