                }
              ]
            }
          ]
        },
        {
          "text": "Balaki akamwambia Balaamu, Umenitendea nini? Nimekuleta ili Uwalaani adui zangu, na tazama, umewabariki kabisa kabisa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.11",
            "verseOrgIds": [
