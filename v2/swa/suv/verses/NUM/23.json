              "items": [
                {
                  "text": "1 Sam 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akafika kwake, na tazama, amesimama karibu na sadaka yake ya kuteketezwa, na wakuu wa Moabu pamoja naye. Balaki akamwambia, BWANA amenena nini? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.17",
            "verseOrgIds": [
              "NUM.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
