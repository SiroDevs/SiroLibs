            }
          ]
        },
        {
          "text": "BWANA akaonana na Balaamu akatia neno kinywani mwake, akasema, Umrudie Balaki, ukaseme hivi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.16",
