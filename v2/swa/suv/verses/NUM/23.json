              "items": [
                {
                  "text": "Kum 18:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.9"
              },
              "items": [
                {
                  "text": "Yer 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA akatia neno katika kinywa chake Balaamu, akasema, Umrudie Balaki; ukaseme maneno haya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.5",
            "verseOrgIds": [
              "NUM.23.5"
            ]
          }
        }
      ]
    },
