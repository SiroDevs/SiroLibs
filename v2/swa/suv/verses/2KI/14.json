            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:1",
              "type": "text"
            },
            {
              "text": "Au, Yoashi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwana wa Yehoahazi mfalme wa Israeli Amazia mwana wa Yoashi mfalme wa Yuda alianza kutawala. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.1",
            "verseOrgIds": [
              "2KI.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye alikuwa na umri wa miaka ishirini na mitano alipoanza kutawala; akatawala miaka ishirini na kenda katika Yerusalemu; na jina la mamaye aliitwa Yehoadani wa Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.2",
            "verseOrgIds": [
              "2KI.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafanya yaliyo mema machoni pa BWANA, ila si kama babaye Daudi; akafanya kama yote aliyoyafanya baba yake Yoashi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.3",
            "verseOrgIds": [
              "2KI.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
