              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda wakashindwa mbele ya Israeli; wakakimbia kila mtu hemani kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.12",
            "verseOrgIds": [
