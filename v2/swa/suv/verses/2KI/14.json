                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikawa, mara ufalme ulipokuwa imara mkononi mwake, aliwaua watumishi wale waliomwua mfalme baba yake; ",
          "type": "text",
          "attrs": {
