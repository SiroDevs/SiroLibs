                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akafanya yaliyo mabaya machoni pa BWANA; ila si kama baba yake na kama mama yake; maana akaiondoa ile nguzo ya Baali aliyoifanya baba yake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.2",
            "verseOrgIds": [
              "2KI.3.2"
            ]
          }
