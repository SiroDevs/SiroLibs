                "loc": "2KI.2.25"
              },
              "items": [
                {
                  "text": "2 Fal 2:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehoshafati akasema, Neno la BWANA analo huyu. Basi mfalme wa Israeli, na Yehoshafati, na mfalme wa Edomu, wakamshukia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.12",
            "verseOrgIds": [
              "2KI.3.12"
            ]
          }
        },
