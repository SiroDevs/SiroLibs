              "items": [
                {
                  "text": "Isa 8:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mfalme wa Israeli akasema, Ole wetu! Kwani BWANA amewakutanisha hawa wafalme watatu, awaue mkononi mwa Moabu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.10",
