            {
              "text": "3:1",
              "type": "text"
            },
            {
              "text": "Au, Yehoramu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwana wa Ahabu alianza kutawala juu ya Israeli huko Samaria katika mwaka wa kumi na nane wa Yehoshafati mfalme wa Yuda, akatawala miaka kumi na miwili. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.1",
            "verseOrgIds": [
              "2KI.3.1"
            ]
          }
        },
