                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pamoja na hayo alishikamana na dhambi za Yeroboamu mwana wa Nebati, ambazo kwa hizo aliwakosesha Israeli; wala hakuziacha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.3",
            "verseOrgIds": [
              "2KI.3.3"
            ]
          }
        }
      ]
    },
