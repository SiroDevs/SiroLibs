                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elisha akasema, Kama BWANA wa majeshi aishivyo, ambaye nimesimama mbele zake, kama singemwangalia uso wake Yehoshafati mfalme wa Yuda, singekutazama, wala kuonana nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.14",
            "verseOrgIds": [
              "2KI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
