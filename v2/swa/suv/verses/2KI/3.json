                "loc": "ISA.16.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakaibomoa ile miji; wakatupa katika kila mahali palipo pema kila mtu jiwe lake, wakapajaza; wakaziziba chemchemi zote za maji, wakaikata miti yote iliyo mizuri; mpaka katika Kir-haresethi tu wakayasaza mawe yake; ila wenye kombeo wakauzunguka wakaupiga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.25",
            "verseOrgIds": [
              "2KI.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mfalme wa Moabu alipoona ya kwamba ameshindwa vitani, alitwaa pamoja naye watu mia saba wenye kufuta panga ili wapenye hata kwa mfalme wa Edomu; wala hawakudiriki. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.26",
            "verseOrgIds": [
              "2KI.3.26"
            ]
