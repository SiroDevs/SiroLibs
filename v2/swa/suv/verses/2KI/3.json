        },
        {
          "text": "Basi Mesha, mfalme wa Moabu, alikuwa mfuga kondoo; naye alikuwa akimlipa mfalme wa Israeli sufu ya wana-kondoo elfu mia, na ya kondoo waume elfu mia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.4",
            "verseOrgIds": [
              "2KI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
