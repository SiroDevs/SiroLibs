        {
          "text": "Ikawa asubuhi, wakati wa kutoa sadaka ya unga, tazama, maji yakaja kwa njia ya Edomu, hata nchi ikajaa maji.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.20",
