        },
        {
          "text": "wapewe maseremala, na wajenzi, na waashi; ili kununua miti na mawe yaliyochongwa wapate kuitengeneza nyumba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.6",
