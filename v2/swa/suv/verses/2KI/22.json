              },
              "items": [
                {
                  "text": "2 Nya 34:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikawa, mfalme alipokwisha kuyasikia maneno ya kitabu hicho cha torati, alirarua nguo zake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.11",
            "verseOrgIds": [
              "2KI.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme akamwamuru Hilkia kuhani, na Ahikamu, mwana wa Shafani, na Akbori, mwana wa Mikaya, na Shafani mwandishi, na Asaya, mtumishi wa mfalme akasema, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.12",
            "verseOrgIds": [
              "2KI.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 22:13"
