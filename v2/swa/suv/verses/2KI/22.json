        },
        {
          "text": "Naye Hilkia, kuhani mkuu, akamwambia Shafani, mwandishi, Nimekiona kitabu cha torati katika nyumba ya BWANA. Hilkia akampa Shafani kile kitabu, naye akakisoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.8",
            "verseOrgIds": [
              "2KI.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shafani mwandishi akamwendea mfalme, akamletea mfalme habari tena, akasema, Watumishi wako wamezitoa zile fedha zilizoonekana ndani ya nyumba, nao wamewakabidhi wafanya kazi wanaoisimamia nyumba ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.9",
            "verseOrgIds": [
              "2KI.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
