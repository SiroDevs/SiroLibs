        },
        {
          "text": "Lakini hawakuyaacha makosa ya nyumba ya Yeroboamu, ambayo kwa hayo aliwakosesha Israeli, lakini wakaendelea katika hayo; nayo ile Ashera ikakaa vivyo katika Samaria). ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.6",
            "verseOrgIds": [
              "2KI.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
