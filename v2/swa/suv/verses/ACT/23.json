              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.33"
              },
              "items": [
                {
                  "text": "Mdo 21:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.25"
              },
              "items": [
                {
                  "text": "22:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mtu huyu alikamatwa na Wayahudi, wakawa karibu kumwua, ndipo nikaenda pamoja na kikosi cha askari nikamwokoa, nilipopata habari ya kuwa yeye ni Mrumi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.27",
            "verseOrgIds": [
              "ACT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.30"
              },
              "items": [
                {
                  "text": "Mdo 22:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nikitaka kulijua lile neno walilomshitakia, nikamtelemsha nikamweka mbele ya baraza; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.28",
            "verseOrgIds": [
              "ACT.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.6.9"
              },
              "items": [
                {
                  "text": "Mdo 6:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.14"
              },
              "items": [
                {
                  "text": "18:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nikaona kwamba ameshitakiwa kwa ajili ya maswali ya sheria yao, wala hakushitakiwa neno lo lote la kustahili kuuawa wala kufungwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.29",
            "verseOrgIds": [
              "ACT.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.24.8"
              },
              "items": [
                {
                  "text": "Mdo 24:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hata nilipopewa habari kwamba patakuwa na vitimvi juu ya mtu huyu, mara nikampeleka kwako, nikawaagiza na wale waliomshitaki, wanene habari zake mbele yako. Wasalamu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.30",
            "verseOrgIds": [
              "ACT.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.30",
            "verseOrgIds": [
              "ACT.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, wale askari wakamchukua Paulo kama walivyoamriwa, wakampeleka hata Antipatri usiku; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.31",
            "verseOrgIds": [
              "ACT.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "hata asubuhi wakawaacha wale wapanda farasi waende pamoja naye, nao wakarudi zao ngomeni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.32",
            "verseOrgIds": [
              "ACT.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wale walipofika Kaisaria, na kumpa liwali ile barua, wakamweka Paulo mbele yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.33",
            "verseOrgIds": [
              "ACT.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.3"
              },
              "items": [
                {
                  "text": "Mdo 22:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye alipokwisha kuisoma, akawauliza, Mtu huyu ni wa jimbo gani? Alipoarifiwa ya kuwa ni mtu wa Kilikia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.34",
            "verseOrgIds": [
              "ACT.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "akasema, Nitakusikia wewe watakapokuja wale waliokushitaki; akaamuru alindwe katika nyumba ya uliwali ya Herode.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.35",
            "verseOrgIds": [
              "ACT.23.35"
            ]
          }
        }
