                }
              ]
            }
          ]
        },
        {
          "text": "Paulo akawakazia macho watu wa baraza, akasema, Ndugu zangu, mimi kwa dhamiri safi kabisa nimeishi mbele za Mungu hata leo hivi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.1",
            "verseOrgIds": [
              "ACT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
