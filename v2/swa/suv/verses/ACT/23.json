              "items": [
                {
                  "text": "26:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.5"
              },
              "items": [
                {
                  "text": "Flp 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Paulo alipotambua ya kuwa sehemu moja ni Masadukayo, na sehemu ya pili ni Mafarisayo, akapaza sauti yake katika ile baraza, Ndugu zangu, mimi ni Farisayo mwana wa Farisayo; mimi ninahukumiwa kwa ajili ya tumaini la ufufuo wa wafu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.6",
            "verseOrgIds": [
              "ACT.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipokwisha kunena hayo palikuwa na mashindano baina ya Mafarisayo na Masadukayo, mkutano ukafarakana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.7",
            "verseOrgIds": [
              "ACT.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.23"
              },
              "items": [
                {
                  "text": "Mt 22:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.18"
              },
              "items": [
                {
                  "text": "Mk 12:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.27"
              },
              "items": [
                {
                  "text": "Lk 20:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana Masadukayo husema ya kwamba hakuna kiyama wala malaika wala roho; bali Mafarisayo hukiri yote. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.8",
            "verseOrgIds": [
              "ACT.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.25.25"
              },
              "items": [
                {
                  "text": "Mdo 25:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.39"
              },
              "items": [
                {
                  "text": "5:39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pakawa na makelele mengi. Waandishi wengine wa upande wa Mafarisayo wakasimama, wakateta, wakisema, Hatuoni uovu wo wote katika mtu huyu; bali ikiwa roho au malaika amesema naye, ni nini? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.9",
            "verseOrgIds": [
              "ACT.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugomvi mkubwa ulipotokea, yule jemadari akachelea Paulo asije akararuliwa nao, akaamuru askari washuke na kumwondoa kwa nguvu mikononi mwao, na kumleta ndani ya ngome.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.10",
            "verseOrgIds": [
              "ACT.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
