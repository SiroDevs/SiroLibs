              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Klaudio Lisia kwa liwali mtukufu Feliki, Salamu! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.26",
            "verseOrgIds": [
              "ACT.23.26"
            ]
          }
        },
        {
