              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi hivi Paulo akaondoka akawaacha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.33",
            "verseOrgIds": [
              "ACT.17.33"
            ]
