          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana Waathene na wageni waliokaa huko walikuwa hawana nafasi kwa neno lo lote ila kutoa habari na kusikiliza habari za jambo jipya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.21",
            "verseOrgIds": [
              "ACT.17.21"
            ]
          }
        }
