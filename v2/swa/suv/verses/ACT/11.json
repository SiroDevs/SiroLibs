          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.4",
            "verseOrgIds": [
              "ACT.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
