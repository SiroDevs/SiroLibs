              "ACT.11.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.1+ACT.8.2+ACT.8.3+ACT.8.4"
              },
              "items": [
                {
                  "text": "Mdo 8:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wale waliotawanyika kwa sababu ya ile dhiki iliyotukia kwa habari ya Stefano, wakasafiri hata Foinike na Kipro na Antiokia, wasilihubiri lile neno ila kwa Wayahudi peke yao. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.19",
            "verseOrgIds": [
              "ACT.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini baadhi ya hao walikuwa watu wa Kipro na Kirene, nao walipofika Antiokia wakasema na Wayahudi wa Kiyunani, wakihubiri habari njema za Bwana Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.20",
            "verseOrgIds": [
              "ACT.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.47"
              },
              "items": [
                {
                  "text": "Mdo 2:47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mkono wa Bwana ukawa pamoja nao, watu wengi wakaamini, wakamwelekea Bwana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.21",
            "verseOrgIds": [
              "ACT.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.4.36"
              },
              "items": [
                {
                  "text": "Mdo 4:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Habari hizo za watu hao zikafika masikioni mwa kanisa lililokuwako katika Yerusalemu; wakamtuma Barnaba, aende hata Antiokia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.22",
            "verseOrgIds": [
              "ACT.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.43"
              },
              "items": [
                {
                  "text": "Mdo 13:43",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye, alipokwisha kufika na kuiona neema ya Mungu akafurahi, akawasihi wote waambatane na Bwana kwa kusudi la moyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.23",
            "verseOrgIds": [
              "ACT.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
