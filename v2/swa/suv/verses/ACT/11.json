            "sid": "ACT 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi mitume na ndugu waliokuwako katika Uyahudi wakapata habari ya kwamba watu wa Mataifa nao wamelipokea neno la Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.1",
            "verseOrgIds": [
              "ACT.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.45"
              },
              "items": [
                {
                  "text": "Mdo 10:45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na Petro alipopanda kwenda Yerusalemu, wale walio wa tohara wakashindana naye, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.2",
            "verseOrgIds": [
              "ACT.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.12"
              },
              "items": [
                {
                  "text": "Gal 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.11"
              },
              "items": [
                {
                  "text": "Efe 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakisema, Uliingia kwa watu wasiotahiriwa ukala nao. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.3",
            "verseOrgIds": [
              "ACT.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akaanza kuwaeleza kwa taratibu, akasema,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.4",
            "verseOrgIds": [
              "ACT.11.4"
            ]
          }
        }
      ]
    },
    {
