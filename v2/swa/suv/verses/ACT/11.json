        "style": "s1"
      },
      "items": [
        {
          "text": "Ripoti ya Petro kwa Kanisa katika Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
