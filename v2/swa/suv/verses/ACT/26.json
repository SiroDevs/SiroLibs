                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini inuka, usimame kwa miguu yako, maana nimekutokea kwa sababu hii, nikuweke wewe uwe mtumishi na shahidi wa mambo haya uliyoyaona, na wa mambo ambayo katika hayo nitajidhihirisha kwako; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.16",
            "verseOrgIds": [
              "ACT.26.16"
            ]
          }
        },
        {
