                {
                  "text": "1 Nya 16:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nikikuokoa na watu wako, na watu wa Mataifa, ambao nakutuma kwao; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.17",
            "verseOrgIds": [
              "ACT.26.17"
