                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu ya hayo Wayahudi wakanikamata ndani ya hekalu wakajaribu kuniua. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.21",
            "verseOrgIds": [
              "ACT.26.21"
            ]
