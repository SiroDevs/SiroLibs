              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme na liwali na Bernike na wale walioketi pamoja nao wakasimama; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.30",
            "verseOrgIds": [
              "ACT.26.30"
            ]
          }
        },
        {
