              "items": [
                {
                  "text": "Mdo 25:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agripa akamwambia Festo, Mtu huyo angeweza kufunguliwa, kama asingalitaka rufani kwa Kaisari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.32",
