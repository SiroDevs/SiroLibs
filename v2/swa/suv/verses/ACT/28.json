          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na walipokuwa hawapatani wao kwa wao, wakaenda zao, Paulo alipokwisha kusema neno hili moja, ya kwamba, Roho Mtakatifu alinena vema na baba zetu, kwa kinywa cha nabii Isaya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.25",
            "verseOrgIds": [
