              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi siku moja iliyoazimiwa, Herode akajivika mavazi ya kifalme, akaketi katika kiti cha enzi, akatoa hotuba mbele yao. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.21",
            "verseOrgIds": [
