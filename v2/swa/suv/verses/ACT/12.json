                "loc": "ACT.5.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hata kulipopambauka askari wakaingiwa na fadhaa nyingi, amekuwaje Petro. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.18",
            "verseOrgIds": [
              "ACT.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Herode alipomtafuta, asimwone, aliwauliza-uliza wale walinzi, akaamuru wauawe. Kisha akatelemkia kutoka Uyahudi kwenda Kaisaria, akakaa huko.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.19",
            "verseOrgIds": [
              "ACT.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kifo cha Herode",
          "type": "text"
        }
      ]
    },
    {
