                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Watu wakapiga kelele, wakisema, Ni sauti ya Mungu, si sauti ya mwanadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.22",
            "verseOrgIds": [
