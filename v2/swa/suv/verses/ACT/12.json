                "loc": "JAS.5.16"
              },
              "items": [
                {
                  "text": "Yak 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Petro akalindwa gerezani, nalo kanisa likamwomba Mungu kwa juhudi kwa ajili yake.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.5",
            "verseOrgIds": [
              "ACT.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petro Akombolewa kutoka kwa Gereza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
