                "loc": "JER.5.24"
              },
              "items": [
                {
                  "text": "Yer 5:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini hakujiacha pasipo ushuhuda, kwa kuwa alitenda mema, akiwapeni mvua kutoka mbinguni, na nyakati za mavuno, akiwashibisha mioyo yenu chakula na furaha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.17",
            "verseOrgIds": [
              "ACT.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwa maneno hayo wakawazuia makutano kwa shida, wasiwatolee dhabihu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.18",
            "verseOrgIds": [
              "ACT.14.18"
            ]
          }
