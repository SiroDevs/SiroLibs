              },
              "items": [
                {
                  "text": "Mdo 14:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.3.11"
              },
              "items": [
                {
                  "text": "2 Tim 3:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hata palipotokea shambulio la watu wa Mataifa na Wayahudi pamoja na wakubwa wao juu yao, kuwatenda jeuri na kuwapiga kwa mawe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.5",
            "verseOrgIds": [
              "ACT.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
