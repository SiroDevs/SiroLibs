              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walakini mitume Barnaba na Paulo, walipopata habari, wakararua nguo zao, wakaenda mbio wakaingia katika makutano, wakipiga kelele, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.14",
            "verseOrgIds": [
              "ACT.14.14"
            ]
          }
        },
        {
