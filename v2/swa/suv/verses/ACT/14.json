                "loc": "MAT.10.23"
              },
              "items": [
                {
                  "text": "Mt 10:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wao wakapata habari wakakimbilia Listra na Derbe, miji ya Likaonia, na nchi zilizo kando kando; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.6",
            "verseOrgIds": [
              "ACT.14.6"
            ]
          }
        },
