                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na huko Listra palikuwa na mtu mmoja, dhaifu wa miguu, kiwete tangu tumboni mwa mamaye, ambaye hajaenda kabisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.8",
            "verseOrgIds": [
              "ACT.14.8"
            ]
          }
        },
        {
          "name": "verse",
