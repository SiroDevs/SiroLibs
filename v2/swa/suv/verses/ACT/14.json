                "loc": "ACT.17.30"
              },
              "items": [
                {
                  "text": "Mdo 17:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ambaye zamani zilizopita aliwaacha mataifa yote waende katika njia zao wenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.16",
            "verseOrgIds": [
              "ACT.14.16"
            ]
          }
        },
        {
