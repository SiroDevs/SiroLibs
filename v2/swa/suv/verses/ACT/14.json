              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa huko Ikonio wakaingia pamoja katika sinagogi la Wayahudi; na kwa vile walivyonena, kundi kubwa la Wayahudi na la Wayunani wakaamini. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.1",
            "verseOrgIds": [
              "ACT.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.45"
              },
              "items": [
                {
                  "text": "Mdo 13:45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Walakini Wayahudi wasioamini wakawataharakisha watu wa Mataifa na kuwatia nia mbaya juu ya ndugu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.2",
            "verseOrgIds": [
              "ACT.14.2"
            ]
          }
        }
      ]
