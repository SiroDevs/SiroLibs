        },
        {
          "text": "Basi wakakaa huko wakati mwingi, wakinena kwa ushujaa katika Bwana, aliyelishuhudia neno la neema yake, akiwajalia ishara na maajabu yatendeke kwa mikono yao. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.3",
            "verseOrgIds": [
              "ACT.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini jamii ya watu wa mjini wakafarakana; hawa walikuwa upande wa Wayahudi, na hawa upande wa Mitume. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.4",
            "verseOrgIds": [
              "ACT.14.4"
            ]
          }
        },
