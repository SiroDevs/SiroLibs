                }
              ]
            }
          ]
        },
        {
          "text": "Wakati ule mfalme Herode alisikia habari za Yesu, akawaambia watumishi wake, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.1",
            "verseOrgIds": [
              "MAT.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huyo ndiye Yohana Mbatizaji; amefufuka katika wafu; na kwa hiyo nguvu hizo zinatenda kazi ndani yake. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.2",
            "verseOrgIds": [
              "MAT.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.19+LUK.3.20"
              },
              "items": [
                {
                  "text": "Lk 3:19-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.2"
              },
              "items": [
                {
                  "text": "Mt 11:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana Herode alikuwa amemkamata Yohana, akamfunga, akamtia gerezani, kwa ajili ya Herodia, mke wa Filipo nduguye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.3",
            "verseOrgIds": [
              "MAT.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.16"
              },
              "items": [
                {
                  "text": "Law 18:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.21"
              },
              "items": [
                {
                  "text": "20:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu Yohana alimwambia, Si halali kwako kuwa naye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.4",
            "verseOrgIds": [
              "MAT.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.26"
              },
              "items": [
                {
                  "text": "Mt 21:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye alipotaka kumwua, aliwaogopa watu, maana walimwona Yohana kuwa nabii. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.5",
            "verseOrgIds": [
              "MAT.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata ilipofika sikukuu ya kuzaliwa kwake Herode, binti Herodia alicheza mbele ya watu, akampendeza Herode. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.6",
            "verseOrgIds": [
              "MAT.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata akaahidi kwa kiapo ya kwamba atampa lo lote atakaloliomba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.7",
            "verseOrgIds": [
              "MAT.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye, huku akichochewa na mamaye, akasema, Nipe hapa katika kombe kichwa cha Yohana Mbatizaji. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.8",
            "verseOrgIds": [
              "MAT.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mfalme akasikitika; lakini kwa ajili ya viapo vyake, na kwa ajili ya wale walioketi chakulani pamoja naye, akaamuru apewe; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.9",
            "verseOrgIds": [
              "MAT.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.12"
              },
              "items": [
                {
                  "text": "Mt 17:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akatuma mtu, akamkata kichwa Yohana mle gerezani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.10",
            "verseOrgIds": [
              "MAT.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichwa chake kikaletwa katika kombe, akapewa yule kijana; akakichukua kwa mamaye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.11",
            "verseOrgIds": [
              "MAT.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanafunzi wake wakaenda, wakamchukua yule maiti, wakamzika; kisha wakaenda wakampasha Yesu habari.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.12",
            "verseOrgIds": [
              "MAT.14.12"
            ]
          }
        }
      ]
    },
    {
