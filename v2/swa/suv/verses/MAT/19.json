              "items": [
                {
                  "text": "Lk 10:26-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akamwambia Kwani kuniuliza habari ya wema? Aliye mwema ni mmoja. Lakini ukitaka kuingia katika uzima, zishike amri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.17",
            "verseOrgIds": [
              "MAT.19.17"
            ]
          }
        },
        {
