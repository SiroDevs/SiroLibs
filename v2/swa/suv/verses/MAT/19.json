        },
        {
          "text": "Ndipo Petro akajibu, akamwambia, Tazama, sisi tumeacha vyote tukakufuata; tutapata nini basi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.27",
            "verseOrgIds": [
              "MAT.19.27"
            ]
          }
        },
