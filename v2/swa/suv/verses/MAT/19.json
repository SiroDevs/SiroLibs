                }
              ]
            }
          ]
        },
        {
          "text": "Ikawa Yesu alipomaliza maneno hayo, akatoka Galilaya akafika mipaka ya Uyahudi, ng’ambo ya Yordani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.1",
            "verseOrgIds": [
              "MAT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
