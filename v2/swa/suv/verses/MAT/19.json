                  "text": "Zab 62:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yule kijana alipolisikia neno lile, akaenda zake kwa huzuni; kwa sababu alikuwa na mali nyingi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
