                  "text": "Zek 8:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu akawakazia macho, akawaambia, Kwa wanadamu hilo haliwezekani; bali kwa Mungu yote yawezekana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.26",
