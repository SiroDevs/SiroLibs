            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.15+LUK.18.16+LUK.18.17"
              },
              "items": [
                {
                  "text": "Lk 18:15-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo akaletewa watoto wadogo ili aweke mikono yake juu yao na kuwaombea; wanafunzi wake wakawakemea. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.13",
            "verseOrgIds": [
              "MAT.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.2"
              },
              "items": [
                {
                  "text": "Mt 18:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini Yesu akasema, Waacheni watoto wadogo waje kwangu; wala msiwazuie; kwa maana walio mfano wa hao, ufalme wa mbinguni ni wao. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.14",
            "verseOrgIds": [
              "MAT.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaweka mikono yake juu yao, akatoka huko.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.15",
            "verseOrgIds": [
              "MAT.19.15"
            ]
          }
        }
      ]
    },
