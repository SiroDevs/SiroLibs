              "items": [
                {
                  "text": "Ebr 10:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na kila mtu aliyeacha nyumba, au ndugu wa kiume au wa kike, au baba, au mama, au watoto, au mashamba, kwa ajili ya jina langu, atapokea mara mia, na kuurithi uzima wa milele. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.29",
            "verseOrgIds": [
              "MAT.19.29"
            ]
          }
        },
        {
