        {
          "text": "Na tazama, mtu mmoja akamwendea akamwambia, Mwalimu, nitende jambo gani jema, ili nipate uzima wa milele? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.16",
            "verseOrgIds": [
              "MAT.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
