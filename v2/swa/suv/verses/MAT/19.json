          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.20"
              },
              "items": [
                {
                  "text": "Mt 6:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.33"
              },
              "items": [
                {
                  "text": "Lk 12:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu akamwambia, Ukitaka kuwa mkamilifu, enenda ukauze ulivyo navyo, uwape maskini, nawe utakuwa na hazina mbinguni; kisha njoo unifuate. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.21",
            "verseOrgIds": [
              "MAT.19.21"
            ]
          }
        },
        {
