                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akamwambia, Zipi? Yesu akasema, Ni hizi, Usiue, Usizini, Usiibe, Usishuhudie uongo, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.18",
            "verseOrgIds": [
