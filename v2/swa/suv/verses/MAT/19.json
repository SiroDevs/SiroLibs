                {
                  "text": "Law 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waheshimu baba yako na mama yako, na, Mpende jirani yako kama nafsi yako. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.19",
            "verseOrgIds": [
              "MAT.19.19"
            ]
          }
        },
        {
