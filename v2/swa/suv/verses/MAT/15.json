                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akaondoka huko, akafika kando ya bahari ya Galilaya; akapanda mlimani, akaketi huko. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.29",
            "verseOrgIds": [
              "MAT.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamwendea makutano mengi wakimletea viwete, vipofu, mabubu, vilema, na wengine wengi, wakawaweka miguuni pake; akawaponya; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.30",
            "verseOrgIds": [
              "MAT.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.37"
              },
              "items": [
                {
                  "text": "Mk 7:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "hata ule mkutano wakastaajabu, walipowaona mabubu wanasema, vilema wanakuwa wazima, viwete wanakwenda, na vipofu wanaona; wakamtukuza Mungu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.31",
            "verseOrgIds": [
              "MAT.15.31"
            ]
          }
        }
      ]
