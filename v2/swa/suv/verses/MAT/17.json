                {
                  "text": "2 Pet 1:17-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na baada ya siku sita Yesu akawatwaa Petro, na Yakobo, na Yohana nduguye, akawaleta juu ya mlima mrefu faraghani; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.1",
            "verseOrgIds": [
              "MAT.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.1.16+2PE.1.17+2PE.1.18"
              },
              "items": [
                {
                  "text": "2 Pet 1:16-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akageuka sura yake mbele yao; uso wake ukang’aa kama jua, mavazi yake yakawa meupe kama nuru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.2",
            "verseOrgIds": [
              "MAT.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tazama, wakatokewa na Musa na Eliya, wakizungumza naye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.3",
            "verseOrgIds": [
              "MAT.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akajibu akamwambia Yesu, Bwana, ni vizuri sisi kuwapo hapa; ukitaka, nitafanya hapa vibanda vitatu, kimoja chako wewe, na kimoja cha Musa, na kimoja cha Eliya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.4",
            "verseOrgIds": [
              "MAT.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.2"
              },
              "items": [
                {
                  "text": "Mwa 22:2",
                  "type": "text"
                }
              ]
            },
            {
