              "items": [
                {
                  "text": "Mk 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.22"
              },
              "items": [
                {
                  "text": "Lk 3:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alipokuwa katika kusema, tazama, wingu jeupe likawatia uvuli; na tazama, sauti ikatoka katika lile wingu, ikasema, Huyu ni Mwanangu, mpendwa wangu, ninayependezwa naye; msikieni yeye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.5",
            "verseOrgIds": [
              "MAT.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wale wanafunzi waliposikia, walianguka kifulifuli, wakaogopa sana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.6",
            "verseOrgIds": [
              "MAT.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akaja, akawagusa, akasema, Inukeni, wala msiogope. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.7",
            "verseOrgIds": [
              "MAT.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakainua macho yao, wasione mtu ila Yesu peke yake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.8",
            "verseOrgIds": [
              "MAT.17.8"
            ]
          }
        }
      ]
    },
