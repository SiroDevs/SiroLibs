              "text": "17:27",
              "type": "text"
            },
            {
              "text": "Shekeli moja ni kama shilingi 3.",
              "type": "text"
            }
          ]
        },
        {
          "text": "; ichukue hiyo ukawape kwa ajili yangu na kwa ajili yako.",
