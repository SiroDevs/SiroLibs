                  "text": "Lk 18:31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hata Yesu alipokuwa akipanda kwenda Yerusalemu, aliwachukua wale wanafunzi kumi na wawili faraghani; na njiani akawaambia, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.17",
            "verseOrgIds": [
              "MAT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.21"
              },
              "items": [
                {
                  "text": "Mt 16:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.22"
              },
              "items": [
                {
                  "text": "17:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Angalieni, tunapanda kwenda Yerusalemu; na Mwana wa Adamu atatiwa mikononi mwa wakuu wa makuhani na waandishi; nao watamhukumu afe; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.18",
            "verseOrgIds": [
              "MAT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kisha watampeleka kwa Mataifa wapate kumdhihaki, na kumpiga mijeledi, na kumsulibisha; na siku ya tatu atafufuka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.19",
            "verseOrgIds": [
              "MAT.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ombi la Mama wa Yakobo na Yohana",
          "type": "text"
        }
      ]
    },
