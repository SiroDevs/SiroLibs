              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mama yao wana wa Zebedayo akamwendea pamoja na wanawe, akamsujudia, na kumwomba neno. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.20",
            "verseOrgIds": [
              "MAT.20.20"
            ]
          }
        },
