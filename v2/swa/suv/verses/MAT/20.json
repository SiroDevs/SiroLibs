                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu akajibu akasema, Hamjui mnaloliomba. Je! Mwaweza kunywea kikombe nitakachonywea mimi? Wakamwambia, Twaweza. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        },
        {
