            "number": "4",
            "style": "v",
            "sid": "EZK 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "vikusanye vipande vyake ndani yake, naam, kila kipande chema, paja na bega; lijaze mifupa iliyochaguliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.4",
            "verseOrgIds": [
              "EZK.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwatwae wateule wa kundi la kondoo, ukafanye chungu ya mifupa chini yake; ukalitokose sana; naam, mifupa yake itokoswe ndani yake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.5",
            "verseOrgIds": [
              "EZK.24.5"
            ]
          }
        }
