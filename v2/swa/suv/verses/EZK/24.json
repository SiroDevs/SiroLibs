                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Bwana MUNGU asema hivi; Ole wake mji wa damu! Hilo sufuria ambalo kutu yake i ndani yake, ambalo kutu yake haikulitoka; litoe kipande kipande; hapana kura iliyoanguka juu yake. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
