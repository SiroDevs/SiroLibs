              "items": [
                {
                  "text": "Kum 12:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana damu yake imo ndani yake; aliiweka juu ya jabali lililo wazi; hakuimwaga juu ya nchi, apate kuifunika kwa mavumbi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.7",
            "verseOrgIds": [
              "EZK.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 24:8"
          },
          "items": [
