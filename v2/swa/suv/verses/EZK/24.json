                "loc": "EZK.8.18"
              },
              "items": [
                {
                  "text": "8:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Katika uchafu wako mna uasherati, kwa maana nimekusafisha, ila wewe hukusafika; hutasafishwa tena uchafu wako ukutoke, hata nitakapokuwa nimeituliza hasira yangu kwako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.13",
            "verseOrgIds": [
              "EZK.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 24:14"
