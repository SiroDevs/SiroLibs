              "type": "tag",
              "attrs": {
                "loc": "MAT.7.2"
              },
              "items": [
                {
                  "text": "Mt 7:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ili ipandishe ghadhabu ya kulipa kisasi, nimeiweka damu yake juu ya jabali lililo wazi, isipate kufunikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.8",
            "verseOrgIds": [
              "EZK.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 24:9"
          },
          "items": [
