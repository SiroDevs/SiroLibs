            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.5.11"
              },
              "items": [
                {
                  "text": "Eze 5:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mimi, BWANA, nimenena neno hili, nalo litakuwa; nami nitalifanya; sitaachilia, wala sitahurumia, wala sitajuta; sawasawa na njia zako, na sawasawa na matendo yako, ndivyo watakavyokuhukumu, asema Bwana MUNGU.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        }
      ]
    },
