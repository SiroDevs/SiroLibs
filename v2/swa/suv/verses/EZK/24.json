              "type": "tag",
              "attrs": {
                "loc": "HAB.2.12"
              },
              "items": [
                {
                  "text": "Hab 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Bwana MUNGU asema hivi; Ole wake mji wa damu! Mimi nami nitaiongeza chungu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.9",
            "verseOrgIds": [
              "EZK.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tia kuni nyingi, uchochee moto, itokose nyama sana, fanyiza mchuzi mzito, mifupa ikateketee. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.22.15"
              },
              "items": [
                {
                  "text": "Eze 22:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha litie juu ya makaa yake, tupu, lipate moto, na shaba yake iteketee, uchafu wake uyeyushwe, na kutu yake iteketee. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amejidhoofisha kwa taabu, lakini kutu yake nyingi haikumtoka; kutu yake haitoki kwa moto. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 24:13"
