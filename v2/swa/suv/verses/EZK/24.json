                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ukawatungie mithali nyumba ya kuasi, ukawaambie, Bwana MUNGU asema hivi; Teleka sufuria, liteleke; ukatie maji ndani yake; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.3",
            "verseOrgIds": [
              "EZK.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
