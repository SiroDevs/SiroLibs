          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno la BWANA likanijia tena, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.15",
            "verseOrgIds": [
              "EZK.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanadamu, tazama, ninakuondolea kwa pigo moja tunu, mteule wa macho yako; walakini hutaomboleza wala kulia, wala yasichuruzike machozi yako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.16",
            "verseOrgIds": [
              "EZK.24.16"
            ]
          }
