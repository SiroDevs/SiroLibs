              "items": [
                {
                  "text": "Yer 51:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.4.2"
              },
              "items": [
                {
                  "text": "Eze 4:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Katika mkono wake wa kuume alikuwa na kura ya Yerusalemu, kuviweka vyombo vya kubomolea, kufumbua kinywa katika machinjo, kuiinua sauti kwa kupiga kelele sana, kuweka vyombo vya kubomolea juu ya malango, kufanya maboma, na kujenga ngome. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.22",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
