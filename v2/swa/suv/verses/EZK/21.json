              "type": "text"
            }
          ]
        },
        {
          "text": "Neno la BWANA likanijia tena, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.18",
            "verseOrgIds": [
              "EZK.21.18"
            ]
          }
        },
