            }
          ]
        },
        {
          "text": "Nawe, mwanadamu, tabiri useme, Bwana MUNGU asema hivi, katika habari za wana wa Amoni, na katika habari za aibu yao; Nena, Upanga; upanga umefutwa; umesuguliwa, ili kuua, ili kuufanya uue sana, upate kuwa kama umeme; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
