            "sid": "EZK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena, mwanadamu, ujiwekee njia mbili, upanga wa mfalme wa Babeli upate kuja; hizo mbili zitatoka katika nchi moja; ukaandike mahali, upaandike penye kichwa cha njia iendayo mjini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.19",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        },
