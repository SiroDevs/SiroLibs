                {
                  "text": "Mwa 13:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wewe, Ewe mtu mwovu, uliyetiwa jeraha kiasi cha kukuua, mkuu wa Israeli, ambaye siku yako imekuja, katika wakati wa uovu wa mwisho; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.25",
            "verseOrgIds": [
              "EZK.21.25"
            ]
          }
        },
