              "items": [
                {
                  "text": "Kum 28:63",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.24"
              },
              "items": [
                {
                  "text": "Isa 1:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mimi nami nitapiga makofi, mimi nami nitashibisha ghadhabu yangu; mimi, BWANA, nimenena neno hili.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.17"
            ]
          }
        }
      ]
    },
