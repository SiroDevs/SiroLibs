              "items": [
                {
                  "text": "Eze 17:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jambo hili litakuwa kwao kama uganga wa ubatili, mbele ya macho yao waliowaapia viapo lakini ataufanya uovu ukumbukwe, ili kwamba wakamatwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.23",
            "verseOrgIds": [
              "EZK.21.23"
            ]
          }
        }
