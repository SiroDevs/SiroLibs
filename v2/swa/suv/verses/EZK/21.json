                "loc": "1PE.4.17"
              },
              "items": [
                {
                  "text": "1 Pet 4:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwanadamu, uelekeze uso wako kuelekea Yerusalemu, ukadondoze neno lako upande wa mahali patakatifu, ukatabiri juu ya nchi ya Israeli; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.2",
            "verseOrgIds": [
              "EZK.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.9.22"
              },
              "items": [
                {
                  "text": "Ayu 9:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "uiambie nchi ya Israeli, BWANA asema hivi; Tazama, mimi ni juu yako, nami nitautoa upanga wangu alani, nami nitamkatilia mbali nawe mtu mwenye haki na mtu mbaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.3",
            "verseOrgIds": [
              "EZK.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.47"
              },
              "items": [
                {
                  "text": "Eze 20:47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi, kwa kuwa nitamkatilia mbali nawe mtu mwenye haki na mtu mbaya, upanga wangu utatoka alani mwake, uwe juu ya watu wote wenye mwili toka kusini hata kaskazini, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.4",
            "verseOrgIds": [
              "EZK.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.45.23"
              },
              "items": [
                {
                  "text": "Isa 45:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na watu wote wenye mwili watajua ya kuwa mimi, BWANA, nimeufuta upanga wangu alani mwake; hautarudi tena. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.5",
            "verseOrgIds": [
              "EZK.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.4"
              },
              "items": [
                {
                  "text": "Isa 22:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ugua, basi, Ee mwanadamu; kwa kuvunjika kwake viuno vyako, na kwa uchungu, utaugua mbele ya macho yao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.6",
            "verseOrgIds": [
              "EZK.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na itakuwa, wakuambiapo, Mbona unaugua? Ndipo utakaposema, Kwa sababu ya habari hizo, maana linakuja; na kila moyo utayeyuka, na mikono yote itakuwa dhaifu, na kila roho itazimia, na magoti yote yatalegea kama maji; tazama, linakuja, nalo litatendeka, asema Bwana MUNGU.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.7",
            "verseOrgIds": [
              "EZK.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
