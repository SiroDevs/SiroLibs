                  "text": "Lk 1:52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bwana MUNGU asema hivi; Kiondoe kilemba, ivue taji; haya hayatakuwa tena kama yalivyo; kikweze kilicho chini, kakishushe kilichoinuka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.26",
