              "type": "text"
            }
          ]
        },
        {
          "text": "Neno la BWANA likanijia, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.8",
            "verseOrgIds": [
              "EZK.21.8"
            ]
