                  "text": "Hes 28:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nawe utatengeneza mwana-kondoo wa mwaka wa kwanza, mkamilifu, kuwa sadaka ya kuteketezwa kwa BWANA kila siku; kila siku asubuhi utamtengeneza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.13",
            "verseOrgIds": [
              "EZK.46.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 46:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe utatengeneza sadaka ya unga pamoja nayo kila siku asubuhi, sehemu ya sita ya efa moja, na sehemu ya tatu ya hini moja ya mafuta; kuchanganya na unga ule mzuri; sadaka ya unga kwa BWANA daima, kwa amri ya milele. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.14",
            "verseOrgIds": [
              "EZK.46.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo ndivyo watakavyomtengeneza mwana-kondoo, na sadaka ya unga, na mafuta, kila siku asubuhi, kuwa sadaka ya kuteketezwa ya daima.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.15",
            "verseOrgIds": [
              "EZK.46.15"
            ]
          }
        }
      ]
