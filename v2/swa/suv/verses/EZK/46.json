              "items": [
                {
                  "text": "Eze 44:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.10"
              },
              "items": [
                {
                  "text": "Mt 25:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye mkuu ataingia kwa njia ya ukumbi wa lango lile, upande wa nje, naye atasimama karibu na mwimo wa lango, nao makuhani wataitengeneza sadaka yake ya kuteketezwa, na sadaka zake za amani, naye ataabudu penye kizingiti cha lango; kisha atatoka; lakini lango lile halitafungwa hata wakati wa jioni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.2",
            "verseOrgIds": [
              "EZK.46.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 46:3"
