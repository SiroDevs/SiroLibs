          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena palikuwa na safu ndani yake pande zote, kuvizunguka vile viwanja vinne; tena palifanywa meko ya kutokosea, chini ya safu pande zote. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.23",
