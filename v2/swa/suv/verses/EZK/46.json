        },
        {
          "text": "Bwana MUNGU asema hivi; Lango la ua wa ndani, lielekealo upande wa mashariki litafungwa siku sita za kazi; lakini siku ya sabato litafunguliwa, na siku ya mwezi mpya litafunguliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.1",
            "verseOrgIds": [
              "EZK.46.1"
            ]
          }
        },
