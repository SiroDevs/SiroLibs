              },
              "items": [
                {
                  "text": "Lk 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Watu wa nchi nao wataabudu mbele ya mlango wa lile lango mbele za BWANA, siku za sabato, na siku za mwezi mpya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.3",
            "verseOrgIds": [
              "EZK.46.3"
            ]
          }
        },
