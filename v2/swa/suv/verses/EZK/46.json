              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana MUNGU asema hivi; Mkuu akimpa mwanawe awaye yote zawadi, ni urithi wake, itakuwa mali ya wanawe; ni milki yao kwa kurithiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.16",
