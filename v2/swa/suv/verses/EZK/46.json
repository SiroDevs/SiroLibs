            }
          ]
        },
        {
          "text": "Akaniambia, Hapa ndipo mahali pa makuhani, watakapoitokosa sadaka ya hatia, na sadaka ya dhambi, watakapoioka sadaka ya unga; kusudi wasizilete nje katika ua wa nje, na kuwatakasa watu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.20",
            "verseOrgIds": [
              "EZK.46.20"
            ]
          }
        },
