              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa visiwa vitatetemeka katika siku ya kuanguka kwako; naam, visiwa vilivyo katika bahari vitafadhaika, kwa sababu ya kuondoka kwako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.18",
            "verseOrgIds": [
              "EZK.26.18"
            ]
          }
        },
        {
          "name": "verse",
