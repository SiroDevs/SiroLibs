              "items": [
                {
                  "text": "Ufu 18:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitaikomesha sauti ya nyimbo zako, wala sauti ya vinubi vyako haitasikiwa tena. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.13",
            "verseOrgIds": [
              "EZK.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitakufanya kuwa jabali tupu; utakuwa mahali pa kutandazia nyavu za wavuvi; hutajengwa tena; maana mimi, BWANA, nimenena neno hili, asema Bwana MUNGU.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
              "EZK.26.14"
            ]
          }
        }
      ]
