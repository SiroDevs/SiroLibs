                }
              ]
            }
          ]
        },
        {
          "text": "Nao watakufanyia maombolezo, na kukuambia, Imekuwaje wewe kuharibika, wewe uliyekaliwa na wana-maji, mji wenye sifa, uliyekuwa na nguvu katika bahari, mji huo, na hao waliokaa ndani yake, waliowatia hofu wote waliokaa ndani yake! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.17",
            "verseOrgIds": [
              "EZK.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
