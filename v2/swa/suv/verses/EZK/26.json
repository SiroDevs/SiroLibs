              "items": [
                {
                  "text": "Isa 37:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.25.5"
              },
              "items": [
                {
                  "text": "Eze 25:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na binti zake walio katika mashamba watauawa kwa upanga; nao watajua ya kuwa mimi ndimi BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.6",
            "verseOrgIds": [
              "EZK.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.7.12"
              },
              "items": [
                {
                  "text": "Ezr 7:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.37"
              },
              "items": [
                {
                  "text": "Dan 2:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana Bwana MUNGU asema hivi; Tazama, nitamleta Nebukadreza, mfalme wa Babeli, mfalme wa wafalme, juu ya Tiro toka kaskazini, pamoja na farasi, na magari ya vita, na wapanda farasi, na jeshi, na watu wengi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.7",
            "verseOrgIds": [
              "EZK.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.20.15"
              },
              "items": [
                {
                  "text": "2 Sam 20:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.4"
              },
              "items": [
                {
                  "text": "Yer 52:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.21.22"
              },
              "items": [
                {
                  "text": "Eze 21:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atawaua binti zako kwa upanga katika mashamba; naye atafanya ngome juu yako, na kufanya maboma juu yako, na kuiinua ngao juu yako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.8",
            "verseOrgIds": [
              "EZK.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ataweka vyombo vyake vya kubomolea mbele za kuta zako, na kwa mashoka yake ataiangusha chini minara yako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.9",
            "verseOrgIds": [
              "EZK.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu wingi wa farasi zake, mavumbi yao yatakufunika; kuta zako zitatetemeka kwa sababu ya mshindo wa wapanda farasi, na wa magurudumu, na wa magari ya vita, atakapoingia katika malango yako, kama watu waingiavyo katika mji uliobomolewa mahali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.10",
            "verseOrgIds": [
              "EZK.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kwato za farasi zake atazikanyaga njia zako zote; atawaua watu wako kwa upanga, na minara ya nguvu zako itashuka hata nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.11",
            "verseOrgIds": [
              "EZK.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao wataufanya utajiri wako kuwa mateka, na bidhaa yako kuwa mawindo; nao watazibomoa kuta zako, na kuziharibu nyumba zako zipendezazo; nao wataweka mawe yako, na miti yako, na mavumbi yako, kati ya maji. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.12",
            "verseOrgIds": [
              "EZK.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
