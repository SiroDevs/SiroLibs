            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.9.16"
              },
              "items": [
                {
                  "text": "Zab 9:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na mkono wangu utakuwa juu ya manabii wanaoona ubatili, na kutabiri uongo; hawatakuwa katika mashauri ya watu wangu, wala hawataandikwa katika maandiko ya nyumba ya Israeli, wala hawataingia katika nchi ya Israeli; nanyi mtajua ya kuwa mimi ndimi Bwana MUNGU. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.9",
            "verseOrgIds": [
              "EZK.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 13:10"
          },
          "items": [
