          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.14.14"
              },
              "items": [
                {
                  "text": "Yer 14:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwanadamu, tabiri juu ya manabii wa Israeli wanaotabiri, uwaambie wanaotabiri kwa mioyo yao wenyewe, Lisikieni neno la BWANA; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.2",
            "verseOrgIds": [
              "EZK.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana MUNGU asema hivi; Ole wao manabii wajinga, wanaoifuata roho yao wenyewe, wala hawakuona neno lo lote! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.3",
            "verseOrgIds": [
              "EZK.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.5"
              },
              "items": [
                {
                  "text": "Mik 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SNG.2.15"
