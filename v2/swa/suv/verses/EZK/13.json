                "loc": "EZK.22.30"
              },
              "items": [
                {
                  "text": "Eze 22:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hamkupanda kwenda mahali palipobomolewa, wala hamkuitengenezea nyumba ya Israeli boma, wapate kusimama vitani katika siku ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.5",
            "verseOrgIds": [
              "EZK.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.24"
              },
              "items": [
                {
                  "text": "Eze 12:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.14.15"
              },
              "items": [
                {
                  "text": "Mit 14:15",
                  "type": "text"
                }
              ]
