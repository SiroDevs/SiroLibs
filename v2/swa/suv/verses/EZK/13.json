              },
              "items": [
                {
                  "text": "Zab 106:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.30"
              },
              "items": [
                {
                  "text": "30",
