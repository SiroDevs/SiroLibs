        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.7",
            "verseOrgIds": [
              "EZK.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi tazama, Bwana MUNGU asema hivi; Kwa sababu mmenena ubatili, na kuona uongo, basi, kwa sababu hiyo, mimi ni juu yenu, asema Bwana MUNGU. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.8",
            "verseOrgIds": [
              "EZK.13.8"
            ]
          }
        },
        {
          "name": "verse",
