              "attrs": {
                "loc": "2CO.11.13"
              },
              "items": [
                {
                  "text": "2 Kor 11:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ee Israeli, manabii wako wamekuwa kama mbweha, mahali palipo ukiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.4",
            "verseOrgIds": [
              "EZK.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
