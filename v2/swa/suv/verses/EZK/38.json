              "EZK.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana MUNGU asema hivi; Je! Wewe ndiwe niliyemnena zamani za kale, kwa vinywa vya watumishi wangu, manabii wa Israeli, waliotabiri siku zile kwa muda wa miaka mingi, ya kwamba nitakuleta upigane nao? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.17",
            "verseOrgIds": [
              "EZK.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itakuwa katika siku hiyo, Gogu atakapokuja kupigana na nchi ya Israeli, asema Bwana MUNGU, ghadhabu yangu itapanda katika mianzi ya pua yangu. ",
