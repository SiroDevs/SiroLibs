            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, mwanadamu, tabiri, umwambie Gogu, Bwana MUNGU asema hivi; Katika siku ile watu wangu, Israeli, watakapokaa salama, hutapata habari? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.14",
            "verseOrgIds": [
              "EZK.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
