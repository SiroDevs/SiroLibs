            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.19.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sheba, na Dedani, na wafanya biashara wa Tarshishi, pamoja na wana-simba wake wote, watakuambia, Je! Umekuja kuteka mateka? Umekusanya jeshi lako, ili kuwinda mawindo? Kuchukua fedha na dhahabu, kuchukua ng’ombe na mali, kuteka mateka mengi sana?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.13",
            "verseOrgIds": [
              "EZK.38.13"
            ]
          }
        }
