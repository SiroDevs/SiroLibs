                  "text": "Eze 27:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.19.3"
              },
              "items": [
                {
                  "text": "19:3",
                  "type": "text"
                }
