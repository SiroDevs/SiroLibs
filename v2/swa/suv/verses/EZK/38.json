                "loc": "GEN.10.2"
              },
              "items": [
                {
                  "text": "Mwa 10:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.14"
              },
              "items": [
                {
                  "text": "Eze 27:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gomeri, na vikosi vyake vyote; nyumba ya Togarma, pande za mwisho za kaskazini, na vikosi vyake vyote; naam, watu wengi pamoja nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.6",
            "verseOrgIds": [
              "EZK.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.9"
              },
              "items": [
                {
                  "text": "Isa 8:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ujiweke tayari, naam, jiweke tayari, wewe na majeshi yako yote waliokukusanyikia, nawe uwe jemadari wao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.7",
            "verseOrgIds": [
              "EZK.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
