              },
              "items": [
                {
                  "text": "Ufu 20:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwanadamu, kaza uso wako, umwelekee Gogu, wa nchi ya Magogu, mkuu wa Roshi, Mesheki, na Tubali, ukatabiri juu yake, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.2",
            "verseOrgIds": [
              "EZK.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "useme, Bwana MUNGU asema hivi; Tazama, mimi ni juu yako, Ewe Gogu, mkuu wa Roshi, na Mesheki, na Tubali; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.3",
            "verseOrgIds": [
              "EZK.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.4"
              },
              "items": [
                {
                  "text": "Eze 29:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.23.12"
              },
              "items": [
                {
                  "text": "23:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nami nitakugeuza na kutia kulabu katika mataya yako, nami nitakutoa, pamoja na jeshi lako lote, farasi na hao wapandao farasi, wote wamevaa silaha za namna zote, jeshi kubwa sana, wenye ngao na kigao, wote wakishika upanga; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.4",
            "verseOrgIds": [
              "EZK.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uajemi, na Kushi, na Putu, pamoja nao; wote wana ngao na chapeo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.5",
            "verseOrgIds": [
              "EZK.38.5"
            ]
          }
        },
