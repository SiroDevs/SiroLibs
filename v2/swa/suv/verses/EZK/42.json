              "items": [
                {
                  "text": "Eze 44:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Makuhani watakapoingia ndani, hawatatoka mahali patakatifu kwenda hata ua wa nje; lakini wataweka mavazi yao katika mahali wahudumiapo; maana ni matakatifu; nao watavaa mavazi mengine, na kupakaribia mahali palipo mahali pa watu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
