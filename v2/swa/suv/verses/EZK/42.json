              "items": [
                {
                  "text": "24:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.2.3"
              },
              "items": [
                {
                  "text": "2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha akaniambia, Vyumba vya upande wa kaskazini, na vyumba vya upande wa kusini, ambavyo vyaelekea mahali palipotengeka, ni vyumba vitakatifu; humo makuhani, wamkaribiao BWANA, watakula vitu vilivyo vitakatifu sana; humo wataviweka vitu vilivyo vitakatifu sana, na sadaka ya unga, na sadaka ya dhambi, na sadaka ya hatia; kwa maana mahali hapo ni patakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.13",
            "verseOrgIds": [
              "EZK.42.13"
            ]
          }
        },
        {
