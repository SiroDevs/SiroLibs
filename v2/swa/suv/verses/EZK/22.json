        },
        {
          "text": "Ndani yako wamedharau baba na mama; kati yako wamewatenda wageni udhalimu; ndani yako wamewaonea yatima na mjane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.7",
            "verseOrgIds": [
              "EZK.22.7"
            ]
          }
        },
        {
          "name": "verse",
