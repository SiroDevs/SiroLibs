                  "text": "Sef 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tazama, wakuu wa Israeli, kila mmoja kwa kadiri ya nguvu zake, wamekuwamo ndani yako, ili kumwaga damu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.6",
            "verseOrgIds": [
              "EZK.22.6"
            ]
          }
        },
        {
