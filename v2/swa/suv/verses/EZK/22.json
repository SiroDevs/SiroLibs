                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi, tazama, nimeipigia kofi hiyo faida uliyopata kwa njia isiyo haki, na hiyo damu yako iliyokuwa kati yako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.13",
