              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.27"
              },
              "items": [
                {
                  "text": "Kum 4:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nitakutawanya kati ya mataifa, na kukutapanya kati ya nchi mbalimbali; nami nitauteketeza uchafu wako, ili ukutoke. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.15",
            "verseOrgIds": [
              "EZK.22.15"
