        },
        {
          "text": "Ndani yako wamepokea rushwa ili kumwaga damu; umepokea riba na faida; nawe kwa choyo umepata mapato kwa kuwadhulumu jirani zako, nawe umenisahau mimi, asema Bwana MUNGU. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.12",
            "verseOrgIds": [
              "EZK.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
