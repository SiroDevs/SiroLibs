              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.2"
              },
              "items": [
                {
                  "text": "26:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umevidharau vitu vyangu vitakatifu, umezitia unajisi sabato zangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.8",
            "verseOrgIds": [
              "EZK.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasingiziaji wamekuwamo ndani yako, ili kumwaga damu; na ndani yako wamekula juu ya milima; kati yako wamefanya uasherati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.9",
            "verseOrgIds": [
              "EZK.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 22:10"
