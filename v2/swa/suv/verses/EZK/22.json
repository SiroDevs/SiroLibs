              },
              "items": [
                {
                  "text": "Eze 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na manabii wake wamewapakia chokaa isiyokorogwa vema, wakiona ubatili, na kuwatabiria maneno ya uongo, wakisema, Bwana MUNGU asema hivi; iwapo BWANA hakusema neno. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.28",
            "verseOrgIds": [
              "EZK.22.28"
            ]
          }
        },
