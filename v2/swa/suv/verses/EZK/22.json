        {
          "text": "Umekuwa na hatia katika damu yako uliyomwaga, nawe umekuwa na unajisi kwa vinyago vyako ulivyovifanya; nawe umezileta karibu siku zako, nawe umefika karibu na miaka yako; basi, kwa sababu ya hayo, nimekufanya kuwa lawama kwa mataifa, na kuwa dhihaka katika nchi zote. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.4",
            "verseOrgIds": [
              "EZK.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zilizo karibu, na zilizo mbali nawe, zitakudhihaki, Ewe mchafu, uliyejaa fujo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.5",
            "verseOrgIds": [
              "EZK.22.5"
            ]
          }
        },
        {
          "name": "verse",
