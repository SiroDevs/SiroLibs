              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanadamu, uiambie nchi, Wewe u nchi isiyosafika, wala kunyeshewa mvua siku ya ghadhabu. ",
          "type": "text",
          "attrs": {
