              "items": [
                {
                  "text": "Yer 5:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Watu wa nchi wametumia udhalimu, wamenyang’anya kwa nguvu; naam, wamewatenda jeuri maskini na wahitaji, nao wamewaonea wageni bila haki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.29",
            "verseOrgIds": [
              "EZK.22.29"
            ]
          }
        },
