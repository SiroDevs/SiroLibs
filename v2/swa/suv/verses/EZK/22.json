                {
                  "text": "1 Kor 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndani yako wamefunua uchi wa baba zao; ndani yako wamemfanyia nguvu mwanamke asiye safi wakati wa kutengwa kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.10",
            "verseOrgIds": [
              "EZK.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
