              "items": [
                {
                  "text": "Mwa 18:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nikatafuta mtu miongoni mwao, atakayelitengeneza boma, na kusimama mbele zangu mahali palipobomoka, kwa ajili ya nchi, nisije nikaiharibu, lakini sikuona mtu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.30",
            "verseOrgIds": [
              "EZK.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
