            }
          ]
        },
        {
          "text": "Na Pasaka ya Wayahudi ilikuwa karibu; naye Yesu akakwea mpaka Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.13",
            "verseOrgIds": [
              "JHN.2.13"
            ]
          }
        },
