              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Wayahudi wakasema, Hekalu hili lilijengwa katika muda wa miaka arobaini na sita, nawe utalisimamisha katika siku tatu? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.20",
            "verseOrgIds": [
              "JHN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
