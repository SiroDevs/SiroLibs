                  "text": "1 Kor 6:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini yeye alinena habari za hekalu la mwili wake. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.21",
            "verseOrgIds": [
              "JHN.2.21"
            ]
          }
        },
        {
