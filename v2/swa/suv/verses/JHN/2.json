              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.9"
              },
              "items": [
                {
                  "text": "Zab 69:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wanafunzi wake wakakumbuka ya kuwa imeandikwa, Wivu wa nyumba yako utanila. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.17",
            "verseOrgIds": [
              "JHN.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 2:18"
          },
          "items": [
            {
