              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.23"
              },
              "items": [
                {
                  "text": "Mt 21:23",
                  "type": "text"
                }
              ]
            },
            {
