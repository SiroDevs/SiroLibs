            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.3"
              },
              "items": [
                {
                  "text": "Yn 7:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Baada ya hayo akashuka mpaka Kapernaumu, yeye na mama yake na ndugu zake na wanafunzi wake; wakakaa huko siku si nyingi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.12",
            "verseOrgIds": [
