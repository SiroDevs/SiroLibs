              "items": [
                {
                  "text": "Yn 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Wayahudi wakajibu, wakamwambia, Ni ishara gani utuonyeshayo, kwamba unafanya haya? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.18",
            "verseOrgIds": [
              "JHN.2.18"
            ]
          }
        },
