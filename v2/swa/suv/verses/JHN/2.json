              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi alipofufuka katika wafu, wanafunzi wake wakakumbuka ya kuwa alisema hivi, wakaliamini lile andiko na lile neno alilolinena Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.22",
            "verseOrgIds": [
              "JHN.2.22"
            ]
          }
        }
