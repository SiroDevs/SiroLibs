            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matendo yake yote yenye nguvu na ya ushujaa, na habari zote za ukuu wake Mordekai ambao alipewa na mfalme, hazikuandikwa katika kitabu-cha-taarifa cha wafalme wa Umedi na Uajemi? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
