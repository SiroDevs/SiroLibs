              ]
            }
          ]
        },
        {
          "text": "Basi mfalme Ahasuero alitoza kodi katika nchi na katika visiwa vya bahari. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
