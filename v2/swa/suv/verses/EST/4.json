                "loc": "EST.3.9"
              },
              "items": [
                {
                  "text": "Est 3:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye Mordekai akamweleza yote yaliyompata, na hesabu ya fedha Hamani aliyoahidi kulipa katika hazina ya mfalme, ili Wayahudi waangamizwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.7",
            "verseOrgIds": [
              "EST.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 4:8"
