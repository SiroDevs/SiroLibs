              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Hathaki akaja, akamwambia Esta maneno ya Mordekai. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.9",
            "verseOrgIds": [
              "EST.4.9"
