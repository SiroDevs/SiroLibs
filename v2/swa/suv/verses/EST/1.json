              },
              "items": [
                {
                  "text": "Dan 8:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "siku zile mfalme Ahasuero alipoketi katika kiti cha enzi cha ufalme wake, huko Shushani ngomeni; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.2",
            "verseOrgIds": [
              "EST.1.2"
            ]
          }
        },
        {
