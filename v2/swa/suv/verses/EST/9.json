                  "text": "Est 8:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wana kumi wa Hamani bin Hamedatha, adui ya Wayahudi; walakini juu ya nyara hawakuweka mikono.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.10",
            "verseOrgIds": [
              "EST.9.10"
