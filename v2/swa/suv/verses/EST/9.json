                  "text": "Kut 23:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "siku ile ile Wayahudi wakakusanyika mijini mwao katika majimbo yote ya mfalme Ahasuero ili kuwatia mikono wale watu waliowatakia hasara; wala asiweze mtu kuwazuia, kwa kuwa hofu yao imewaangukia watu wote. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.2",
            "verseOrgIds": [
              "EST.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.7"
              },
              "items": [
                {
                  "text": "Mit 16:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao maakida wa majimbo, na majumbe, na maliwali, na wale waliofanya shughuli ya mfalme, waliwasaidia Wayahudi; kwa sababu hofu ya Mordekai imewaangukia. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.3",
            "verseOrgIds": [
              "EST.9.3"
            ]
          }
        },
        {
          "name": "verse",
