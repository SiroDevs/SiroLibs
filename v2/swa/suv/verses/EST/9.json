              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapeleka barua kwa Wayahudi wote katika majimbo yote mia na ishirini na saba ya ufalme wake Ahasuero, maneno ya amani na kweli, ",
          "type": "text",
          "attrs": {
