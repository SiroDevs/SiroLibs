                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akapiga Moabu, akawapima kwa kamba hali wamelazwa chini; akapima kamba mbili za kuuawa, na kamba moja nzima ya kuhifadhi hai. Wamoabi wakawa watumwa wa Daudi, wakaleta zawadi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.2",
            "verseOrgIds": [
              "2SA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.10.6"
              },
              "items": [
                {
