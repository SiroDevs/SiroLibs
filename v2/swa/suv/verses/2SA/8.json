            "caller": "#"
          },
          "items": [
            {
              "text": "8:16",
              "type": "text"
            },
            {
              "text": "Au, mkumbushaji.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
