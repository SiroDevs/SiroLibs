                }
              ]
            }
          ]
        },
        {
          "text": "na Sadoki, mwana wa Ahitubu, na Ahimeleki, mwana wa Abiathari walikuwa makuhani; na Shausha mwandishi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.17",
