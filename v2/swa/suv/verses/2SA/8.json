                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "hivi pia mfalme Daudi akavifanya wakfu kwa BWANA, pamoja na hiyo fedha, na dhahabu alizofanya wakfu za mataifa yote aliowashinda; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.11",
            "verseOrgIds": [
              "2SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "za Edomu, na za Moabu, na za wana wa Amoni, na za Wafilisti, na za Amaleki, na za nyara za Hadadezeri, mwana wa Rehobu, mfalme wa Soba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.60.1"
              },
              "items": [
                {
                  "text": "Zab 60:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.7"
              },
              "items": [
                {
                  "text": "2 Fal 14:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Daudi akajipatia jina, aliporudi kutoka kuwapiga Waedomi katika Bonde la Chumvi, watu kumi na nane elfu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.13",
            "verseOrgIds": [
              "2SA.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
