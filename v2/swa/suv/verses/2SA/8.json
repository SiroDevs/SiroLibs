                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Huyo Yoabu, mwana wa Seruya alikuwa juu ya jeshi; na Yehoshafati, mwana wa Ahiludi, mwenye kuandika tarehe;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.16",
            "verseOrgIds": [
              "2SA.8.16"
            ]
          }
        },
        {
