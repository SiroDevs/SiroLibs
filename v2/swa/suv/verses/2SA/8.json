            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akatawala juu ya Israeli wote; naye Daudi akawafanyia hukumu na haki watu wake wote. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.15",
            "verseOrgIds": [
              "2SA.8.15"
            ]
          }
        },
