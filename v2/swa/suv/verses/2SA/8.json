        {
          "text": "Ikawa baadaye, Daudi akawapiga Wafilisti, akawashinda; Daudi akautwaa Gathi na vijiji vyake mikononi mwa hao Wafilisti. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.1",
            "verseOrgIds": [
              "2SA.8.1"
            ]
          }
        },
        {
