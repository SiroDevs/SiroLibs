            "number": "5",
            "style": "v",
            "sid": "2SA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi mfalme Daudi akatuma watu, akamwondoa katika nyumba ya Makiri, mwana wa Amieli, katika Lo-debari. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.5",
            "verseOrgIds": [
              "2SA.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Mefiboshethi, mwana wa Yonathani, mwana wa Sauli akaenda kwa Daudi, akaanguka kifudifudi, akasujudu. Daudi akasema, Mefiboshethi! Naye akaitika, Mimi hapa, mtumwa wako! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.6",
            "verseOrgIds": [
              "2SA.9.6"
            ]
          }
        },
