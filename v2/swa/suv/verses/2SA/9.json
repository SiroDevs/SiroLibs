                }
              ]
            }
          ]
        },
        {
          "text": "Akasujudu, akasema, Mimi mtumwa wako ni nini, hata ukamwangalia mbwa mfu kama mimi? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.8",
