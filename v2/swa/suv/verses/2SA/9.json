                  "text": "2 Sam 17:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mfalme akamwambia, Yuko wapi? Siba akamwambia mfalme, Tazama, yumo katika nyumba ya Makiri, mwana wa Amieli, katika Lo-debari. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.4",
            "verseOrgIds": [
              "2SA.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
