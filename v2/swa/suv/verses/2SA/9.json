        },
        {
          "text": "Ndipo mfalme akamwita Siba, mtumwa wa Sauli, akamwambia, Mali yote yaliyokuwa ya Sauli na ya nyumba yake nimempa mwana wa bwana wako. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.9",
            "verseOrgIds": [
              "2SA.9.9"
            ]
          }
