        },
        {
          "text": "vitu hivi vyote, Ee mfalme, mimi Arauna nakupa wewe mfalme. Kisha Arauna akamwambia mfalme, BWANA, Mungu wako, na akukubali. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.23",
