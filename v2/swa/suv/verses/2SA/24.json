          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Daudi akakwea sawasawa na neno la Gadi, kama BWANA alivyoamuru. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.19",
            "verseOrgIds": [
              "2SA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huyo Arauna akatazama, akamwona mfalme na watumishi wake wakimjia; Arauna akatoka, akasujudu mbele ya mfalme kifulifuli hata nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.20",
            "verseOrgIds": [
              "2SA.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
