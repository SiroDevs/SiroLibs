              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.22.5"
              },
              "items": [
                {
                  "text": "1 Sam 22:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.9.9"
              },
              "items": [
                {
                  "text": "9:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na Daudi alipoondoka asubuhi, neno la BWANA likamjia nabii Gadi, mwonaji wake Daudi, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.11",
            "verseOrgIds": [
              "2SA.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenda, ukanene na Daudi, BWANA asema hivi, Nakuwekea mambo matatu; katika haya uchague moja, nikutendee hilo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.12",
            "verseOrgIds": [
              "2SA.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.21.12"
              },
              "items": [
                {
                  "text": "1 Nya 21:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Gadi akamwendea Daudi, akamweleza, akamwambia, Basi, miaka saba ya njaa ikujie katika nchi yako? Au miezi mitatu ukimbie mbele ya adui zako, huku wakikufuatia? Au siku tatu iwe tauni katika nchi yako? Fanya shauri sasa, ufikiri, ni jawabu gani nimrudishie yeye aliyenituma. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.13",
            "verseOrgIds": [
              "2SA.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
