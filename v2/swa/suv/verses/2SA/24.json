              "type": "text"
            }
          ]
        },
        {
          "text": "Siku hiyo Gadi akamwendea Daudi, akamwambia, Haya! Kwea wewe, ukamwinulie BWANA madhabahu penye kiwanja cha Arauna, Myebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.18",
            "verseOrgIds": [
