              "items": [
                {
                  "text": "Hes 16:48",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Arauna akasema, Bwana wangu mfalme amemjia mtumwa wake kwa kusudi gani? Naye Daudi akasema, Makusudi ninunue kwako kiwanja hiki, ili nimjengee BWANA madhabahu, ili kwamba tauni ipate kuzuiliwa katika watu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.21",
            "verseOrgIds": [
              "2SA.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
