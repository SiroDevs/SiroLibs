              "items": [
                {
                  "text": "Mdo 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini neno la mfalme likawa na nguvu juu ya Yoabu, na juu ya majemadari wa jeshi. Basi Yoabu akatoka na majemadari wa jeshi machoni pa mfalme, kwenda kuwahesabu watu wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.4",
            "verseOrgIds": [
              "2SA.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
