            }
          ]
        },
        {
          "text": "Wakavuka Yordani, wakapiga kambi huko Aroeri, upande wa kuume wa mji ulioko kati ya bonde la Gadi, na mpaka Yazeri; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.5",
            "verseOrgIds": [
              "2SA.24.5"
            ]
          }
        },
        {
