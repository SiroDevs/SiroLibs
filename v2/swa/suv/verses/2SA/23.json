                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena Benaya, mwana wa Yehoyada, mtu hodari wa Kabseeli aliyekuwa amefanya mambo makuu; aliwaua simba wakali wawili wa Moabu,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.20",
            "verseOrgIds": [
              "2SA.23.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23:20",
              "type": "text"
            },
            {
              "text": "Au, wana wawili wa Arieli, wa Moabu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " pia akashuka akamwua simba katikati ya shimo wakati wa theluji; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.20",
            "verseOrgIds": [
              "2SA.23.20"
            ]
          }
        },
