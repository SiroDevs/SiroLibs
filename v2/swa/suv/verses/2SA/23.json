              "items": [
                {
                  "text": "1 Nya 11:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena, Abishai, nduguye Yoabu, mwana wa Seruya, alikuwa mkuu wa wale watatu. Huyo aliuinua mkuki wake juu ya watu mia tatu, akawaua, akawa na jina kati ya wale watatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.18",
            "verseOrgIds": [
              "2SA.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Huyo hakuwa na heshima maalumu miongoni mwa wale watatu? Kwa hiyo akawekwa kuwa akida wao; ila hakudiriki kuwamo katika wale watatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.19",
            "verseOrgIds": [
              "2SA.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
