              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayo ndiyo aliyoyafanya Benaya, mwana wa Yehoyada, akawa na jina kati ya wale mashujaa watatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.22",
