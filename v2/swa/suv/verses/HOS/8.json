                "loc": "JOB.21.14"
              },
              "items": [
                {
                  "text": "Ayu 21:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nijapomwandikia sheria yangu katika amri elfu kumi, zimehesabiwa kuwa ni kitu kigeni. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.12",
            "verseOrgIds": [
              "HOS.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa habari za dhabihu za matoleo yangu, hutoa dhabihu ya nyama na kuila; lakini BWANA hawakubali; sasa ataukumbuka uovu wao, na kuwapatiliza dhambi zao; watarudi kwenda Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.13",
            "verseOrgIds": [
              "HOS.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.31"
              },
              "items": [
                {
                  "text": "1 Fal 12:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana Israeli amemsahau Muumba wake, naye amejenga nyumba za enzi; na Yuda ameongeza miji yenye maboma; lakini nitapeleka moto juu ya miji yake, nao utaziteketeza ngome zake.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.14",
            "verseOrgIds": [
              "HOS.8.14"
            ]
          }
        }
