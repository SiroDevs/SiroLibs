              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana wao hupanda upepo, nao watavuna tufani; nafaka haina bua; machipuko yake hayatoi masuke; hata ikiwa yatoa, wageni watayameza. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli amemezwa; sasa wamo miongoni mwa mataifa kama chombo kisichopendeza. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.8",
            "verseOrgIds": [
              "HOS.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.19"
              },
              "items": [
                {
                  "text": "2 Fal 15:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana wamekwea kwenda Ashuru, mfano wa punda wa mwituni aliye peke yake; Efraimu ameajiri wapenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.9",
            "verseOrgIds": [
              "HOS.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.10.8"
              },
              "items": [
                {
                  "text": "Isa 10:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.7"
              },
              "items": [
                {
                  "text": "Eze 26:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.37"
              },
              "items": [
                {
                  "text": "Dan 2:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naam, ijapokuwa waajiri kati ya mataifa, sasa nitawakusanya; nao wanaanza kupunguka kwa sababu ya mzigo wa mfalme wa wakuu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa Efraimu ameongeza madhabahu kwa dhambi, madhabahu zimekuwa dhambi kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.11",
            "verseOrgIds": [
              "HOS.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
