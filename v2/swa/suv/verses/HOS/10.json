                "loc": "JER.4.3"
              },
              "items": [
                {
                  "text": "Yer 4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jipandieni katika haki, vuneni kwa fadhili; uchimbueni udongo wa mashamba yenu, kwa maana wakati umewadia wa kumtafuta BWANA, hata atakapokuja na kuwanyeshea haki. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.12",
            "verseOrgIds": [
              "HOS.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.4.8"
              },
              "items": [
                {
                  "text": "Ayu 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.22.8"
              },
              "items": [
                {
                  "text": "Mit 22:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.8.7"
              },
              "items": [
                {
                  "text": "Hos 8:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mmelima dhuluma, mmevuna uovu; mmekula matunda ya uongo; kwa maana uliitumainia njia yako, na wingi wa mashujaa wako. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.13",
            "verseOrgIds": [
              "HOS.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.34"
              },
              "items": [
                {
                  "text": "2 Fal 18:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu hiyo fitina itatokea kati ya watu wako, na ngome zako zote zitaharibiwa, kama vile Shalmani alivyoharibu Betharbeli, katika siku ya vita; mama akavunjika-vunjika pamoja na watoto wake. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.14",
            "verseOrgIds": [
              "HOS.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo ndivyo Betheli atakavyowatenda ninyi, kwa sababu ya ubaya wenu mwingi; wakati wa mapambazuko mfalme wa Israeli atakatiliwa mbali kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.15",
            "verseOrgIds": [
              "HOS.10.15"
            ]
          }
        }
