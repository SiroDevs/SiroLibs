                "loc": "DEU.9.21"
              },
              "items": [
                {
                  "text": "Kum 9:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.30"
              },
              "items": [
                {
                  "text": "Lk 23:30",
                  "type": "text"
                }
              ]
            },
