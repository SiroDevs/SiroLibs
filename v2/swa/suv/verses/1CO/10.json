                "loc": "NUM.21.5+NUM.21.6"
              },
              "items": [
                {
                  "text": "Hes 21:5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wala tusimjaribu Bwana, kama wengine wao walivyomjaribu, wakaharibiwa na nyoka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.9",
            "verseOrgIds": [
              "1CO.10.9"
            ]
          }
        },
