              "items": [
                {
                  "text": "Hes 20:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wote wakanywa kinywaji kile kile cha roho; kwa maana waliunywea mwamba wa roho uliowafuata; na mwamba ule ulikuwa ni Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.4",
            "verseOrgIds": [
