                  "text": "1 Pet 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi mambo hayo yaliwapata wao kwa jinsi ya mifano, yakaandikwa ili kutuonya sisi, tuliofikiliwa na miisho ya zamani.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.11",
            "verseOrgIds": [
              "1CO.10.11"
            ]
