                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini wengi sana katika wao, Mungu hakupendezwa nao; maana waliangamizwa jangwani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.5",
            "verseOrgIds": [
              "1CO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 10:6"
          },
          "items": [
            {
