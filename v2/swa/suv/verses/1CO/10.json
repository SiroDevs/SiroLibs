          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo anayejidhania kuwa amesimama na aangalie asianguke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.12",
            "verseOrgIds": [
              "1CO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaribu halikuwapata ninyi, isipokuwa lililo kawaida ya wanadamu; ila Mungu ni mwaminifu; ambaye hatawaacha mjaribiwe kupita mwezavyo; lakini pamoja na lile jaribu atafanya na mlango wa kutokea, ili mweze kustahimili.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.13",
            "verseOrgIds": [
              "1CO.10.13"
            ]
          }
        }
      ]
    },
