                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wala msinung’unike, kama wengine wao walivyonung’unika, wakaharibiwa na mharabu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.10",
            "verseOrgIds": [
              "1CO.10.10"
            ]
          }
