                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kikombe kile cha baraka tukibarikicho, je! Si ushirika wa damu ya Kristo? Mkate ule tuumegao, si ushirika wa mwili wa Kristo? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.16",
            "verseOrgIds": [
              "1CO.10.16"
            ]
          }
        },
