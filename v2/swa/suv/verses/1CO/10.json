            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa ajili ya hayo, wapenzi wangu, ikimbieni ibada ya sanamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.14",
            "verseOrgIds": [
              "1CO.10.14"
            ]
          }
        },
        {
