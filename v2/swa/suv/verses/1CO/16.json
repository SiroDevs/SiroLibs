                "loc": "ACT.20.7"
              },
              "items": [
                {
                  "text": "Mdo 20:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Siku ya kwanza ya juma kila mtu kwenu na aweke akiba kwake, kwa kadiri ya kufanikiwa kwake; ili kwamba michango isifanyike hapo nitakapokuja; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.2",
            "verseOrgIds": [
              "1CO.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami nitakapofika nitawatuma kwa nyaraka wale mtakaowachagua, wachukue hisani yenu mpaka Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.3",
            "verseOrgIds": [
              "1CO.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kama ikifaa niende na mimi, watasafiri pamoja nami.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.4",
            "verseOrgIds": [
              "1CO.16.4"
            ]
          }
        }
      ]
    },
