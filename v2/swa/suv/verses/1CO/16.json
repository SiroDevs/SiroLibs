        {
          "text": "Kwa habari ya ile changizo kwa ajili ya watakatifu, kama vile nilivyoamuru makanisa ya Galatia, nanyi fanyeni vivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.1",
            "verseOrgIds": [
              "1CO.16.1"
            ]
          }
        },
