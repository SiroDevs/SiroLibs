              },
              "items": [
                {
                  "text": "2 Kor 10:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nalikuwako kwenu katika hali ya udhaifu na hofu na matetemeko mengi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.3",
            "verseOrgIds": [
              "1CO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
