              "items": [
                {
                  "text": "1 The 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ili imani yenu isiwe katika hekima ya wanadamu, bali katika nguvu za Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.5",
            "verseOrgIds": [
              "1CO.2.5"
