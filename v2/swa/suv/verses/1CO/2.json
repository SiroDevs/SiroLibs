              "attrs": {
                "loc": "GAL.6.14"
              },
              "items": [
                {
                  "text": "Gal 6:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana naliazimu nisijue neno lo lote kwenu ila Yesu Kristo, naye amesulibiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.2",
            "verseOrgIds": [
              "1CO.2.2"
            ]
          }
        },
