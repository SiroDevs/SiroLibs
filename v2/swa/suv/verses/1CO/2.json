            "number": "4",
            "style": "v",
            "sid": "1CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na neno langu na kuhubiri kwangu hakukuwa kwa maneno ya hekima yenye kushawishi akili za watu, bali kwa dalili za Roho na za nguvu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.4",
            "verseOrgIds": [
              "1CO.2.4"
            ]
          }
        },
