              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, ndugu zangu, mimi nilipokuja kwenu, sikuja niwahubiri siri ya Mungu kwa ufasaha wa maneno, wala kwa hekima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.1",
