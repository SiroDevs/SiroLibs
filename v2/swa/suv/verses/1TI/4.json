                  "text": "3:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bali hadithi za kizee, zisizokuwa za dini, uzikatae; nawe ujizoeze kupata utauwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.7",
            "verseOrgIds": [
              "1TI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
