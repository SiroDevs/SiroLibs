              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwakumbushe ndugu mambo hayo, nawe utakuwa mtumishi mwema wa Kristo Yesu, na mzoevu wa maneno ya imani, na mafundisho mazuri yale uliyoyafuata. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.6",
            "verseOrgIds": [
              "1TI.4.6"
            ]
          }
        },
