                "loc": "1TI.6.6"
              },
              "items": [
                {
                  "text": "1 Tim 6:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana kujizoeza kupata nguvu za mwili kwafaa kidogo, lakini utauwa hufaa kwa mambo yote; yaani, unayo ahadi ya uzima wa sasa, na ya ule utakaokuwapo baadaye.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.8",
            "verseOrgIds": [
              "1TI.4.8"
            ]
          }
        }
