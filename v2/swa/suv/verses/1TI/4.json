                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakiwazuia watu wasioe, na kuwaamuru wajiepushe na vyakula, ambavyo Mungu aliviumba vipokewe kwa shukrani na walio na imani wenye kuijua hiyo kweli. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.3",
            "verseOrgIds": [
              "1TI.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 4:4"
          },
          "items": [
