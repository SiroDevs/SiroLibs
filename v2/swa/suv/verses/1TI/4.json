              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.31"
              },
              "items": [
                {
                  "text": "Mwa 1:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.15"
              },
              "items": [
                {
                  "text": "Mdo 10:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana kila kiumbe cha Mungu ni kizuri, wala hakuna cha kukataliwa, kama kikipokewa kwa shukrani; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.4",
            "verseOrgIds": [
              "1TI.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kuwa kimetakaswa kwa neno la Mungu na kwa kuomba.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.5",
            "verseOrgIds": [
              "1TI.4.5"
            ]
          }
        }
