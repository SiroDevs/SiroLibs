            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.14"
              },
              "items": [
                {
                  "text": "Rum 11:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jitunze nafsi yako, na mafundisho yako. Dumu katika mambo hayo; maana kwa kufanya hivyo utajiokoa nafsi yako na wale wakusikiao pia.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.16",
            "verseOrgIds": [
              "1TI.4.16"
            ]
          }
        }
