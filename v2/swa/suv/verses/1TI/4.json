            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni neno la kuaminiwa, tena lastahili kukubalika kabisa; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.9",
            "verseOrgIds": [
              "1TI.4.9"
            ]
          }
        },
