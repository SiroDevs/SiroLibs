                "loc": "1TI.2.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kwa maana twajitaabisha na kujitahidi kwa kusudi hili, kwa sababu tunamtumaini Mungu aliye hai, aliye Mwokozi wa watu wote, hasa wa waaminio.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.10",
            "verseOrgIds": [
              "1TI.4.10"
            ]
          }
        }
