            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.16"
              },
              "items": [
                {
                  "text": "Flm 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wale walio na bwana waaminio wasiwadharau kwa kuwa ni ndugu; bali afadhali wawatumikie, kwa sababu hao waishirikio faida ya kazi yao wamekuwa wenye imani na kupendwa. Mambo hayo uyafundishe na kuonya.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.2",
            "verseOrgIds": [
              "1TI.6.2"
            ]
          }
        }
      ]
    },
    {
