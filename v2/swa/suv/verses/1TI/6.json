        },
        {
          "text": "Mtu awaye yote akifundisha elimu nyingine, wala hayakubali maneno yenye uzima ya Bwana wetu Yesu Kristo, wala mafundisho yapatanayo na utauwa, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.3",
            "verseOrgIds": [
              "1TI.6.3"
            ]
          }
        },
