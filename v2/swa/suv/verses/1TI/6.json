        },
        {
          "text": "Wo wote walio chini ya kongwa, hali ya utumwa, na wawahesabie bwana zao kuwa wamestahili heshima yote, jina la Mungu lisitukanwe wala mafundisho yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.1",
            "verseOrgIds": [
              "1TI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 6:2"
          },
          "items": [
