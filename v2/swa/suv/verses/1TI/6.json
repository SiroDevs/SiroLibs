        },
        {
          "text": "na majadiliano ya watu walioharibika akili zao, walioikosa kweli, huku wakidhani ya kuwa utauwa ni njia ya kupata faida. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.5",
            "verseOrgIds": [
