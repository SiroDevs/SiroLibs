          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "amejivuna; wala hafahamu neno lo lote; bali ana wazimu wa kuwazia habari za maswali, na mashindano ya maneno, ambayo katika hayo hutoka husuda, na ugomvi, na matukano, na shuku mbaya; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.4",
            "verseOrgIds": [
              "1TI.6.4"
            ]
          }
        },
