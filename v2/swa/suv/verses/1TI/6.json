                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana shina moja la mabaya ya kila namna ni kupenda fedha; ambayo wengine hali wakiitamani hiyo wamefarakana na Imani, na kujichoma kwa maumivu mengi.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.10",
            "verseOrgIds": [
              "1TI.6.10"
            ]
          }
        }
