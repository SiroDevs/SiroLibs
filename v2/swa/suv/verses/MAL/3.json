              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati ule ndipo dhabihu za Yuda na Yerusalemu zitakapopendeza mbele za BWANA, kama katika siku za kale, na kama katika miaka ya zamani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.4",
            "verseOrgIds": [
              "MAL.3.4"
            ]
          }
        },
