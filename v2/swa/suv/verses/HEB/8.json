            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.6"
              },
              "items": [
                {
                  "text": "2 Kor 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini sasa amepata huduma iliyo bora zaidi, kwa kadiri alivyo mjumbe wa agano lililo bora, lililoamriwa juu ya ahadi zilizo bora. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.6",
            "verseOrgIds": [
              "HEB.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana kama lile la kwanza lingalikuwa halina upungufu, nafasi isingalitafutwa kwa lile la pili. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.7",
            "verseOrgIds": [
              "HEB.8.7"
            ]
          }
        },
