              "items": [
                {
                  "text": "Kut 22:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana wanadamu huapa kwa yeye aliye mkuu kuliko wao; na kwao ukomo wa mashindano yote ya maneno ni kiapo, kwa kuyathibitisha. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.16",
            "verseOrgIds": [
              "HEB.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika neno hilo Mungu, akitaka kuwaonyesha zaidi sana warithio ile ahadi, jinsi mashauri yake yasivyoweza kubadilika, alitia kiapo katikati; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.17",
            "verseOrgIds": [
              "HEB.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 6:18"
          },
          "items": [
