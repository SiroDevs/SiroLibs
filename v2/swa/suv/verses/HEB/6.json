              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.23.19"
              },
              "items": [
                {
                  "text": "Hes 23:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.29"
              },
              "items": [
                {
                  "text": "1 Sam 15:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ili kwa vitu viwili visivyoweza kubadilika, ambavyo katika hivyo Mungu hawezi kusema uongo, tupate faraja iliyo imara, sisi tuliokimbilia kuyashika matumaini yale yawekwayo mbele yetu; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.18",
            "verseOrgIds": [
              "HEB.6.18"
            ]
          }
        },
