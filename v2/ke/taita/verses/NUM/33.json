          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 33:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikafuma Jotbatha wikaghenda na kudunga kambi Abrona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.34",
            "verseOrgIds": [
              "NUM.33.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 33:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikafuma Abrona wikaghenda na kudunga kambi Ezion-geberi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.35",
            "verseOrgIds": [
              "NUM.33.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 33:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikafuma Ezion-geberi wikaghenda na kudunga kambi kireti cha Sini (niko kuwangwaghwa Kadeshi) ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.36",
            "verseOrgIds": [
              "NUM.33.36"
            ]
