          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko mzuri wa Aradi, Mkanaani orekoghe ukikaia Negebu isanga ja Kanaani, ukasikira malagho gha kucha kwa wandu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.40",
