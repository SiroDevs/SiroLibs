          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "na wandu wose, elfu mirongo idadu na wawi; waka wiselale na mndwawomi ungi jingi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.35",
            "verseOrgIds": [
              "NUM.31.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
