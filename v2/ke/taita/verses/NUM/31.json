              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na mkohani Eleazari, wikabonya sa iji koni BWANA oremlaghirieghe Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.31",
            "verseOrgIds": [
              "NUM.31.31"
            ]
