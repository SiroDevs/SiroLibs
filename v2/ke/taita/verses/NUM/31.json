          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "punda elfu mirongo irandadu na imweri ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.34",
            "verseOrgIds": [
              "NUM.31.34"
            ]
