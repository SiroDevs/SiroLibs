          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'ombe, elfu mirongo idadu na irandadu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.44",
            "verseOrgIds": [
              "NUM.31.44"
