              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumanya na ija nusu ya vilambo veredwaloghe wunyika, iyo Musa oretanyireghe na ija ya masikari ikaie kwa wundu ghwa wandu wa Israeli, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.42",
