          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kufumanya na iyo nusu ya vilambo vidwalo wunyika kwa wundu ghwa wandu wa Israeli, Musa ukawusa ifungu jimweri kwa kula mirongo misanu, wandu chiaimweri na nyamandu; ukawineka Walawi awo werekoghe wikiilindia Hema, sa iji koni BWANA oremlaghirieghe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.47",
            "verseOrgIds": [
              "NUM.31.47"
            ]
          }
        }
      ]
