          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'ombe elfu mirongo mfungade na iwi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.33",
            "verseOrgIds": [
              "NUM.31.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
