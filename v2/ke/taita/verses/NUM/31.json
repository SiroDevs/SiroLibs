          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ivo vilambo veredwaloghe wunyika ni awo masikari, verekoghe ng'ondi elfu maghana arandadu na mirongo mfungade na isanu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.32",
            "verseOrgIds": [
              "NUM.31.32"
            ]
          }
        },
        {
