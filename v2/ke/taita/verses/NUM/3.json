          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukarineka Haruni na wana wake, sa iji koni BWANA oremlaghirieghe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.51",
