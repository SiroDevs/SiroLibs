          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "BWANA kummbanga Samueli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngelo iro, uo mwana Samueli, orekoghe ukimdumikia BWANA aisi ya Eli. Na ilagho ja Mlungu jerekoghe jahora modo nandighi matuku agho; kwa kukaia ndekorekoghe na mawono ghangi shwa kwa shwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngelo iyo, meso gha Eli gherezoeghe kufwa, hata nderedimieghe kuwona; ukakaia ukilala chumbenyi kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.2",
            "verseOrgIds": [
              "1SA.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueli orekoghe ukilala andenyi ya hekalu ya BWANA",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.3",
              "type": "text"
            },
            {
              "text": "Hekalu ya BWANA:",
              "type": "text"
            },
            {
              "text": "angu andu kwa BWANA kokaia.",
              "type": "text"
            }
          ]
        },
        {
          "text": " andu Sanduku ya Ilaghano erekoghe ikikaia, na taa ya Mlungu erekoghe iserimishiro. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukammbanga Samueli, “Samueli! Samueli!” Ukadika “Neko aha!” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.4",
            "verseOrgIds": [
              "1SA.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukakimbia cha kwa Eli ukamzera, “Nacha seji kwaniwanga.” Ela Eli ukaghamba, “Sikuwangie kungi ghenda kulale.” Niko Samueli ukaghenda ukalala. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.5",
            "verseOrgIds": [
              "1SA.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukawanga sena, “Samueli!” Nao Samueli ukawuka ukaghenda kwa Eli ukaghamba, “Nacha seji kwaniwanga.” Ela ukaghamba, “Mwanwapo sikuwangie kungi ghenda kulale.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngelo iro, Samueli nderekoghe wammanya BWANA, hata ilagho jake ndejeremtambukieghe anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.7",
            "verseOrgIds": [
              "1SA.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukammbanga Samueli indo ja kadadu. Nao ukawuka ukaghenda kwa Eli ukamzera, “Nacha seji kwaniwanga.” Niko Eli ukamanya kukaia ni BWANA wawuyammbanga uja mwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
            "verseOrgIds": [
              "1SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa huwo Eli ukamzera Samueli, “Ghenda kulale; nao ukakuwanga sena kumzere, ‘Ghora BWANA, angu ini mdumiki wako nawuyasikira.’” Niko Samueli ukawuya na kulala andu koni orekoghe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.9",
            "verseOrgIds": [
              "1SA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.9",
            "verseOrgIds": [
              "1SA.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao BWANA ukacha ukakaia kimusi na kummbanga sena, “Samueli! Samueli!” Niko Samueli ukadika, “Ghora BWANA angu mdumiki wako nawuyasikira.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.10",
            "verseOrgIds": [
              "1SA.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko BWANA ukamzera Samueli, “Ola nalighisa kubonya ilagho andenyi ya Israeli, mundu uo ose uchaajisikira, jichamturusa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.11",
            "verseOrgIds": [
              "1SA.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituku ijo nichakatisha malagho ghose nereghighorieghe aighu ya Eli na nyumba yake kufuma kuzoya hata kutua; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.12",
            "verseOrgIds": [
              "1SA.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "seji neremzerieghe kukaia, nichairedia nyumba yake ikabo ja kala na kala kwa wundu ghwa ugho wuwiwi ughumanyire; kwa kukaia wana wake werekoghe wikimsholia Mlungu, nao nderewikanieghe anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.13",
            "verseOrgIds": [
              "1SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa huwo naghema aighu ya nyumba ya Eli kukaia wandu wake ndewichaeleshwa kwa kizongona hata kwa mafunyo kwa kala na kala.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.14",
            "verseOrgIds": [
              "1SA.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.14",
            "verseOrgIds": [
              "1SA.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Samueli ukalala hata ndoe ikaela; niko ukairughua minyango ya nyumba ya BWANA. Ela ukaobua kumghoria Eli agho mawono. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.15",
            "verseOrgIds": [
              "1SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Eli ukammbanga Samueli ukamzera, “Samueli mwana wapo;” nao ukadika, “Neko aha.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.16",
            "verseOrgIds": [
              "1SA.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli ukamzera, “BWANA wakuzerie wada? Kusenivise ilagho jingi ja agho ghose ukughorie. Kukanivisa, kukabwa ni Mlungu kuchumba.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.17",
            "verseOrgIds": [
              "1SA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko aho Samueli ukamghoria agho ghose oreghoreloghe ni BWANA, hata nderemvisireghe ilagho jingi anduangi. Nao Eli ukaghamba, “Uo ni BWANA, ndebonye sa iji koni wawona nicha moni.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.18",
            "verseOrgIds": [
              "1SA.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.18",
            "verseOrgIds": [
              "1SA.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueli ukazoghua, na BWANA ukakaia andwamweri nao, hata nderesighieghe ilagho jingi jake usejikatishire anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.19",
            "verseOrgIds": [
              "1SA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Waisraeli wose kufuma Dani hata Beer-sheba wikamanya kukaia Samueli wamerie kuwikwa ukaie mlodi wa BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.20",
            "verseOrgIds": [
              "1SA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukachuria kukufunukua sena aho Shilo, angu orekoghe wakufunukua kwa Samueli kwa chia ya ilagho jake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.21",
            "verseOrgIds": [
              "1SA.3.21"
            ]
          }
        }
      ]
    }
  ],
