              },
              "items": [
                {
                  "text": "Mit. 29.12-38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.13",
            "verseOrgIds": [
              "DEU.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "M'boilo ndimenyi chiaimweri na wana wenyu wa womi na wa waka, na wadumiki wenyu wa womi na wa waka, na Mlawi, na mghenyi omara-mara, na mwana usewadie ndee, na muka mkiwa; awo wiko mizinyi konyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.14",
            "verseOrgIds": [
              "DEU.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mum'bonyere BWANA Mlungu onyu iyo ndima kwa matuku mfungade andu uchaakusaghua, kwa kukaia BWANA Mlungu onyu uchakurasimia kwa mavalo ghenyu ghose; na kwa kazi renyu rose mchaabonya; na oho kuchulo ni kuboilwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wandu wenyu wose wa womi wichaghenda kumtasa BWANA Mlungu onyu mando adadu kwa mwaka, andu BWANA uchaakusaghua. Ngelo ya Ndima ya Mikate isewadie Chachu, na ngelo ya Ndima ya Makuwido, na ngelo ya Ndima ya Viwanda. Wiseghende kumtasa BWANA mikonu miduu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kula mundu uchafunya seji udimagha kunughana na seji BWANA Mlungu wake umrasimie.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
              "DEU.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wudumiki ghwa hachi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
              "DEU.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mmbike watanyi na wabaa andenyi ya mizi yenyu yose mnekwagha ni BWANA Mlungu onyu, kunughana na vichuku venyu, wipate kutanya wandu kwa hachi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.18",
            "verseOrgIds": [
              "DEU.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msede hachi ya mndungi; msetanye kwa kutala wandu; hata mserumirie kutuwa, kwa kukaia kutuwa kwadaturua meso gha wandu wiko na suku, na kulaghasha hachi ra wandu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.19",
            "verseOrgIds": [
              "DEU.16.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
