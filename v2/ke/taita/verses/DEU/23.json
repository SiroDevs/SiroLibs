              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kukaida aghadi ya mbuwa ya mmbenyu ya mizabibu, kwadima kuja zabibu seji kudimagha, ela kusekumbirie ringi kikapunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.24",
            "verseOrgIds": [
