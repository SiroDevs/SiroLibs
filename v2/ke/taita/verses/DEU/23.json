              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela mkakaia kusebonyagha ighemi jingi, ndemchaatalilwa kaung'a ingi anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.22"
            ]
