              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakulomba kunisighe niruwuke, nipate kuwona ijo isanga jiboie jiko chija kimonu cha Jordani ijo isanga jighokie ja Mighondi ya Lebanoni!’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
