              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DEU 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aho mkanitumbulia, ‘Dam'bonyere BWANA kaung'a; dichajoka dilo, sa iji koni BWANA Mlungu odu oredilaghirieghe.’ Niko kula umu onyu ukarwa maswagha ghake gha wuda ukighesha wei ni ilagho jiangue kujoka cha isanga ja mighondinyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.41",
            "verseOrgIds": [
              "DEU.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela BWANA ukanizera, ‘Wizere wisejoke hata wisakelwa wichesimwa ni wamaiza wawo angu sikwanye nenyo anduangi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.42",
            "verseOrgIds": [
              "DEU.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niendamghoria, ndemoresikireghe; ela modelegha malaghiro gha BWANA, mkaajoka cha isanga ja mighondinyi mkikukasa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.43",
            "verseOrgIds": [
              "DEU.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Waamori, awo werekoghe wikikaia ijo isanga ja mighondinyi wikamfumia wikammbinga sa choki, wikamkaba ajaisi Seiri hata mkavika Horma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.44",
            "verseOrgIds": [
              "DEU.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko mcheewuya mkawoka kumlilia BWANA, ela BWANA ndemcheesikira hata kumzighana anduangi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.45",
            "verseOrgIds": [
              "DEU.1.45"
            ]
          }
        }
      ]
    },
    {
