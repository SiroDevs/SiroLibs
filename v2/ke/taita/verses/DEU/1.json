                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.26",
            "verseOrgIds": [
              "DEU.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "mkazughunuka hemenyi konyu mkighamba, ‘Ni angu BWANA uzamilo ni isi, niko udifunyire isanga ja Misri na kudireda kwa Waamori wipate kuditotesha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.27",
            "verseOrgIds": [
              "DEU.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dijoka cha hao? Wanidu wadibwagha ngolo wikighamba, awo wandu ni wabaa, sena ni walacha kudichumba, mizi nayo ni mibaa iko na ngome riaghilo na kuvika mawingunyi; sena dawiwonie Waanaki aho.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.28",
            "verseOrgIds": [
              "DEU.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
