                "loc": "HEB.3.19"
              },
              "items": [
                {
                  "text": "Waeb. 3.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.32",
            "verseOrgIds": [
              "DEU.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "uo orekirieghe imbiri konyu andenyi ya iwingu nadime, na andenyi ya modo nakio, kummbonyera chia muidiriagha, na wulalo ghodunga hema renyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.33",
            "verseOrgIds": [
              "DEU.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "BWANA kuwikaba Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
