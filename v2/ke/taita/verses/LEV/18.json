                {
                  "text": "Neh. 9.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.9"
              },
              "items": [
                {
                  "text": "Eze. 18.9",
                  "type": "text"
                }
              ]
            },
