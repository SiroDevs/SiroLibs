              "LEV.26.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 26:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela isanga jisighwa ni wandu wake, najo jichahora andu kose jisighilo iduu; hata wameria kuboisa makosa ghawo, kwa kukaia wereleghieghe memu yapo na kuzamilwa ni malaghiro ghapo rohonyi kwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.43",
            "verseOrgIds": [
              "LEV.26.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 26:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elaima kwa agho ghose, ngelo wikikaia isanga ja wamaiza wawo, sichaawisigha putu hata kuvikia kuwinona anduangi, hata sichaajiinja ilaghano japo nerejibonyereghe nawo, angu Ini ne BWANA Mlungu wawo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.44",
            "verseOrgIds": [
              "LEV.26.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 26:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela kwa wundu ghwawo, nichajikumbuka ilaghano japo sena, ijo nerejibonyereghe na weke ndee, awo nerewifunyireghe isanga ja Misri mbari zima rikiwona eri nipate kukaia Mlungu wawo; Ini ne BWANA.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        }
      ]
    },
