          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihi niyo memu, malaghiro, na sharia iro BWANA oreriwikieghe aghadi yake na wandu wa Israeli, kuidia kwa Musa aighu ya Mghondi ghwa Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
