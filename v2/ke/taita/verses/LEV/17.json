              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.10",
            "verseOrgIds": [
              "LEV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kukaia irangi ja mumbinyi jeeka andenyi ya bagha, nani namneka bagha madhabahunyi mpate kubonya wupatanisho ghwa kaung'a kwa wundu ghwa roho renyu; angu bagha niyo ibonyagha mapatano, nayo niyo irangi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.11",
            "verseOrgIds": [
              "LEV.17.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.22"
              },
              "items": [
                {
                  "text": "Waeb. 9.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.11",
            "verseOrgIds": [
              "LEV.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wokoni niko nawizera wandu wa Israeli, na waghenyi wiko aghadi kwawo, kukaia wiseje bagha jingi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.12",
            "verseOrgIds": [
              "LEV.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.12",
            "verseOrgIds": [
              "LEV.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Huwo koni mndungi wa wandu wa Israeli angu mghenyi uko aghadi kwawo, ukabwagha nyamandu angu nyonyi eja, suti udie bagha yake yose, sena iyo bagha uidunge ndoe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.13",
            "verseOrgIds": [
              "LEV.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu irangi ja kula nyamandu iko moyo jeeka andenyi ya bagha; niko nawizera wandu wa Israeli wiseje bagha ya nyamandu ingi, kwa kukaia irangi ja kula nyamandu jeeka baghenyi, mndungi ukaja bagha uchatanywa na wandu wake. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.14",
            "verseOrgIds": [
              "LEV.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na uo ose uchaaja nyamandu ifue cheni, angu ibwaghilo ni mmbao, ukaiagha ni muisanga angu mghenyi wawuyakaia aghadi konyu, uchaoghosha nguwo rake, na kukuoghosha uo moni na machi; sena uchakaia useelie hata luma lwa kenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.15",
            "verseOrgIds": [
              "LEV.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ukalegha kuoghosha nguwo rake, angu kukuoghosha uo moni, uchaduka wuwiwi ghwake moni.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.16",
            "verseOrgIds": [
              "LEV.17.16"
            ]
          }
        }
      ]
    }
