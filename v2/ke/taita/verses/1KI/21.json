          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukamzera Elija Mtishbi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwawuyammbona Ahabu seji wakusera imbiri kwapo? Angu wakusera huwo imbiri kwapo, sichaareda ugho wuwiwi matuku ghake, ela nichairedia nyumba yake agho mawiwi matuku gha mwana wake.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.29",
            "verseOrgIds": [
