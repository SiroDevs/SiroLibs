              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orebonyereghe wuwiwi ghuzamie ghotasa milimu sa Waamori, awo BWANA orewiwingieghe imbiri ya wandu wa Israeli.)",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
