              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu uendasikira malagho agho, ukarashua nguwo rake na kurwa nguwo ra magunia; ukafunga tumu na kulala magunienyi ukikusera nandighi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
            "verseOrgIds": [
