              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka ghwa kawi ghwa kubonya nguma kwa Mzuri Asa wa Juda, Nadabu mwana wa Mzuri Jeroboamu, ukawuya mzuri wa Israeli. Ukawibonyera Israeli nguma kwa miaka iwi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
