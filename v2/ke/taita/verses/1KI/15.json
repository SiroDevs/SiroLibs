          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukabonya mawiwi imbiri ya BWANA, ukinugha chia ra ndee, na kaung'a rake iro rerewishekerieghe Waisraeli kubonya kaung'a.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
