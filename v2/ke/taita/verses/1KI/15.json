          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maza iro rerebonyekieghe mwaka ghwa kadadu ghwa kubonya nguma kwa Asa mzuri wa Juda. Niko Baasha ukawuya mzuri wa Israeli wulalo ghwa Nadabu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.28",
            "verseOrgIds": [
              "1KI.15.28"
            ]
          }
