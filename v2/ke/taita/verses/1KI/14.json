              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabonyo mazima ghose gha Mzuri Rehoboamu ghaandikilo andenyi ya Chuo cha Malagho gha Ngelo cha wazuri wa Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korekoghe na wuda ngelo rose aghadi ya Rehoboamu na Jeroboamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
            "verseOrgIds": [
              "1KI.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamu ukafwa, ukarikwa makaburinyi gha weke ndee mzinyi ghwa Daudi. Mae orewangwagha Naama Muamoni; mwana wake Abijamu ukabonya nguma wulalo ghwake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.31",
            "verseOrgIds": [
              "1KI.14.31"
            ]
          }
