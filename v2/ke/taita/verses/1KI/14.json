          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukawusa mali yose ya Hekalu ya BWANA na mali rose rerekoghe andenyi ya ngome ya mzuri. Wokoni ukawusa rija ngao ra dhahabu rerebonyeroghe ni Solomoni, ukaghenda naro.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
