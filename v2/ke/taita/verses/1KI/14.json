          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mzuri Rehoboamu ukabonya ngao ra shaba wulalo ghwaro. Ukariwika rilindiloghe ni Wabaa wa walindiri, awo werelindiagha mbenge ya ngome ya mzuri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kula ngelo mzuri orengiagha Hekalunyi, na walindiri werekoghe wikidwa iro ngao, na kuriwunja sena andenyi ya chumba charo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        }
      ]
