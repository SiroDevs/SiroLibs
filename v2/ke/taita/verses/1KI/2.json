          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Solomoni ukamuinja kwa kazi ya wukohani ghwa BWANA, jipate kukatia jija ilagho ja BWANA jereghoreloghe kwa Eli aja Shilo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.27",
            "verseOrgIds": [
              "1KI.2.27"
            ]
          }
        },
