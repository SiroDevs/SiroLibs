              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.25",
            "verseOrgIds": [
              "1KI.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Mzuri Solomoni ukamzera mkohani Abiathari “Ghenda cha mzinyi mzenyu Anathothi, kwa kukaia yakufwana kufwa. Ela kwa ngelo ihi sichaakubwagha, angu koreidukieghe Sanduku ya Ilaghano ja Bwana MLUNGU imbiri ya aba Daudi, sena kukaja wasi chiamweri na aba.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.26",
            "verseOrgIds": [
              "1KI.2.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
