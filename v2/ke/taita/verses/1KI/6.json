          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sena orebonyereghe mnyango kwa mudi ghwa mzeituni ghorughuka andu kuwi, kwa wundu ghongia Andu kwa Wueli kuchumbie; ukawikiria achi naighu ya kizingiti cha mnyango. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
              "1KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukakota fwana ra makerubi, na mitende, na maua ghisheghelukie aighu ya iyo minyango iwi. Iyo minyango na iro fwana ukarishinga dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.32",
            "verseOrgIds": [
              "1KI.6.32"
            ]
          }
        }
      ]
    },
    {
