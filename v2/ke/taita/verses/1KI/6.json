          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msingi ghwa Hekalu ghoreaghiloghe mori ghwa kawi ghuwangwaghwa Zivu, mwaka ghwa kana ghwa kubonya nguma kwa Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka ghwa ikumi na imweri ghwa kubonya nguma kwa Solomoni, mori ghwa wunyanya ghuwangwaghwa Buli, Hekalu yose ikamerelwa kuaghwa sa iji koni mpango ghwaro ghorekoghe. Ereaghiloghe kwa miaka mfungade.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
