            "number": "33",
            "style": "v",
            "sid": "1KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukabonya fremu ya mnyango ghongia cha Hekalunyi ghwa mbembe inya kwa mudi ghwa mzeituni, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
            "verseOrgIds": [
              "1KI.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "na minyango iwi ekucha ya msumbesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.34",
            "verseOrgIds": [
              "1KI.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukakota fwana ra makerubi aighu ya iyo minyango, na mitende, na maua ghisheghelukie; ukaghishinga dhahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukaagha waza ya nandenyi kwa magho ghiwachilo; kula laini idadu ra magho ghiwachilo ukaisa laini imweri ya mbau ra msida.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        }
      ]
