                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa huwo wandu wa Israeli wichajiwika ituku iji ja Sabato kukaia alama ya ilaghiro na kujitala kwa vivalwa vawo vose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni alama ya kala na kala aghadi ya wandu wa Israeli na ini; angu Ini BWANA nereumbieghe mlungunyi na ndoenyi kwa matuku arandadu, na ituku ja mfungade ngarisigha kazi, ngahoresha.’”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
