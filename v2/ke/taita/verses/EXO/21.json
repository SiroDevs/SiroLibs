        },
        {
          "text": "“Mundu ukamkaba mzumba wake wa womi angu wa waka kwa zobo hata ufo, uchanekwa adhabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.20",
            "verseOrgIds": [
              "EXO.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ikakaia uja mzumba wakaia usefue ituku ja imbiri hata ja kawi, uja BWANA ndechanekwa adhabu ingi, angu uja mzumba ni mali yake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
            "verseOrgIds": [
              "EXO.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
