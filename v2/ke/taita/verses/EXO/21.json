          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iji wandu warashana, na umu umlase mmbao na igho, angu kumkaba na ngonde, nao ikaie ndem'bwaghie, ela wakaia olala wulinyi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.18",
            "verseOrgIds": [
              "EXO.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
