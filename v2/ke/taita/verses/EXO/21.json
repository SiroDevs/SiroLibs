            "number": "19",
            "style": "v",
            "sid": "EXO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "iji wawuka, na ukaie oghenda kwa kuteselwa ni mzata, uo mundu oremkabieghe uchalipa ngelo rake rose orekoghe wulinyi, na kumtesia hata waboa putu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
              "EXO.21.19"
            ]
