          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uo ose uchamkaba mundu na kum'bwagha, uchabwaghwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.12",
            "verseOrgIds": [
              "EXO.21.12"
