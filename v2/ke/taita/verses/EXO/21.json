              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ikakaia mndungi wam'bwagha mundu kwa kidali, hata ngera wakimbiria madhabahunyi kwapo kwa wusalama, uchabwaghwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
