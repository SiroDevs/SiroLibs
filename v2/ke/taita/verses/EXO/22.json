          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mchabonya wokoni kwa njau na bauru renyu. Ichakaianya na mae kwa matuku mfungade, ituku ja wunyanya, mchaifunya ikaie yapo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.30"
            ]
