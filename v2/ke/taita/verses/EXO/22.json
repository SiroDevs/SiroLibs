          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mundu uo ose uchaafunyira milungu mizima vizongona isaakaia ni kwa BWANA moni, utotesho putu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.20",
