                  "text": "Wuk. 18.10-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.18",
            "verseOrgIds": [
              "EXO.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu uo ose ulalagha na nyamandu ubwagho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.19",
            "verseOrgIds": [
              "EXO.22.19"
            ]
          }
        },
