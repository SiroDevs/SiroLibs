          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusakemkita mka mkiwa angu mwana mkiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.22",
            "verseOrgIds": [
              "EXO.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkawikoronga nao winililie, loli nichasikira kililo chawo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.23",
            "verseOrgIds": [
              "EXO.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nani nichajokwa ni machu na kum'bwagha kwa lufu; na waka wenyu wichawuya waka wakiwa, na wana wenyu wichawuya wana wakiwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.24",
            "verseOrgIds": [
              "EXO.22.24"
            ]
          }
        }
