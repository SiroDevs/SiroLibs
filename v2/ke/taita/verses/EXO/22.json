        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kusakemsigha msawi wa waka ukaie moyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.18",
            "verseOrgIds": [
              "EXO.22.18"
            ]
