              "type": "text"
            }
          ]
        },
        {
          "text": "“Kusakemuka kureda mafunyo gha makuwido ghako agheni mecha gha imbiri iji ghakaia tayari. Mchanineka wavalwa wenyu wa imbiri wa womi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.29"
            ]
          }
