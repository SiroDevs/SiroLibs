              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mnyangonyi ghongia cha hemenyi kubonye pazia ya kitani iboie kwa wundu ghwa mnyango ghwa Hema, ilukilo kwa uzi ra buluu, zambarau na ra ngundu; itolelo nicha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.36",
            "verseOrgIds": [
              "EXO.26.36"
            ]
          }
        },
