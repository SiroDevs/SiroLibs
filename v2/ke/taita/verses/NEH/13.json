          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngawilaghira Walawi wikueleshe weni, wichelindia mbenge, wipate kukaia na loli ituku ja Sabato jawikwa jielie.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.22",
            "verseOrgIds": [
