              "type": "text"
            }
          ]
        },
        {
          "text": "Wokoni ngelo ija nerewonieghe kukaia Wayahudi wengi werelowueghe waka wa Ashdodi, Amoni, na Moabu,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.23",
