              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa chia ihi nerewieleshereghe wandu kufuma kula ilagho ja kighenyi; ngawika kazi kwa wakohani, na Walawi kula umu kwa kazi yake. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
