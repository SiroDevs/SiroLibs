          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunikumbuke kwa wundu ghwa agha wori ee Mlungu wapo, na kuniwika nicha karakara na wubaa ghwa lukundo lwako lukatie.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.22",
            "verseOrgIds": [
              "NEH.13.22"
            ]
          }
        }
