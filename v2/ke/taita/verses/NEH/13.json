          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joiada orekoghe mwana wa Mkohani m'baa Eliashibu ela mwana umu wa Joiada oremlowueghe mwai wa Sanbalati, kufuma muzi ghwa Beth-horoni, kwa huwo ngammbinga ufume Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
            "verseOrgIds": [
              "NEH.13.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
