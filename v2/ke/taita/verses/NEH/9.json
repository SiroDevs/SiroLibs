              "NEH.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa wundu ghwa agha ghose ghibonyekie, isi wandu wa Israeli dabonya ilaghano ja loli kwa maandiko, na wabaa wedu, Walawi na Wakohani wajirumiria kwa kujikaba mhuri ghwawo.",
          "type": "text",
          "attrs": {
