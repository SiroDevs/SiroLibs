              "NEH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukumbuke wucha nibonyere kwa awa wandu ee Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.19",
            "verseOrgIds": [
              "NEH.5.19"
            ]
          }
        }
