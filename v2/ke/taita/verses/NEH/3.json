      },
      "items": [
        {
          "text": "Wakohani awo widumikie wurighenyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
              "NEH.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakohani winughagha wereaghieghe sena andu kulazi kwa wurigha luwaru lunughie; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.22",
            "verseOrgIds": [
              "NEH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benjamini na Hashubu wereaghieghe luwaru lunughie kulangaya nyumba rawo. Wokoni Azaria mwana wa Maaseia, wawae Anania ukaagha luwaru lunughie naimbiri ya nyumba yake. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.23",
            "verseOrgIds": [
              "NEH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binui mwana wa Henadadi oreaghieghe luwaru lunughie kufuma nyumba ya Azaria hata mbembenyi ya wurigha. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.24",
            "verseOrgIds": [
              "NEH.3.24"
            ]
          }
        },
        {
          "name": "verse",
