          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palali mwana wa Uzai oreaghieghe kufuma mbembenyi ya wurigha hata mnara ghwa ngome ya lughu ya mzuri kaavui na nyumba ya walindiri. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.25",
            "verseOrgIds": [
              "NEH.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pedaia mwana wa Peroshi oreaghieghe andu kumu cha mashariki kaavui na Mbenge ya Machi na mnara gholindia hekalu. (Aha ni andu kumu kwa muzi kuwangwagha Ofeli andu wadumiki wa Hekalu werekaiagha.)",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waaghi wamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
