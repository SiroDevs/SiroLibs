              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.24",
            "verseOrgIds": [
              "JAS.2.24"
            ]
          }
        },
        {
          "name": "verse",
