          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mando mengi ngidamba, nerekoghe ndengonyi edukwa ni machi medenyi na ndengonyi ya viting'a, na ndengonyi kwa wandu wapo weni, na ndengonyi kwa wandu wa mbari zima, na ndengonyi andenyi ya muzi, na ndengonyi kireti, na ndengonyi baharinyi, na ndengonyi kwa wanidu wa tee.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
