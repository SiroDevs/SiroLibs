          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao iji wawizighana wandu, ukawiwona wasirimwa na kusaghisika, ukawadwa ni wughoma angu werekoghe sa ng'ondi risewadie mlisha ungi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.36",
            "verseOrgIds": [
              "MAT.9.36"
            ]
