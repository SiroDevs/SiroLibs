          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Jesu ukaghenda mizi yose mibaa na mitini, ukifundisha andenyi ya sunagogi rawo na kujichila Ilagho Jiboie ja wuzuri ghwa Mlungu; ukaboisa makongo na manyonge gha mbari rose.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.35",
            "verseOrgIds": [
              "MAT.9.35"
            ]
          }
        },
        {
          "name": "note",
