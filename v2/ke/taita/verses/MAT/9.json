          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukawizera wanughi wake, “Mvono ni mungi, ela wabonyi kazi ni watini.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
            "verseOrgIds": [
              "MAT.9.37"
            ]
          }
        },
        {
