              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata iji werekwaneghe chiaimweri aja Galilaya, Jesu ukawizera, “Mwana wa Mdamu uchafunywa kwa wandu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.22",
            "verseOrgIds": [
              "MAT.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wicham'bwagha, ela ituku ja kadadu ucharuka.” Wanughi wake wikangilwa ni wasi loli-loli.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.23",
            "verseOrgIds": [
              "MAT.17.23"
            ]
          }
        }
      ]
    },
