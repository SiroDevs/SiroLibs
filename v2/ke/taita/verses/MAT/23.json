        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.22",
            "verseOrgIds": [
              "MAT.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ni bugha konyu inyo walimu wa Sharia na Mafarisayo, waji-kuwi! Angu mwafunya ifungu ja ikumi hata kwa mbogha ra malemba ghinukie nicha, na bizari, ela mwasigha agho malagho ghiko gha suti gha Sharia na hachi, na wughoma, na irumirio. Kumangu agha mwaghibonyere, chiaimweri na ghaja mazima wori.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.23",
            "verseOrgIds": [
              "MAT.23.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
