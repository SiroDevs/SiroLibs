          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Hezekia ukamzera Isaya, “Ilagho ja BWANA kwajighora jaboie.” Angu oregheshereghe matuku ghake, “Kuchakaia sere na walindiri.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
