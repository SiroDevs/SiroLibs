              "items": [
                {
                  "text": "Wuf. 6.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA waghora huwu, “Nichaghukaba wurumwengu kwa wundu ghwa wuwiwi ghwake, na wawiwi, kwa wundu ghwa wulaghe-laghe ghwawo; kukukasa kose kwa wandu nichakumeria, na kuwisera awo wikudukie. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nichawibonya wadamu wisigho watini kuchumba dhahabu ieleshero, na watinieri kuchumba dhahabu ya Ofiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.12",
            "verseOrgIds": [
              "ISA.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa huwo nichasughusa mlungunyi, na ndoenyi kuchasughusika hata kufume andu kwaro, ngelo Ini BWANA wa majeshi nichaawonyera machu ghapo ghibirie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.13",
            "verseOrgIds": [
              "ISA.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.13",
            "verseOrgIds": [
              "ISA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Waghenyi wikaiagha Babuloni wichakimbiria mizi yawo, wikisaghisika karakara na shaa ikimbiagha wadiwi; karakara na ng'ondi risewadie mlisha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.14",
            "verseOrgIds": [
              "ISA.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu uo ose uchaawonwa na kuwadwa uchadungwa na lufu hata ufo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.15",
            "verseOrgIds": [
              "ISA.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wawo wichabarilwa ndonyi na kuwaghanyika wikiwona. Wichasokwa vilambo vawo, na waka wawo wichadidikwa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.16",
            "verseOrgIds": [
              "ISA.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.16",
            "verseOrgIds": [
              "ISA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA waghora huwu, “Nichawinyavura Wamedi, wandu wisena bea na feza hata dhahabu, wipate kuikaba Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.17",
            "verseOrgIds": [
              "ISA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wichabwagha wandu wa irika kwa ndana na mawanu ghawo. Ndewichaakaia na wughoma gungi kwa wana wiongagha, hata kuwiwonia wughoma wana watini. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.18",
            "verseOrgIds": [
              "ISA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babuloni nigho wuzuri ghughokie kuchumba mawuzuri ghose; nigho kuboa na kukukasa kwa Wakalidayo, ela ngelo Mlungu uchaaghukumba noko, ghuchakaia sa Sodoma na Gomora.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.19",
            "verseOrgIds": [
              "ISA.13.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24"
              },
              "items": [
                {
                  "text": "Kuz. 19.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.19",
            "verseOrgIds": [
              "ISA.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jingi ndeghuchaakailwa ni wandu kwa vivalwa vose. Muarabu ungi ndechaadunga hema yake aho, hata mlisha ungi ndechaalisha mfugho rake aho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.20",
            "verseOrgIds": [
              "ISA.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela nyamandu ra isakenyi richakaia aho, na nyumba raro richangilwa ni nyamandu rirumagha. Nyagha richakaia aho, na weke mwakuli wichasarigha aho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.21",
            "verseOrgIds": [
              "ISA.13.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
