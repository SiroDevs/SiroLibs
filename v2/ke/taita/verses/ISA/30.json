              "ISA.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonenyi ndighi ra Mlungu rawoneka kufuma kula, riko na modo ghwa machu ghake, ghifukiagha sa mosi, na memu yake ikisughuswa ni lubio lwake; madedo ghake ghiakora sa modo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.27",
            "verseOrgIds": [
              "ISA.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miruke yake ni kara kara na machi mengi ghichue hata singonyi kwa mundu; upate kuriela-ela iro mbari ra wandu na kichungio chake chetotesha, na kuwifunga mkowa momunyi ghowilongoza cha isakenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.28",
            "verseOrgIds": [
              "ISA.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela inyo wandu wa Mlungu, mchakaia na kubora kwa kuboilwa, sa ngelo ya karamu ra matuku ghenyu mabaa gha nakio; mchachulwa ni kuboilwa seji mundu uboilwagha ukikaba msherembe aighu ya mghondi ghwa BWANA, uo uko Mbanga ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.29",
            "verseOrgIds": [
              "ISA.30.29"
            ]
          }
        }
      ]
    },
