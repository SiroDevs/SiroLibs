            "number": "1",
            "style": "v",
            "sid": "ISA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agha ni malagho aighu ya Tiro. Lilenyi inyo mabaharia wa Tarshishi, kwa kukaia muzi ghonyu ghwa Tiro ghwanonwa, hata ndekuwadie nyumba ingi angu bandari, rose ranonwa putu. Mchasikira maza iri kufuma Kupro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        },
        {
