                "loc": "REV.5.5"
              },
              "items": [
                {
                  "text": "Wuf. 5.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.16"
              },
              "items": [
                {
                  "text": "22.16",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wandu wibarishiro wichawuya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituku ijo, uo mundu wa kivalwa cha Jese uchawuka kukaia alama kwa wandu. Wandu wa iro mbari wichamlola, na andu kwake kokaia kuchakaia kwa wubaa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.12"
              },
              "items": [
                {
                  "text": "War. 15.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngelo iyo, BWANA uchaghorua mkonu ghwake indo ja kawi kuwunja masighariko gha wandu wake kufuma Ashuru na kufuma Misri, na kufuma Pathrosi, na kufuma Ethiopia",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.11",
            "verseOrgIds": [
              "ISA.11.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11.11",
              "type": "text"
            },
            {
              "text": "Ethiopia:",
              "type": "text"
            },
            {
              "text": "Kiebrania ni Kushi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na kufuma Elamu, na kufuma Shinari, na kufuma Hamathi, na masanga gha pwani baharinyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.11",
            "verseOrgIds": [
              "ISA.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA uchawusira bendera ikaie alama kwa iro mbari ra wandu, ewonyera kukaia uchatumbanya wandu wa Israeli na wandu wa Juda wisaghisikie, wifume iro mbembe inya ra ndoenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iriso ja Israeli jichasia, na wamaiza wa Juda wichainjwa; Israeli ndechaammbonia Juda iriso, na Juda ndechaamsumbua Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela wichawadana na kuwingiria Wafilisti wiko cha magharibi; wichawikaba na kuwidwa wunyika wandu wa mashariki. Wichawikaba na kuwisima wandu wa Edomu na Moabu, na Waamoni wichakuwika aisi yawo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.14",
            "verseOrgIds": [
              "ISA.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na BWANA uchaghuomera putu mwanya ghwa bahari ya Misri, sena uchawetesha mbeo mbaa eomera, nayo ichaomera Moda ghwa Eufrate na kusighara meda mitini mfungade, idimagha kuruwukwa kwa maghu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.15",
            "verseOrgIds": [
              "ISA.11.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.12"
              },
              "items": [
                {
                  "text": "Wuf. 16.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.15",
            "verseOrgIds": [
              "ISA.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchakaia na chia mbaa kufuma Ashuru, kwa wundu ghwa masighariko gha wandu wake Israeli, sa iji koni werekoghe nayo ngelo werefumagha isanga ja Misri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.16",
            "verseOrgIds": [
              "ISA.11.16"
            ]
          }
        }
      ]
    }
  ],
