            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mndumu uchacha wa kivalwa cha Jese",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11.1",
              "type": "text"
            },
            {
              "text": "Jese:",
              "type": "text"
            },
            {
              "text": "ndee wake Daudi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " sa longe lujokagha akirimbenyi cha mudi luzoghorwagha ni miri yaro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
