            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni uendameria kazi yose ya Hekalu ya BWANA, ukavingira ivo vilambo ndee Daudi oreviwikieghe wakfu; ukawika feza, dhahabu, na vombo vose andenyi ya mali ya Hekalu ya Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        },
        {
