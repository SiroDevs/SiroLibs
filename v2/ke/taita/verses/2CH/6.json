          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "wikahea kwa nia na kwa ngolo yawo yose ahoeni wunyikenyi weredwaloghe, na kulomba wikilangaya cha isangenyi jawo ijo korewinekieghe weke ndee, na ugho muzi kughusaghue, na Hekalu niiaghie ekutasira, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
