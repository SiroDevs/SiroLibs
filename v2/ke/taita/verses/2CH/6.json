          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iji wandu wako wakubonyera kaung'a, (angu ndeuko mndungi usebonyagha kaung'a,) na oho kuwibonyere machu, na kuwibonya wisimo ni wamaiza wawo hata widwalo wunyika isanga ja kula angu ja kaavui, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
