          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iji vua yalema kunya, angu wandu wako wakubonyera kaung'a, wikalomba wikilangaya andu aha, wikirumiria irina jako na kughaluka kufuma kwa kaung'a yawo, angu kwawitirira, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kusikire aho mlungunyi, kuwilekie wadumiki wako, awo wandu wako Israeli kaung'a yawo, ingelo kuwiwonyeragha chia ndicha enugha; nao kuwiredie vua isangenyi ijo kuwinekie wandu wako jikaie ifwa jawo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        }
      ]
