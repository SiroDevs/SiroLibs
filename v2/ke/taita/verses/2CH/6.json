          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iji wandu wako wafuma kwendalwa na wamaiza wawo wudenyi, kwa chia iyo yose kuchaawiduma, nawo wikulombe wikilangaya muzi ughu kughusaghuye, na Hekalu ihi niiaghie ekutasira oho, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
