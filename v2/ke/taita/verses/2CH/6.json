          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na idana ee Mlungu wapo, zighana, kudeghe madu ghako kwa ilombi jawuyalombwa aha.",
          "type": "text",
          "attrs": {
