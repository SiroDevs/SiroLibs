          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "kusikire kufuma mlungunyi andu kukaiagha, agho malombi na kuvoya kwawo, kuwifuye wughoma wandu wako wikubonyere kaung'a, kuwikatishiere seji walomba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
            "verseOrgIds": [
              "2CH.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
