          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wokoni mghenyi useko wa wandu wako Israeli, ukacha kufuma isanga ja kula kwa wundu ghwa irina jako ibaa, na ndighi ra mkonu ghwako ghughorokie, na kulomba ukilangaya Hekalu ihi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kusikire kufuma mlungunyi andu kukaiagha, kubonye kunughana na agho ghose uo mghenyi wakulomba, eri wandu wose ndoenyi wipate kukumanya na kukuobua sa wandu wako Israeli, na kumanya angu Hekalu ihi niiaghie ni andu kokutasira aho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        }
      ]
    },
