          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao aeni aho isangenyi widwalo wunyika wihee na kukuvoya wikighamba ‘Dabonyere kaung'a dikalaghaya na kubonya kiwiwi;’ ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
