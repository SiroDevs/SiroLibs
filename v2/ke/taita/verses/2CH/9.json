        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabonyo ghose mazima gha Solomoni kufuma kuzoya hata kutua, ghaandikilo andenyi ya historia ya mlodi Nathani, na andenyi ya wulodi ghwa Ahija wa Shilo na andenyi ya mawono gha Ido uo mmboni, na wokoni malagho aighu ya Jeroboamu mwana wa Nebati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni orebonyereghe nguma Jerusalemu aighu ya Israeli yose kwa miaka mirongo ina. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Solomoni ukafwa, ukarikwa andenyi ya muzi ghwa ndee Daudi, na mwana wake Rehoboamu ukabonya nguma wulalo ghwake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
          }
        }
      ]
