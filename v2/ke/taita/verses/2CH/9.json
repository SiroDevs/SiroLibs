          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mzuri oreitalieghe feza kukaia sa kilambo icho chose Jerusalemu, sa magho, na misida ikakaia sa miku ya Shefela kwa wungi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ukareda farasi rereredeloghe kufuma Misri na kufuma masanga ghose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
            "verseOrgIds": [
              "2CH.9.28"
            ]
          }
