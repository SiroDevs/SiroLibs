          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huwo niko kazi rose ra Solomoni reremereloghe kufuma ituku msingi ghwa Hekalu ya BWANA ghuaghilo, hata ituku imerelo. Kwa huwo Hekalu ya BWANA ikamerelwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Solomoni ukaghenda Ezion-geberi, na Elathi iko mbai-mbai ya bahari isanga ja Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.17",
            "verseOrgIds": [
              "2CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huramu ukamdumia meli na wadumiki wilisane na bahari, nawo chiaimweri na wadumiki wa Solomoni wikaghenda cha Ofiri; wikaduka dhahabu kufuma aho ichumbagha kilo elfu ikumi na isanu, wikamredia Mzuri Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        }
      ]
    }
