              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunughana na mafundisho gha ndee Daudi, orewikieghe vipughi va wakohani kwa wundu ghwa wudumiki ghwawo, na Walawi kwa kazi ya kukasa na wudumiki ghotesia wakohani seji erekundikieghe kula ituku; na walindiri mbenge kwa vipughi vawo kunughana na seji mbenge rerekoghe ndazi; angu huwo niko Daudi mundu wa Mlungu orelaghirieghe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata ndeweresighieghe ilagho jingi jisebonyero ja agho mzuri orewilaghirieghe wakohani na Walawi aighu ya ilagho jingi ijo jose, na aighu ya maza ra mali.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
