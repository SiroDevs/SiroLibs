        },
        {
          "text": "Amazia mwana wa Joashi mzuri wa Juda, orekaieghe moyo miaka ikumi na misanu nyuma ya kifwa cha Joashi mwana wa Jehoahazi mzuri wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
