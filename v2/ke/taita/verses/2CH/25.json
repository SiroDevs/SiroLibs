          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malagho mazima gha mabonyo gha Amazia kufuma kuzoya hata kutua, ghaandikilo andenyi ya Chuo cha Wazuri wa Juda na Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
