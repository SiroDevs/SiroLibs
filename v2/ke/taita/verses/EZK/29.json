              "type": "text"
            }
          ]
        },
        {
          "text": "Ituku ja ikumi na iwi, ja mori ghwa ikumi, mwaka ghwa ikumi ghwa kudwalwa wunyika kodu, BWANA oreghorieghe nani ukighamba,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
