              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukaghora nani ukighamba, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.23",
            "verseOrgIds": [
              "EZK.33.23"
