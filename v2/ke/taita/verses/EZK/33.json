          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luma lwa kenyi, imbiri ya uo mkimbii usechee, nerekoghe ngisikira ndighi ra BWANA; nakesho yaro, iji uo mkimbii orechieghe, BWANA ukafungua momu ghwapo nidede.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.22",
            "verseOrgIds": [
              "EZK.33.22"
            ]
          }
        }
      ]
    },
