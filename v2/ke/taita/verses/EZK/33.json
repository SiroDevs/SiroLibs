          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.20",
            "verseOrgIds": [
              "EZK.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituku ja kasanu ja mori ghwa ikumi, mwaka ghwa ikumi na iwi ghwa kudwalwa wunyika kodu, mndumu ufufunukie kufuma Jerusalemu ukanichea ukaghamba, “Muzi ghwamerie kuwadwa.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.21",
            "verseOrgIds": [
              "EZK.33.21"
            ]
          }
        },
