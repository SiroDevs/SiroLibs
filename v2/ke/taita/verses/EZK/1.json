            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aisi ya mawingunyi, mawawa gha rija nyamandu gherekoghe ghaghorolwa, kula jimu cha kwa mmbao; na kula nyamandu, erekoghe na mawawa ghamu awi ghekufinikira mumbi ghwake. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.23",
            "verseOrgIds": [
              "EZK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata iji rerekoghe rikighenda, neresikireghe lwaka lwa mawawa ghawo sa lwaka lwa machi mengi, sa lukuwa lwa Uo Uwadie Ndighi Rose; ndoghoi yaro sa lwaka lwa ijeshi. Ngelo rakaia kimusi, rikakucha mawawa ghawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        },
