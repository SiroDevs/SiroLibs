              "type": "text"
            }
          ]
        },
        {
          "text": "Sa lusenge lwa vua luko mawingunyi ngelo ya vua kunya, niko uko kung'ala-ng'ala kwaro korekoghe kwammara chia rose.",
          "type": "text",
          "attrs": {
