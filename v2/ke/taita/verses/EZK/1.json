          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naighu ya vongo va iro nyamandu riko moyo, korekoghe na kilambo chiwonekagha sa mawingunyi ching'alaa-ng'ala sa kilole chielie nandighi chialilo naighu ya vongo vawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.22",
            "verseOrgIds": [
              "EZK.1.22"
            ]
          }
        },
        {
