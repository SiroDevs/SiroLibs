                "loc": "LEV.19.30"
              },
              "items": [
                {
                  "text": "Wal. 19.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.2"
              },
              "items": [
                {
                  "text": "26.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.8",
            "verseOrgIds": [
              "EZK.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weko wandu kwako wikufunyire kughora tee kwa kubwagha wandu. Wamu wiaja vizongona vifunyiro kwa milimu a mighondinyi, na kubonya maza ra wulaki aghadi konyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.9",
            "verseOrgIds": [
              "EZK.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koko na wandu aghadi konyu wilalagha na weke mka-ndee, na wamu wiatumia ndighi kulala na waka wiseelie wiko merinyi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.10",
            "verseOrgIds": [
              "EZK.22.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.7+LEV.18.8+LEV.18.9+LEV.18.10+LEV.18.11+LEV.18.12+LEV.18.13+LEV.18.14+LEV.18.15+LEV.18.16+LEV.18.17+LEV.18.18+LEV.18.19+LEV.18.20"
              },
              "items": [
                {
                  "text": "Wal. 18.7-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.10",
            "verseOrgIds": [
              "EZK.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mndumu uasela na muka wa mmbao na umu ualala na mka-mwanwake, umu ualala na mruna uvalo ni mka-ndee. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.11",
            "verseOrgIds": [
              "EZK.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andenyi kwako wandu wamu wadatuwa wibwaghe wandu. Mwadaboilwa kuwivara wambenyu fwaida kwa kuwikoronga, nenyo mwaniliwa ini Bwana MLUNGU.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.12",
            "verseOrgIds": [
              "EZK.22.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
