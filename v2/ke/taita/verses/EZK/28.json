          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukaghamba, “Wandu wa Israeli ndewichaakaia na wambao wangi sena wewisumbua sa mtaranganga ghowirambua, angu sa munjwa ghowidunga. Nawo wichamanya kukaia ini ne Bwana MLUNGU.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        }
      ]
    },
