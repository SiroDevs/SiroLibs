          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana MLUNGU waghamba huwu, “Ngelo nichaawitumbanya wandu wa Israeli kufuma andu kose kwa awo wandu nerekoghe nawisaghisa, na kuwonyera wueli ghwapo aghadi ya iro mbari ra wandu, wichakaia isangenyi jawo jeni, ijo neremnekieghe mdumiki wapo Jakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.25",
            "verseOrgIds": [
              "EZK.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawo wichakaia banana andenyi ya ijo isanga; wichaagha nyumba na kuwa mizabibu. Wichakaia banana ingelo nichaatanya awo wambao werewikitagha; nawo wichamanya kukaia ini ne Bwana MLUNGU.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.26",
            "verseOrgIds": [
              "EZK.28.26"
            ]
          }
        }
