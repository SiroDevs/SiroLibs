            "sid": "EZK 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukaghora nani sena ukighamba, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.1",
            "verseOrgIds": [
              "EZK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iji ikatanisho kwawuyajitumia aighu ya isanga ja Israeli, kutambua kwaro niki, ja kughaba ‘Wavi wajie zabibu mbishi, na wana wikawadwa ni changarari?’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
