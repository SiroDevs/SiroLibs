                "loc": "JER.31.29"
              },
              "items": [
                {
                  "text": "Jer. 31.29",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sa iji nikaiagha moyo, ini Bwana MLUNGU naghamba ndemchaatumia iji ikatanisho sena andenyi ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.3",
            "verseOrgIds": [
              "EZK.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olenyi roho rose ni rapo, roho ya aba na roho ya mwana wori; na roho ibonyagha kaung'a niyo ifwagha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.4",
            "verseOrgIds": [
              "EZK.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.4",
            "verseOrgIds": [
              "EZK.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngera mundu wa hachi, wabonya agho ghiko gha hachi na loli, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.5",
            "verseOrgIds": [
              "EZK.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikaie ndejagha vindo vafunywa kizongona kwa milimu mighondinyi, nao ndeitasagha iyo milimu ya Israeli, hata ndemlushagha muka wa mmbao, angu kumuadada muka uko merinyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usekorongagha mndungi, ela wadammbunjira msile wake icho orechiwikieghe wufunga; ndesokagha, ela wadamneka vindo uo uko na njala, na kumneka nguwo uo uko na zuna. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usekopeshagha ukisuwiria fwaida, angu kuwusa machurio ghangi, na kukumazira usebonye mawiwi; ela wadatanya hachi aghadi ya mundu na mmbao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadaghenda kwa kunugha sharia rapo, na kuilindia memu yapo; uo ni mhachi, nao loli uchakaia moyo, Ini Bwana MLUNGU naghamba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Wal. 18.5",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mundu uo ukava mwana wa womi, nao uwuye kiting'a, angu m'bwaghi wandu, angu kubonya maza rifwane sa iro ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.10",
            "verseOrgIds": [
              "EZK.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndee usereribonyagha, reja vindo vifunyiro kizongona kwa milimu mighondinyi, na kumlusha muka wa mmbao; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.11",
            "verseOrgIds": [
              "EZK.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kumkoronga mkiwa usowagha, na kusoka, usewunjagha wufunga ghwa kilambo orekopeshereghe, utasagha milimu na kubonya wuchafu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadakopesha ukikunda fwaida na kuwusa machurio; welee, mundu wa huwu wadima kukia? Hata, ndedimagha kukia. Mundu wa huwo ndedimagha kukaia moyo; wameria kubonya maza rose ra wuchafu, nao loli uchafwa, na kifwa chake chichamlawia moni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.13",
            "verseOrgIds": [
              "EZK.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.13",
            "verseOrgIds": [
              "EZK.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ela uhu mundu umu wa kawi, umoni ubonyere wuwiwi, ukava mwana wa womi uwonagha kaung'a rose rerebonywagha ni ndee, nao uobuo kuribonya sa ndee, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.14",
            "verseOrgIds": [
              "EZK.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "usejagha vindo vifunyiro kizongona kwa milimu mighondinyi, angu kutasa milimu ya wandu wa Israeli, uselushagha muka wa mmbao, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.15",
            "verseOrgIds": [
              "EZK.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "usemkoseragha mndungi, angu kuwusa wufunga kwa wundu ghwa kilambo chingi, angu kusoka; ela wadaneka mkiwa vindo, na kumneka nguwo mundu uko zuna. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usekunde kubonya kiwiwi, usekopeshagha ukikunda fwaida angu kuwusa machurio, ela wadaritala sharia rapo na kuikatisha memu yapo; ndechaafwa kwa wundu ghwa kaung'a ra ndee, ela kwa loli uchakaia moyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ndee, kwa kukaia orekufungishireghe ndighi kukita, ukamsoka mruna na kubonya agho ghiseboie mesonyi kwa wandu wake; ola uchafwa kwa wundu ghwa wuwiwi ghwake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.18",
            "verseOrgIds": [
              "EZK.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.18",
            "verseOrgIds": [
              "EZK.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ela sena kwaawuyakotia, ‘Kwaki mwana usakabwaa kwa wundu ghwa mawiwi gha ndee?’ Mwana ukabonya agho ghikundwagha ni sharia na gha hachi, nao ulindie sharia rapo na memu yapo yose, loli uchakaia moyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.19",
            "verseOrgIds": [
              "EZK.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu ubonyagha kaung'a uchafwa. Mwana ndechaalipilwa kaung'a ra ndee, hata ndee mwana ndechaalipilwa kaung'a ra mwana. Mundu wa hachi uchalipwa gha hachi; na mundu mmbiwi uchalipilwa gha wuwiwi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.20",
            "verseOrgIds": [
              "EZK.18.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.16"
              },
              "items": [
                {
                  "text": "Wuk. 24.16",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.20",
            "verseOrgIds": [
              "EZK.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ela mundu mmbiwi ukaghaluka na kusigha kaung'a rake rose oreribonyereghe, na kuriwadia sharia rapo, na kubonya agho ghiko gha loli na gha hachi, loli uchakaia moyo, ndechaafwa anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.21",
            "verseOrgIds": [
              "EZK.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndekuwadie ikosa jingi jake jichaakumbukwa, ja agho mawiwi ghose oreghibonyereghe, ela uchadua moyo kwa wundu ghwa hachi yake uibonyere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.22",
            "verseOrgIds": [
              "EZK.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwani naboilwagha ni kifwa cha mndungi mmbiwi? Waghamba Bwana MLUNGU. Kuchumba nandighi nakunde ughaluke na kusigha wuwiwi ghwake, ukaie moyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.23",
            "verseOrgIds": [
              "EZK.18.23"
            ]
          }
        }
      ]
    },
