              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kula jimu jaro jerekoghe na mawushu ana, na mawawa ana; na aisi ya agho mawawa korekoghe na vilambo viwonekagha sa mikonu ya wadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.21",
