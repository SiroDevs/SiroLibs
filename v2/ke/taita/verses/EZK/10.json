        },
        {
          "text": "Iro ni rija nyamandu reni nereriwonieghe riko nandonyi ya Mlungu wa Israeli aho Moda ghwa Kebari, ngawimanya kukaia awo ni makerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.20",
            "verseOrgIds": [
              "EZK.10.20"
            ]
          }
        },
        {
