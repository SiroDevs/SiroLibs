        "style": "s1"
      },
      "items": [
        {
          "text": "BWANA kuwikaba Wamisri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
