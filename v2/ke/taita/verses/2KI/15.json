          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabonyo ghose gha Pekahia ubonyere ghaandikilo andenyi ya Chuo cha Malagho gha Ngelo cha Wazuri wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.26",
