          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "M'baa wake wa majeshi Peka mwana wa Remalia ukam'bonyera sheshe na wandu mirongo misanu wa Gileadi; ukam'bwagha Pekahia aja Samaria ngomenyi kwa mzuri, ukabonya nguma wulalo ghwake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
