          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Pulu mzuri wa Ashuru ukajikaba isanga ja Israeli, na Menahemu ukamneka Pulu talanto elfu imweri ra feza eri umtesie kumangisha wuzuri ghwake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.19",
            "verseOrgIds": [
              "2KI.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemu orepatireghe pesa iri rose kwa kuwishingira wandu wiko na mali isangenyi kwake, wifunye vibelele va feza mirongo misanu kula umu, wimneke mzuri wa Ashuru. Aho niko mzuri wa Ashuru ukaghaluka na kusigha kusumbua ijo isanga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.20",
            "verseOrgIds": [
              "2KI.15.20"
            ]
          }
        }
      ]
