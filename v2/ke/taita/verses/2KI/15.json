          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabonyo ghose gha Peka oreghibonyereghe, ghaandikilo andenyi ya Chuo cha Malagho gha Ngelo cha Wazuri wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.31",
