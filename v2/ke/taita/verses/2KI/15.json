            }
          ]
        },
        {
          "text": "Mwaka ghwa mirongo idadu na ikenda ghwa kubonya nguma kwa Uzia mzuri wa Juda, niko Menahemu mwana wa Gadi orezoeghe kuwibonyera nguma Israeli. Ukabonya nguma Samaria kwa miaka ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.17",
            "verseOrgIds": [
              "2KI.15.17"
            ]
          }
        },
        {
