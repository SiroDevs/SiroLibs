              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukabonya mawiwi imbiri ya BWANA, hata nderetaneghe na kaung'a ra Jeroboamu mwana wa Nebati, kwa iro, orewishekerieghe Israeli kungia kaung'enyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
