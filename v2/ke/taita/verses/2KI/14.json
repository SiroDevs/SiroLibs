          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwa kukaia BWANA ndeghemie jingi wei uchajivuta irina ja Israeli ndoenyi kose, niko ukawikira kwa kumtumia Jeroboamu mwana wa Joashi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        }
