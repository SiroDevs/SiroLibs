              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA orekoghe wawona kutirirwa kwa Israeli seji kwakaia kubaa, kwa kukaia ndekoresigharikieghe mndungi useko na wasi ukaiagha mzumba angu mkitina; hata ndekorekoghe na mndungi owitesia Israeli anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.26",
            "verseOrgIds": [
              "2KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
