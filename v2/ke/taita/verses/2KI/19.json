          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Senakeribu mzuri wa Ashuru ukafuma ukaghala, na kukaia Nineve. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.36",
            "verseOrgIds": [
              "2KI.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
