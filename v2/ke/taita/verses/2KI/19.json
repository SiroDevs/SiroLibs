          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu uchawuya kwa iyo chia cheni orechieghe nayo, hata na jingi ndechaangia ughu muzi, ini BWANA naghamba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.33",
            "verseOrgIds": [
              "2KI.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kukaia nichaghulindia ughu muzi nipate kughukira kwa wundu ghwapo, na kwa wundu ghwa mdumiki wapo Daudi.’”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.34",
            "verseOrgIds": [
              "2KI.19.34"
            ]
          }
        }
      ]
    },
