          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elaima, kundenyi agho manosi ghiko mabaa. Na sena, nichammbonyera chia iboie kuchumba.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.31",
