{
  "id": "1CO.12",
  "number": "12",
  "bookId": "1CO",
  "reference": "1 Wakorintho 12",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
