          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini Paulo, naandika voro iri kwa mkonu ghwapo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.21",
            "verseOrgIds": [
              "1CO.16.21"
            ]
          }
        },
