  "copyright": "PUBLIC DOMAIN",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1CH 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kivalwa cha Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Juda ni: Perezi, Hezroni, Karmi, na Shobali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.1",
            "verseOrgIds": [
              "1CH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reaia mwana wa Shobali oremvaeghe Jahathi, na Jahathi ukamva Ahumai na Lahadi. Awa werekoghe wa kinyumba cha Wasorathi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.2",
            "verseOrgIds": [
              "1CH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Etamu ni: Jezreeli, Ishma, na Idibashi, na mruna wa waka orewangwagha Hezelelponi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.3",
            "verseOrgIds": [
              "1CH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Penueli oremvaeghe Gedori, na Ezori ukamva Husha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.4",
            "verseOrgIds": [
              "1CH.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.4",
            "verseOrgIds": [
              "1CH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuri uo oremvaeghe Tekoa, orekoghe na waka wawi: Hela na Naara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.5",
            "verseOrgIds": [
              "1CH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naara oremvaieghe Ahuzamu, Heferi, Temeni, na Haahashtari. Awo niwo werekoghe wana wa Naara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.6",
            "verseOrgIds": [
              "1CH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Hela ni: Serethi, Ishari, na Ethnani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.7",
            "verseOrgIds": [
              "1CH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakozi oremvaeghe Anubu, na Soleba na wandu wa kinyumba cha Aharheli mwana wa Harumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.8",
            "verseOrgIds": [
              "1CH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabeshi orekoghe na ishima kuchumba waruna; na mae ukammbanga Jebeshi ukighamba “Ni angu neremvaeghe kwa luwawo.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.9",
            "verseOrgIds": [
              "1CH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabeshi ukammbanga Mlungu wa Israeli ukighamba, “Nirasimie kunichurie isanga; nifungishe ndighi, na kunilindia nisepato ni ilagho jingi jizamie.” Mlungu ukamneka icho orelombieghe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.10",
            "verseOrgIds": [
              "1CH.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vinyumba vimu vizima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.10",
            "verseOrgIds": [
              "1CH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu, uo mruna Shuha, oremvaeghe Mehiri; uo omremvaeghe Eshtoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.11",
            "verseOrgIds": [
              "1CH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshtoni ukamva Beth-rafa na Pasea, na Teshina, uo oremvaeghe Irnahashi. Awa niwo wandu werekaieghe Reka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.12",
            "verseOrgIds": [
              "1CH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Kenazi ni: Othinieli na Seraia. Na wana wa Othinieli ni: Hathathi na Meonathai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.13",
            "verseOrgIds": [
              "1CH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meonathai oremvaeghe Ofra, na Seraia ukamva Joabu uo orezoeghe muzi ghwa Geharashimu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.14",
            "verseOrgIds": [
              "1CH.4.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4.14",
              "type": "text"
            },
            {
              "text": "Geharashimu:",
              "type": "text"
            },
            {
              "text": "kutambua kwaro ni Vololo ya mafundi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nawo wewangiloghe huwo angu werekoghe mafundi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.14",
            "verseOrgIds": [
              "1CH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Kalebu mwana wa Jefune: Iru, Ela, na Naamu; na Ela ukamva Kenazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.15",
            "verseOrgIds": [
              "1CH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Jehaleleli ni: Zifu, Zifa, Tiria na Asareli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.16",
            "verseOrgIds": [
              "1CH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Esra ni: Jetheri, Meredi, Eferi, na Jaloni. Awa niwo wana wa Bithia mwai wa mzuri wa Misri uo Meredi oremlowueghe; wikava mwai Miriamu, na wana wawi Shamai, na Ishba uo orezoeghe muzi ghwa Eshtemoa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.17",
            "verseOrgIds": [
              "1CH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mkake wa Kiyahudi oremvaeghe Jeredi uo orezoeghe muzi ghwa Gedori, na Heberi uo orezoeghe muzi ghwa ndee ghwa Soko, na Jekuthieli uo orezoeghe muzi ghwa Zanoa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.18",
            "verseOrgIds": [
              "1CH.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.18",
            "verseOrgIds": [
              "1CH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hodia oremlowueghe mruna Nahamu. Kivalwa chake nicho chiwurie Wagarmi wikaiagha muzi ghwa Keila, na Wamaaka wikaiagha muzi ghwa Eshtemoa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.19",
            "verseOrgIds": [
              "1CH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Shimoni ni: Amoni, Rina, Ben-hanani, na Tiloni. Wana wa Ishi ni: Zohethi na Ben-zohethi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.20",
            "verseOrgIds": [
              "1CH.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kivalwa cha Shela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.20",
            "verseOrgIds": [
              "1CH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Shela uo mwana wa Juda ni: Eri uo orezoeghe muzi ghwa Leka; Laada uo orezoeghe muzi ghwa Maresha; icho kichuku chilukagha kitani, chikaiagha muzi ghwa Beth-ashbea. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.21",
            "verseOrgIds": [
              "1CH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jokimu na wandu awo werewilowueghe waka wa Kimoabu na kukaia Bethlehemu. (Mizango ihi ni ya kala na ndighi) ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.22",
            "verseOrgIds": [
              "1CH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa wedeeka ni wandu wa Netaimu na Gederi wevimba wongo; wikadua aho wikibonya kazi ya mzuri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.23",
            "verseOrgIds": [
              "1CH.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kivalwa cha Simeoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.23",
            "verseOrgIds": [
              "1CH.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Simeoni ni: Nemueli, Janini, Jaribu, Zera na Shauli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.24",
            "verseOrgIds": [
              "1CH.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumu ni mwana wa Shauli wawae Mibsamu, na wawae wa madafu Mishma. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.25",
            "verseOrgIds": [
              "1CH.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Mishma ni: Hamueli, uo oremvaeghe Zakuri, ndee Shimei. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.26",
            "verseOrgIds": [
              "1CH.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei orekoghe na wana wa womi ikumi na warandadu na wa waka warandadu; ela waruna ndewerekoghe na wana wengi, hata kinyumba cha mzawo ndecherechurikieghe sa wandu wa Juda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.27",
            "verseOrgIds": [
              "1CH.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.27",
            "verseOrgIds": [
              "1CH.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
