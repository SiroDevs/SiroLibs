            "sid": "1CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji Daudi waghosia nandighi, orem'bonyereghe mwana wake Solomoni kukaia mzuri wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.1",
            "verseOrgIds": [
              "1CH.23.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
