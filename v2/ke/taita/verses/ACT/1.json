          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwade wulalo ghwa kazi na wudumi ghwa Juda ughusighie na kughenda andu kwake koni.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.25",
            "verseOrgIds": [
              "ACT.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikakaba kura, nayo ikamghuya Mathia, nao ukatalwa andwamweri na waja wadumi ikumi na umweri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.26",
