              "type": "text"
            }
          ]
        },
        {
          "text": "kufuma ngelo ra wubaputizo ghwa Johane hata ituku oredwaloghe nokoighu kufuma kodu, suti ukaie mshahidi wa kuruka kwake andwamweri nesi.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.22",
