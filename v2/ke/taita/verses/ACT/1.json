              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwa huwo, mndumu wa awa wandu wereduanyeghe nesi ngelo rose Bwana Jesu orekoghe aghadi kodu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.21",
            "verseOrgIds": [
              "ACT.1.21"
