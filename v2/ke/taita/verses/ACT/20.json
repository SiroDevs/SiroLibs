          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "wikiwawa kuchumba kwa wundu ghwa agho malagho orededieghe wei ndewichaammbona sena. Niko wikamfumira hata melinyi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.38",
