{
  "id": "ACT.5",
  "number": "5",
  "bookId": "ACT",
  "reference": "Mabonyo Gha Wadumi 5",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
