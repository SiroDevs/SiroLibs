          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao wikawada maghesho gha Gamalieli, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.39",
            "verseOrgIds": [
              "ACT.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "wikawiwanga wadumi wingie, wikawikaba na kuwilaghira wiseghore ilagho jingi kwa irina ja Jesu, wikawisigha wighende. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.40",
            "verseOrgIds": [
              "ACT.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko wikafuma mwandunyi wikiboilwa, angu watalwa kukaia wifwane kusowelwa ishima kwa wundu ghwa irina ijo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.41",
            "verseOrgIds": [
              "ACT.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ituku ituku, Hekalunyi na nyumbenyi ndeweresighieghe kumchila Jesu kukaia Kristo anduangi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.42",
            "verseOrgIds": [
              "ACT.5.42"
            ]
          }
        }
      ]
