              },
              "items": [
                {
                  "text": "Mab. 13.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.38",
            "verseOrgIds": [
              "ACT.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawuka nganyi mbaa, hata wikatana; Barnaba ukamdwa Marko wikadamba kwa bahari kughenda Kupro, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.39",
            "verseOrgIds": [
              "ACT.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "ela Paulo ukamsaghua Sila, nao umeria kulombelwa mvono ghwa Bwana ni wanidu, ukafuma ukaghenda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.40",
            "verseOrgIds": [
              "ACT.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
