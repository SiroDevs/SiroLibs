              },
              "items": [
                {
                  "text": "Kuz. 25.29-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.36",
            "verseOrgIds": [
              "GEN.27.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
