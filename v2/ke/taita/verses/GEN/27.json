          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idana sikira malagho ghapo mwanwapo. Wuka kukimbirie kwa mwanidu Labani uko Harani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.43",
            "verseOrgIds": [
              "GEN.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukaie aho kutini hata machu gha mwanyinyu ghasia, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.44",
            "verseOrgIds": [
              "GEN.27.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 27:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "na lubio lwake luinjike, na kughiliwa agho ghose kum'bonyere. Niko aho nichakudumiria kuwuye. Nisowekelwa wada ni wana kwa ituku jimweri?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.45",
            "verseOrgIds": [
              "GEN.27.45"
            ]
