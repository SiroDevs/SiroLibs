          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau ukaghamba, “Ado loli ukawangwa Jakobo si hachi! Iji ni indo ja kawi Jakobo ukinikalia; ja imbiri oonisoka hachi ya kuvalwa kwapo kwa imbiri, nao ola hoku sena wanisoka irasimio japo.” Nao ukamkotia ndee, “Ndekunisighie irasimio jingi aba?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.36",
            "verseOrgIds": [
              "GEN.27.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
