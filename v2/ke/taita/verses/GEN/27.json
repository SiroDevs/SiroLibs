          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Rebeka ukaghorelwa malagho gha Esau mwana wake wa imbiri, nao ukaduma ukammbanga Jakobo mwana wake mtini ukamzera, “Ola mwanyinyu Esau wawuyahoresha ngolo yake kwa kubonya mpango ghokubwagha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.42",
            "verseOrgIds": [
              "GEN.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
