        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.35",
            "verseOrgIds": [
              "GEN.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
