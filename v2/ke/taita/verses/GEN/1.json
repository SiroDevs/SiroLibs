        },
        {
          "text": "Nao Mlungu ukaumba mdamu kwa fwana yake cheni, kwa fwana ya Mlungu ukawiumba mundu wa womi na wa waka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
