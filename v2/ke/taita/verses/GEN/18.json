          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu ukaghamba, “Kusejoko ni machu BWANA, nichadeda iji indo jimweri tu. Kukawikua ikumi uko ni wada?” Nao ukaghamba, “Kwa wundu ghwa ikumi sichaatotesha anduangi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
