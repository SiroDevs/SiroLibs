        },
        {
          "text": "BWANA waghamba, “Wandu wa Dameshki wabonyere kaung'a sena na sena; kwa wundu ugho nichawikaba. Wakorongie wandu wa Gileadi kwa lung'eto lubaa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
