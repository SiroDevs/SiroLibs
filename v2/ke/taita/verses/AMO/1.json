                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa huwo nichaduma modo ghukore ngome rereaghiloghe ni Mzuri Hazaeli, nagho ghuchakora ngome ra muzi ghwa Mzuri Ben-hadadi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.4",
            "verseOrgIds": [
              "AMO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nichachikanya mbenge ra Dameshki, na kuwibwagha wandu wikaiagha andenyi ya Vololo ya Aveni,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.5",
              "type": "text"
            },
            {
              "text": "Aveni:",
              "type": "text"
            },
            {
              "text": "kutambua kwaro ni Wuwiwi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na m'bonyi nguma ufumagha Beth-aveni. Wandu wa Siria wichadwalwa wunyika cha Kiri.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
