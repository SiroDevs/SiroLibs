              },
              "items": [
                {
                  "text": "Isa. 17.1-3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.49.23+JER.49.24+JER.49.25+JER.49.26+JER.49.27"
              },
              "items": [
                {
                  "text": "Jer. 49.23-27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.9.1"
