  "reference": "1 Wathesalonike 5",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
