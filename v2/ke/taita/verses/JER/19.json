              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukaghamba, “Ghenda kughuo mtungi ghwa wongo ghwa mvimbi, sena kudo wabaa wamu wa wandu na wakohani wamu wa kala, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.1",
            "verseOrgIds": [
              "JER.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwendanye vololo ya Hinomu kwa kuidiria Mbenge ya Chuwigha, kupate kughora agho malagho nichaakughoria.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.2",
            "verseOrgIds": [
              "JER.19.2"
            ]
          }
        },
        {
