              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.2",
            "verseOrgIds": [
              "JER.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchaghamba, ‘Sikirenyi malagho gha BWANA ee Wazuri wa Juda na wandu mkaiagha Jerusalemu; BWANA wa majeshi, uo Mlungu wa Israeli waghamba: Ola nichareda wuwiwi aighu ya andu aha, ugho, hata wandu wikasikira wichaturukia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.3",
            "verseOrgIds": [
              "JER.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kukaia wandu wanisighie, na kukunona andu aha kwa kuifukiria milungu mizima marumba, iyo wiseiichi, hata weke ndee, hata wazuri wa Juda wiseiichi; na andu aha wakunonie kwa kudia bagha ra wandu wisewadie ikosa jingi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.4",
            "verseOrgIds": [
              "JER.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuagha madhabahu kwa wundu ghwa Baali, wipate kukora wana wawo wa womi aighu modonyi wikaie sa kizongona chekora; ilagho jingi nisewizerie hata kujighora, hata jingi nisejighesha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.5",
            "verseOrgIds": [
              "JER.19.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.21"
              },
              "items": [
                {
                  "text": "Wal. 18.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.5",
            "verseOrgIds": [
              "JER.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa huwo ini BWANA naghamba kukaia, matuku ghichacha, andu aha kusechaawangwa sena Tofethi angu Vololo ya Hinomu; ela kuchawangwa Vololo ya Machinjo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.6",
            "verseOrgIds": [
              "JER.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mipango wereibonyereghe wandu wa Juda na Jerusalemu andu aha nichainona, na kuwibonya wandu wawo wibwagho wudenyi ni wamaiza wawo, na awo wilolagha kughitotesha marangi ghawo. Nicharineka nyonyi ra mbeonyi na nyamandu ra isakenyi gharia ra mimbi yawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.7",
            "verseOrgIds": [
              "JER.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na muzi ughu nichaghubonya ghuzomelo na kushinikilwa ni kula mundu uidagha, kwa wundu ghwa uko kunoneka kwaro. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.8",
            "verseOrgIds": [
              "JER.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani nichawibonya wije nyama ra wana wawo wa womi na wa waka. Kula mundu uchaja nyama ya mmbao kwa wundu ghwa wasi ghwa uko kurughailwa ni awo wabwaghi wawo wighilolagha marangi ghawo.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Niko kuchaghubara ghuja mtungi imbiri ya waja wandu mkwanye, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.10",
            "verseOrgIds": [
              "JER.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuwizere, BWANA wa majeshi waghamba huwu, ‘Huwu niko nichaawibara awa wandu na ughu muzi, seji mundu ubaragha mtungi ghwa mvimbi, hata ghusedime kuwuyavimbwa sena. Wandu wicharika wandu wawo Tofethi, kwa kusowa andu kungi kuzima korikia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.11",
            "verseOrgIds": [
              "JER.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huwo niko nichaakubonya andu aha chiaimweri na wandu wikaiagha andenyi yaro. Nichaghubonya ughu muzi karakara na Tofethi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.12",
            "verseOrgIds": [
              "JER.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nyumba ra Jerusalemu na nyumba ra wazuri wa Juda, iro nyumba rose rerefukiriloghe marumba kwa majeshi gha mlungunyi aighu ya mapaa gharo, na vizongona venywa vose verediriloghe kwa milungu mizima, aighu yaro, richanonwa kara kara na Tofethi.’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.13",
            "verseOrgIds": [
              "JER.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.13",
            "verseOrgIds": [
              "JER.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Jeremia ukafuma Tofethi, andu BWANA oremdumieghe kufunya wulodi, ukakaia kimusi wazenyi ya Hekalu na kuwizera wandu wose, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.14",
            "verseOrgIds": [
              "JER.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“BWANA wa majeshi, uo Mlungu wa Israeli waghora huwu: Ola nichareda wuwiwi aighu ya muzi ughu na aighu ya mizi yaro mitini, ugho wuwiwi nereghughorieghe aighu yaro; kwa kukaia waghilishire singo rawo na kulegha kunisikira.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.15",
            "verseOrgIds": [
              "JER.19.15"
            ]
          }
        }
      ]
    }
  ],
