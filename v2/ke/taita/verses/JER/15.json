                "loc": "EXO.32.11+EXO.32.12+EXO.32.13+EXO.32.14"
              },
              "items": [
                {
                  "text": "Kuf. 32.11-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.13+NUM.14.14+NUM.14.15+NUM.14.16+NUM.14.17+NUM.14.18+NUM.14.19"
              },
              "items": [
                {
                  "text": "Mit. 14.13-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.5+1SA.7.6+1SA.7.7+1SA.7.8+1SA.7.9"
              },
              "items": [
                {
                  "text": "1 Sam. 7.5-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawo wikakukotia, ‘Welee, dighende hao?’ Kuchawitumbulia, ‘BWANA naghamba huwu: “Wandu webwaghwa ni saka izamie, wichafwa kwa saka izamie, na awo webwaghwa wudenyi, wichafwa wudenyi, na awo webwaghwa ni njala, wichabwaghwa ni njala, na awo webarishwa, wichabarishwa.” ’",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.10"
              },
              "items": [
                {
                  "text": "Wuf. 13.10",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nichawiwikia watoteshi wa mbari inya, lufu lobwagha, koshi rerashua, nyonyi ra mbeonyi na nyamandu ra isakenyi reja na kunona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani nichawibonya wishinikilo ni mawuzuri ghose gha ndoenyi kwa wundu ghwa agho ghibonyero aho Jerusalemu ni Manase mwana wa Hezekia, mzuri wa Juda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.4",
            "verseOrgIds": [
              "JER.15.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.1+2KI.21.2+2KI.21.3+2KI.21.4+2KI.21.5+2KI.21.6+2KI.21.7+2KI.21.8+2KI.21.9+2KI.21.10+2KI.21.11+2KI.21.12+2KI.21.13+2KI.21.14+2KI.21.15+2KI.21.16"
              },
              "items": [
                {
                  "text": "2 Waz. 21.1-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.1+2CH.33.2+2CH.33.3+2CH.33.4+2CH.33.5+2CH.33.6+2CH.33.7+2CH.33.8+2CH.33.9"
              },
              "items": [
                {
                  "text": "2 Mal. 33.1-9",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeremia kulalamika kwa BWANA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni bugha kwapo mao, angu korenivaeghe nikaie mundu odeda na kubonya nganyi isanga jose. Sikopeshere hata sikopie kilambo chingi kwa mndungi; ela sena wandu wose weenisua. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukaghamba, “Kwa loli nichakukira kwa wundu ghwa wucha, kwa loli nichawibonya wamaiza wako wikuvoye ngelo ya wasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welee, mndungi wadima kuchikanya chuma, ee chuma chifumagha kaskazinyi na shaba? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuzuri ghwako ghwa mali na mashamo ghako nichaghineka ghidwalo wunyika duu, kwa wundu ghwa kaung'a rako richue isangenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
            "verseOrgIds": [
              "JER.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nichakubonya kuwidumikie wamaiza wako isanga kusejiichi, angu kwa machu ghapo, modo ghwakorelo ghuchaadua ghukiaka matuku ghose.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko ngatumbulia, “Oho kwamanya ee BWANA; kunikumbuke na kunilindia. Kulipe kisasi aighu ya watiriri wapo. Kwa wundu ghwa uko kurumaghia kwako kusakenida kula; kumanye naawuyasholelwa kwa wundu ghwako. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.15",
            "verseOrgIds": [
              "JER.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nereghiwonieghe malagho ghako ngaghija, ghikawuya iseko na kuboilwa ngolonyi kwapo; angu niwangilo kwa irina jako ee BWANA Mlungu wa majeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.16",
            "verseOrgIds": [
              "JER.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sereserieghe kidombo aghadi ya wandu weja maseko, hata jingi sereboiloghe chiaimweri nawo; nereserieghe kidombo niekeri, angu mkonu ghwako ghorenimazireghe, nani ngachulwa ni machu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.17",
            "verseOrgIds": [
              "JER.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaki luwawo lwapo lusesiagha na chonda chapo chiseboagha? Welee, kuchawuya sa kamoda ka tee kwapo, kara kara na machi ghiomagha?”",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.18",
            "verseOrgIds": [
              "JER.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.18",
            "verseOrgIds": [
              "JER.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA waghora huwu, “Kukahea nichakuwunja kupate kunidumikia. Kukadeda malagho mecha wulalo ghwa agho ghisena fwaida, kuchawuya mundu ojigora ilagho japo; wandu wichakunugha oho, hata ndekuchaawinugha awo anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.19",
            "verseOrgIds": [
              "JER.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nichakubonya kukaie sa wurigha ghwa ngome ghwa shaba kwa wandu awa; wichalwa na oho, nawo ndewichaakusima, kwa kukaia ini neko chiaimweri na oho nipate kukukira na kukuvuvua. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.20",
            "verseOrgIds": [
              "JER.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nichakukira kufuma mikonunyi ya wandu wawiwi, na kukukombua kufuma kwa wakorongi.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.21",
            "verseOrgIds": [
              "JER.15.21"
            ]
          }
        }
      ]
    }
  ],
