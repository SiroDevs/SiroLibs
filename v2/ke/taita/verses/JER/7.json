                "loc": "LEV.18.21"
              },
              "items": [
                {
                  "text": "Wal. 18.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.10"
              },
              "items": [
                {
                  "text": "2 Waz. 23.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.35"
              },
              "items": [
                {
                  "text": "Jer. 32.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.31",
            "verseOrgIds": [
              "JER.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa huwo zighana matuku ghichacha, andu aho kusechaawangwa Tofethi angu Vololo ya Hinomu, ela kuchawangwa Vololo Echinjira; kwa kukaia wandu wasowa andu kungi korikia, wicharika aho Tofethi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mimbi ya awo wandu ichawuya vindo va nyonyi na va nyamandu ra isakenyi, hata mndungi ndechaariturusa iro nyamandu anduangi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.33",
            "verseOrgIds": [
              "JER.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndekuchaakaia na mndungi andenyi ya mizi ya Juda na hata chienyi ra Jerusalemu; ndekuchaakaia na kuseka kungi aho, hata kuboilwa kungi; lwaka lwa bwana arusi angu lwa bibi arusi ndeluchaasikirika aho, kwa kukaia aho kuchawuya sa kireti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.34",
            "verseOrgIds": [
              "JER.7.34"
            ]
          }
        },
