              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.22",
            "verseOrgIds": [
              "JER.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA wa majeshi, uo Mlungu wa Israeli waghamba huwu, “Ngelo nichaawiwunja wandu isangenyi kwawo, wichatumia agha malagho sena andenyi ya isanga ja Juda na andenyi ya mizi yawo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.23",
            "verseOrgIds": [
              "JER.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.26",
            "verseOrgIds": [
              "JER.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA waghamba, “Ola matuku ghichacha, nani nichabonya isanga ja Israeli na ja Juda jichulo ni wandu na mfugho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.27",
            "verseOrgIds": [
              "JER.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ichakaia sa iji koni nerewiinjireghe na kuwifunya noko, kuwinona na kuwiredia wuwiwi, huwo koni nichawiagha na kuwiwika. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.28",
            "verseOrgIds": [
              "JER.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngelo iyo, wandu ndewichaaghora sena:",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.29",
            "verseOrgIds": [
              "JER.31.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.30",
            "verseOrgIds": [
              "JER.31.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA waghamba, “Ola matuku ghichacha, nani nichabonya ilaghano iwishi na wandu wa Israeli na wandu wa Juda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.31",
            "verseOrgIds": [
              "JER.31.31"
            ]
          }
        },
