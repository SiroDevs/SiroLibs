              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.37",
            "verseOrgIds": [
              "JER.31.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA waghamba, “Ola matuku ghichacha, na muzi ghwa Jerusalemu ghuchaaghwa sena kwa wundu ghwapo; kufuma Mnara ghwa Hananeli hata Mbenge ya Mbembe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.38",
            "verseOrgIds": [
              "JER.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msitari ghwa kipimo ghuchaghorolwa hata mghondi ghwa Garebu, ima ghughahike cha Goa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.39",
            "verseOrgIds": [
              "JER.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vololo yose, andu wafu wirikwagha na andu maivu ghidaghwagha, na mbuwa rose riko hata kamoda ka Kidroni, cha mashariki, ichabonywa ikaie ya wueli kwapo; ugho muzi jingi ndeghuchaachikanywa hata kunonwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.40",
            "verseOrgIds": [
              "JER.31.40"
            ]
          }
        }
      ]
    }
