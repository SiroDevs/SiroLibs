              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.31",
            "verseOrgIds": [
              "JER.31.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaghano ijo ndejichaakaia sa iji nerejibonyereghe na weke ndee iji nerewifunyireghe isanga ja Misri ngiwidwa na mkonu; ilaghano japo ijo werejichikanyireghe, hata ngera nerekoghe kwawo sa mumi wawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.32",
            "verseOrgIds": [
              "JER.31.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ilaghano nichaajibonya na wandu wa Israeli nyuma ya matuku ghaja nijo iji: Nichawika sharia yapo andenyi kwawo, nani nichaiandika aighu ya ngolo rawo; nichakaia Mlungu wawo nawo wichakaia wandu wapo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.33",
            "verseOrgIds": [
              "JER.31.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.16"
              },
              "items": [
                {
                  "text": "Waeb. 10.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.33",
            "verseOrgIds": [
              "JER.31.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndewichaafundishana sena kula mundu na mmbao na kula mundu na mruna wikighamba, ‘Mmanye BWANA,’ angu wandu wose wichanimanya kufuma mtini wawo, hata m'baa wawo. Kwa kukaia nichawifuya wughoma mawiwi ghawo, na kaung'a yawo sichaaikumbuka sena anduangi, ini BWANA naghamba.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.34",
            "verseOrgIds": [
              "JER.31.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.17"
              },
              "items": [
                {
                  "text": "Waeb. 10.17",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
