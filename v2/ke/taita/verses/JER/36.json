        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.31",
            "verseOrgIds": [
              "JER.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko ngawada chuo kizima, ngamneka uja muandiki Baruku mwana wa Neria, uo oreandikieghe malagho ghose neremghorieghe ini Jeremia andenyi ya chija chuo cherekoreloghe ni Jehoiakimu mzuri wa Juda, ukaandika sena na kuchuria malagho mazima aighu ya agho gha imbiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
            "verseOrgIds": [
              "JER.36.32"
            ]
          }
        }
      ]
    }
