            "sid": "ZEC 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ukaniwonyera Mkohani M'baa Joshua ukikaia kimusi imbiri ya malaika wa BWANA, na Shetani uko kimusi chia ya mkonu ghwake ghwa kiwomi upate kumshitakia.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
