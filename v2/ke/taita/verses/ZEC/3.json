                "loc": "EZR.5.2"
              },
              "items": [
                {
                  "text": "Ezr. 5.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.10"
              },
              "items": [
                {
                  "text": "Wuf. 12.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa BWANA ukamzera Shetani, “BWANA ndekukemie ee Shetani! Uo BWANA uikunde Jerusalemu ndekukemie. Umundu ooka sa kilaya chafunywa modonyi.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.9"
              },
              "items": [
                {
                  "text": "Juda. 9",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua orekoghe ukikaia kimusi imbiri ya malaika urwae nguwo rilue. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.3",
            "verseOrgIds": [
              "ZEC.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika ukawizera wambao werekoghe kimusi imbiri kwake, “Mruonyi iro nguwo rilue.” Ukamzera Joshua, “Ola nakuinjira kaung'a yako, nani nichakurusha nguwo ra zoghori mbaa.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.4",
            "verseOrgIds": [
              "ZEC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.4",
            "verseOrgIds": [
              "ZEC.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukawilaghira awo werekoghe aho wimrushe Joshua kiremba chielie chongonyi kwake. Wikamngira icho kiremba chielie chongonyi kwake, na kumrusha nguwo malaika wa BWANA ukikaia kimusi kaavui nao.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.5",
            "verseOrgIds": [
              "ZEC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.5",
            "verseOrgIds": [
              "ZEC.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko malaika wa BWANA ukamlaghira Joshua, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.6",
            "verseOrgIds": [
              "ZEC.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukaia, BWANA Uwadie-Ndighi-Rose waghamba, “Kukawadia sharia rapo, na kukatisha kazi kunekelo kuribonye, kuchadua mzighaniri wa Hekalu yapo, na chukumbi raro; nani nichasikira malombi ghako, seji nawuyasikira malombi gha weke malaika awa wawuyakaia kimusi aha imbiri kwapo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.7",
            "verseOrgIds": [
              "ZEC.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idana sikira ee Joshua Mkohani M'baa, chiaimweri na wambenyu mkwanye, wiko fwana ya maza ndicha richagha, nichamreda mdumiki wapo uwangwagha Lumbashu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.8",
            "verseOrgIds": [
              "ZEC.3.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.5"
              },
              "items": [
                {
                  "text": "Jer. 23.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.33.15"
              },
              "items": [
                {
                  "text": "33.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.12"
              },
              "items": [
                {
                  "text": "Zek. 6.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.8",
            "verseOrgIds": [
              "ZEC.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naawuyawika igho jiko na chuwaru mfungade imbiri ya Joshua; nichakota mbari aghadi yaro, nani nichainja kaung'a ya isanga iji kwa ituku jimweri. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.9",
            "verseOrgIds": [
              "ZEC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituku ijo jikavika, kula mundu onyu uchamkaribisha mmbao wikaie aisi ya mzabibu ghwake na aisi ya mtini ghwake wikiboilwa kwa kukaia weko na sere na wulindiri.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.10",
            "verseOrgIds": [
              "ZEC.3.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
