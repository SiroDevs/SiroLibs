            "number": "3",
            "style": "v",
            "sid": "REV 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata iji uo Mwana wa Ng'ondi oreghufungueghe ugho muhuri ghwa kawi, neresikireghe iyo nyamandu iko moyo ya kawi ikighamba, “Choo”. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.3",
            "verseOrgIds": [
              "REV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na farasi zima ikafuma ya mkundu tini, na uo oreijokieghe, orenekeloghe rusa einja sere ndoenyi, wandu wipate kubwaghana weni na weni; nao orenekeloghe lufu lubaa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.4",
            "verseOrgIds": [
              "REV.6.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
