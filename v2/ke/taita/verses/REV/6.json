          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nyerinyeri ra mlungunyi rikapotoka andoenyi seji mtini ghughughuduagha matunda gharo gha kwari ngelo ghwasughuswa ni mbeo mbaa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
