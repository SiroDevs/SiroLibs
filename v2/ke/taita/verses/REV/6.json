              "items": [
                {
                  "text": "Isa. 34.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawingunyi koreinjikieghe seji karatasi rikuchwagha, na kula mghondi na kisiwa vereinjikieghe andu kwaro.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.14",
            "verseOrgIds": [
              "REV.6.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.20"
              },
              "items": [
                {
                  "text": "Wuf. 16.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.14",
            "verseOrgIds": [
              "REV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko aho wazuri wa ndoenyi, na wandu wabaa, na wabaa wa majeshi, na awo wiwadie mali, na wandu wiwadie ndighi, na kula mundu, ukaigha mzumba angu mkitina, wikakuvisa mbangenyi, na aghadi ya maghamba ghiko mighondinyi;",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.15",
            "verseOrgIds": [
              "REV.6.15"
            ]
          }
        },
