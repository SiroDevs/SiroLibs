                "loc": "ZEC.1.8"
              },
              "items": [
                {
                  "text": "Zek. 1.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.3"
              },
              "items": [
                {
                  "text": "6.3",
                  "type": "text"
                }
              ]
            },
