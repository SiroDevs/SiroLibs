        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata iji uo Mwana wa Ng'ondi oreghufungueghe ugho muhuri ghwa karandadu, nerezighanireghe, nao ola korekoghe na msughusiko m'baa ghwa ndoe; iruwa jikawuya ja chilu sa nguwo ya igunia, na mori ghukawuya ghwa ngundu sa bagha,",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.12",
            "verseOrgIds": [
              "REV.6.12"
            ]
          }
        },
