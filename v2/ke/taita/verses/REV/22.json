          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ini Jesu namduma malaika wapo ughighorie makanisa maza iri. Ini ne wa kivalwa cha Daudi; iyo nyerinyeri ing'alaa-ng'ala ya luma lwa nakesho.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.16",
            "verseOrgIds": [
              "REV.22.16"
            ]
          }
