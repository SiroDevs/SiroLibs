          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cha shighadi reko iro koshi, na wasawi, na walaki, na wabwaghi wandu, na awo witasagha milimu, na kula mundu uikundagha tee na kuibonya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.15",
            "verseOrgIds": [
              "REV.22.15"
            ]
