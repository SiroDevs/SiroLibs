          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warasimilwa awo wioghoshagha nguwo rawo, eri wipate kukaia na hachi eghughendia ugho mudi ghwa irangi, na kungia mzinyi wikimaria mbengenyi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.14",
            "verseOrgIds": [
              "REV.22.14"
            ]
          }
        },
        {
