          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misingi ya wurigha ghwa ugho muzi, erepambiloghe na kula igho jiko ja zoghori mbaa. Ja imbiri, ni igho ja jaspi; ja kawi, ni safire; ja kadadu, agate; ja kana, zumaridi; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.19",
            "verseOrgIds": [
              "REV.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ja kasanu, oniksi; ja karandadu, karneliani; ja mfungade, kristolitho; ja wunyanya, beruli; ja ikenda, topazi; ja ikumi, krusoprase; ja ikumi na imweri, jasintho; na ja ikumi na iwi, amethisto. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.20",
            "verseOrgIds": [
              "REV.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iro mbenge ikumi na iwi rerekoghe lulu ikumi na iwi; kula mbenge erebonyeroghe na lulu imweri, na chia mbaa ya muzi erebonyeroghe kwa dhahabu ielie, iwonekagha sa kilole.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.21",
            "verseOrgIds": [
              "REV.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 21:21"
          },
          "items": [
