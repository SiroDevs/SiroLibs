                "loc": "EZK.1.26+EZK.1.27+EZK.1.28"
              },
              "items": [
                {
                  "text": "Eze. 1.26-28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.1"
              },
              "items": [
                {
                  "text": "10.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na uo orechiserieghe, orewonekieghe sa magho gha zoghori mbaa ghiwangwagha jasperi na karneliani, na mbai-mbai ya icho kifumbi, korekoghe na lusenge lwa vua luwonekagha sa igho ja zumaridi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbai-mbai ya icho kifumbi cha nguma, verekoghe vifumbi vimu va nguma mirongo iwi na vina, na waghosi mirongo iwi na bana waseria aighu yaro, wirwae nguwo ra chokwa na virumbu va dhahabu vongonyi kwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.4",
            "verseOrgIds": [
              "REV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufuma kwa icho kifumbi cha nguma, rerefumieghe chuhehia, na chwaka na mirurumo ya chukuwa; na imbiri ya icho kifumbi cha nguma, korekoghe na taa mfungade rikiaka, naro ni roho mfungade ra Mlungu;",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
