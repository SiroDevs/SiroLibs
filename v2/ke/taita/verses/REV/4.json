        "style": "s1"
      },
      "items": [
        {
          "text": "Wutasi mlungunyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuma ya agho, nerezighanireghe, nao ola, ngawona mnyango ghwarughulwa mlungunyi! Na ulo lwaka nerezoeghe kulusikira lukighora nani sa tarumbeta lukaghamba, “Joka nokunu, nani nichakuwonyera iro maza riko na suti ekaia nyuma ya agha.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.1",
            "verseOrgIds": [
              "REV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na shwa wori ngakaia andenyi ya Roho; nao ola ngawona kifumbi cha nguma mlungunyi chaserelwa ni mndumu!",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
