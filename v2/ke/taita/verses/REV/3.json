          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uo usimagha, nichamrumiria kusea kidombo andwamweri nani kwa kifumbi chapo cha nguma seji koni ini neresimieghe na kusea kidombo andwamweri na Aba kwa kifumbi chake cha nguma. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.21",
            "verseOrgIds": [
              "REV.3.21"
            ]
          }
        },
