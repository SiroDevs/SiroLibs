        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bugha ya kawi yameria kuida, ola bugha ya kadadu icha kafwani.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.14",
            "verseOrgIds": [
              "REV.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iyo tarumbeta ya mfungade",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.14",
            "verseOrgIds": [
              "REV.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko uo malaika wa mfungade ukaikaba tarumbeta yake, kukakaia na chwaka mbaa mlungunyi rikighamba, “Wuzuri ghwa wurumwengu ghwawuya wuzuri ghwa Bwana odu na ghwa Kristo wake, nao uchabonya nguma kwa kala na kala.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.15",
            "verseOrgIds": [
              "REV.11.15"
            ]
          }
        },
