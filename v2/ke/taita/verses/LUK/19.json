            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.44",
            "verseOrgIds": [
              "LUK.19.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 19:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Jesu ukangia Hekalunyi, ukazoya kuwiwinga cha shighadi awo wereuzagha; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.45",
            "verseOrgIds": [
              "LUK.19.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 19:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukawizera, “Yaandikwa, ‘Nyumba yapo ichakaia nyumba elombia.’ Ela inyo mwaibonya ikaie mbanga ya viting'a.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.46",
            "verseOrgIds": [
              "LUK.19.46"
            ]
          }
        },
        {
