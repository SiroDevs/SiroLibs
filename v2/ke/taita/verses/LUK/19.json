          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao kula ituku Jesu ukakaia ukifundisha Hekalunyi. Wakohani wabaa, walimu wa Sharia, na vilongozi va wandu wikakunda kum'bwagha.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.47",
            "verseOrgIds": [
              "LUK.19.47"
            ]
          }
        },
        {
          "name": "note",
