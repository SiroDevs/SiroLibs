                "loc": "LUK.21.37"
              },
              "items": [
                {
                  "text": "Lk. 21.37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.47",
            "verseOrgIds": [
              "LUK.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela wikasowa chia ingi ebonya, angu wandu wose werekoghe wikimsikiria kwa loli, wisekunde kuidwa ni ilagho jingi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.48",
