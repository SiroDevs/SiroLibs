          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Marita orekoghe wasumbuka kwa kudumika nandighi ukamghendia Jesu ukamzera, “Bwana ndekutalagha kuwona angu mwanidu wanisighia wudumiki niekeri? Mzere uche unitesie.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.40",
            "verseOrgIds": [
              "LUK.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
