        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ichakaia baa kwa Tiro na Sidoni kuchumba inyo Ituku ja Kutanywa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.14",
            "verseOrgIds": [
              "LUK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oho Kafarnaumu, kwaghamba kujoke kuvike mlungunyi? Kuchaserwa hata Andu kwa Wafu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.15",
            "verseOrgIds": [
              "LUK.10.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.13+ISA.14.14+ISA.14.15"
              },
              "items": [
                {
                  "text": "Isa. 14.13-15",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
