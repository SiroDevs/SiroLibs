          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Jesu ukawizera wanughi wake, “Uo umsikiragha inyo, uanisikira ini, na uo umleghagha inyo, uanilegha ini, na uo unileghagha ini, uamlegha uo orenidumieghe.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
            "verseOrgIds": [
              "LUK.10.16"
            ]
          }
        },
        {
