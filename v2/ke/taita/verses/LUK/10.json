              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.12",
            "verseOrgIds": [
              "LUK.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ni bugha kwako Korazini! Ni bugha kwako Bethsaida! Angu weke mwakilimbiti wibonyekie kwako, ngera wedebonyerwa Tiro na Sidoni, kumangu wamerie kuhea koicho, wikirwa nguwo ra magunia na kusea kidombo ivunyi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.23.1+ISA.23.2+ISA.23.3+ISA.23.4+ISA.23.5+ISA.23.6+ISA.23.7+ISA.23.8+ISA.23.9+ISA.23.10+ISA.23.11+ISA.23.12+ISA.23.13+ISA.23.14+ISA.23.15+ISA.23.16+ISA.23.17+ISA.23.18"
              },
              "items": [
                {
                  "text": "Isa. 23.1-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Eze. 26.1–28.26",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.4+JOL.3.5+JOL.3.6+JOL.3.7+JOL.3.8"
