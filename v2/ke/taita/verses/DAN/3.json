          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko Nebukadnezari ukasoghoda kaavui na iwiwi ja modo ukaghamba, “Shadraka, Meshaki, na Abednego, wadumiki wa Mlungu Uko Aighu Na Ndighi, fumenyi shwa-shwa, muche aha!” Nao Shadraka, na Meshaki, na Abednego wikafuma modonyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.26",
            "verseOrgIds": [
              "DAN.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wabaa wa isanga na wa serikali, na wanjama wa mzuri, wikakwana chiaimweri. Wikawona kukaia modo ndeghuwibonyere waja wandu ilagho jingi; hata kukaia na ndighi mimbinyi kwawo; maridia ghawo na nguwo rawo nderiwonie ilagho jingi, hata irumba ja modo ndejerekoghe kwawo anduangi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.27",
            "verseOrgIds": [
              "DAN.3.27"
            ]
          }
        }
      ]
    },
