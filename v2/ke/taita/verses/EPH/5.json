              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwa wundu ughu, mundu uchamsigha ndee na mae, umaziriane na mkake, na awo wawi, wichawuya mumbi ghumweri.”",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.31",
            "verseOrgIds": [
              "EPH.5.31"
            ]
