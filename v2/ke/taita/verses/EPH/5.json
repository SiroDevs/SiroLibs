              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihi ni ngasu mbaa, nani naawuyaghamba kukaia yaawuyawonyera seji Kristo uko na ikanisa jake. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.32",
