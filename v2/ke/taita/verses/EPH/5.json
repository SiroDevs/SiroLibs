              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "angu isi deko via va mumbi ghwake. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.30",
            "verseOrgIds": [
              "EPH.5.30"
            ]
