              },
              "items": [
                {
                  "text": "Wakol. 1.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.22",
            "verseOrgIds": [
              "EPH.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "najo nijo mumbi ghwake, uko kuchua kwake uchuragha vose andenyi ya vose.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.23",
            "verseOrgIds": [
              "EPH.1.23"
            ]
          }
        }
