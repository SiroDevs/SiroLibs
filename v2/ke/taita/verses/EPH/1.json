                "loc": "PSA.8.6"
              },
              "items": [
                {
                  "text": "Zab. 8.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
