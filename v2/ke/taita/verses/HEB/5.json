                "loc": "EXO.28.1"
              },
              "items": [
                {
                  "text": "Kuf. 28.1",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huwo koni, Kristo nderewusireghe ijo ishima jebonywa Mkohani M'baa kwa kukujosa moni anduangi, ela orewikiloghe ni Mlungu uo oremzerieghe,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukulindia aighu ya kujisigha ijo irumirio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.10",
            "verseOrgIds": [
              "HEB.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deko na malagho mengi gheghora aighu ya ilagho iji, ela gheekua kumghoria angu moochaka msedimagha kutambukilwa shwa-shwa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.11",
            "verseOrgIds": [
              "HEB.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu hata ngera ngelo ihi yafwaneghe mkaie walimu, ela mwaduagha mkikunda mndumu umfundishe sena mafundisho gha imbiri gha ilagho ja Mlungu. Wulalo ghwa vindo vikurie, inyo mwaduagha mkikunda mariwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.12",
            "verseOrgIds": [
              "HEB.5.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.3.2"
              },
              "items": [
                {
                  "text": "1 Wakor. 3.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.12",
            "verseOrgIds": [
              "HEB.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu kula mundu unywagha mariwa gheni, waduagha mwana, nao ndemanyagha agho ghiko gha hachi kwa wundenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.13",
            "verseOrgIds": [
              "HEB.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela vindo vikurie, ni va wandu wabaa, awo wikufundishire kwa kurizaisira akili rawo ridime kumanya mecha na mawiwi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.14",
            "verseOrgIds": [
              "HEB.5.14"
            ]
          }
        }
      ]
    }
