              },
              "items": [
                {
                  "text": "Kuf. 20.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.25",
            "verseOrgIds": [
              "HEB.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngelo iyo, lwaka loresughusireghe ndoe; ela idana walaghira huwu, “Indo jimu sena nichasughusa si ndoe iekeri anduangi, ela na mlungunyi wori.”",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
            "verseOrgIds": [
              "HEB.12.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.2.6"
              },
              "items": [
                {
                  "text": "Hag. 2.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
            "verseOrgIds": [
              "HEB.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malagho agha “Indo jimu sena,” ghiawonyera kuinjwa kwaro ivo visughuswagha sa vilambo viumbilo, eri ivo visedimikagha kusughuswa, vipate kusigharika. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.27",
            "verseOrgIds": [
              "HEB.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa huwo ndedifunye chawucha na kuboilwa kwa kuwusa wuzuri ghusedimagha kusughuswa; nesi ndedimtase Mlungu kwa chia im'boiagha, kwa ishima, na kuobua; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.28",
            "verseOrgIds": [
              "HEB.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "angu Mlungu odu, ni modo ghubirie, ghulunguragha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.29",
            "verseOrgIds": [
              "HEB.12.29"
            ]
          }
