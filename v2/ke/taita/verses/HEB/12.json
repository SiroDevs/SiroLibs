          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manyenyi msemleghe uo ughoragha nenyo. Angu ikakaia wiserekirieghe awo weremleghieghe uo orewiwonyereghe ndoenyi, isi dichakia wada dikamlegha uo udiwonyeragha kufuma mlungunyi?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.25",
            "verseOrgIds": [
              "HEB.12.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
