          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu inyo ndemghuvikie Mghondi ghwa Sinai ghudimagha kuadadwa; andu modo ghoreakagha, kuko na kira, wuchilu, kiremba,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.18",
            "verseOrgIds": [
              "HEB.12.18"
            ]
          }
        },
        {
