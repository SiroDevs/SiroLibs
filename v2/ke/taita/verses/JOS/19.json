          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mizi iyo mibaa na mitini, erekoghe andenyi ya ijo isanga jerenekeloghe kichuku cha Dani jikaie ifwa jawo, kunughana na nyumba rawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.48",
