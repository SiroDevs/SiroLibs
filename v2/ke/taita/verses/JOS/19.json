            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 19:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkohani Eleazari, Joshua mwana wa Nuni, na wabaa wa vichuku va wandu wa Israeli niwo werejiwaghieghe ijo isanga kwa kukaba kura imbiri ya BWANA aja Shilo mnyangonyi ghwa Hema Ekwania; na huwo wikaimeria iyo kazi ejiwagha isanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.51",
            "verseOrgIds": [
              "JOS.19.51"
            ]
          }
        }
