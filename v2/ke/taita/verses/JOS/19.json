          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.39",
            "verseOrgIds": [
              "JOS.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kura ya mfungade ikakaia kwa kichuku cha Dani kunughana na nyumba rawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.40",
            "verseOrgIds": [
              "JOS.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masanga gherewurieghe ifwa jawo gherekoghe ni Sora, Eshtaoli, Ir-shemeshi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.41",
            "verseOrgIds": [
              "JOS.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaalbini, Aijaloni, Ithla, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.42",
            "verseOrgIds": [
              "JOS.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eloni, Timna, Ekroni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.43",
            "verseOrgIds": [
              "JOS.19.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elteke, Gibethoni, Baalathi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.44",
            "verseOrgIds": [
              "JOS.19.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 19:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehudi, Bene-beraki, Gath-rimoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.45",
            "verseOrgIds": [
              "JOS.19.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 19:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mejarkoni, Rakoni, wokoni na isanga jimarie Jopa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.46",
            "verseOrgIds": [
              "JOS.19.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 19:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata iji wandu wa Dani werelaghashireghe isanga jawo, wikajoka na kulwa na wandu wa Leshemu, wikawibwagha kwa lufu, wikajiwada na kujiwusa ijo isanga, wikajikaia; wikajiwanga Dani kunughana na irina ja wawae wawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.47",
            "verseOrgIds": [
              "JOS.19.47"
            ]
          }
        },
        {
