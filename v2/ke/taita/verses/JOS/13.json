          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huwu niko Musa orewaghieghe isanga jiko cha mashariki ya Jeriko na Jordani, iji orekoghe kirindinyi cha Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
            "verseOrgIds": [
              "JOS.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Musa nderewinekieghe kichuku cha Lawi isanga jingi; kwa kukaia orewizerieghe ifwa jawo jichakaia ifungu ja mafunyo ghifunywagha kwa BWANA Mlungu wa Israeli.",
          "type": "text",
