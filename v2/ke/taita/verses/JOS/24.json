            "verseOrgIds": [
              "JOS.24.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleazari mwana wa Haruni ukafwa. Wikamrika aho Gibea, muzi ghwa isanga ijo jerenekeloghe mwana wake Finehasi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.33",
