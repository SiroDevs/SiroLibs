              "EXO.30.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.37.29"
              },
              "items": [
                {
                  "text": "Wuw 37:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.22",
            "verseOrgIds": [
              "EXO.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Chenga tïkwïn cho ngutoy cho onyïn: kilen mut nko akonga cho pö mwaghpa manemane nko kilen sömök cho pö sinamon cho ngutoy cho onyïn nko kilen sömök cho pö tïkwïn cho lata miwen cho ngutoy cho onyïn ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.23",
            "verseOrgIds": [
              "EXO.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko kilen mut nko akonga cho pö kasya nko liten angwan cho pö mwaghpa arol. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.24",
            "verseOrgIds": [
              "EXO.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighonyi choni löwïr mwagh nyo tïlil nyo kiyiltoy nyo kenyornyoryö chi nyo nkït wölo kightoy tïkwïn cho ngutoy cho onyïn. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.25",
            "verseOrgIds": [
              "EXO.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyilonyi mwaghoni Ema nyo mi ECHOTYON nko Santuku Muma* ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.26",
            "verseOrgIds": [
              "EXO.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko mese nko karichi nko ketay ghyongo kitömöwo nko karichi nko ato kïpelo körösyon ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.27",
            "verseOrgIds": [
              "EXO.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko ato kïpelo amöros nyo kïpelöy nko karichi nko otupö nko kelyechi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.28",
            "verseOrgIds": [
              "EXO.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itïlilenyi karichoni, atökïtïlilitu tya. Melö swongöy chi anta kïgh anka tïkwïl nyo melö tïlil. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.29",
            "verseOrgIds": [
              "EXO.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyilenyi Aron nko werkachi aitïlil chane, atökïpöghisyeghwanïn le tïsï. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.30",
            "verseOrgIds": [
              "EXO.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ailenchï pipö Israel, ‘Lïku nyï mwagh nyo tïlil nyo kiyiltoy ompö pïnwöyikwa kokay. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.31",
            "verseOrgIds": [
              "EXO.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kïmïlchini por pö chi kïtïkon ameghönye chi mwagh anka nyo karkegh nko nyoni, tïlil mwaghoni ompö akwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.32",
            "verseOrgIds": [
              "EXO.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato nyornyoryö chi mwagh anka nyo karkegh nko nyoni anta yila chi anka tïkwïl, kepesyegho piköchan.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.33",
            "verseOrgIds": [
              "EXO.30.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tïkwïn cho ngutoy cho onyïn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.33",
            "verseOrgIds": [
              "EXO.30.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 30:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, “Chenga tïkwïn cho ngutoy cho onyïn aikany kïkarkegh nïkisyengwa, choni kï: natap nko syekelet nko kelpen nko upani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.34",
            "verseOrgIds": [
              "EXO.30.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 30:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aigh tïkwïn cho ngutoy cho onyïn. Aitö partin atökwigh kitïlilitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.35",
            "verseOrgIds": [
              "EXO.30.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 30:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itïghotïghenyi walaka kïmïnkechitu aitö walaka Santuku Muma ompö ori Ema nyo mi ECHOTYON, wölo onyoryeghonan nko akwa, lïku nyo tïlil tya ompö akwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.36",
            "verseOrgIds": [
              "EXO.30.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 30:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoghchï kegh tïkwïn cho ngutoy cho karkegh nko chay kakitïlil, ompöwölo lïku cho tïlilöch ompö akwa ompö ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.37",
            "verseOrgIds": [
              "EXO.30.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 30:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chi anka tïkwïl nyo ighöy tïkwïn cho ngutoy cho le choni, kepesyegho piköchan.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.38",
            "verseOrgIds": [
              "EXO.30.38"
            ]
          }
        }
      ]
    }
