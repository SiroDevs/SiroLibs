  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "EXO 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Itekenyi ato kïpelo amöros nyo kïpelo tïkwïn cho ngutoy cho onyïn ompö tilok. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.1",
            "verseOrgIds": [
              "EXO.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku sentimiten 45 koghïntanyi nko töpesïntanyi, akïkarkegh wop tïkwïl, sentimiten 90 kutok akï nömöy kegh nko kuyechi tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.2",
            "verseOrgIds": [
              "EXO.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imala koltin cho pïchighöch okumpö parak nko kamastö nko kuye aighchï söremwokö koltin kuwitwit. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.3",
            "verseOrgIds": [
              "EXO.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay ighchï kaymoris odeny cho pö koltin, ngwïnyi söremwokachi ompö woptine kwodeny akïlïku ato kitöni ketichay kïsïto. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.4",
            "verseOrgIds": [
              "EXO.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pata keti tilok aimala koltin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.5",
            "verseOrgIds": [
              "EXO.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itö tawu anankanay mi ato lekïto Santuku Muma.* Wölay otuyeghonan nko akwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.6",
            "verseOrgIds": [
              "EXO.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelöy Aron tïkwïn cho ngutoy cho onyïn ompö parakunyi, tökwoghö chik otini noghöy kitömöw. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.7",
            "verseOrgIds": [
              "EXO.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïpelöy mönon tïkwïl otini noghöy kitömöw, atökïlïkwï ngutogh nyo karam ompö tawu ECHOTYON ompö pïnwöyikwa kokay. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.8",
            "verseOrgIds": [
              "EXO.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meroptegha atoni tïkwïn cho ngutoy cho onyïn melö tïlilöch anta ropöwon nyo kïpelöy anta nyo pö pagh amomïlchï dipay.* ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.9",
            "verseOrgIds": [
              "EXO.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighöy Aron kinyoryogh ompö kuyo ato kïpelo amöros kïnyïl akonga ompö köny ompö kisön pö kitötogh pö ngokï cho pö kinyoryogh kïnyïl akonga ompö köny ompö pïnwöyikwa kokay, nyoni kï tïlil tya ompö ani, ECHOTYON.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.10",
            "verseOrgIds": [
              "EXO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Suru Ema nyo mi ECHOTYON*",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.10",
            "verseOrgIds": [
              "EXO.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.11",
            "verseOrgIds": [
              "EXO.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Otini iyitenyi pipö Israel, ikany kutö chi anka tïkwïl kïgh ECHOTYON nyo tyoko kegh tömönyorï chane sömew otini iyitenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.12",
            "verseOrgIds": [
              "EXO.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.38.25+EXO.38.26"
              },
              "items": [
                {
                  "text": "Wuw 38:25-26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.24"
              },
              "items": [
                {
                  "text": "Mat 17:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konu chi anka tïkwïl nyo kakiyit ropïyen cho mökino kïlïkwï ropöwo ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.13",
            "verseOrgIds": [
              "EXO.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ropchini chi anka tïkwïl nyo kikeyit ECHOTYON ropïyenichoni nyo tïng könyis tömönut odeny kutoch. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.14",
            "verseOrgIds": [
              "EXO.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metötonye sïkönö cho tïlöy choni, ametötonye meywon cho ngörï kïtïl choni, otini töni ECHOTYON ropöwon nyo ripo söpontanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.15",
            "verseOrgIds": [
              "EXO.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichengonyi pipö Israel suru kinyoryogh, atökïpöyit ighisyo Ema nyo mi ECHOTYON, atökïlïkwï ropöwontenkwa ompö tawu ECHOTYON.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.16",
            "verseOrgIds": [
              "EXO.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Otupo tay",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.16",
            "verseOrgIds": [
              "EXO.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.17",
            "verseOrgIds": [
              "EXO.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Igha otupo tay nko kelyechi cho pö taghoy. Aitö kwenu Ema nyo mi ECHOTYON nko ato kïpelo amöros aiyin pögh ori. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.18",
            "verseOrgIds": [
              "EXO.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwöto Aron nko werkachi morikwa nko kelyekwa ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.19",
            "verseOrgIds": [
              "EXO.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "otini petöy Ema nyo mi ECHOTYON anta otini karik ato kïpelo amöros atökïpöghisyö kïpel kitötogh ompö ma nyo pö ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.20",
            "verseOrgIds": [
              "EXO.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wunöy morikwa nko kelyekwa atömömeghö, lïku nyï kirurut nyo pö kokay ompö chane nko monekwa löwïr.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.21",
            "verseOrgIds": [
              "EXO.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwagh nyo kiyiltoy",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
