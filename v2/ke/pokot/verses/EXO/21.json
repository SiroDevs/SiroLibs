            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chi anka tïkwïl nyo lïwöy chi kïma, ketïghöy nyinte kïma tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.12",
