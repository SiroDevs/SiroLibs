        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.32",
            "verseOrgIds": [
              "EXO.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato ngany chi pïrïm anta pal amötïpnye akïchïnchï egh ori anta sïkïryö, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
              "EXO.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïghoktoy chito pïrïm, ropïyen kïghokini chito kïpö, kïlïkwï nyenyi nyinö kama. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
            "verseOrgIds": [
              "EXO.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato par kïrpö chi kïrpö chitö anka akïma, kwoltoy chane nyinö söpöy akïchagh kerpeskö kwen nko panye cho pö nyinö kama. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.35",
            "verseOrgIds": [
              "EXO.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato ki otöp nyo pö kirkoni kïwirsïyi, amakarnye chito kïpö, kïmïchini kïghakta kirïk ompö kirïk akïlïkwï nyenyi nyinö kama.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.36",
            "verseOrgIds": [
              "EXO.21.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kirurut pö ghaktagh",
          "type": "text"
        }
      ]
