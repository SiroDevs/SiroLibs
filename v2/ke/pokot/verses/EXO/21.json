        {
          "text": "“Ato lïwö chi lïkïp sekeyontenyi nyo le mïrön anta korka akïma, kïmïchini ketö nyinte sitöt, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.20",
            "verseOrgIds": [
              "EXO.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "wölo melö kitöni nyinte sitöt ato nget sekeyontonay ompö asis akonga anta osis odeny, ompöwölo sekeyontenyi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
            "verseOrgIds": [
              "EXO.21.21"
            ]
          }
        }
      ]
    },
