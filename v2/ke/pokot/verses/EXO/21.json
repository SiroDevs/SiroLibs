            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kong ompö kong, kelat ompö kelat, egh ompö egh, kel ompö kel, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.24",
