          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mönyorunye sitöt nyay kelï nyinte ato nget chichay kökilï akïwestö kïtökönotö lïkïp, wölo ghokyini chichay kelï nyinte osiswechi chay kempur kwïle akïrip ntökïsïwa lö kisöp.",
          "type": "text",
          "attrs": {
