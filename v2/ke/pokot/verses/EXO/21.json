          ]
        },
        {
          "text": "“Ato syal pich odeny akïwira anka kagh kongenyi anta ewunyi, wölo kïkasa akïrï pöröy, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.18",
