              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïcheng Musa kisön akwisö pich akïlö, “Chï kï kisön cho pö muma nyo kam ECHOTYON nko akwa ompö ngalechï.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
            "verseOrgIds": [
              "EXO.24.8"
            ]
          }
        }
