            "number": "30",
            "style": "v",
            "sid": "EXO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïsörunö ECHOTYON pipö Israel mori pipö Misri. Kïsïwa Israel chane kimeghö ompö nanam kamas. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïwa Israel ighisyö nyo wow nyo kigh ECHOTYON ompö pipö Misri, kïkonyït pich ECHOTYON nko mötworintenyi Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        }
      ]
    },
    {
