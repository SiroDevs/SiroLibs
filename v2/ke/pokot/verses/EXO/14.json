  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "EXO 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.1",
            "verseOrgIds": [
              "EXO.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwochinö pipö Israel kïmïlisyö akumungö tawu Pi Ayirot, kwenu Mikdol nko Nanam nyo Pïrir, ompö tawu Paal Sepon. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.2",
            "verseOrgIds": [
              "EXO.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo nonöy Parao lö, nyoru pipö Israel, kömpölelyö ompö or akupotyechï surkwen. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.3",
            "verseOrgIds": [
              "EXO.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oghan möt pö Parao kwaghïghit, tökïrïpekwa tonyorchan ororyö wölo mi Parao nko pikachi löwïr cho pö lïk, atökunkïtï pipö Misri lö ochan ECHOTYON.” Kwigh chane lenyoni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.4",
            "verseOrgIds": [
              "EXO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.4",
            "verseOrgIds": [
              "EXO.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kikïmwochï pöytoghinto Misri lö kikïryagh pïchay, kïwaghach Parao kinonutkachi nko cho pö mötworichi ompö pïchay akïlö, “Ne nyï kakighacha tökepïstenö pipö Israel cho köpöghisyeghwecha?” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.5",
            "verseOrgIds": [
              "EXO.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnap nkarinechi nko pikachi pö lïk. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.6",
            "verseOrgIds": [
              "EXO.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïcheng nkaritin cho le 600 cho kikïkïl nko nkaritine walaka löwïr cho pö koro Misri kïmi nko yetïntinekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.7",
            "verseOrgIds": [
              "EXO.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh ECHOTYON möt pö Parao kwaghïghit, kïrïp chane pipö Israel cho kipetöy ompö nyakanat.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.8",
            "verseOrgIds": [
              "EXO.14.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:8",
              "type": "text"
            },
            {
              "text": "nyakanat:",
              "type": "text"
            },
            {
              "text": "Kimi Tororöt kïripöy chane.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.8",
            "verseOrgIds": [
              "EXO.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrïpa pipö Misri chane angoletin nko nkarino Parao nko pikachi pö angoletin nko lïkenyi, kïnyorchï chane Nanam nyo Pïrir, ato lekïto Pi Ayirot tawu Paal Sepon.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.9",
            "verseOrgIds": [
              "EXO.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.9",
            "verseOrgIds": [
              "EXO.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kilekïtit Parao, kïlö pipö Israel kiros kïsïwa lö, kimi pipö Misri kïrïpu chane, kimïghyö nyoman akïlokyï ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.10",
            "verseOrgIds": [
              "EXO.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï chane Musa, “Kimömicha so pïrïmpotï koro Misri nka nyï kemïtwechanyi kewonyechinö surkwen? Keghwechanyi ne temïtwecha kepkanena koro Misri? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.11",
            "verseOrgIds": [
              "EXO.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyete nyay kimwowuchanyi ompö koro Misri lö, ‘Pïstecha kepöghisyechinö pipö Misri.’ Kitö ngwangwa kepöghisyechinöcha pipö Misri kïtïl kewonyechinöcha surkwen.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.12",
            "verseOrgIds": [
              "EXO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.12",
            "verseOrgIds": [
              "EXO.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Musa pïchay, “Mowöghisyö, achïchïma atasïwena sörunöto ECHOTYON nyo ighwokwa asete, ompöwölo pipö Misri cho osïwïyekwa asete, kïmelö tosïwïyekwa ngat. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.13",
            "verseOrgIds": [
              "EXO.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poryewokwa ECHOTYON, osisyenökwa pat.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.14",
            "verseOrgIds": [
              "EXO.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.14",
            "verseOrgIds": [
              "EXO.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, “Ompö ne telokyinaninyi? Mwochinö pipö Israel kïpa tagh. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.15",
            "verseOrgIds": [
              "EXO.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Syolö lïkïngu aighïtochï ewungu nanam aingotyö pöghe, atökuwer pipö Israel wölo tïyame. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.16",
            "verseOrgIds": [
              "EXO.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oghan mötöwo pipö Misri kwoghïghitu atökïpa kïrïp chane, tonyorchan ororyö Parao nko pikachi löwïr nko nkaritine nko pikachi pö angoletin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.17",
            "verseOrgIds": [
              "EXO.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini karïntan Parao nko nkarinechi nko pikachi pö angoletin anyorwan ororyö, kunkïtï nyu pipö Misri lö ochan ECHOTYON.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.18",
            "verseOrgIds": [
              "EXO.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.18",
            "verseOrgIds": [
              "EXO.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmïla malaykayantanay kintöghoghchini pipö Israel kïwö lötungwa akïwö pchöri poltonay kimi tawungwa kutang lötungwa ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.19",
            "verseOrgIds": [
              "EXO.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "akughyongö kwenu pipö Misri nko pipö Israel. Kimito polta nko tuwïn ompö pipö Misri kïlöpo wölo mi pipö Israel",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.20",
            "verseOrgIds": [
              "EXO.14.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:20",
              "type": "text"
            },
            {
              "text": "polta nko tuwïn ompö pipö Misri kïlöpo wölo mi pipö Israel:",
              "type": "text"
            },
            {
              "text": "Meporunye ompö ngala Eprania lasiny.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akimarikcha kegh chane.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.20",
            "verseOrgIds": [
              "EXO.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.20",
            "verseOrgIds": [
              "EXO.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kughïtochï Musa ewunyi nanam. Kïyumtö ECHOTYON pögh nangat ompö yomöt nyo awes nyo kïngwïna kongasis, kwigh nanam kïlïkwï kor nyo tïyame akïchagh kegh pögh. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.21",
            "verseOrgIds": [
              "EXO.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwer pipö Israel nanam kwen wölo tïyame, kïlïkwï pögh nayat ompö ewu tagh nko ewu löt ompö chane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.22",
            "verseOrgIds": [
              "EXO.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrïp pipö Misri akïpa ntökwit nanam kwen nko angoletino Parao nko nkaritinechi nko pikachi pö angoletin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.23",
            "verseOrgIds": [
              "EXO.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini le kiwasan kurosunö ECHOTYON pchörinay pö ma nko nyo pö polta kuros pipö Misri, akwigh chane kïkwongkwongisyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.24",
            "verseOrgIds": [
              "EXO.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnam norayonta kelyo nkarinekwa atökïnïkisyï chane kïpa. Kïlö pipö Misri, “Keryöghenö Israel, ompöwölo mi ECHOTYON kïporyechini chane atökïparecha.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.25",
            "verseOrgIds": [
              "EXO.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.25",
            "verseOrgIds": [
              "EXO.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, “Ghïtochinö ewungu nanam, atökulum pögh pipö Misri, akulum nkarinekwa nko pikökwa pö angoletin.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.26",
            "verseOrgIds": [
              "EXO.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kughïtochï Musa ewunyi nanamnay, otini kile tökwoghö kïmïlisyö pöghechay le atay kömi osis. Kïryagh pipö Misri, wölo kïyumchï ECHOTYON chane nanam kwen. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.27",
            "verseOrgIds": [
              "EXO.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmïlisyö pöghechay akulum nkaritine nko pipö angoletin nko lïke kïmïkul nyo pö Parao nyo kirïp chane ntökwit nanam ori. Möminye ompö akong nyo kingötï. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.28",
            "verseOrgIds": [
              "EXO.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kuwer pïchay pö Israel kor nyo tïyame ompö nanamnay, kïlïkwï pöghechay nayat ompö ewu tagh nko ewu löt ompö chane.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.29",
            "verseOrgIds": [
              "EXO.14.29"
            ]
          }
        }
      ]
    },
