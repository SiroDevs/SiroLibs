          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïchinecha kepe rutogh nyo pö osis sömök wölnö le surkwen atöketönö ECHOTYON Tororötïncha amöros lenyini kimwoghwecha.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.27",
