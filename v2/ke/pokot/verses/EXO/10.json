              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.24",
            "verseOrgIds": [
              "EXO.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlö Musa, “Mïchini ketïngetecha amörostin cho kïpelöy nko amörostin walaka atöketönö ECHOTYON Tororötïnyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.25",
            "verseOrgIds": [
              "EXO.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petöy tukacha nko acha tïkwïl. Möminye ompö akong nyo ngötu, mïchinecha keranga kyakicho töketönö ECHOTYON Tororöt, ompöwölo melö kinkïtöcha ye lö ne nyo kitöni ECHOTYON ntökïtenö ketacha wölini.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.26",
            "verseOrgIds": [
              "EXO.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
