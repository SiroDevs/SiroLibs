          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur Parao Musa akïlenchï, “Ape, opöghisyechinö ECHOTYON nko monekwo, wölo nya kïngötï kyakikwa.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.24",
            "verseOrgIds": [
              "EXO.10.24"
            ]
          }
        }
      ]
    },
    {
