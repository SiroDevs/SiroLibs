            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oghekwa ighisyö osis mut nko akonga, wölo asispa mut nko odeny kï Sapato nyo tïlil nyo kimuny ECHOTYON, chi anka tïkwïl nyo ighöy ighisyö asisoni ketïghöy kïma, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.2",
            "verseOrgIds": [
              "EXO.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "möminye nyo le ompö ma nyo kinoghöy ompö korikwa asisoni.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.3",
            "verseOrgIds": [
              "EXO.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kitötogh cho pö Ema nyo Tïlil",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
