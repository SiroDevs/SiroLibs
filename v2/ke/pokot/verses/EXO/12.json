                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï ECHOTYON Musa nko Aron ompö koro Misri lö, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.1",
            "verseOrgIds": [
              "EXO.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lïku arawanï ompö akwa nyo pö tagh ompö köny. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.2",
            "verseOrgIds": [
              "EXO.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwochinö söpïch pö Israel lö, ompö asisto taman nyo pö arawanï kïmïchini kïcheng chi anka tïkwïl wawa kech kïrïp kegh nko koriko papotïnekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.3",
            "verseOrgIds": [
              "EXO.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato melö pöro kachi nyo muköy ntökwam kech opïn, kutuyö kegh nko pöröryenyi. Onkïtukwa nyu kiyitötengwa kïrïp kegh nko pich cho kam wawanay pö kech. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.4",
            "verseOrgIds": [
              "EXO.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochengekwa wawa nyo lïpop nyo tïng köny akonga nyo le makal anta kwagha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.5",
            "verseOrgIds": [
              "EXO.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arorekwa ntökwit nangatu asis nyo pö taman nko angwan nyo pö arawanete, otini pöröy pipö Israel warechay. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.6",
            "verseOrgIds": [
              "EXO.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïcheng kisönkö akïnyïra pölöwo kukat nko chïrchïru kuka köyoni komisyeghö chane, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.7",
            "verseOrgIds": [
              "EXO.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "omöy chane pentö aghononi nyo kakïpel nko makatin cho puryö mumar nko onkïy cho ngwonöch. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.8",
            "verseOrgIds": [
              "EXO.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam peny kïnyaril anta nyo kakigha, wölo nyo kakïpel kïmïkul nko mötït nko kelye nko tïkuko mu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.9",
            "verseOrgIds": [
              "EXO.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakany kïngötï ompö nyo mïnïng ntökwit tökwoghö, ato mi nyo köngötï apel. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.10",
            "verseOrgIds": [
              "EXO.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyï wölo omtonekwa: okörmönekwa sïrokökwa, atö kwegh kelyön, anama lïkïp egh. Omisïyekwa lawel. Nyoni kï Pasaka nyo pö ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.11",
            "verseOrgIds": [
              "EXO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.11",
            "verseOrgIds": [
              "EXO.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ompöwölo oweran koro Misri oghononi apöran poretay löwïr ompö koro Misri nyo pö chi nko cho pö kyak arwokyinan tororötin löwïr cho pö Misri. Ochan ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.12",
            "verseOrgIds": [
              "EXO.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku kisön machey ompö akwa, ompö korïn cho omitekwa. Akï otini kasïwan kisönchoni, atïlakwa akï möminye sömewö nyo nyorokwa otini onyörilan kong pipö koro Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.13",
            "verseOrgIds": [
              "EXO.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.15"
              },
              "items": [
                {
                  "text": "Wuw 23:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.18"
              },
              "items": [
                {
                  "text": "34:18",
