      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ikïlenyi chane le nyï kïlïkwï tïsï cho pöghisyeghwanïn, ichengenyi mogh nyo mïnïng nyo le kirïk nko mökol odeny cho lïpopöch ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.1",
            "verseOrgIds": [
              "EXO.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko makatin cho puryö mumar nko makatin cho mïnkech cho puryö mumar cho kakikulkulyö nko mwagh nko makatin cho töwörör cho kakitö mwagh. Ighonyi nkanun cho kinyöryö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.2",
            "verseOrgIds": [
              "EXO.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipunö löwïr köröp akonga aikat kïrkït nko mökolkö kwodeny cho pö amöros.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.3",
            "verseOrgIds": [
              "EXO.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.3",
            "verseOrgIds": [
              "EXO.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Imïtunyi Aron nko werkachi kïpka kuka Ema nyo mi ECHOTYON* aimwata chane pögh. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.4",
            "verseOrgIds": [
              "EXO.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icheng sïrokö ailokyï Aron, koti nko sïra epod* nyo kogh nko epod nko sïra takat aikicha angwa mu nyo kikïnap nyo karam. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.5",
            "verseOrgIds": [
              "EXO.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ailokyï kopiyö mötïnyi nko aparparat nyo tïlil. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.6",
            "verseOrgIds": [
              "EXO.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aicheng mwaghay kiyiltoy aimïlchï mötïnyi aiyil nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.7",
            "verseOrgIds": [
              "EXO.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.7",
            "verseOrgIds": [
              "EXO.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atolapay imïtï werkachi ailokyï kotin chane ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.8",
            "verseOrgIds": [
              "EXO.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "airötyï Aron nko werkachi angwa mu ailokyï kopiyen, atökïlïkwï nyingwa tïsintön kokay. Lenye nyoni wölo itörortonyi Aron nko werkachi tökïpöghisyewanïn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.9",
            "verseOrgIds": [
              "EXO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.9",
            "verseOrgIds": [
              "EXO.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ikötï kïrkït tawu kuka Ema nyo mi ECHOTYON* aikany kukana Aron nko werkachi morikwa mötito kirïk, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.10",
            "verseOrgIds": [
              "EXO.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "atolapay ipörchï kïrkït tawu ECHOTYON ompö kuka Ema nyo mi ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.11",
            "verseOrgIds": [
              "EXO.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay icheng kareranpa kisönko kirïk ainyïra kuyo ato kïpelo amöros, imïlchï chinö köngötï kitoröto ato kïpelo amöros. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.12",
            "verseOrgIds": [
              "EXO.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icheng siro mu nko koghogh wölo akwagh nko söromoykö kwodeny kïmi nko sunetkökwa aipela ato kïpelo amöros. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.13",
            "verseOrgIds": [
              "EXO.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ipelonyi sany pö möngot panye cho pö kïrkït nko menyonte nko eghyante, ompöwölo kitötogh pö ngokï.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.14",
            "verseOrgIds": [
              "EXO.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.14",
            "verseOrgIds": [
              "EXO.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Icheng makal akonga ompö chay aikany kukana Aron nko werkachi morikwa mötït, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.15",
            "verseOrgIds": [
              "EXO.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "atolapay iyeng makalu aicheng kisönkö aisö ato kïpelo amöros kuwitwit. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.16",
            "verseOrgIds": [
              "EXO.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay itanatan makalu kïmïnkechitu aimwat mutïne nko kelye ainyoryö chinö mïnkech nko mötït ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.17",
            "verseOrgIds": [
              "EXO.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "aipel makalu kïmïkul ompö ato kïpelo amöros pö ECHOTYON. Nguchinanïn nyu nyo karam.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.18",
            "verseOrgIds": [
              "EXO.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
