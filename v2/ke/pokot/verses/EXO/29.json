            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.18",
            "verseOrgIds": [
              "EXO.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Icheng makalu nyinö anka aikany kukana Aron nko werkachi morikwa mötït, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.19",
            "verseOrgIds": [
              "EXO.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipar makalu aicheng kisönkö kareran ainyïra walpa yit pö Aron nyo pö ewu tagh nko walisayi yiti werkachi cho pö ewuno tagh nko walisayi morichi cho echön cho pö ewuno tagh nko walisayi mori kelyön cho echön aisö kisönkö cho köngötï ato kïpelo amöros kuwitwit. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.20",
            "verseOrgIds": [
              "EXO.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icheng kareranpa kisönchay mi ato kïpelo amöros nko mwaghay kiyiltoy aisö Aron nko werkachi nko sïrokökwa atökïtïlilitu chane nko sïrokökwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.21",
            "verseOrgIds": [
              "EXO.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.21",
            "verseOrgIds": [
              "EXO.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ichengenyi sunetko makal nko tore nko siro mu nko koghoghtö wölo akwagh nko söromoykö kwodeny kïmi nko sunetkökwa nko kïpes nyo pö ewu tagh, ompöwölo makal nyo pö kitororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.22",
            "verseOrgIds": [
              "EXO.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aichengunö köröponay mi tawunyan makatyan akonga nyo kikiyila mwaghpa orolwö nko makatyante anka nyo möminye mwagh nko anka nyo tawarar. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.23",
            "verseOrgIds": [
              "EXO.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itönenyi chï lapay ewuno Aron nko ewuneko werkachi aiwiswis kïlïkwï amöros nyo kiwiswisöy ompö tawu ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.24",
            "verseOrgIds": [
              "EXO.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay ichengunö ewunekwa aipel ompö ato kïpelo amöros nko kitötoghtinechay. Nguchinanïn nyu nyo karam. Nyoni kï ropöwon nyo pö ma ompö ani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.25",
            "verseOrgIds": [
              "EXO.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
