              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Moropï okonï kitötogh pö paghekwa nko chongïn pö dipay* nko cho pö mwaghpa arol.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
