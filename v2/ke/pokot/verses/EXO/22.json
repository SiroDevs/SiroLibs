              "type": "text"
            }
          ]
        },
        {
          "text": "Moghchï nyo gha ton anta arey nyinte, ompöwölo kyochikwa to ompö koro Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
            "verseOrgIds": [
              "EXO.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Machop kong mïsïk anta panan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.22",
            "verseOrgIds": [
              "EXO.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato achopakwa kong akïlokyanïn, oteran lokekwa lawel. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.23",
            "verseOrgIds": [
              "EXO.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onörekan tya aparakwa. Lïku korukwa mïsïktin akïlïku monekwa pönon.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.24",
            "verseOrgIds": [
              "EXO.22.24"
            ]
          }
        }
