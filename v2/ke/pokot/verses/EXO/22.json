          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato wal chi chepkïltït nyo tomönye kelotokïn akïrï tïkwïl, kutötoy kantin atökïlïkwï korkenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato tagh kwanta kuyilchï nyinte, kïmïchini kutötö kantin cho pö chepkïltït.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        }
      ]
    },
    {
