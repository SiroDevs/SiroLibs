          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agh lenyoni tïkwïl ompö twakwo nko kechiryekwo. Nya kïtïpï nko kamati ompö osis mut nko odeny, wölo okonanïn ompö asispa mut nko sömök.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
