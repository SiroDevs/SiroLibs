              "type": "text"
            }
          ]
        },
        {
          "text": "Ato ipösönchï kerpes chi nyo le nyinyan akï meywon ompö kwenunkwa, makarkegh nko pich cho le pösöntoghï cho ghoköy tösöw. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.25",
