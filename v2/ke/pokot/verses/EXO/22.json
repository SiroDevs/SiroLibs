              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okonanïkwa poretayikwo cho le wor. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.29"
