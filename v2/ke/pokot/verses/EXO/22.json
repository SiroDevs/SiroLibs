          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato osomökwa sïra pöröryengwo alekwa kiyoku, oyokyï kïtomö kïröytö asis, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
