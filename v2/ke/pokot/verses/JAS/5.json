              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.18",
            "verseOrgIds": [
              "JAS.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JAS 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mi chi kwenunkwa tupchenichu, nyo kakupotö ara man akuyokï chitö anka, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.19",
            "verseOrgIds": [
              "JAS.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JAS 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.10.12"
              },
              "items": [
                {
                  "text": "Ngt 10:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.8"
              },
              "items": [
                {
                  "text": "1Pt 4:8",
                  "type": "text"
                }
              ]
