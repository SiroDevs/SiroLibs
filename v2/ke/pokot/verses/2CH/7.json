              },
              "items": [
                {
                  "text": "Law 9:23-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyini kiwang Solomon saghatenyi, kïrökunö ma yïm akïpel ropöwechay kïpelöy löwïr nko amörostine akïnyïghï ororyo ECHOTYON köyay pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Memukyïcha tïsï ntö kïlït köyoni ompöwölo kinyïghitate ororyo ECHOTYON köyoni pö saghat. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
