          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31+EXO.25.32+EXO.25.33+EXO.25.34+EXO.25.35+EXO.25.36+EXO.25.37+EXO.25.38+EXO.25.39+EXO.25.40"
              },
              "items": [
                {
                  "text": "Wuw 25:31-40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh orïmo koltin nyo kisoch taman, akïsötyï wölo kitömöy kïrïp kegh nko wölini kikïmwochï kwigh tïkuchoni kulut Kö pö Tororöt* ori, mut okumpö tagh kïlö mut okumpö löt. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.7",
            "verseOrgIds": [
              "2CH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.23+EXO.25.24+EXO.25.25+EXO.25.26+EXO.25.27+EXO.25.28+EXO.25.29+EXO.25.30"
              },
              "items": [
                {
                  "text": "Wuw 25:23-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh ngat mesen taman akulut Kö pö Tororöt ori, mut okumpö tagh kïlö mut ewu löt. Atolapay kwigh otupöy 100 cho pö koltin.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.8",
            "verseOrgIds": [
              "2CH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.8",
            "verseOrgIds": [
              "2CH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwach ngat kasaru tïsï nko kasar nyo wow, kwighchï kukot akuluma kukotkö kari taghoy. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.9",
            "verseOrgIds": [
              "2CH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitö ngarpïlu kïtöpö ewu tagh kïparta okumpö kongasis kuros wölnö katankulegha Kö pö Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.10",
            "verseOrgIds": [
              "2CH.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.10",
            "verseOrgIds": [
              "2CH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh Uram tören nko kölöpöchtin cho echön cho pö karïn, akwigh otupöy. Kïlenyona kuwany Uram ighisyenyi nyo kighchini pöytoghin Solomon ompö Kö pö Tororöt. Choni kï:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11+2CH.4.12+2CH.4.13+2CH.4.14+2CH.4.15+2CH.4.16",
            "verseOrgIds": [
              "2CH.4.11",
              "2CH.4.12",
              "2CH.4.13",
              "2CH.4.14",
              "2CH.4.15",
              "2CH.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.18",
            "verseOrgIds": [
              "2CH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tïkwïn löwïr cho kighchï Solomon Kö pö Tororöt, kï ato kïpelo amöros nyo pö koltin nko mesen cho pö makatin cho kipöy tawu ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.19",
            "verseOrgIds": [
              "2CH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigha koltin kelyeto orïmonay kisoch taman cho kinoghöy tökïlöpochï Wölo Tïlil Tya* le otini kikïmwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.20",
            "verseOrgIds": [
              "2CH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigha tapïkokö nko orïmonay kisoch taman nko kitömöwekwa koltin cho pïchighöch nko, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.21",
            "verseOrgIds": [
              "2CH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "makasin cho risöy tatïn walay nöghsot nko otupöy cho mïnkech nko akölöpöchtin nko tören cho kipo ma. Kikigha choni löwïr koltin cho pïchighöch. Kikiluma koltin cho pïchighöch kukoti Kö pö Tororöt nko kukoti cho pö ori cho kïlïto Wölo Tïlil Tya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.22",
            "verseOrgIds": [
              "2CH.4.22"
            ]
          }
        }
      ]
    }
