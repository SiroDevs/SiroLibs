                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.36"
              },
              "items": [
                {
                  "text": "Mat 9:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.34"
              },
              "items": [
                {
                  "text": "Mrk 6:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Mikaya lö, “Kyasïwan pipö Israel löwïr kitoytoyö ompö kutïngkot le kechir cho mötïnye mösöwon. Kïmwa ECHOTYON lö, ‘Mötïngcha pïchï kintöghoghin, nya kïmïlisyö kestonikwa ompö kalya.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.16",
            "verseOrgIds": [
              "2CH.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.16",
            "verseOrgIds": [
              "2CH.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï pöytoghinto Israel Yeosyapat, “Olentan komwowunyi nya lö, möngorönye chichï kïgh nyo karam kutöngwanïn kïpoto ghöyityö pat.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.17",
