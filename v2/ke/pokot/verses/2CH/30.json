          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ighata kegh ompö Ichon pö Pasaka*",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta Esekia pich kïpa kïkurï pipö Israel löwïr nko cho pö Yuda, akukirta palaltin kukirchï möngi Epraim nko cho pö Manase kïpka Kö pö Tororöt nyo mi Yerusalem, kwam Ichon pö Pasaka nyo kïkonyïto ECHOTYON Tororöt pö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.1",
            "verseOrgIds": [
              "2CH.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.9.9+NUM.9.10+NUM.9.11"
              },
              "items": [
                {
                  "text": "Kiy 9:9-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kichomnyechï pöytoghintö Esekia nko kintöghoghï nko nyorye kïmïkul lö, kyomöy Ichon pö Pasaka ompö arawa odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.2",
            "verseOrgIds": [
              "2CH.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kimemïcha kwam arawa tagh, ompöwölo kingörï tïsï cho kikikutïlil kegh, akitomöcha kïpka pich kuryam ompö Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.3",
            "verseOrgIds": [
              "2CH.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcham pöytoghintö nko tuye kïmïkul tötutchoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.4",
            "verseOrgIds": [
              "2CH.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona akonga kekurï pipö Israel löwïr kïngetunö Persyepa ntökwit Dan kïpka kwam ichon nyo kïkonyïto ECHOTYON Tororöt pö Israel ompö Yerusalem, ompöwölo kimökïrïpcha pich cho chang le wölini kikikirta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.5",
            "verseOrgIds": [
              "2CH.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnam nyu pöytoghintö nko yetïntinechi pich kïpa kwip palaltin kïghömï Israel nko Yuda kïmïkul. Kilentöy palaltinechoni kikir pöytoghintö, “Owöghökisyenö wölo mi ECHOTYON Tororöt pö Apraam nko Isak nko Yakopo pipö Israel, atömanyïl kïwaghaka ngat nyinte kïpörï wölo mi ngötunönkökwo cho kyochïwïtyeghö mori pöytoghi Asirya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.6",
            "verseOrgIds": [
              "2CH.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malïkwï papotïnekwo nko werkökwo cho kimeghancha ECHOTYON Tororöto papotïnekwa, tökïtenö kïpïstö kïnyörïlyö chane le wölo asïwïyekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.7",
            "verseOrgIds": [
              "2CH.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malïkwï ye nyu tighï le wölo kilata papotïnekwa wölo oterchï ECHOTYON, apkan konyi nyo tïlil nyo kikwigh kïtïlilit kokay, apöghisyechï ECHOTYON Tororötïngwo atömanyïl kuyoda kegh nörekyenyi nyï körom le nyï ompöwölo omitekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.8",
            "verseOrgIds": [
              "2CH.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo ato owöghökisyekwa wölo mi ECHOTYON kïnyoru tupchenikwa nko monekwa kisyonöt kungwïna wölo mi nömikwa akïmïlisyö kutöngwï koronetenyi. Ompöwölo pöropchon ECHOTYON Tororötïnkwa akïtïng kisyonöt amötöghokwanye ato owöghökisyekwa wölo mi nyinte.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.9",
            "verseOrgIds": [
              "2CH.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.9",
            "verseOrgIds": [
              "2CH.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa pïchoni kikïyonta kuwerata kanasyan anka tïkwïl, kïghömi koro Epraim nko Manase tökurel Saplon. Wölo kikïroröchï chane akengörer. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.10",
            "verseOrgIds": [
              "2CH.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïrïny kegh pipö Asyer nko Manase nko Saplon cho ngörï akïpka kutöngwï Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.11",
            "verseOrgIds": [
              "2CH.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh Tororöt pipö Yuda kïcham löwïr ngölyonto pöytoghin nko yetïntinechi kïrïp kegh nko ngölyonto ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.12",
            "verseOrgIds": [
              "2CH.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ichon pö Pasaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.12",
            "verseOrgIds": [
              "2CH.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurelï pich cho chang arawa odeny, kïghömïtï kegh Yerusalem atökwam Ichon pö Makatin cho puryö Mumar, ki söpïch nyo wow nyoman. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.13",
            "verseOrgIds": [
              "2CH.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutor ighisyengwa kïngany ato kïpelo amöros ompö Yerusalem akïngany ato kïpelo amöros löwïr cho pö tïkwïn cho ngutoy cho onyïn, akurit kïpa kïwirchï mpöghoghyo Kidron. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.14",
            "verseOrgIds": [
              "2CH.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyeng wawa kecha Pasaka asispa taman nko angwan nyo pö arawanoni pö odeny. Kïnam arasï tïsï nko pipö Lawi, nyo kigh chane kutïlil kegh akwipï amörostin cho kïpelöy Kö pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.15",
            "verseOrgIds": [
              "2CH.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpechï ocheywekwa cho kighöy su, kïrïp kegh nko Kirurut pö Musa chi pö ECHOTYON, kwisö tïsï kisön cho kitö pipö Lawi ato kïpelo amöros. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.16",
            "verseOrgIds": [
              "2CH.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kimito nyoryononi pich cho chang cho kitomöcha kutïlil kegh, kïyenchï pipö Lawi chi anka tïkwïl nyo kitomönye kutïlil kegh wawa kecha Pasaka, atökutïlilchï ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.17",
            "verseOrgIds": [
              "2CH.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö söpïchoni kitomönye kutïlil kegh pïchoni cho chang cho kipkono: Epraim nko Manase nko Isakar nko Saplon wölo kyam Pasaka, mökïrcha le wölo kikikirta. Ompöwölo kisoghchï Esekia chane lö, “We ECHOTYON, ichinyi karam, löstoghchinö chi anka tïkwïl nyo mi yi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.18",
            "verseOrgIds": [
              "2CH.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyo kikwigh mïkulöwunyi kïyarinyi, nyo ichï ECHOTYON Tororöto papotïnekwa, kïrkegh melö tïlil kïrïpata kegh nko kirurut pö kitïlilöt.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.19",
            "verseOrgIds": [
              "2CH.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïterchï ECHOTYON Esekia akwigh pich kïsöpchö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.20",
            "verseOrgIds": [
              "2CH.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwam nyu pipö Israel cho kimi Yerusalem Ichon pö Makatin cho puryö Mumar osis mut nko odeny ompö ngörekyö nyo wow, kïpechï pipö Lawi nko tïsï kïsal ompö asis anka tïkwïl akïtumchini ECHOTYON ompö owesyengwa löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.21",
            "verseOrgIds": [
              "2CH.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngalan Esekia kutö mïkulögh pipö Lawi löwïr cho kiporï tïnganat nyo karam ompö ighisyo ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.22",
            "verseOrgIds": [
              "2CH.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ichontö nyo pö odeny",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwam pich omisyo ichon osis mut nko odeny, akutötoy amörostino ropöwo kalya kuyokyini sörö ECHOTYON Tororöto papotïnekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.22",
            "verseOrgIds": [
              "2CH.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïmut tuyonay kïmïkul akonga kwam ichon osiswe walak mut nko odeny ompö ngörekyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.23",
            "verseOrgIds": [
              "2CH.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kitö Esekia pöytoghinto Yuda tuyononi eghin cho le 1,000 nko kechir cho le 7,000 kïlïkwï ropöw. Akïpösï ngat yetïntinö, tuyononi eghin 1,000 nko kechir cho le 10,000. Ompö atoni kitïlil kegh tïsï cho chang. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.24",
            "verseOrgIds": [
              "2CH.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngörekyö söpïch pö Yuda löwïr, kïngörekyö tïkwïl tïsï nko pipö Lawi akïngörekyö pich cho kimi söpïch nyo kingwïno Israel nko pïnot cho kipkono koro Israel nko cho kimöngöy koro Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.25",
            "verseOrgIds": [
              "2CH.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kimi ngörekyö nyo wow Yerusalem, ompöwölo melö kitö kwigha kïgh nyo lenye nyete ompö Yerusalem kïngata osiswo Solomon wero Daudi pöytoghinto Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.26",
            "verseOrgIds": [
              "2CH.30.26"
            ]
          }
        },
