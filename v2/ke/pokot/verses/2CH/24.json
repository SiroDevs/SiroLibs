              "2CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyoda kegh lïkonay pö Sirya, kïpïstö Yoas kotyon. Kïyar or mötworichi nyo pöro nyinte, ompöwölo kimïlata nyinte kisön pö wero tïsin Yeoyada kepörchï pöröyunyi. Ketïpchï Yoas kanasyanta Daudi wölo mötïpchïnye chi pïrïmpoti pöytoghï. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.25",
            "verseOrgIds": [
              "2CH.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pïchoni kipar Yoas kï ki ompö, Sapad wero korka nyo kikïkuro Syimeat nyo ngwïno Amon nko Yeosapad wero korka nyo kïkuro Syimrit nyo ngwïno Moap. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.26",
            "verseOrgIds": [
              "2CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikikirchï ngala werpö Yoas nko cho pö werkoynön parakunyi nko ighata Kö pö Tororöt kitapï nyo kikikirchï ngala pöytoghï. Kïpayta Amasya werïnyi kuker nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.27",
            "verseOrgIds": [
              "2CH.24.27"
            ]
          }
        }
