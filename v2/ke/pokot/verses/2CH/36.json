              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurit Nepukadnesa kari Kö pö Tororöt walak kutang Papilon akïwö kutö konyi nyo pö paytagh ompö Papilon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirote ighisyewut walak cho kigh pöytoghintö Yeoyakim kïmi nko ngokichi nko tïkwïn walak cho ghach kitapu pöytoghi Israel nko Yuda. Kuker werïnyi Yeoyakin kïpayta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        }
      ]
