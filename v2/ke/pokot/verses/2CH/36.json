            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtor Yeoyakim kïpayta ato kitïng könyis 25 kïpayta könyis taman nko akonga ompö Yerusalem. Kigh nyinte ngokï ompö tawu ECHOTYON Tororötïnyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.5",
            "verseOrgIds": [
