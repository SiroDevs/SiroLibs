        "sid": "2CH 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kitïta Reopoam Yerusalem, kïghamït mïrön cho le wutï 180,000 cho kipkana Yuda nko cho pö Penchamen, kïporyeghö pipö Israel, atökïpöyit Reopoam paytagh. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.1",
            "verseOrgIds": [
              "2CH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kingwïnchï ngölyonto Tororöt werkoyon Syemaya chi pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.2",
            "verseOrgIds": [
              "2CH.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lenchinö Reopoam wero Solomon pöytoghinto Yuda nko pipö Israel löwïr cho mi Yuda nko Penchamen lö, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.3",
            "verseOrgIds": [
              "2CH.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "lentöy ECHOTYON, ‘Mapa oporyeghö werkökwa pipö Israel, mïlena chi anka tïkwïl katangu ompöwölo pkono ngalechï löwïr wölo omitan.’ ” Kïter nyu pïchay ngala ECHOTYON akïmïlisyö kestonikwa amakïpacha kïporyeghö Yeropoam.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.4",
            "verseOrgIds": [
              "2CH.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kitek Reopoam kanastin cho gheto kegh",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.4",
            "verseOrgIds": [
              "2CH.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimang Reopoam Yerusalem akïtek kanastin cho gheto kegh ompö Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.5",
            "verseOrgIds": [
              "2CH.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitek Petleem nko Etam nko Tekoa ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.6",
            "verseOrgIds": [
              "2CH.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Petsur nko Soko nko Adulam ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.7",
            "verseOrgIds": [
              "2CH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Kat nko Maresya nko Sip ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.8",
            "verseOrgIds": [
              "2CH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Adoraim nko Lakis nko Aseka ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.9",
            "verseOrgIds": [
              "2CH.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Sora nko Ayalon nko Epron, kanastin cho mi Yuda nko Penchamen.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.10",
            "verseOrgIds": [
              "2CH.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.10",
            "verseOrgIds": [
              "2CH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitek nïyet kwoghïghitu akutö kighyongteghï ori nko töpotoni omisyö nko mwagh nko dipay.* ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.11",
            "verseOrgIds": [
              "2CH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kutö kanastinechoni löwïr longoy nko ngötwö akwigh kwongeritu tya. Kïpayta nyu Yuda nko Penchamen kïlïkwï nyenyi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.12",
            "verseOrgIds": [
              "2CH.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiwuchï tïsï nko pipö Lawi Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.12",
            "verseOrgIds": [
              "2CH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipka tïsï nko pipö Lawi löwïr cho kimi Israel wölo mi nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.13",
            "verseOrgIds": [
              "2CH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kipïstö pipö Lawi koroswekwa wölo kiyokwïyöy kyakikwa akïpïstö tïkukwa akïpka kutöngwï Yuda nko Yerusalem, ompöwölo kiyon chane Yeropoam nko werkachi lö, tömegh ighisyo tïsö kwighchï ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.14",
            "verseOrgIds": [
              "2CH.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.31"
              },
              "items": [
                {
                  "text": "1Pöy 12:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkïlchï kegh tïsichi cho pöghisyechini wölo kïsogho körkeyïntin nko cho kisoghöy oy nko cho kisoghöy körkeyïntin cho kikigh ompö körkeyïntino mogh. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.15",
            "verseOrgIds": [
              "2CH.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpka pipö Israel löwïr cho kikikutö kïpsach mïkuliskökwa kïyar ECHOTYON Tororöt pö Israel. Kïrïpï pipö Lawi, kïpa kutö ECHOTYON Tororöto papotïnekwa amöros ompö Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.16",
            "verseOrgIds": [
              "2CH.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyetï nyu paytaghpa koro Yuda, akwawesit Reopoam wero Solomon ompö könyis sömök ompöwölo kirïp otöpto kwanta Daudi nko Solomon ompö könyis sömök.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.17",
            "verseOrgIds": [
              "2CH.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kaporpa Reopoam",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.17",
            "verseOrgIds": [
              "2CH.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwip Reopoam Maalat chepö Yerimot wero Daudi nko nyo pö Apiail chepö Elyap wero Yese, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.18",
            "verseOrgIds": [
              "2CH.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïyichï kokononi wor sömök: choni kï ompö Yeus nko Syemarya nko Saam. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.19",
            "verseOrgIds": [
              "2CH.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwip ngat Maaka chepö Apsolom, kïyichï Maaka nyinte Apiya nko Atai nko Sisa nko Syelomit. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.20",
            "verseOrgIds": [
              "2CH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicham Reopoam Maaka chepö Apsolom kïtïl koruchi löwïr nko koru walak cho kimatarnye. Koruchi löwïr kï ki 18 nko chemïnïngwenichi* cho le 60, kitïng wor cho le 28 nko tipïn cho le 60. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.21",
            "verseOrgIds": [
              "2CH.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitö Reopoam Apiya wero Maaka kïpöyï werkökwa, ompöwölo kimököy kwighöy nyinte kïlïkwï pöytoghin. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.22",
            "verseOrgIds": [
              "2CH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichaghta ompö chïreryö werkachi walak kïghömï koro Yuda nko Penchamen nko kanastin löwïr cho kikiwach, akutö chane omisyö nyo wow nyoman akïyörchï kor cho chang.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.23",
            "verseOrgIds": [
              "2CH.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kipokyï pipö Misri koro Yuda",
          "type": "text"
        }
      ]
    }
  ],
