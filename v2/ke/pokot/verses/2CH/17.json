      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiker Yeosyapat ngacharuto kwanta, kwigh kegh nyinte kïporyö nko Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.1",
            "verseOrgIds": [
              "2CH.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitö pipö lïk kanastin löwïr cho kikiwach cho pö Yuda nko kanastina Epraim cho kikikïcheng papoto Asa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.2",
            "verseOrgIds": [
              "2CH.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi ECHOTYON nko Yeosyapat ompöwölo kirïp otöp nyo kipö tagh nyo pö paponyi, masaghnye Paal.* ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.3",
            "verseOrgIds": [
              "2CH.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kiyar Tororöt pö paponyi akïrïp kirurutkachi, amarïpnye otöptino pipö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.4",
            "verseOrgIds": [
              "2CH.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kwigh ECHOTYON paytaghtanyi kïchïchïm tya kwipchï pipö Yuda löwïr Yeosyapat ropöw kïsïkönon akïnyorï konyït nyo wow. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.5",
            "verseOrgIds": [
              "2CH.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki nyakan mïkulöwunyi ompö ortïna ECHOTYON kulet tagh kunyar wölay syolote nko Asyera* ompö Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.6",
            "verseOrgIds": [
              "2CH.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.6",
            "verseOrgIds": [
              "2CH.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö könyi sömök nyo pö paytaghtanyi kiyoktö Penail nko Opadia nko Sakaria nko Netanel nko Mikaya cho kile kintöghoghï kunetisyö ompö kanastina Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.7",
            "verseOrgIds": [
              "2CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi pipö Lawi nko chane choni kï ompö: Syemaya nko Netania nko Sepadia nko Asael nko Syemiramot nko Yeonatan nko Adonicha nko Topiya nko Topadoniya. Kimi tïkwïl Elisyama nko Yeoram cho kile tïsi pipö Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.8",
            "verseOrgIds": [
              "2CH.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunetisyö ompö Yuda akitïng kitapu Kirurut* pö ECHOTYON, kipestegha kanastina Yuda löwïr kunetotoy pich.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Owesyo Yeosyapat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichumchï otyogh pö ECHOTYON pöytoghï löwïr cho pö koros cho kimang kuwit Yuda akimökïpacha kïpar kegh nko Yeosyapat. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.10",
            "verseOrgIds": [
              "2CH.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwipchï pipö Pilisti walak Yeosyapat ropöw, akwipchï silpa kïlïkwï surï kwipï pipö Arepya mökol 7,700 nko kwöghe 7,700. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.11",
            "verseOrgIds": [
              "2CH.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyetï Yeosyapat akwawesit nyoman, kïtek wölo kikïmöröro pung nko kanastin cho kïrorchini tïkwïn ompö Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.12",
            "verseOrgIds": [
              "2CH.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akitïng kaplawachtin cho echön ompö kanastina Yuda akitïng mïrön pö lïk cho le nyökon cho kimi Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.13",
            "verseOrgIds": [
              "2CH.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyitötengwa kïrïp kegh nko koriko papotïnekwa kï chï:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.14+2CH.17.15+2CH.17.16+2CH.17.17+2CH.17.18",
            "verseOrgIds": [
              "2CH.17.14",
              "2CH.17.15",
              "2CH.17.16",
              "2CH.17.17",
              "2CH.17.18"
            ]
          }
        }
      ]
    }
  ],
