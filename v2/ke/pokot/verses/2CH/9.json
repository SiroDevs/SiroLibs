            "sid": "2CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirote ighisyewut löwïr cho kigh pöytoghintö Solomon kïngata söröm nko söröm kitapu werkoyon Natan nko werkoynöno Aiya nyo pö Syilo nko kiporut pö Kirosinto Ido nyo kisïwa ngala Yeropoam wero Nepat? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipayta Solomon Israel kïmïkul ompö Yerusalem könyis tömönut angwan. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïma Solomon aketïpchï kanasyanteto kwanta Daudi, kuker werïnyi Reopoam nyinte kïpayta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kipesyö pipö ortïn cho kimi okumpö löt",
          "type": "text"
        }
