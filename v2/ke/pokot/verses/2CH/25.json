          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuset pöytoghinto Israel Yeoas lïk kïwö kïporyö nko pöytoghinto Yuda Amasya. Kuryama Pet Syemes nyo mi koro Yuda, kïporyeghö atoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.21",
            "verseOrgIds": [
              "2CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrïnta pipö Israel cho pö Yuda, kïryagh pipö lïko Yuda kïpa kestonikwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.22",
            "verseOrgIds": [
              "2CH.25.22"
            ]
          }
        }
      ]
    },
