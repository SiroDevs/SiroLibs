          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnam Yeoas pöytoghinto Israel Amasya wero Yoas wero Aasia pöytoghinto Yuda kïnama Pet Syemes, akwip kïwö Yerusalem. Kurultö nayatu kanasyantanoni kïngeta Kuka Epraim tökurel Kuka Luch ki lekït lowïnto kirulötononi miten 200. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcheng koltin nko silpa löwïr nko karïn löwïr cho kimi Kö pö Tororöt* cho kiripöy Oped Edom akïcheng tïkwïn cho kirorote ompö kö pö soch nko pich cho kirötote Atolapay kuyoda kegh kutang Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
