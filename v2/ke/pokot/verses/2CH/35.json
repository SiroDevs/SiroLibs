          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko ighisyewutkachi cho pö tagh nko cho pö löt, kï kikikirchï kitapu pöytoghi Israel nko Yuda.",
          "type": "text",
