              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirote ighisyewut walak cho kigh pöytoghintö Yosia nko tïkwïn cho karamach cho kigh kïrïp kegh nko kirurut pö ECHOTYON, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
              "2CH.35.26"
            ]
          }
        },
        {
          "name": "verse",
