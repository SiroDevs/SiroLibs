      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kyoghyö pipö Israel löwïr Yordan, kïlenchï ECHOTYON Yoswö, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.1",
            "verseOrgIds": [
              "JOS.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïla mïrön taman nko odeny ompö pipö Israel, ngwïno chi akong tïkwïl arengwa ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.2",
            "verseOrgIds": [
              "JOS.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "aimwochï chane kïkwagh koghïn cho le taman nko odeny ompö kwenu Yordan wölay keghyongö kelyo tïsï ap kwoghyö wölini oruyokwa asïna.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.3",
            "verseOrgIds": [
              "JOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.3",
            "verseOrgIds": [
              "JOS.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïkur Yoswö pïchay le taman nko odeny cho kökikïl nyinte ompö pipö Israel, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.4",
            "verseOrgIds": [
              "JOS.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïlenchï chane, “Ape antaghoghena Santuku Muma* ECHOTYON Tororötïngwo ntat kwenu Yordan akïsït chi anka tïkwïl ompö akwa, kogh ompö katïnyi, kïrïp kegh nko ortïna pipö Israel, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.5",
            "verseOrgIds": [
              "JOS.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "atökïlïkwï kiporunöt ompö kwenunkwa, ato tepekwa monekwa ompö osis cho pkonöy lö, ‘Pöru ne koghichï?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.6",
            "verseOrgIds": [
              "JOS.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olenchï, ‘Kimuryö pögho Yordan ompö tawu Santuku Muma ECHOTYON, otini kyowu Yordan.’ Kïlenyona nyu, lïku koghichï kinonut ompö Israel kokay.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.7",
            "verseOrgIds": [
              "JOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.7",
            "verseOrgIds": [
              "JOS.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh pipö Israel lenyini kimwochï Yoswö chane, kïkwagh koghïn taman nko odeny ompö kwenu Yordan, kïrïp kegh nko wölo tenö ortïna pipö Israel, lenyini kimwochï ECHOTYON Yoswö akwip kwoghyö ntökwit wölo kiruyot chane akuyin atoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.8",
            "verseOrgIds": [
              "JOS.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusupchï Yoswö koghichay le taman nko odeny kwenu Yordan wölay kighyongö kelyo tïsï cho kipöy Santuku Muma akïtökïmito otini nko ye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.9",
            "verseOrgIds": [
              "JOS.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kighyongö tïsï cho kipöy Santuku kwenu Yordan, ntökïtenö kuwonyö kïgh anka tïkwïl nyo kilenchï ECHOTYON Yoswö mwochinö pich, kïrïp kegh nko tïkuchini löwïr kimwochï Musa Yoswö.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.10",
            "verseOrgIds": [
              "JOS.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoghyö pich lalwa antakwagh lawel. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.10",
            "verseOrgIds": [
              "JOS.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akï nyini kyoghyö pich löwïr kumuchö, kwoghyö nyu tïsï nko Santuku Muma ECHOTYON akuntaghogha pich. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.11",
            "verseOrgIds": [
              "JOS.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoghyö werpö Rupen nko cho pö Kad nko kareranpa ara Manase kuntaghogha pipö Israel kïmi nko karikwa, le wölini kimwochï Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.12",
            "verseOrgIds": [
              "JOS.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingata pich 40,000 cho kimi kïpsach kïporyö akipa tawu ECHOTYON tökïporyö ompö mpöghoghyo Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.13",
            "verseOrgIds": [
              "JOS.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh ECHOTYON Yoswö asisoni kekonyït ompö tawu pipö Israel löwïr le wölo kikikonyïtö Musa ompö osis löwïr cho pö möngenyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.14",
            "verseOrgIds": [
              "JOS.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.14",
            "verseOrgIds": [
              "JOS.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Yoswö, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.15",
            "verseOrgIds": [
              "JOS.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwochinö tïsï cho kisït Santuku Muma kïpkana kwenu Yordan.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.16",
            "verseOrgIds": [
              "JOS.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï Yoswö chane lenyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.17",
            "verseOrgIds": [
              "JOS.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akï nyini kipkana kwenu Yordan tïsichay kisït Santuku Muma ECHOTYON akwit sany wölo tïyame, kïmïlisyö pögho Yordan otengwa lenyini, akïnyïghï ntökuwachta le tagh.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipkana pich nyu Yordan asispa taman nyo pö arawa tagh akïtek möngot ompö Kilkal, sörömu Yeriko wölo le kongasis. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.19",
            "verseOrgIds": [
              "JOS.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisupchï nyu Yoswö Kilkal koghichay le taman nko odeny kikipö Yordan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.20",
            "verseOrgIds": [
              "JOS.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchï Yoswö pipö Israel, “Atotep monekwa papotïnekwa ompö osis cho pkonöy lö, ‘Poru ne koghichï?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.21",
            "verseOrgIds": [
              "JOS.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwochikwa chane lö, ‘Kyoghyö Israel Yordan kïtïyame.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.22",
            "verseOrgIds": [
              "JOS.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kigh ECHOTYON Tororötïnkwa akïyam Yordan kiteny ompö tawunkwa, le wölo kida nyinte Nanam nyo Pïrir ntökïtenö kyoghyenöcha, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.23",
            "verseOrgIds": [
              "JOS.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "atökunkïtï pich löwïr ompö ngwïny lö wow owesyo ECHOTYON, ato konyïtö ECHOTYON Tororötïngwo kokay.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.24",
            "verseOrgIds": [
              "JOS.4.24"
            ]
          }
        }
      ]
    }
  ],
