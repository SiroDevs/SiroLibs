          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiwonyö ngalechoni, kïrapas Yoswö wero Nun, mötworinto ECHOTYON, ato kitïng könyis 110. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
