      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïghamït nyu Yoswö ortïna pipö Israel löwïr ompö Syekem akïkur poy nko kintöghoghï nko kirwokot nko wowïntino pipö Israel akughyongö tawu Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.1",
            "verseOrgIds": [
              "JOS.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.11.17"
              },
              "items": [
                {
                  "text": "Tow 11:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchï Yoswö pïchay löwïr, “Lentöy ECHOTYON Tororöt pö Israel, ‘Kimöngöy könyisyok papotïnekwa Tera papoto Apraam nko Naor, lalwa Yuparet antakwagh, akipöghisyechini tororötin walaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.2",
            "verseOrgIds": [
              "JOS.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.1+GEN.12.2+GEN.12.3+GEN.12.4+GEN.12.5+GEN.12.6+GEN.12.7+GEN.12.8+GEN.12.9"
              },
              "items": [
                {
                  "text": "Tow 12:1-9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.21.1+GEN.21.2+GEN.21.3"
              },
              "items": [
                {
                  "text": "21:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyamïtunan paponkwa Apraam lalwa Yuparet antakwagh antöghoghchan ompö koro Kanan kïmïkul atasan yiyötenyi otö Isak nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.3",
            "verseOrgIds": [
              "JOS.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.24+GEN.25.25+GEN.25.26"
              },
              "items": [
                {
                  "text": "Tow 25:24-26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.36.8"
              },
              "items": [
                {
                  "text": "36:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.1+GEN.46.2+GEN.46.3+GEN.46.4+GEN.46.5+GEN.46.6+GEN.46.7"
              },
              "items": [
                {
                  "text": "46:1-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.2.5"
              },
              "items": [
                {
                  "text": "Krt 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay otönön Isak Yakopo nko Esau. Otönön Esau kamaspa Edom kïcheng, wölo kiwö Yakopo nko monechi Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.4",
            "verseOrgIds": [
              "JOS.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Wuw 3:1–12:42.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayontan Musa nko Aron atönön nyarïl nyo wow koro Misri. Atolapay amwïtwokwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.5",
            "verseOrgIds": [
              "JOS.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.1+EXO.14.2+EXO.14.3+EXO.14.4+EXO.14.5+EXO.14.6+EXO.14.7+EXO.14.8+EXO.14.9+EXO.14.10+EXO.14.11+EXO.14.12+EXO.14.13+EXO.14.14+EXO.14.15+EXO.14.16+EXO.14.17+EXO.14.18+EXO.14.19+EXO.14.20+EXO.14.21+EXO.14.22+EXO.14.23+EXO.14.24+EXO.14.25+EXO.14.26+EXO.14.27+EXO.14.28+EXO.14.29+EXO.14.30+EXO.14.31"
              },
              "items": [
                {
                  "text": "Wuw 14:1-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyamïtunan papotïnekwa Misri ntökwitï nanam. Kirïpï pipö Misri papotïnekwa ompö nkaritin nko angoletin ntökwitï Nanam nyo Pïrir. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.6",
            "verseOrgIds": [
              "JOS.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akï nyini kirirchanïn chane otönön tuwïn kwenungwa nko pipö Misri, atolapay aluman chane pögho nanam akïtïp akyasiwekwa ngal cho kyaghan ompö Misri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.7",
            "verseOrgIds": [
              "JOS.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Amangakwa surkwen osis cho chang. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.7",
            "verseOrgIds": [
              "JOS.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.21+NUM.21.22+NUM.21.23+NUM.21.24+NUM.21.25+NUM.21.26+NUM.21.27+NUM.21.28+NUM.21.29+NUM.21.30+NUM.21.31+NUM.21.32+NUM.21.33+NUM.21.34+NUM.21.35"
              },
              "items": [
                {
                  "text": "Kiy 21:21-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay amïtwakwa ntatukwa koro pipö Amori cho möngöy lalwa Yordan antakwagh kïporyeghenokwa, otönön chane morikwa, achengakwa korengwa awanyan chane. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.8",
            "verseOrgIds": [
              "JOS.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Kiy 22:1–24:25.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinget Palak wero Sipor pöytoghinto Moap kïporyeghenokwa, kïyonta pich kïkurï Palaam wero Peor atökïchïpokwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.9",
            "verseOrgIds": [
              "JOS.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kyachaman oterchï Palaam, kïlenyona kusoyönokwa, osörunenokwa nyu mori Palak. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.10",
            "verseOrgIds": [
              "JOS.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.3.14+JOS.3.15+JOS.3.16+JOS.3.17"
              },
              "items": [
                {
                  "text": "Yos 3:14-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.6.1+JOS.6.2+JOS.6.3+JOS.6.4+JOS.6.5+JOS.6.6+JOS.6.7+JOS.6.8+JOS.6.9+JOS.6.10+JOS.6.11+JOS.6.12+JOS.6.13+JOS.6.14+JOS.6.15+JOS.6.16+JOS.6.17+JOS.6.18+JOS.6.19+JOS.6.20+JOS.6.21"
              },
              "items": [
                {
                  "text": "6:1-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oghyekwa Yordan ntat Yeriko, kïporyeghenokwa pipö Yeriko nko Amori nko Peris nko Kanan nko Ititi nko Kirkasyi nko Ipiti nko Yepusi. Wölo kyokonokwa owesyö arïntena chane. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.11",
            "verseOrgIds": [
              "JOS.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.28"
              },
              "items": [
                {
                  "text": "Wuw 23:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.20"
              },
              "items": [
                {
                  "text": "Krt 7:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyayoktan koromin nyo kintaghoghenokwa nyo kiyon pöytoghi pipö Amori kwodeny akwompö akwa. Melö kyompö chokonikwa anta ompö ngötwekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.12",
            "verseOrgIds": [
              "JOS.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.10+DEU.6.11"
              },
              "items": [
                {
                  "text": "Krt 6:10-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akonokwa koros cho masïngekwanye nko kanastin cho melö kyatekakwa amangakwa ori, amakwa sapipun nko arol cho melö kyakatkatakwa.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.13",
            "verseOrgIds": [
              "JOS.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.13",
            "verseOrgIds": [
              "JOS.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïtas tagh Yoswö kïlö, “Okonyïtö ECHOTYON, apöghisyechï nyinte ompö mïkulögh nyo melö pö lïs nko ompö man, opïstenö tororötinechay kipöghisyechini papotïnekwa ompö koro Mesopotamiya nko ompö Misri, apöghisyechï ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.14",
            "verseOrgIds": [
              "JOS.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato mochömekwanye opöghisyechinö ECHOTYON akïl asisete lö ngo opöghisyechini, ato kö tororötinechay kipöghisyechini papotïnekwa ompö koro Mesopotamiya, anta tororötino pipö Amori chï omöngekwa korengwa, wölo ani nko katanyan opöghisyechinan ECHOTYON.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.15",
            "verseOrgIds": [
              "JOS.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.15",
            "verseOrgIds": [
              "JOS.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï nyu pïchay lö, “Mökïpïstonechanye kepöghisyechinö ECHOTYON akepöghisyechï tororötin walaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.16",
            "verseOrgIds": [
              "JOS.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kimïtwecha ECHOTYON Tororötïncha nko papotïnecha ompö koro Misri, kengetunenö koro mötwornön akwigh kiporut cho echön cho kikïsïwecha. Kïripotecha nyinte ompö wölini kikïpesteghecha löwïr nko ompö kwenu pich löwïr cho kikiweracha koroswekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.17",
            "verseOrgIds": [
              "JOS.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyon ECHOTYON ompö tawuncha pipö Amori cho kimöngöy koronï, kïlenyona, kïpöghisyechinecha ECHOTYON, ompöwölo nyinte kï Tororötïncha.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.18",
            "verseOrgIds": [
              "JOS.24.18"
            ]
          }
        }
      ]
    },
