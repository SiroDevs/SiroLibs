          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö chane, “Kïchicha söwiko ngalechï.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.22",
            "verseOrgIds": [
              "JOS.24.22"
            ]
          }
        }
      ]
    },
    {
