        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.20",
            "verseOrgIds": [
              "JOS.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
