                  "text": "Yos 19:49-50",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtïpchï chane nyinte korenyi ompö Timnat Sera nyo mi Epraim koro kamas, okumpö löt ompö kutïng pö Kaas.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        }
