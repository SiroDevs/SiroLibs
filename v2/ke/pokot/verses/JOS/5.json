              "JOS.5.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.1+EXO.12.2+EXO.12.3+EXO.12.4+EXO.12.5+EXO.12.6+EXO.12.7+EXO.12.8+EXO.12.9+EXO.12.10+EXO.12.11+EXO.12.12+EXO.12.13"
              },
              "items": [
                {
                  "text": "Wuw 12:1-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyini kitek pipö Israel möngotinekwa Kilkal, kwigh Pasaka* nangat ompö asisto taman nko angwan nyo pö arawa, ompö mpöghoghöyi Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.10",
            "verseOrgIds": [
              "JOS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwam pagha korononi nko makatin cho puryö mumar nko pagh cho kakïkel asis nyo kirïpöy Pasaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.11",
            "verseOrgIds": [
              "JOS.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.35"
              },
              "items": [
                {
                  "text": "Wuw 16:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kuwonyö omisyö nyo kïkuro mana asisoni, otini kyam pagha koronini amelö kitökïnyorï pipö Israel mana ngat, wölo kyam akwa cho pö koro Kanan könyinoni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.12",
            "verseOrgIds": [
              "JOS.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yoswö nko chi pö chok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.12",
            "verseOrgIds": [
              "JOS.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kirich Yoswö Yeriko, kïtopöntö akïsïwa chi nyo kighyongö tawunyi nyo kitïng chok. Kïwö Yoswö otini mi nyinte akïlenchï, “Ichinyi nyincha nya anta ichï punyontencha?” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.13",
            "verseOrgIds": [
              "JOS.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö chichay, “Ewo, kangwïnan ye alïkwï wowïn pö lïkö ECHOTYON.” Kupïtyï nyu Yoswö ngwïny akïsagh, akïlenchï, “Mwochini ne ye echotyon mötworintenyu?”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.14",
            "verseOrgIds": [
              "JOS.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.14",
            "verseOrgIds": [
              "JOS.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï wowïnay pö lïko ECHOTYON Yoswö, “Ngwïsa kweghköku ompöwölo tïlil atoni ighyongonenyi.” Kwigh Yoswö lenyini.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.15",
            "verseOrgIds": [
              "JOS.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rulöto Yeriko",
          "type": "text"
        }
      ]
    }
