      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikikïyosit nyu Yoswö nyoman. Kïlenyona, kïlenchï ECHOTYON nyinte, “Kiyositunyi nyoman akwanyï tökïngötunote korö nyo wow nyo tökechengöy. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.1",
            "verseOrgIds": [
              "JOS.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achï koros cho tökïlyöghöy: koroswo pipö Pilisti löwïr nko cho pö Kesyur ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.2",
            "verseOrgIds": [
              "JOS.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kingata lalwa Syior okumpö kongasispa koro Misri nko okumpö löt ntökwit rotyo Ekron, tökuyitote lö koro Kanan. Mi pöytoghï cho le mut cho pö pipö Pilisti, cho pö kanasyanta Kasa nko Asdod nko Askelon nko Kat nko Ekron nko cho pö Apim, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.3",
            "verseOrgIds": [
              "JOS.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "okumpö tagh nko koro Kanan löwïr nko Meara nyo pö Sidon nko Apek ntökwit rotyo koro pipö Amori ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.4",
            "verseOrgIds": [
              "JOS.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko koro Kepal nko koro Lepanon löwïr okumpö kongasis, kïngata Paal Kad kutïng pö Ermon ta ntökwit ara Amat ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.5",
            "verseOrgIds": [
              "JOS.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.33.54"
              },
              "items": [
                {
                  "text": "Kiy 33:54",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko pipö kamas löwïr kïngata Lepanon ntökwit Misrepot Maim ata pipö Sidon löwïr. Oyonan ante ompö tawu pipö Israel, chöghchinönyi kore pipö Israel kïcheng kïlïkwï nyingwa lenyini komwowunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.6",
            "verseOrgIds": [
              "JOS.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chöghchinönyi nyu koronï ortïn mut nko angwan nko kareranpa ara Manase atökïcheng.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.7",
            "verseOrgIds": [
              "JOS.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chaghata kor ompö Yordan okumpö kongasis",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
