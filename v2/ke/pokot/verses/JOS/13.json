              "JOS.13.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.33"
              },
              "items": [
                {
                  "text": "Kiy 32:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.12"
              },
              "items": [
                {
                  "text": "Krt 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikikïcheng kareranpa ara Rupen nko Manase nko ara Kad koroswechï kitö Musa mötworinto ECHOTYON chane, ompö Yordan antakwagh okumpö kongasis: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.8",
            "verseOrgIds": [
              "JOS.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngata Aroer nyo mi sörömu mpöghoghyo Arnon nko kanasyantanay mi kwenu mpöghoghyononi nko tömko Medepa kïmïkul ntökwit Dipon ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.9",
            "verseOrgIds": [
              "JOS.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko kanastin löwïr cho pö Sion pöytoghinto pipö Amori nyo kipöytoy ompö Espon ntökwit rotyo pipö Amon, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.10",
            "verseOrgIds": [
              "JOS.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Kiliad nko koro Kesyur nko Maaka nko kutïng pö Ermon löwïr nko Pasyan löwïr nko Saleka ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.11",
            "verseOrgIds": [
              "JOS.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko paytaghpa Ok kïmïkul nyo kimi Pasyan nyo kipayta Astarot* nko Edrey (nyinte onkït nyo kile ngötunöno Repaim). Pïchoni cho kirïnta Musa akïyon. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.12",
            "verseOrgIds": [
              "JOS.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amelö kiyon pipö Israel Kesyur anta Maaka wölo kimang chane kwenu pipö Israel nko ye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.13",
            "verseOrgIds": [
              "JOS.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
