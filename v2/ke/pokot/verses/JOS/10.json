              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïrïnta Yoswö pipö koros löwïr cho mi wölo le kamas nko wölo le to nko nariytin nko pöytoghikwa löwïr, möminye nyo kingötï, wölo kïgh anka tïkwïl nyo satate lenyini kimwa ECHOTYON Tororöt pö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.40",
            "verseOrgIds": [
              "JOS.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrïnta Yoswö chane kïngata Kades Parnea ntökwit Kasa nko koro Kosyen löwïr ntökurel Kipyon. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.41",
            "verseOrgIds": [
              "JOS.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnam Yoswö ompö osiswechoni pöytoghichoni löwïr nko koroswekwa, ompöwölo kiporyechï ECHOTYON Tororöt pö pipö Israel chane. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
            "verseOrgIds": [
              "JOS.10.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïmïla Yoswö nko pipö Israel löwïr kutang Kilkal möngengwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.43",
            "verseOrgIds": [
              "JOS.10.43"
            ]
          }
        }
      ]
    },
