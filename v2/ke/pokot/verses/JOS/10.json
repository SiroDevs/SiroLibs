              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnam Yoswö Makeda asisoni akïpar pöytoghintenyi, kïpar chi anka tïkwïl nyo kimi ori, melö mi chi nyo kingötï. Kighchï nyinte pöytoghinto Makeda le wölo kida pöytoghinto Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.28",
            "verseOrgIds": [
              "JOS.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
