          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiweghö rotyengwa Elep akïngata ket nyo wow nyo mi Saananim akïlït Adaminekep nko Yapneel ntökwitïta Lakum akuwonyechï Yordan. ",
          "type": "text",
