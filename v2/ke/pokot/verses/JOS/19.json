          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanastin cho kikïtekyï nayat kuwit kï: Sidim nko Ser nko Amat nko Rakat nko Kineret ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.35",
