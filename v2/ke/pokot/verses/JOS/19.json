              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kuwit rotye kutang ta ntökwit Asnot Tapor, akïweghö atoni ntökwit Ukok, kïnam koro Saplon ompö okumpö tagh nko koro Asyer ompö okumpö ta nko koro Yuda ompö okumpö kongasis ompö Yordan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.34",
            "verseOrgIds": [
