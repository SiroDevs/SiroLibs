      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kechöghchï ngat ara Simion koroswekwa, kïrïp kegh nko korikwa. Kimito koroswechoni kwenu koroswo pipö ara Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.1",
            "verseOrgIds": [
              "JOS.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.4.28+1CH.4.29+1CH.4.30+1CH.4.31+1CH.4.32+1CH.4.33"
              },
              "items": [
                {
                  "text": "1Ot 4:28-33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi mïlatengwa kanastinechï: Persyepa nko Syepa nko Molada ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.2",
            "verseOrgIds": [
              "JOS.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Asar Syual nko Pala nko Esem ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.3",
            "verseOrgIds": [
              "JOS.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Eltolad nko Petul nko Orma ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.4",
            "verseOrgIds": [
              "JOS.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Siklak nko Pet Markapot nko Asar Susa ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.5",
            "verseOrgIds": [
              "JOS.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Pet Lepaot nko Syaruen, kanastin taman nko sömök cho echön nko cho mïnkech. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.6",
            "verseOrgIds": [
              "JOS.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikitö tïkwïl Ain nko Enrimon nko Eter nko Asyan, kanastin angwan cho echön nko cho mïnkech. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.7",
            "verseOrgIds": [
              "JOS.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmi nko kanastin cho mïnkech löwïr cho kiwitwit kanastinechï ntökwit Paalat Peer nko Rama nyo pö Nekep.* Chete cho kile koroswo ara Simion kïrïp kegh nko korikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.8",
            "verseOrgIds": [
              "JOS.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïchöghchï ara Simion kareranpa ara Yuda, ompöwölo ki wow tya korengwa. Kïlenyona nyu kïnyorï ara Simion koroswekwa ompö koroswo ara Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.9",
            "verseOrgIds": [
              "JOS.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kor nyo kakitö Saplon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.9",
            "verseOrgIds": [
              "JOS.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kechoghchï ngat ara Saplon koroswekwa kïrïp kegh nko korikwa. Akingata sörömu koroswekwa Sarid. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.10",
            "verseOrgIds": [
              "JOS.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpusta rotyengwa ta ntökwit Mareal akïnam Dapesyet, atolapay kïlït champilwa nyo mi Yokneam okumpö kongasis. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.11",
            "verseOrgIds": [
              "JOS.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïweghö Sarid kutang okuntö anka wölnö kaparta okumpö kongasis ntökwit rotye Kislot Tapor, akïlït Daperat akutor ntökwit Yapia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.12",
            "verseOrgIds": [
              "JOS.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiwegho atoni kuwer kutang okumpö kongasis akïwö Kat Eper ntökwit Et Kasin, ntökwit Rimon, akuwit ntökwit Nea. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.13",
            "verseOrgIds": [
              "JOS.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuwit rotye okumpö löt ntökwit Anaton, akuwonyechï mpöghoghyo Iptael. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.14",
            "verseOrgIds": [
              "JOS.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmi nko Katat nko Naalal nko Syimron nko Idala nko Petleem. Kanastin taman nko odeny cho echön nko cho mïnkech. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.15",
            "verseOrgIds": [
              "JOS.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chete ki koroswo ara Saplon kïrïp kegh nko korikwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.16",
            "verseOrgIds": [
              "JOS.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kor nyo kakitö Isakar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.16",
            "verseOrgIds": [
              "JOS.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kechoghchï ngat ara Isakar koroswekwa, kïrïp kegh nko korikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.17",
            "verseOrgIds": [
              "JOS.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimito kanastinechï koroswekwa: Yesrel nko Yesulot nko Syunem ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.18",
            "verseOrgIds": [
              "JOS.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Aparaim Syion nko Anaarat ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.19",
            "verseOrgIds": [
              "JOS.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Rapit nko Kisyon nko Epes ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.20",
            "verseOrgIds": [
              "JOS.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Remet nko Enkanim nko En Ada nko Pet Pases. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.21",
            "verseOrgIds": [
              "JOS.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingata rotyengwa Tapor nko Syaasuma nko Pet Syemes, akuwonyechï Yordan. Kanastin 16 cho echön nko cho mïnkech. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.22",
            "verseOrgIds": [
              "JOS.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chete ki koroswo ara Isakar kïrïp kegh nko korikwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.23",
            "verseOrgIds": [
              "JOS.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kor nyo kakitö Asyer",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.23",
            "verseOrgIds": [
              "JOS.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kechoghchï ngat ara Asyer koroswekwa kïrïp kegh nko korikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.24",
            "verseOrgIds": [
              "JOS.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimito kanastinechï koroswekwa Elkat nko Ali nko Peten nko Aksyap. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.25",
            "verseOrgIds": [
              "JOS.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nko Alamelek nko Amad nko Misyal. Akïnam rotyengwa Karmel nko Syior Lipnat ompö okumpö ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.26",
            "verseOrgIds": [
              "JOS.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kuwit okumpö kongasis, kïwö kïlït Pet Dakon akïnam koro Saplon nko mpöghoghyo Iptael okumpö ewu löt ntökwit Pet Emek nko Neyel. Atolapay kïwö lenyoni kïrop ewu löt ntökwit Kapul ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.27",
            "verseOrgIds": [
              "JOS.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Epron nko Reop nko Amon nko Kana ntökwit Sidon. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.28",
            "verseOrgIds": [
              "JOS.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay nyu kuwit rotye ntökwit Rama akïnam kanasyan nyo pö Tiro nyo kikïtekyï nayat kuwit. Kuwit rotye ntökwit Osa akuwonyechï nanampa Kwen. Kïmi nko Maalap nko Aksip ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.29",
            "verseOrgIds": [
              "JOS.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Uma nko Apek nko Reop. Kanastin 22, cho echön nko cho mïnkech. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.30",
            "verseOrgIds": [
              "JOS.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chete ki koroswo ara Asyer kïrïp kegh nko korikwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.31",
            "verseOrgIds": [
              "JOS.19.31"
            ]
          }
