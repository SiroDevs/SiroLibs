          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.7",
            "verseOrgIds": [
              "JOS.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitö pipö Lawi ompö parata kwegh",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.8",
            "verseOrgIds": [
              "JOS.21.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:8",
              "type": "text"
            },
            {
              "text": "parata kwegh:",
              "type": "text"
            },
            {
              "text": "Rosa Yoswö 14:2.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Israel kanastinechï nko kor wölo oketïyi kyakï lenyini kimwa ECHOTYON kuwerï Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.8",
            "verseOrgIds": [
              "JOS.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.8",
            "verseOrgIds": [
              "JOS.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitötö chane kanastinechï ompö koro Yuda nko Simion ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.9",
            "verseOrgIds": [
              "JOS.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "cho kipöyit monïngo Aron nyo kaportina Koat nyo pö ara Lawi cho kinya kïnyorï kor. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.10",
            "verseOrgIds": [
              "JOS.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketö chane Kiryatarpa, nyoni kï Epron ompö komos pö koro Yuda kïmi nko wölo oketïyi kyakï. Arpa nyo le papoto Anak. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.11",
            "verseOrgIds": [
              "JOS.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ketö Kalep wero Yepune paren cho lekïto kanasyan nko kestoni kïlïkwï chechi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.12",
            "verseOrgIds": [
              "JOS.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.12",
            "verseOrgIds": [
              "JOS.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketö monïngo tïsin Aron: Epron (kanasyan nyo kïryöghchini) nko Lipna ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.13",
            "verseOrgIds": [
              "JOS.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Yatir nko Estemoa ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.14",
            "verseOrgIds": [
              "JOS.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Olon nko Depir ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.15",
            "verseOrgIds": [
              "JOS.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Ayin nko Yuta nko Pet Syemes kïmi nko wölo oketïyi kyakï. Kanastin mut nko angwan, ompö ortïnechï le odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.16",
            "verseOrgIds": [
              "JOS.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay ketö ompö koro Penchamen: Kipyon nko Kepa ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.17",
            "verseOrgIds": [
              "JOS.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Anatot nko Almon kïmi nko wölo oketïyi kyakï. Kanastin angwan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.18",
            "verseOrgIds": [
              "JOS.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanastina monïngo tïsin Aron kï ki taman nko sömök kïmi nko wölo oketïyi kyakï.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.19",
            "verseOrgIds": [
              "JOS.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.19",
            "verseOrgIds": [
              "JOS.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kechöghchï kaportina Koat nyo pö ara Lawi kareranpa koro ara Epraim. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.20",
            "verseOrgIds": [
              "JOS.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikitö chane Syekem (kanasyan nyo ryoghchini pich cho köpörisyö ompö lelyot) ompö kamaspa Epraim nko Keser ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.21",
            "verseOrgIds": [
              "JOS.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Kipsaim nko Pet Oron kïmi nko wölo oketïyi kyakï. Kanastin angwan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.22",
            "verseOrgIds": [
              "JOS.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketötö ompö ara Dan: Elteke nko Kipeton ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.23",
            "verseOrgIds": [
              "JOS.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Ayalon nko Katrimon kïmi nko wölo oketïyi kyakï. Kanastin angwan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.24",
            "verseOrgIds": [
              "JOS.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketötö ompö kareranpa ara Manase: Tanak nko Katrimon kïmi nko wölo oketïyi kyakï. Kanastin odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.25",
            "verseOrgIds": [
              "JOS.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanastina kaportina Koat kï ki taman kïmi nko wölo oketïyi kyakï.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.26",
            "verseOrgIds": [
              "JOS.21.26"
            ]
          }
        }
      ]
    },
