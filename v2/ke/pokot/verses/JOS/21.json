        },
        {
          "text": "Kitö nyu ECHOTYON Israel kor nyo kiwolwolchï papotïnekwa, akï otini kicheng koronay, kïmöngisyö. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
