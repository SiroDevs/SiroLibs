      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpka poyi kori pipö Lawi wölo mi Eleasar tïsin nko Yoswö wero Nun nko kintöghoghi kori ortïna pipö Israel, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.1",
            "verseOrgIds": [
              "JOS.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.35.1+NUM.35.2+NUM.35.3+NUM.35.4+NUM.35.5+NUM.35.6+NUM.35.7+NUM.35.8"
              },
              "items": [
                {
                  "text": "Kiy 35:1-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïlenchï chane ompö Syilo koro Kanan, “Kimwa ECHOTYON kuwerï Musa lö, kïkonecha kanastin kemanga nko wölo oketïyi kyakicha.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.2",
            "verseOrgIds": [
              "JOS.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona nyu kutö pipö Israel kanastin pipö Lawi nko kor wölo oketïyi kyakï lenyini kimwa ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.3",
            "verseOrgIds": [
              "JOS.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.3",
            "verseOrgIds": [
              "JOS.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenya kechöghchï kanestinekwa kori kaporpa Koat. Kïnyorï monïngo tïsin Aron kanastin taman nko sömök ompö koro Yuda nko Simion nko Penchamen. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.4",
            "verseOrgIds": [
              "JOS.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnyorï pipö Koat cho kingötï kanastin taman ompö koro Epraim nko Dan nko kareranpa Manase.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.5",
            "verseOrgIds": [
              "JOS.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.5",
            "verseOrgIds": [
              "JOS.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnyorï kaporpa Kersyon kanastin taman nko sömök ompö koro Isakar nko Asyer nko Naptali nko kareranpa Manase ompö Pasyan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.6",
            "verseOrgIds": [
              "JOS.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
