  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "1SA 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi Samwel kïpöghisyechini ECHOTYON akuntöghoghchini Eli. Kingörï ngala ECHOTYON osiswechoni, kimömicha sïwïyaghtina cho chang.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi Eli kïrïwöy konyi nangat akikïrich kïkar. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.2",
            "verseOrgIds": [
              "1SA.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmi Samwel kïrïwöy Kö pö ECHOTYON, ato kimi Santuku Muma* akitomönye kemis kitömöwon. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur ECHOTYON Samwel lö, “Samwel! Samwel!” Kïngitön lö, “Yoy!” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.4",
            "verseOrgIds": [
              "1SA.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akurïp wölo mi Eli, akïlenchï, “Anyï ani, ilentenyi ne?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.5",
            "verseOrgIds": [
              "1SA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Eli, “Mokurinyinye wïyönyi rïwö.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.5",
            "verseOrgIds": [
              "1SA.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur ECHOTYON ngat Samwel, kïnget Samwel akïwö wölo mi Eli, akïlenchï, “Anyï ani, ilentenyi ne?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Eli, “Mokurinyinye werïnyu, wïyönyi rïwö ngat.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitomönye kunkïtï Samwel ECHOTYON, ompöwölo kitomönye kungwïnchï ECHOTYON nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.7",
            "verseOrgIds": [
              "1SA.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur ECHOTYON Samwel ngat nyo pö sömök, kïnget akïwö wölo mi Eli, akïlenchï, “Anyï ani, ilentenyi ne?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
            "verseOrgIds": [
              "1SA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpköchï Eli lö kichï ECHOTYON nyini kökuröy Samwel. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
            "verseOrgIds": [
              "1SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Eli Samwel, “Wïyö rïwö, ato kurïnyi, ilenchï, ‘Ngalana ECHOTYON, ompöwölo lïmöy mötworintengu.’ ” Kïwö Samwel kïrï.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.9",
            "verseOrgIds": [
              "1SA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.9",
            "verseOrgIds": [
              "1SA.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïn ECHOTYON, akïkursyö lenyaye pö tagh, “Samwel! Samwel!” Kïlö Samwel, “Ngalana ompöwölo lïmöy mötworintengu.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.10",
            "verseOrgIds": [
              "1SA.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Samwel, “Omökan agh kïgh ompö Israel, nyo otyot chi anka tïkwïl nyo lïmöy. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.11",
            "verseOrgIds": [
              "1SA.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opuntenan asisoni osïltenan kinyarat nyo kyamwaghan ompö paraku Eli nko katanyi kïngata towunöt ntökwit söröm. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.12",
            "verseOrgIds": [
              "1SA.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyomwochan Eli lö otöninan sitöt konyi kokay, ompö ghöyityö nyo kighwanïn werkachi aki nkït nyinte, wölo mömwochïnye nyinte chane kïpïstö. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.13",
            "verseOrgIds": [
              "1SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owolwolan ye lö, memukonye ghöyityo kö pö Eli ntöketïlilö amöros anta kitötogh kokay.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.14",
            "verseOrgIds": [
              "1SA.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.14",
            "verseOrgIds": [
              "1SA.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrï Samwel kïyech, atolapay kïyat kukoti Kö pö ECHOTYON. Akuway kïmwochï Eli sïwïyaghnay. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.15",
            "verseOrgIds": [
              "1SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur Eli Samwel akïlenchï, “Werïnyu!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.16",
            "verseOrgIds": [
              "1SA.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Samwel, “Anyï ani.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.16",
            "verseOrgIds": [
              "1SA.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.16",
            "verseOrgIds": [
              "1SA.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Eli nyinte, “Komwowunyi ne ECHOTYON? Mewïngenanïn. Nya kïtïghinyi ECHOTYON, ato iwïngenaninyi kïgh anka tïkwïl nyo kömwowunyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.17",
            "verseOrgIds": [
              "1SA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï Samwel nyinte kïgh anka tïkwïl amöminye nyo kiwïnga nyinte. Kïlö Eli, “Nyinte kï ECHOTYON, nya kwigh kïgh nyo sïwïyi lö karam.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.18",
            "verseOrgIds": [
              "1SA.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.18",
            "verseOrgIds": [
              "1SA.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyetï Samwel akimi ECHOTYON nko nyinte amöminye ngölyon nyo kimwa nyo kiwö ngwïny. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.19",
            "verseOrgIds": [
              "1SA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunkïtï pipö Israel löwïr kïngata Dan nyo mi okumpö löt ntökwit Persyepa nyo mi okumpö tagh lö, Samwel kï werkoyonto ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.20",
            "verseOrgIds": [
              "1SA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtas tagh ECHOTYON kuporï kegh ompö Syilo, wölay kingwïnichineghö Samwel akïngalan tïkwïl. Nyini kingalan Samwel kïter pipö Israel löwïr.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.21",
            "verseOrgIds": [
              "1SA.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakïnam Santuku Muma*",
          "type": "text"
        }
      ]
    }
  ],
