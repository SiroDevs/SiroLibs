  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "1SA 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutuyechï Pilisti lïkoskökwa Apek, kïmang pipö Israel kö pö pögh nyo mi mpöghoghyo Yesrel. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.1",
            "verseOrgIds": [
              "1SA.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwer pöytoghi pipö Pilisti cho le mut nko söpïchis cho le 100 nko söpïchis cho le 1,000, kïrïp Daudi lötï nko pikachi nko Akis. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.2",
            "verseOrgIds": [
              "1SA.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep yetïntino lïkos pö pipö Pilisti lö, “Ighöy ne pïchï pö Eprania yi nya?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Akis chane, “Daudi nyete, mötworinto Saulö, pöytoghinto Israel, akyomitan nko nyinte könyiswechaye löwïr amöminye ghöyityö nyo kyosöchan nyinte kïngata otini kimi nko ani.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnörekyï yetïntinechay Akis akïlenchï, “Nya kïmïla chichï kanasyantanini kitönönyi nyinte, möwetönye poryot nko acha, ompöwölo muköy kïwaghaka akïporyeghenecha ompö wölini. Muköy lö ne chichï ntökïchomnyö nko echotyontenyi kïpoto ato parecha? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.4",
            "verseOrgIds": [
              "1SA.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.7"
              },
              "items": [
                {
                  "text": "1Sam 18:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.21.11"
              },
              "items": [
                {
                  "text": "21:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nyete, nyay kitumchini korï akughönchini kegh lö,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur Akis Daudi akïlenchï, “Owolwolan ompö kaynata ECHOTYON lö, kitöpenyi nko ani nyo karam, achöman kepa nko nyi poryonï, ompöwölo möminye ghöyityö nyo kyosöchinyi kïngata otini kingwïnanyi wölo omitan, wölo melö chömöy pöytoghichï walaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.6",
            "verseOrgIds": [
              "1SA.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona mïlena ye nyu ompö kalya atömönörekyö pöytoghichï pö pipö Pilisti.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.7",
            "verseOrgIds": [
              "1SA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.7",
            "verseOrgIds": [
              "1SA.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi Akis, “Kaghan ne ye nyo gha? Ne nyo kesöchaninyi kïngata atanye kyotorön opöghisyewunyi nko ye, nyo mömïchininye owan oporyeghö pung pö echotyontenyan pöytoghin?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.8",
            "verseOrgIds": [
              "1SA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.8",
            "verseOrgIds": [
              "1SA.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Akis Daudi, “Onkïtön lö metïngetenyinye kigheghchin ompö ani nyonikïny, ilatenyi malaykayanta Tororöt wölo kïrkegh kïlata nyoni, kïkimwa yetïntino lïkos pö pipö Pilisti nyo mötïny lö, ‘Mewetenyinye nko acha poryot.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.9",
            "verseOrgIds": [
              "1SA.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona inget asïyech tökwoghö aiwö nko mötwori echotyontengu Saulö cho kapka nko nyi.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.10",
            "verseOrgIds": [
              "1SA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.10",
            "verseOrgIds": [
              "1SA.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnget Daudi tökwoghö kïmïla koro pipö Pilisti, wölo kïpa pipö Pilisti kutang Yesrel.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.11",
            "verseOrgIds": [
              "1SA.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Köporyö Daudi nko pipö Amalek",
          "type": "text"
        }
      ]
    }
  ],
