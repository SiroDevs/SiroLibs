          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Samwel kutang Rama, kïwö Saulö kutang katanyi Kipea. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.34",
            "verseOrgIds": [
              "1SA.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makïsïwanye Samwel Saulö ngat ntökïrapas. Kïlangany Samwel ompö Saulö, ompöwölo kilö ECHOTYON, opï atanye okïlöy Saulö kïlïkwï pöytoghinto pipö Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.35",
            "verseOrgIds": [
              "1SA.15.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakïkïl Daudi kïlïkwï pöytoghin",
          "type": "text"
        }
      ]
    }
