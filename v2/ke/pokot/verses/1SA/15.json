              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.25",
            "verseOrgIds": [
              "1SA.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Samwel Saulö, “Mowetanye nko nyi, ompöwölo ketaghanyi kirurut pö ECHOTYON, kataghinyi ye nyu nyinte lïkuna pöytoghinto Israel.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        }
      ]
