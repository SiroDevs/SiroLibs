        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.31",
            "verseOrgIds": [
              "1SA.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Samwel, “Amïtuna yi Akak pöytoghinto Amalek.” Kungwïn Akak wölo mi Samwel akïngörökonu,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.32",
            "verseOrgIds": [
              "1SA.15.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:32",
              "type": "text"
            },
            {
              "text": "akïngörökonu:",
              "type": "text"
            },
            {
              "text": "Anta akïpotönonu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akïlö, “Wechï kachïwïtan ngwonïn pö meghat.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.32",
            "verseOrgIds": [
              "1SA.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlö Samwel, “Ompöwölo kigh chokengu kor kïchop monïng kïlïku nyoni tïkwïl ompö yongu.” Atolapay kïtörotör Samwel Akak ompö tawu ECHOTYON ompö Kilkal.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        }
      ]
    },
