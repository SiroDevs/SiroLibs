  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "1SA 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï Saulö werïnyi Yonatan nko mötworichi lö apara Daudi. Wölo kicham Yonatan Daudi nyoman. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.1",
            "verseOrgIds": [
              "1SA.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yonatan Daudi, “Möchöy paponyan kïpörinyi, kïlenyona irip kegh asïyech tökwoghö, iwö itöpö wölo wïngate. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.2",
            "verseOrgIds": [
              "1SA.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owetan otöpo nko paponyan wölnö le paren iwïnchinenyi kegh. Omwochinan paponyan parakungu, ato mi ngölyon ongwïnan omwowunyi.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.3",
            "verseOrgIds": [
              "1SA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.3",
            "verseOrgIds": [
              "1SA.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngalana Yonatan nyo karam Daudi akïlenchï Saulö, “Meghchï nyo gha mötworintengu Daudi, ompöwölo möminye kïgh nyo gha nyo kegh. Kilïkwï kingörokut ompö nyi kïgh anka tïkwïl nyo kigh nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.4",
            "verseOrgIds": [
              "1SA.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitö nyinte söpontanyi ket, akïwö kïpar Kolyat, kutö ECHOTYON Israel rïntagh nyo wow. Kisïwenyi, aingörekyinyi. Kwompö ne nyu temökenyi pöre Daudi aighchï ngokï kisön cho mötïngnye lelut?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.5",
            "verseOrgIds": [
              "1SA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.5",
            "verseOrgIds": [
              "1SA.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïter Saulö ngala Yonatan, akuwalwal ompö kaynata ECHOTYON lö, “Mökïpörönye chi Daudi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.6",
            "verseOrgIds": [
              "1SA.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur Yonatan Daudi akïmwochï ngalechay löwïr. Kumïtï Yonatan Daudi wölo mi Saulö, kïpöghisyechï Daudi Saulö le nyaye kö pö su.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.7",
            "verseOrgIds": [
              "1SA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.7",
            "verseOrgIds": [
              "1SA.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimito poryot ngat, kïwö Daudi kïporyö nko Pilisti akïpar chane cho chang, kïryagh pipö Pilisti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.8",
            "verseOrgIds": [
              "1SA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.8",
            "verseOrgIds": [
              "1SA.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïnchï mïkulögh nyo gha Saulö nyo kiyono ECHOTYON, ato kitöpo konyi akitïng ngot, kïmi Daudi kïpïtöy pïkan. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.9",
            "verseOrgIds": [
              "1SA.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtora ngat Saulö Daudi, wölo kïghöpön Daudi, kïtor ngatay nayat. Kuperta Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.10",
            "verseOrgIds": [
              "1SA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.10",
            "verseOrgIds": [
              "1SA.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.11",
            "verseOrgIds": [
              "1SA.19.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.59"
              },
              "items": [
                {
                  "text": "Tum 59",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta aghononi Saulö pich kïpa kïrip Daudi ompö katanyi atökïpar nyinte tökwoghö. Wölo kïlenchï Mikal Daudi, “Atomenateghenyinye kisönköku aghonete, kepörinyi asïyech.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.11",
            "verseOrgIds": [
              "1SA.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kureyteghö Mikal Daudi ompö tïrisya, kïchïwït nyu Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.12",
            "verseOrgIds": [
              "1SA.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcheng Mikal körkeyïn, akutö pöröy akïmaman sampu puto ngaror akutö möt akuyen sïro. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.13",
            "verseOrgIds": [
              "1SA.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiyonta pich Saulö kïpa kïnömï Daudi, kïlenchï korkenyi, “Chirate nyinte.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.14",
            "verseOrgIds": [
              "1SA.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta pich Saulö kïpa kurosï Daudi akïlenchï, “Ape osïtunö nko pöröye atö aparan.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.15",
            "verseOrgIds": [
              "1SA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kit pïchay köyay, kimito körkeyïnay pöröy akimi sampunay pö puto ngaror mötïnyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.16",
            "verseOrgIds": [
              "1SA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Saulö Mikal lö, “Ompö ne telïsaninyi aipïstö punyontenyan kïchïwït?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.17",
            "verseOrgIds": [
              "1SA.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Mikal, “Kilenchanïn, ‘Ato mengarakanïnyinye achïwïtan, opörinyi.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.17",
            "verseOrgIds": [
              "1SA.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.17",
            "verseOrgIds": [
              "1SA.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuperta Daudi akïwö kutang Rama wölo mi Samwel, akïmwochï Samwel ngal löwïr cho kighchï Saulö nyinte. Kïwö nyinte nko Samwel akumpur Nayot. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.18",
            "verseOrgIds": [
              "1SA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kemwochï Saulö lö, “Mi Daudi Nayot ompö Rama.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.19",
            "verseOrgIds": [
              "1SA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta Saulö pich kïpa kïnömï Daudi, nyini kisïwa pïchay söpïch pö werkoy cho kinyolöy akïngorsïyi, aki Samwel nyo kile kintöghoghintengwa, kungwïnchï chane mïkulöwu Tororöt, kutor chane tïkwïl kïnyal akïngorsïyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.20",
            "verseOrgIds": [
              "1SA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kikïmwochï Saulö, kïyonta pikö walaka, kïnyal chane tïkwïl akïngorsïyi. Kïyonta Saulö pikö walaka panto sömök, kwigh lenyaye tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.21",
            "verseOrgIds": [
              "1SA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö nyu nyinte kutang Rama ntökwit kö pö pögh nyo wow nyo mi Seku, kïtep lö, “Mi onö Samwel nko Daudi?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.22",
            "verseOrgIds": [
              "1SA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kelenchï, “Mi chane Nayot ompö Rama.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.22",
            "verseOrgIds": [
              "1SA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.22",
            "verseOrgIds": [
              "1SA.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïweghö atoni ntökwit Nayot nyo mi Rama, kungwïnchï nyinte tïkwïl mïkulöwu Tororöt, kutor kïnyal akïngorsyö ntökwit Nayot ompö Rama. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.23",
            "verseOrgIds": [
              "1SA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
