          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kicheng Pilisti Santuku Muma, kïsït kïngeta Epeneser ntökwit kanasyanta Asdod ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.1",
            "verseOrgIds": [
              "1SA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akutö koto tororötïngwa Dakon kïtöpö kamasu körkeyïnoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.2",
            "verseOrgIds": [
              "1SA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnget pipö Asdod tökwoghö asis nyo kirïpöy akïlö kiros kikïtïnchï Dakon Santuku Muma ECHOTYON, kïcheng Dakon akutö atay kömito. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.3",
            "verseOrgIds": [
              "1SA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo nyini kinget asisto odeny ngat, kïlö kiros kichïnta Dakon kïköpïghtö mu ompö tawu Santuku Muma ECHOTYON akïmïtïkö möt nko ewunechi kïchïnchï ket pö kukat, kïngötï portö onkït kïchïrmet. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.4",
            "verseOrgIds": [
              "1SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyay mötïkönye tïsi Dakon ket pö kuka Dakon ompö Asdod anta chi anka tïkwïl nyo lïtöy kö pö Dakon nko nyete le ye.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyawesit ECHOTYON ompö pipö Asdod akutö sitöt Asdod nko seremwokachi akutö tösus.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.6",
            "verseOrgIds": [
              "1SA.5.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:6",
              "type": "text"
            },
            {
              "text": "tösus:",
              "type": "text"
            },
            {
              "text": "Kitas kikirut walaka cho pö köny lö, “Kipokyï mïra kor.” Rosa 6:4-5.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.6",
            "verseOrgIds": [
              "1SA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kisïwa pipö Asdod kïgh nyo kigha, kïlö, “Mökïmïchininye kïtöpö nko acha Santuku Muma Tororöt pö Israel, ompöwölo kikwawesit nyinte ompö acha nko Dakon tororötïncha.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.7",
            "verseOrgIds": [
              "1SA.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïkur pipö Asdod pöytoghi pipö Pilisti löwïr akïlenchï, “Kido ne Santuku Muma Tororöt pö Israel?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.8",
            "verseOrgIds": [
              "1SA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö chane, “Nya kesït kutang kanasyanta Kat.” Kesït nyu santukunay pö Muma kutang Kat. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.8",
            "verseOrgIds": [
              "1SA.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kitïta Kat, kwawesit ECHOTYON ompö pipö kanasyantanoni, akïwira chane mïghö nyo wow, akuchopa tösus pïchoni cho mïnkech nko cho echön. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.9",
            "verseOrgIds": [
              "1SA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïsït Santuku Muma kanasyanta Ekron. Nyini kit Santuku Muma Tororöt Ekron, kïriryö pipö Ekron lö, “Kepï Santuku Tororöt pö Israel wölï kïmicha atökïparecha lömïs.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.10",
            "verseOrgIds": [
              "1SA.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur pipö Ekron pöytoghi Pilisti, akïlenchï, “Ayodena Santuku Muma Tororöt pö Israel apa otö otini kömitö, atömöparecha lömïs.” Kimitö mïghö kanasyante kïmïkul, ompöwölo kichop ECHOTYON chane. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.11",
            "verseOrgIds": [
              "1SA.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pich cho kimakïparcha, kï kyam tösuswö, kit nyu rirata pipö kanasyantanoni yïm.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.12",
            "verseOrgIds": [
              "1SA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakiyoda Santuku Muma*",
          "type": "text"
        }
      ]
    }
  ],
