{
  "id": "1SA.8",
  "number": "8",
  "bookId": "1SA",
  "reference": "1 Samwel 8",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "1SA 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiyosit Samwel, kutö werkachi kurwokï Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.1",
            "verseOrgIds": [
              "1SA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayneto poretye kï Yoel, nyo pö odeny kï Apiya. Kirwoköy chane ompö kanasyanta Persyepa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.2",
            "verseOrgIds": [
              "1SA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimarïpcha werkachi körkeyïntanyi, wölo kipïrchï ropïyen akïcheng asoya amökurwokcha ompö man.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.3",
            "verseOrgIds": [
              "1SA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.3",
            "verseOrgIds": [
              "1SA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnyoryö poyi pipö Israel löwïr akïpa Rama wölo kimi Samwel, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.4",
            "verseOrgIds": [
              "1SA.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.14"
              },
              "items": [
                {
                  "text": "Krt 17:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïlenchï, “Kiyositunyi, akwanyï mörïpöcha werköku körkeyïntöngu. Kïmökecha pöytoghin le puntonichï walaka.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.5",
            "verseOrgIds": [
              "1SA.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kingarak Samwel ompö somötengwa nyo pö pöytoghin, kïlenyona kïsagh nyinte ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.6",
            "verseOrgIds": [
              "1SA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Samwel, “Tera ngal löwïr cho mwowunyi chane, ompöwölo melö kataghinyi chane, wölo kataghanïn alïkwan pöytoghintengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.7",
            "verseOrgIds": [
              "1SA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kewunyi ngal cho kighwanïn kïngata otini kyamïtunan chane koro Misri nko nyete le ye, kitaghanïn akïpöghisyechï tororötin walaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.8",
            "verseOrgIds": [
              "1SA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona terchinö chane aichil chane tya aiporchï chane otöp nyo pö pöytoghin nyo pöytoy chane.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.9",
            "verseOrgIds": [
              "1SA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.9",
            "verseOrgIds": [
              "1SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï Samwel pïchay kimököy pöytoghin kïgh anka tïkwïl nyo kimwochï ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.10",
            "verseOrgIds": [
              "1SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö, “Anyï wölo idonokwa pöytoghintenkwa, nömöy monekwa cho le werkö kwip nkarinechi. Kïlïkwï walaka cho pö angoletin, atökuntöghoghchï nkaritinechi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.11",
            "verseOrgIds": [
              "1SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlöy walaka kïlïkwï yetïntino pich 1,000 nko yetïntino pich tömönut mut nko walaka cho ngorsïyi nko cho le ilï nko cho tongöy kari poryot nko kari nkarinechi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.12",
            "verseOrgIds": [
              "1SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chengöy tipikwa kwigh mwowöy cho ngutoy cho onyïn akïlïkwï chïlï akwigh makatin. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.13",
            "verseOrgIds": [
              "1SA.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chengöy parenikwa cho karamach nko pareni sapipun nko cho pö arol akutö. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.14",
            "verseOrgIds": [
              "1SA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chengöy kareranpa taman ompö paghekwa nko sapipune akutö kirwokotichi nko yetïntinechi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.15",
            "verseOrgIds": [
              "1SA.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chengöy mötworikwa cho le kor nko mïrön nko chumwak nko sïkïröyikwa akutö kwigh ighisyenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.16",
            "verseOrgIds": [
              "1SA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chengöy kareranpa taman nyo pö kyakikwa alïkukwa nyu sekeyichi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.17",
            "verseOrgIds": [
              "1SA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olokyokwa asisoni akwompö pöytoghintenkwa nyo kyokïlchikwa kegh akwane, wölo möterwokwanye ECHOTYON.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.18",
            "verseOrgIds": [
              "1SA.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.18",
            "verseOrgIds": [
              "1SA.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïtagh pïchay kïterchï Samwel, akïlö, “Ewo! Kïmökecha pöytoghin, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.19",
            "verseOrgIds": [
              "1SA.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "atökekaracha kegh nko puntonichï walaka, atökïpaytecha akuntöghoghwecha ompö poryot.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.20",
            "verseOrgIds": [
              "1SA.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiter Samwel ngala pïchoni löwïr, kïwö kïmwochï ECHOTYON lenyaye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.21",
            "verseOrgIds": [
              "1SA.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Samwel, “Terchinö chane ngalekwa aikïlchï pöytoghin.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.22",
            "verseOrgIds": [
              "1SA.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Samwel pipö Israel, “Wïyö chi anka tïkwïl katangu.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.22",
            "verseOrgIds": [
              "1SA.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Könyoryö Saulö nko Samwel",
          "type": "text"
        }
      ]
    }
  ],
