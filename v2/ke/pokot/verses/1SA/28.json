  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "1SA 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh kegh pipö Pilisti osiswechoni atökïporyö nko pipö Israel. Kïlenchï Akis Daudi, “Nkïtunö ye nyu lö iwetenyi poryot nko ani nko piköku.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.1",
            "verseOrgIds": [
              "1SA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.1",
            "verseOrgIds": [
              "1SA.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi Akis, “Nkïtunö lö ongörokinyi.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Akis nyinte, “Karam nyoman, oghinyi ye nyu lïkune ripintenyan kokay.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kangalan Saulö nko chepsoköyon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.3",
            "verseOrgIds": [
              "1SA.28.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.27"
              },
              "items": [
                {
                  "text": "Law 20:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.10+DEU.18.11"
              },
              "items": [
                {
                  "text": "Krt 18:10-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.1"
              },
              "items": [
                {
                  "text": "1Sam 25:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kökikïma Samwel akïriryö pipö Israel ompö nyinte akïtïpchï kanasyantenyi Rama. Kökiyon Saulö chepsoköytin nko ponï ompö koro Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.3",
            "verseOrgIds": [
              "1SA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.3",
            "verseOrgIds": [
              "1SA.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïghamït kegh pipö Pilisti akïpka kïmang kanasyanta Syunem, kighamït Saulö pipö Israel akïmang kutïng pö Kilpoa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.4",
            "verseOrgIds": [
              "1SA.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kisïwa Saulö lïko pipö Pilisti, kïmïgh akïpotan tya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.5",
            "verseOrgIds": [
              "1SA.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.21"
              },
              "items": [
                {
                  "text": "Kiy 27:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Saulö ECHOTYON kïgh nyo mïchini kwigh, wölo möwöghökyïnye ECHOTYON kïgh nyinte ompö kirwotïtogh anta ompö Urim nko Tumim* anta ompö werkoy. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.6",
            "verseOrgIds": [
              "1SA.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Saulö mötworichi, “Oporwante wölo mi chepsoköyon, atö owan atepa nyinte kïgh nyo mïchini aghan.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï chane nyinte, “Mi akonga Endor.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwaghach kegh Saulö kïsisit akulak sïrö walaka akïwö oghö nko pikachi odeny wölo mi kokonay akïlenchï, “Tepunenante oy aikurwanïn chi nyo omwowunyi.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.8",
            "verseOrgIds": [
              "1SA.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.8",
            "verseOrgIds": [
              "1SA.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï kokonay nyinte, “Inkïtönyi nyoman kïgh nyo kigh Saulö, ompöwölo kiyon nyinte pich cho kile chesoköytin nko ponï ompö koronete. Ompö ne nyu tetönenyi söpontönyan ngöghöp, atökeparanïn?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.9",
            "verseOrgIds": [
              "1SA.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.9",
            "verseOrgIds": [
              "1SA.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kuwolwolchï Saulö kokonay ompö kaynata ECHOTYON lö, “Möminye sitöt nyo nyorunyi ompö ngalechï.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.10",
            "verseOrgIds": [
              "1SA.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.10",
            "verseOrgIds": [
              "1SA.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö kokonay, “Imökenyi okurwan ngo?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.11",
            "verseOrgIds": [
              "1SA.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Saulö, “Kurwante Samwel.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.11",
            "verseOrgIds": [
              "1SA.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.11",
            "verseOrgIds": [
              "1SA.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kisïwa kokonay Samwel, kïrir tya akïlenchï Saulö, “Ompö ne telïsaninyi? Akwanyï kichö ichinyi Saulö.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.12",
            "verseOrgIds": [
              "1SA.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.12",
            "verseOrgIds": [
              "1SA.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï pöytoghintö nyinte, “Mewöghisyö, kesïwïyenyi ngo nya?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.13",
            "verseOrgIds": [
              "1SA.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï kokonay Saulö, “Osïwïyan kïtontöwo chi nyo pusuno ngwïny.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.13",
            "verseOrgIds": [
              "1SA.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.13",
            "verseOrgIds": [
              "1SA.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep nyinte lö, “Lata ngo nyinte atokirosöy?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.14",
            "verseOrgIds": [
              "1SA.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö kokonay, “Poyon nyo pusu akikïnanagha sïra.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.14",
            "verseOrgIds": [
              "1SA.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunkïtï Saulö lö ki Samwel nyoni, kïkïtïng ompö konyït.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.14",
            "verseOrgIds": [
              "1SA.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
