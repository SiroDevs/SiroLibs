              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuteghyö pïchay löwïr lö, “Isöp kokay, we pöytoghin?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.24",
            "verseOrgIds": [
              "1SA.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
