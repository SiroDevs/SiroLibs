          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï Samwel pich man nko ighisyo pöytoghin akukirchï kitapï akutö wölay tïlil. Atolapay kïmwochï Samwel pich kïpa kestonikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.25",
            "verseOrgIds": [
              "1SA.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Saulö kutang katanyi Kipea nko pipö lïk cho kökikutö Tororöt nyakanat. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.26",
            "verseOrgIds": [
              "1SA.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlö pich walaka cho ghach, “Muköy lö ne chichï ntökïsörwecha?” Kïsas chane nyinte, akïtagh kwipchï konut. Wölo kisï Saulö.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.27",
            "verseOrgIds": [
              "1SA.10.27"
            ]
          }
        }
      ]
