          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.1",
            "verseOrgIds": [
              "1SA.26.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.54"
              },
              "items": [
                {
                  "text": "Tum 54",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa pipö Sip wölo mi Saulö ompö Kipea akïlenchï, “Mi Daudi kïwïngchini kegh kutïng pö Akila nyo mi Yesimon okumpö kongasis.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.1",
            "verseOrgIds": [
              "1SA.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Saulö kutang surkwen pö Sip nko nyökon 3,000 kïyar Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.2",
            "verseOrgIds": [
              "1SA.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmang Saulö kutïng pö Akila nyo mi kamasu or ompö Yesimon okumpö kongasis. Wölo kïtöpö Daudi wölnö le surkwen. Nyini kinkïtï lö mi Saulö kïyörotoy Daudi, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.3",
            "verseOrgIds": [
              "1SA.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïyonta ghotï kïpa kurosï Saulö, kïsöwï lö nyoman kikungwïn. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.4",
            "verseOrgIds": [
              "1SA.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Daudi ntökwit wölini kimöngöy Saulö, akïsïwa wölo kirïwöy Saulö nko Apner wero Ner kintöghoghinto pikachi pö lïk. Kimi Saulö kïrïwöy kwen kïruyö pikachi kuwit nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.5",
            "verseOrgIds": [
              "1SA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.5",
            "verseOrgIds": [
              "1SA.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Daudi Aimelek chi pö Ititi nko Yoap werto ompö Apisyay wero Seruya lö, “Ngo nyo wetöy wölo mi Saulö nko ani?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.6",
            "verseOrgIds": [
              "1SA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Apisyay, “Owetan nko nyi.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.6",
            "verseOrgIds": [
              "1SA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.6",
            "verseOrgIds": [
              "1SA.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Apisyay nko Daudi möngo Saulö aghononi, akïnyorï nyinte mi kïrïwöy kwenu möngot akipörtochï ngotïnyi ngwïny atolekïtö mötïnyi, kïrï Apner nko pipö lïk kuwit nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.7",
            "verseOrgIds": [
              "1SA.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Apisyay Daudi, “Ketö Tororöt aghonete punyontengu moriku, nya atoran nyinte ngotïnyi kïwudochï ngwïny, amelenchï kegh otoran kïnyïl odeny!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.8",
            "verseOrgIds": [
              "1SA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.8",
            "verseOrgIds": [
              "1SA.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlenchï Daudi Apisyay, “Mepar, ompöwölo nyoru chi sitöt nyo pöröy chi nyo le kïlana ECHOTYON.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.9",
            "verseOrgIds": [
              "1SA.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïlö ngat Daudi, “Owolwolan ompö kaynata ECHOTYON lö, pöröy ECHOTYON nyinte anta itïta asistanyi nyo meghöy anta kïpara poryot. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.10",
            "verseOrgIds": [
              "1SA.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.24.6"
              },
              "items": [
                {
                  "text": "1Sam 24:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö chömöy ECHOTYON aparan chi nyo le kïlanenyi, wölo chenga ngatït nyo lekïto mötïnyi nko söteto pögh akepa.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.11",
            "verseOrgIds": [
              "1SA.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcheng Daudi ngatay nko söteto pögh cho kilekïtö möt pö Saulö akïpa. Möminye chi nyo kisïwa anta söwï anta nget, kimi chane rïwön, ompöwölo kitö ECHOTYON rïwön nyo nïkis.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.12",
            "verseOrgIds": [
              "1SA.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.12",
            "verseOrgIds": [
              "1SA.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Daudi ato le antakwagh, akughyongö kutïng parak ato low ompö chane, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.13",
            "verseOrgIds": [
              "1SA.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïkur lïkonay pö Saulö nko Apner wero Ner, akïlenchï, “Mengitönwanïnyinye so Apner?” Kïlö Apner, “Ngo nyï ngetöy pöytoghin nya?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.14",
            "verseOrgIds": [
              "1SA.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.14",
            "verseOrgIds": [
              "1SA.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi Apner, “Olentan kechinyi chi nyo le nyakan ompö Israel nya? Kwompö ne nyu tömeripönyi echotyontengu pöytoghin? Ompöwölo kengwïn chi kïlïtï möngot atökïpar nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.15",
            "verseOrgIds": [
              "1SA.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö karam kïyï keghanyi. Owolwolan ompö kaynata ECHOTYON lö mïchini meghanyi, ompöwölo merïpönyinye echotyontengu, nyo le kïlana ECHOTYON. Mi onö ye ngotpa pöytoghin nko sötenyi pö pögh, chay kömi ato lekïto mötïnyi.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.16",
            "verseOrgIds": [
              "1SA.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.16",
            "verseOrgIds": [
              "1SA.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsöwï Saulö kuti Daudi, kïlö, “Nyi nyoni nya werïnyu Daudi?” Kïlö Daudi, “Ani nyete echotyontenyu pöytoghin.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.17",
            "verseOrgIds": [
              "1SA.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïlö ngat, “Ompö ne terïpsetenenyi mötworintengu? Kaghan ne nyo gha nya? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.18",
            "verseOrgIds": [
              "1SA.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tere ye nyu pöytoghin ngal cho mwoghöy mötworintengu. Ato ECHOTYON nyo keghinyi ighwanïn le nyï, otöninan ropöwo kalya, kïnyïl ato pich, kïchïpote chane ompö ECHOTYON, ompöwölo kayonenanïn chane koro ECHOTYON tömonyorwan mïlat akïlenchanïn, ‘Wïyö pöghisyechinö tororötin walaka.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.19",
            "verseOrgIds": [
              "1SA.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, mecham omeghchan kor nyo low ompö ECHOTYON, ompöwölo kengwïn pöytoghinto Israel kïyar kïmïtyan, le chi nyo sökosöy törit ompö kutïngkot.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.20",
            "verseOrgIds": [
              "1SA.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.20",
            "verseOrgIds": [
              "1SA.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Saulö, “Kaghan nyo gha, mïlenanyi werïnyu Daudi, mowunyinye kïgh nyo gha, ompöwölo kesïwenyi lö, pö tösunöt söpontönyan asisete. Kalïkwan sölwö, kalelan tya.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.21",
            "verseOrgIds": [
              "1SA.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.21",
            "verseOrgIds": [
              "1SA.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi, “Anyï ngotïngu we pöytoghin! Nya kungwïn chi kïcheng. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.22",
            "verseOrgIds": [
              "1SA.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Töni ECHOTYON chi anka tïkwïl ropöwontenyi ompö mantanyi nko kighanatenyi, ompöwölo ketöninyi ECHOTYON oghonete morichan, wölo melö kaparinyi nyo le kïlana ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.23",
            "verseOrgIds": [
              "1SA.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïle ato pö tösunöt söpontöngu ompö ani, nya kïpöyit tösunöt söpontönyan ompö ECHOTYON akïsörwanïn nyinte ompö kömpölelut löwïr.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
            "verseOrgIds": [
              "1SA.26.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
            "verseOrgIds": [
              "1SA.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Saulö Daudi, “Nya kusoyönïn ECHOTYON werïnyu! Ighenyi tïkwïn cho chang akïpïntoy.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Daudi arenyi, kïmïla Saulö katanyi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi ompö kwenu pipö Pilisti",
          "type": "text"
        }
      ]
