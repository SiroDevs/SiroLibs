      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mïrön cho kimi Kö pö kirwoko Nepukadnesa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
