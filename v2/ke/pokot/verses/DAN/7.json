              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.5"
              },
              "items": [
                {
                  "text": "Ngo 22:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " wölo nyoru pipö Tororöt nyo Töror Tya pöyunöte kïlïkwï nyingwa kokay nko kokay.’",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.18",
            "verseOrgIds": [
              "DAN.7.18"
            ]
          }
        }
