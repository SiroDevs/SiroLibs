              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Kumpur kokwö akutor kurwokyï nyinte, kesara nyinte paytaghtanyi akenyar kokay. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.26",
