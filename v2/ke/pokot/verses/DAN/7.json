                {
                  "text": "Ngo 11:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ketö nyinte paytagh nko ororyo nko pöyunöt, atökïpöghisyechï pich nko punton nko kutïw löwïr nyinte. Melö weröy paytaghtanyi nyonikïny, amelö wonyot pöyunötenyi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.14",
            "verseOrgIds": [
              "DAN.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakïngongwï ngala sïwïyaghtin",
          "type": "text"
        }
      ]
    },
