                  "text": "13:5-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Töghöy chane Tororöt nyo Töror, akïpïr pipö Tororöt nyo Töror Tya. Akumukyï kïwaghach kirurutkökwa nko osiswo ichontinekwa. Ketö pipö Tororöt morichi könyis sömök nko nïsï.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.25",
            "verseOrgIds": [
              "DAN.7.25"
            ]
          }
        }
      ]
    },
