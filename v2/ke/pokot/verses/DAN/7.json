              "items": [
                {
                  "text": "Ngo 20:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kungwïn nyinte nyo kisöpöy kïngata könyisyok kurwokyï pipö Tororöt nyo Töror Tya. Kwitïta asis ato kinyoru pipö Tororöt pöyunöt.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.22",
            "verseOrgIds": [
              "DAN.7.22"
            ]
          }
        }
      ]
