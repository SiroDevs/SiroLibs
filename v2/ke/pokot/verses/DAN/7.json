              "items": [
                {
                  "text": "14:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Asïwan ompö sïwïyaghpa oghö, kungwïn ompö polta akong nyo lata ptangengmöt akïwö wölo mi nyinte nyo kisöpöy kïngata könyisyok kïtöpö tawunyi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.13",
            "verseOrgIds": [
              "DAN.7.13"
            ]
          }
        }
      ]
    },
