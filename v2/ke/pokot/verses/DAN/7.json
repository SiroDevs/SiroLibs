          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo kyamachan onkïtï tya paraku tyonto angwan nyo kisis ompö chinö walaka löwïr akïgha nyoman, kyotyegho nyoman, kitïng kela karïn nko sighoy pö taghoy. Kïpulpul akïrïngarïng pungkachi akïtyakatyak chinö kingötï. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.19",
            "verseOrgIds": [
              "DAN.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akyamachan onkïtï tïkwïl kuyechay le taman kimi mötïnyi nko kuyöghonay kichumï akwigh chay le sömök kïchïntoy. Kitïng konyïn nko kut nyo kingölonöy ngala menotön, ki wow nyoni kïtïl chay walaka löwïr.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.20",
            "verseOrgIds": [
              "DAN.7.20"
            ]
          }
        }
      ]
    },
