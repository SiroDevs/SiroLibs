          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.14"
              },
              "items": [
                {
                  "text": "Ngo 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.4"
              },
              "items": [
                {
                  "text": "20:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Otini kitorosan,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.9",
            "verseOrgIds": [
              "DAN.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.10",
            "verseOrgIds": [
              "DAN.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Otini kitomitan orosöy alïman ngala menotön cho kingölonöy kuyöghonay. Otini kitorosan asïwan kepar tyonyay pö angwan akenyar portanyi atolapay ketötö kepel. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.11",
            "verseOrgIds": [
              "DAN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo tyonköchay walaka kechenga pöyunötinekwa akïpïstö chane kïsöpchö nyo tangogh.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.12",
            "verseOrgIds": [
              "DAN.7.12"
            ]
          }
        }
      ]
    },
