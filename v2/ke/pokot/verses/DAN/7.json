          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Choni kï sörömu ngalechoni. Wölo otyan, amïghön nyoman, arorchan ngalechoni löwïr mïkulöwunyu.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.28",
            "verseOrgIds": [
              "DAN.7.28"
            ]
          }
        }
