                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Otini kitorosan, kïporyeghö kuyöghonay pipö Tororöt akïrïnta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.21",
