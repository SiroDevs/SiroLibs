            "number": "23",
            "style": "v",
            "sid": "DAN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïlenchanïn chichay, ‘Tyontö nyo pö angwan kï pöyunöt nyo pö angwan ompö ngwïny, sisitu nyoni ompö pöyunötin löwïr. Ryöpöy ngwïny kïmïkul, akïtyakatyak akïrïngarïng kïlïkwï mïnchïran. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.23",
            "verseOrgIds": [
              "DAN.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.12"
              },
              "items": [
                {
                  "text": "Ngo 17:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kuyechay le taman kï pöytoghï taman cho ngetöy kïpöytoy pöyunötononi. Wölo chumu anka nyo sis ompö chay löwïr pö tagh akuchunta nyu pöytoghï sömök. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.24",
            "verseOrgIds": [
              "DAN.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
