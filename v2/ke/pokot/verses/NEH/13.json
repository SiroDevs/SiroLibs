              "NEH.13.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.19"
              },
              "items": [
                {
                  "text": "Krt 12:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osöwan ngat lö melö kitöketö pipö Lawi nko tumï cho kipöghisïyi karerantangwa, kïlenyona kïpa nyu chane kutang parenikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.10",
            "verseOrgIds": [
              "NEH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achilan yetïntin lö, “Ompö ne tökepïstö Kö pö Tororöt le nyï?” Aghamïtan chane atolapay oyokyan chi anka tïkwïl ighisyenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.11",
            "verseOrgIds": [
              "NEH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.10"
              },
              "items": [
                {
                  "text": "Mal 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay nyu kwipï pipö Yuda löwïr kareranpa taman nyo pö pagh nko dipay nko mwagh, ketö töpoton cho mi Kö pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.12",
            "verseOrgIds": [
              "NEH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïlan Syelemia tïsin nko Sadok nyo le kikirin nko Pedaya nyo pö Lawi kughyongchï töpotonichay, akïlan Anan wero Sakur wero Mataniya kungarak chane, ompöwölo ki pich cho ghönote chane. Ki pöghisyengwa kïchöghchï werkökwa pasanichay.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.13",
            "verseOrgIds": [
              "NEH.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.13",
            "verseOrgIds": [
              "NEH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inanante, we Tororötïnyu, amewutyeghö ighisyewutköchan löwïr cho karamach cho kyaghan ompö kongu nko sowutkö.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.14",
            "verseOrgIds": [
              "NEH.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.14",
            "verseOrgIds": [
              "NEH.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 13:15"
          },
          "items": [
