            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyasïwan ompö osiswechoni tïkwïl pipö Yaudi cho kip kor cho pö Asdod nko Amon nko Moap. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.23",
