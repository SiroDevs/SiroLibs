          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay omwochan pipö Lawi kutïlil kegh akïpka kïrip ortïn atö kïtïlilit asispa Sapato.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.22",
