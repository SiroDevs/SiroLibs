        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.9",
            "verseOrgIds": [
              "NEH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
