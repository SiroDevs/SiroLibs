              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona otïlilön chane ompö kïgh anka tïkwïl nyo kipö sany. Atolapay atatan ighisyewut pö tïsï nko cho pö pipö Lawi chi anka tïkwïl nko ighisyenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
              "NEH.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
