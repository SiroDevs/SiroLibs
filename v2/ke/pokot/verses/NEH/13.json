              "NEH.13.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.3+DEU.23.4+DEU.23.5"
              },
              "items": [
                {
                  "text": "Krt 23:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikisomön asisoni kirurut pö Musa kïlïm pich. Kenyorï wölo kikikir lö, mölïtönye chi pö Amon anta nyo pö Moap tuyo pipö Tororöt kokay, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.1",
            "verseOrgIds": [
              "NEH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.1+NUM.22.2+NUM.22.3+NUM.22.4+NUM.22.5+NUM.22.6"
              },
              "items": [
                {
                  "text": "Kiy 22:1-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ompöwölo kimelö kitaroka chane pipö Israel omisyö nko pögh. Kikur chane Palaam kungwïn kïchïp, wölo kiwaghach Tororötïncha chïpononi kïlïkwï kisoyönöt. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.2",
            "verseOrgIds": [
              "NEH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona otini kilïm pipö Israel kirurut kesomönöy, kupesyö kegh nko pich löwïr cho pö punton.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Keyokwï ngat Neemia saghata man",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng kongot Elyasyip tïsin nyo kighyongchini korïn cho mi Kö pö Tororöt* nyinte nko Topiya kïtomö kwitï ngalechï. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.4",
            "verseOrgIds": [
              "NEH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichomchï nyinte Topiya kïmang kö pö ori nyo wow, wölo kikïrorchini ropöw nko tïkwïn cho ngutoy cho onyïn nko karïn cho kïpöghisyegho ompö Kö pö Tororöt nko kareranpa taman nyo pö pagh nko dipay* nko mwagh cho kikïkonï ketö pipö Lawi nko tumï nko ripi Kö pö Tororöt lenyini mwoghöy kirurut. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.5",
            "verseOrgIds": [
              "NEH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimomitanye Yerusalem osiswechoni kighisyot ngalechï. Kyowan wölo mi Artakerkes pöytoghinto Papilon ompö könyi 32 nyo pö paytaghtanyi. Ato mi löt kïchömwanïn pöytoghintö ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.6",
            "verseOrgIds": [
              "NEH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "amïlan Yerusalem. Otomwan kigh Elyasyip ngokï otini kichömchï Topiya kïmang kö nyo mi Kö pö Tororöt ori. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.7",
            "verseOrgIds": [
              "NEH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anarekan tya alösyan kari Topiya löwïr sany. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.8",
            "verseOrgIds": [
              "NEH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay amwatïtan ketïlil korichay awan oyokwï ngat kari Kö pö Tororöt nko ropöwo pagh nko tïkuchay ngutoy cho onyïn.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.9",
            "verseOrgIds": [
              "NEH.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 13:9"
          },
          "items": [
            {
