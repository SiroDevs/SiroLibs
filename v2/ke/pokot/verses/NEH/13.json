              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inanante ompö choni, we Tororötïnyu, aikamanante ompö chomnyengu nyo pö kokay",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.22",
