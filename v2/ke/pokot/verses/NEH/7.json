              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monïngo tïsï cho melö kirumï arengwa kï: Opaya nko Akos nko Parsilay (nyo kip korkenyi ompö tipi Parsilay nyo pö Kiliad, akekurteghö kaynatengwa.) ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.63",
            "verseOrgIds": [
              "NEH.7.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "NEH 7:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimelö kikïcham chane kïlïkwa tïsï ompöwölo melö kirumï arengwa ompö kitapun. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.64",
            "verseOrgIds": [
