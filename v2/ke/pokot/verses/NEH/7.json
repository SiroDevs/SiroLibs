          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.5",
            "verseOrgIds": [
              "NEH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achï pïchay kipkana koro Papilon cho kirang Nepukadnesa pöytoghinto Papilon le ratan. Kimïlisyö Yerusalem nko Yuda akïwö chi tïkwïl kanasyantenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.6",
            "verseOrgIds": [
              "NEH.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kintöghoghikwa kï: Serupapel nko Yoswö nko Neemia nko Asaria nko Raamiya nko Naamani nko Mordekay nko Pilsyan nko Misperet nko Pikpay nko Neum nko Paana.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.7",
            "verseOrgIds": [
              "NEH.7.7"
            ]
          }
        }
      ]
    },
