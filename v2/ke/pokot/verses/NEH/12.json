            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kughyongö nyu söpïchtinechoni kwodeny kiyokyini Tororöt sörö ompö Kö pö Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.40",
