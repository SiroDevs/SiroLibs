                  "text": "26:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh chane ighisyewut pö Tororötïngwa nko kitïlilutkö walaka. Kwigh tïkwïl tumï nko ripi Kö pö Tororöt ighisyengwa lenyini kimwa Daudi nko werïnyi Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.45",
            "verseOrgIds": [
              "NEH.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NEH 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi kintöghoghinto tumï akimi tumwöy cho kisölöy akusoyönöy Tororöt kïngata köny ompö osiswo Daudi nko Asap. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
            "verseOrgIds": [
              "NEH.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NEH 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitötoy pipö Israel löwïr pasan ompö osis löwïr cho pö tumï nko cho pö ripi Kö pö Tororöt ompö osiswo Serupapel nko cho pö Neemia. Kikïlchï chane ropöw pipö Lawi, atolapay kukïlchï pipö Lawi pipö ara Aron.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.47",
            "verseOrgIds": [
              "NEH.12.47"
            ]
          }
        }
      ]
