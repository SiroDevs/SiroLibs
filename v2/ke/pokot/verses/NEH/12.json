          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NEH 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirïpöy chane ompö, Maaseya nko Syemaya nko Eleasar nko Usi nko Yeoanan nko Malkicha nko Elam nko Eser. Kitum tumï cho kintöghoghchini Yesraya kelïma wölo low.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.42",
            "verseOrgIds": [
              "NEH.12.42"
            ]
          }
        }
      ]
