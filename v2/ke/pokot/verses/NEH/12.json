          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikikir kaynötut pö kintöghoghi ortïna pipö Lawin nko cho pö tïsï ompö osiswo Elyasyip nko Yoyada nko Yoanan nko Yadua nyo kile tïsin ntökwit paytaghpa Daryas nyo pö Pasya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.22",
            "verseOrgIds": [
              "NEH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikikirchï kaynötut pö pipö Lawi cho kile kintöghoghi korikwa kitapu Otöptino köny ntökwit osiswo Yoanan wero Elyasyip.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.23",
            "verseOrgIds": [
              "NEH.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tötut pö ighisyewut ompö Kö pö Tororöt*",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
