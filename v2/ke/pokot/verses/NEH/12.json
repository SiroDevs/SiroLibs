          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitötö chane amörostin cho echön asisoni akïngörekyö, ompöwölo kegh Tororöt chane kïngörekyö nyoman. Kingörekyö korï tïkwïl nko monïng ntökelïma ngörekyononi kimi Yerusalem wölo low.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pasani tïsï nko pipö Lawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
