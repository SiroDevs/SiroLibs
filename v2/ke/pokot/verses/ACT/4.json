          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kuwany kïsoghöy, kïpotan atoni kinyoryeghö chane. Kenyïghit chane Mïkulögh nyo Tïlil, akïngalan ngölyonto Tororöt ompö nyakanat.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.31",
            "verseOrgIds": [
              "ACT.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ghömtoy kighönï tïkukwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
