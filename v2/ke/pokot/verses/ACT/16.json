          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.34",
            "verseOrgIds": [
              "ACT.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany kïyech kuyoktö kirwokotichay pö Rumi wowïntino askarin akïlenchï, “Opïstenö pïchono kïpechï kegh.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.35",
            "verseOrgIds": [
              "ACT.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.35",
            "verseOrgIds": [
              "ACT.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï ripintonay pö chela Paulö ngalechay lö, “Kakuyokwï kirwokotï kut kepïstinyi nko Sila. Nyo karam ape ompö kalya.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.36",
            "verseOrgIds": [
              "ACT.16.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.36",
            "verseOrgIds": [
              "ACT.16.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlenchï Paulö wowïntinechay pö askarin, “Kikïmungecha kïsïwïyi pich lapay. Aketorchecha chela, akechicha pipö Rumi. Nkanyï kïyöröy kewïchtonecha? Melö lenye nyona! Nya kïpka kirwokotichoni chane yeteyi kutyakecha.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.37",
            "verseOrgIds": [
              "ACT.16.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.37",
            "verseOrgIds": [
              "ACT.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa wowïntinechay pö askarin kïmwöchï ngalechay kirwokot pö Rumi, kïkany kïlïm lö kïchï pö Rumi Paulö nko Sila, kwotyö.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.38",
            "verseOrgIds": [
              "ACT.16.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.38",
            "verseOrgIds": [
              "ACT.16.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïpa kïsaghsagh chane, atolapay kumïtuna chane chela kïpka sany akïmwochï chane kïngeta kanasyantanay. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.39",
            "verseOrgIds": [
              "ACT.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngetunö Paulö nko Sila chela akïpa kuwerata kö pö Lidia. Kuryama wöloni nko kighönï, kïcher chane ompö ngala kikilöto kegh akïpa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.40",
            "verseOrgIds": [
              "ACT.16.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Syala ompö Tesalonike",
          "type": "text"
        }
      ]
    }
