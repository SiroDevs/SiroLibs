          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.28",
            "verseOrgIds": [
              "ACT.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikurtö kepï kitömöwon, kukomchï ori akupïtyï kelyo Paulö nko Sila kïpotönöy ompö kiwaghat. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.29",
            "verseOrgIds": [
              "ACT.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kumït chane sany akïtep lö, “Echotchï oghan ne, tökesörwon?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.30",
            "verseOrgIds": [
              "ACT.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.30",
            "verseOrgIds": [
              "ACT.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï, “Ghana Echotyon Yeso atesïkö sörunötenyi nko piko katangu.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.31",
            "verseOrgIds": [
              "ACT.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwomchï nyinte nko pikö walaka cho kimi konyi ngölyonto Echotyon.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.32",
            "verseOrgIds": [
              "ACT.16.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.32",
            "verseOrgIds": [
              "ACT.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö atoni chane panini kwoghonini kïpa kot anka akïmwat moyokökwa, kïnyini lawel kepatisan nyinte nko piko katanyi kïmïkul. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.33",
            "verseOrgIds": [
              "ACT.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kumït Paulö nko Sila kïpa konyi akutö omisyö kwam. Kïngarak nyinte nko piko katanyi nyoman. Ompöwölo kakughan Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.34",
            "verseOrgIds": [
              "ACT.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
