            "verseOrgIds": [
              "ACT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kuteghchï Paulö, “Mepar kegh! Kïmitecha yete lapay.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.28",
            "verseOrgIds": [
              "ACT.16.28"
            ]
          }
        }
      ]
    },
    {
