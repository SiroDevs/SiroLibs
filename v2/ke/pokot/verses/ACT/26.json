              "type": "text"
            }
          ]
        },
        {
          "text": " lö, kichopöy kong Kristo,* atökïlïkwï nyo tagh nyo tutuno pich cho kimeghö, atökïmwochï pipö Yaudi nko pipö punton lö, kimuköy kesöru chane, köröy kegh nyoni nko löpoyïn ompö chane.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.23",
            "verseOrgIds": [
              "ACT.26.23"
            ]
          }
        }
      ]
