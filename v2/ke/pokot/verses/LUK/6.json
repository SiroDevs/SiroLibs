              "LUK.6.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.14"
              },
              "items": [
                {
                  "text": "1Pt 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ochikwa soyönote chona reyok pich, akeyonchok sany, kechïpok akemïnak akenyarenak kaynötut lö ochï pich cho ghach akwompö paraku Wero Chi! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.22",
            "verseOrgIds": [
              "LUK.6.22"
            ]
          }
        },
