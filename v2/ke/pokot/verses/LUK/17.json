              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïle wölo kilata ngala ompö osiswo Noa, kïlïku choni tïkwïl ompö osiswo Wero Chi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.26",
