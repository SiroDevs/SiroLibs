              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi tïkwïl korï odeny cho ngoghöy pagh akonga, kimïtoy anka kepïstö anka.” [ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.35",
