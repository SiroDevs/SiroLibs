            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kyomisïyi pich akïgheghsyö, kensïyi chane akuyiltoy monekwa, ntökwïtïta asisini kilït Noa meli. Atoni nyu ato kitï museryonta nyo kïtïgh chane lömïs. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.27",
            "verseOrgIds": [
