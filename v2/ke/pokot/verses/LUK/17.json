          },
          "items": [
            {
              "text": "Tow 18:20–19:25.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kilata nyoni tïkwïl ompö osiswo Lot. Kimi pich kwomisïyi akïgheghsïyi akyolsïyi akwoltoy tïkwïn akikötkötisïyi akïteksïyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.28",
            "verseOrgIds": [
              "LUK.17.28"
            ]
          }
        },
        {
          "name": "verse",
