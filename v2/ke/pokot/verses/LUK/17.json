          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lata nyoni wölo lïku asisoni chumu Wero Chi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.30",
            "verseOrgIds": [
              "LUK.17.30"
