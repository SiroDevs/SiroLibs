                  "text": "Mat 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kikany kuwany chane ngal tïkwïl cho kiyomisöy Kirurut pö Echotyon, kïmïlonchö Kalilaya ntökwitï kanasyantengwa kegh nyo pö Nasaret. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyetï monïngay akïnar, kingöghom nyoman akimi kisoyönöto Tororöt parakunyi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mi weray le Yeso Kö pö Tororöt",
          "type": "text"
        }
      ]
    },
