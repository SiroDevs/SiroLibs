          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichikyï osiswechoni Kaisari Aukusto lö, kïmököy kekiröy kaynötut pö pich ompö kor kïmïkul atökeyit. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.1",
            "verseOrgIds": [
              "LUK.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipö kiyitötononi tagh kekir atoni kipöytoy Kurenio koro Sirya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.2",
            "verseOrgIds": [
              "LUK.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa pich tïkwïl atökekir chi anka tïkwïl ompö kanasyantenyi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.3",
            "verseOrgIds": [
              "LUK.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.3",
            "verseOrgIds": [
              "LUK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngeta Yosep kanasyanta Nasaret nyo mi Kalilaya akïwö kutang Yudea ntökwit kanasyan nyo kikuro Petleem, wölo kikïyichï pöytoghin Daudi. Kiwö Yosep wöloni ompöwölo kipö nyinte ara Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.4",
            "verseOrgIds": [
              "LUK.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwö wöloni atökukir kegh nko Marya, nyo kökikulotokïn akimirsïyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.5",
            "verseOrgIds": [
              "LUK.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwotini kitökïmi Petleem, kwitïta osiswechi cho pö lusyogh. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.6",
            "verseOrgIds": [
              "LUK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyï poretyenyi nyo le weri, kuyenö sïra monïng akumïkonchï atekerya kyak, ompöwölo kimöminye pöroyïn kö pö to nyo kitempuröy chane.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.7",
            "verseOrgIds": [
              "LUK.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mösöw nko malayken",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.7",
            "verseOrgIds": [
              "LUK.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimito mösöwö osiswechoni korononi cho kiripöy kyakikwa oghö. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.8",
            "verseOrgIds": [
              "LUK.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchumchï chane malaykayanta Echotyon kulïwchï ororyo Echotyon kuwit chane, kuwöghisyö nyoman, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.9",
            "verseOrgIds": [
              "LUK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wölo kïlenchï malaykayantanay, “Mowöghisyö! Ompöwölo opkokwa Lökoy cho Karamach cho ipchini pich lapay ngörekyö nyo wow. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.10",
            "verseOrgIds": [
              "LUK.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikeyï asisete ompö kanasyanta Daudi Ghetin ompö akwa nyo le Kristo* akï Echotyon. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.11",
            "verseOrgIds": [
              "LUK.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwanyï kiporunöte ompö akwa, onyorunekwa mnyarkil nyo kikiyenö sïro pö monïng akemïkonchï atekerya kyak.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.12",
            "verseOrgIds": [
              "LUK.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.12",
            "verseOrgIds": [
              "LUK.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnyini lawel kuchumï söpïch nyo wow nyo pö malaykeni yïm, akuryam nko malaykayantanay akïtum tumwöy cho sölo Tororöt lö,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.13",
            "verseOrgIds": [
              "LUK.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.14",
            "verseOrgIds": [
              "LUK.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kipechï kegh malaykenichay kïmïlonchö yïm, kïmwochï mösöwechay lö, “Kepe Petleem atökesïwena kïyï kegha kömwowecha Echotyon.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.15",
            "verseOrgIds": [
              "LUK.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.15",
            "verseOrgIds": [
              "LUK.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïryagh akïnyorï Marya nko Yosep akïsïwa mnyarkil nyo rïwöy ateker. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.16",
            "verseOrgIds": [
              "LUK.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwotini kisïwa mösöwechay monïngay, kïmwochï chane ngal cho kömwochï chane malayken ompö monïngoni. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.17",
            "verseOrgIds": [
              "LUK.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtangany pich nyoman cho kilïm ngalechoni kimwoghöy mösöwö. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.18",
            "verseOrgIds": [
              "LUK.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïkomönchï Marya mïkulöwunyi ngalechoni löwïr akunan lasiny. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.19",
            "verseOrgIds": [
              "LUK.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmïlonchö mösöwechay, akï tumöy sölut pö Tororöt ompö ngal löwïr cho kilïm akïsïwa, ompöwölo kighisyö nyo mötïny le wölini kimwochï malayken chane.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.20",
            "verseOrgIds": [
              "LUK.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakïmïnchï Yeso kaynat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
