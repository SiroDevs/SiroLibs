              "attrs": {
                "loc": "LEV.12.3"
              },
              "items": [
                {
                  "text": "Law 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.31"
              },
              "items": [
                {
                  "text": "Luk 1:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otini kit osis mut nko sömök, kwit ato kïmutöy montö, kekurö nyinte Yeso, kaynat nyo kitö malaykayan nyinte otini kitomönye kesïch.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
            "verseOrgIds": [
              "LUK.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakitötö Yeso ompö Kö pö Tororöt*",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
