          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kilïm pung pö pipö Yuda nko cho pö Penchamen lö kitek tïkay kipkana pïnotön Kö pö ECHOTYON Tororöt pö Israel, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.1",
            "verseOrgIds": [
              "EZR.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.24+2KI.17.25+2KI.17.26+2KI.17.27+2KI.17.28+2KI.17.29+2KI.17.30+2KI.17.31+2KI.17.32+2KI.17.33+2KI.17.34+2KI.17.35+2KI.17.36+2KI.17.37+2KI.17.38+2KI.17.39+2KI.17.40+2KI.17.41"
              },
              "items": [
                {
                  "text": "2Pöy 17:24-41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïpa kïnyorï Serupapel nko poyi ortïn akïlenchï, “Akanya keteksyenöcha nko akwa ompöwölo kïsoghecha Tororötïnkwa lenyini osoghekwa akikitönöcha amörostin nyinte kïngata osiswo Esaradon pöytoghinto Asirya nyo kimïtwecha wölete.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.2",
            "verseOrgIds": [
              "EZR.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.2",
            "verseOrgIds": [
              "EZR.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlenchï Serupapel nko Yoswö nko poyi ortïn chane, “Melö kïtïngecha kïgh akwa ompö teksyo Kö pö Tororötïncha,* kïtekyinecha achane ECHOTYON Tororötïncha lenyini kamwa Sayras pöytoghinto Pasya.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.3",
            "verseOrgIds": [
              "EZR.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.3",
            "verseOrgIds": [
              "EZR.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwigh piko korononi pipö Yuda kïmeghö mutïnö akuwöghisyö kïteksyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.4",
            "verseOrgIds": [
              "EZR.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïwïkyï soch kusus chane. Kigh lenyoni kïnomnyö ompö osiswo Sayras pöytoghinto Pasya ntökutomï paytaghpa Daryas.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kitagh pikö walaka tekata Yerusalem ngat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
