                  "text": "1Ot 25:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kitek tekï kitoröto Kö pö Tororöt kïpa tagh tïsï cho kilach sïrokökwa nko kontin nko pipö Lawi nko werpö Asap cho kitïng karïn cho töpölöle cho pö tumöt. Kïtum akïkwol ECHOTYON lenyini kimwa Daudi pöytoghinto Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
