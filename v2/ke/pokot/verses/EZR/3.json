              "EZR.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.1"
              },
              "items": [
                {
                  "text": "Wuw 27:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kitomtö arawa mut nko odeny kökimöngisyö pipö Israel kanastinekwa. Kïghamït kegh chane löwïr akïpa Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.1",
            "verseOrgIds": [
              "EZR.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.1"
              },
              "items": [
                {
                  "text": "Wuw 27:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Yoswö wero Yosadak nko pikachi cho le tïsï nko Serupapel wero Syealtiel nko piko arengwa, akïtek ngat ato kïpelo amöros nyo pö Tororöt pö Israel, töketöteghö amörostin cho kïpelöy lenyini kikikir ompö Kirurut pö Musa, chi pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.2",
            "verseOrgIds": [
              "EZR.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitekyï ato kïpelo amöros otini ki mi nyay pö köny, kïrkegh kiwöghöy pich cho kimöngöy korononi. Kutö ECHOTYON amörostin cho kïpelöy pöghet nko nangat. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.29.12+NUM.29.13+NUM.29.14+NUM.29.15+NUM.29.16+NUM.29.17+NUM.29.18+NUM.29.19+NUM.29.20+NUM.29.21+NUM.29.22+NUM.29.23+NUM.29.24+NUM.29.25+NUM.29.26+NUM.29.27+NUM.29.28+NUM.29.29+NUM.29.30+NUM.29.31+NUM.29.32+NUM.29.33+NUM.29.34+NUM.29.35+NUM.29.36+NUM.29.37+NUM.29.38"
              },
              "items": [
                {
                  "text": "Kiy 29:12-38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwam Ichon pö Tunkun lenyini kikikir. Kitötoy osis amörostin cho kïpelöy kïrïp kegh nko amörostin cho kikïtat ompö asis anka tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.4",
            "verseOrgIds": [
              "EZR.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Kiy 28:11–29:39.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïtas amörostin cho kïpelöy nko cho pö Ichon pö Relïn pö Arawa nko ichontin walaka cho kimwa ECHOTYON nko ropöwonto chi anka tïkwïl nyo tötoy kïropchini ECHOTYON ompö chamatenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitor pich kutö ECHOTYON amörostin cho kïpelöy asisini tagh ompö arawa mut nko odeny, kïrkegh kökitomönye ketor ketek Kö pö Tororöt.*",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ketor teksyo Kö pö Tororöt ngat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö pipö Israel ropïyen teki koghïn nko cho pö ket akutö pipö Tiro nko Sidon omisyewut nko tïkwïn cho kïgheghöy nko mwaghpa orolwö tökwipï tarakit ompö Lepanon kuwerï nanam ntökwit Yopa. Kikipï nyu lenyini kichömchï Sayras pöytoghinto Pasya chane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.7",
            "verseOrgIds": [
              "EZR.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kitïta arawa odeny ompö könyito odeny kïngata kïpka chane Yerusalem, Serupapel wero Syealtiel nko Yoswö wero Yosadak nko werkökwa löwïr nko tïsï nko pipö Lawi nko chane löwïr cho kimïlisyeghö pïnotön teksyo Kö pö Tororöt. Kekïl pipö Lawi cho tïng könyis tömönut odeny kutoch tökughyongchï teksyo Kö pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.8",
            "verseOrgIds": [
              "EZR.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kighyongchï teksyo Kö pö Tororöt Yeswö nko werkachi nko tïlyayichi nko Kadmiel nko werkachi (cho pö ara Odapiya)",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.9",
            "verseOrgIds": [
              "EZR.3.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:9",
              "type": "text"
            },
            {
              "text": "Odapiya:",
              "type": "text"
            },
            {
              "text": "Rosa 2:40, ompö Eprania kï, Yuda.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nko werpö Enadad nko pipö Lawi nko werkökwa kïmi nko tïlyayikwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.9",
            "verseOrgIds": [
              "EZR.3.9"
            ]
          }
        }
      ]
    },
