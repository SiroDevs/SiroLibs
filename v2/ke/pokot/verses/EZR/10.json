          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.43",
            "verseOrgIds": [
              "EZR.10.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EZR 10:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kip pïchï löwïr tipi punton, wölo kayon ye nko monïnge.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.44",
            "verseOrgIds": [
              "EZR.10.44"
            ]
          }
        }
