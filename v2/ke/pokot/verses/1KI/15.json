          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiporyot kïtenö osis pöytoghin Asa nyo pö Yuda nko pöytoghin Paasya nyo pö Israel, otini kimi chane kïpöytoy.",
          "type": "text",
