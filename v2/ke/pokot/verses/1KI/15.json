              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirote ighisyewut löwïr cho kigh pöytoghintö Nadap kitapu Otöptino pöytoghi Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
