            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panini lawel, kewany pipö ara Yeropoam löwïr kïrïp kegh nko ngölyonto ECHOTYON nyo kimwagha kuti mötworintenyi, werkoyon Aiya nyo pö Syilo, amelö kingötï nyo le ompö akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
