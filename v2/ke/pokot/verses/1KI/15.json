          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilïkwï nyoni ompöwölo kinörekyï ECHOTYON Tororöt pö Israel Yeropoam ompö ngokichi cho kigh nko lelut cho kilelchï pipö Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        }
