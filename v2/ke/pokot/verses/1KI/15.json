          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kigh Nadap ngokï ompö tawu ECHOTYON le paponyi akwigh pipö Israel kwigh ngokï.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        }
