              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitor Nadap wero Yeropoam kïpayta Israel könyi odeny ompö paytaghpa pöytoghin Asa nyo pö Yuda. Kipayta nyinte könyis odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
