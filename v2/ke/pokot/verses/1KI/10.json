                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïrongunö angoletino Solomon Misri nko Kilikia. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyala koro Misri nkari akonga ropïyen cho ngata kilen mut nko odeny cho pö ropïyen, kikyoltegho angole akonga ropïyen cho ngata kilen odeny. Kimï nyu chane ompö aranoni kwolchï ngat pöytoghi pipö Ititi nko cho pö Sirya angoletin nko nkaritin.",
          "type": "text",
