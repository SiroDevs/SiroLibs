              "1KI.10.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.42"
              },
              "items": [
                {
                  "text": "Mat 12:42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.31"
              },
              "items": [
                {
                  "text": "Luk 11:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kilïm pöytoghintö Syepa nyo kile korka wölo kikïsalta Solomon ompö kaynata ECHOTYON, kïnap kegh akïwö kutang Yerusalem atökïtyama nyinte teput cho owesöch. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.1",
            "verseOrgIds": [
              "1KI.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirutö nyinte nko mötwor cho chang akirongöy tamasay cho kipöy tïkwïn cho ngutoy cho onyïn nko koltin nko sanay cho pö olyot nyo wow. Otini kituyö nyinte nko Solomon, kïtep kokonay teput cho chang cho teno cho kinan nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.2",
            "verseOrgIds": [
              "1KI.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwöghökwï Solomon choni löwïr. Kimöminye teputyö nyo kipöl Solomon kuyokyï nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.3",
            "verseOrgIds": [
              "1KI.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlïm pöytoghintonay pö Syepa ngal löwïr cho pö ngöghomnyö cho kimwa Solomon akïsïwa konyi nyo kitek nyo pö paytagh ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.4",
            "verseOrgIds": [
              "1KI.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïsïwa omisyö nyo kikipchini ompö mesenyi nko kata wölo kimöngöy yetïntinechi nko wölini kikïtat katanyi nyo pö paytagh kïlïkwï nko pich cho kipöghisïyi ompö köyoni nko sïro cho kiloköy pïchoni nko mötwor cho kipöghöy to ompö omisyewut pö ichontin nko amörostin cho kipelo Kö pö Tororöt. Otini kisïwa löwïr kïma mu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.5",
            "verseOrgIds": [
              "1KI.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchï pöytoghin Solomon, “Pö man ngala cho kyalïman ompö ngöghomnyengu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.6",
            "verseOrgIds": [
              "1KI.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kyaghanan ntökïtenö angwïnan ante asïwa ngöghomnyengu nko sïkönötengu kïtïl kwolöt nyo kyalïman ompö nyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.7",
            "verseOrgIds": [
              "1KI.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soyönote kïtya piköku akusoyönote mötworiku cho ghyongo tawungu kïnomnyö kïteröy ngaleku cho pö ngöghomnyö. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.8",
            "verseOrgIds": [
              "1KI.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kïkwolö Kaynata Tororötïngu! Keporï nyinte wölo chömteninyi, nka nyini keghinyi lïkuna pöytoghinto Israel. Kïlenyona irwokyï piköku ompö man.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.9",
            "verseOrgIds": [
              "1KI.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.9",
            "verseOrgIds": [
              "1KI.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïropchï kokonay le pöytoghin pö Syepa Solomon tïkwïn cho kipuno korenyi. Kingata nïkisyengwa kilen 4,000 cho pö koltin nko tïkwïn cho ngutoy cho onyïn cho chang nko sanay cho chang cho pö olyot nyo wow tya. Kitomönye kïnyorï pöytoghintö Solomon tïkwïn cho ngutoy cho onyïn cho teno choni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.10",
            "verseOrgIds": [
              "1KI.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Kïkany otini kipchini melino pöytoghin Iram koltin Solomon kïngetunö Opir, kwipunö wöloni tïkwïl mpawtin cho pö ket cho kïkuro almuk cho chang nyoman nko sanay cho pö olyot nyo wow. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.11",
            "verseOrgIds": [
              "1KI.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïpöghisyeghö Solomon mpawtinechay pö keti almuk kïteka pchörino Köyay pö Tororöt nko konyi nyo pö paytagh, akwigha otupöy nko pïkantis cho pö pich cho tumöy. Kipïchighöch nyoman mpawtinechoni pö keti almuk! Kitomönye kepchï koro Israel mpawtin cho lata choni akitomönye kesïwa ngat ye.)",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö pöytoghintö Solomon pöytoghintonay pö Syepa tïkwïn löwïr cho kimököy, kïmi nko ropöw cho kökikunan ato le tagh lö otöni nyinte. Kïmïla nyu kokonay korenyi wölini le Syepa nko pikachi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mökosyo Solomon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyorï pöytoghintö Solomon köny anka tïkwïl kilen 23,000 cho pö koltin, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.14",
            "verseOrgIds": [
              "1KI.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïmi nko surï cho kinyoruno mïnchïrïs pö pöytoghi Arapia nko cho pö pöytoghi walaka cho pö koroswo pipö Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.15",
            "verseOrgIds": [
              "1KI.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.15",
            "verseOrgIds": [
              "1KI.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwigh pöytoghintö Solomon longoy pokolay odeny akuluma longe anka tïkwïl koltin cho pö kilen cho ngata mut nko odeny ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.16",
            "verseOrgIds": [
              "1KI.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "akwigh ngat longoykö walaka 300 cho karkegh nko choni, akuluma koltin anka tïkwïl cho ngata kilen odeny akïrorchï longoychoni löwïr Köyay wow kimpuröy pö wuw pö Lepanon.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.17",
            "verseOrgIds": [
              "1KI.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.17",
            "verseOrgIds": [
              "1KI.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwigh ngat ngachar nyo wow nyo pö paytagh nyo pö kela pelöw akuluma koltin cho pïchighöch. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.18",
            "verseOrgIds": [
              "1KI.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikigh ngacharunoni kïsïch mirtin mut nko akonga cho kïlongtegho akegh parakunyi kuwit. Kikigh körkeyïn pö ngötïny kïtöpunö sörömu mirtinechoni löwïr. Kilïkwï taman nko odeny körkeyïntinechoni pö ngötuny. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.19",
            "verseOrgIds": [
              "1KI.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitöpunö körkeyïn pö kirïk pataghuto ngacharunoni pö paytagh, akïtöpö körkeyïn pö ngötïny ewunechi kwodeny. Melö mi ngacharu paytagh nyo lata nyoni nyo kikesïwechï ompö paytagh anka tïkwïl.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.20",
            "verseOrgIds": [
              "1KI.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.20",
            "verseOrgIds": [
              "1KI.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikigha koltin kikompen löwïr cho kigheghsyegho pöytoghintö Solomon nko tïkwïn löwïr cho kikïpöghisyegho ompö köyoni pö Wuw pö Lepanon. Melö kipöghisyegho silpa, ompöwölo ki kwïle chona ompö osiswo Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.21",
            "verseOrgIds": [
              "1KI.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng pöytoghintö Solomon melino Tarsis cho pö mïnchïrïsnön cho kitïng ghömïchö nko cho pö Iram. Kimïlisyegho melinechi Opir kïnyïl akonga ompö könyis sömök. Kimi kwipu koltin nko silpa kasawatin nko kela pelöw nko möyosoy.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.22",
            "verseOrgIds": [
              "1KI.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.22",
            "verseOrgIds": [
              "1KI.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïlïkwï pöytoghintö Solomon sïkön akïngöghomit kïtïl pöytoghin anka tïkwïl, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.23",
            "verseOrgIds": [
              "1KI.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "akimököy pipö ngwïny kïmïkul kïpkonöy kïlïmöy ngala ngöghomnyö nyo kitö Tororöt nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingwïn chi anka tïkwïl nko ropöwechi wölo mi nyinte. Kipï chane: kari silpa nko koltin nko sïro nko kari lïk nko tïkwïn cho lata köröstin nko angoletin nko sïkïröy.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        }
      ]
