              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur Solomon Askarin cho pegho nkaritin cho le 1,400 nko askarine walaka cho pegho angoletin cho le 12,000. Kitö kanastina nkaritin, kumpur walaka nko pöytoghin ompö Yerusalem, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.26",
            "verseOrgIds": [
              "1KI.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikarkegh kari silpa ompö osiswo Solomon nko koghïn ompö Yerusalem, akikarkegh pïrompurtino tarakit ompö chongïn nko makany pö Syepela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
              "1KI.10.27"
            ]
          }
        },
        {
