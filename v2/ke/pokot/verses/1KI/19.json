        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwomchï pöytoghintö Aap korkenyi Yesepel lökoyechay kigh Eliya löwïr nko wölo kiparta nyinte werkoyi Paal.* ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.1",
            "verseOrgIds": [
              "1KI.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta Yesepel chi wölo mi Eliya akïlenchï, “Nya kïparanïn tororötinö ato teno nyete asïyech ato tomönye awunyi lenyini kighchinyi werkoyichoni.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.2",
            "verseOrgIds": [
              "1KI.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmïgh Eliya nyoman akuperta kutang Persyepa kanasyan nyo pö Yuda atökïsörï söpontanyi. Kïpïsyï mötworintenyi kanasyantanoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.3",
            "verseOrgIds": [
              "1KI.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 19:3"
          },
          "items": [
