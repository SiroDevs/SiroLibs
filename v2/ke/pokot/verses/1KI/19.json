              "1KI.19.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.3"
              },
              "items": [
                {
                  "text": "Rum 11:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Eliya lö, “ECHOTYON Tororöt nyo pö owesyö, kasïwan nyo gha nyoman ompö pipö Israel ompöwölo kapeny chane muma* nyo nko nyi, akunyar ato kïpelo amörostineku akïpar werkoyköku löwïr. Ani ye nyu onkït nyo köngötï, akwanyï ye mi chane kïyöröy kïpöranïn tïkwïl.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.10",
            "verseOrgIds": [
              "1KI.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.10",
            "verseOrgIds": [
              "1KI.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON, “Wïyö ghyongenö tawunyan ompö kutïng parak.” Akwotini kitökughyongo Eliya atoni, kuwerï ECHOTYON ompö yomöt nyo wow nyo kikarer kutïngöy akïpasyang ghatoy, wölo melö kimi ECHOTYON yomononi. Kïsï yomonay, atolapay kutor koronay kurïngring. Wölo melö kimi ECHOTYON kirïngringötonay. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.11",
            "verseOrgIds": [
              "1KI.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kiwonyö kirïngringötonay, kwitï ma, wölo melö kimi ECHOTYON mayoni. Nyini kiwonyö ma, kungwïn kut nyo mïnïng nyo kikïlïm nyo pö chamat.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.12",
            "verseOrgIds": [
              "1KI.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.12",
            "verseOrgIds": [
              "1KI.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kilïm Eliya kutinoni, kuyenö sïrenyi tokochunyi akïngetunö köpönonay otini le kuketo köpön. Kïlïm nyinte kut nyo kitep lö, “Ighenyi ne yi nya Eliya?”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.13",
            "verseOrgIds": [
              "1KI.19.13"
            ]
          }
        }
      ]
    },
