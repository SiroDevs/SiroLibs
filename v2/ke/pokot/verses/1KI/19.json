            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.7+2KI.8.8+2KI.8.9+2KI.8.10+2KI.8.11+2KI.8.12+2KI.8.13"
              },
              "items": [
                {
                  "text": "2Pöy 8:7-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON, “Mïlena aiwö ara surkwen nyo weröy ato lekïto Damaska, atolapay ilït kanasyan aiyil Asael kïlïkwï pöytoghinto Sirya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.15",
            "verseOrgIds": [
              "1KI.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.1+2KI.9.2+2KI.9.3+2KI.9.4+2KI.9.5+2KI.9.6"
              },
              "items": [
                {
                  "text": "2Pöy 9:1-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiyil Yeu wero Nimsyi kïlïkwï pöytoghinto Israel nko Elisya wero Syapat nyo pö Apel Meola kïlïkwï werkoyon kukerinyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.16",
            "verseOrgIds": [
              "1KI.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anka tïkwïl nyo chïwïto choko Asael, kïpöröy Yeu, akwanka tïkwïl nyo chïwïto choko Yeu, kïpöröy Elisya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.17",
            "verseOrgIds": [
              "1KI.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.4"
              },
              "items": [
                {
                  "text": "Rum 11:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo opïsinan koro Israel pich 7,000 cho melö kikïtïnchï Paal anta chïchïn kutïwekwa körkeyïntanyi.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.18",
            "verseOrgIds": [
              "1KI.19.18"
            ]
          }
        }
      ]
    },
