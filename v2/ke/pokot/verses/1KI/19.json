          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Eliya lö, “ECHOTYON Tororöt nyo pö owesyö, kasïwan nyo gha nyoman ompö pipö Israel, ompöwölo kapeny chane muma* nyo kyam nko nyi, akunyar ato kïpelo amörosköku, akïpar werkoyiku löwïr. Ani ye nyu onkït nyo köngötï, akwanyï ye mi chane kïyöröy kïpöranïn tïkwïl.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.14",
            "verseOrgIds": [
              "1KI.19.14"
            ]
          }
        }
