          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpa ntökwitïta Opir akïmïloncheghö wöloni kwipu koltin cho tïlöy kilen 14,000.",
          "type": "text",
          "attrs": {
