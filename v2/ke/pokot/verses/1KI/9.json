    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiwany pöytoghintö Solomon kïtek Köyay pö Tororöt nko konyi nyo pö paytagh nko kïgh anka tïkwïl nyo kimököy kwighöy, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.1",
            "verseOrgIds": [
              "1KI.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.5"
              },
              "items": [
                {
                  "text": "1Pöy 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.7"
              },
              "items": [
                {
                  "text": "2Ot 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kungwïnchï ECHOTYON nyinte nyo pö odeny, le atanye kingwïnchï nyinte ompö Kipyon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.2",
            "verseOrgIds": [
              "1KI.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON nyinte, “Kalïman saghatengu nyo kesaghenyi tawunyan. Kotïlilön Köyï kitekanyi atökesaghenanïn kokay. Oripan Köyete kïtenö osis. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.3",
            "verseOrgIds": [
              "1KI.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo ato ipöghisyeghwaninyi ompö man nko kitenat nyo pö mïkulögh, le ato kigh papongu Daudi, airïpanyi kirurutköchan aigh kïgh anka tïkwïl nyo omwowunyi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.4",
            "verseOrgIds": [
              "1KI.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.4"
              },
              "items": [
                {
                  "text": "1Pöy 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "okomönan kiyomisötenyu nyo kyoyomisön kegh nko Daudi, papongu, otini kyomwochan nyinte lö, töpo ngacharu paytagh nyo pö Israel kokay. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.5",
            "verseOrgIds": [
              "1KI.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato itaghanyi anta moneku kirurutköchan löwïr apa asagh tororötin walaka, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.6",
            "verseOrgIds": [
              "1KI.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ochenonan nyu Israel koronini kyotönön chane. Atolapay apakadan köyete kyotïlilön kïlïkwï ato kïsoghenanïn. Kïchïpotegho nyu Israel koros löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.7",
            "verseOrgIds": [
              "1KI.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.9"
              },
              "items": [
                {
                  "text": "2Pöy 25:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.19"
              },
              "items": [
                {
                  "text": "2Ot 36:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wetöy asistanka Köyete pö Tororöt kyotörorön lasiny kïlïku kïratyan atökïtöngönchï chi anka tïkwïl nyo weröy, akïtep kegh lö, ‘Kilö ne tökwighchï ECHOTYON koronï nko Köyï le nyï?’ ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.8",
            "verseOrgIds": [
              "1KI.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoku nyu pich lö, ‘Ompöwölo kipïstö chane ECHOTYON Tororötïngwa, nyo kimïtuna papotïnekwa koro Misri, akïpechï kïsagh tororötin walaka, nka nyï kepchï ECHOTYON chane ghöyityö nyo teno nyï.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.9",
            "verseOrgIds": [
              "1KI.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kichomnyö Solomon nko Iram",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.9",
            "verseOrgIds": [
              "1KI.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtek Solomon Köyay pö Tororöt nko konyi nyo pö paytagh ompö könyis tömönut odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.10",
            "verseOrgIds": [
              "1KI.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kökikutö Iram pöytoghinto Tiro Solomon mpawtina tarakit nko saypras nko koltin löwïr cho kimököy. Nyini kiwany ighisyenyi, kutö pöytoghintö Solomon Iram kanastin tömönut odeny cho kimi okumpö Kalilaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.11",
            "verseOrgIds": [
              "1KI.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïweghö Iram Tiro kutang Kalili ntökïsïwa kanastinechoni, wölo melö kicham kanastinechoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.12",
            "verseOrgIds": [
              "1KI.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïlenchï Iram Solomon, “Nka chete so kanastinechini kekonaninyi, werïnyo?” Kïkurö kanastinechoni Kapul",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.13",
            "verseOrgIds": [
              "1KI.9.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:13",
              "type": "text"
            },
            {
              "text": "Kapul:",
              "type": "text"
            },
            {
              "text": "Ompö Eprania kïlenye ato kïlö puryö kinyiwut.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akïtökekuro nko ye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.13",
            "verseOrgIds": [
              "1KI.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwanyï kökikutö Iram Solomon koltin cho pö kilen 4,000.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.14",
            "verseOrgIds": [
              "1KI.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tïkwïn walaka cho kigh Solomon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.14",
            "verseOrgIds": [
              "1KI.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipöghisyeghö pöytoghintö Solomon charut otini kiteköy Köyay pö Tororöt nko konyi nyo pö paytagh, atökunyïghit kanasyante wölo le okumpö kongasis atökïtek nayat kuwit kanasyante. Kïpöghisyeghö charut ngat atökïtek kanastina Asor nko Mekido nko Keser. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.15",
            "verseOrgIds": [
              "1KI.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kökiporyeghö Parao ato le tagh kanasyanta Keser akïnam akïpar pikö akïpel pipö Kanan cho kimöngöy kanasyantanoni. Atolapay kïropchï cheptanyi asisini kip Solomon nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.16",
            "verseOrgIds": [
              "1KI.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtek ngat Solomon Keser nko Pet Oron wölo porö, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.17",
            "verseOrgIds": [
              "1KI.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Paalat nko Tamar nyo mi surkwen pö Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.18",
            "verseOrgIds": [
              "1KI.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki kanastinechoni cho kikïrorchï kaplawachtinechi nko nkarinechi nko pikachi pö angoletin nko kïgh anka tïkwïl nyo kimököy ompö teksyo Yerusalem ompö Lepanon nko ompö koroswe walaka tïkwïl cho kipöytoy nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.19",
            "verseOrgIds": [
              "1KI.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïpöghisyeghö Solomon ngat charut ompö pich cho kingötunö pipö Amori nko pipö Ititi nko pipö Peris nko pipö Ipiti nko pipö Yepusi. Melö ki pipö Israel chane.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.20",
            "verseOrgIds": [
              "1KI.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.20",
            "verseOrgIds": [
              "1KI.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poru lö chane kï pich cho kidong korononi, cho melö kimï pipö Israel kïpar atanya kipka chane kïcheng korononi kïlïkwï nyingwa. Kwigh Solomon chane kïlïkwï Sekey nko nyete le ye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.21",
            "verseOrgIds": [
              "1KI.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kigh Solomon pipö Israel kïlïkwï sekey. Kipöghisyö chane le askarin nko opisatin nko yetïntinechi cho pö lïkos nko cho kighyongchini pich nko cho kipegho angoletin.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.22",
            "verseOrgIds": [
              "1KI.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.22",
            "verseOrgIds": [
              "1KI.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki ngata 550 opisatina Solomon cho kighyongchini sekey cho kighöy ighisyo charut nyo pö teksyö.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.23",
            "verseOrgIds": [
              "1KI.9.23"
            ]
          }
        }
      ]
    },
    {
