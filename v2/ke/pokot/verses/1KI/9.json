              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta pöytoghintö Iram pich cho kinkït kïpegho nanam kïpa nko mötwori Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
