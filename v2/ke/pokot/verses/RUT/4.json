        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.6",
            "verseOrgIds": [
              "RUT.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
