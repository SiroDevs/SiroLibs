            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kwip Poas Rus. Kutö ECHOTYON kïsïkisyö akïyï wor. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.13",
            "verseOrgIds": [
              "RUT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï korï Naomi, “Nya kïsala ECHOTYON nyo melö köpïstinyi asisete ompöwölo kikoninyi monïng nyo ripinyi, nya kïmakosit monïngoni ompö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.14",
            "verseOrgIds": [
              "RUT.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku nyinte ompö nyi nyo yokunyi söpontöngu akïpaghïn ompö yosïntöngu, ompöwölo köyï monïngoni Rus potïchtöngu, nyo kiwunyi nyo karam tya kïtïl wor mut nko odeny.” ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.15",
            "verseOrgIds": [
              "RUT.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïsïtyï Naomi monïngay takenyi, akïnam.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.16",
            "verseOrgIds": [
              "RUT.4.16"
            ]
          }
        }
      ]
