              "items": [
                {
                  "text": "Tow 29:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kughan pïchay nko poyi lö, “Owöy, kïchicha söwi, kanya kwigh ECHOTYON kokononi ngwïnöy katangu kïtöpö le Lea nko Rael cho kitek kwodeny ka Israel. Imakositï ompö ara Eprata airumunö Petleem. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.11",
            "verseOrgIds": [
              "RUT.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.27+GEN.38.28+GEN.38.29+GEN.38.30"
              },
              "items": [
                {
                  "text": "Tow 38:27-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atökïkarkegh kongu nko kö pö Peres wero Yuda nko Tamar ompö monïng cho koninyi ECHOTYON ompö kokonï.”",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.12",
            "verseOrgIds": [
              "RUT.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Poas nko yiyenyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
