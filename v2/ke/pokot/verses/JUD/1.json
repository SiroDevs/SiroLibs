          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwïrngwïronöy pïchoni kïtenö osis akugheghchini pikö walaka. Pich chane cho rïpöy möchutkökwa cho ghach, menöy lö kïchï pich cho echön, akï lïso kïnamata kegh nko pich ngalekwa cho onyïn, atökïnyorï tïkwïn cho kömököy.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.16",
            "verseOrgIds": [
              "JUD.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rirchin nko kinetut",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
