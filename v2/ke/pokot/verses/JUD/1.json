                  "text": "2Pt 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kimwowokwa lö, “Chumu pich osiswo söröm cho nyernyerenekwa akï pich cho rïpöy pïrchintinekwa cho mökonyïtönye Tororöt.” ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.18",
            "verseOrgIds": [
              "JUD.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JUD 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pich choni cho ipu pesyogh ompö kwenunkwa, pich cho ntöghoghchini kinonutkökwa cho pö ngwïninï akïmötïngcha chane Mïkulögh nyo Tïlil. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.19",
            "verseOrgIds": [
              "JUD.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JUD 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo cho le akwa kongotichu, aleta tagh achïchima kegh ompö kighanatengwo nyo tïlil nyoman, asagh ompö owesyo Mïkulögh nyo Tïlil, ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.20",
            "verseOrgIds": [
              "JUD.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JUD 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "akany kïkamanakwa chomnyo Tororöt otini omitö oköngöy Echotyontenyo Yeso Kristo, kïkonokwa söpon pö kokay ompö kisyonötenyi.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.21",
            "verseOrgIds": [
              "JUD.1.21"
            ]
          }
        }
      ]
