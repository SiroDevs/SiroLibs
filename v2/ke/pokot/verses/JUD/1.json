              },
              "items": [
                {
                  "text": "Kiy 14:29-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omökan ye ononwokwa, kïrkegh kökyonkïtukwa lasïny lö kisörï Echotyon pipö Israel osiswechanya kïngetunö koro Misri, wölo atomi löt kuwany pich ompö kwenungwa cho kipuryö kighanat. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.5",
            "verseOrgIds": [
              "JUD.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JUD 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anan ya malayken cho kiyörchï kegh wowïn kïsir nyini le nyingwa, akïpïstö möngengwa nyo kö pö su. Kikïrata Tororöt chane sïrïmtin akureytö wölo tuw, akïkörchï chane wölini ntökïtenö kwitï Asisay wow kirwokini chane. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.6",
            "verseOrgIds": [
              "JUD.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JUD 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.1+GEN.19.2+GEN.19.3+GEN.19.4+GEN.19.5+GEN.19.6+GEN.19.7+GEN.19.8+GEN.19.9+GEN.19.10+GEN.19.11+GEN.19.12+GEN.19.13+GEN.19.14+GEN.19.15+GEN.19.16+GEN.19.17+GEN.19.18+GEN.19.19+GEN.19.20+GEN.19.21+GEN.19.22+GEN.19.23+GEN.19.24"
              },
              "items": [
                {
                  "text": "Tow 19:1-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anan ya kanastina Sodoma nko Komora nko kanastin cho kilekïtinö, cho kipechï pikökwa kwigh tïkwïn cho lata choni kigh malayken, akïpechï kwigh cheporesnan nko takalnan. Kikirwokyï chane kïnyorï nyarïlpa ma nyo pö kokay, tökïlïkwï nyoni kinetut nyo pö pich lapay.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.7",
            "verseOrgIds": [
              "JUD.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
