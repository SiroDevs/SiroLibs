              "type": "text"
            }
          ]
        },
        {
          "text": " Ani Yuda palalyantanï, nyay le mötworinto Yeso Kristo* nyo ochï tupchö nko Yakopo nyo kakir palalyantanete.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
