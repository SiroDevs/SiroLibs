              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo mïchini tupchenichu anana ngalechanya kimwowokwa kiyoktoghi Echotyontenyo Yeso Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.17",
            "verseOrgIds": [
              "JUD.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
