                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.7"
              },
              "items": [
                {
                  "text": "Ngo 21:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akimeghnye ompö lenyoni Mikael, nyo ki wow ompö malayken. Otini kinam kegh kut kïtiytiysot nko Onyöt ato kïmosot por pö Musa, kimemukïnye Mikael kïnörekyï Onyöt ompö kimwagha, wölo kilö, “Nya kïsyölchinyi Tororöt onkït.” ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.9",
            "verseOrgIds": [
              "JUD.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JUD 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo pïchï kumwoghöy kïgh anka tïkwïl cho möpköchinicha chane. Wongöy chane ngalechaye nkït chane ompö oringwa le ato nkït tïpö wudïn cho mötïngcha chïreryö. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.10",
            "verseOrgIds": [
              "JUD.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JUD 1:11"
          },
          "items": [
