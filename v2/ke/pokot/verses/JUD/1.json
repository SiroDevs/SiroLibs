          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.7",
            "verseOrgIds": [
              "JUD.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JUD 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lata choni pïchete tïkwïl. Mïtöy chane kirwotïtoghtinekwa ngokï ompö porwöyikwa, akïsas paytaghpa Tororöt akumwa tïpö yïm cho töroröch cho kïgh Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.8",
            "verseOrgIds": [
              "JUD.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JUD 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.34.6"
              },
              "items": [
                {
                  "text": "Krt 34:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.13"
              },
              "items": [
                {
                  "text": "Dan 10:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.1"
              },
              "items": [
                {
                  "text": "12:1",
