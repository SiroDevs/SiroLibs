              "items": [
                {
                  "text": "Mat 26:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay omwochan chane lö, “Okonanïn ropïyenichu ato ochömekwa, wölo ato mochömekwanye akany kïtïpï.” Kïcham akupimwanïn ropïyenichan kerpes tömönut sömök cho pö silpa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.12",
            "verseOrgIds": [
              "ZEC.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
