        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sïwïyaghpa pörkoyö nyo kipimtoy",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osyolön konyïn asïwan chi nyo nömöy pörköyö nyo kipimtoy. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.1",
            "verseOrgIds": [
              "ZEC.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atepan lö, “Iwetenyi onö?”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.2",
            "verseOrgIds": [
              "ZEC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö, “Owetan opimöy koghïn nko töpesïn pö Yerusalem.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.2",
            "verseOrgIds": [
              "ZEC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.2",
            "verseOrgIds": [
              "ZEC.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö tagh malaykayantanay kingölonöy nko ani, kungwïn anka kuryam tïkwïl ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.3",
            "verseOrgIds": [
              "ZEC.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïlenchï, “Rïpö mwochinö karöchïnintoninö lö, chongitu pich nyoman kanasyanta Yerusalem nyo memukonye ketekyï nïyet ompöwölo möngörïnye pich nko kyak cho mi ori. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.4",
            "verseOrgIds": [
              "ZEC.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo lentöy ECHOTYON, ‘Olïkunan ante nayatu ma nyo witöy Yerusalem. Otöponan orinyi alïkwï ororyenyi.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.5",
            "verseOrgIds": [
              "ZEC.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kikur ECHOTYON pikachi kïmïlisyö kaw",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.5",
            "verseOrgIds": [
              "ZEC.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikur ECHOTYON pikachi kïlentöy, “Akwa wey! Oryöwunenö okumpö kuntoka wölo kyotoytochokwa le wölini okutïtonan yomat kïyasta! ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.6",
            "verseOrgIds": [
              "ZEC.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwa cho omi koro Papilon, oryöwunö lawel osorï Sayon!”* ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.7",
            "verseOrgIds": [
              "ZEC.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyoktanïn ECHOTYON Kimuktoghin ompö ororyenyi owö omwochï koros cho kirang pikachi kipa pïnotön lö, “Kor anka tïkwïl nyo swongöy piköchan kïlenye ato körïtanïn kong nyini tuw. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.8",
            "verseOrgIds": [
              "ZEC.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otökan ante ECHOTYON koroschini opïsinan piköchan kïngötöru koros cho kingatar korengwa akwigh mötwor, kïngatar koroschoni.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.9",
            "verseOrgIds": [
              "ZEC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.9",
            "verseOrgIds": [
              "ZEC.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lentöy ECHOTYON, “Tumö aingarak we chepö Sayon! Ongwïnan omöngöy kwenunkwa!”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.10",
            "verseOrgIds": [
              "ZEC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.10",
            "verseOrgIds": [
              "ZEC.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pkonöy koroswö osiswechoni akïlinyö nko ECHOTYON. Lïku nyu chane piköchan, amangan kwenungwa. Onkïtukwa nyu lö, ECHOTYON Kimuktoghin nyo kiyokwanïn wölo omikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.11",
            "verseOrgIds": [
              "ZEC.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pöyitu ngat atoni koro Yuda ECHOTYON nyo chömo kegh tya ompö koronï tïlil akïkïlchï kegh ngat kanasyanta Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.12",
            "verseOrgIds": [
              "ZEC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.12",
            "verseOrgIds": [
              "ZEC.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona sisa chi anka tïkwïl lasay ompö tawu ECHOTYON ompöwölo köngetunö nyinte möngenyi nyo tïlil.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.13",
            "verseOrgIds": [
              "ZEC.2.13"
            ]
          }
        }
      ]
    }
