          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amachan asyach ngöghomnyö, ankïtï chepoynön nko sölwontön, osïkwan lö lenye nyoni tïkwïl ato kïyonöy yomat.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.17",
            "verseOrgIds": [
              "ECC.1.17"
            ]
