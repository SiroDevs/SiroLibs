              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.18",
            "verseOrgIds": [
              "JER.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenchanïn ECHOTYON, “Yeremia, wïyö mwatïtena ngölyontenyan ompö Kuka Pich, wölo weröy pöytoghi Yuda ato lïtöy akï lïtuno kanasyanta Yerusalem. Wïyö mwatïtena tïkwïl lenyoni ompö kukoti walaka cho pö kanasyante. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.19",
            "verseOrgIds": [
              "JER.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lenchinö chane, ‘Akwa pöytoghi Yuda nko pikö löwïr nko pich cho möngöy Yerusalem, cho weröy kukotichï! Atere ngölyonto ECHOTYON.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.20",
            "verseOrgIds": [
              "JER.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.15+NEH.13.16+NEH.13.17+NEH.13.18+NEH.13.19+NEH.13.20+NEH.13.21+NEH.13.22"
              },
              "items": [
                {
                  "text": "Nem 13:15-22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lenchinö kamwaghan ante ECHOTYON lö, ato köyongöy söpon, okïr makasan tïkwïn asispa Sapato, amop tïkwïn kïlït kukoti Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.21",
            "verseOrgIds": [
              "JER.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.8+EXO.20.9+EXO.20.10"
              },
              "items": [
                {
                  "text": "Wuw 20:8-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Krt 5:12-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mekösönunö tïkwïn korikwo asispa Sapato, amagh ighisyö anka tïkwïl asisoni. Okonyïtö asisoni le asis nyo tïlil kïle wölo kyomwochan papotïnekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.22",
            "verseOrgIds": [
              "JER.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kiter amelö kiyang papotïnekwa ngalechan. Kilïkwï pich cho oghïghe mötöwö, amakïternye ngalechan, amakïrïpnye le wölo kyomwochan chane.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.23",
            "verseOrgIds": [
              "JER.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.23",
            "verseOrgIds": [
              "JER.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo ato ateranïkwa nyo ochï ECHOTYON, akïr kegh makasan kïgh anka tïkwïl kïlïtï kukoti kanasyantanï asispa Sapato, akonyït asisoni kïlïkwï asis nyo tïlil, akïr kegh magh ighisyö anka tïkwïl asisoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.24",
            "verseOrgIds": [
              "JER.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïlïtu, pöytoghï cho mïlöy ngacharu pöytoghin Daudi nko yetïntinekwa kukotï kanasyantanete kïpegho angoletin nko nkaritin. Lïtu chane nko pipö Yuda nko löwïr cho möngöy Yerusalem. Lïku nyu Yerusalem kanasyan nyo mangate kokay. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.25",
            "verseOrgIds": [
              "JER.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pkono pich kanastina Yuda löwïr nko koros cho lekïtinö kanasyanta Yerusalem, pkono walak koro Penchamen nko koro Syepela, kïpkana walaka kore wölo le komos nko kor nyo mi okumpö tagh nyo pö Yuda. Ipu chane ropöwo amöros Kö pö Tororöt, ropöwo pagh nko tïkuchay ngutoy cho onyïn nko ropöw cho kiyokyinegho Tororöt sörö. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.26",
            "verseOrgIds": [
              "JER.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo atomateranïkwanye, amokönyït asispa Sapato kïlïkwï nyo tïlil, amokïr akasan tïkwïn kïlïtöy kukoti Yerusalem asisoni, opelan kukoti Yerusalem. Nöghsot tïkwïl kori Yerusalem cho ororöch ompö ma nyo memukönye chi kumis.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.27",
            "verseOrgIds": [
              "JER.17.27"
            ]
          }
        }
      ]
    }
  ],
