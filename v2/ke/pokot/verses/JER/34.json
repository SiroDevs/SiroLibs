        "style": "s1"
      },
      "items": [
        {
          "text": "Kikipchï Sedekia ngölyon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
