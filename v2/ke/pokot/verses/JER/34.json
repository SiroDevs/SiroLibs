              "JER.34.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.1+2KI.25.2+2KI.25.3+2KI.25.4+2KI.25.5+2KI.25.6+2KI.25.7+2KI.25.8+2KI.25.9+2KI.25.10+2KI.25.11"
              },
              "items": [
                {
                  "text": "2Pöy 25:1-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "2Ot 36:17-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingölonwanïn ECHOTYON ato kimi Nepukadnesa pöytoghinto Papilon nko lïkenyi nko lïkos pö koros cho kipöytoy nyinte kïporyegho Yerusalem nko kanastine walaka cho lekïtinö. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.1",
            "verseOrgIds": [
              "JER.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenchanïn ECHOTYON, Tororöt pö Israel, “Wïyö mwochinö Sedekia, pöytoghinto Yuda lö kamwaghan ante ECHOTYON lö, kyotönön kanasyantanï mori pöytoghinto Papilon akïwetöy kïpelo ma. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.2",
            "verseOrgIds": [
              "JER.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany nyi Sedekia, melö ichïwïtenyi kïnöminyi akeretinyi wïyö Papilon nteryam aingalan nko pöytoghinto Papilon. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.3",
            "verseOrgIds": [
              "JER.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo nyi we Sedekia, pöytoghinto Yuda, teranïn lasiny. Möpörinyinye chi ompö poryot. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.4",
            "verseOrgIds": [
              "JER.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imeghenyi osiswe walaka ompö kalya akïpka pich kïpel tïkuchay ngutoy nyo karam asisoni kïrorinyi lenyini kikida papotïneku cho pö tagh cho kile pöytoghï kïtomö nyi. Lokyot pich asispa meghengu kïlentöy, ‘Heywey! Kameghenecha pöytoghintenyo.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.5",
            "verseOrgIds": [
              "JER.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.5",
            "verseOrgIds": [
              "JER.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay opchan Sedekia pöytoghinto Yuda ngölyontononi ompö Yerusalem ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.6",
            "verseOrgIds": [
              "JER.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "otini kimi lïko Papilon kïporyegho kanasyanta Yerusalem nko Lakis nko Aseka, kanastin odeny cho kiwokot opïn ompö koro Yuda akï cho kitomönye kïnam Nepukadnesa, pöytoghinto Papilon.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.7",
            "verseOrgIds": [
              "JER.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kityakata lïs nyo pö sekey",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.7",
            "verseOrgIds": [
              "JER.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi ato kicham pöytoghin Sedekia nko pipö Yerusalem lö kïpetöy ketyoköy ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.8",
            "verseOrgIds": [
              "JER.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "sekey cho le pipö Eprania, kö mïrön anta kö kor atömakïmi chi nyo ighöy chi pö Yaudi anka sekeyon. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.9",
            "verseOrgIds": [
              "JER.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïchomnyechï kintöghoghi nko pïchay löwïr lö wetöy chi anka tïkwïl kutyoktoy sekeyontenyi amökïminye chi nyo ighöy chi pö Yaudi anka sekeyon. Kutyak nyu chane sekeyikwa lenyini kimwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.10",
            "verseOrgIds": [
              "JER.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato le löt kïwaghach chane kinonutkökwa akïpa kuyokwï ngat pïchay kikiketyak akwigh sekeyikwa ngat. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.11",
            "verseOrgIds": [
              "JER.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïmwowanïn ECHOTYON, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.12",
            "verseOrgIds": [
              "JER.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tororöt pö Israel lö mwochinö pïchoni lö, “Atanya kyotyokunan papotïnekwa ompö sekeynön ompö koro Misri, kyaman muma* nko chane. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.13",
            "verseOrgIds": [
              "JER.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyolenchan mïchini chi anka tïkwïl kutyak sekeyontenyi nyo le chi pö Eprania kïwechï kegh nyo kipöghisyechï nyinte könyis mut nko odeny. Wölo melö kiterwanïn papotïnekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.14",
            "verseOrgIds": [
              "JER.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rose lö ompö nyete le oghi, kyowöghökisyökwa aghakwa kïrïp kegh nko ngölyontenyan otini kityak chi anka tïkwïl sekeyontenyi nyo le chi pö pipö Yaudi. Kyamakwa muma* ompö tawunyan ompö Kö pö Tororöt* wölini kïsoghenanïn. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.15",
            "verseOrgIds": [
              "JER.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kowöghökisyökwa ngat apa oyokwï sekeyichay asïmnyonökwa kaynenyan. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.16",
            "verseOrgIds": [
              "JER.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona omwoghan ante ECHOTYON lö, ompöwölo mokonyïtökwanye ngölyontenyan nyo komökenokwa atyaka pikökwo cho le sekey. Kanya nyu atyakekwa tïkwïl, owonyenö nyu ompö ngot nko sömew nko kömöy. Oghokwa pich cho ato sïwa pipö koros löwïr kwotyö. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.17",
            "verseOrgIds": [
              "JER.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oghchinan pïchoni kimökonyïtcha akïrïp ngala muma nyo kyaman nko papotïnekwa, le wölo kida eghay kikarer kwen akuwer kwenu panyechi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.18",
            "verseOrgIds": [
              "JER.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chane kï yetïntino Yuda nko Yerusalem nko opisatino ka pöytoghin nko tïsï nko pich löwïr cho kiwer kwenu panya eghay kikïkar kïlïkwï odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.19",
            "verseOrgIds": [
              "JER.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otöninan chane mori pungkökwa cho mi kïpsach kïpar chane. Omöy nyu töritwö nko tïpö wudïn porwöyikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.20",
            "verseOrgIds": [
              "JER.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otöninan tïkwïl Sedekia pöytoghinto Yuda nko mötworichi mori pung cho yöröy kïpar chane. Pung choni kï lïko pöytoghinto Papilon cho kiyoda kegh akuchal kïporyeghenokwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.21",
            "verseOrgIds": [
              "JER.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arosa! Kamwaghan ante ECHOTYON lö, oyoktenan kut kuyokwï kegh lïkononi pö pöytoghinto Papilon. Pkonöy kïporyegho kanasyantanete akïnam akïpela ma. Oghan kanastina Yuda kïlïkwï surkwen nyo puryö chi nyo möngöy.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.22",
            "verseOrgIds": [
              "JER.34.22"
            ]
          }
        }
      ]
    }
  ],
