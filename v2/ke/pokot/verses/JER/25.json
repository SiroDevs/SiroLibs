          "type": "text",
          "attrs": {
            "verseId": "JER.25.18",
            "verseOrgIds": [
              "JER.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chï kï pikö walaka cho kighegha kikompononi pö nörekyo ECHOTYON:",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.19+JER.25.20+JER.25.21+JER.25.22+JER.25.23+JER.25.24+JER.25.25+JER.25.26",
            "verseOrgIds": [
              "JER.25.19",
              "JER.25.20",
              "JER.25.21",
              "JER.25.22",
              "JER.25.23",
              "JER.25.24",
              "JER.25.25",
              "JER.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
