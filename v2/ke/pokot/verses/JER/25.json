          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigha lenyoni pipö ngwïny atomi söröm kïgha pöytoghinto Papilon.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.19+JER.25.20+JER.25.21+JER.25.22+JER.25.23+JER.25.24+JER.25.25+JER.25.26",
