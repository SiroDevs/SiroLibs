            }
          ]
        },
        {
          "text": "Kiyonï Sedekia, pöytoghinto Yuda Pasyur wero Malkia nko tïsin Sepania wero Maaseya, kïpka kïtepanïn ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
