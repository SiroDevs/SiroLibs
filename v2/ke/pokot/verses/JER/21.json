              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " lö, “Kaykay somwecha kingörokut ECHOTYON ompöwölo kikïsetï akikurik kanasyantenyo Nepukadnesa, pöytoghinto Papilon. Töptoy ana ighöy ECHOTYON töngönchin le wölo keghtoy su, kwigh Nepukadnesa kuyoda kegh kïpïstecha.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
