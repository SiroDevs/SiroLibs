        },
        {
          "text": "Atolapay kumït Nepusaradan, yetïn pö ripi pöytoghin Seraya nyo kile yetïn pö tïsï nko rïpintenyi Sepania nko ripï sömök cho ghyongo kuka Kö pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.24",
            "verseOrgIds": [
              "JER.52.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 52:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimïta kanasyan tïkwïl kintöghoghinto lïk nko kiruri pöytoghin cho le mut nko odeny akumït tïkwïl rïpinto yetïn pö lïk nyo kile kirurinto yetïntanyi nko pich walaka cho le 60 cho ororöch. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.25",
            "verseOrgIds": [
              "JER.52.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 52:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimïtyï Nepusaradan pïchoni pöytoghinto Papilon ompö kanasyanta Ripla. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.26",
            "verseOrgIds": [
              "JER.52.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïmuny akïtïgh pïchoni pöytoghinto Papilon ompö kanasyanta Ripla nyo kimi koro Amat.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kikïrang pipö Yuda kïpa pïnotnön. Achï kiyitöto pich cho kirang Nepukadnesa le ratan osiswo paytaghtanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 52:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pipö Yaudi 3,023 ompö könyi mut nko odeny, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
              "JER.52.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 52:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko 832 cho kiranga Yerusalem ompö könyi 18. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 52:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany ompö könyi 23 nyo pö paytaghtanyi, kïrang Nepusaradan, yetïn pö ripichi pipö Yaudi 745. Kïlenyona kilïkwï pïchoni löwïr kikïrang 4,600.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 52:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 52:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kinam Epilmerodak paytaghpa Papilon, kusyonchï Yeoyakin, pöytoghinto Yuda ntökutyokunö chela. Asisoni kikityokwï Yeoyakin kï asispa 25 nyo pö arawa taman nko odeny nyo pö konyi 37 kïngata kemït pöytoghin Yeoyakin le ratan kïwö Papilon. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kighchï pöytoghin Epilmoredaki Yeoyakin nyo karam, akïkonyït kïtïl pöytoghi walaka cho kimi pïnotnön nko nyinte koro Papilon. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kikïchömchï Yeoyakin kïngwïsta sïro pö chela akechömchï kwomisyö ompö mesa pöytoghin. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïropchï Yeoyakin pöytoghinto Papilon ropïyen atokumï kïyörchï kegh möchutkachi cho pö osis tïkwïl ntökïtenö kuwonyö osiswechi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
            "verseOrgIds": [
              "JER.52.34"
            ]
          }
        }
      ]
    }
