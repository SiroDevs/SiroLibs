      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ripöy ECHOTYON Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingwïnchanïn ngölyonto ECHOTYON kilenchanïn, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.1",
            "verseOrgIds": [
              "JER.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wïyö mwatïtena ompö Yerusalem lö lentöy ECHOTYON,",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.2",
            "verseOrgIds": [
              "JER.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngoki papotïno Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.3",
            "verseOrgIds": [
              "JER.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwa monïngo Yakopo nko akwa pipö ortïna Israel, atera ngölyonto ECHOTYON! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.4",
            "verseOrgIds": [
              "JER.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lentöy ECHOTYON,",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.5",
            "verseOrgIds": [
              "JER.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kerwokyï ECHOTYON pikachi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kïgh igho ompö penyata Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kitagh pipö Israel kïsagh ECHOTYON",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kimïchï sitöt pipö Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.25",
            "verseOrgIds": [
              "JER.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïle wölo nömöy arasï chorin ato kïnömchï chorsyö, kïnömöy arasï pipö Israel. Nömöy pöytoghikwa nko yetïntinekwa nko tïsikwa nko werkoyikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.26",
            "verseOrgIds": [
              "JER.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pïchoni chay lenchini ket, ‘Ichinyi paponyan,’ akïlenchï kogh, ‘Nyi nyo keyiyanïn.’ Ompöwölo köpörchanïn chane patagh, melö kipörwanïn mu. Wölo ato chumchï nyarïl, kïrirchanïn kïlentöy, ‘Nyonö sörwecha wey!’",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.27",
            "verseOrgIds": [
              "JER.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.27",
            "verseOrgIds": [
              "JER.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ayo, mi onö tororötineku chay keghchinyi kegh? Ne mapka kungarakinyi ato muköy otini kechumchinyi nyarïl nya? Olentan chang tororötineku nya, we Yuda, tenö kanastineku! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.28",
            "verseOrgIds": [
              "JER.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö ne togheghchinanïkwa? Kyataghakwa löwïr ngalechan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.29",
            "verseOrgIds": [
              "JER.2.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.29",
            "verseOrgIds": [
              "JER.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kiwö kwïle sitenyan nyo kinyorï pikökwa, ompöwölo kicham lö kikelel. Kiwany chokengu werkoyköku le ngötïny nyo komï. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.30",
            "verseOrgIds": [
              "JER.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwa we pïnwöy, atere ngölyonto ECHOTYON! Ayo, okörakegh so nko kor nyo le surkwen ompö Israel, anta kor nyo kinyïghï tuwïn? Kwompö ne nyu tökïlentöy piköchan, ‘Kighecha le wölo kakïchamta amökepkonechanye kokay wölo imitenyi!’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.31",
            "verseOrgIds": [
              "JER.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayo, muköy so työ kïwutyeghö karichi cho mino kegh, anta muköy mïraru kensyö kïwutyeghö sïrokachi? Wölo kiwutyeghanïn piköchan ompö osis cho meyitisyocha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.32",
            "verseOrgIds": [
              "JER.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichinyi körom nyoman ompö rïpsetagh pö chaman! Imukenyi ompö tenet kor cho tïng otöptin cho ghach ortïneku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.33",
            "verseOrgIds": [
              "JER.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pröch sïroköku ompö kisönpö mey nko cho mötïngcha lelut, amelö ompöwölo kinyorunyi kïwiröy kongu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.34",
            "verseOrgIds": [
              "JER.2.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo ompö choni löwïr, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.34",
            "verseOrgIds": [
              "JER.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïtelentenyi, ‘Kegh ngo ne nyo gha, nyo melö töngwanïn nörekyo ECHOTYON.’ Wölo orwokyininyi ompöwölo kelenyi, ‘Maghanye ngokï.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.35",
            "verseOrgIds": [
              "JER.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö ne tegha kegh chi nyo le kwïle, otï kewaghakananyi ortïneku le nyï? Rotinyi pipö Misri le wölo kiratïta pipö Asirya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.36",
            "verseOrgIds": [
              "JER.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwotini imïleghonyi Misri, iyenonunyi kegh möt ompö arasï. Ompöwölo töghöy ECHOTYON pïchoni itwoytonyi kegh, amenyorchininyinye chane kingörokut nyonikïny.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.37",
            "verseOrgIds": [
              "JER.2.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Meghönotcha pipö Israel",
          "type": "text"
        }
      ]
    }
  ],
