          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenchanïn ECHOTYON, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïle otini momukekwanye ntawaghach muma* nyo kyaman nko pöghet, aman nko oghö lö, mi ato lïku pöghet akï mi ato lïku oghö, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïmomukekwanye tïkwïl awaghach muma nyo kyaman nko mötworintenyan Daudi. Kyamwaghan lö möminye kokay ato potöy chi pö ara Daudi nyo töpo ngacharunyi pö paytagh. Kyamwaghan tïkwïl lö mepotönye tïsin nyo pö ara Lawi nyo pöghisyechinanïn. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.21",
            "verseOrgIds": [
              "JER.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otösan pipö ara pöytoghin Daudi nko tïsï cho pö ara Lawi kïchangit nyoman nyo memukönye chi kuyit le kokel cho mi yïm anta ngayam cho mi sörömu nanam.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.22",
            "verseOrgIds": [
              "JER.33.22"
            ]
          }
        }
      ]
    },
