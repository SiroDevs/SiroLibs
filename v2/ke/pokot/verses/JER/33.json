                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lentöy ECHOTYON, “Itïtöy ato opuntenan ayomis nyo kyaman nko pipö Israel nko Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.14",
            "verseOrgIds": [
              "JER.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö osiswechoni okïlan chi nyo le chumwak nyo ngwïno ara pöytoghin Daudi kïpayta kor. Ighöy nyinte man nko tïkwïn cho karamach ompö kore kïmïkul. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
              "JER.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsöru pipö Yuda nko Yerusalem kïtïpï ompö kalya akïsïköy kanasyantanoni kaynat nyo kïlentöy, ‘ECHOTYON nyo le sörunintencha.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
          }
        }
      ]
