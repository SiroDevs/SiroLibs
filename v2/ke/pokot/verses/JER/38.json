                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keripchanïn nyu kö pö ripï ntökïtenö asis nyo kikïrïnta akenam kanasyanta Yerusalem.",
          "type": "text",
