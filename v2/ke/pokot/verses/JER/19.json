              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenchanïn ECHOTYON, “Wïyö wölo mi ighinto tören aiyal tör. Atolapay imït poy nko tïsï cho le poy cho te ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.1",
            "verseOrgIds": [
              "JER.19.1"
            ]
          }
        },
        {
