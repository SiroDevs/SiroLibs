              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achï ngal cho kipkonchanïn Yeremia, wero Ilkia ato kyochan tïsin ompö kanasyanta Anatot nyo mi koro Penchamen. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2Pöy 22:3–23:27; 2Ot 34:8–35:19.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kingwïnchanïn ngölyonto ECHOTYON ompö könyi taman nko sömök nyo pö paytaghpa Yosia, wero Amon nyo pö Yuda ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
