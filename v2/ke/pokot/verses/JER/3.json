              "JER.3.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        2Pöy 22:1–23:30; 2Ot 34:1–35:27.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ompö osiswo paytaghpa pöytoghin Yosia, kilenchanïn ECHOTYON, “Ayo, kesïwenyi kïgh nyo kegh Israel nyo poru lö melö ghanate? Köpïstanïn akïwechï kwigh cheporesnan ompö komos nko ghïtwo pö ket cho nyörilöch sökö! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.6",
            "verseOrgIds": [
              "JER.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyolenchinan kegh atowany kwigh choni löwïr, kïmïlisyö wölo omitan, wölo melö kigh lenyoni. Kisöwintönchï cheptangwa Yuda, nyo le lïsin, ngalechoni löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.7",
            "verseOrgIds": [
              "JER.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisöwintönchï Yuda tïkwïl lö kyayonan Israel le korka nyo kakityak akwompö cheporesnanenyi, wölo melö kyotyö nyonikïny. Kilïkwï nyinte tïkwïl chepores! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.8",
            "verseOrgIds": [
              "JER.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwompöwölo kisïwa lö ki kïgh nyo mïnïng cheporesnan, kwipchï kor sïmnyontön nyo wow nyoman ompö cheporesnan otini kisoghöy koghïn nko ket. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.9",
            "verseOrgIds": [
              "JER.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amelö ompö kitökïmïleghchanïn Yuda, cheptompö Israel nyo le lïsin ompö mïkulöwunyi kïmïkul wölo ompö lïs.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.10",
            "verseOrgIds": [
              "JER.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.10",
            "verseOrgIds": [
              "JER.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchanïn ECHOTYON, “Kaykay penyintonï le Israel kïtïl Yuda nyo le lïsin. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.11",
            "verseOrgIds": [
              "JER.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona wïyö mwochinö Israel lö kamwaghan lö,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.14",
            "verseOrgIds": [
              "JER.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okonokwa nyu atoni mösöw cho chömanïn ompö mïkulögh akï pöghokwa ompö ngöghomnyö nko pköchin. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.15",
            "verseOrgIds": [
              "JER.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwato otösisyekwa achangitï ompö kor osiswechoni, makïngölonönye pich ngat kïlentöy, “Santuku Muma* ECHOTYON.” Puryö ompö nyo tökunonöy, kikewutyeghö amökwomönye pich emö, anta nyo lentöy opï kakigh Santuku Muma ECHOTYON anka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.16",
            "verseOrgIds": [
              "JER.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkuro osiswechoni Yerusalem, “Ngacharu paytaghpa ECHOTYON,” wölo ghömechini pipö koros löwïr ompö tawunyan kïsaghanïn amelö tökïpïrchini ngat kwighöy möchutko mïkuliskökwa cho ghach. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.17",
            "verseOrgIds": [
              "JER.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ryomöy nyu osiswechoni pipö Yuda nko pipö Israel cho pkono koros cho mi okumpö löt akïmïlisyö kor nyo kyotönön köny papotïnekwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.18",
            "verseOrgIds": [
              "JER.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kasagh pipö Tororöt körkeyïntin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atoni nyu ato omwoghekwa lö,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.22",
            "verseOrgIds": [
              "JER.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.23",
            "verseOrgIds": [
              "JER.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïngeta kechicha mïnkech nko ye, kiwangenecha tïkwïn cho kipïswecha papotïnecho ngölyontonï pö arasï. Kiwangenecha kyak nko monïng cho le wor nko tipïn. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.24",
            "verseOrgIds": [
              "JER.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona mïchinecha kewirchinö kegh ngwïny ompö arasnï kanamecha. Nya kulumecha kiratatenyo ompöwölo, kïngeta kechicha mïnkech, kikighchicha nko papotïnecha ngokï ECHOTYON Tororötïncha, atökeghchinecha nko ompö nyete le ye. Melö ompö kitöketeracha kuti ECHOTYON Tororötïncha.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.25",
            "verseOrgIds": [
              "JER.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuröto kötogh",
          "type": "text"
        }
      ]
    }
  ],
