              "JER.35.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        2Pöy 23:36–24:6",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7"
              },
              "items": [
                {
                  "text": "2Ot 36:5-7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kilenchanïn ECHOTYON ato ki pöytoghinto Yuda Yeoyakim wero Yosia, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.1",
            "verseOrgIds": [
              "JER.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wïyö kestoni pipö ara Rekap aingalan tïkwïl atolapay imïtï kïtïpï kö nyo mïnïng ompö Kö pö Tororöt.* Otini kötöpï ngwïny kumuchö, iropchï chane dipay* kïgha.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.2",
            "verseOrgIds": [
              "JER.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owan lenyini amïtï Yasania wero Yeremia, kuköto Apasinia nko werkökwa nko monekwa, pipö ara Rekap kïmïkul. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.3",
            "verseOrgIds": [
              "JER.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyomïtyan Kö pö Tororöt akepa ketïpi opis pö kinetan pö Anan, wero Idalya nyo le mötworinto Tororöt. Kilekïto opisnoni opistino pich cho echön akimi paraku opis pö Maaseya wero Syalum nyo kile wowïn pö Kö pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.4",
            "verseOrgIds": [
              "JER.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay otönön tawu pipö Rekap kikompen nko pakulin cho kikinyïghit dipay, alenchan, “Ogheghsyenö.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.5",
            "verseOrgIds": [
              "JER.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.5",
            "verseOrgIds": [
              "JER.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kuyokwanïn chane lö, “Melö kïgheghecha dipay ompöwölo kitaghenecha paponcha Yonadap wero Rekap nyo kilenchecha, okïr kegh maghegh dipay amochömchï monekwo tïkwïl kïgha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.6",
            "verseOrgIds": [
              "JER.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motekyï kegh korïn amangor paren amakatkat sapipun anta al pareni sapipun. Omöngekwa emen osis tïkwïl atomöngisyenö könyis cho chang ompö koronï omikwa le rutoghot. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.7",
            "verseOrgIds": [
              "JER.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikerïpacha ngalechoni kimwowecha kukötönyo Yonadap wero Rekap nyini kikïrenecha keghegha dipay. Kïlenyona melö kïgheghöcha dipay amögheghönye korucha nko monecha cho le wor nko tipïn tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.8",
            "verseOrgIds": [
              "JER.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kïtekyinecha kegh korïn cho kïmöngöy amelö kïtïngetecha pareni sapipun anta paren cho kïngoröy. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.9",
            "verseOrgIds": [
              "JER.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmöngecha emen lenyini kirurecha kukötöncha Yonadap. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.10",
            "verseOrgIds": [
              "JER.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo otini kitor pöytoghin Nepukadnesa kïporyeghö korenete, keryöwucha kewïnga kegh Yerusalem ompöwölo kiwöghecha lïko pipö Papilonia nko nyo pö Sirya. Nka nyete ye nyu kïmöngecha kanasyanta Yerusalem.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchanïn ECHOTYON Kimuktoghin, Tororöt pö Israel, “Wïyö mwochinö pipö Yuda nko Yerusalem lö katepan chane ante ECHOTYON lö, ompö ne tömoterökwa ngölyontenyan arïp kirurutköchan? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.12+JER.35.13",
            "verseOrgIds": [
              "JER.35.12",
              "JER.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anetena kegh pipö ara Yonadap wero Rekap cho kiter akïrïp lenyini kikïmwochï lö maghegh dipay. Nyo pö nyoman melö mi ompö akong nyo kigha dipay kïngata osiswechoni nko nyete le ye. Kyongölonwokwa arurokwa kïnyïl cho chang wölo melö kyateranïkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.14",
            "verseOrgIds": [
              "JER.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyoyokwokwa mötworichan werkoy kïnyïl cho chang cho kipka kïmwowokwa lö opïstenö ortïnekwo cho ghach atolapay owöghökisyö agh man. Kimwowokwa lö orip kegh masagh amopöghisyechï tororötin walaka. Nyo ntökyarïpakwa ngalechoni kitomöngekwa kokay koronete kokonokwa atö tïkwïl papotïnekwa. Wölo nyu melö kyateranïkwa amelö kyayangakwa kïgh nyo kyamwaghan. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.15",
            "verseOrgIds": [
              "JER.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiter akïrïp pipö ara Rekap ngölyontononi kukötöngwa Yonadap, wölo materanïkwanye chï le akwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.16",
            "verseOrgIds": [
              "JER.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, omwoghan ye ante ECHOTYON, Tororöt Kimuktoghin, Tororöt pö Israel lö, opchinan kiwurat pipö Yuda nko Yerusalem, nyo lata nyo kyamwaghan kutinyu lö onyorunekwa. Oghan lenyoni ompöwölo melö kyaterakwa ngal cho kyomwowekwa, kyokurokwa amongitönökwanye.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.17",
            "verseOrgIds": [
              "JER.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.17",
            "verseOrgIds": [
              "JER.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay omwochan pïchay pö ara Rekap lö kölö ECHOTYON Kimuktoghin, Tororöt pö Israel, “Ompöwölo kyarïpakwa agh lenyini kimwowokwa kukötönkwa Yonadap, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.18",
            "verseOrgIds": [
              "JER.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyomisokwa ante ECHOTYON Kimuktoghin, Tororöt nyo pö Israel lö, möminye ato potöy chi nyo pö ara Yonadap wero Rekap nyo pöghisyewanïn kokay.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.19",
            "verseOrgIds": [
              "JER.35.19"
            ]
          }
        }
      ]
    }
  ],
