            "style": "v",
            "sid": "JER 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.16",
            "verseOrgIds": [
              "JER.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Arosa lö oyokunan kwenunkwa moroyut, pkonöy mïnyay kïsïrokwa amomukekwanye opolokïn.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.17",
            "verseOrgIds": [
              "JER.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kisönönchï Yeremia pikachi",
          "type": "text"
        }
      ]
    }
