          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn ECHOTYON, “Oyonunan pung cho pkonöy kïngötöröy tïkukwa nko ropïyenikwa. Lïku nyoni sitenyan ompö ngokï cho kyaghakwa ompö kore kïmïkul. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
            "verseOrgIds": [
              "JER.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oghokwa opöghisyechinö punkökwo ompö kor nyo monkïtökwanye, ompöwölo lata nörekyenyan ma nyo nöghöy kokay.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        }
      ]
    },
