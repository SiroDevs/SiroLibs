          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalechï kï sörömu ngala Yeremia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.64",
            "verseOrgIds": [
              "JER.51.64"
            ]
          }
        }
