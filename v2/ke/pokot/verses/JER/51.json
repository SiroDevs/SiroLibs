          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lenchini ECHOTYON pikachi cho mi Papilon,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.50",
            "verseOrgIds": [
              "JER.51.50"
            ]
          }
        }
