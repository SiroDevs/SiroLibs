          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyinte nyo tïlilöy nko chane cho kitïlilöy kïtïng löwïr apite akonga nko nyinte. Nka nyoni mösïwïyinye Yeso arasï kïkurö chane tupchenichu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.11",
            "verseOrgIds": [
              "HEB.2.11"
            ]
          }
        }
      ]
    },
