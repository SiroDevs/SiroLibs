              "items": [
                {
                  "text": "Aky 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitimtim kutinyi osiswechoni ngwïny, wölo keyomisï nyinte ye lö, “Totimtiman ngwïny ngat amelö ngwïny onkït wölo otimtiman yïm kïmïkul.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
            "verseOrgIds": [
              "HEB.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porwecha ngölyontonï “ngat” lö, kitimtimöy tïkwïn löwïr cho kikigh aketoyö, akenategha, atökudong nyu tïkwïn cho metimtimisyocha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.27",
            "verseOrgIds": [
              "HEB.12.27"
            ]
          }
        }
