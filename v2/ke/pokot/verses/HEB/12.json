      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.21",
            "verseOrgIds": [
              "HEB.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo katukwa kutïng pö Sayon* akwa kanasyanta Tororöt nyo satate, Yerusalem nyo pö yïm, wölo nyoryegho malayken cho makïrar. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.22",
            "verseOrgIds": [
              "HEB.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katïtekwa wölo nyoryegho Tororöt nko monechi cho le poretay cho kikekir kaynötutkökwa ompö yïm. Kapkanakwa wölo mi Tororöt nyo le kirwokinto pich kïmïkul nko nyo pö mïkulis pö pich tïkwïl cho kikegh kïtïlilöchitu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.23",
            "verseOrgIds": [
              "HEB.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
