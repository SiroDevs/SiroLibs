            "verseOrgIds": [
              "HEB.12.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.35.3"
              },
              "items": [
                {
                  "text": "Isa 35:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Osyolö nyu ewunekwo cho nyörkölöl, achïchim kutïngöyikwo cho oghochot. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.12",
            "verseOrgIds": [
              "HEB.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.4.26"
              },
              "items": [
                {
                  "text": "Ngt 4:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aleta tagh arïpa or nyo ghïteghote, tömöngwal kel nyo chirate, wölo tökesop.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
              "HEB.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
              "HEB.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okilö kegh, otïpinö ompö kalya nko pich löwïr otïpinö otöp nyo pö tïlilyö nyo ato mötïngnye chi kïmösïwïyinye Echotyon. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.14",
            "verseOrgIds": [
              "HEB.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.18"
              },
              "items": [
                {
                  "text": "Krt 29:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Okil kegh lasiny tömötöp chi anka tïkwïl ntökïchïwïta pöropcho Tororöt. Orip kegh tömakarkegh nko ket nyo ngwan nyo ipu nyörilwok cho chang ködöwichi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.15",
            "verseOrgIds": [
              "HEB.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.29+GEN.25.30+GEN.25.31+GEN.25.32+GEN.25.33+GEN.25.34"
              },
              "items": [
                {
                  "text": "Tow 25:29-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Orip kegh tömörumunö chi kwenunkwa nyo ighöy cheporesnan anta chi nyo mewöghönye Tororöt nyo karkegh nko Esau nyo kyalta mïlatenyi nyo pö poretnan omisyö nyo pö asakonga kwïle. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.16",
            "verseOrgIds": [
              "HEB.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.30+GEN.27.31+GEN.27.32+GEN.27.33+GEN.27.34+GEN.27.35+GEN.27.36+GEN.27.37+GEN.27.38+GEN.27.39+GEN.27.40"
              },
              "items": [
                {
                  "text": "Tow 27:30-40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ato mi lötï otini kilentöy tonyorï ngat kisoyönötonay kile nyenyi, ketagha, ompöwölo kimökïsïchnye pöroyïn nyo kiköteghö, kïrkegh kimar ntökïtörengu lok.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.17",
            "verseOrgIds": [
              "HEB.12.17"
            ]
          }
        }
      ]
    },
