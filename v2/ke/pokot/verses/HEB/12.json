          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arose kegh nyu tömatagh nyinte nyoni ngölonöy. Ompöwölo ato kimöchïwïtyöcha pich cho kitagh kïlïm ngala chichoni kingwïn ngwïnyinï akuyomisï ngala yïm, ekechïwïtyonecha lö ne nyu ato kïghöpönöcha nyinte nyoni rirwecha ompö yïm? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.25",
            "verseOrgIds": [
              "HEB.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 12:26"
          },
          "items": [
