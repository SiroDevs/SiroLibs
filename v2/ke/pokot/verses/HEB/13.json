          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omökan onkïtunekwa lö kiketyokunö werïnyo Timoteo chela. Ato ngwïn lawel, ongwïnan nko nyinte otini orutoghchinokwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.23",
