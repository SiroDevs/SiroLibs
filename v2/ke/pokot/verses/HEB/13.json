              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otokweswecha kintöghoghikwa lapay nko pipö Tororöt kïmïkul. Ketakwesakwa tupchenicho cho pkono Talyan.",
          "type": "text",
          "attrs": {
