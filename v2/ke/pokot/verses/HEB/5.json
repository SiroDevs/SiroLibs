            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïlenyoni tïkwïl ompö Kristo,* kimakïlnye kegh nyinte onkït kïlïkwï Tïsin nyo Wow, ki Tororöt nyo kitö nyinte, akïlenchï:",
          "type": "text",
