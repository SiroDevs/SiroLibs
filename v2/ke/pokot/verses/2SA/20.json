        },
        {
          "text": "Kighyongchini Yoap pipö lïk cho pö Israel, kughyongchini Penaya wero Yeoyada pipö Keret nko Pelet, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
