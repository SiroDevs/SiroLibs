        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpka ortïna pipö Israel löwïr wölo mi Daudi ompö Epron akïlenchï, “Kïchicha kisönköku kegh. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.1",
            "verseOrgIds": [
              "2SA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kintöghoghchinyi pipö Israel ompö poryot ompö osis cho kipöytoy Saulö. Kïlenchinyi ECHOTYON, ‘Ilïkunenyi pöytoghinto piköchan Israel.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.2",
            "verseOrgIds": [
              "2SA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpka nyu poyi Israel löwïr Epron wölo mi pöytoghintö, kwam muma Daudi nko chane ompö tawu ECHOTYON ompö Epron akïkïl Daudi kïlïkwï pöytoghinto Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.3",
            "verseOrgIds": [
              "2SA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.11"
              },
              "items": [
                {
                  "text": "1Pöy 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.3.4"
              },
              "items": [
                {
                  "text": "1Ot 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.27"
              },
              "items": [
                {
                  "text": "29:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitïng Daudi könyis tömönut sömök otini kitor kïpayta, kipayta nyinte ompö könyis tömönut angwan. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.4",
            "verseOrgIds": [
              "2SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipayta Yuda ompö Epron könyis mut nko odeny nko aro mut nko akonga, kïpayta ompö Yerusalem Israel kïmïkul nko Yuda ompö könyis 33.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.5",
            "verseOrgIds": [
              "2SA.5.5"
            ]
          }
        }
      ]
    },
    {
