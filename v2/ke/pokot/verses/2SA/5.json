              "text": "5:20",
              "type": "text"
            },
            {
              "text": "Paal Perasim:",
              "type": "text"
            },
            {
              "text": "Ompö Eprania kelentöy ECHOTYON nyo chutöy.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpïsyï atoni pipö Pilisti körkeyïntinekwa, kïsït Daudi nko pikachi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.21",
            "verseOrgIds": [
              "2SA.5.21"
            ]
          }
        }
