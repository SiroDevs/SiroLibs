      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.29",
            "verseOrgIds": [
              "2SA.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmïlegha Yoap wölay kiyonchï Apner akutuyö pikachi, kimömicha pipö Daudi cho le 19 amelö kiyit Asael. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.30",
            "verseOrgIds": [
              "2SA.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kipar pipö Daudi pipö Penchamen 360 cho kimi nko Apner. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.31",
            "verseOrgIds": [
              "2SA.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsït Yoap nko pikachi por pö Asael akïpa kïrorchï möt pö kwanta nyo mi Petleem. Atolapay kïpa oghö kïyech ntökwit Epron tökwoghö.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.32",
            "verseOrgIds": [
              "2SA.2.32"
            ]
          }
        }
