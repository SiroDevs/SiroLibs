  "copyright": "PUBLIC DOMAIN",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "2SA 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kiwonyö choni, kïtep Daudi ECHOTYON lö, “Owan apusta atang kanasyan akonga nyo pö Yuda?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON nyinte, “Owöy, wïyönyi.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Daudi lö, “Owan kanasyante nyono?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö ECHOTYON, “Kanasyanta Epron.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.42+1SA.25.43"
              },
              "items": [
                {
                  "text": "1Sam 25:42-43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïwö Daudi kïpusta wölini nko koruchi kwodeny, Ainoam nyo pö kanasyanta Yesrel nko Apikail nyay kimïl kile koko Napal nyo pö kanasyanta Karmel. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.2",
            "verseOrgIds": [
              "2SA.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwï Daudi tïkwïl nko pikachi nko monekwa akïmang kanastina Epron. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.3",
            "verseOrgIds": [
              "2SA.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.11+1SA.31.12+1SA.31.13"
              },
              "items": [
                {
                  "text": "1Sam 31:11-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpka pipö Yuda akïkïl Daudi kïlïkwï pöytoghintengwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kimwochï chane Daudi lö, “Pipö Yapes Kiliad cho kiror Saulö,” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïyonta Daudi pich kïpa Yapes Kiliad akïlenchï, “Nya kusoyönokwa ECHOTYON, ompö köromnyö nyo kyoghchikwa Saulö pöytoghintengwo otini kyarorakwa nyinte! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.5",
            "verseOrgIds": [
              "2SA.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye nyu nya kuporwokwa ECHOTYON chomnyogh nyo möminye söröm! Oghwokwa tïkwïl kïgh nyo karam ompö kïgh nyo kaghakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.6",
            "verseOrgIds": [
              "2SA.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osïkö ye nyu owesyö anyökönitu, ompöwölo kikïma pöytoghintenkwa Saulö, akikïkïlanïn pipö Yuda alïkwan pöytoghintengwa.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.7",
            "verseOrgIds": [
              "2SA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakïkïl Isposyet kïlïkwï pöytoghinto Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.7",
            "verseOrgIds": [
              "2SA.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumït Apner wero Ner nyo kile yetïn pö lïko Saulö Isposyet wero Saulö kutang Maanaim. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.8",
            "verseOrgIds": [
              "2SA.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwigh nyinte kïlïkwï pöytoghinto Kiliad nko Asyurin nko Yesrel nko Epraim nko Penchamen nko koro Israel kïmïkul. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.9",
            "verseOrgIds": [
              "2SA.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Isposyet wero Saulö könyis tömönut angwan otini kitor kïpayta Israel, kipayta ompö könyis odeny. Wölo kïrïp pipö Yuda Daudi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.10",
            "verseOrgIds": [
              "2SA.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïpayta nyinte chane ompö Epron könyis mut nko odeny nko aro mut nko akonga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.11",
            "verseOrgIds": [
              "2SA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Poryo pipö Israel nko pipö Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.11",
            "verseOrgIds": [
              "2SA.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïweghö Apner wero Ner Maanaim nko mötwori Isposyet wero Saulö kutang Kipyon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.12",
            "verseOrgIds": [
              "2SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Yoap wero Seruya nko mötwori Daudi akuryama ngarpïlu Kipyon nko chane, kïtöpö söpïchtö anka kareranta anka nyo pö ngarpïlunay kïtöpö anka kareranta anka. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.13",
            "verseOrgIds": [
              "2SA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Apner Yoap, “Nya kïngetï mïrön cho ngörï akïporyö ompö tawunyo.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.14",
            "verseOrgIds": [
              "2SA.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Yoap, “Nya kïporyö.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.14",
            "verseOrgIds": [
              "2SA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngetï cho le taman nko odeny cho pö Isposyet wero Saulö nyo pö ara Penchamen nko taman nko odeny cho pö Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.15",
            "verseOrgIds": [
              "2SA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnam chi anka tïkwïl punyontenyi möt akïpïsïkö chok kamasunyi, kupïtyö nyu chane kwodeny. Kïlenyona kekurö atoni, “Wuw pö Chokon,” nyo mi Kipyon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.16",
            "verseOrgIds": [
              "2SA.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingwanit poryot asisoni nyoman, kïrïnta pipö Daudi Apner nko pipö Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.17",
            "verseOrgIds": [
              "2SA.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.17",
            "verseOrgIds": [
              "2SA.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimito atoni werpö Seruya cho le sömök, Yoap nko Apisyay nko Asael. Kipïrtït Asael le cheptirkich. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.18",
            "verseOrgIds": [
              "2SA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyon Asael Apner akimerosnye kamas nko kamas. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.19",
            "verseOrgIds": [
              "2SA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kura Apner löt akïlö, “Nyi nyete so Asael?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.20",
            "verseOrgIds": [
              "2SA.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö, “Owöy ani nyete.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.20",
            "verseOrgIds": [
              "2SA.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.20",
            "verseOrgIds": [
              "2SA.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Apner nyinte, “Waghakena tanga okumpö ewu tagh anta okumpö löt, aiyon akonga ompö pipö lïk aichenga tïkuchi löwïr.” Wölo melö kipïstö Asael kïyon Apner. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.21",
            "verseOrgIds": [
              "2SA.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Apner Asael ngat, “Nyapanena merïpanïn, pö ne aparinyi? Muko lö ne ntoporyan nko werïnkwa Yoap?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.22",
            "verseOrgIds": [
              "2SA.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kicham kïpïstö kïyon nyinte, kïlenyona kïwaghaka Apner akïtor Asael mu kurel patagh. Kupït Asael akïmeghchï otini kimi. Akï chi anka tïkwïl nyo kitï otini kimeghchï Asael, kï kighyö akïtangany.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.23",
            "verseOrgIds": [
              "2SA.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.23",
            "verseOrgIds": [
              "2SA.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïyon Yoap nko Apisyay Apner, ntökïröytochï asis kamaspa Ama nyo lekïto Kiya ompö or nyo wetöy kutöngöy surkwen pö Kipyon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.24",
            "verseOrgIds": [
              "2SA.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutuyö kegh pipö ara Penchamen nko Apner kïlïkwï lïk akonga akïtïpï psach ompö kutïng parak. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.25",
            "verseOrgIds": [
              "2SA.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïkur Apner Yoap akïlenchï, “Kïporyot so le nyete kokay? Mesïwïyenyinye lö ghöyitu sörömunyi? Ipïsyinenyi piköku kïyonöy werkökwa nko oyï?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.26",
            "verseOrgIds": [
              "2SA.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.26",
            "verseOrgIds": [
              "2SA.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Yoap, “Owolwolan ompö kaynata Tororöt lö, ntömengalananyi kötö tökïrïpöy piköchan werkökwa ntökwit asïyech tökwoghö.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.27",
            "verseOrgIds": [
              "2SA.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkut Yoap kontï, kuporï lö mökïminye poryot, kïpïstö pïchay kïrïp pipö Israel amelö kitö kïporyö ngat.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.28",
            "verseOrgIds": [
              "2SA.2.28"
            ]
          }
        }
      ]
    },
    {
