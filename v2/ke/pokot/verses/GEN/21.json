        "sid": "GEN 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusoyön ECHOTYON Sara kïrïp kegh nko kiyomisöt nyo kimwochï. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.1",
            "verseOrgIds": [
              "GEN.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.11"
              },
              "items": [
                {
                  "text": "Epr 11:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïkisyö Sara akïyichï Apraam monïng nyo le worö otini kökilïkwï nyinte poyon. Kiyï Sara werïnyi ompö osiswechini kikakïmwa Tororöt lö kïyiyöy. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.2",
            "verseOrgIds": [
              "GEN.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkurö Apraam kaynenyi Isak werïnyi nyini kiyichï Sara, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.3",
            "verseOrgIds": [
              "GEN.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.12"
              },
              "items": [
                {
                  "text": "Tow 17:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.8"
              },
              "items": [
                {
                  "text": "Ist 7:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïkany otini kitïta Isak osis mut nko odeny, kïmut Apraam nyinte lenyini kimwa Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.4",
            "verseOrgIds": [
              "GEN.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Apraam könyis pokol akonga otini tökeyichï werïnyi Isak. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.5",
            "verseOrgIds": [
              "GEN.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Sara, “Keghanïn Tororöt oror, akwanka tïkwïl nyo lïmöy ngölyontonï kïroröy nko ani.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.6",
            "verseOrgIds": [
              "GEN.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kulet tagh kïmwa lö, “Ngo nyo kemuköy ntökïlenchï Apraam muköy Sara kurerï monïng? Akwanyï ye koyichan nyinte monïng nyo le worö ompö yosïntanyi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.7",
            "verseOrgIds": [
              "GEN.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.7",
            "verseOrgIds": [
              "GEN.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnar nyu monïngay, ato mi asista nyo kikilïkuyöy, kwigh Apraam ichon nyo wow.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.8",
            "verseOrgIds": [
              "GEN.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakïyon Akar nko Ismael",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.8",
            "verseOrgIds": [
              "GEN.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisïwa Sara asistanka Ismael mompö Apraam nyay kiyichï Akar chepö Misri, kimi kïpirönöy nko Isak wero Sara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.9",
            "verseOrgIds": [
              "GEN.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.29+GAL.4.30"
              },
              "items": [
                {
                  "text": "Kal 4:29-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï nyu Sara Apraam lö, “Yona kokonï le sekeyon nko werïnyi, ompöwölo memukönye mompö sekeyon kïmïlisïyi nko werïnyan Isak.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.10",
            "verseOrgIds": [
              "GEN.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïghöchï Apraam ngölyontononi nyoman, ompöwölo ki werïnyi Ismael tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.11",
            "verseOrgIds": [
              "GEN.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.7"
              },
              "items": [
                {
                  "text": "Rum 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.18"
              },
              "items": [
                {
                  "text": "Epr 11:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlenchï Tororöt Apraam, “Mesïwa nyo gha ompö monïngï anta ompö korkengu nyï le sekeyon. Ighanyi kïgh anka tïkwïl nyo mwowunyi Sara, ompöwölo ngwïno Isak areto yiyengu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.12",
            "verseOrgIds": [
              "GEN.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oghan tïkwïl monïngo kokonï le sekeyon kïlïkwï pipö punton cho chang, ompöwölo yiyengu nyinte tïkwïl.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.13",
            "verseOrgIds": [
              "GEN.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.13",
            "verseOrgIds": [
              "GEN.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnget nyu Apraam nyini le kiwasan akwip omisyö nko söto pögh. Kutö Akar nko monïngay kïkasan pögh akïyon kïwö nko montanyi. Kïwö Akar akïmi kïwestegho surkwen pö Persyepa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.14",
            "verseOrgIds": [
              "GEN.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany otini kiwonyeghö pögh sötonay, kumïkonchï Akar werïnyi ato le wuw. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.15",
            "verseOrgIds": [
              "GEN.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akunayta miten cho itöy pokol kïwö kïtöpö ngwïny, akïmi kïlenchini kegh, “Momökanye osïwïyi megheto montanyu.” Wölo otini kimi kïtöpo atoni, kïrir monïngay.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.16",
            "verseOrgIds": [
              "GEN.21.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:16",
              "type": "text"
            },
            {
              "text": "monïngay:",
              "type": "text"
            },
            {
              "text": "Lentöy kikirutkö walaka Akra.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.16",
            "verseOrgIds": [
              "GEN.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlïm Tororöt kutito monïngay. Kïkur malaykayanta ECHOTYON Akar ompö yïm lö, “Kaminyi ne nya Akar? Mewöghisyö ompöwölo kakïlïm Tororöt kutito montö ompö wölini riroy. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.17",
            "verseOrgIds": [
              "GEN.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngeta aiwö icheng montö aisaghsagh, ompöwölo oghan nyinte kïlïku asïyech pipö punton cho chang.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.18",
            "verseOrgIds": [
              "GEN.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïyat Tororöt konyi Akar kïsïwa kö pö pögh. Kïwö akunyïghit sötonay akutö montanyi kïgha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.19",
            "verseOrgIds": [
              "GEN.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi Tororöt nko monïngay, kulet tagh monïngay kïnar. Kïmang wölo le surkwen kïlïkwï chi nyo le wutin nyoman. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.20",
            "verseOrgIds": [
              "GEN.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi kïmöngöy surkwen pö Paran, kïmörchï kame chepö Misri kwip.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.21",
            "verseOrgIds": [
              "GEN.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kyam Apraam muma nko Apimelek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.21",
            "verseOrgIds": [
              "GEN.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.22",
            "verseOrgIds": [
              "GEN.21.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.26"
              },
              "items": [
                {
                  "text": "Tow 26:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwö osiswechoni Apimelek nko Pikol nyo kile wowïn pö askarin akïlenchï Apraam, “Mi Tororöt nko nyi ompö tïkwïn löwïr cho ighenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.22",
            "verseOrgIds": [
              "GEN.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, omwanïn muma ompö yeteyi ompö tawu Tororöt lö melö ilïsaninyi anta monechan anta piko orenyan. Kïle wölini ochan ghanate ompö nyi, kïmïchini omwaninyi muma lö ilïkunenyi nyo ghanate ompö ani nko ompö koronete.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.23",
            "verseOrgIds": [
              "GEN.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
