          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato orïwön nko papotïnechan ipanïn oweghan Misri, aitïpchanïn wölo kikïtïpchï chane.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
