              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimang Yakopo koro Misri könyis 17 akïlïkwï könyiswo Yakopo löwïr 147. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.28",
