              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kilekïtitu osiswo Israel kïma, kïkur werïnyi Yosep akïlenchï, “Chama kïgh nyo oghan, kanagha ewungu kïpestönyan, ighwanïn nyo karam nyoman, metöp tetïpchanïn Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.29",
            "verseOrgIds": [
