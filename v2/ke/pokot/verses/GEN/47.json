              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona nyu kïmang Israel Kosyen ompö koro Misri, akïlïkwï sïkön ompö wöloni akïyiyö akïtösisyö tya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.27",
