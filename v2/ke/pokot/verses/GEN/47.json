              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh nyu Yosep ngölyontononi kïlïkwï kirurut nyo pö koro Misri, akïtökïmi nko ye lö, pöyitu Parao kareran cho pö mut kïpoto koro tïsï onkït nyo möpöyitnye Parao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.26",
            "verseOrgIds": [
              "GEN.47.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kipö söröm nyo kisom Yakopo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
