            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchï chichay, “Melö tökekureninyi ye Yakopo, wölo Israel,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.28",
