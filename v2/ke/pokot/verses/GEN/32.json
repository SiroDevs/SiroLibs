          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïkurö Yakopo kayneto atoni Peniel,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "32:30",
              "type": "text"
            },
            {
              "text": "Peniel:",
              "type": "text"
            },
            {
              "text": "Ompö Eprania kelentöy, “Tokochu Tororöt.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ompöwölo kilö, “Kyasïwan tokochu Tororöt akwanyï tochan satate.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikipusï asis atoni kingeto Yakopo Penuel, akingwolotoy ompö kichirata kompö löp. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyoni momöcha pipö Israel tikït nyo mi kompö löp nko nyete le ye, ompöwölo kiswany chichoni Yakopo tikïtyanoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
            "verseOrgIds": [
              "GEN.32.32"
            ]
          }
        }
