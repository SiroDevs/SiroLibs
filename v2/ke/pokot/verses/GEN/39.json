      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kikimït Yosep ntökwit koro Misri kwala Potipa pipö Ismael Yosep cho kimït nyinte kïwö wöloni le Misri. Ki chi Potipa nyo wowö pipö Parao cho le ripï. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.1",
            "verseOrgIds": [
              "GEN.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.9"
              },
              "items": [
                {
                  "text": "Ist 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kimi ECHOTYON nko Yosep, kïlenyona kïsïch perur nyoman ompö wölo mi ECHOTYON. Kïmang Yosep koto echotyontenyi chichoni pö Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.2",
            "verseOrgIds": [
              "GEN.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunkïtï echotyontenyi lö kimi ECHOTYON nko Yosep akunkïtï lö nyinte ECHOTYON nyini kiperur tïkwïn lapay cho kighöy Yosep. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.3",
            "verseOrgIds": [
              "GEN.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, kïcham Potipa kïgh nyo kigh Yosep, ntökumï kïlïkwï mötworintenyi nyo ghyongchini tïkuchi akïlïkwï ripinteto konyi kïmïkul. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.4",
            "verseOrgIds": [
              "GEN.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngata atoni kigh Potipa Yosep kughyongchï konyi akïlïkwï ripinteto tïkuchi lapay, kusoyön ECHOTYON koyay pö chichay pö Misri ompö paraku Yosep. Kïsïch kisoyönöto ECHOTYON kïgh anka tïkwïl nyo kitïng nyinte, ato nyo kimi kö anta nyo kimi par. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.5",
            "verseOrgIds": [
              "GEN.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïpïsyï Potipa Yosep kïpayta tïkuchi löwïr cho kitïng amelö kitökïtïng machat nyo sïngo kïgh anka tïkwïl kïpoto omisyö nyo kyomöy onkït.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.6",
            "verseOrgIds": [
              "GEN.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki chi nyo pïchigh Yosep nyoman ato kirosöy. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.6",
            "verseOrgIds": [
              "GEN.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany kuwer osiswö cho te, kïtora kong koko Potipa Yosep akïlenchï, “Keruyenö tïkwïl.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.7",
            "verseOrgIds": [
              "GEN.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïtagh Yosep akïlenchï korketo echotyontenyi, “Rose lö, omitan yete amelö tökïsïngo echotyontenyan kïgh anka tïkwïl nyo mi kö, akwanyï ketö nyinte tïkuchi löwïr morichan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.8",
            "verseOrgIds": [
              "GEN.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö wow nyinte ompö köyete kïtïlanïn akïtomönye kïtaghenanïn kïgh nyonikïny kïpoto nyi, ompöwölo ichinyi korkenyi. Oghan nyu lö ne ghöyityö nko ngokï cho tïrusöch lechoni ompö wölo mi Tororöt?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.9",
            "verseOrgIds": [
              "GEN.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akï kïrkegh kingölonchï kokononi Yosep kïtenö osis, wölo kitagh Yosep kïrï nko nyinte amöterchïnye anta töpö nko nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.10",
            "verseOrgIds": [
              "GEN.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.10",
            "verseOrgIds": [
              "GEN.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kitïta asis akong ato otini kilït Yosep kö tökwigh ighisyenyi nyo kighöy kïnomnyö amelö kimi piko ighisyö walaka köyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.11",
            "verseOrgIds": [
              "GEN.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnam kokonay pö Potipa sïra Yosep akïmi kïlenchini, “Keruyenö tïkwïl.” Wölo kïpïstö Yosep sïranay kimi moriko kokonay akuperta kïlït sany. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.12",
            "verseOrgIds": [
              "GEN.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany kïsïwa kokonay lö kirïp nyinte kïwö sany akïpïstö sïrenyi kïpïsyï morichi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.13",
            "verseOrgIds": [
              "GEN.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïkur mötworichi cho kighöy pöghisyö ompö konyi akïlenchï, “Arose nyu köny, kakipkecha chi pö Eprania nyo kengwïn kumwaghecha. Anyï ye kengwïn akömököy kïnömanïn orï nko nyinte ompö owesyö, ateghan kïmarikit, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.14",
            "verseOrgIds": [
              "GEN.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïkany kïlïm lö kyateghan lenyoni, kuperta kïlït sany akïpïswanïn sïrenyi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.15",
            "verseOrgIds": [
              "GEN.39.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.15",
            "verseOrgIds": [
              "GEN.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkaman kokonay sïranay ntökïtenö otini kimïla santenyi kungwïn kaw. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.16",
            "verseOrgIds": [
              "GEN.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kitï kïmwochï ngalechay ngat lö, “Kömököy mötworintonï le chi pö Eprania kimïtunyi kwighwanïn ngokï. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.17",
            "verseOrgIds": [
              "GEN.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo panini lawel ariran kuperta kïlït sany akïpïstö sïrenyi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.18",
            "verseOrgIds": [
              "GEN.39.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.18",
            "verseOrgIds": [
              "GEN.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kilïm nyu echotyonto Yosep ngalechoni kimwochini korkenyi nyinte lö, “Lenye nyoni wölo kedanïn mötworintengu,” kïnarek tya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.19",
            "verseOrgIds": [
              "GEN.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumït Potipa Yosep akïwö kïtorchï chela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.20",
            "verseOrgIds": [
              "GEN.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.9"
              },
              "items": [
                {
                  "text": "Ist 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kimi ECHOTYON nko Yosep akïcham nyinte nyoman ntökwigh wowïn pö chela kïchama kegh Yosep. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.21",
            "verseOrgIds": [
              "GEN.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kwigh wowïn pö chela Yosep kïpayta pich lapay cho kirötote ompö wölini le chela, akï kïgh anka tïkwïl nyo kikigha chelanoni kï nyinte nyo kigh ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.22",
            "verseOrgIds": [
              "GEN.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "amelö kitökïsïnga wowïnoni pö chela kïgh anka tïkwïl nyo kighyongchini Yosep, ompöwölo kimi ECHOTYON nko Yosep akwigh kïgh anka tïkwïl nyo kighöy kïsïch kiperuröt.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.23",
            "verseOrgIds": [
              "GEN.39.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kangor Yosep kirwotïtoghtino mampustin",
          "type": "text"
        }
      ]
    }
  ],
