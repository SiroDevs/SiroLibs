    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngetunö Apram koro Misri akïwö kutang okumpö löt. Kimi nko korkenyi nko tïkuchi löwïr nko Lot tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.1",
            "verseOrgIds": [
              "GEN.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki sïkön Apram nyoman, kitïng kechir nko ngaror nko tïch nko ropïyen nko koltin. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.2",
            "verseOrgIds": [
              "GEN.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulet tagh nko pantanyi kïngetunö okumpö tagh ntökwitï Petel, wölo kipörtochï emenyi, kwenu Petel nko Ai, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.3",
            "verseOrgIds": [
              "GEN.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "atoni ato kinya kïtekyineghö ECHOTYON ato kïpelo amöros. Kïsagha Apram ECHOTYON atoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.4",
            "verseOrgIds": [
              "GEN.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.4",
            "verseOrgIds": [
              "GEN.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Lot tïkwïl nyo kirutö nko Apram okwotïno tïch nko cho pö kechir nko emen. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.5",
            "verseOrgIds": [
              "GEN.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïmïnïngit koronay ompö chane kwodeny tïkwïl ompöwölo kichang kyakikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.6",
            "verseOrgIds": [
              "GEN.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwitï syala nyo kingwïna pipö Apram cho kile mösöw nko cho pö Lot. Kimöngöy osiswechoni pipö Kanan nko cho pö Peris.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.7",
            "verseOrgIds": [
              "GEN.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.7",
            "verseOrgIds": [
              "GEN.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïlenchï Apram Lot, “Mömïchininye kïrumunö syala kwenuncha anta kwenuto mösöweku nko chichan, ompöwölo kïchicha pipö or akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.8",
            "verseOrgIds": [
              "GEN.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo mïchini kepesyenöcha. Kïla nyo le nyi wop anka tïkwïl nyo kemach. Ato ikïlanyi okumpö löt owan okumpö tagh.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.9",
            "verseOrgIds": [
              "GEN.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
