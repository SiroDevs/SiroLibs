              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kitökïmöngöy Israel korononi, kïrï werïnyi Rupen nko Pila nyo kile chemïnïngwenyi.* Kïlïm Israel ngalechoni akïnyala tya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
