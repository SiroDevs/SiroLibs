          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Isak lö, “Kyaghan Yakopo kïlïkwï echotyontengu tönön werkökwa lapay kïlïkwï mötworichi. Kotönön nyinte pagh nko kumi sapipun. Tökïne nyo towunyi ye nyu nya werïnyu?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.37",
            "verseOrgIds": [
              "GEN.27.37"
            ]
          }
        }
      ]
