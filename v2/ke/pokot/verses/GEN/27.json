          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep kwanta lö, “Ichinyi ngo nya?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.32",
            "verseOrgIds": [
              "GEN.27.32"
            ]
          }
        }
