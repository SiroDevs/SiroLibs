          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïlenchï, “Kengwïn werïnkwa ompö lïs, akïcheng kisoyönötengu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.35",
