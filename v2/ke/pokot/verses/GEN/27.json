            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Esau, “Kikïmïnchï kaynenyi kuten lö Yakopo!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.36",
            "verseOrgIds": [
