        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.34",
            "verseOrgIds": [
              "GEN.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
