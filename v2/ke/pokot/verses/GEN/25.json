          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö nyu Yakopo Esau makatyan nko omisyonay pö denkun, kwam akïgha akïnget kïwö. Kïlenyona, kïsas Esau mantanyi nyo pö poretnan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.34",
            "verseOrgIds": [
