            "style": "v",
            "sid": "GEN 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
            "verseOrgIds": [
              "GEN.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyetu werchay, kïlïkwï Esau sökosin nyo ngöghom, chi nyo kichömöy kïtöpuno wuw, wölo kitalase Yakopo, chi nyo kimöngöy emen. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.27",
            "verseOrgIds": [
              "GEN.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïcham Isak Esau tya ompöwölo kichömöy kwomöy pany cho kipkono sakas, wölo kicham Repeka Yakopo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.28",
            "verseOrgIds": [
              "GEN.25.28"
            ]
          }
        }
      ]
    },
