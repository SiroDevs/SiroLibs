          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö Esau, “Nya kïle choni! Anyï karich ameghan, nyiwu ne mantanyan nyo pö yiyö ompö ani?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.32",
            "verseOrgIds": [
