          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany kuwany ECHOTYON kïngalan nko Apraam, kïwechï kegh, kïmïla Apraam.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.33",
            "verseOrgIds": [
              "GEN.18.33"
            ]
          }
        }
      ]
    },
