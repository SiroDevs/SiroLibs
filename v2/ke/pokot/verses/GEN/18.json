          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtas Apraam kïmwa lö, “Töptoy rumuno cho le tömönut angwan opïn.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
            "verseOrgIds": [
              "GEN.18.29"
            ]
          }
        }
      ]
    },
