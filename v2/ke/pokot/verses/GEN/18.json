          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö, “Monyoranye kanasyantanoni ato onyorchan tömönut odeny.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.31",
            "verseOrgIds": [
              "GEN.18.31"
            ]
          }
        }
