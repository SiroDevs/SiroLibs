          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï, “Monyoranye kanasyantanoni ato mi pich cho le taman.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
