          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mi lötï kïlö Apraam, “Kaykay menarek, ECHOTYON, pïswante amwagh nyo pö akonga. Ekwoto rumï pich cho pö man cho le taman?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
        }
      ]
