              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta pöytoghintonay yetïntö anka nko askarin tömönut mut kïpa wölaye kimi Eliya kïpa kïlenchï, “Kurinyi pöytoghintö lö rökuno nyete le ye!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
