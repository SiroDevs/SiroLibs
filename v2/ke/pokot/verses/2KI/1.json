          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï malaykayanta ECHOTYON Eliya, “Wïyö nko nyinte, mewöghisyö.” Kïlenyona kïwö Eliya nko yetïntönay wölo mi pöytoghintö. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
              "2KI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïlenchï, “Lentöy ECHOTYON, ‘Ompöwölo keyontenyi pich kïpa wölo mi Paal Sepup nyay le tororöt pö Ekron le ato melö kömi Tororöt koro Israel nyo kïtepöy kïgh, melö isöpenyi, imeghenyi.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        }
      ]
