          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta pöytoghintö yetïn pö askarin tömönut mut kïpa kïnam Eliya. Kïwö ghetintönay kïnyorï mpuröy ato le kutïng. Kïlenchï, “Kurinyi pöytoghintö we chi pö Tororöt.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        }
      ]
    },
