            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï pïchay lö, “Kiloköy sampï akukicha kegh angwa mu.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
