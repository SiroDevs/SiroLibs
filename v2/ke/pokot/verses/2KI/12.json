              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.3",
            "verseOrgIds": [
              "2KI.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
