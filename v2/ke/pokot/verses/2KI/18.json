  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "2KI 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilïkwï Esekia wero Aas pöytoghinto Yuda ompö könyi sömök nyo pö paytaghpa Osyea wero Ela pöytoghinto Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.1",
            "verseOrgIds": [
              "2KI.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng nyinte könyis 25 otini kitor kïpayta. Kipayta ompö Yerusalem könyis 29. Kikuro kame Apiya chepö Sakaria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.2",
            "verseOrgIds": [
              "2KI.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh nyinte nyo karam ompö tawu ECHOTYON, kïrïp kegh nko otöpto kwanta pöytoghin Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.3",
            "verseOrgIds": [
              "2KI.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.9"
              },
              "items": [
                {
                  "text": "Kiy 21:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyar wölo kïsogho körkeyïntin akurultö pchörin akuriy körkeyïntin cho pö tororöt nyo kikuro Asyera* nyo le korka akïtörotör moroy nyo pö taghoy nyo kigh Musa nyo kikuro Neustan, ompöwölo kitökïpelchini pipö Israel amörostin osiswechoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.4",
            "verseOrgIds": [
              "2KI.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kighan Esekia ECHOTYON Tororöt pö Israel amelö kinyorï pipö Yuda ngat pöytoghinte anka nyo karkegh nko nyinte ompö cho kimi tawunyi anta cho kirïpï nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.5",
            "verseOrgIds": [
              "2KI.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kighan nyinte ECHOTYON ompö mïkulöwunyi kïmïkul, melö kipeny ngalechi. Kirïp nyinte kirurut pö ECHOTYON löwïr cho kimwochï Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.6",
            "verseOrgIds": [
              "2KI.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kimi ECHOTYON nko nyinte akusoyön nyinte ompö kïgh anka tïkwïl nyo kigh. Kipeny nyinte ngala pöytoghinto Asirya akïtagh kïpöghisyechï. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.7",
            "verseOrgIds": [
              "2KI.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïporyeghö pipö Pilisti akïrïnta akupokyï kanastinekwa cho mïnkech nko cho echön, kïmi nko Kasa nko koros cho lekïtöch.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.8",
            "verseOrgIds": [
              "2KI.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.8",
            "verseOrgIds": [
              "2KI.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipokyï Syalmaneser pöytoghinto Asirya kanasyanta Samaria akurich ompö könyi angwan nyo pö paytaghpa Esekia, aki könyi mut nko odeny nyo pö Osyea pöytoghinto Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.9",
            "verseOrgIds": [
              "2KI.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnam nyu chane kanasyantanoni ompö sörömu könyi sömök. Ki könyi mut nko akonga nyoni nyo pö paytaghpa Esekia, aki könyi mut nko angwan nyo pö Osyea pöytoghinto Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.10",
            "verseOrgIds": [
              "2KI.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrang pöytoghinto Asirya pipö Israel kutang koro Asirya akutö walaka kïmang kanasyanta Ala, kïmang walaka lalwa Apor ompö Koro Kosan kutö walaka kïmang kanastina pipö Mede.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.11",
            "verseOrgIds": [
              "2KI.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.11",
            "verseOrgIds": [
              "2KI.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïnam kanasyanta Samaria ompöwölo kitagh pipö Israel kïrïp muma* ECHOTYON Tororötïngwa, ata cho kimwochï Musa, mötworinto ECHOTYON chane, melö kilïm anta terchï.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.12",
            "verseOrgIds": [
              "2KI.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kyotyeghö pipö Asirya Yerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.12",
            "verseOrgIds": [
              "2KI.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupokyï Senakerip pöytoghinto Asirya kanastina Yuda löwïr cho kikïtekyï nöyet akïrïnta ompö könyi taman nko angwan nyo pö paytaghpa Esekia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.13",
            "verseOrgIds": [
              "2KI.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta Esekia pöyoghinto Yuda kut wölo mi pöytoghinto Asirya ompö Lakis akïlenchï, “Kalelan, kaykay meporyeghö piköchan, atokonïn kïgh anka tïkwïl nyo imökenyi.” Kuyokyï pöytoghintonay Esekia lö, “Omökan konunenyi kilen 10,000 cho pö silpa nko kilen 1,000 cho pö koltin.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.14",
            "verseOrgIds": [
              "2KI.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïghamït Esekia silpa löwïr cho ki mi Kö pö Tororöt* nko cho ki mi kaplawach pö konyi nyo pö paytagh ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.15",
            "verseOrgIds": [
              "2KI.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "akungetunö kukoti Kö pö Tororöt koltine walaka cho kimina nyinte kukot wölo le yïm akutö pöytoghinto Asirya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.16",
            "verseOrgIds": [
              "2KI.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyonta pöytoghintonay pö Asirya Tartan nko Rapsaris nko Rapsyake nko lïk nyo wow ompö Lakis, kïpa kïporyö nko Esekia ompö Yerusalem, kintöghoghchini chane lïkononi. Nyini kitïta chane Yerusalem, kughyongö ara pögh nyo kingwïno ngarpïl nyo kimi wölo to, ompö ara mït nyo wetöy kutöngöy wölo kiwuno ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.17",
            "verseOrgIds": [
              "2KI.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïyonta kintöghoghichay pich kïkurï pöytoghin Esekia, kïpka pich sömökï kïtaroch chane. Elyakim wero Ilkia nyo kighyongchini ka pöytoghin nko Syepna nyo kile kikirinto ngal nko Yoa wero Asap nyo kile kikirinto tïkwïn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.18",
            "verseOrgIds": [
              "2KI.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.18",
            "verseOrgIds": [
              "2KI.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Rapsyake chane, “Olenchinö Esekia, kölö pöytoghinto Asirya nyo wow, kïgh ne nyï itwoytonyi kegh?” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.19",
            "verseOrgIds": [
              "2KI.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulet tagh lö, “Ilentenyi so ngal kwïle cho setöy lïk akïkonï chïreryö nko owesyö? Ngo nyini itwoytonyi kegh lö ngörokokwa otï kepenyanyi pöytoghinto Asirya nya? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.20",
            "verseOrgIds": [
              "2KI.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrkegh ilentenyi otwoytoy kegh koro Misri, wölo karkegh nyona nko chi nyo tökönöy mochön nyo mïro akïchak ewunyi. Lata nyoni Parao, pöytoghinto Misri ompö pich cho twoytoy kegh nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.21",
            "verseOrgIds": [
              "2KI.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.21",
            "verseOrgIds": [
              "2KI.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo ato olenchanïkwa, ‘Kitwoytocha kegh ECHOTYON Tororötïnyo!’ Memukonye ompöwölo kinyar Esekia ato kïpelo amöros nko wölo kïsogho körkeyïntin akïlenchï pipö Yuda nko cho pö Yerusalem asaghena ato kïpelo amöros nyo mi Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.22",
            "verseOrgIds": [
              "2KI.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona nyonö chomnyenö nko echotyontenyan pöytoghinto Asirya. Okoninyi angoletin 2,000 ato itïngetenyi pich cho teno choni cho pegho! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.23",
            "verseOrgIds": [
              "2KI.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imukenyi lö ne nyu nteyon ompö yetïn nyo mïnïng ompö mötwori echotyontenyan akwanyï itwoytonyi kegh koro Misri ompö nkarinechi nko pipö angoletin? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.24",
            "verseOrgIds": [
              "2KI.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilentenyi so koporyeghan korenkwa anyar amengarakanïn ECHOTYON? Ki ECHOTYON nyini kimwowanïn oporyeghö koronete anyar!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.25",
            "verseOrgIds": [
              "2KI.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.25",
            "verseOrgIds": [
              "2KI.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchï Elyakim wero Ilkia nko Syepna nko Yoa Rapsyake, yetïnay pö Asirya, “Kaykay ngölonwecha mötworiku ompö ngala Aram, mengölonwecha ngala pipö Yuda, tömalïm pïchï löwïr mi nayat.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.26",
            "verseOrgIds": [
              "2KI.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.26",
            "verseOrgIds": [
              "2KI.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïmwöchï Rapsyake chane lö, “Olentekwa so akwa nko pöytoghintenkwa opïn cho köyonwanïn pöytoghintenyu angwïn omwochï ngalechï? Ewo, kangwïnan atangalan nko pïchona mpuröy nayat tïkwïl, pich cho tomönye kite kwam sïkökökwa akïgha sikörorikwa nko akwa tïkwïl.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.27",
            "verseOrgIds": [
              "2KI.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.27",
            "verseOrgIds": [
              "2KI.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kughyö Rapsyake akutegh ompö kuti pipö Yuda lö, “Atera ngala aryang, pöytoghinto Asirya! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.28",
            "verseOrgIds": [
              "2KI.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karirwakwa nyinte lö makany kïlïsak Esekia, memukönye ntökïsörwokwa ompö morichan. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.29",
            "verseOrgIds": [
              "2KI.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakany kïlïsak lö ngörokokwa ECHOTYON. Molenchï kegh sörwokwa ECHOTYON, amokön lö yodoy lïko Asirya manam kanasyantengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.30",
            "verseOrgIds": [
              "2KI.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mater ngala Esekia, lentöy pöytoghinto Asirya apkana ama mis nko ani. Atonyorunö pöroyïn nyo omo akwekwo pö sapipun nko cho pö makanykökwo aghegh pögho koriko pöghonikwo, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.31",
            "verseOrgIds": [
              "2KI.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntökïtenö kuporwokwa pöytoghintö kore anka nyo karkegh nko korenkwa, kor nyo mi pagh nko dipay* nko makatin nko keti arol nko kumot. Atomöngisyenökwa kokay puryö meghat. Wölo makany kïlïsakwa Esekia lö sörwokwa ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.32",
            "verseOrgIds": [
              "2KI.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi so tororöt ompö akong nyo pö punton nyo kisörunö pikachi mori pöytoghinto Asirya? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.33",
            "verseOrgIds": [
              "2KI.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi onö tororöt pö Amat nko Arpad? Akï mi onö tororöt pö Separpaim nko nyo pö Ena nko nyo pö Ipa? Mi nyo kimï kïsörunö Samaria morichanï? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.34",
            "verseOrgIds": [
              "2KI.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyï ato kimï tororöt nyo le ompö akonga nyo pö puntonichoni ntökïsörunö pikachi pöytoghintencha? Kïne nyo ighokwa anana lö söruno ECHOTYON Yerusalem morichan?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsisyö pïchay lasay lenyini kimwochï pöytoghin Esekia nyo kökimwochï chane. Melö kiwöghökwï ngölyon nyo le ompö akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
            "verseOrgIds": [
              "2KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkarer sïrokökwa Elyakim wero Ilkia nko Syepna nko Yoa ompö nyarïl akïpa wölo mi pöytoghintö Esekia akïmwochï nyinte ngalechay pö Rapsyake, wowïnay pö Asirya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.37",
            "verseOrgIds": [
              "2KI.18.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Katep pöytoghintö Isaya kingörokut",
          "type": "text"
        }
      ]
    }
