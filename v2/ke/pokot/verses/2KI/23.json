        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur pöytoghintö Yosia kintöghoghi Yuda nko cho pö Yerusalem, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.1",
            "verseOrgIds": [
              "2KI.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïwö kïpusta nko chane kutang Kö pö Tororöt,* kimi nko tïsï nko werkoy nko pikö walaka löwïr, cho pö Yuda nko cho pö Yerusalem, cho mïnkech nko cho echön. Atolapay kusomönö tawungwa löwïr ngal cho kikikir kitapunay pö muma* kikïnyorchï Kö pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kighyongo pöytoghintö atolekïto pchörï akwam muma ompö tawu ECHOTYON lö, orïpöy ECHOTYON arip kirurutkachi löwïr ompö mïkulöwunyi kïmïkul nko söpontanyi kïmïkul, akïcham kïrïp ngal löwïr cho kikikir kitapunoni pö muma. Kïcham pïchoni löwïr kïrip mumanoni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
