              },
              "items": [
                {
                  "text": "2Ot 33:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïmwochï Yosia Ilkia Tïsin nyo Wow* nko tïsï walaka cho mïnkech nko pich cho kiripöy kuka Kö pö Tororöt, kuritunö karïn Kö pö Tororöt cho kikighchï Paal* nko Asyera* nko töpogh akïpel tïkuchoni löwïr ompö sanypa kanasyan atolekïtö mpöghoghyo Kidron akïghamït areni akwip kutang Petel. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïyon tïsï löwïr cho kikïl pöytoghi Yuda atökïpelchï körostin ompö wölo kïsogho körkeyïntin kanastina Yuda nko woptine walaka cho lekïto Yerusalem nko cho kipelchï Paal köröstin nko asis nko arawa nko töpogh. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.5",
            "verseOrgIds": [
              "2KI.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïsïtunö Asyera Kö pö Tororöt ompö Yerusalem ntökwit mpöghoghyo Kidron akïpela wölini akïghamït areni akïlösyï wölo kïtïpchini pich kïtïkon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akurul korïn cho kimi cheporestin ompö Kö pö Tororöt ki atoni wölo kinöpo korï sïro cho koghöch cho kikïkörtegho Asyera. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kumïtï tïsï löwïr cho kimi kanastina Yuda akusïmnyon wölo kïsogho körkeyïntin kïngata Kepa ntökwit Persyepa. Kunyar wölo kïsogho körkeyïntin cho kimi kukoti kanasyan cho pö kuka Yoswö nyo kipöytoy kanasyante, nyo kimi okumpö löt ompö kuka kanasyan. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.8",
            "verseOrgIds": [
              "2KI.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kichömchï tïsichoni kïpka Kö pö Tororöt, wölo kikitö kwam makatin cho puryö mumar nko werkökwa cho le tïsï.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        }
      ]
    },
