        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö pöytoghintö Aasia nko pöytoghin Yoram nyo pö Israel kïporyeghö Asael pöytoghinto Sirya ompö ato kïkuro Ramot Kiliad, kekotön Yoram ompö atoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
            "verseOrgIds": [
              "2KI.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïmïla pöytoghin Yoram kanasyanta Yesrel atökïsarar moyokachi chay kikotön pipö Sirya ompö Rama otini kiporyot nko Asael pöytoghinto Sirya. Kïwö Aasia wero Yeoram pöyoghinto Yuda, kura nyinte otini kikasate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakïkïl Yeu kïlïkwï pöytoghinto Israel",
          "type": "text"
        }
      ]
    }
