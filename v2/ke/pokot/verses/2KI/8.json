              },
              "items": [
                {
                  "text": "1Pöy 11:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kicham ECHOTYON kunyar Yuda akwompö mötworintenyi Daudi, ompöwölo kiyomis lö lïku nyinte nko monechi pöytoghï kokay.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.19",
            "verseOrgIds": [
              "2KI.8.19"
            ]
          }
        }
      ]
    },
