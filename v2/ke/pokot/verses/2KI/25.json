                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.24.2"
              },
              "items": [
                {
                  "text": "Esk 24:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingwïn Nepukadnesa nko pikachi löwïr cho pö lïk atökïporyeghö Yerusalem asis nyo pö taman nyo pö arawa taman nyo pö könyi mut nko angwan nyo pö paytaghpa Sedekia. Kurich kanasyantanay kuwit akïtek nayat nyo kïghïpo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.1",
            "verseOrgIds": [
              "2KI.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurich nyu kanasyantanoni ntökwit könyi taman nko akonga nyo pö paytaghpa Sedekia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.2",
            "verseOrgIds": [
              "2KI.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kitïta asispa mut nko angwan nyo pö arawa angwan kïngwanit kömöy lakat. Melö kitökïmi kïgh nyonikïny nyo kingötï nyo kikyomöy. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.3",
            "verseOrgIds": [
              "2KI.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.21"
              },
              "items": [
                {
                  "text": "Esk 33:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngany pïchay nayatu kanasyantengwa, kïrkegh kimi pipö Papilonia kuriköy chane. Kuperta pöytoghintö nko piko lïk löwïr oghökwen, kipa akuwer or nyo kikwen nïyetwo odeny nyo lekïto para pöytoghin akupertoy kutang mpöghoghyo Arapa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.4",
            "verseOrgIds": [
              "2KI.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïrïp pipö lïko Papilonia pöytoghin Sedekia ntökïnömchï mpöghogh nyo lekïto Yeriko, kïtoyö piko lïkenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.5",
            "verseOrgIds": [
              "2KI.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenam Sedekia akemït wölo mi pöytoghinto Papilon ompö kanasyanta Ripla. Kurwokyineghö Nepukadnesa nyinte wöloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.6",
            "verseOrgIds": [
              "2KI.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.13"
              },
              "items": [
                {
                  "text": "Esk 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepar werpö Sedekia kïsïwïyi nyinte akeködötï konyichi akerata nyinte sïrïmtin akemït kïwö Papilon.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kinyarata Kö pö Tororöt*",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlït Nepusaradan nyo kiwowö pipö lïk kanasyanta Yerusalem, arawa mut nko odeny könyi 19 nyo pö paytaghpa Nepukadnesa nyo pö Papilon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.8",
            "verseOrgIds": [
              "2KI.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïpel Kö pö Tororöt nko kö pö pöytoghin nko korïn löwïr cho pö Yerusalem nko kö anka tïkwïl nyo ki wow. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.9",
            "verseOrgIds": [
              "2KI.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïngany nïyetwo kanasyanta Yerusalem lïko Papilonia nyo kighyongchini ripinto pöytoghin. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.10",
            "verseOrgIds": [
              "2KI.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrang Nepusaradan pich cho kidong kanasyantanay nko söpïch pö pich cho le tïngon nko cho kökikupertegho pöytoghinto Papilon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.11",
            "verseOrgIds": [
              "2KI.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kipïstö pich ompö Yuda cho le mey atökumï kïrip pareni sapipun akïngor.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.12",
            "verseOrgIds": [
              "2KI.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
