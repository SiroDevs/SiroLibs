      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitor Yeoaas wero Yeu kïpayta Israel ompö Samaria, könyi 23 nyo pö paytaghpa Yoas wero Aasia pöytoghinto Yuda. Kipayta nyinte könyis 17. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.1",
            "verseOrgIds": [
              "2KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh nyinte ngokï ompö tawu ECHOTYON le pöytoghin Yeropoam wero Nepat nyo kigh pipö Israel kwigh ngokï, kimöpïstönye ortïnechi cho ghach. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
              "2KI.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïnörekyï ECHOTYON Israel, akïpïsyï Asael pöytoghinto Sirya nko werïnyi Pen Adad kïrïnta Israel kïnomnyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.3",
            "verseOrgIds": [
              "2KI.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsagh Yeoaas ECHOTYON, kïterchï ECHOTYON nyinte ompöwölo kisïwa nyarïlpa pipö Israel wölo kichopta kong pöytoghinto Sirya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kutö ECHOTYON pipö Israel yetïn nyo kisörunö chane pipö Sirya, kïmang nyu pipö Israel korengwa le tagh. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.5",
            "verseOrgIds": [
              "2KI.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kipïstö chane ngokï cho kigh pöytoghintö Yeropoam nyo kigh pipö Israel kwigh ngokï, wölo kitas tagh kïsagh tororöt Asyera* nyo le korka nyo kimi Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.6",
            "verseOrgIds": [
              "2KI.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.6",
            "verseOrgIds": [
              "2KI.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kitökïtïng Yeoaas pipö lïk cho kingötï, kïpoto pipö angoletin 50 nko nkaritin nko pich 10,000 cho kipegho kelyon, ompöwölo kökikïpar pöytoghinto Sirya walaka, akïtïkatïk le terïtyon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.7",
            "verseOrgIds": [
              "2KI.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirote ighisyewut löwïr cho kigh pöytoghintö Yeoaas nko owesyenyi kitapu Otöptino pöytoghi Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.8",
            "verseOrgIds": [
              "2KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïma aketïpchï Samaria, kuker werïnyi Yoas kïpayta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.9",
            "verseOrgIds": [
              "2KI.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pöytoghin Yeoas nyo pö Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.9",
            "verseOrgIds": [
              "2KI.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö könyi 37 nyo pö paytaghpa Yoas pöytoghinto Yuda, kilïkwï Yeoas wero Yeoaas pöytoghinto Israel ompö Samaria akïpayta könyis 16. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.10",
            "verseOrgIds": [
              "2KI.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh nyinte tïkwïl ngokï ompö tawu ECHOTYON akïrïp otöp nyo gha nyo kipö pöytoghin Yeropoam nyo kigh pipö Israel kwigh ngokï. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.11",
            "verseOrgIds": [
              "2KI.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirote ighisyewut löwïr cho kigh pöytoghintö Yeoas nko owesyenyi nyo kiporyeghö Amasya pöytoghinto Yuda kitapu Otöptino pöytoghi Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.12",
            "verseOrgIds": [
              "2KI.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïma Yeoas, ketïpchï pïrïmpoti pöytoghï ompö Samaria, kuker werïnyi Yeropoam kïpayta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.13",
            "verseOrgIds": [
              "2KI.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Megha Elisya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.13",
