              "type": "text"
            }
          ]
        },
        {
          "text": "Kikwagha surï pöytoghintö Aasuero piko pöyunötenyi kïmïkul cho kimöngöy kor wölo tïyame nko koros cho kiwit pögh. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikikir ngal löwïr cho pö töngönchin cho kigh nyinte nko lökoye walaka löwïr kitapu pöytoghi Pasya nko Mede cho poru wölo kitotegha nyinte Mordekay kïyetï akekonyït nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyetï Mordekay, chi pö Yaudi, ntökïlïkwï nyo pö odeny ompö paytaghpa Aasuero. Kikïkonyït nyinte tya akïsïch chömchin ompö pikachi, pipö Yaudi, ompöwölo kighchï chane nyo karam atökïtïpï pikökwa löwïr ompö kalya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
