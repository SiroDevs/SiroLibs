  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "EST 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kitïta asispa taman nko sömök nyo pö arawa taman nko odeny, nyoni kï arawa Adar,* asis nyo kikipuntoy ngölyonto pöytoghin nko kiyomisötenyi, asis nyo kinonöy pung pö pipö Yaudi lö kitöni chane morikwa, wölo nyinö kitölïku nyoni kïnyorï rïntagh pipö Yaudi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.1",
            "verseOrgIds": [
              "EST.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutuyö kegh pipö Yaudi ompö kanastinekwa ompö koros löwïr cho pö pöytoghin Aasuero atökïporyeghö pungkökwa cho kimököy kuwongöy chane. Melö kimi chi nyo kilentöy omukyini oporyegho chane, ompöwölo kikiwagh chane löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.2",
            "verseOrgIds": [
              "EST.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungarak nyu pipö Yaudi echot pö koros löwïr nko kintöghoghï nko pröyöntinekwa nko chane tïkwïl cho kighöy ighisyo pöytoghin, ompöwölo kiwagh chane Mordekay. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.3",
            "verseOrgIds": [
              "EST.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki wow Mordekay akïghömï ororyenyi kore kïmïkul akimi kwowesitu ompö ka pöytoghin. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.4",
            "verseOrgIds": [
              "EST.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpar nyu pipö Yaudi pungkökwa löwïr ompö chokon, kipar akunyar chane akwighchï le wölo kimöktoy.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.5",
            "verseOrgIds": [
              "EST.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.5",
            "verseOrgIds": [
              "EST.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipar pipö Yaudi pich 500 ompö Susa ori kanasyan nyo wow. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.6",
            "verseOrgIds": [
              "EST.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi pïchoni kikïpar werpö Aman wero Amet cho kile taman, chi nyo kile punyonto pipö Yaudi. Atolapay kepar Parsyandata nko Dalpon nko Aspata nko Porata nko Adaliya nko Aridate nko Parmasta nko Arisay nko Ariday nko Paisata. Wölo melö kirit pipö Yaudi tïkuko pïchoni.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.7+EST.9.8+EST.9.9+EST.9.10",
            "verseOrgIds": [
              "EST.9.7",
              "EST.9.8",
              "EST.9.9",
              "EST.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.7+EST.9.8+EST.9.9+EST.9.10",
            "verseOrgIds": [
              "EST.9.7",
              "EST.9.8",
              "EST.9.9",
              "EST.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïmwochï nyu pöytoghin asisoni pich cho teno cho kikïpar ompö kanasyanta Susa. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.11",
            "verseOrgIds": [
              "EST.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlechï nyu pöytoghintö Esta, “Kapar pipö Yaudi pich 500 ompö kanasyanta Susa onkït, kïmi nko werpö Aman taman. Ekïtya nyu köny cho kakïpara koroskö walaka! Tesomenyi ne ye ngat? Kïkoninyi, mwowante kïgh nyo tesomenyi ngat atökekonïn.”",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.12",
            "verseOrgIds": [
              "EST.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.12",
            "verseOrgIds": [
              "EST.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Esta nyinte lö, “Ato ichömenyi, we pöytoghin ikany kwigh ngat pipö Yaudi cho mi Susa asïyech lenyini kikikechömchï chane kwigh asisete. Aimwatïta kewusö porwöyi werpö Aman taman ketay kiwuso pich.” ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.13",
            "verseOrgIds": [
              "EST.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwatïta pöytoghintö kegh lenyini ompö Susa, akewudochï porwöyi werpö Aman taman ket ompö tawu pich. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.14",
            "verseOrgIds": [
              "EST.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïghamït kegh pipö Yaudi cho kimi Susa ngat ompö asispa taman nko angwan arawa Adar akïpar pikö walaka 300 ompö kanasyanta Susa. Wölo melö kirit chane tïkuko pïchoni.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.15",
            "verseOrgIds": [
              "EST.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.15",
            "verseOrgIds": [
              "EST.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïghamït kegh pipö Yaudi ngat cho kimi koros atökïghet kegh, kïpar pungkökwa pich 75,000 cho kireyöy chane. Kumuny nyu, wölo melö kirit chane tïkuko pïchoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.16",
            "verseOrgIds": [
              "EST.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki asispa taman nko sömök nyoni nyo pö arawa Adar. Atolapay kumuny chan asispa taman nko angwan nyo pö arawanoni, melö kitökïpörisyö chane ngat, kwigh nyu asisoni asispa akor nko ngörekyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.17",
            "verseOrgIds": [
              "EST.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kwigh pipö Yaudi cho kimi Susa asispa taman nko mut kïlïkwï asispa kimïny, ompöwölo kipar chane pungkökwa asispa taman nko sömök nko taman nko angwan atolapay kumuny asispa taman nko mut. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.18",
            "verseOrgIds": [
              "EST.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyoni tökwighöy pipö Yaudi cho möngöy kanastin cho mïnkech asispa taman nko angwan arawa Adar kïlïkwï asispa kimïny nyo kïngörekyegho akyomöy akor kitöni kegh ropöwo omisyewut.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ichon pö Purim",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukir Mordekay ngalechoni akutö palaltin pipö Yaudi löwïr cho kimöngöy koros pö pöytoghin kïmïkul, cho lekïtöch nko cho lowöch, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.20",
            "verseOrgIds": [
              "EST.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïmwochï chane kïrip kïlïkwï osiswo kimïny asispa taman nko angwan nko asispa taman nko mut nyo pö arawa Adar ompö köny anka tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.21",
            "verseOrgIds": [
              "EST.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osiswechoni cho kityaka kegh pipö Yaudi pungkökwa aki arawanoni nyo kikïwaghach kïlïkwï ngörekyö kïngetunö rirat kïlïkwï asispa ororyö. Kikïmwochï chane kwigh osiswechoni kïlïkwï osiswo akortin nko ngörekyö, cho kïropchini kegh ropöwo omisyewut akeropchï mey. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.22",
            "verseOrgIds": [
              "EST.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EST 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kulet tagh pipö Yaudi könyis löwïr kïrïp akortinechoni kitor chane kïrïp kegh nko wölini kikirchï Mordekay chane.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.23",
            "verseOrgIds": [
              "EST.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EST 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.23",
            "verseOrgIds": [
              "EST.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EST 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikikïnya Aman wero Amedata nyo pö ara Akak kïngor ompö wirtaghpa söker cho kikïkuro “Purim,” tökenkïtï lö asis ne nyo kiwongöy pipö Yaudi. Kökikunan nyinte lö owongöy chane lömïs, akökikïngor ompö ara söker lö kiwongöy chane. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.24",
            "verseOrgIds": [
              "EST.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EST 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo otini kinkïtï pöytoghintö ngaleko wökononi, kukirta palalyan nyo kikar rïmononi gha ompö pipö Yaudi kimwowï Aman akïmwatïta kewudochï Aman ket nko werkachi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.25",
            "verseOrgIds": [
              "EST.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EST 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkurö chane osiswechoni pö Ichon pö Purim, kïrïp kegh nko wölo kikirta Mordekay nko ompö tïkwïn löwïr cho kighisyö ompö kwenungwa. Kwigh nyu pipö Yaudi kïlïkwï otöp nyo rïpöy chane nko monekwa anta chi kïnye anka tïkwïl nyo kacham kïlïkwï pipö Yaudi, lö ato itïta atoni ompö köny anka tïkwïl, kelowitöy osiswechoni kwodeny kïrïp kegh nko kirurut pö Mordekay. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.26+EST.9.27",
            "verseOrgIds": [
              "EST.9.26",
              "EST.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EST 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïchomnyechï nyu atoni lö mïchini kunan chi pö Yaudi anka tïkwïl nko konyi ompö pïnwöy löwïr osiswechoni pö Purim ompö koros nko kanastin löwïr amöwutyeghö pipö Yaudi nko monekwa kokay.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.28",
            "verseOrgIds": [
              "EST.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EST 9:28"
          },
          "items": [
