              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kiyon Manase pich cho kimöngöy kanastina Pet Syan nko Tanak nko Dor nko Ipleam nko Mekido nko kanastinekwa cho mïnkech, ompöwölo kitas tagh pipö Kanan kïmang korononi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.27",
            "verseOrgIds": [
              "JDG.1.27"
            ]
          }
        },
