            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kisïch Israel owesyö, kutö pipö Kanan kwigh ighisyo sekeynön wölo melö kiyon chane.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
