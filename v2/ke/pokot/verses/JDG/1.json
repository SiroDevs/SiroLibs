            "number": "26",
            "style": "v",
            "sid": "JDG 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö chichay kutang koro pipö Ititi kïtek kanasyan, kïkurö kayneto kanasyantanoni Lus. Kïlïkwï nyoni kaynatenyi nko nyete le ye.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.26",
            "verseOrgIds": [
              "JDG.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pich cho melö kiyon pipö Israel",
          "type": "text"
        }
      ]
    },
    {
