          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuporchï nyu nyinte chane or nyo lïtöy kanasyan. Kïpar pïchoni pö Epraim nko cho pö Manase piko kanasyantanoni löwïr, kïpoto chichay nko piko konyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.25",
            "verseOrgIds": [
              "JDG.1.25"
            ]
          }
        },
        {
          "name": "verse",
