        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achï nyu punton cho kipïsyï ECHOTYON korononi atö kïtyama pipö Israel cho kitomöcha kunkïtï poryot anka tïkwïl ompö koro Kanan. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.1",
            "verseOrgIds": [
              "JDG.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh lenyoni atö kumï kunet pïnwöy löwïr cho pö Israel cho pkonöy wölo kïporyeghtoy ntökïmïr tya pich cho kitomöcha kïset lïk. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.2",
            "verseOrgIds": [
              "JDG.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achï puntonichoni: pöytoghï mut cho pö pipö Pilisti nko pipö Kanan löwïr nko pipö Sidon kïmi nko pipö Ipiti cho kimöngöy kutïngkoti Lepanon, kïngeta kutïng pö Paal Ermon ntökwit Adoketpa Amat. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.3",
            "verseOrgIds": [
              "JDG.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpïstö pïchoni atö ketyam pipö Israel ompö chane, atö kumï kunkïtï lö ekïrïpöy kirurut pö ECHOTYON cho kimwochï papotïnekwa kuwerï Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.4",
            "verseOrgIds": [
              "JDG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.4",
            "verseOrgIds": [
              "JDG.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïmang pipö Israel nko pipö Kanan nko Ititi nko Amori nko Peris nko Ipiti nko Yepusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.5",
            "verseOrgIds": [
              "JDG.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwip tipiko pïchoni akuyilchï tipikwa werko pïchoni akïpöghisyechï tororötinekwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.6",
            "verseOrgIds": [
              "JDG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Otniel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.6",
            "verseOrgIds": [
              "JDG.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh pipö Israel ngokï ompö tawu ECHOTYON kïwutyeghö ECHOTYON Tororötïngwa, otini kisagh körkeyïntino Paal* nko Asyera.* ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.7",
            "verseOrgIds": [
              "JDG.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona kïngwanit nörekyo ECHOTYON lö kat ompö pipö Israel, akwigh chane kerïnta kïpöghisyechï pipö Israel Kusyan Risyataim pöytoghinto Mesopotamia könyis mut nko sömök. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.8",
            "verseOrgIds": [
              "JDG.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo otini kirirchï pipö Israel ECHOTYON kïkïl nyinte chi nyo kisörï chane, chichoni kï Otniel wero Kenas, werto ompö Kalep nyo mïnïng. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.9",
            "verseOrgIds": [
              "JDG.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïnchï Mïkulöwu ECHOTYON nyinte, akurwokyï pipö Israel akïset lïk, kutö ECHOTYON Kusyan Risyataim pöytoghinto Mesopotamia morichi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.10",
            "verseOrgIds": [
              "JDG.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnyorï korononi kalya könyis tömönut angwan, atolapay kïrapas Otniel wero Kenas.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.11",
            "verseOrgIds": [
              "JDG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eud",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.11",
            "verseOrgIds": [
              "JDG.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigh pipö Israel ngokï ngat ompö tawu ECHOTYON. Kïlenyona kutö ECHOTYON Eklon pöytoghinto Moap owesyö kïrïnta pipö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.12",
            "verseOrgIds": [
              "JDG.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutuyö Eklon pipö Amon nko pipö Amalek kïporyeghö Israel, akïnam Yeriko, kanasyanta sos. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.13",
            "verseOrgIds": [
              "JDG.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpöghisyechï pipö Israel Eklon pöytoghinto Moap könyis 18.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.14",
            "verseOrgIds": [
              "JDG.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.14",
            "verseOrgIds": [
              "JDG.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo otini kirirchï pipö Israel ECHOTYON, kïkïl nyinte chi nyo kisörï chane, chichoni kï Eud wero Kera nyo pö pipö Penchamen, chi nyo wachele. Kïyonta pipö Israel nyinte kwipchï Eklon pöytoghinto Moap ropöw. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.15",
            "verseOrgIds": [
              "JDG.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwighchï kegh Eud chok nyo ngatip wop tïkwïl nyo tenö koghïntanyi egh kïngata tököghögh, akïrötyï kïpestanyi nyo pö tagh akuyenö sïrenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.16",
            "verseOrgIds": [
              "JDG.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonkoghchï ropöwontonay Eklon pöytoghinto Moap, aki chi nyo narate nyoman Eklon. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.17",
            "verseOrgIds": [
              "JDG.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany kutötö Eud ropöwontonay, kiyomisöto pïchay kipu ropöwontononi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.18",
            "verseOrgIds": [
              "JDG.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïmïlegha nyinte wölini kimito körkeyïntinö ompö wölini le Kilkal, akïlenchï Eklon, “Otïngetan ngölyon nyo pö wïnyat nyo omwowunyi, we pöytoghin.” Kïlenchï pöytoghintonay mötworichi, “Osisyenö.” Kïnget pïchay löwïr.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.19",
            "verseOrgIds": [
              "JDG.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.19",
            "verseOrgIds": [
              "JDG.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Eud kïrich nyinte ompö otini kimpuröy onkït konyi nyo mi parak nyo kaghït akïlenchï, “Kökonanïn Tororöt ngölyon nyo le nyengu.” Kïngeta pöytoghintonay ngacharunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.20",
            "verseOrgIds": [
              "JDG.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingwïsuna Eud ewunyi löt chokonay mi kïpesunyi pö okumpö tagh, akïrït pöytoghintonay mu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.21",
            "verseOrgIds": [
              "JDG.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlït chokonay muyenyi nko otini nömöy ewï, melö kitökïngwïs Eud chokonay ompöwölo kiyentö sunet, kïnyïrïtu kwan. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.22",
            "verseOrgIds": [
              "JDG.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïwö Eud kïlït sany akïkörchï nyinte kö. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.23",
            "verseOrgIds": [
              "JDG.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany nyini köwö nyinte kïlït sany, kïpka mötwori pöytoghintonay, kïlö kitomï kikïkar kukoti köyay, kïlenchï kegh töptoy mi kungöroköy kegh ompö kö nyo pö ori. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.24",
            "verseOrgIds": [
              "JDG.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïköngisyö nyo kogh, wölo otini kimökïyatnye kukat, kïchengwï chane yotöwon akïyat. Kïlö kiros rïwöy echotyontengwa ngwïny kikïma.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.25",
            "verseOrgIds": [
              "JDG.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.25",
            "verseOrgIds": [
              "JDG.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurïp Eud otini kimi mötworichay kïköngisïyi, kuwerata wölay kimi körkeyïntinö akurïpchï wölnö le Seira. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.26",
            "verseOrgIds": [
              "JDG.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kitïta wölini kukik ompö komoswo pipö Epraim, kïpka pipö Israel kïrökunö komos nko nyinte, akimi kuntöghoghchini chane. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.27",
            "verseOrgIds": [
              "JDG.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï pïchay, “Arïpkanïn, ompöwölo kikutö ECHOTYON pungkökwa pipö Moap morikwa.” Kïlenyona kïrökï nyinte, kïpa akïnam ato kyoghyegho pipö Moap lalwa Yordan, akimöpïsyïcha ompö chi nyo le akonga kwoghyö. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.28",
            "verseOrgIds": [
              "JDG.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpar chane asisoni pipö Moap cho owesöch cho ngata 10,000 akimachïwïtnye nyo le ompö akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.29",
            "verseOrgIds": [
              "JDG.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpayta nyu asisoni pipö Israel koro Moap. Kïnyorï korononi kalya könyis 80.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.30",
            "verseOrgIds": [
              "JDG.3.30"
            ]
          }
        }
      ]
    },
