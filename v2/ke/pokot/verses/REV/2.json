              "items": [
                {
                  "text": "Krt 23:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wölo mi ngala tïkwïte cho otïngetan ompö nyi mi pich kwenunkwa cho rïpöy kinetut pö Palaam nyo kinet Palak kïkïnkïn pipö Israel kwigh ngokï kwam omisyewut cho kikïropchï körkeyïntin, akunet chane kwigh cheporesnan. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.14",
            "verseOrgIds": [
              "REV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona tïkwïl, imitenyi nko pich cho rïpöy kinetut pö Nikolaytin. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
              "REV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kötenö ngokiku! Wölo ato mekötenyinye lenyoni, otunan lawel wöloni imitenyi atoporyan nko pïchoni ompö chok nyo ngwïno kutinyan.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.16",
            "verseOrgIds": [
              "REV.2.16"
            ]
          }
        }
      ]
    },
