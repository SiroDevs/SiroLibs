                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Opöran pich löwïr cho le rïpankachi atökunkïtï kanisen löwïr lö onkïtön kinonut pö pich löwïr nko mïkuliskökwa. Oghokyinan chi anka tïkwïl ompö chane kïrïp kegh nko ighisyewukachi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.23",
            "verseOrgIds": [
              "REV.2.23"
            ]
          }
        }
