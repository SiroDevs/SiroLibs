                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kirchinö malaykayanta kanisa Smurna lö, ‘Anyï ngölyon nyo ngwïno nyinte nyo pö tagh akï pö löt, Alpa nko Omeka nyo kima akïsöpöy ngat. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
            "verseOrgIds": [
              "REV.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onkïtön nyörilwokökwa nko chopatengu, wölo ichinyi sïkön, ankïtön ngalechoni ghach ngöloneninyi pich cho lentöy kïchï pipö Yaudi amenkacha, pö chane Onyöt! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.9",
            "verseOrgIds": [
              "REV.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meway kïgh nyonikïny nyo mach kwipunyi nyarïl. Rosa! Työmokwa Onyötö akïtorchokwa chela, akechopokwa kong osis taman. Alïkwï cho ghönote ompö ani, kïrkegh meghe, ato konok tenta söpon. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.10",
            "verseOrgIds": [
              "REV.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.14"
              },
              "items": [
                {
                  "text": "Ngo 20:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.8"
              },
              "items": [
                {
                  "text": "21:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato itïng chi yitïn, ilïm ngal cho mwochini Mïkulögh kanisen! Melö nyoru ngwonïn pö megha odeny pich cho rïntoghisïyi.’",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.11",
            "verseOrgIds": [
              "REV.2.11"
            ]
          }
        }
      ]
    },
