          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kirchinö malaykayanta kanisa Perkamo lö, ‘Anyï ngölyon nyo ngwïno nyinte nyo tïng chok nyo ngatip wop tïkwïl.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.12",
            "verseOrgIds": [
              "REV.2.12"
            ]
          }
        }
      ]
