              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kirchinö malaykayanta kanisa Tuatira lö, ‘Anyï ngölyon nyo ngwïno wölo mi Wero Tororöt nyo lata konyichi lyopöto ma akïlata kelyechi tay nyo kikïsit nyoman.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
            "verseOrgIds": [
              "REV.2.18"
            ]
          }
        }
