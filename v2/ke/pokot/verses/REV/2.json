                  "text": "30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wölo otïngetan ngölyon ompö nyi: iterchinenyi kokonï le Yesepel ighöy kegh lö ochï werkoyon. Kunet mötworichan kipotöt, kwigh cheporesnan akwam omisyewut cho kïropchini körkeyïntin. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.20",
            "verseOrgIds": [
              "REV.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyotönön nyinte pöroyïn nyo löstegho ngokichi, wölo katagh nyinte kïpïstö otöptanyi nyo pö cheporesnan. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.21",
            "verseOrgIds": [
              "REV.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, owirenan nyinte kosotyö nko pich cho ighöy cheporesnan tïkwïl. Anta manyona kikötö akïpïstö ortïnekwa cho ghach. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.22",
            "verseOrgIds": [
              "REV.2.22"
            ]
          }
        },
        {
