              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.13",
            "verseOrgIds": [
              "REV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.14",
            "verseOrgIds": [
              "REV.14.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.13"
              },
              "items": [
                {
                  "text": "Dan 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay asïwan lö kimi polta nyo rel atoni. Kitöpo kïgh poltononi nyo lata ptangengmöt nyo kitïng tenta koltin ompö mötïnyi nko rotwö nyo ngatip nyo kilo pagh ompö ewunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.14",
            "verseOrgIds": [
              "REV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.13"
              },
              "items": [
                {
                  "text": "Yol 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atoni nyu, kungwïna malaykayante anka Kö pö Tororöt* akïlenchï malaykayantanay kitöpo polta ompö kut nyo wow, “Nama rotwengu atetorö ilsyenö ompöwölo kikwitïta asispa ilö, akikïrïryö pagha ngwïny nyo kömïchï kel!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.15",
            "verseOrgIds": [
              "REV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atoni nyu kïnam malaykayantanay kitöpo polta rotwenyi akwil ngwïny.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.16",
            "verseOrgIds": [
              "REV.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
