              "items": [
                {
                  "text": "Ngo 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lentöy Echotyon, “Atere ya! Ongwïnan le chorin! Soyönote chi nyo mi kïpsach akïkörmönöy sïrokachi atömöwö kïchïrut akïnyorï arasï ompö tawu pich!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
            "verseOrgIds": [
              "REV.16.15"
            ]
          }
        }
