                {
                  "text": "Wuw 9:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïwö malaykayanteto tagh akïmïlchï tïkwïn cho kömi pakulinyi paraku ngwïny nyo tïyame. Kuchumchï chepserkechöy cho ghach ompö ngwonïn nyo wow pich cho kitïng macheyu tyonyoni nko cho kisoghöy körkeyïntanyi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        }
      ]
    },
    {
