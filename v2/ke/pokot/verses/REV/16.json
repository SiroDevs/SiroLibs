              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay alïman kut nyo wow nyo kingölonunö Kö pö Tororöt kïlenchini malaykenichoni le mut nko odeny, “Ape omïlchinö ngwïny tïkwïn cho mi pakulinechona le mut nko odeny, cho pö nörekyo Tororöt!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        }
      ]
    },
