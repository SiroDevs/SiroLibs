            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay kumïtï mïkulischay pö pöytoghichoni kïtuyechï ato kïkuro ompö kuti Eprania Armakedon.",
          "type": "text",
