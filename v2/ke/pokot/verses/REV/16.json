        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïmïlchï malaykayanteto mut nko akonga tïkwïn cho kimi pakulinyi paraku lalwanay wow kïkuro Yuparet. Kïteny lalwanay, atökïrumchï or pöytoghï cho kipkono kongasis. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.12",
            "verseOrgIds": [
              "REV.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay asïwan mïkulis sömök cho ghach cho kilata mnyakaway cho kipkono kuti ntaranay nko kutito tyonyoni nko kutito werkoyontononi pö putintön. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïkulis pö oy chane cho ighöy töngönchin. Petöy mïkulischoni kïsömök wölo mi pöytoghi ngwïny kïmïkul atökutuyö chane löwïr ompö poryot ompö Asis nyo wow nyo pö Kimuktoghin Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.14",
            "verseOrgIds": [
              "REV.16.14"
            ]
          }
        }
      ]
    },
