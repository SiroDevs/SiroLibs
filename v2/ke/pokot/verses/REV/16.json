              "items": [
                {
                  "text": "Wuw 10:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay kïmïlchï malaykayanteto mut tïkwïn cho kimi pakulinyi paraku ngacharu paytaghpa tyonyay. Kuyen tuwïn pöyunöto tyonyay, kïsïr pich ngölyepkekwa ompö ngwonïn. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumwa chane Tororöt pö yïm ompö ngwonïn nyo kilïmchï kegh nko ompö chepserkechtinekwa. Wölo kimöpïstöcha chane ortïnekwa cho ghach.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
