                  "text": "Isa 6:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïnyïghï ighöt Kö pö Tororöt nyo kingwïn ompö ororyö nko owesyo Tororöt, akimöminye chi nyo kimï kïlït Kö pö Tororöt ntökïtenö kuwonyö kinyörilutchoni le mut nko odeny cho kipï malaykenichoni le mut nko odeny.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.8",
            "verseOrgIds": [
              "REV.15.8"
            ]
          }
        }
      ]
    },
