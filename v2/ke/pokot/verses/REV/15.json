          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay asïwan kiporunöte anka ompö yïm, kiporunöt nyo wow akï pö töngönchin. Kimi malayken cho le mut nko odeny cho ki acheytangwa kwipchï ngwïny kinyörilut mut nko odeny cho pö söröm, cho lïtitöy nörekyo Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.1",
            "verseOrgIds": [
              "REV.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
