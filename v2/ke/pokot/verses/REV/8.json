              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïkut malaykayan nyo pö odeny kontinyi. Kewirchï kïgh nanam nyo ato kiros kïlata kutïng nyo wow nyo kinöghöy. Kïwaghaka kareranpa nanam akong ompö sömök kïlïkwï kisön, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïmeghö kareran akong ompö sömök cho pö tyonkïn cho nanam, akenyar kareran akonga nyo pö sömök nyo pö melin.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
      ]
