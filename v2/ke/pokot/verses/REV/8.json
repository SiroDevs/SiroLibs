                {
                  "text": "Isa 14:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïkut malaykayan nyo pö sömök kontinyi. Kïchïnuna yïm kokelyanta nyo wow nyo kinöghöy le ta, akïchïnchï kareran akonga ompö sömök nyo pö lalwatïn nko wölo kosuno pögh. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 8:11"
          },
          "items": [
