            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiyat Wawa Kech macheyto mut nko odeny, kïsï yïmö lasay ompö nïsu sa akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.1",
            "verseOrgIds": [
              "REV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay asïwan malayken mut nko odeny kughyongo tawu Tororöt, ketö chane kontin mut nko odeny.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.2",
            "verseOrgIds": [
              "REV.8.2"
            ]
          }
        }
      ]
    },
