              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïnap kegh malaykenichay le mut nko odeny kitïng kontin mut nko odeny tökïkut kontinekwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.6",
