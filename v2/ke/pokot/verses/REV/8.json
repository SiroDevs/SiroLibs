                {
                  "text": "16:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay kïcheng malaykayantanay töwïtyonay kïpelo mankoy, akunyïghit ma ompö ato kïpelo amöros, akïwirchï ngwïny. Kwitï tïlötö nko kiteghat nko kiryal nko potanata ngwïny.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        }
      ]
