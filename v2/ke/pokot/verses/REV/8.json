            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.15"
              },
              "items": [
                {
                  "text": "Yer 9:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " (Kïkuro kaynata kokelyantanoni “Ngwonïn.”) Kïwaghaka kareran akonga ompö sömök nyo pö pögh kïngwonöchitu, kïmeghö pich cho chang cho kigha pöghechoni ompöwölo kiwöghokisyö kïngwonöchitu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        }
