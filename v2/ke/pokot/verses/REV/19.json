          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apkana ama panya porwöyi pöytoghï nko cho pö yetïntino askarin nko cho pö nyökon, panya angoletin cho pö pich cho pegho angoletinechoni nko panya pich löwïr, kö sekey anta ewo, kö mïnkech anta kö echön!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.18",
            "verseOrgIds": [
              "REV.19.18"
            ]
          }
        }
