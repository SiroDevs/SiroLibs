        },
        {
          "text": " Atolapay asïwan malaykayan nyo kighyongo paraku asis akïkur ompö kut nyo wow mötony kïmïroy poltoy lö, “Apkana! Oghömitinö kegh akor nyo wow nyo pö Tororöt! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.17",
            "verseOrgIds": [
              "REV.19.17"
            ]
          }
        },
