                {
                  "text": "3:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Soyönote pich lapay cho mwötöy sïrokökwa, ompöwölo tïng chane chömchin nyo omöy okinto ket pö söpon akïlïtöy kanasyan kuweröy kukotichi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.14",
            "verseOrgIds": [
              "REV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïkorchini sany pich cho pochï otöp nyo lata nyo pö kukïdin nko ponï nko rïmï nko cho soghöy körkeyïntin nko cho chömo kegh putintön.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.15",
            "verseOrgIds": [
              "REV.22.15"
            ]
          }
        }
      ]
    },
    {
