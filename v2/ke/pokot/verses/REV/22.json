                "loc": "REV.2.18"
              },
              "items": [
                {
                  "text": "2:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ochan Alpa nko Omeka, towunöt nko söröm, nyo pö tagh nko nyo pö söröm.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.13",
