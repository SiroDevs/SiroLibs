              "items": [
                {
                  "text": "Yer 17:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïlenchanïn Yeso ngat, “Tere! Ongwïnan lawel! Apunan ropöwechu, atotö chi anka tïkwïl kïrïp kegh nko ighisyewutkachi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.12",
            "verseOrgIds": [
              "REV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
