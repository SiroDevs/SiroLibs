                {
                  "text": "Mat 5:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.14+MAT.6.15"
              },
              "items": [
                {
                  "text": "Mat 6:14-15",
