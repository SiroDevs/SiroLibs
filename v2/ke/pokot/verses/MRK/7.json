            "sid": "MRK 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusupchï kegh Parisaytin* nko koneti kirurut cho te cho kipkono Yerusalem tawu Yeso. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.1",
            "verseOrgIds": [
              "MRK.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsïwa kinetanpa Yeso walaka kwomisïyi nko morïn cho le sïmnyon, cho tomönye kewun.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.2",
            "verseOrgIds": [
              "MRK.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.2",
            "verseOrgIds": [
              "MRK.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ompöwölo rïpöy Parisaytin nko pipö Yaudi löwïr kinetut cho kinyorchï chane poyikwa nyo momisïyicha kïtomö kewun morïn kïrïp kegh nko asïltineko poyikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.3",
            "verseOrgIds": [
              "MRK.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwato pkana chane donyö, kïmomisïyicha kïtomö kuwun kegh akimito ngala walaka cho kitach akïrïp cho lata, kewun mpalawis tören nko otupeni cho kikïgha taghoy.)",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.4",
            "verseOrgIds": [
              "MRK.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.4",
            "verseOrgIds": [
              "MRK.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Parisaytin nko koneti kirurut Yeso lö, “Ompö ne tömörïpöy kinetanköku kinetut cho kikïnyorchicha poy? Kölö ne tökwomisïyi chane nko morïn cho le sïmnyon?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.5",
            "verseOrgIds": [
              "MRK.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.5",
            "verseOrgIds": [
              "MRK.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.6",
            "verseOrgIds": [
              "MRK.7.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.13"
              },
              "items": [
                {
                  "text": "Isa 29:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kuyokyï Yeso chane lö, “Nyoman nyay kingorekwa werkoyonta Isaya chepölköstinechï otini kikikir lö, lentöy Tororöt,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.6",
            "verseOrgIds": [
              "MRK.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.7",
            "verseOrgIds": [
              "MRK.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kopïstekwa Kirurut pö Tororöt anama kegh asïltino pich.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.8",
            "verseOrgIds": [
              "MRK.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.8",
            "verseOrgIds": [
              "MRK.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yeso chane ngat, “Nkotïngetekwa chïreryö nyo gha nyo oghöpöno kinetut pö Tororöt atamuka arïpa asïltinekwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.9",
            "verseOrgIds": [
              "MRK.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kilö Musa, ‘Techa kon nko komöt, akwanka tïkwïl nyo mwoghöy kwanta anta kame akany ketïgh kïma.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.10",
            "verseOrgIds": [
              "MRK.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo anetakwa lö, ato tïng chi kïgh nyo kömököy kungöroko kwanta anta kame, atolapay kïmwa lö, ‘Kïyay komökan ongörokeninyi,’ kï, kakïpöyit Tororöt, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.11",
            "verseOrgIds": [
              "MRK.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "aghakwa nyinte kïpïstö mengarak kwanta anta kame. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.12",
            "verseOrgIds": [
              "MRK.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aghakwanyu ngölyonto Tororöt kïlïkwï kwïle ompö otöptinekwo cho kyonyorchï poyikwo, aghakwa tïkwïn walaka cho chang cho karkegh nko choni.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.13",
            "verseOrgIds": [
              "MRK.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tïkwïn cho sïmnyonöy chi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.13",
            "verseOrgIds": [
              "MRK.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur Yeso ngat pich kïpka wölo mi nyinte akïlenchï, “Atere ngalechan, akwa lapay alïm. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.14",
            "verseOrgIds": [
              "MRK.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möminye kïgh nyo mi chi sany nyo ato wö orinyi kumuköy kusïmnyon nyinte, kïpoto tïkwïn cho pkono ori, choni cho ighöy chi kïlïku sïmnyon. [ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.15",
            "verseOrgIds": [
              "MRK.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato itïng chi yitïn cho ilïmo, ilïm!”]",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.16",
            "verseOrgIds": [
              "MRK.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.16",
            "verseOrgIds": [
              "MRK.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kipakachta tuyonay, akïlït kö, kïtep kinetankachi lö ne nyo poru körkeyïnay. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.17",
            "verseOrgIds": [
              "MRK.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yeso chane, “Ayo möpköchinokwanye tïkwïl so? Mosïwïyekwanye lö, möminye kïgh nyo lïtöy chi nyo ngwïno sany nyo muköy ntökusïmnyon chi, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.18",
            "verseOrgIds": [
              "MRK.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ompöwölo melö lïtöy mïkulöwunyi, wölo lïtöy muyenyi atolapay kurel sany.” (Kiporï Yeso ompö mwaghatanoni lö tïlilöch omisyewut lapay.)",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.19",
            "verseOrgIds": [
              "MRK.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.19",
            "verseOrgIds": [
              "MRK.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlö, “Kïyinö ngwïno chi ori nyo sïmnyonöy nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.20",
            "verseOrgIds": [
              "MRK.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo pkono mïkulöwo pich ori kinonut cho ghach cho lata cheporesnan, chorsyö, pörsyö, atomi, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.21",
            "verseOrgIds": [
              "MRK.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "pïrchin nyo gha, köromnyö, lïsat, kelïkwï chepomu, ketora kipö chi kong, kiswomöt, kwolöto kegh nko sölwontön, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.22",
            "verseOrgIds": [
              "MRK.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "pkono tïkuchï lapay ori chi akïchete cho ighöy chi kïlïku sïmnyon.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.23",
            "verseOrgIds": [
              "MRK.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kighanata korka akonga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.23",
            "verseOrgIds": [
              "MRK.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïngeta Yeso wöloni, kïwö kutang okumpö Tiro nko Sidon. Kïlït kö akimachamnye lö tenkïtï chi wöloni kimi nyinte, wölo kimawïnganye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.24",
            "verseOrgIds": [
              "MRK.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïn korka lawel lenyini nyo kitïng cheptanyi oy, akupïtyï kelyo Yeso. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.25",
            "verseOrgIds": [
              "MRK.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki pö Krik kokononi nyo kïngwïna Poinike ompö Sirya, kïsagh Yeso kutulö oy cheptanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.26",
            "verseOrgIds": [
              "MRK.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Yeso nyinte lö, “Nya kepagh monïng kïpïghyö. Mökaramnye kecheng omisyo monïng akewirchï kukïdin.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.27",
            "verseOrgIds": [
              "MRK.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.27",
            "verseOrgIds": [
              "MRK.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï kokonay Yeso lö, “Nyoman, Echotyon wölo muköy kukïdinö kïkwagh rarakan cho chuntoy monïngö.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.28",
            "verseOrgIds": [
              "MRK.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.28",
            "verseOrgIds": [
              "MRK.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yeso kokonay, “Ompö mwaghatengu nyoni, wïyö nyi nyu, kikïngeta cheptöngu oy!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.29",
            "verseOrgIds": [
              "MRK.7.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.29",
            "verseOrgIds": [
              "MRK.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö kaw, kutomtö montanyi rïwöy pöröy kikïngeta oyichay.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.30",
            "verseOrgIds": [
              "MRK.7.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kesop Yeso kïminy nyo mangate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.30",
            "verseOrgIds": [
              "MRK.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïngeta Yeso Tiro akuwerata Sidon, ntökwit nanampa Kalilaya ntö kïlït Dekapoli. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.31",
            "verseOrgIds": [
              "MRK.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumïtyï pich nyinte chi nyo kimingate akwaghïgh kut. Kïsagh Yeso kukanagh morichi parakunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.32",
            "verseOrgIds": [
              "MRK.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumït Yeso chichay yona akulut morichi yiti chichay akïngwïtï akïswany ngalyapunyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.33",
            "verseOrgIds": [
              "MRK.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïtopön yïm akïwirï kimïny ompö sönönöt, akïlenchï chichay, “Epata,” lenye nyoni ato kïmwa lö, “Yatena!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.34",
            "verseOrgIds": [
              "MRK.7.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.34",
            "verseOrgIds": [
              "MRK.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyotisyö yitichay, kutyaka ngalyapunyi kïngalan nyo karam. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.35",
            "verseOrgIds": [
              "MRK.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïmwochï pïchay lö, mötöp ntomwochï chi, wölo kïrkegh kimwa lenyoni kï kingangta pïchay akïmwatïta lasiny. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.36",
            "verseOrgIds": [
              "MRK.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtangany pïchay nyo pö nyoman akïlö, “Kegh tïkwïn lapay karam nyo, kegh kïminytin kïlïm ngal akwigh kïmanytin, kïngalan!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.37",
            "verseOrgIds": [
              "MRK.7.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kapagh Yeso pich cho le elpun angwan",
          "type": "text"
        }
      ]
    }
  ],
