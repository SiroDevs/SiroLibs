              "items": [
                {
                  "text": "Luk 9:7-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kuyokyï lö, “Lentöy pich ichinyi Yoana Kipatisanin, kïlentöy walaka ichinyi Eliya, kïlö walaka ichinyi akonga ompö werkoyi könyisyok.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.28",
            "verseOrgIds": [
              "MRK.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.68+JHN.6.69"
              },
              "items": [
                {
                  "text": "Yna 6:68-69",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïtepa ngat lö, “Akwa, olentekwa ochan ngo?” Kuyokyï Petro lö, “Ichinyi Kristo.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.29",
            "verseOrgIds": [
              "MRK.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kuyomis Yeso chane lö, “Motöp ntomwochï chi ngalechï.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.30",
            "verseOrgIds": [
              "MRK.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kingalana Yeso kiwongunötenyi nko meghenyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.30",
            "verseOrgIds": [
              "MRK.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutor kunet kinetankachi lö, “Wongu Wero Chi nyoman, töghöy nyinte poyï nko tïsï cho echön nko koneti kirurut, kïtïghöy nyinte kïma, wölo nyini kewer osiswö sömökï kututunö ngwen.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.31",
            "verseOrgIds": [
              "MRK.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiporchï Yeso chane ngölyontononi lasiny. Kïlenyona, kumït Petro nyinte kïwö ato le kömos akïchil. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.32",
            "verseOrgIds": [
              "MRK.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïwaghaka Yeso kuros kinetankachi akïwechï kïchil Petro. Kïlenchï, “Ngetena tawunyan Onyötonï, ompöwölo menonenyinye le wölo nontoy Tororöt inonenyi le ptangengmöt!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.33",
            "verseOrgIds": [
              "MRK.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
