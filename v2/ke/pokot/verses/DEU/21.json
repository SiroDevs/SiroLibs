  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "DEU 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato kïnyorï chi nyo kakïpar amenkïtnye chi lö ngo nyo kapar ompö koronini konokwa ECHOTYON Tororötïnkwa ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.1",
            "verseOrgIds": [
              "DEU.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akany kïtuyö poyikwa nko kirwokikwa, atökïpka kupim koghïn kïngeta otini kakïnyorchï mïntïrïch ntökwit kanastin cho lekïtöch. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.2",
            "verseOrgIds": [
              "DEU.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïyörï poyi kanasyantanoni lekïto atoni kakïnyorchï mïntïrïch mösör nyo tomönye kepöghisyeghö. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.3",
            "verseOrgIds": [
              "DEU.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïkat ntökwit ato lekïto champilwa nyo mi pögh cho melö tengöy, wölo tomönye kengor, atolapay kïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.4",
            "verseOrgIds": [
              "DEU.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petöy wölini tïkwïl pipö Lawi cho le tïsï, ompöwölo chane cho kikïl ECHOTYON Tororötïnkwa atökïpöghisyechï nyinte akusoyön pich ompö kaynenyi. Akï chane cho sötöy syölut anka tïkwïl nko ngala pich cho kïporyö akeghöy kïrïp kegh nko ngalekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.5",
            "verseOrgIds": [
              "DEU.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuno nyu poyi kanasyantanoni lekïto atoni kömeghchï chi morikwa paraku mösörunoni kakïkwïl ompö le champilwa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.6",
            "verseOrgIds": [
              "DEU.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïlö, ‘Melö kakïtïghöcha chichï amelö kinkïtöcha lö ngo nyo kötïgh. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.7",
            "verseOrgIds": [
              "DEU.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heywey! ECHOTYON, ilöstoghchï piköku Israel cho kimïtunenyi koro Misri. Ilöstowecha amekany kwamecha kisön pö chi nyo puryö lelut.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.8",
            "verseOrgIds": [
              "DEU.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mökwomokwanye nyu kisönchay puryö lelut, ompöwölo kaghakwa kïgh nyo mököy ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.9",
            "verseOrgIds": [
              "DEU.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngala kor cho kakïnama poryot",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.9",
            "verseOrgIds": [
              "DEU.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato asetekwa lïk atoporyenö nko punkökwo, akutö ECHOTYON Tororötïnkwa chane morikwa arangakwa chane kïlïkwï naman, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.10",
            "verseOrgIds": [
              "DEU.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïsïwa chi korka nyo pïchigh ompö kwenungwa, nyo mököy lö roko kop. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.11",
            "verseOrgIds": [
              "DEU.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwip katanyi akïrwach akïmut sighokachi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.12",
            "verseOrgIds": [
              "DEU.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïwaghach sïrokachi. Akïkany kïtöpö kïrir pikökwa ompö arawa akonga. Atolapay kwip nyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.13",
            "verseOrgIds": [
              "DEU.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato mi löt kïtagh nyinte, kutyak ametöp lö oltoy ompö ropïyen le sekeyon ompöwölo kikirïwotenyi nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.14",
            "verseOrgIds": [
              "DEU.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngala mïlata worö nyo le poret",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.14",
            "verseOrgIds": [
              "DEU.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato ip chi koruchi odeny akïcham anka kïsas anka akïsïch chane kwodeny monekwa, akïlïkwï poret weri nyo pö kokonay kïsösöy, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.15",
            "verseOrgIds": [
              "DEU.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "akwotini mököy nyinte kuporchini monechi tïkwïn, kïmelö mïchini kïcham weri nyo pö kokonay le chaman akwigh nyinte kïlïkwï poret nyinö kötö lïku weri nyo pö kokonay kïsösöy. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.16",
            "verseOrgIds": [
              "DEU.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo mïchini kutö poretyenyi tïkwïn cho kitöni kïnyïl odeny, kïrkegh kö weri nyo pö kokonay kïsösöy, ompöwölo ki poretyenyi tagh nyinte. Nyo mïchini kïnyorï monïng nyo le poret mantanyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.17",
            "verseOrgIds": [
              "DEU.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngala worö nyo aghïgh möt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.17",
            "verseOrgIds": [
              "DEU.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato tïng chi worö nyo aghïgh möt akï penyöy ngal akï melö teröy kuti yiyichi kïrkegh kakïmuny lö ne, kï melö terchini chane, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.18",
            "verseOrgIds": [
              "DEU.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "akany nyu kïnam yiyichi akumïtyï poyi kanasyantenyi atökerwokyï. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.19",
            "verseOrgIds": [
              "DEU.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwochini chane poy lö, ‘Aghïgh möt werï akï penyöy ngal, mölïmönye kïgh, chi nyo pöghisyegho ropïyen nyo gha akï tömösin.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.20",
            "verseOrgIds": [
              "DEU.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiro nyu nyinte koghïn mïrön pö kanasyantanoni ntökïma. Aranoni nyo omukekwa onoteghone ghöyityö ompö kwenunkwa, ato lïm pipö Israel kuwöghisyö.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.21",
            "verseOrgIds": [
              "DEU.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kirurutkö walaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.21",
            "verseOrgIds": [
              "DEU.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato igh chi ngokï cho mïchini kïmegha aketïgh nyinte akewusö ket, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.22",
            "verseOrgIds": [
              "DEU.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.13"
              },
              "items": [
                {
                  "text": "Kal 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mopïsyï kïrï ketoni ntökïyech, ompöwölo mi chïpöto Tororöt paraku chi nyo kiwuso, kïlenyona otïp nyinte asisoni atömosïmnyon kor nyo konokwa ECHOTYON Tororötïnkwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.23",
            "verseOrgIds": [
              "DEU.21.23"
            ]
          }
        }
      ]
    }
