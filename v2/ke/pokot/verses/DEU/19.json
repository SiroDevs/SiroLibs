              "items": [
                {
                  "text": "Mat 5:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makany kusyonok chichoni, kitököy söpon ompö söpon, kong ompö kong, kelat ompö kelat egh ompö egh, kel ompö kel.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.21",
            "verseOrgIds": [
              "DEU.19.21"
            ]
          }
        }
      ]
