                "loc": "DEU.27.17"
              },
              "items": [
                {
                  "text": "Krt 27:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Manategha rotyeto pöröryengwo nyo kimut poyï könyisyok ompö koronini konokwa ECHOTYON Tororötïnkwa achenga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngal cho pörtoy okumpö söwï",
          "type": "text"
        }
      ]
    },
