            "sid": "DEU 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay olonekwa ropïyenichoni kïgh anka tïkwïl nyo kömököy, ato kö tïch anta kechir anta dipay anta kumïn anta kö kïgh kïnye anka tïkwïl nyo pïrchinokwa mu, ama tawu ECHOTYON Tororötïngwo angörekyö nko monekwo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        }
      ]
    },
    {
