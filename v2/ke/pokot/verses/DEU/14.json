          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mopïstö pipö Lawi cho omöngekwa tïkwïl, ompöwölo melö tïng chane kor nyo mïlöy nko akwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.27",
            "verseOrgIds": [
              "DEU.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany ato mi sörömu könyito sömök opï kareranpa taman cho pö tïkwïn löwïr cho kirïrwokwa könyinoni arorchï kanastinekwo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.28",
            "verseOrgIds": [
              "DEU.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atökïpka kwam pipö Lawi cho mötïngcha kor nyo mïlöy nko akwa nko to nko pönon nko mïsïktin cho mi möngöy nko akwa, atökusoyönokwa ECHOTYON Tororötïnkwa ompö kïgh anka tïkwïl nyo oghekwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.29",
            "verseOrgIds": [
              "DEU.14.29"
            ]
          }
        }
      ]
