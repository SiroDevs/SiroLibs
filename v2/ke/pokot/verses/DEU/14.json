                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ochikwa pich cho tïlilöch ompö ECHOTYON Tororötïngwo cho kikïngotokwa nyinte akakïlakwa ECHOTYON alïkuna pikachi kegh ompö kwenu puntoni walaka löwïr ompö ngwïny.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tyonkïn cho tïlilöch nko cho le sïmnyon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mam kïgh anka tïkwïl nyo le sïmnyon. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.3",
            "verseOrgIds": [
              "DEU.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achï tyonkïn cho omekwa: tany nko kech nko aran ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.4",
            "verseOrgIds": [
              "DEU.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko cheptirkich nko asarïch nko ptukö nko arta wuw nko kecha kamas nko korinya anta siran. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.5",
            "verseOrgIds": [
              "DEU.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omekwa tyony anka tïkwïl nyo sakate putïlyö akuntoröy ngömïgh. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.6",
            "verseOrgIds": [
              "DEU.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo mam tyonchï kïrkegh kentoröy ngömïgh anta sökote putïlöy, tamas nko plekwa nko kaner ompöwölo ntoröy ngömïgh amelö sökote putïlöy. Sïmnyon tïkuchoni ompö akwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.7",
            "verseOrgIds": [
              "DEU.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam nkïruwen, ompöwölo kïrkegh sökote putïlöy kïmelö ntoröy ngömïgh. Sïmnyon kïyoni ompö akwa. Maswany nyo kama.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.8",
            "verseOrgIds": [
              "DEU.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.8",
            "verseOrgIds": [
              "DEU.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Achï tïkwïn löwïr cho omekwa cho mi pögh: kïgh anka tïkwïl nyo tïng köpepoy nko res, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.9",
            "verseOrgIds": [
              "DEU.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wölo mam anka tïkwïl nyo mötïngnye köpepoy anta res. Sïmnyon kïyoni ompö akwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.10",
            "verseOrgIds": [
              "DEU.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.10",
            "verseOrgIds": [
              "DEU.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omukekwa ome törit walaka löwïr cho melö sïmnyon karamach. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.11",
            "verseOrgIds": [
              "DEU.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo mam töritwechï: sich nko pyukïk nko sirörö nko kamchereres nko mötony nko chesampï nko kukayoy nko cheptusonkol nko wutpöghö nko kachïlïkoköch nko kongoy nko cho karkegh nko mpaw nko reres. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.12+DEU.14.13+DEU.14.14+DEU.14.15+DEU.14.16+DEU.14.17+DEU.14.18",
            "verseOrgIds": [
              "DEU.14.12",
              "DEU.14.13",
              "DEU.14.14",
              "DEU.14.15",
              "DEU.14.16",
              "DEU.14.17",
              "DEU.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sïmnyon tïku löwïr cho mïnkech cho tïng köpepoy, mam tïkuchoni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.19",
            "verseOrgIds": [
              "DEU.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukekwa ome tïkuchoni walaka löwïr cho melö sïmnyon.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.20",
            "verseOrgIds": [
              "DEU.14.20"
            ]
          }
        }
      ]
    },
    {
