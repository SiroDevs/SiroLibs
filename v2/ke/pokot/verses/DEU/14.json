              "type": "text"
            }
          ]
        },
        {
          "text": "“Ochikwa pipö ECHOTYON Tororötïnkwa. Kïlenyona mawat nyu porwöyikwo amarwak mötöw ato ma chi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
