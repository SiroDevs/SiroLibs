              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato wany asïyech ECHOTYON Tororötïnkwa pipö punton, ompö koronini opetekwa ochengöy amany, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.29",
            "verseOrgIds": [
              "DEU.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "orip kegh nyu tömarïp atöptino pïchoni nyoni ngöghöp ompö akwa. Amatep wölo soghtoy tororötinekwa lö tökegha lenyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.30",
            "verseOrgIds": [
              "DEU.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masagh ECHOTYON Tororötïngwo le chane. Ompöwölo otini soghöy chane tororötinekwa kwighöy, lilöy ECHOTYON kïgh nyo lilöy ECHOTYON. Köpechï kïpel ompö chini le monekwa le amörostin ompö tororötinekwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        }
      ]
