              "type": "text"
            }
          ]
        },
        {
          "text": "“Asaghan ECHOTYON asisoni lö, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.23",
            "verseOrgIds": [
              "DEU.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Echotyon TORORÖT, ketorönyi ye iporwanïn wowïntöngu nko owesyengu. Möminye tororöt anka yïm anta ngwïny nyo muköy kwighöy tïkwïn cho pö töngönchin cho keghanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo osoghinyi lö pïswante oghyö asïwan koronini mi lalwa Yordan antakwagh nko koronini pïchigh pö komos nko Lepanon.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        }
      ]
    },
