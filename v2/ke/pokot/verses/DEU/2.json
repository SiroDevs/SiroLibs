            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21"
              },
              "items": [
                {
                  "text": "Kiy 21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kemïlisyecha nyu akepa ketang surkwen kerïpacha or nyo wetöy Nanam nyo Pïrir, lenyini kimwowanïn ECHOTYON. Kepechicha kewitwit komoswo Edom osis cho chang.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.1",
            "verseOrgIds": [
              "DEU.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.1",
            "verseOrgIds": [
              "DEU.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïngalan ECHOTYON akïlenchanïn, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.2",
            "verseOrgIds": [
              "DEU.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Kömïchï osiswö cho kawitwitakwa kamas, ape nyu atanga ewu löt. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.3",
            "verseOrgIds": [
              "DEU.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.36.8"
              },
              "items": [
                {
                  "text": "Tow 36:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aimwochï pïchï lö, karik awerakwa koreto werkökwo, pipö Esau cho möngöy Edom. Wöyokwa chane wölo orip kegh nyoman. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.4",
            "verseOrgIds": [
              "DEU.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masyal nko chane ompöwölo melö okonokwa korengwa nyo le ompö kite, nyo tenö walpa kata. Ompöwölo kotönön Esau komoswo Edom kïcheng kïlïkwï nyenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.5",
            "verseOrgIds": [
              "DEU.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alena chane omisyö nyo omöy nko pögh cho ogheghöy.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.6",
            "verseOrgIds": [
              "DEU.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.6",
            "verseOrgIds": [
              "DEU.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ompöwölo kesoyön ECHOTYON Tororötïnkwa ighisyewutko ewunekwa löwïr, nkït nyinte wölini kapesteghekwa surkwenete wow. Kimi nko akwa ECHOTYON Tororötïnkwa ompö könyiswechanye le tömönut angwan amelö kimi kïgh nyo kirörchokwa.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.7",
            "verseOrgIds": [
              "DEU.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.7",
            "verseOrgIds": [
              "DEU.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïlenyona nyu, kepecha aketïl wölo kimi werköcha pipö Esau cho kimöngöy Seir. Kemïloncheghecha or nyo wegho Arapa kutöngöy kanastina Elat nko Esyonkeper. Kerïpacha or nyo weröy surkwen pö koro Moap. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.8",
            "verseOrgIds": [
              "DEU.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.3"
              },
              "items": [
                {
                  "text": "Tow 19:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn ECHOTYON, ‘Mesus pipö Moap, pïchay pö ara Lot, metöp lö oporyot nko chane, ompöwölo kyotönön chane kanasyanta Ar amelö mi korengwa nyo okonokwa.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.9",
            "verseOrgIds": [
              "DEU.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.9",
            "verseOrgIds": [
              "DEU.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kimöngöy koronini pipö Emim. Ki pich chane cho owesöch aki chang. Aki koghöch le pipö Anakim. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.10",
            "verseOrgIds": [
              "DEU.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikiyit chane tïkwïl lö pipö Repaim le pipö Anakim. Wölo kikurö pipö Moap chane pipö Emim. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.11",
            "verseOrgIds": [
              "DEU.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimöngöy pipö Ori tïkwïl korononi pö Seir kïngeta otini le könyisyok, wölo kïyon pipö Esau chane. Kïpar pipö Ori akïpechï kïmöngisyö, le wölanye kida pipö Israel pïchanya kitö ECHOTYON korengwa kïlïkwï nyingwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.12",
            "verseOrgIds": [
              "DEU.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.12",
            "verseOrgIds": [
              "DEU.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Angeta oghyenö lalwa Sered lenyini kïmwa Echotyon. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.13",
            "verseOrgIds": [
              "DEU.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.28+NUM.14.29+NUM.14.30+NUM.14.31+NUM.14.32+NUM.14.33+NUM.14.34+NUM.14.35"
              },
              "items": [
                {
                  "text": "Kiy 14:28-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kichengecha könyis 38 kïngeta otini kikïngetecha Kades Parnea ntökïtenö kyoghyenöcha lalwa Sered. Kökikuwonyö pipö lïk löwïr cho kipö pïn nyo pö atoni, kïrïp kegh nko ngölyonto ECHOTYON nyo kimwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.14",
            "verseOrgIds": [
              "DEU.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kimi ECHOTYON kïporyegho chane ntökïtenö kewanya chane löwïr kanasyantanoni.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.15",
            "verseOrgIds": [
              "DEU.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.15",
            "verseOrgIds": [
              "DEU.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Otini Kikuwonyö pïchay pö lïk löwïr, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.16",
            "verseOrgIds": [
              "DEU.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïlenchanïn ECHOTYON, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.17",
            "verseOrgIds": [
              "DEU.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Orïpekwa asisete ara Ar nyo mi koro Moap. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.18",
            "verseOrgIds": [
              "DEU.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.38"
              },
              "items": [
                {
                  "text": "Tow 19:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini ketanyi koro pipö Amon, pïchay pö ara Lot, mesus chane ametöp lö oporyot nko chane, ompöwölo kyotönön chane korononi amelö mi korengwa nyo okonokwa.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.19",
            "verseOrgIds": [
              "DEU.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.19",
            "verseOrgIds": [
              "DEU.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kikiyit korononi tïkwïl lö koro pipö Repaim cho kimöngöy korononi ato kile tagh, wölo kikurö pipö Amon chane Samsumim. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.20",
            "verseOrgIds": [
              "DEU.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki pich chane cho owesöch aki chang aki koghöch le pipö Anakim. Wölo kïpar ECHOTYON chane, kïpka nyu korononi pipö Amon akïmang kuker chane. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.21",
            "verseOrgIds": [
              "DEU.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïle wölanye kighchï ECHOTYON pipö Edom, pïchay pö ara Esau kimönyöy koro komoswo Edom. Atanye kipar nyinte pipö Ori atökutö pipö Edom kïpka kïmang korengwa akïtökïmöngöy nko nyete le ye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.22",
            "verseOrgIds": [
              "DEU.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimöngöy pipö Apim sörömu nanampa Kwen ntökwit Kasa, kïpka pipö Kaptorim kïpar chane akïmöngisyö.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.23",
            "verseOrgIds": [
              "DEU.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.23",
            "verseOrgIds": [
              "DEU.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Angeta nyu anama pantangwo, oghyenö lalwa Arnon, ompöwölo kyotönön morikwa Sion pöytoghinto Espon nyo le chi pö Amori nko korenyi tïkwïl. Oporyeghenö yenyu nyinte acheng korenyi kïlïkwï nyinkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.24",
            "verseOrgIds": [
              "DEU.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otowunan kïngata asisete otöni pich löwïr cho mi ngwïny kiwaghat nko mïghöt ompö nyi. Ato lïm chane ngaleku kïpotonchö, akïnyorï ngwonïn ompö nyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.25",
            "verseOrgIds": [
              "DEU.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Karïnta pipö Israel pöytoghin Sion",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.25",
            "verseOrgIds": [
              "DEU.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atolapay ayontan pich kïpegha surkwen pö Kedemot kïpa kïmwochï Sion pöytoghintö Espon ngala kalya kïlenchï, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.26",
            "verseOrgIds": [
              "DEU.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Chömwecha kewera korengu. Kïpetecha kerïpöy ara mït kwïle, melö kïmostocha kamas nko kamas. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.27",
            "verseOrgIds": [
              "DEU.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwecha omisyö nyo kyomöy nko pögh cho kïgheghöy. Wölo metagh kïnye keweracha korengu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.28",
            "verseOrgIds": [
              "DEU.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntökïtenö kyoghyenöcha lalwa Yordan atökepecha kor nyo konecha ECHOTYON Tororötïncha. Kïle wölini kichömwecha pipö Esau cho möngöy Seir nko pipö Moap cho möngöy Ar.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.29",
            "verseOrgIds": [
              "DEU.2.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.29",
            "verseOrgIds": [
              "DEU.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo kïtaghenecha Sion pöytoghinto Espon keweracha korenyi, ompöwölo kigh ECHOTYON Tororötïncha mïkulöwunyi kwaghïghit. Akwigh nyinte kïlïkwï tighin, atökumï kutö nyinte morikwa le asisete.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.30",
            "verseOrgIds": [
              "DEU.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.30",
            "verseOrgIds": [
              "DEU.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atolapay kïlenchanïn ECHOTYON, ‘Rose lö kotönön pöytoghin Sion nko korenyi moriku. Chenga nyu aipayta kïlïkwï nyengu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.31",
            "verseOrgIds": [
              "DEU.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany otini kingwïn Sion nko pikachi löwïrcho pö lïk atökïporyeghenecha ompö Yaas, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.32",
            "verseOrgIds": [
              "DEU.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïkonecha ECHOTYON Tororötïncha nyinte, kepara nyinte nko werkachi nko pikachi cho pö lïk. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.33",
            "verseOrgIds": [
              "DEU.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kechengacha nyu asisoni kanastinechi löwïr akepar chi anka tïkwïl, mïrön nko kor nko monïng. Melö kikïpïstecha ompö akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.34",
            "verseOrgIds": [
              "DEU.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kikïrangacha kyak akerit tïkwïn cho kikïpörunecha kanastin. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.35",
            "verseOrgIds": [
              "DEU.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikonecha ECHOTYON Tororötïncha kechenga kanastin löwïr kïngeta Aroer nyo mi sörömu mpöghoghyo Arnon nko kanasyan nyo kimi kwenu mpöghoghyononi ntökwitïta Kiliad. Melö kimi kanasyanta nyo le ompö akonga nyo kipölecha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.36",
            "verseOrgIds": [
              "DEU.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kikïrikacha koro pipö Amon anta sörömu lalwa Yapok anta kanastina koro komos anta kor anka tïkwïl nyo kitaghenecha ECHOTYON Tororötïncha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.37",
            "verseOrgIds": [
              "DEU.2.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Karïnta pipö Israel pöytoghin Ok",
          "type": "text"
        }
      ]
    }
