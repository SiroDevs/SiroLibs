    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïle nyu otini kïchicha pich cho kïpöghisïyi nko Tororöt, kïsoghokwa nyoman lö makany kupot kwïle pöropcho Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.1",
            "verseOrgIds": [
              "2CO.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.8"
              },
              "items": [
                {
                  "text": "Isa 49:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mwoghöy Tororöt lö,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kïmökecha ketöne matankïl ara chi anka tïkwïl atömönyorï pöghisyencha kigheghchin. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.3",
            "verseOrgIds": [
              "2CO.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyinö kötö kighecha lenyoni, keporucha kegh lasiny lö kïchicha mötwori Tororöt ompö kïgh anka tïkwïl nyo kighecha ompö mïkukönöt nyo wow ompö osiswo kichopat nko kömpölelyö nko nyarïl. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.4",
            "verseOrgIds": [
              "2CO.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.23"
              },
              "items": [
                {
                  "text": "Ist 16:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kakïmungecha aketorchecha chela, kakïchilecha ompö tawu pich, kakitungenecha ighisyewut kyoghochenö akepa kïpuryö rïwön anta omisyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.5",
            "verseOrgIds": [
              "2CO.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakiporucha kegh lö kïchicha mötworï Tororöt ompö tïlilyo mïkulögh nko kinkïtöt nko kamaghat nko tölosyö ompö Mïkulögh nyo Tïlil ompö chomnyencha nyo möminye lïsata, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.6",
            "verseOrgIds": [
              "2CO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ompö amtaghtancha nyo pö man nko ompö owesyo Tororöt. Lïku man karicha cho kïporyegho akeripo kegh ompö ewu tagh nko nyo pö löt. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.7",
            "verseOrgIds": [
              "2CO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmitecha kïpsach kekonyïtech anta kïkonech arasï. Kïsalecha akechïpecha. Kïlatecha lïsï akwanyï kïngölonecha ngala man. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.8",
            "verseOrgIds": [
              "2CO.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlatecha pich cho mörumucha akwanyï nkïtecha pich tïkwïl, kïlatecha pich cho kimeghö, wölo kïchicha söpchote lasiny kïle otini osïwïyekwa, kïlatecha pich cho kichopöy kong, wölo tomönye keparecha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.9",
            "verseOrgIds": [
              "2CO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrkegh kelatenacha pich cho wongu wölo kïngöreksocha kïtenö osis. Kïlatecha mey cho tïryolöch, wölo kimökosecha pich cho chang, kïlatecha pich cho kïmitö kïtuw akwanyï kïtïngetecha kïgh anka tïkwïl.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.10",
            "verseOrgIds": [
              "2CO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.10",
            "verseOrgIds": [
              "2CO.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakïngalanacha nko akwa kïlöpo, werköcho pipö Korinto akï möminye kïgh nyo kakïwïnchicha mïkulöwecho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.11",
            "verseOrgIds": [
              "2CO.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato asïwekwa kïgh anka tïkwïl nyo le tömölöwon ompö kwenunkwa nko acha, kïmi kïyoni okuntönkwa melö okuntöncha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.12",
            "verseOrgIds": [
              "2CO.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ongölonwokwa ye le ato ongölonchinan monechu akany ya kïyotisyö mïkulöwekwa lasiny ompö acha le wölo kikidecha chicho.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.13",
            "verseOrgIds": [
              "2CO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Marïp otöptino pich cho meghönöcha Tororöt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.13",
            "verseOrgIds": [
              "2CO.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monomnyotö nko pich cho meghönöcha Tororöt, ompöwölo memukonye. Muköy lö ne köromnyö kïnomnyotoy nko ghöyïn? Anta tïng ghamtagh ne löpoyïn nko tuwïn? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.14",
            "verseOrgIds": [
              "2CO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anta lïmchinot Kristo* nko Onyöt ompö or ne? Tïngeto ghömïchö ne chi nyo ghanate nko nyo melö ghanate? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.15",
            "verseOrgIds": [
              "2CO.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.12"
              },
              "items": [
                {
                  "text": "Law 26:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.27"
              },
              "items": [
                {
                  "text": "Esk 37:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.3.16"
              },
              "items": [
                {
                  "text": "1Kr 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.19"
              },
              "items": [
                {
                  "text": "6:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tïngeto tïlyantan ne Kö pö Tororöt* nko körkeyïntino putintön? Ompöwölo kïchicha Kö pö Tororöt nyo satate. Kïle wölo mwoytoy nyinte Tororöt lö,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    }
