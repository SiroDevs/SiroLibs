  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "2CO 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osomokwa nyu ante Paulö, ompö kisyonöto Kristo* nko chomnyenyi nyo nonöy pich lö chi nyo talase ato omitan nko akwa, wölo chi nyo körom ato ochan low nko akwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.1",
            "verseOrgIds": [
              "2CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osoghokwa lö maghante osïch köromnyö ato atwan, ompöwölo otïngetan man lö omukan ongwonitu ompö pich cho nonöy lö kïrïpecha otöp nyo pö por. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.2",
            "verseOrgIds": [
              "2CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo, kïrkegh kö man lö kïmöngecha ngwïnyinete, wölo melö kïporyeghocha otöp nyo pö por. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.3",
            "verseOrgIds": [
              "2CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo, melö pö karicha cho kïporyegho, poryo ngwïnyinï, wölo owesyo Tororöt nyo wuröy nïyet cho ongeröch. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.4",
            "verseOrgIds": [
              "2CO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwurecha kimölöto kegh nko kïgh anka tïkwïl nyo nisönöy akupapech pich kïlowöchitunö kinkïtöto Tororöt. Kighecha kinonut anka tïkwïl kïlïkwï naman akechikyï kïterchï Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.5",
            "verseOrgIds": [
              "2CO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "otini kokïniniekwa lasiny terchintönkwa nko acha, kenapacha nyu kegh akechop kong tighintön anka tïkwïl.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.6",
            "verseOrgIds": [
              "2CO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.6",
            "verseOrgIds": [
              "2CO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orosekwa tïkwïn okumpö sany kïpoto. Ekïmi kwenunkwa chi nyo nonöy lö ochï chi pö Kristo nya? Nya kunonchï kegh lö, kïchicha tïkwïl pipö Kristo le wölo lata nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.7",
            "verseOrgIds": [
              "2CO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo melö ololïyonan, kïrkegh kömwoghöy pikö walaka lö kokwolön kegh tya, ompö owesyö nyo kikonecha Echotyon owesyö nyo tekokwa melö nyo rultoyokwa kïrkegh kïlenyoni, kïmelö ololïyonan. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.8",
            "verseOrgIds": [
              "2CO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möchömanye ononekwa lö kamachan otyoghenokwa ompö palaltinechan. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.9",
            "verseOrgIds": [
              "2CO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muköy chitö anka kïmwoghöy lö, “Ngwonöch tya palaltina Paulö, wölo nyarkalal nyinte ato kïmitecha tïkwïl amelö kïgh ngalechi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.10",
            "verseOrgIds": [
              "2CO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kunan chi nyo ngölonöy lenyoni lö möminye sisïn ompö ngal cho kikirecha ato kïmitecha nko akwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.11",
            "verseOrgIds": [
              "2CO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.11",
            "verseOrgIds": [
              "2CO.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kimukyinecha keghöy kegh anta kikongityö kegh nko pich cho syolöy kegh. Pich cho ighöy kipimöwontengwa akukongityö kegh chane nko chane kegh, mötïngcha chane sïkunöt! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.12",
            "verseOrgIds": [
              "2CO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kïkwolecha kegh tya. Rumuno kwolötencha kipimöwontononi pö ighisyö nyo kikonecha Tororöt ighisyö nyo kighocha okuntönkwa tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.13",
            "verseOrgIds": [
              "2CO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo melö kïkwolecha kegh kïtïl owesyencha le ato melö kitunecha wöloni omitekwa, ompöwölo kikïnyaghacha kepkan ntöketï wöloni atökepkokwa Lökoy cho Karamach cho ngölono Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.14",
            "verseOrgIds": [
              "2CO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona nyu, melö kïkwolecha kegh ompö ighisyewut cho kigh pikö walaka kïtïl kipimöwon nyo kikonecha Tororöt, wölo kikönecha lö tötasa kighanatenkwa akïghetï atökeghenacha nyu ighisyö nyo wow tya kwenunkwa kïrïp kegh nko kipimöwonto Tororöt nyo kikonecha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.15",
            "verseOrgIds": [
              "2CO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kemukacha nyu kyamta Lökoy cho Karamach ompö koroswe walaka cho lowöch nko akwa amelö tökïmi nyu machata nyo kïkwolocha kegh ighisyo nyo kigha pikö walaka kore anka.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.16",
            "verseOrgIds": [
              "2CO.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.16",
            "verseOrgIds": [
              "2CO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.24"
              },
              "items": [
                {
                  "text": "Yer 9:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïle wölo mwoghöy Kikirut lö, “Nya kïkwol kegh chi anka tïkwïl ompö kïgh nyo kegh Echotyon.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo chi nyo kïchömöy, kïmelö nyo sölöy kegh nyinte poto nyo sölöy Echotyon.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.18",
            "verseOrgIds": [
              "2CO.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulö nko kiyoktoghi putintön",
          "type": "text"
        }
      ]
    }
  ],
