          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.1",
            "verseOrgIds": [
              "2CO.8.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.26"
              },
              "items": [
                {
                  "text": "Rum 15:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïmökecha onkïtunekwa, werköcho, kïgh nyo kigh pöropcho Tororöt ompö kaniseni Makedonia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.1",
            "verseOrgIds": [
              "2CO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïtyam kighöniko kanisenichoni nyoman ompö nyarïl, wölo ki wow ngörekyengwa nyo kimï kïpagh pich cho chang kïrkegh ki mey chane tya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.2",
            "verseOrgIds": [
              "2CO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukan osöwintönchini lö kitötö chane tïkukwa le wölo kimuktoy, akutötö ompö kïtïl choni, akwompö konunöto kegh. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.3",
            "verseOrgIds": [
              "2CO.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisaghecha nyoman ketönöcha chane pöroyïn nyo ghömechini ighisyononi kingöroköy pipö Tororöt, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.4",
            "verseOrgIds": [
              "2CO.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "amelö kikikönecha lö ighöy chane kïgh nyo lata nyoni wölo kinya chane kutö kegh Echotyon akïkonecha kegh tïkwïl, kïrïp kegh nko machata Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.5",
            "verseOrgIds": [
              "2CO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyoni kikïsaghacha Tito nyo kitowï ighisyononi pö chomnyogh kungarakakwa tïkwïl awantena ighisyononi mi kwigho ompö kwenunkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.6",
            "verseOrgIds": [
              "2CO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otïngetekwa kïgh anka tïkwïl. Kighanat nko owesyö nyo kïngölonöy nko kinkïtöt nko kikilöto kegh nyo oghöy tïkwïn cho karamach ompö acha. Nka nyoni kikönecha olïkunekwa pich cho opöghöy pich ompö ighisyononi pö chomnyogh.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.7",
            "verseOrgIds": [
              "2CO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.7",
            "verseOrgIds": [
              "2CO.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö ochikyinokwa, wölo omökan oporu wölo kikiltö kegh pikö walaka kungörokisyö, atamukan nyu onkïtï lö ekïpö man kïtya chomnyenkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.8",
            "verseOrgIds": [
              "2CO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo onkïtökwa pöropcheto Echotyontenyo Yeso Kristo nyo kïrkegh kitïng nyinte kïgh anka tïkwïl, kwigh kegh meywon ompö akwa atökumï kwighakwa alïkuna sïkön ompö meywontönenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.9",
            "verseOrgIds": [
              "2CO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ononwokwa ompö ngölyontononi lö mïchinokwa ye awanya ighisyonanya kyotowukwa könyinay kewonyö. Ki akwa piko tagh cho, melö kyanyaghakwa pat agh, wölo kyotïngetekwa tïkwïl machat agha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.10",
            "verseOrgIds": [
              "2CO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awanya nyu ighisyononi. Osïkö machat nyo wow nyo teno nyoni kyotïngetekwa otini kyotötekwa, opöghisyeghenö kïgh nyo otïngetö ye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.11",
            "verseOrgIds": [
              "2CO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo toköy Tororöt kïgh nyo mököy chi kutötoy amelö nyo mötïngnye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.12",
            "verseOrgIds": [
              "2CO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molenchï kegh kamwaghan lenyoni atökïsïch pikö walaka payasat, osïkökwa nyarïl, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.13",
            "verseOrgIds": [
              "2CO.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "wölo kïmököy kikongityot akanya kungarak tïkukwa cho chang pikö walaka cho tïng rörchin otï le ye atökungarakakwa tïkukwa asïyech ato rarta chikwa atökïkarkegh nyu tïkwïn. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.14",
            "verseOrgIds": [
              "2CO.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.18"
              },
              "items": [
                {
                  "text": "Wuw 16:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïle wölo mwoytoy Kikirut lö, “Melö kitösisyö cho pö chi nyo kighamït cho chang amelö kirarta cho pö chi nyo kighamït cho ngörï.”",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.15",
            "verseOrgIds": [
              "2CO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tito nko pikachi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.15",
            "verseOrgIds": [
              "2CO.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyokyinan Tororöt sörö nyo wow nyo ketö Tito mïkulögh nyo mököy nyoman kungörokokwa lenyini komökan ante! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.16",
            "verseOrgIds": [
              "2CO.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö ompöwölo kicham nyinte saghatencha, wölo kitïng tïkwïl machat nyo wow tya kungwïnchokwa ompö machatenyi kegh. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.17",
            "verseOrgIds": [
              "2CO.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakïyonucha nyinte kungwïn nko werïnyo anka nyo rumunote salatenyi ompö kanisen löwïr nyo pö amtaghpa Lökoy cho Karamach. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.18",
            "verseOrgIds": [
              "2CO.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïmönyoninye onkït, kikïl kanisen nyinte kïlïkwï chi nyo kïrutonecha tïkwïl otini keghöy ighisyonï pö chomnyogh ompö ororyo Echotyon atökuporï kikïniniot nyo pö machatencha nyo karam.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.19",
            "verseOrgIds": [
              "2CO.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.19",
            "verseOrgIds": [
              "2CO.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmökecha keghöpönone kigheghchin anka tïkwïl nyo swongöy kegh nko ropöwontonï pö köromïn pö mu kighecha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.20",
            "verseOrgIds": [
              "2CO.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.4"
              },
              "items": [
                {
                  "text": "Ngt 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïmöchecha keghe man, amelö ompö tawu Echotyon onkït, wölo ompö tawu pich tïkwïl.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.21",
            "verseOrgIds": [
              "2CO.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.21",
            "verseOrgIds": [
              "2CO.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyoni kakïyonucha werïnyo anka kungwïn nko chane nyo kaketyamacha kïnyïl cho chang akesïwecha lö tïng nyinte machat nyo wow nyo pö kingarakat. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.22",
            "verseOrgIds": [
              "2CO.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany ompö Tito, omitan opöghisïyi nko nyinte, kengwïn nyinte wöloni kungarakakwa. Kïkany werköcho choni pkonöy nko nyinte, kï pich cho keyokwï kanisen akï ororyo Kristo chane. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.23",
            "verseOrgIds": [
              "2CO.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oporchinö nyu chane manto chomnyenkwa ompö kanisen löwïr atökunkïtï lö kïtïngetecha man kekwolenö kegh akwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.24",
            "verseOrgIds": [
              "2CO.8.24"
            ]
          }
        }
      ]
    }
  ],
