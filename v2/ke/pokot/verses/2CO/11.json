              "items": [
                {
                  "text": "Ist 9:23-25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kyomitan Damaska akimi chi nyo kiripöy kanasyantanoni nyo kile pröyönto Areta wowïnto korononi. Kitö wowïnoni chichoni kïrip kanasyantanoni atökïnamanïn. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
            "verseOrgIds": [
              "2CO.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CO 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kereytanïn ompö köröp akelutanïn sany ompö pïntö nyo kimi nayat achïwïtan nyu morichi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.33",
            "verseOrgIds": [
              "2CO.11.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sïwïyaghpa Paulö nko ngongut",
          "type": "text"
        }
      ]
