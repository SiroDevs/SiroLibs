            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kikïmungenanïn lïkip kïnyïl sömök, kewirenanïn koghïn kïnyïl akonga, kunyarenanïn meli ompö nanam kïnyïl sömök, atöpan wöloni nangat kïyech nko pöghetunyi kwimön. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.25",
            "verseOrgIds": [
              "2CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
