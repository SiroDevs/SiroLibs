                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wölo kinya Tororöt kïkïlanïn ompö pöropchenyi akulowitanïn kïrkegh otini kitomönye keyïyanïn ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.15",
            "verseOrgIds": [
              "GAL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "akiporwanïn Werïnyi atömanyïl omchï pipö punton Lökoy cho Karamach, melö kyowan ayara chi kiruröt nyonikïny ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.16",
            "verseOrgIds": [
              "GAL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "akimowanye ompö wölini le Yerusalem atotuyö nko kiyoktoghï kïtomö kuyoktanïn nyinte, wölo kyowan panini atany Arapia atolapay amïlan ngat otöngwï Damaska. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.17",
            "verseOrgIds": [
              "GAL.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.26+ACT.9.27+ACT.9.28+ACT.9.29+ACT.9.30"
              },
              "items": [
                {
                  "text": "Ist 9:26-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otöpan wöloni ntökuwonyö könyiswö sömökwï owan nyu atang Yerusalem atotuyö nko Petro, atöpan nko nyinte osis taman nko mut. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.18",
            "verseOrgIds": [
              "GAL.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amelö kyotuyan nko kiyoktoghin anka, kïpoto Yakopo werto ompö Echotyon. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.19",
            "verseOrgIds": [
              "GAL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pö man ngalechete kakirwakwa akunkït Tororöt lö, momïranye putintön.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.20",
            "verseOrgIds": [
              "GAL.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
