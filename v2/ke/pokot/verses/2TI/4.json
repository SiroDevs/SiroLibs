            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kighwanïn nyo gha nyoman Aleksanda nyay le kitonginto kari taghoy. Yokyini Echotyon nyinte kïrïp kegh nko ighisyewutkachi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irip kegh nyinte tïkwïl, ompöwölo kilyoch nyinte ompö köromnyö nyoman ngalechaye kyomtocha.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.15",
            "verseOrgIds": [
              "2TI.4.15"
            ]
          }
        }
