              "type": "text"
            }
          ]
        },
        {
          "text": " “Arosa nyu! Oyonunan werkoyon Eliya kïtomö kwitï asispa ECHOTYON, asis nyo pö otyogh nyo wow nyoman. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
