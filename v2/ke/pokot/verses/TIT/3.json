                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.12"
              },
              "items": [
                {
                  "text": "1Kr 16:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ingarak Sena konetinto kirurut nko Apolo tökutor rutogh lawel tömörörchï kïgh anka tïkwïl ompö or. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.13",
            "verseOrgIds": [
              "TIT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïchini kunet kegh piköcho löwïr kwigh pöghisyewut cho karamach, tökïpöghisyeghö kungaraka pich cho tïng möchut ompö lawel. Merokonye kïtïpï chane otöp nyo puryö kinyiwut.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        }
      ]
    },
