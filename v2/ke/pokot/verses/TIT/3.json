      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nya kïtöpö pöropcho Tororöt nko akwa löwïr.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.15",
            "verseOrgIds": [
