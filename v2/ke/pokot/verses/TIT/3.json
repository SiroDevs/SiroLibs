            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ato oyokunyi Artema anta Tukiko, imukyï nyoman ingwïn Nikopoli wölo omitan, ompöwölo kamachan angwïn otöpö wöloni osiswo kaghïtan. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.12",
            "verseOrgIds": [
              "TIT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
