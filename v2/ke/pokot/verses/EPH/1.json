                "loc": "PSA.8.6"
              },
              "items": [
                {
                  "text": "Tum 8:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
