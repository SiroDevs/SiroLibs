              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ani Paulö nyo le kiyoktoghinto* Kristo* Yeso ompö machata Tororöt nyete, kakirwokwa pipö Tororöt cho omitö Epeso ochï cho ghönote ompö Kristo Yeso.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.1",
