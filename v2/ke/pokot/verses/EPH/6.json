            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akwa monïng, ateka yiyikwo ompö Echotyon, ompöwölo karam lenyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.1",
            "verseOrgIds": [
              "EPH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
