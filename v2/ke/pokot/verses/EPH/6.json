            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïkany akwa papotïn, magh monekwo kulilisyö, wölo anama chane ompö pïröt nko kinetut pö Echotyon.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.4",
