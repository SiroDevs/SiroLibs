            "sid": "EPH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo alatan chi nyo ghyongchini ngaleko korenyi ompö kore anka, ompö Lökoy cho Karamach kïrkegh ochan ratate. Osoghwante atamuk angalan ompö nyakanat le otini mïchinanïn alïkwï.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.20",
            "verseOrgIds": [
              "EPH.6.20"
            ]
          }
        }
