        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.35",
            "verseOrgIds": [
              "ISA.37.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ISA 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö oghononi malaykayanta ECHOTYON wölo kimöngöy pipö Asirya akïpar pipö lïk 185,000. Nyini kiyech atole asïyech, kelö kïtopön kimeghö chane löwïr! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.36",
            "verseOrgIds": [
              "ISA.37.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ISA 37:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïchïchïka nyu pöytoghintö Senakerip akïmïla kutang Ninawi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.37",
            "verseOrgIds": [
              "ISA.37.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ISA 37:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi asistanka ato kisogho nyinte koto tororötanyi Nisrok, kïpara chokon werkachi odeny, Adramelek nko Syareser akupertoy kutang koro Ararat. Kuker nyinte werïnyi nyo kïkuro Esaradon kïpayta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.38",
            "verseOrgIds": [
              "ISA.37.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kösotyö nko astaghpa pöytoghin Esekia",
          "type": "text"
        }
      ]
