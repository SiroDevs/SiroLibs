              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.1",
            "verseOrgIds": [
              "ISA.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
