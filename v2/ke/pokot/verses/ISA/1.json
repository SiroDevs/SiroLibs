              "attrs": {
                "loc": "2KI.15.1+2KI.15.2+2KI.15.3+2KI.15.4+2KI.15.5+2KI.15.6+2KI.15.7"
              },
              "items": [
                {
                  "text": "2Pöy 15:1-7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "15:32–16:20; 18:1–20:21; 2Ot 26:1–32:33.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sïwïyaghtin cho pö Yuda nko Yerusalem cho kiporchï Tororöt Isaya wero Amos ato kipöytoy Usia nko Yotam nko Aas nko Esekia Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.1",
            "verseOrgIds": [
              "ISA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kachil Tororöt pikachi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
