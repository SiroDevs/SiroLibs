            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïrongöy ompö chini le moneku kegh akepa kelat atökïpöghisyechï pöytoghinto Papilonia ompö konyi.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
