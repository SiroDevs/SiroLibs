                "loc": "MAT.4.15"
              },
              "items": [
                {
                  "text": "Mat 4:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wölo möminye or nyo chïwïto chane kömpölelyononi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.1",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pöytoghin nyo tökungwïnöy",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh koro Saplon nko nyo pö Naptali kesas ompö osis cho kipö tagh, wölo kwigh kïtörorit ompö osisweko lötï, kïngetunö nanampa Kwen kutang kongasis ntökwitïta Yordan antakwagh ntökwit ompö nyini le Kalilaya möngöy pipö punton.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.1",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mungöy ECHOTYON Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyokyï Echotyon ngölyonto kirwoköt pipö Israel, pïchoni pö ara Yakopo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.8",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkïtu chi anka tïkwïl nyo pö Israel nyo möngöy kanasyanta Samaria lö kegh nyinte kïyoni. Kwolöy kegh chane otï le ye akïmen lö, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Körulyö korichay pö mataparen, wölo kïtekocha korichoni koghïn cho kikipat. Kakïtör pïrompïris pö makany, wölo kikerenecha pïrompïris pö tarakit.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.10",
            "verseOrgIds": [
              "ISA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.10",
            "verseOrgIds": [
              "ISA.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, ketö ECHOTYON sirmoy pung pö Resin tökïporyeghö chane. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.11",
            "verseOrgIds": [
              "ISA.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mito pipö Sirya kongasis, kïmi pipö Pilisti to, kingany chane kutïwekwa atökwam Israel. Wölo kïrkegh kighisyö choni löwïr melö kiwany nörekyo ECHOTYON, wölo tökughïtoy ewunyi kïnömöy sitenyi nyo mungoy pikachi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.12",
            "verseOrgIds": [
              "ISA.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.12",
            "verseOrgIds": [
              "ISA.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kakitö pipö Israel, kïrkegh kichop kong ECHOTYON Kimuktoghin chane. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.13",
            "verseOrgIds": [
              "ISA.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, töni ECHOTYON kintöghoghi Israel nyarïl nko pikökwa. Töröy asis akonga mötöwekwa nko töronkwöyikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.14",
            "verseOrgIds": [
              "ISA.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku poyï nko pich cho konyïtote mötöwe, kïlïkwï töronkwöyi werkoy cho netöy pich putintön! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.15",
            "verseOrgIds": [
              "ISA.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kimït pïchoni kintöghoghichini kitosonchö, akwigh kïkwongkwongisyö. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.16",
            "verseOrgIds": [
              "ISA.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka nyoni nyu kïgh nyo ighöy Echotyon möchïwïtyö pikökwa cho le chumwak, amesyonchï pönonkökwa nko mïsïktinekwa, ompöwölo kighachitu pikö tïkwïl, akïngölonöy kutïweko pïchoni löwïr ngala sölwontön. Akï kïrkegh keghisyö lenyoni, kïmelö wonyot nörekyo ECHOTYON, wölo tökughïtoy ewunyi kïnömöy sitenyi nyo mungoy pikachi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.17",
            "verseOrgIds": [
              "ISA.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.17",
            "verseOrgIds": [
              "ISA.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo nöghöy ghöyityo pich le ma, nyo wuröy tapalak nko kato. Pelöy kïkarkegh nko ma nyo nögho wuw, nyo yumtoy kegh parak akuyen yïm le poltoy. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.18",
            "verseOrgIds": [
              "ISA.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelöy ECHOTYON Kimuktoghin koronete kïtïryalit ompöwölo kanarek nyinte, pelöy pikö kïnöghyö le kwen cho kinoghöy, amelö mito chi atoni nyo söröpchini werïngwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.19",
            "verseOrgIds": [
              "ISA.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Söro kegh pich omisyewut cho kemï kïnyorï ompö kore kïmïkul, wölo melö pïghyongi nyonikïny. Omöy chane ompö chini le monekwa! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.20",
            "verseOrgIds": [
              "ISA.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poryot pipö Manase nko cho pö Epraim, atolapay kutuyö kegh akïporyeghö Yuda. Akï kïrkegh keghisyö lenyoni, kïmelö wonyot nörekyo ECHOTYON, wölo tökughïtoy ewunyi kïnömöy sitenyi nyo mungoy pikachi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.21",
            "verseOrgIds": [
              "ISA.9.21"
            ]
          }
        }
      ]
    }
  ],
