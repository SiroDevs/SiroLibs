              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo otini kasïwekwa monïng cho okonokwa, onkïtukwa nyu lö ochan Tororöt pö Israel nyo Tïlil. Okonyïtanïkwa, atïlil kaynatenyan. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.23",
            "verseOrgIds": [
              "ISA.29.23"
            ]
          }
        },
        {
