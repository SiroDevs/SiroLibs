                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïlïmo chöghöto köpepoy kor nyo mi lalwatïna Etopya antakwagh. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yontoy piko korononi cho ghyongchini korengwa cho wutu lalwa Nile ompö tirïpken cho kikïnapa sus cho pito wölo le nyonyön, akelenchï omïlonchenö korengwo chona kakïyonwok oryöghöy lawel! Ape omwochinö ngölyon piko korengwo nyo kipesyö lalwatïna, pikökwo cho koghöch cho köromöch akwowesöch pikökwa cho koghöch akïtïlyönglyöng porwöy, akewöghöy ompö ngwïny kïmïkul.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera chi anka tïkwïl nyo imitö ngwïnyinï! Otini kasïwa machey nyo kakiporunö kutïng parak, otopön! Kïkany ato kïkut kontï, alïm! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kölenchanïn ECHOTYON, “Otopönunan ompö yïm ompö sison kïle wölay ghömïtïtoy kegh röyöntö atay layate nöngötus ompö osiswö ilö, alïwunan le asis nyo lïwu pöghet. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo wuröy punyon pipö Etopya kïle kwïle, kïle wölo mutïtoy rotwö mori keti sapipun kïtomö kïpïtï akwechi, otini kawirta tapïkoy akïrörochö löwïr akïnam akwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omöy töritwö nko tyonkïn mïntïruchko pikökwa cho pö lïk. Omöy töritwö osiswo kömöy, kwam tyonkïn osiswo kaghïtan.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
