          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itu asis akonga ato toköy ECHOTYON Kimuktoghin ropöw cho pkono koronete kepesyö lalwatïna, mito pich cho köromöch akwowesöch, pich cho koghöch akïtïlyönglyöng porwöy, chane cho kiwöghöy ompö ngwïny kïmïkul. Pkonöy chane akïpusï kutïng pö Sayon,* wölini kïsogho ECHOTYON Kimuktoghin.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mungöy Tororöt pipö Misri",
          "type": "text"
        }
      ]
    }
