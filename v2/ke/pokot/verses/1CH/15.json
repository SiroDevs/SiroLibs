  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "1CH 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtekyï kegh kö Daudi ompö kanasyanta Daudi, akïpor wölo kitöni Santuku Muma Tororöt akïparta Ema. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.1",
            "verseOrgIds": [
              "1CH.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.8"
              },
              "items": [
                {
                  "text": "Krt 10:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlö, “Möminye chi anka nyo sïtöy Santuku Muma kïpoto pipö Lawi, ompöwölo kikïl ECHOTYON chane kïsït Santuku Muma akïpöghisyechï nyinte kokay.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.2",
            "verseOrgIds": [
              "1CH.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutuyö Daudi pipö Israel löwïr ompö Yerusalem atökïpa kïsïtï Santuku Muma wölo kikwigh Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.3",
            "verseOrgIds": [
              "1CH.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïkur monïngo Aron nko cho pö pipö Lawi: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.4",
            "verseOrgIds": [
              "1CH.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "cho pö ara Koat ompö pipö Lawi kï Uriel nyo kintöghoghchini pikökwa cho le 120, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.5",
            "verseOrgIds": [
              "1CH.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "cho pö ara Merari kï Asaya nyo kintöghoghchini pich cho le 220, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.6",
            "verseOrgIds": [
              "1CH.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "cho pö ara Kersyon kï Yoel nyo kintöghoghchini pich cho le 130, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.7",
            "verseOrgIds": [
              "1CH.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "cho pö ara Elisapan kï Syemaya nyo kintöghoghchini pich cho le 200, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.8",
            "verseOrgIds": [
              "1CH.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "cho pö ara Epron kï Eliel nyo kintöghoghchini pich cho le 80, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.9",
            "verseOrgIds": [
              "1CH.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "cho pö ara Usiel kï Aminadap nyo kintöghoghchini pich cho le 112.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.10",
            "verseOrgIds": [
              "1CH.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.10",
            "verseOrgIds": [
              "1CH.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur Daudi Sadok nko Apyatar ompö tïsï nko pipö Lawi cho le mut nko akonga: Uriel nko Asaya nko Yoel nko Syemaya nko Eliel nko Aminadap. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.11",
            "verseOrgIds": [
              "1CH.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï pipö Lawi, “Ochikwa kintöghoghi pipö Lawi, ye nyu otïlilö kegh nko pikökwo atosïtunö Santuku Muma nyo pö ECHOTYON Tororöt pö Israel kungwïn wölo kaghan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.12",
            "verseOrgIds": [
              "1CH.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kimosïtukwanye atanye le tagh, kïnyölechecha Tororöt, ompöwölo melö kikïripöcha le wölo kikïmöktoy.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.13",
            "verseOrgIds": [
              "1CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutïlil kegh tïsï nko pipö Lawi, atökwipï Santuku Muma nyo pö ECHOTYON Tororöt pö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.14",
            "verseOrgIds": [
              "1CH.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.14"
              },
              "items": [
                {
                  "text": "Wuw 25:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsït pipö Lawi Santuku Muma nyo pö Tororöt ompö löyoswekwa kïsïtö ket, kïle ato kimwa Musa kïrïp kegh nko ngölyonto ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.15",
            "verseOrgIds": [
              "1CH.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.15",
            "verseOrgIds": [
              "1CH.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï Daudi kintöghoghi pipö Lawi kïkïl werkökwa cho tumöy tumwöy akïpöghisyegho pilimpin nko kayampen. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.16",
            "verseOrgIds": [
              "1CH.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkïl pipö Lawi pïchï: Eman wero Yoel nko werïngwa Asap wero Perekia nko Etan wero Kusyaya nyo pö ara Merari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.17",
            "verseOrgIds": [
              "1CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkïl ngat tïlyayikwa atökungarak chane: Sakaria nko Yasiel nko Syemiramot nko Yeiel nko Uni nko Elyap nko Penaya nko Maaseya nko Matatia nko Elipeleu nko Mikneia. Cho kiripöy kukat kï: Oped Emod nko Yeiel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.18",
            "verseOrgIds": [
              "1CH.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumï cho kilïwöy karïn cho silyot kï: Eman nko Asap nko Etan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.19",
            "verseOrgIds": [
              "1CH.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pich cho kipïtöy pïkantis cho mïnkech kï, Sakaria nko Asyel nko Syemiramot nko Yeiel nko Uni nko Elyap nko Maaseya nko Penaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.20",
            "verseOrgIds": [
              "1CH.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pich cho kipïtöy pïkantis cho echön kï: Matitia nko Elipeleu nko Mikneia nko Oped Edom nko Yeiel nko Asasia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.21",
            "verseOrgIds": [
              "1CH.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.21",
            "verseOrgIds": [
              "1CH.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kekïl Kenania kïlïkwï kintöghoghinto tumï cho pö Lawi ompöwölo ki tumin nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.22",
            "verseOrgIds": [
              "1CH.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perekia nko Elkana nko Oped Edom cho kiripöy Santuku Muma. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.23",
            "verseOrgIds": [
              "1CH.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tïsï cho kikutöy kontï ompö tawu Santuku Muma kï Syepania nko Yosyapat nko Netanel nko Amasay nko Sakaria Penaya nko Elieser. Kilïkwï tïkwïl Oped Edom nko Yeia ripi santukunoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.24",
            "verseOrgIds": [
              "1CH.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakïsït Santuku Muma Yerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.24",
            "verseOrgIds": [
              "1CH.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö Daudi nko kintöghoghi Israel nko yetïntino pipö lïk kutang kö pö Oped Edom kïsïtï Santuku Muma akingörekyote chane tya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.25",
            "verseOrgIds": [
              "1CH.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitö chane ECHOTYON amöros nyo pö eghin mut nko odeny nko kechir mut nko odeny ompöwölo kingarak Tororöt pipö Lawi cho sïtöy Santuku Muma. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiloköy Daudi sïra katani, akiloköy tumï tïkwïl nko Kenania kintöghoghintengwa nko pipö Lawi cho kisïtöy Santuku Muma. Akiloköy Daudi epod.* ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.27",
            "verseOrgIds": [
              "1CH.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwipï pipö Israel Santuku Muma Yerusalem akuteghyot ompö ngörekyö, akïkutöy kontin nko kuy nko toasin nko kurerun.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 15:28"
          },
          "items": [
