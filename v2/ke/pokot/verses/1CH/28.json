      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï Daudi yetïntino pipö Israel kïtuyechï Yerusalem: yetïntono ortïn nko cho kighöy ighisyö nyo pö ka pöytoghin nko yetïntino korïn nko cho kiripöy tïkwïn nko cho kiyokwïyi tïch cho pö pöytoghin nko werkachi nko yetïntono ka pöytoghin nko yetïntino pipö lïk nko pich walaka cho konyïtote.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.1",
            "verseOrgIds": [
              "1CH.28.1"
            ]
          }
        }
      ]
    },
    {
