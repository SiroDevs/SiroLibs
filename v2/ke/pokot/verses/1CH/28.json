            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.1+2SA.7.2+2SA.7.3+2SA.7.4+2SA.7.5+2SA.7.6+2SA.7.7+2SA.7.8+2SA.7.9+2SA.7.10+2SA.7.11+2SA.7.12+2SA.7.13+2SA.7.14+2SA.7.15+2SA.7.16"
              },
              "items": [
                {
                  "text": "2Sam 7:1-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.17.1+1CH.17.2+1CH.17.3+1CH.17.4+1CH.17.5+1CH.17.6+1CH.17.7+1CH.17.8+1CH.17.9+1CH.17.10+1CH.17.11+1CH.17.12+1CH.17.13+1CH.17.14"
              },
              "items": [
                {
                  "text": "1Ot 17:1-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kughyongö Daudi tawungwa akïlenchï, “Oterwante pikachu. Kyomökan oteke kö nyo pö Santuku Muma* nyo pö ECHOTYON, wölo tïköy nyinte. Kö kyatatan otekyï kö nyo kikonyïto nyinte, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.2",
            "verseOrgIds": [
              "1CH.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wölo kitaghenanïn nyinte, ompöwölo ochan chipö lïk akiparanyi pich cho chang. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.3",
            "verseOrgIds": [
              "1CH.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïlanïn nko monechu ECHOTYON Tororöt pö Israel apayta Israel kokay. Kikïl ara Yuda atökïpayta, kïkïl ompö ara Yuda koto paponyan. Kïkïlanïn ompö koto paponyan alïkwan pöytoghinto Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.4",
            "verseOrgIds": [
              "1CH.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikonïn ECHOTYON wor cho chang, kïkïl Solomon ompö choni löwïr kïlïkwï pöytoghin ompö Israel, paytaghpa ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.5",
            "verseOrgIds": [
              "1CH.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.5",
            "verseOrgIds": [
              "1CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïlenchanïn ECHOTYON, ‘Werïngu Solomon nyo teköy Konyan. Kakïlan nyinte kïlïkwï werïnyan alïkwan kwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.6",
            "verseOrgIds": [
              "1CH.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochïchiman paytaghtanyi kokay atotas tagh nyinte kïrip kirurutköchan akïrïp ngalechan lenyini ighöy ye.’",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.7",
            "verseOrgIds": [
              "1CH.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.7",
            "verseOrgIds": [
              "1CH.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omwowokwa ye nyu pikachu ompö tawu Tororöt nko tuyonï pö Israel pipö ECHOTYON lö, arïp kïgh anka tïkwïl nyo mwowekwa ECHOTYON Tororötïnyo, atö onyorunö koronï karam, apïsyinikwa monekwo kïmïl kokay.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.8",
            "verseOrgIds": [
              "1CH.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.8",
            "verseOrgIds": [
              "1CH.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Daudi Solomon, “Werïnyu, inkïtï Tororöt pö papongu aipöghisyechï nyinte ompö mïkulögh akonga nko kinonut akonga. Nkït nyinte kinonsyewutköcha nko möchutköcha, ato iwechinyi nyinte kïtokinyi. Wölo ato itaghanyi nyinte, kïtöghinyi kokay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.9",
            "verseOrgIds": [
              "1CH.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkïtunö lö kikïkïlinyi ECHOTYON ateteka Konyi nyo tïlil. Igha ye nyu aigh ompö nyakanat.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.10",
            "verseOrgIds": [
              "1CH.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.10",
            "verseOrgIds": [
              "1CH.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö Daudi werïnyi Solomon tötut cho pö tekata Kö pö Tororöt,* cho pö kari karïn nko kori walaka nko cho pö Wölo Tïlil Tya* kïlöstegho ngokï. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.11",
            "verseOrgIds": [
              "1CH.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö tïkwïl tötut cho kitïng nyinte ompö kinonutkachi, cho pö Kö pö Tororöt okumpö sany nko korïn cho kimi nko korïn cho pö Kö pö Tororöt nko tïkwïn cho kakitïlilchï ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.12",
            "verseOrgIds": [
              "1CH.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akutö tïkwïl tötut cho pö wölo ightoy ighisyengwa tïsï nko pipö Lawi, kwigh ighisyö ompö Kö pö Tororöt akïrip karïn cho kïpöghisyegho ompö Kö pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.13",
            "verseOrgIds": [
              "1CH.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïmwochï nyinte lö silpa nko koltin cho tya cho kïpöghisyegho ompö karïn ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.14",
            "verseOrgIds": [
              "1CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko kitömöwö nko atay kikönoghöy kitömöwö ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.15",
            "verseOrgIds": [
              "1CH.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko meseni silpa nko meseni koltin cho kikitoni makatin cho kïropchini Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.16",
            "verseOrgIds": [
              "1CH.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwochï nyinte lö koltin cho karamach cho tya cho kigho umen nko pakulin nko alepïtis nko silpa nko koltin cho tya cho kikigho söpïryen, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.17",
            "verseOrgIds": [
              "1CH.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko koltin cho karamach cho tya cho kikigho atay kïpelo tïkwïn cho ngutoy cho onyïn nko cho kigho nkari nyo pö kerupimtinechay* syolöy köpepokökwa ompö paraku Santuku Muma nyo pö ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.18",
            "verseOrgIds": [
              "1CH.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö pöytoghin Daudi, “Mi chï löwïr tötut cho kikir kïrïp kegh nko ngala ECHOTYON cho kikonanïn amwa.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.19",
            "verseOrgIds": [
              "1CH.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.19",
            "verseOrgIds": [
              "1CH.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï Daudi werïnyi Solomon lö, “Iawesitï ainyakanitï. Torö ighisyö amewöghisyö. Mi nko nyi ECHOTYON Tororöt nyo opöghisyechinan. Möpïsteninyinye, töpo nko nyi ntökïtenö wanganyi ighisyo Kö pö Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.20",
            "verseOrgIds": [
              "1CH.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiketö ighisyewutkökwa tïsï nko pipö Lawi cho ighöy ompö Kö pö Tororöt. Kikïcham pich kengarakinyi cho tïng tïnganat nyo pö tïkwïn cho chang, intöghoghchinenyi pïchï löwïr nko kintöghoghikwa.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.21",
            "verseOrgIds": [
              "1CH.28.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ropöw cho kïteko Kö pö Tororöt",
          "type": "text"
        }
      ]
    }
  ],
