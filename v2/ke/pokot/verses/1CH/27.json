          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chï kï pich cho kighyongchï tïpö pöytoghin Daudi:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.25+1CH.27.26+1CH.27.27+1CH.27.28+1CH.27.29+1CH.27.30+1CH.27.31",
            "verseOrgIds": [
              "1CH.27.25",
              "1CH.27.26",
              "1CH.27.27",
              "1CH.27.28",
              "1CH.27.29",
              "1CH.27.30",
              "1CH.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiruri Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 27:25"
          },
          "items": [
