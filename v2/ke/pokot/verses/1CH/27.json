        },
        {
          "text": "Chï kï kintöghoghi kori pipö Israel nko ortïn nko yetïntin cho kighöy ighisyo paytagh. Ompö arawa anka tïkwïl nyo pö köny, kimi pich cho le 24,000 cho kighöy Ighisyö ompö ngwïnyi yetïn pö lïk nyo pö kintöghoghinto arawanoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.1",
            "verseOrgIds": [
              "1CH.27.1"
            ]
          }
        }
