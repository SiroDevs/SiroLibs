            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïma Saulö ompöwölo kighchï ECHOTYON nyo gha. Kimarïpnye kirurut pö ECHOTYON, wölo kïwö kitepa ngal chepsoköytin ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "otinö kötö tepo ECHOTYON. Kïlenyona kïpar ECHOTYON nyinte akutö paytaghtö Daudi wero Yese.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kalïkwï Daudi pöytoghinto Israel nko Yuda",
          "type": "text"
        }
      ]
    }
