      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chï kï werpö Yakopo: Rupen nko Simion nko Lawi nko Yuda nko Isakar nko Saplon ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.1",
            "verseOrgIds": [
              "1CH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Dan nko Yosep nko Penchamen nko Naptali nko Kad nko Asyer. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.2",
            "verseOrgIds": [
              "1CH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werpö Yuda kï Er nko Onan nko Syela, kïyï chete le sömök Patsyua nyo pö Kanan, kigha otöp nyo pö Er wero Yuda nyo tagh, ntökïpar ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.3",
            "verseOrgIds": [
              "1CH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyichï potïchtanyi Tamar wor odeny, Peres nko Sera kitïng Yuda wor mut löwïr.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.4",
            "verseOrgIds": [
              "1CH.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.4",
            "verseOrgIds": [
              "1CH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werpö Peres kï: Esron nko Amul. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.5",
            "verseOrgIds": [
              "1CH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werpö Sera kï: Simri nko Etan nko Eman nko Kalkol nko Dara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.6",
            "verseOrgIds": [
              "1CH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.1"
              },
              "items": [
                {
                  "text": "Yos 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Karmi weri akonga nyo kikïkuro Akar nyay kipchï pipö Israel nyarïl ompöwölo kiwïng tïkwïn cho kikengotyï Tororöt. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.7",
            "verseOrgIds": [
              "1CH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Etan weri akonga nyo kikïkuro Asaria.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.8",
            "verseOrgIds": [
              "1CH.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ara pöytoghin Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.8",
            "verseOrgIds": [
              "1CH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Esron wor sömök: Yeramel nko Ram nko Kalep. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.9",
            "verseOrgIds": [
              "1CH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ram kï papoto Aminadap. Aminadap kï papoto Nasyon, nyo ki wow ompö werpö Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.10",
            "verseOrgIds": [
              "1CH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasyon kï papoto Salma, Salma kï Poas, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.11",
            "verseOrgIds": [
              "1CH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poas kï papoto Oped, Oped kï papoto Yese. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.12",
            "verseOrgIds": [
              "1CH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Yese wor mut nko odeny, nyo tagh kï Elyap, kïrïpöy Apinadap nko Syimea nko ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.13",
            "verseOrgIds": [
              "1CH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netanel nko Radai ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.14",
            "verseOrgIds": [
              "1CH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Osem nko Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.15",
            "verseOrgIds": [
              "1CH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tipikwa kï: Seruya nko Apikail. Kitïng Seruya chepö Yese wor sömök: Apisyay nko Yoap nko Asael. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.16",
            "verseOrgIds": [
              "1CH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïyï Apikail Amasa paponyi kï chete nyo pö ara Ismael.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.17",
            "verseOrgIds": [
              "1CH.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Monïngo Esron",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.17",
            "verseOrgIds": [
              "1CH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyorï Kalep wero Esron monïng ompö korkenyi Asupa nko Yeriot, werkachi chï: Yesyer nko Syopap nko Ardon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.18",
            "verseOrgIds": [
              "1CH.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrapas Asupa, kwip Kalep Eprat nyo kiyichï nyinte weri nyo kïkuro Ur. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.19",
            "verseOrgIds": [
              "1CH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ur kï papoto Uri, Uri kï papoto Pesalel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.20",
            "verseOrgIds": [
              "1CH.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.20",
            "verseOrgIds": [
              "1CH.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato kitïng Esron könyis 60, kwip chepö Makir papoto Kiliad. Kïyichï nyinte weri nyo kikïkuro Sekup, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.21",
            "verseOrgIds": [
              "1CH.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sekup kï papoto Yair nyo kitïng kanastin 23 ompö koro Kiliad. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.22",
            "verseOrgIds": [
              "1CH.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kïcheng Kesyur nko Aram chane kanastin 60 kïmi nko kanastin cho mïnkech, Yair nko Kenat nko cho riköy choni. Pich cho kimöngöy wöloni kö monïngo Makir papoto Kiliad. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.23",
            "verseOrgIds": [
              "1CH.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kirapas Esron, kïlïtï kö Kalep korketo paponyi Esron nyo kikïkuro Eprata, kïyichï nyinte weri nyo kikïkuro Asyur nyo kitek kanasyanta Tekoa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.24",
            "verseOrgIds": [
              "1CH.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Monïngo Yeramel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.24",
            "verseOrgIds": [
              "1CH.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Yeramel poretya Esron wor mut: Ram poretye nko Puna nko Oren nko Osem nko Aiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.25",
            "verseOrgIds": [
              "1CH.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Yeramel korketö anka nyo kikïkuro Atara, yoto Onam. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.26",
            "verseOrgIds": [
              "1CH.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werpö Ram poretya Yeramel kï: Maas nko Yamin nko Eker. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.27",
            "verseOrgIds": [
              "1CH.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werpö Onam kï: Syamay nko Yada. Werpö Syamay kï: Nadap nko Apisyur. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.28",
            "verseOrgIds": [
              "1CH.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kip Apisyur korka nyo kikïkuro Apiail nyo kiyichï nyinte wor odeny, Apan nko Molid. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.29",
            "verseOrgIds": [
              "1CH.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werpö Nadap kï: Seled nko Apaim, wölo kima Selid akimötïngnye monïng. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.30",
            "verseOrgIds": [
              "1CH.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apaim kï papoto Isyi, Isyi kï papoto Syesyan, Syesyan kï papoto Alai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.31",
            "verseOrgIds": [
              "1CH.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werpö Yada werto ompö Syamay kï: Yeter nko Yonatan, wölo kima Yeter akimötïngnye monïng. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.32",
            "verseOrgIds": [
              "1CH.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werpö Yonatan kï: Pelet nko Sasa. Chete löwïr kï monïngo Yeramel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.33",
            "verseOrgIds": [
              "1CH.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimötïngnye weri Syesyan kïpoto tipïn, wölo kitïng sekeyon nyo pö Misri nyo kikïkuro Yara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.34",
            "verseOrgIds": [
              "1CH.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyilchï sekeyontonay cheptanyi, kïnyorï chane weri nyo kikïkuro Atai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.35",
            "verseOrgIds": [
              "1CH.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atai kï papoto Natan, Natan kï papoto Sapad. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.36",
            "verseOrgIds": [
              "1CH.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sapad kï papoto Eplal, Eplal kï papoto Oped. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.37",
            "verseOrgIds": [
              "1CH.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oped kï papoto Yeu, Yeu kï papoto Asaria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.38",
            "verseOrgIds": [
              "1CH.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaria kï papoto Eles, Eles kï papoto Eleasa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.39",
            "verseOrgIds": [
              "1CH.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleasa kï papoto Sismai, Sismai kï papoto Syalum. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.40",
            "verseOrgIds": [
              "1CH.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Syalum kï papoto Yekamia, Yekamia kï papoto Elisyama.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.41",
            "verseOrgIds": [
              "1CH.2.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Monïnge walaka cho pö Kalep",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.41",
            "verseOrgIds": [
              "1CH.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werto ompö Yeramel poretya Kalep kï Mesya. Mesya kï papoto Sip nyo kile papoto Maresya, papoto Epron. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.42",
            "verseOrgIds": [
              "1CH.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werpö Epron kï: Kora nko Tapua nko Rekem nko Syema. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.43",
            "verseOrgIds": [
              "1CH.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Syema kï papoto Raam papoto Yorkeam, Rekem kï papoto Syamay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.44",
            "verseOrgIds": [
              "1CH.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Syamay kï papoto Maon, Maon kï papoto Petsur. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.45",
            "verseOrgIds": [
              "1CH.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Kalep chemïnïngwö* nyo kikïkuro Epa, nyo kiyiyï wor sömök: Aran nko Mosa nko Kases, kitïng Aran werïnyi nyo kikïkuro Kases. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.46",
            "verseOrgIds": [
              "1CH.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CH 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werpö Yadai kï: Rekem nko Yotam nko Kesyan nko Pelet nko Epa nko Syaap. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.47",
            "verseOrgIds": [
              "1CH.2.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1CH 2:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Kalep chemïnïngwö anka nyo kikïkuro Maaka, nyo kiyichï nyinte wor odeny, Syaper nko Tirana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.48",
            "verseOrgIds": [
              "1CH.2.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CH 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyï ngat ato le löt wor odeny, Syaap nyo kitek kanasyanta Madmana nko Syepa nyo kitek kanastina Makpena nko Kipea nko cheptanyi nyo kikïkuro Aksa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.49",
            "verseOrgIds": [
              "1CH.2.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CH 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chete kï monïngo Kalep:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.50",
            "verseOrgIds": [
              "1CH.2.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CH 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ur kï poretye, kikïkuro korkenyi Eprata. Syopal wero Ur nyo kitek kanasyanta Kiryat Yearim, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.50",
            "verseOrgIds": [
              "1CH.2.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CH 2:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïtek werïnyi nyo pö odeny nyo kïkuro Salma Petleem, kïtek weri nyo pö sömök nyo kikïkuro Arep Petkader.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.51",
            "verseOrgIds": [
              "1CH.2.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Monïngo Daudi",
          "type": "text"
        }
      ]
    }
