              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï ECHOTYON pipö Israel löwïr kughyongö tawu Solomon akwigh nyinte kwororit kïtïl pöytoghin anka nko anka nyo kipayta Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
