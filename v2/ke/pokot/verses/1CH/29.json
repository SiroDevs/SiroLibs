              "type": "text"
            }
          ]
        },
        {
          "text": "Kicham yetïntinö nko pipö lïk nko chini le werpö Daudi kïlïkwï Solomon pöytoghin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.24",
