              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirate ngala Daudi ompö kitapuna werkoy sömök: Samwel nko Natan nko Kad. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.29",
            "verseOrgIds": [
