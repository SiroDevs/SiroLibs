              "type": "text"
            }
          ]
        },
        {
          "text": "Kirapas nyinte ato kikïyosit, kï monkoryon akïkonyïtote, kïcheng werïnyi Solomon ngacharu kïlïkwï pöytoghin. ",
          "type": "text",
          "attrs": {
