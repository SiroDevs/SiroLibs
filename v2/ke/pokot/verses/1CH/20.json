              },
              "items": [
                {
                  "text": "2Sam 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kintöghoghchï Yoap pipö lïk akupokyï koro pipö Amon, ompö kitoröto köny nyo kirïptoy ato kipetöy pöytoghï poryot, akimi Daudi Yerusalem. Kïnam chane kanasyanta Rapa akïporyeghö akuwur. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.1",
            "verseOrgIds": [
              "1CH.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicheng Daudi tenta karïn nyo kimi mötïto körkeyïntangwa akutö mötïnyi kitenö nïkisyenyi kilen 34 akimi ori koghïn cho pö olyot. Kipï pöröw cho chang ompö kanasyantanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnömï pikö cho kimi kanasyante akïtörö mïsïmenö nko köpempoy nko oywöy, kighchï lenyoni tïkwïl pipö kanastina pipö Amon. Atolapay kïmïla Daudi Yerusalem nko pikachi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Köporyö pipö Israel nko pipö Pilisti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
