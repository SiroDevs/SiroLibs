      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïsït Santukunay pö Muma akutö Ema nyo kökikïtekyï Daudi. Atolapay kutö ECHOTYON amöros nko ropöwo pöghisyö. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.1",
            "verseOrgIds": [
              "1CH.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiwany Daudi kutötö amöros, kusoyön pich ompö kaynata ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.2",
            "verseOrgIds": [
              "1CH.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akutö pipö Israel löwïr cho kile kor nko mïron, makatyan nko peny nko sapipun cho kikiyam.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.3",
            "verseOrgIds": [
              "1CH.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.3",
            "verseOrgIds": [
              "1CH.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkïl Daudi pipö Lawi cho kintöghoghchini saghat ompö tawu Santuku Muma,* cho kitumöy akïkwolöy ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.4",
            "verseOrgIds": [
              "1CH.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikïl Asep kïlïkwï kintöghoghinte, kïrïptoy Sakaria nko Yeiel nko Syemiramot nko Yeiel nko Matitia nko Elyap nko Penaya nko Oped Edom nko Yeiel cho kikutöy kurerï, kïpïtöy Asap pïkan, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.5",
            "verseOrgIds": [
              "1CH.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïkutöy kontin Penaya nko Yaasiel ompö tawu Santuku Muma. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.6",
            "verseOrgIds": [
              "1CH.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitö Daudi atoni Asap nko pikökwa pö Lawi kïlïkwï cho kwolöy ECHOTYON ompö tumwöy.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.7",
            "verseOrgIds": [
              "1CH.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tum pö sölut",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö pich löwïr, “Amen!”* Nya kïkwolö ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.36",
            "verseOrgIds": [
              "1CH.16.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kasagha pipö Israel Yerusalem nko Kipyon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.36",
            "verseOrgIds": [
              "1CH.16.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutö Daudi Asap nko werkökwa kïpöghisyö ompö tawu Santuku Muma chik. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.37",
            "verseOrgIds": [
              "1CH.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingörekyö chane Oped Edom nko Yedutun nko werkökwa cho le 16. Kiripöy kukat Osa nko Oped Edom.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.38",
            "verseOrgIds": [
              "1CH.16.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.38",
            "verseOrgIds": [
              "1CH.16.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipïsï Daudi Sadok nyo le tïsin nko tïsi walaka kïtat ngala saghat ompö Ema nyo mi ECHOTYON* ompö tïkumwoko Kipyon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.39",
            "verseOrgIds": [
              "1CH.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipelöy chane amöros tökwoghö nko mönon, le wölo kikir ompö kirurut cho kitö ECHOTYON Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.40",
            "verseOrgIds": [
              "1CH.16.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 16:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi chane nko Eman nko Yedutun nko pikö walaka cho kikïkïl kïtum akuyokyï sörö ECHOTYON ompö chomnyenyi nyo töpo kokay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.41",
            "verseOrgIds": [
              "1CH.16.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 16:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiripöy Eman nko Yedutun tïkwïl kontin nko tasim nko kari walaka cho kïpöghisyegho ato kïtumöy tumwöyi kwolöt. Pipö ara Yedutun cho kikïkïl kïrip kukat.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.42",
            "verseOrgIds": [
              "1CH.16.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
