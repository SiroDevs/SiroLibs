          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki pipö Lawi walaka cho kighyongchini tumöt, kimöngöy chane korïn cho mïnkech ompö Kö pö Tororöt, akimeghönye chane ighisyö anka, ompöwölo kipöghisïyi oghö nko pöghet.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.33",
            "verseOrgIds": [
              "1CH.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.33",
            "verseOrgIds": [
              "1CH.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pïchete kï kintöghoghi kori pipö Lawi ompö ortïnekwa, kimöngöy chane Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.34",
            "verseOrgIds": [
              "1CH.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukötino Saulö nko monekwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.34",
            "verseOrgIds": [
              "1CH.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitek kanasyanta Kipyon akïmang, kikïkuro korkenyi Maaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.35",
            "verseOrgIds": [
              "1CH.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kekuro poretyenyi Apdon, werkachi walaka kï: Sur nko Kis nko Paal nko Ner nko Nadap ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.36",
            "verseOrgIds": [
              "1CH.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Kedor nko Aio nko Sakaria nko Miklot ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.37",
            "verseOrgIds": [
              "1CH.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "papoto Syimea. Kimang monekwa Yerusalem atolekïtö piko arengwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.38",
            "verseOrgIds": [
              "1CH.9.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.38",
            "verseOrgIds": [
              "1CH.9.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ner kï papoto Kis, Kis kï papoto Saulö, kitïng Saulö wor angwan: Yonatan nko Malkisyua nko Apinadap nko Espaal. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.39",
            "verseOrgIds": [
              "1CH.9.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonatan kï papoto Meripaal nyo kile papoto Mika. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.40",
            "verseOrgIds": [
              "1CH.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Mika wor angwan: Piton nko Melek nko Tarea nko Aas. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.41",
            "verseOrgIds": [
              "1CH.9.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aas kï papoto Yara nyo kile papoto Alemet nko Asmapet nko Simri, Simri kï papoto Mosa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.42",
            "verseOrgIds": [
              "1CH.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosa kï papoto Pinea, Pinea kï papoto Repaya, Repaya kï papoto Eleasa, Eleasa kï papoto Asel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.43",
            "verseOrgIds": [
              "1CH.9.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 9:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïng Asel wor mut nko akonga, Asrikam nko Pokeru nko Ismael nko Syearia nko Opadia nko Anan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.44",
            "verseOrgIds": [
              "1CH.9.44"
            ]
          }
        }
      ]
    },
