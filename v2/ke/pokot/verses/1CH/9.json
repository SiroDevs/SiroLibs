        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.7+1CH.9.8",
            "verseOrgIds": [
              "1CH.9.7",
              "1CH.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chane löwïr kï 956 ompö arengwa nko korikwa. Akï kikintöghoghi korikwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.9",
            "verseOrgIds": [
              "1CH.9.9"
            ]
          }
        }
      ]
    },
