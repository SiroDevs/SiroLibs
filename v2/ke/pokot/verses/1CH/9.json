          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chi pö Lawi nyo kikuro Matitia, nyo le poretya Syalum nyo pö ara Kora nyo kighöy Makatin cho töwörör. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.31",
            "verseOrgIds": [
              "1CH.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki pikökwa cho pö ara Koat cho kighöy makatin cho pö osiswo Sapato.*",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.32",
            "verseOrgIds": [
              "1CH.9.32"
            ]
          }
        }
      ]
    },
    {
