          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chï kï pipö Lawi cho kimang Yerusalem:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.14+1CH.9.15+1CH.9.16",
            "verseOrgIds": [
              "1CH.9.14",
