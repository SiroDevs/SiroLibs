          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saghata körkeyïntin ompö Yerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingwïnchanïn owesyo Echotyon TORORÖT ato kyomitan konyan nko poyi Yuda. Ki könyi mut nko okonga arawa mut nko akonga asispa mut nyo pö arawa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.1",
            "verseOrgIds": [
              "EZK.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.27"
              },
              "items": [
                {
                  "text": "Esk 1:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Asïwan kïgh nyo kilata chi, kilenye ma ato ngata kïrut kwapta kïlenye wölo to tay nyo rel nyo mirmiröy akuryölöy. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.2",
            "verseOrgIds": [
              "EZK.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kughïtö kïgh nyo lata egh akïnamanïn put. Atolapay kïsïtanïn Mïkulögh yïm akwipanïn Yerusalem kutönanïn or ato lïtöy kö nyo mi ori nyo portoy ewu löt ato kimi körkeyïn nyo kililöy Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.3",
            "verseOrgIds": [
              "EZK.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.3",
            "verseOrgIds": [
              "EZK.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.4",
            "verseOrgIds": [
              "EZK.8.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.28"
              },
              "items": [
                {
                  "text": "Esk 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay asïwan ororyo Tororöt pö Israel nyo lenye nyay kyasïwan ompö lalwa Kepar. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.4",
            "verseOrgIds": [
              "EZK.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenchanïn ECHOTYON, “Wero chi, syole konyiku köny aitopön okumpö löt.” Kïlenyona osyolön konyichan, arosan ara ato kïpelo amörostïn okumpö löt asïwan körkeyïn. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.5",
            "verseOrgIds": [
              "EZK.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn, “Isïwïyenyi nya tïkuchï ighöy pipö Israel ghach le nyï? Chï kayonanïn oweghan konyu? Wölo tesïwïyenyi tïpö arasï cho möngörï.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.6",
            "verseOrgIds": [
              "EZK.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.6",
            "verseOrgIds": [
              "EZK.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwipkanïn kuka kö pö ori asïwan ato pankas ompö nayat. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.7",
            "verseOrgIds": [
              "EZK.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn ECHOTYON, “Wero chi, pala nayatunï.” Apalan nayatunay asïwan kukat. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.8",
            "verseOrgIds": [
              "EZK.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn, “Lïtö ori tesïwena sïmnyontön wölolata ompö ori kegh chane.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.9",
            "verseOrgIds": [
              "EZK.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olïtön nyu ori asïwan pichen cho kikikirchï nayat cho pö tïkwïn cho chuto kegh ngwïny nko tyonkïn walaka cho le sïmnyon nko körkeyïntin cho soghöy pipö Israel.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.10",
            "verseOrgIds": [
              "EZK.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.10",
            "verseOrgIds": [
              "EZK.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi ori poyi Israel cho le 70 nko Yasania wero Syapan. Kitïng chi tïkwïl törenyi nyo pelsyegho nko igho tïkuchay ngutoy cho onyïn nyo kiwö yïm. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.11",
            "verseOrgIds": [
              "EZK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn, “Wero chi, kesïwenyi tïkwïn cho ighöy pipö Israel ompö tuwïn, mi chi anka tïkwïl konyi kïsoghöy pichen. Akïlentöy, ‘Melö sïwïyecha Tororöt, kikipïstö ompö nyinte koronete.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.12",
            "verseOrgIds": [
              "EZK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn ngeta tesïwïyenyi cho echön cho ghach nyoman cho ighöy pïchï. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.13",
            "verseOrgIds": [
              "EZK.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwipanïn ato lekïto ara okumpö löt ompö Kö pö Tororöt* onyorwan kor cho lokyini Tamus.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.14",
            "verseOrgIds": [
              "EZK.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.14",
            "verseOrgIds": [
              "EZK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn ECHOTYON, “Kesïwenyi choni nya wero chi? Tesïwïyenyi walaka cho ghach kïtïl chï.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.15",
            "verseOrgIds": [
              "EZK.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwipkanïn Kö pö Tororöt ori, anyorchan kukat mïrön 25 cho portoy kongasis kïsoghöy asis, kipörtochï patagh Tororöt.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.16",
            "verseOrgIds": [
              "EZK.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.16",
            "verseOrgIds": [
              "EZK.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn ECHOTYON, “Kesïwenyi choni nya wero chi? Lentöy so pipö Yuda melö kïgh sïmnyontönonï kegh ompö yi, tökwigh kïnyïghï poryot kor le nyï akwighanïn anarekan tya, kewusö nyarïl yit chane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.17",
            "verseOrgIds": [
              "EZK.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona oghchinan chane ompö nörekyö amotukanye anta osyonchï chi kïrkegh kirirchanïn lö ne moterchinanye chane nyonikïny.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.18",
            "verseOrgIds": [
              "EZK.8.18"
            ]
          }
        }
      ]
    }
  ],
