            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïnchanïn ngölyonto ECHOTYON ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.1",
            "verseOrgIds": [
              "EZK.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.8"
              },
              "items": [
                {
                  "text": "Ngo 20:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kïlenchanïn, “Wero chi, wechinö Kok ompö koro Makok yetïn nyo wow nyo pö Mesyek nko Tupal, atolapay ingor lö, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.2",
            "verseOrgIds": [
              "EZK.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Lentöy Echotyon TORORÖT keghöchaninyi nyoman we Kok, yetïn pö Mesyek nko Tupal nyo wow. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.3",
            "verseOrgIds": [
              "EZK.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owöghökoninyi, anameninyi sartin karenyakay atolapay opunyi nyu nko piköku pö lïk nko angoletine nko pich cho pegho angoletin nko chane löwïr cho kilach kari lïk nko longoy nko chokon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.4",
            "verseOrgIds": [
              "EZK.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pich löwïr cho pkono Pasya nko Etopya nko Lipya cho tïng longoy nko kopïyeni karïn ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.5",
            "verseOrgIds": [
              "EZK.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko Komer nko pipö lïkenyi löwïr, Pet Tokarma ompö okumpö löt nko pipö lïkenyi löwïr nko pipö punton löwïr cho mi nko nyi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.6",
            "verseOrgIds": [
              "EZK.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.6",
            "verseOrgIds": [
              "EZK.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Kïlenyona igha kegh aitöpö kïpsach nko söpïchis löwïr cho kighamïtyï kegh wölo imitenyi atolapay ipayta chane löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.7",
            "verseOrgIds": [
              "EZK.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weröy osiswö cho te, kekurinyi napa kegh, akï ompö könyis cho pkonöy iwetenyi poryegho kor nyo kösöpö poryot, kor nyo kighamïtyï kegh pich akïpa kutïngkoti Israel cho kikilïkwï kïratis, kikipï pich kïpkana punton kïpka kïmöngisyö löwïr ompö kalya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.8",
            "verseOrgIds": [
              "EZK.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipokunenyi nko lïkengu kïmïkul le mirtino pögh, le polta nyo keyentö ngwïny.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.9",
            "verseOrgIds": [
              "EZK.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.9",
            "verseOrgIds": [
              "EZK.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lentöy Echotyon TORORÖT, “Pkonchininyi kinonut asisoni cho itötenyi ghöyityö kwïle. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.10",
            "verseOrgIds": [
              "EZK.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilentenyi nyu, ‘Opokyinan kor nyo melö kikiwach okumpö kiror. Opöran pich cho mi kalya, chane löwïr cho möngöy wölo puryö nïyet okumpö kiror amelö tïng tekech pö karïn anta kukot. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.11",
            "verseOrgIds": [
              "EZK.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipecha nyu pöröw akep tïku chinö kakïsakasa koronini kikimang ngat pich cho kighamïtuna kegh punton cho le sïkön ompö kyak nko tïkwïn akïmang kwenu koronini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.12",
            "verseOrgIds": [
              "EZK.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lenchininyi nyu pipö Syepa nko Dedan nko mïnchïrïs pö Tarsis nko kanastinekwa löwïr, “Kengwïnanyi techenga pöröw aighamït pipö lïk, ap silpa nko koltin, arang tuka nko tïku cho möngörï le pöröw?” ’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.13",
            "verseOrgIds": [
              "EZK.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.13",
            "verseOrgIds": [
              "EZK.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona wero chi ngora ailenchï Kok lentöy Echotyon TORORÖT, “Asisini möngisïyi piköchan Israel ompö kalya inapanyi kegh. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.14",
            "verseOrgIds": [
              "EZK.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingwïna korengu wölo low ompö okumpö löt nko punton cho möngörï cho pegho angoletin nko söpïchis cho möngörï nko lïkos cho makïrar. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.15",
            "verseOrgIds": [
              "EZK.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingwïnanyi ipar piköchan Israel le polta nyo kelum ngwïny. Omïtunyi osiswechoni we Kok nyonö pokyinö korenyan tökunkïtwanïn puntonï otini oporuneninyi tïlilyenyan tökïsïwa chane.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.16",
            "verseOrgIds": [
              "EZK.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lentöy Echotyon TORORÖT, “Nyi so nyay kyangalanan köny ompö kutïwa mötworichan werkoyi Israel? Kingor chane könyisyok lö, omïtunan chi kupokyï chane.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.17",
            "verseOrgIds": [
              "EZK.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sito Tororöt nyo pö Kok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.17",
            "verseOrgIds": [
              "EZK.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lentöy Echotyon TORORÖT, “Asisini kepokyï Kok koro Israel, kungetï nörekyenyan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.18",
            "verseOrgIds": [
              "EZK.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwoghan nyu lö rïngringöy koro Israel asisoni nyoman ompö kililatenyan nko nörekyenyan nöghöy le ma. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.19",
            "verseOrgIds": [
              "EZK.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Potonchot akïmïghyö kaghagh cho mi nanam nko töritwo yïm nko tïpö wuw nko kïgh anka tïkwïl nyo westoy kuchuto kegh ngwïny nko pich löwïr ompö ngwïny kïmïkul, otini kasïwanïn akirulyö kutïngkotï nko komos akurïngring nayat anka tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.20",
            "verseOrgIds": [
              "EZK.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okurunan chok kungwïnchï Kok ompö kutïngtönyan, mwoghöy Echotyon TORORÖT pöröy choko chi anka tïkwïl werïngwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.21",
            "verseOrgIds": [
              "EZK.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omungenan nyinte nko pipö lïkenyi nko koros cho ngöroköy nyinte amal nko mïltaghpa kisön. Oropönchinan takarïs nko ngeset nko ma. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.22",
            "verseOrgIds": [
              "EZK.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona oporunan owesyenyan nko tïlilyenyan aporchan kegh punton cho möngörï, kunkïtï nyu lö ochan ECHOTYON.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.23",
            "verseOrgIds": [
              "EZK.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Megha Kok",
          "type": "text"
        }
      ]
    }
