            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.16+NUM.28.17+NUM.28.18+NUM.28.19+NUM.28.20+NUM.28.21+NUM.28.22+NUM.28.23+NUM.28.24+NUM.28.25"
              },
              "items": [
                {
                  "text": "Kiy 28:16-25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Omekwa ichonto Pasaka* ompö asispa taman nko angwan nyo pö arawa tagh, atolapay kyam makatyan nyo puryö mumar ompö osis mut nko odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.21",
            "verseOrgIds": [
              "EZK.45.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
