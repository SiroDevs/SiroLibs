        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lentöy ECHOTYON, “Möminye chi ompö punton löwïr cho kimang kuwit pipö Israel cho kichopöy kong chane, nyo tökuchopöy kong chane ngat atökunkïtï lö ochan Echotyon TORORÖT.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        }
      ]
    },
