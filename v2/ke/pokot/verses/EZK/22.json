              "items": [
                {
                  "text": "Krt 16:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.19"
              },
              "items": [
                {
                  "text": "23:19",
