                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.36+LEV.25.37"
              },
              "items": [
                {
                  "text": "Law 25:36-37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Chengöy pich ompö nyi asoya tökïmïlta kisön, ghoköy walaka yiyöwo ropïyen cho kemangta lö tökesïkönonö, akyowutyeghanïkwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.12",
            "verseOrgIds": [
              "EZK.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.12",
            "verseOrgIds": [
              "EZK.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïlenyona rose kyapartan morïn okonyïtö tösunöt nyo kinyorunyi ompö ara mïrwos nko kisönchï kemïltenyi ompö kwenungu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.13",
            "verseOrgIds": [
              "EZK.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tetïngetenönyi nyakanat nya anta tetïngetenönyi owesyö nyo iporyot ompö asisini koporyegheninyi? Ani ECHOTYON nyo kamwagh, aghan lenyini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.14",
            "verseOrgIds": [
              "EZK.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otoytoyenekwa oghömunö punton nko koros, achaman kuwonyö sïmnyontön ompö nyi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.15",
            "verseOrgIds": [
              "EZK.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akumwaghanïn puntonï ompö akwa onkïtukwa nyu lö ochan ECHOTYON.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.16",
            "verseOrgIds": [
              "EZK.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mapa Tororöt nyo nöghöy kurïri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.16",
            "verseOrgIds": [
              "EZK.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïnchanïn ngölyonto ECHOTYON, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.17",
            "verseOrgIds": [
              "EZK.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wero chi, kikarkegh pipö Israel ompö ani nko kapoki silpa cho kakikananta, kikarkegh löwïr nko tay nko akwanga nko karïn nko ngolöwo karïn cho kakïpel kïngötï pïlölöskö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.18",
            "verseOrgIds": [
              "EZK.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona lentöy Echotyon TORORÖT, ompöwölo kyakarakwa kegh löwïr nko mïyöyök, oghömïtyinokwa löwïr Yerusalem kwen ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.19",
            "verseOrgIds": [
              "EZK.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "le ato supchini pich silpa ma nko tay nko karïn nko ngolöwo karïn nko akwanga akekutyï ma kïnöghö tökïyiyö. Oghömïtokwa nyu lenyoni ompö nörekyenyan nko nyolotyenyan atönokwa ori onöghyenökwa kuwonyö sïmnyon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.20",
            "verseOrgIds": [
              "EZK.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oghömïtokwa akutyokwa mapa nörekyenyan, onoghyekwa tochiryö ompö ori. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.21",
            "verseOrgIds": [
              "EZK.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onöghyonekwa le wölo nöghtoy silpa tökïyï ompö ma, atonkïtunö lö ani ECHOTYON nyo kyomïlchokwa nörekyenyan kïrïp kegh nko pöghisyewutkökwa, mwoghöy ECHOTYON.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.22",
            "verseOrgIds": [
              "EZK.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngoki kintöghoghi Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.22",
            "verseOrgIds": [
              "EZK.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchanïn echotyon ngat, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.23",
            "verseOrgIds": [
              "EZK.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lenchinö pipö Israel melö tïlil korenkwa, amungokwa ompö asispa nörekyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.24",
            "verseOrgIds": [
              "EZK.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lata kintöghoghichï ngotïny nyo pororöy ompö tyony nyo kapar, kikïpar chane pich akïcheng kaplawachtin nko tïkwïn, kikipar pich kudong mïsïk cho möngörï ompö kor. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.25",
            "verseOrgIds": [
              "EZK.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.10"
              },
              "items": [
                {
                  "text": "Law 10:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kipeny tïsï kirurutköchan nko tïkucha cho tïlilöch amelö tökupesyot kïgh nyo tïlil nko nyo melö tïlil, tomöcha kunet sisityo tïkwïn cho tïlilöch nko cho le sïmnyon. Melö kitökïyang osiswechan pö Sapatotin kïlenyona kikuratanïn chane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.26",
            "verseOrgIds": [
              "EZK.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lata kintöghoghichï cho kapar tyony, mïltoy kisön tökïnyorï sïkönöt ompö or nyo gha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.27",
            "verseOrgIds": [
              "EZK.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikuyen werkoykökwa ngokichï le atay molo pich korïn relnoy. Sïwïyi sïwïyagh pö putintön akïngor ngala putintön kïlentöy, ‘Kamwa Echotyon TORORÖT,’ akwanyï melö kamwa lenyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.28",
            "verseOrgIds": [
              "EZK.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilïsisyö pich akïsara pich tïkwïn, akurïm ptankeris nko pönon akïmasa pïnot tïkukwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.29",
            "verseOrgIds": [
              "EZK.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona ayaran chi kwenungwa nyo muköy kïtek nayat akughyongö nïyetwe wölo kikewur ompö tawunyan, atö mawuran kore, wölo monyorwanye ompö akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.30",
            "verseOrgIds": [
              "EZK.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona komïlchokwa yenyu nörekyenyan owonyenan chane ompö mapa nörekyenyan. Oghchinan chane kïrïp kegh nko ighisyewutkachi.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.31",
            "verseOrgIds": [
              "EZK.22.31"
            ]
          }
        }
      ]
    }
