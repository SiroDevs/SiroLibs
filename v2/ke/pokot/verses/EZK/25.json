            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïlenchï Echotyon TORORÖT pipö Edom, “Kïle wölo kyoghchikwa nyo gha pipö Yuda, kyaghakwa ghöyïn nyo mamïnïngnye otini kotökisyekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.12",
            "verseOrgIds": [
              "EZK.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona lentöy Echotyon TORORÖT, omungan Edom awonyan pich nko tyonkïn, aghan kïlïkwï kïratyan korö kïngeta Teman ntökwit Dedan. Wonyegho pich chok löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.13",
            "verseOrgIds": [
              "EZK.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oghan nyu kitakatenyan ompö mori piköchan srael, takwigh Edom kïrïp kegh nko nörekyenyan nko nyölotyenyan. Atökunkïtï chane kitakatenyan.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.14",
            "verseOrgIds": [
              "EZK.25.14"
            ]
          }
        }
      ]
    },
