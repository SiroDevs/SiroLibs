      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lentöy Echotyon TORORÖT, “Kïköröy kuke nyo pö okumpö kongasis ompö osiswo pöghisyewut mut nko akonga, wölo kïyotöy asispa Sapato* nko Ichon pö Relïn pö Arawa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.1",
            "verseOrgIds": [
              "EZK.46.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wetöy pöytoghintö kïlïtuno kïrurutyo okumpö sany kurelchï köyay wow, akungwïn kughyongö ket pö kukat, kïnget nyu tïsin akïropta ropöwechi cho kïpelöy nko ropöwo pöghisyö, atolapay kïsagh pöytoghintö ompö ghatya pagh ompö or. Atolapay kïlït sany, wölo melö kiköröy ore ntökwimön. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.2",
            "verseOrgIds": [
              "EZK.46.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pkonöy pipö Israel kïkïtïngöy kïsoghöy ECHOTYON ompö osiswo Sapatotin nko Ichontino Relïn pö Arawa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.3",
            "verseOrgIds": [
              "EZK.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.3",
            "verseOrgIds": [
              "EZK.46.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ipchini pöytoghintö ECHOTYON ropöw cho kïpelöy mökol mut nko akonga cho mïnkech nko makal akonga cho lïpopöch ompö asispa Sapato. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.4",
            "verseOrgIds": [
              "EZK.46.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipu makal anka tïkwïl nko ropöwo pagh kilen 17 nko nïsï, akwipï kïgh anka tïkwïl nyo kacham nko liten sömök nyo pö mwaghpa arol. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.5",
            "verseOrgIds": [
              "EZK.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwipï ngaryan nyo lïpop nko spentin mut nko akonga nko makal akonga ompö Ichon pö Relïn pö Arawa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.6",
            "verseOrgIds": [
              "EZK.46.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïkonï ropöwo pagh nko mwaghpa arol kilen mut nko odeny nko nïsï cho rïpöy ngaryan nko makalanay akwipï kïgh anka tïkwïl nyo kacham. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.7",
            "verseOrgIds": [
              "EZK.46.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato lïtöy pöytoghinto Kö pö Tororöt* kïlïto apuke okumpö sany akïmïlo kïlïtöy aranini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.8",
            "verseOrgIds": [
              "EZK.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.8",
            "verseOrgIds": [
              "EZK.46.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo otini kapka pich kïsagh ECHOTYON ompö osiswo ichontin, pich cho kölïtunö ara okumpö löt kïlïtöy soya ara okumpö tagh kïlö cho kölïtunö ewu tagh kïlïtöy ewu löt. Möminye chi nyo lïtöy aranay kölïtunö atay, lïtöy pich sany ompö wölini pörtoy chane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.9",
            "verseOrgIds": [
              "EZK.46.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini lïtöy chane ori kïlïtöy tïkwïl pöytoghintö nko chane, ato lïtöy sany kïlïtöy tïkwïl sany.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.10",
            "verseOrgIds": [
              "EZK.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.10",
            "verseOrgIds": [
              "EZK.46.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ipu chi ompö osiswo ichontin ropöwo pagh nko ngaryan nko makal nko spentin nko kïgh anka tïkwïl nyo kacham chi kwipï nko mwagh liten sömök nyo wetöy nko ropöw. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.11",
            "verseOrgIds": [
              "EZK.46.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato tötoy pöytoghintö ropöwo chamat kutoni ECHOTYON, ato kö ropöw cho kïpelöy anta ropöwo pöghisyö, keyotyini nyinte aranay portoy kongasis kutötö nyu ropöwechi le ompö osiswo Sapato atolapay kekar ara otini kölït sany.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.12",
            "verseOrgIds": [
              "EZK.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ropöwo osis",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.12",
            "verseOrgIds": [
              "EZK.46.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lentöy ECHOTYON “Kïroptoy ompö tökwogha anka tïkwïl wawa nyo lïpop akepelöy lökïr ketöni ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.13",
            "verseOrgIds": [
              "EZK.46.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 46:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïroptoy tïkwïl ropöwo pïsya kilen odeny nko lita akonga nyo pö mwaghpa orolwö nyo kikïtïntïrta pïsya. Mïchini kerip kirurutchï osis löwïr kokay. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.14",
            "verseOrgIds": [
              "EZK.46.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïropchini ECHOTYON wawa kech nko pïsya nko mwaghpa orolwö tökwogha anka tïkwïl.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.15",
            "verseOrgIds": [
              "EZK.46.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pöytoghin nko kor",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.15",
            "verseOrgIds": [
              "EZK.46.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 46:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lentöy Echotyon TORORÖT, “Ato tö pöytoghintö werkachi kïgh ompö mïlatenyi, kïpöyitu werkachi ompöwölo mïlatengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.16",
            "verseOrgIds": [
              "EZK.46.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 46:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.10"
              },
              "items": [
                {
                  "text": "Law 25:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wölo ato tö mötworintenyi kïpöyitu mötworin ntökwitïta könyi kilingat keyokyï nyu pöytoghin, kïpoto weri nyo chengöy kokay ropöwonto mïlatenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.17",
            "verseOrgIds": [
              "EZK.46.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 46:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö söro pich pöytoghintö mïlutkökwa akïyonchï sany chane. Töni werkachi mïlatenyi nyini le parenyi, tömömi ompö piköchan chi nyo kïsöro parenyi.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.18",
            "verseOrgIds": [
              "EZK.46.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chikoni Kö pö Tororöt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 46:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.18",
            "verseOrgIds": [
              "EZK.46.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 46:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwipanïn chichay nko apuke pö korïn cho pörtoy okumpö löt ato lekïto köyay pöro mi ori Tïlilöch korichï pö tïsï, kuporwanïn ato le korïn okumpö ta ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.19",
            "verseOrgIds": [
              "EZK.46.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 46:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïlö, “Yete ato ghogho tïsï panya ropöw nko amörostin cho pö ngokï anta ropöwo kitakat nko ropöwo pagh, tömömi kïgh nyo tïlil nyo kipöy kïlïtöy sany tömönamta pich tïlilyö.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.20",
            "verseOrgIds": [
              "EZK.46.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 46:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.20",
            "verseOrgIds": [
              "EZK.46.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 46:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwipanïn luchtin okumpö sany akuporwanïn luchtin angwan wölo mi wölo kimpuröy ompö luch anka tïkwïl ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.21",
            "verseOrgIds": [
              "EZK.46.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kimi luchtina walaka cho mïnkech cho le miten tömönut odeny ompö koghïn akï miten tömönut mut ompö töpesïn ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.22",
            "verseOrgIds": [
              "EZK.46.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 46:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki koghïn nayatu anka tïkwïl kuwit akimi nököghonï cho kikïtek kïnam nayat. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.23",
            "verseOrgIds": [
