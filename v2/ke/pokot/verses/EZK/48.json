      },
      "items": [
        {
          "text": "48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chï kï kaynötut pö ortïna pipö Israel: pöyitu Dan kïngeta nanampa Kwen kuwer Etlon ompö okumpö löt, akïnam or ntökwit Lepo Amat, akïnam Asar Enon ntökwit rotyo Damaska nko Amat, lïku nyoni rotyenyi kïngeta okumpö kongasis nko okumpö ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyoru Asyer kareran akonga akïchagh rotyot nko Dan kïngeta okumpö kongasis nko to. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnyorï Naptali kareran akonga, choghöy rotyot nko Asyer ompö okumpö kongasis ntökwit ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnyorï Manase kareran akonga, chöghöy rotyot nko Naptali ompö okumpö kongasis ntökwit ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyoru Epraim kareran akonga, chöghöy rotyot nko Manase ompö okumpö kongasis ntökwit ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyorï Rupen kareran akonga, chöghöy rotyot nko Epraim ompö okumpö kongasis ntökwit ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyoru Yuda ntökwit kareran akonga, chöghöy rotyot nko Rupen kïngeta kongasis ntökwit ta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakïngotyï ECHOTYON kor ato le kwen",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïchöghöy kore nyo rïptoy nyo pö Yuda akechöghchini ortïn kïkarkegh. Kïmutöy kilomiten taman nko odeny nko nïsï ompö koghïn kïngeta okumpö kongasis kughegh okumpö ta akïkarkegh lenyoni ompö töpesïn kïngeta okumpö ewu löt kughegh okumpö ewu tagh. Kïteköy Kö pö Tororöt* ato le kwen.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitïlilchini ECHOTYON atoni, kilomiten taman nko odeny nko nïsï ompö kilomiten taman. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyoru tïsï kareran nyo pö wölo tïlil. Lïku karerantangwa nyo le kilomiten taman nko odeny nko nïsï kïngeta okumpö kongasis nko okumpö ta akï kilomiten mut kïngeta okumpö löt nko ewu tagh. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pöyitu nyï tïsï cho ngotote werpö Sadok kïrïp chane kirurutköchan, akïtagh kïmasta otini kimasta pipö Israel nko Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku karerantangwa kegh ompö koronini kikengot aketïlil tya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyoru pipö Lawi nyingwa kore okumpö ewu löt nyo pö wölo könyorï tïsï, nyo le kilomiten taman nko odeny nko nïsï ompö koghïn kïngeta kongasis kughegh ta, akï kilomiten mut ompö töpesïn kïngeta ewu löt kughegh ewu tagh. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kyoltoy kokay anta kïwaghak nko anka anta kitötö, ompöwölo tïlil ompö ECHOTYON amelö mito anka nyo karam kïtïl nyete.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölinö kingötï le kilomiten taman nko odeny nko nïsï kïmelö tïlil wölo pöyitu pich löwïr kïpöghisyeghö kïmang aketö kanasyanta kwen ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyo karkegh wölini nko wölini miten 2,250 wop anka tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitöni tömkö nyo le miten 125 kuwit woptino kanasyan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kore wölnö köngötï otinö kiketek kanasyan ompö okumpö tagh ompö wölay tïlil kï kilomiten mut nko odeny nko nïsï ompö okumpö kongasis akï kilomiten mut ompö odeny nko nïsï ompö ta, kïlïkwï wölo ngoröy pich cho möngöy kanasyan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoröy chi anka tïkwïl nyo möngöy ori kïrkegh kö ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku wölo ngotote kilomiten taman nko nïsï wölini nko wölini kimi nko wölini kökiketek kanasyan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pöyitu nyu pöytoghin nyoni kongotï ompö woptin odeny ompö wölay tïlil nko kanasyan, kïngeta kongasis nko ta nko wölo möngöy tïsï nko pipö Lawi. Ngeto kongasis akïwö kutang rotyot ompö kongasis akutang ta kïnam nanampa Kwen ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "akuyokwï rotyo Yuda ompö okumpö tagh nko rotyo Penchamen.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kor nyo pö ortïna Israel walaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyoru ara Penchamen kareran akonga kïngeta kongasis nko ta ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïnyorï Simion kareran akonga, choghöy rotyot nko Penchamen kïngeta kongasis nko ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyorï Isakar kareran akonga, kïchagh rotyot nko Simion kïngeta kongasis nko ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyorï Saplon kareran akonga, choghöy rotyot nko Isakar kïngeta kongasis nko ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyorï Kad kareran akonga, choghöy rotyot nko Saplon kïngeta kongasis nko ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
              "EZK.48.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 48:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngeto rotyo Kad ompö okumpö tagh Tamar ntökwit pögho Meripat Kades, akï rop lalwa Misri ntökwit nanampa Kwen. ",
          "type": "text",
          "attrs": {
