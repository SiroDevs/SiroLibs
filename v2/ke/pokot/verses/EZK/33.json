                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïnchanïn chi nyo kipertegha Yerusalem asispa mut arawa taman könyi taman nko odeny nyo pö pïnotönencha, kïlenchanïn, “Kikïrul kanasyanta.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.21",
            "verseOrgIds": [
              "EZK.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyolïmchan kegh ewu ECHOTYON nangatunyi kïtomö kungwïn chichay kiperï kïnganganïn kut ECHOTYON otini itu chichay tökwogha, kïlenyona kiyatanïn kut, angalanan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.22",
            "verseOrgIds": [
              "EZK.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngoki pich",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
