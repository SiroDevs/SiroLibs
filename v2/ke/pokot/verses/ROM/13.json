              "items": [
                {
                  "text": "Mrk 12:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.25"
              },
              "items": [
                {
                  "text": "Luk 20:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nka nyoni kini ighokwa akwaghtena surï, ompöwölo pöghisyechini Tororöt kintöghoghichoni otini mi kwighöy ighisyengwa kuten. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.6",
            "verseOrgIds": [
              "ROM.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makany kïnamak ghoksyö, ato kö nyo ghoköy surï, keghokyï, anta kö konyït, kekonyït.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.7",
            "verseOrgIds": [
              "ROM.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kïcham kegh pipö Tororöt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.7",
            "verseOrgIds": [
              "ROM.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makany kïghakak chi nyonikïny, kïpoto ghosyo chomnyogh, ompöwölo anka tïkwïl nyo chömöy pöröryenyi, kï kepuntö kirurut. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.8",
            "verseOrgIds": [
              "ROM.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.13+EXO.20.14+EXO.20.15"
              },
              "items": [
                {
                  "text": "Wuw 20:13-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
