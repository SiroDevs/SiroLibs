                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Law 19:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.17+DEU.5.18+DEU.5.19"
              },
              "items": [
                {
                  "text": "Krt 5:17-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ompöwölo kirurutchay mwoghöy lö, “Megh cheporesnan anta mepar chi anta mechorsyo anta mepïrchï tïpö pich,” nko walaka löwïr kïmi kirurutyonï le akonga nyo lentöy, “Chama pöröryengu le ato ichömenyi kegh nyinte.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö ighchini chi nyo chömöy pöroryenyi kïgh nyo gha. Kïlenyona nyu kecham, pörör kï kerïp kirurut löwïr.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akïmöchonicha opïn, onkïtökwa lö kïmitö osis cho nenach. Osiswechete cho kömïchï kengetena rïwon, ompöwölo kikïlekïtit ye tya sörunötenyo kïtïl atanya kikighanacha. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.11",
            "verseOrgIds": [
              "ROM.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamach kuwonyö oghö, akarich kïyech. Kelastena nyu ighisyewut pö tuwïn akelach kari lïk cho pö löpoyïn. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.12",
            "verseOrgIds": [
              "ROM.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kemöngisyenö ompö or nyo tenate, le pich cho pestegho löpoyïn pö pöghet. Melö ompö aketagh kïsamta nko tamasa anta sïmnyontön nko cheporesnan anta syala nko sastagh. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.13",
            "verseOrgIds": [
              "ROM.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo nya kïlïkwï Echotyon Yeso Kristo* longa nyo ripekwa, amotö porwöyikwa pöroyïn kwigh lenyini köpïrchï kwigh.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.14",
            "verseOrgIds": [
              "ROM.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Merwokyï werïngwo",
          "type": "text"
        }
      ]
    }
