        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.17",
            "verseOrgIds": [
              "ROM.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.19.4"
              },
              "items": [
                {
                  "text": "Tum 19:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wölo nya tepan lö, kitomöcha so kïlïm chane ngölyontononi? Kikïlïm lö chïs! Ompöwölo mwoghöy Kikirut lö,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kisyonöto Tororöt ompö pipö Israel",
          "type": "text"
        }
      ]
    }
  ],
