  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "PHP 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tupchenichu ochömenokwa kegh nyoman akwomanïn emö akwa. Ochikwa ngörekyengan, achikwa tentenyan nyo pö rïntagh, oghyongö lasiny lenyoni ompö Echotyon!",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.1",
            "verseOrgIds": [
              "PHP.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.1",
            "verseOrgIds": [
              "PHP.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osoman Euodia nko Suntuke lö, “Kaykay omukyinö olïmchinenö le cho otupchö ompö Echotyon.” ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.2",
            "verseOrgIds": [
              "PHP.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osominyi tïkwïl, kongenyu nyo ichï ghanate, lö ngaraka koruchoni, ompöwölo kinoghyö chane nko ani ompö amtaghata Lökoy cho Karamach nko Klemen nko pich lapay cho kikinoghyecha tïkwïl, pich cho kirote kaynötutkökwa kitapu söpon.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.3",
            "verseOrgIds": [
              "PHP.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.3",
            "verseOrgIds": [
              "PHP.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ongörökyenö ompö Echotyon osis tïkwïl otösan ngat omwoghöy lö, ongörökyenö!",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.4",
            "verseOrgIds": [
              "PHP.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.4",
            "verseOrgIds": [
              "PHP.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanya kunkïtï pich lapay tölosyenkwa, kilekïtït ato mïlo Echotyon. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.5",
            "verseOrgIds": [
              "PHP.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosusenö kegh kïgh anka tïkwïl, wölo otönö kïgh anka tïkwïl sowut, opchinö Tororöt lokekwo atö sörö amwochï nyinte möchut kökwa. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.6",
            "verseOrgIds": [
              "PHP.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komönöy nyu kalya Tororöt, nyo tïlöy pköchin anka tïkwïl nyo pö ptangengmöt, mïkuliskökwa nko kinonutkökwa ompö Kristo* Yeso.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.7",
            "verseOrgIds": [
              "PHP.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.7",
            "verseOrgIds": [
              "PHP.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo pö löt tupchenichu omwoghan lö, anyïghita kinonutkökwo tïkwïn lapay cho pö man nko cho pö konyït nko cho puryö lïs nko cho tïlilöch nko cho pö töroryö nko pïchighyö. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.8",
            "verseOrgIds": [
              "PHP.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agha tïkwïn cho kyanetakwa kegh atakakwa alïmakwa asïwekwa ompö ani. Atökïtöpö Tororöt pö kalya nko akwa.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.9",
            "verseOrgIds": [
              "PHP.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sörö ompö ropöwon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.9",
            "verseOrgIds": [
              "PHP.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochan ngarakate nyoman ompö Echotyon ompöwölo kïrkegh kikuwer osiswö cho chang konyorukwa ngat pöroyïn nyo oporu lö toyonganïkwa. Melö so nye kökyopïstekwa oyanganïn, wölo kimosïkökwanye pöroyïn oporunö. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.10",
            "verseOrgIds": [
              "PHP.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö tökelö omitan otontorönöy ompöwölo ochopan kïgh, ewo. Kyanetan kegh kïmïchon tïkwïn cho otïngetan. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.11",
            "verseOrgIds": [
              "PHP.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onkïtön rörchin lö kïgh ne, ankïtön tïkwïl chongïn pö tïkwïn. Kyanetan kegh wïngat kïmïchanïn tïkwïn ompö pöroyïn anka tïkwïl, kö ompö pïghyöng anta kömöy, ompö chongïn anta rörchin. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.12",
            "verseOrgIds": [
              "PHP.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukan oghöy tïkwïn löwïr ompö Kristo nyo konanïn owesyö.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.13",
            "verseOrgIds": [
              "PHP.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.13",
            "verseOrgIds": [
              "PHP.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kyaghakwa nyo karam otini kyangarakanïkwa ompö nyörilwoköchan.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.14",
            "verseOrgIds": [
              "PHP.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.14",
            "verseOrgIds": [
              "PHP.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
