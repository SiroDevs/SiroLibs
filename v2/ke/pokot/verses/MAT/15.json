          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.23",
            "verseOrgIds": [
              "MAT.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yeso kokonay, “Kikïyonwanïn angwïn wölo mi kechir cho kipotyö cho pö pipö Israel kïpoto!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.24",
            "verseOrgIds": [
              "MAT.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.24",
            "verseOrgIds": [
              "MAT.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungwïn kokonay kïkïtïngchï kelyechi akïlö, “Echotyon, ngarakante!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.25",
            "verseOrgIds": [
              "MAT.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.25",
            "verseOrgIds": [
              "MAT.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yeso, “Mömïchininye kecheng omisyo monïng akewirchï kukïdin.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.26",
            "verseOrgIds": [
              "MAT.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.26",
            "verseOrgIds": [
              "MAT.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö kokonay, “Nyoman, Echotyon, wölo kwöghöy tïkwïl kukïdinö rarakan cho chïntegho mesa piko kïpö.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.27",
            "verseOrgIds": [
              "MAT.15.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.27",
            "verseOrgIds": [
              "MAT.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Yeso lö, “Kamanï, itïngetenyi kighanat nyo wow! Nya kwigha lenyini imökenyi.” Kïsöp cheptanyi lenyini.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.28",
            "verseOrgIds": [
              "MAT.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sopöy Yeso pich cho chang",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.28",
            "verseOrgIds": [
              "MAT.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngeta Yeso wölini akïwö ntökwit nanampa Kalilaya. Kïpus kutïng akumpur ngwïny. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.29",
            "verseOrgIds": [
              "MAT.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpkonchï söpïchtinö cho chang cho kimïtu pich cho kisipisyö porwöy nko chepkarotin nko cho kingwolsot nko kïmanytin nko pikö walaka cho chang cho kichiryot kutö tawu kelyechi, kusop Yeso chane. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.30",
            "verseOrgIds": [
              "MAT.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtöngönchï nyu pich otini kisïwa pich cho kile kïmanytin kïngölonöy, kïsöpchö cho kimeyta porwöy, kïpesta cho kingwolsot akurosïta chepkarotin. Kïsal chane Tororöt pö Israel.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.31",
            "verseOrgIds": [
              "MAT.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kapagh Yeso söpïch anka nyo wow",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.31",
            "verseOrgIds": [
              "MAT.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkur nyu Yeso kinetankachi akïlenchï, “Osyonchinan pïchï, ompöwölo kötïpïyö chane nko ani osis sömök akïtomöcha kwam kïgh amochömanye oyontoy chane kïtomö kwomisyö, tömam kömöy chane kïpetöy kestonikwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.32",
            "verseOrgIds": [
              "MAT.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep kinetanchay Yeso lö, “Akwonö wölo kïnyorchini omisyö nyo muköy pich cho tenö chï ompö wölï le surkwen?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.33",
            "verseOrgIds": [
              "MAT.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Yeso lö, “Otïngetekwa makatin ata nya?” Kïlenchï, “Mut nko odeny nko kaghagh tïkwïte cho mïnkech.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.34",
            "verseOrgIds": [
              "MAT.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchikyï Yeso tuyonay kumpur ngwïny. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.35",
            "verseOrgIds": [
              "MAT.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïcheng makatinechay le mut nko odeny nko kaghaghe akusoyön Tororöt kïmïnchïran akutö kinetankachi, kïcheng kinetankachi akutö pïchay. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.36",
            "verseOrgIds": [
              "MAT.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwam chane löwïr ntökïpïghyö atolapay kïghamït rarakan cho kingötï cho kinyïghï köröpon mut nko odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.37",
            "verseOrgIds": [
              "MAT.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki mïrön 4,000 chane akimeyitnye chi kor nko monïng. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.38",
            "verseOrgIds": [
              "MAT.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kuyomis Yeso kegh nko pïchoni. Kïwö kïlany meli kutang okumpö Makadan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.39",
            "verseOrgIds": [
              "MAT.15.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kamak pich keporchï töngönchin",
          "type": "text"
        }
      ]
    }
  ],
