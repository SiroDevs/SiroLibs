          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipïntö nyu ngölyon nyo kimwa werkoyon Yeremia lö,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.17",
            "verseOrgIds": [
              "MAT.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kömïlisyeghö Misri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
