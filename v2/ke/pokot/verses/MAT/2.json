          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.18",
            "verseOrgIds": [
              "MAT.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kïma Erode, kuchumchï malaykayanta Echotyon Yosep ompö kirwotïtogh ompö Misri ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.19",
            "verseOrgIds": [
              "MAT.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïlenchï, “Ngeta mïta montö nko kame aiwö koro Israel, ompöwölo kimeghö pich kiyöröy kïtïghöy montö.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.20",
            "verseOrgIds": [
              "MAT.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenyona, kïnget Yosep akumït monïngay nko kame kïmïlisyö koro Israel.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.21",
            "verseOrgIds": [
              "MAT.2.21"
            ]
          }
        }
      ]
    },
