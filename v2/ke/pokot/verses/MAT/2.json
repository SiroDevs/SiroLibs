          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo otini kilïma Yosep lö pöytoy Arkelao Yudea nyo kiker kwanta Erode, kuwöghisyö akimökïwönye wölini, kïkany otini kikerur ompö kirwotïtogh kïwö kutang okumpö Kalilaya ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.22",
            "verseOrgIds": [
              "MAT.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
