      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kisop Yeso chepkörotonoy odeny",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
