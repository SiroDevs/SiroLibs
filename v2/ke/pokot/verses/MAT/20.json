                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wölo melö lenye nyona ompö akwa. Ato mököy chi ompö akwa kïyetu, kïmïchini kïlïkwï nyinte mötworintekwa, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
