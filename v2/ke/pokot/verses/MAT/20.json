          ]
        },
        {
          "text": " akwoto mököy chi akong ompö akwa kïlïku nyo pö tagh kïmïchini kïlïkwï sekeyontenkwa, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.27",
