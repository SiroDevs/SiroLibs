          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.18",
            "verseOrgIds": [
              "MAT.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïpkonchï nyu Yeso kinetankachi ompö ato le sirö akïtep lö, “Kölö ne tömökimukacha keyona oyichay nya?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.19",
            "verseOrgIds": [
              "MAT.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.21"
              },
              "items": [
                {
                  "text": "Mat 21:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.23"
              },
              "items": [
                {
                  "text": "Mrk 11:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.2"
              },
              "items": [
                {
                  "text": "1Kr 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kuyokyï Yeso chane lö, “Ompöwölo mïnïng kighanatenkwa. Omwowokwa nyoman lö ntökotïngetekwa kighanat nyo tenö kösïghyonto ket pö aradali kötomukekwa olenchinö kutïngï, ‘Ngetena yi aiwö atara,’ kötöngetöy akömökïminye kïgh nyo memukonye ompö akwa. [",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.20",
            "verseOrgIds": [
              "MAT.17.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.20",
            "verseOrgIds": [
              "MAT.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo möngetöcha oy cho lata chï kwïle, kïpoto ompö saghat nko kïrurat.”]",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.21",
            "verseOrgIds": [
              "MAT.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kangalana Yeso meghenyi panto odeny",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
