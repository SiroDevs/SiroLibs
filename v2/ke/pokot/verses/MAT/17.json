              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yeso, “Kwoto le nyona, kuporu lö möminye machata piko kore kïkwagh. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.26",
            "verseOrgIds": [
