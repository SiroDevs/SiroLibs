                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kikany kuwer osiswö cho le mut nko akonga, kumït Yeso Petro nko Yakopo nko werïngwa Yoana kïpus kutïng nyo kogh chane opïn. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.1",
            "verseOrgIds": [
              "MAT.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kuwenga Yeso ompö tawungwa. Kulïwï tokochunyi le asis, kïrelachitu sïrokachi löka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.2",
            "verseOrgIds": [
              "MAT.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïsïwa kinetanchay pö Yeso Musa nko Eliya kïngölonöy nko nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.3",
            "verseOrgIds": [
              "MAT.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Petro Yeso, “Echotyon, karam nyoman kemicha yi! Ato imökenyi, otekan yete tunkun sömök, nyengu akong kïpöyit anka Musa, kipöyit anka Eliya.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.4",
            "verseOrgIds": [
              "MAT.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
