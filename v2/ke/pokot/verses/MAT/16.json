              "MAT.16.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.38"
              },
              "items": [
                {
                  "text": "Mat 12:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.16"
              },
              "items": [
                {
                  "text": "Luk 11:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïpa Parisaytin* nko Sadukaytin* wölo mi Yeso, kimököy chane kutö nyinte ngöghöp, kïlenyona kïsom nyinte lö teporchï kiporunöt nyo ngwïno yïm. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.1",
            "verseOrgIds": [
              "MAT.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kuyokyï Yeso lö, “Otini kemön olekwa, ‘Peköy asïyech ompöwölo pïrir yïmö!’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.2",
            "verseOrgIds": [
              "MAT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany kuwas olekwa, ‘Ropönöy ompöwölo pïrir yïmö akï kïruntï.’ Ato onkïtökwa angoröy atöptino osis otini kotopönökwa yïm akwanyï momuchekwanye ntangor möchey pö otöptino osiswechï. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.3",
            "verseOrgIds": [
              "MAT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.39"
              },
              "items": [
                {
                  "text": "Mat 12:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.39"
              },
              "items": [
                {
                  "text": "Luk 12:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Pïn nyo gha nyo melö ghanate nyo yöröy kiporunöt! Wölo möminye kiporunötö nyo osïkekwa nyonikïny, kïpoto nyanya pö Yona.” Kïpïstö Yeso chane akïwechï kegh.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.4",
            "verseOrgIds": [
              "MAT.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mumara Parisaytin nko Sadukaytin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.4",
            "verseOrgIds": [
              "MAT.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kyoghyö kinetankachi nanamay kïlö kiros kichö kïwutyeghö chane kwip makatin. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.5",
            "verseOrgIds": [
              "MAT.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.1"
              },
              "items": [
                {
                  "text": "Luk 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïlenchï Yeso chane, “Orip kegh mumara Parisaytin nko Sadukaytin.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.6",
            "verseOrgIds": [
              "MAT.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumöl kegh chane opïn kïlentöy, “Kamwa so lenyoni ompöwölo melö kakipucha makatin.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.7",
            "verseOrgIds": [
              "MAT.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunkïtï Yeso wölini kimwoghtoy chane, kïtep lö, “Kölö ne tomölekwa kegh lö ompöwölo melö kakipucha makatin? Wechï mïnïng kighanatenkwa! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.8",
            "verseOrgIds": [
              "MAT.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.17+MAT.14.18+MAT.14.19+MAT.14.20+MAT.14.21"
              },
              "items": [
                {
                  "text": "Mat 14:17-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomönye so kïpköchokwa? Mononekwanye atanya kyamïnchïran makatin mut apagha mïrön 5,000, kyanyïghitakwa ngötunön köröpon ata? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.9",
            "verseOrgIds": [
              "MAT.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.34+MAT.15.35+MAT.15.36+MAT.15.37+MAT.15.38"
              },
              "items": [
                {
                  "text": "Mat 15:34-38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anta makatinechanya le mut nko odeny kyapaghan mïrön 4,000? Kyanyïghitakwa ngötunön köröpon ata? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.10",
            "verseOrgIds": [
              "MAT.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwompö ne tömöpköchokwa lö melö kongölononan ngala makatin? Oripenö kegh mumara Parisaytin nko Sadukaytin!” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.11",
            "verseOrgIds": [
              "MAT.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kunkïtï kinetankachi lö melö kirirchini nyinte chane lö orip kegh mumar cho kïpöghisyegho ompö makatin, wölo kimököy chane kïripo kegh kinetut pö Parisaytin nko Sadukaytin.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.12",
            "verseOrgIds": [
              "MAT.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kamwa Petro lö, Wero Tororöt Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.12",
            "verseOrgIds": [
              "MAT.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kit Yeso okumpö Kaysaria Pilipi, kïtep nyinte kinetankachi lö, “Lentöy pich ngo Wero Chi nya?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.13",
            "verseOrgIds": [
              "MAT.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.13",
            "verseOrgIds": [
              "MAT.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
