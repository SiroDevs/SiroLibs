                "loc": "ISA.40.3"
              },
              "items": [
                {
                  "text": "Isa 40:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ki Yoana nyinte nyaye kingölono werkoyon Isaya ato kimwa lö,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.3",
            "verseOrgIds": [
              "MAT.3.3"
            ]
          }
        }
      ]
