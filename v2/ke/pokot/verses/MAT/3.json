              "type": "text"
            }
          ]
        },
        {
          "text": "Kingwïn osiswechoni Yoana Kipatisanintö akutor kwamtata ompö surkwen pö Yudea kilentöy, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.1",
            "verseOrgIds": [
              "MAT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
