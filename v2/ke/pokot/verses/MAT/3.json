              "items": [
                {
                  "text": "Luk 9:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atolapay kïlö kut nyo kingwïno yïm, “Werïnyan nyï nyo le chamanenyan, nyo ochömonan kegh nyinte tya.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
