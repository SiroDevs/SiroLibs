          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö kitökïmi chi nyo kitökuyokyï nyinte ngölyon akimökïminye chi nyo kimukyï kïtep nyinte teput ngat kïngeta asisoni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.46",
            "verseOrgIds": [
              "MAT.22.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Körirchï Yeso pich kïripö kegh koneti kirurut nko Parisaytin",
          "type": "text"
        }
