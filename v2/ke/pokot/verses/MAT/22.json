                "loc": "LUK.10.25"
              },
              "items": [
                {
                  "text": "Luk 10:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Chïchïmo Kirurut pö Musa nko kinetut pö werkoy kirurut chete le odeny.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.40",
            "verseOrgIds": [
              "MAT.22.40"
            ]
          }
        }
      ]
    },
