              "items": [
                {
                  "text": "Ist 23:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïpkonchï Yeso Sadukaytin,* ki chane cho kinetöy lö möminye kitutunötö. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.23",
            "verseOrgIds": [
              "MAT.22.23"
            ]
          }
        },
