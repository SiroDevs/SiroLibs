              "NUM.18.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.30+LEV.27.31+LEV.27.32+LEV.27.33"
              },
              "items": [
                {
                  "text": "Law 27:30-33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.22+DEU.14.23+DEU.14.24+DEU.14.25+DEU.14.26+DEU.14.27+DEU.14.28+DEU.14.29"
              },
              "items": [
                {
                  "text": "Krt 14:22-29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlö ECHOTYON, “Kyotönön pipö Lawi kareran pö taman anka tïkwïl nyo pipö Israel kïlïkwï mïlatengwa, ompö ighisyengwa nyo ighöy ompö Ema nyo mi ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.21",
            "verseOrgIds": [
              "NUM.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melö riköy nyu pipö Israel walaka Ema nyo mi ECHOTYON atomanam ngokï akïmeghö. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.22",
            "verseOrgIds": [
              "NUM.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo pipö Lawi cho pöghisïyi ompö Ema nyo mi ECHOTYON akï nömöy chane ngokikwa, lïku nyï kirurut pö kokay ompö monekwa tïkwïl. Amöminye mïlata nyo nyoru pipö Lawi ompö kwenu pipö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.23",
            "verseOrgIds": [
              "NUM.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo kyotönön chane kareranpa taman nyo konanïn pipö Israel le ropöwon nyo karam kïlïkwï mïlatengwa. Kïlenyona mötïngcha chane mïlat ompö kwenu pipö Israel.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kareranpa taman nyo pö pipö Lawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï nyu ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.25",
            "verseOrgIds": [
              "NUM.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lenchinö pipö Lawi, otini konyorukwa kareranpa taman ompö pipö Israel nyo kikonokwa ECHOTYON kïlïkwï mïlatenkwa, oropchinekwa ECHOTYON kareranpa taman ompö ori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.26",
            "verseOrgIds": [
              "NUM.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyitöy nyu ropöwechoni le pagha ngorin chini tagh nko dipay. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.27",
            "verseOrgIds": [
              "NUM.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenyona otötokwa lenyoni ropöw cho pö ECHOTYON ompö kareranpa taman cho konokwa pipö Israel, atolapay otönökwa Aron ropöwechï. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.28",
            "verseOrgIds": [
              "NUM.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö ropöwechini löwïr onyorukwa, oroptokwa nyu cho karamach akïtïlilöch. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.29",
            "verseOrgIds": [
              "NUM.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenyona ilenchininenyi chane, otini karoptekwa cho karamach ompö ropöwekwa löwïr, kipöyitu pipö Lawi chinö köngötï. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.30",
            "verseOrgIds": [
              "NUM.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omekwa nyu nko monekwa chinö köngötï ompö wop anka tïkwïl, ompöwölo pö choni ighisyenkwa nyo oghekwa ompö Ema nyo mi ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.31",
            "verseOrgIds": [
              "NUM.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amelö tökïnömokwa ngokï, ato karoptekwa cho karamach ompö löwïr. Wölo orip kegh nyu atömosïmnyon ropöwechoni tïlilöch pö pipö Israel ato amakwa kïtömö keropchï ECHOTYON ropöwe cho karamach, tömomeghö.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.32",
            "verseOrgIds": [
              "NUM.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Or cho pö tany nyo pïrir",
          "type": "text"
        }
      ]
    }
  ],
