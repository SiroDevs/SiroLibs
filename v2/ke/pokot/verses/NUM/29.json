          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko kwagha nyo le ropöwonto ngokï kïsis ompö ropöwcho kïpelöy chik nko ropöwo pagh nko ropöwcho kigheghöy.",
          "type": "text",
          "attrs": {
