          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko ropöwo pagh cho le pïsya nko mwagh cho pö kilen sömök ompö egh akonga nko kilen odeny ompö makalu ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.9",
            "verseOrgIds": [
              "NUM.29.9"
            ]
          }
