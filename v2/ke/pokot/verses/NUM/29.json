          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko kilö akonga ompö wawa kech akonga akonga ompö chay le mut nko odeny. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.10",
            "verseOrgIds": [
              "NUM.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aropta tïkwïl kwagha nyo le ropöwonto ngokï nyo tïlilokwa nko ropöwontonay kïpelöy chik nko ropöweko pagh nko ropöweko dipay.*",
          "type": "text",
          "attrs": {
