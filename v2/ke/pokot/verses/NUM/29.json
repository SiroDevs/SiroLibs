          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oroptokwa ompö asisto odeny ngartin taman nko odeny nko mökol odeny nko wara kechir taman nko angwan cho le mökol cho tïng köny akonga akïlïpopoch. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.17",
            "verseOrgIds": [
              "NUM.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
