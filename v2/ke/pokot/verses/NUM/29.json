          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nko ropöweko pagh nko ropöw cho kigheghöy cho pö eghine nko mökolkö nko wareko kechir kïrïp kegh nko wölo tenö, kïrïp kegh nko kirurut, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.18",
            "verseOrgIds": [
              "NUM.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
