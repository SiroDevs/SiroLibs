        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.1",
            "verseOrgIds": [
              "NUM.9.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
