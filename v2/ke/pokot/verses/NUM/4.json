          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "pchörineko Ema nko tiwowekwa nko nömöwe nko pörköyi nko tïku walaka cho pö ighisyengwa. Tïngeti chi anka tïkwïl tïkwïn cho mïchini kïsïtöy. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.32",
            "verseOrgIds": [
              "NUM.4.32"
            ]
          }
        },
        {
          "name": "verse",
