            "number": "20",
            "style": "v",
            "sid": "NUM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.20",
            "verseOrgIds": [
              "NUM.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.21",
            "verseOrgIds": [
              "NUM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yitö werpö Kersyon tïkwïl ompö ortïnekwa nko korikwa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.22",
            "verseOrgIds": [
              "NUM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "aikir pich cho tïng könyis tömönut sömök ntökwit tömönut mut cho muköy kwigh ighisyö ompö Ema nyo mi ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.23",
            "verseOrgIds": [
              "NUM.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chane cho sïtöy tïkuchï: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.24",
            "verseOrgIds": [
              "NUM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ema nko ananke nyo kïkörtegho okumpö ori nko nyo pö okumpö sany nko sïra aran kiyeno parak nko ananka nyo pö kuka Ema, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.25",
            "verseOrgIds": [
              "NUM.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko anankis nko pörköy cho pö kuka kasar nyo kiwit Ema nko ato kïpelo amöros nko anankis cho pö kuka Ema nko tïku walaka cho pö ighisyengwa. Ighöy kïgh anka tïkwïl nyo kakïmwochï chane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.26",
            "verseOrgIds": [
              "NUM.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rosöy Musa nko Aron lö kegh pipö Kersyon kïgh anka tïkwïl nyo kömwochï Aron nko werkachi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.27",
            "verseOrgIds": [
              "NUM.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighisyo pipö Kersyon nyï ompö Ema nyo mi ECHOTYON, akï Itamar wero Aron tïsin nyo ghyongchini chane.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.28",
            "verseOrgIds": [
              "NUM.4.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ighisyo pipö Lawi cho pö ara Merari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
