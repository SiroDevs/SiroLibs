          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighisyo pipö Merari nyï ompö Ema nyo mi ECHOTYON, akï Itamar wero Aron tïsin nyo ghyongchini chane.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.33",
