                  "text": "Kiy 29:7-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku nyu kirurut nyo pö kokay ompö akwa lö nyini ketomtö asispa taman nyo pö arawa mut nko odeny, okïrurekwa amagh ighisyö anka tïkwïl nko ton nyo möngöy kwenunkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kighöy linyot asisete atöketïsokwa ompö ngokikwo löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku Sapato* nyo omunyekwa akïrur ompöwölo lïku kirurut nyo pö kokay. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighöy linyot Tïsin nyo Wow* nyo kikekïl kïcheng ngacharuto kwanta, akuloköy sïro pö tïsï ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïtïs Wölo Tïlil Tya nko Ema nyo mi ECHOTYON nko ato kïpelo amöros nko tïsï nko pipö Israel löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku nyete kirurut nyo pö kokay ompö akwa nyo kitïsokwa kïnyïl akonga ompö köny ompö ngokikwa löwïr.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
    },
