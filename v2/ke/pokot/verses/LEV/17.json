              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.7",
            "verseOrgIds": [
              "LEV.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kipesyot chi nko pikachi nyo pö kö pö Israel anta ton nyo möngöy nko chane nyo tötoy amöros nyo kïpelöy anta ropöwon anka tïkwïl ompö ECHOTYON amelö ompö kuka Ema nyo mi ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.8+LEV.17.9",
            "verseOrgIds": [
              "LEV.17.8",
              "LEV.17.9"
            ]
          }
        }
      ]
    },
