              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Könoghöy nyinte ewunyi mötïto tany akïpörchï kuka Ema nyo mi ECHOTYON.* Atolapay kïcheng tïsï kisönkö akwisö kuwit kïghömï ato kïpelo amöros. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.2",
