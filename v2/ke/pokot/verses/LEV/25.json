          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.21.2+EXO.21.3+EXO.21.4+EXO.21.5+EXO.21.6"
              },
              "items": [
                {
                  "text": "Wuw 21:2-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.12+DEU.15.13+DEU.15.14+DEU.15.15+DEU.15.16+DEU.15.17+DEU.15.18"
              },
              "items": [
                {
                  "text": "Krt 15:12-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato lïkwï meywon chi akonga ompö akwa akwolunyi kegh, megh nyinte kïpöghisyö le sekeyon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.39",
            "verseOrgIds": [
              "LEV.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo inam nyinte le ton anta pïnotyon, pöghisyewunyi le mötworin ntökwit könyi kilïngat. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.40",
            "verseOrgIds": [
              "LEV.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö nyu nyinte nko monechi kïmïla katangwa wölo mi pikökwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.41",
            "verseOrgIds": [
              "LEV.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo mötworichan chane cho kyamïtunan koro Misri. Melö kyoltoy le sekey. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.42",
            "verseOrgIds": [
              "LEV.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meghapghap chane, wölo ikonyït Tororötïngu ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.43",
            "verseOrgIds": [
              "LEV.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imukenyi ole sekeyköku cho le mïrön anta kor ompö puntonichï kiwitakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.44",
            "verseOrgIds": [
              "LEV.25.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukekwa ole pïnot tïkwïl cho möngöy nko akwa nko monekwa cho kiyichï korenkwa kïlïkwï chikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.45",
            "verseOrgIds": [
              "LEV.25.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïlöy monekwa sekeyikwa, tökïpöghisyechï chane kokay. Wölo maghapghap werkökwo pipö Israel.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.46",
            "verseOrgIds": [
              "LEV.25.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.46",
            "verseOrgIds": [
              "LEV.25.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 25:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato lïkwï sïkön chi nyo le pïnotyon nyo möngöy nko akwa akïlïkwï werïnkwa meywon akwoltochï kegh pïnotyontonay anta arengwa le sekeyon, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.47",
            "verseOrgIds": [
              "LEV.25.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 25:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "kumuköy nyu werkökwa kwal ngat, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.48",
            "verseOrgIds": [
              "LEV.25.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 25:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "anta mamatanyi anta werkökwa walaka anta arengwa anka ntökwal ngat anta ato lïkwï sïkön kwal kegh. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.49",
            "verseOrgIds": [
              "LEV.25.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 25:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïchini kïtepa echotyonte nyini kyal nyinte, atolapay kuyit tïkwïl könyis kïngata otini kyalta kegh ntökwit könyi kilïngat kighöy olyenyi kïrïp kegh nko könyiswechini kötöpöghisïyi le mötworin. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.50",
            "verseOrgIds": [
              "LEV.25.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 25:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato köngötï könyiswö cho ngörï ntökwit könyi kilïngat kutyoköy kegh kïrïp kegh nko könyiswechini kötöpöghisyechini nyinte, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.51+LEV.25.52",
            "verseOrgIds": [
              "LEV.25.51",
              "LEV.25.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 25:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "le ato köle mötworin nyo nömöy ropïyen. Amekany kïpayta nyinte ompö ghapghapat. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.53",
            "verseOrgIds": [
              "LEV.25.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 25:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato memuko kyal ngat nyinte le nyï, ketyoköy nyu nyinte nko monechi ompö könyi kilïngat. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.54",
            "verseOrgIds": [
              "LEV.25.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 25:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
