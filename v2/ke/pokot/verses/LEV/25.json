            "sid": "LEV 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.1",
            "verseOrgIds": [
              "LEV.25.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.10+EXO.23.11"
              },
              "items": [
                {
                  "text": "Wuw 23:10-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa ompö kutïng pö Sinay, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.1",
            "verseOrgIds": [
              "LEV.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwochinö pipö Israel lö, nyini katïtekwa koronini okonokwa, mongorsyö könyi mut nko odeny ompöwölo könyi Sapato* ompö ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.2",
            "verseOrgIds": [
              "LEV.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olechinekwa kösïgh parenikwo akwïnchïr sapipunekwo alisyekwa ompö könyis mut nko akonga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.3",
            "verseOrgIds": [
              "LEV.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo könyi mut nko odeny kïlïku könyi Sapato nyo pö kimïny ompö kor. Lïku köny nyo kakitïlilchï ECHOTYON. Molechï kösïgh parenikwo anta akwïnchïr sapipunekwo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.4",
            "verseOrgIds": [
              "LEV.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motöp ntol pagh cho kapit opïn amopït sapipun cho melö kyakwïnchïrakwa ompö könyinoni pö kimïny ompö kor. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.5",
            "verseOrgIds": [
              "LEV.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïrkegh kemungöy korö könyinoni, onyorukwa omisyö nyo mïchinokwa nko sekeyikwa cho le mïrön nko cho le kor nko mötworikwa nko to cho möngöy nko akwa ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.6",
            "verseOrgIds": [
              "LEV.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akïpïghyongöy kyakikwa tïkwïl nko tyonkïn cho mi korenkwa. Lïku omisyö kïgh anka tïkwïl nyo rïro kor.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.7",
            "verseOrgIds": [
              "LEV.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Könyi kilïngat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.7",
            "verseOrgIds": [
              "LEV.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Oyitekwa könyis mut nko odeny kïnyïl mut nko odeny, lïku könyis 49 löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.8",
            "verseOrgIds": [
              "LEV.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay ayontekwa chi nyo wetöy kïkutöy kontï kïghömï kor asisini pö taman ompö arawa mut nko odeny ompö asispa linyot.* ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.9",
            "verseOrgIds": [
              "LEV.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oghekwa nyu könyi tömönut mut kïtïlilit. Omwotïtokwa kityakat ompö pipö korenkwa löwïr, lïku kinanata könyis tömönut mut ompö akwa, lïngöy chi anka tïkwïl kinyi, kïmïla sekeyonta katangwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.10",
            "verseOrgIds": [
              "LEV.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mongorsyö anta ol tïkwïn cho kapit opïn anta opït sapipun cho makwïnchïrnye chi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.11",
            "verseOrgIds": [
              "LEV.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tïlil könyinoni kïmïkul ompö akwa. Omekwa tïkwïn cho kapit opïn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.12",
            "verseOrgIds": [
              "LEV.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.12",
            "verseOrgIds": [
              "LEV.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lïngöy chi kinyi nyo kyalta ompö könyinoni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.13",
            "verseOrgIds": [
              "LEV.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato iolchï pöröryengu par anta iyala nyinte, kï mïchini oghchinö kegh nyo karam. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.14",
            "verseOrgIds": [
              "LEV.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyalta par kïrïp kegh olye nko könyiswechini kïngoröy kïtomö kwit könyi kilïngat. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.15",
            "verseOrgIds": [
              "LEV.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato changit könyiswö itas olye kïyetï anta ngörïngit ireyteghö olye, ompöwölo paghechini rïro paranini chini olenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.16",
            "verseOrgIds": [
              "LEV.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moghchï kegh nyo gha, wölo okonyït Tororöt. Ochan ECHOTYON Tororötïnkwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.17",
            "verseOrgIds": [
              "LEV.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kömpölelyo könyi mut nko odeny",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.17",
            "verseOrgIds": [
              "LEV.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Orip kirurutköchan löwïr, atamanga koronï ompö kalya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.18",
            "verseOrgIds": [
              "LEV.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rïröy korö paghechi cho omekwa apïghyö amöngisyö ompö kalya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.19",
            "verseOrgIds": [
              "LEV.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.19",
            "verseOrgIds": [
              "LEV.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wölo ato olekwa, ‘Kyomecha ne ompö könyi mut nko odeny ato mökïngorsyechanye?’ ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.20",
            "verseOrgIds": [
              "LEV.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okonokwa kisoyönutköchan ompö könyi mut nko akonga, tökïrïr pagh cho mïchini könyis sömök. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.21",
            "verseOrgIds": [
              "LEV.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato ongorsyekwa könyi mut nko sömök kïtö omekwa pagha könyiswechay le sömök ntökïtenö kïrïr pagha könyi mut nko angwan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.22",
            "verseOrgIds": [
              "LEV.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kilïngata tïkwïn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.22",
            "verseOrgIds": [
              "LEV.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Moltonye chi kor kokay, ompöwölo nyinyan kore. Ochikwa to achï pïnot.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.23",
            "verseOrgIds": [
              "LEV.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.23",
            "verseOrgIds": [
              "LEV.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mïchini kechömchï chi nyo kyalta parenyi kwal ngat. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.24",
            "verseOrgIds": [
              "LEV.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato lïkwï werïngwo meywon akwalta tïkuchi kareran, kungwïnöy chitöngwa kwolöy akuyoda kini kyalta werïngwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.25",
            "verseOrgIds": [
              "LEV.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato chi nyo mötïnye chitöngwa nyo olöy, kï köngöy nyinte ato sïch tïkwïn cho muköy ntökwal, kwal. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.26",
            "verseOrgIds": [
              "LEV.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghoktoy ropïyen cho pö könyis cho köngötï tökutomtö könyi kilïngat otini kyalta nyinte. Kïwö nyu kwal kinyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.27",
            "verseOrgIds": [
              "LEV.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato möghömöy ropïyeni cho kyolo, kïtöpo kini mori chichini kyal ntökïtenö kwitïta könyi kilïngat, kulïng nyu könyinoni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.28",
            "verseOrgIds": [
              "LEV.25.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.28",
            "verseOrgIds": [
              "LEV.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato alta chi konyi nyo kömöngöy nyo kitek nayatu kanasyan, kumuköy kwal ngat atowonyö könyï akonga kïngata otini kyalta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.29",
            "verseOrgIds": [
              "LEV.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato malnye nyinte otini kewonyö könyï akonga, kïpöyitu kot chichay kyal kokay nko monechi. Melö tökulïngöy ompö könyi kilïngat. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.30",
            "verseOrgIds": [
              "LEV.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato korïn cho melö mito kanasyan keghöy le wölo kidoy paren cho muköy chito kïpö kwolöy ngat anta kilïng ompö könyi kilïngat. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.31",
            "verseOrgIds": [
              "LEV.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo muköy pipö Lawi ntökwal ngat korïn cho mi kanastinekwa ompö asis anka tïkwïl. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.32",
            "verseOrgIds": [
              "LEV.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo ato al chi pö Lawi köyoni, atolapay kuyoku kegh chichay kikyala kot tagh kungwïn kwala nyinte, kïmïchini keyokyï chichay pö Lawi ompö könyi kilïngat. Ompöwölo korïn cho mi kanastin cho kimöngöy pipö Lawi kï pö pipö Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.33",
            "verseOrgIds": [
              "LEV.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kyoltoy koro ocheywo pipö Lawi ompöwölo nyingwa kokay.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.34",
            "verseOrgIds": [
              "LEV.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kemongchï mey tïkwïn",
          "type": "text"
        }
      ]
    },
