                "loc": "LEV.19.27+LEV.19.28"
              },
              "items": [
                {
                  "text": "Law 19:27-28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.1"
              },
              "items": [
                {
                  "text": "Krt 14:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mötöröröcha tïsï mötöwekwa anta silsil tamughayikwa anta mut porwöyikwa kuporï lokekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.5",
            "verseOrgIds": [
              "LEV.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku chane cho tïlilöch ompö ani amesïmnyonöcha kaynenyan, ompöwölo tötoy chane ropöwo omisyö ompö ani, kïlenyona kïmïchini kïtïlilitu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.6",
            "verseOrgIds": [
              "LEV.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mepönye chepkartayan anta nyo melö chepkïltït anta nyo kiketyak, ompöwölo tïlilöch tïsï ompö Tororötïngwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.7",
            "verseOrgIds": [
              "LEV.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okonyïtekwa tïlilöch tïsï ompöwölo tötoy chane ropöwonto omisyö ompö ani. Ochan ECHOTYON nyo tïlil nyo otïlilokwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.8",
            "verseOrgIds": [
              "LEV.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato sïmnyon kegh chepö tïsin ompö chepkartanan, kï ketö paponyi arasï, kepelöy nyinte lökïr.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.9",
            "verseOrgIds": [
              "LEV.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.9",
            "verseOrgIds": [
              "LEV.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato Tïsin nyo Wow* ompö werkökwa nyo kikeyil atökulach sïro pö tïsintön, kïmelö pïstoy putechi kïtirirön anta pachpach sïrokachi kuporï lokechi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.10",
            "verseOrgIds": [
              "LEV.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amöwetönye ato mi mïntïrïch, kïrkegh kö paponyi anta yonyi, atömesïmnyon kegh, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.11",
            "verseOrgIds": [
              "LEV.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "anta lït Ema nyo mi ECHOTYON* kï sïmnyon. Ompöwölo mi mwaghay pö ECHOTYON mötïnyi. Ochan ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.12",
            "verseOrgIds": [
              "LEV.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipöy nyinte chepkïltït. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.13",
            "verseOrgIds": [
              "LEV.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mepönye korka nyo le mïsïk anta nyo kiketyak anta korka nyo kikesïmnyon ompö anta chepkartanan. Wölo ipöy korka nyo pö arengwa nyo le chepkïltït. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.14",
            "verseOrgIds": [
              "LEV.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atömesïmnyon monechi ompö pikökwa, ompöwölo ochan ECHOTYON nyo otïlilan nyinte.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.15",
            "verseOrgIds": [
              "LEV.21.15"
            ]
          }
        }
      ]
    },
