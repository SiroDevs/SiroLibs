          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.23",
            "verseOrgIds": [
              "LEV.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïngölonchï nyu Musa Aron nko werkachi nko pipö Israel löwïr lenyoni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.24",
            "verseOrgIds": [
              "LEV.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tïlilyo ropöw",
          "type": "text"
        }
      ]
    }
