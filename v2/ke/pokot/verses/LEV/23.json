              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.23",
            "verseOrgIds": [
              "LEV.23.23"
