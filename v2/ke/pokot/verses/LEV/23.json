        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.1",
            "verseOrgIds": [
              "LEV.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwochinö pipö Israel lö, achï kirurut cho orïpekwa ompö ichontin cho tïlilöch ato oryomekwa asagh ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.2",
            "verseOrgIds": [
              "LEV.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
