            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato olöy paghekwo, mol ntökwit nyini le söröm, amaghamït ngötunön ompö par, opïsyinekwa mey nko cho le to. Ochan ECHOTYON Tororötïnkwa.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
