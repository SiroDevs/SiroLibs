              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akukana ewunyi mötïto kechanay akïpörchï otini kïpörchini amöros nyo kïpelöy. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.33",
