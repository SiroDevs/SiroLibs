                  "text": "Kiy 15:27-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato igh chi anka kïtïkon ngokï kïpeny kirurut pö ECHOTYON amelö ompö kwötyin, kï nam ngokï, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.27",
            "verseOrgIds": [
              "LEV.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyini kösöwï nyinte ngokichi, kïmïchini kurewï aran nyo sakat nyo lïpop le ropöwontenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.28",
            "verseOrgIds": [
              "LEV.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akukana ewunyi mötïto aran akïpörchï otini kïpörchini amöros nyo kïpelöy. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.29",
            "verseOrgIds": [
              "LEV.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kulut tïsin morïn kisön pö artanay akutö kuyo ato kïpelo amöros. Atolapay kïcheng kisönkö chinö kïngötï akïmïlchï kelyo ato kïpelo amöros. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.30",
            "verseOrgIds": [
              "LEV.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 4:31"
          },
          "items": [
