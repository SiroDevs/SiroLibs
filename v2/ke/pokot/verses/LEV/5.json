          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tïngeto chi lelut nyo ato kïkur kungwïn kïmwa söwintön nyo pö kïgh nyo kisïwa anta nyo nkït, kïsisï kegh.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.1",
            "verseOrgIds": [
              "LEV.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.1",
            "verseOrgIds": [
              "LEV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato swany chi kïgh nyo le sïmnyon nyo kima ato kö tyony anta kö tany amelö ompö kwötyin, otini kösöwï, kï kikusïmnyon kegh, akïlel akinam ngokï nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato swany chi sïmnyonto chi anta sïmnyon anka tïkwïl amelö ompö kwötyin, otini kösöwï, kï kinam ngokï.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato sörchï chi kuwalwal kegh kwigh kïgh nyo gha anta nyo karam amelö ompö kwötyin, otini kösöwï kï kinam ngokï.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato kinam ngokï chi ompö tïkuchoni, kïmïchini kïnganyta ngokichi ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "akwipchï ECHOTYON kech anta aran kïlïkwï ropöwontenyi, ighöy tïsin lenyoni atökulinyö nko ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïnyïl ato memïnye kïnyorï kech nyo pö ngokichi kwipchï ECHOTYON chepïrïmpen odeny anta kayuntun odeny atökïghaktegha ngokichi, lïku akonga ropöwonto ngokï kïlïkwï anka amöros nyo kïpelöy. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipchini nyinte tïsin töritwe nyo nyoghöy kutötoy ropöwonto ngokï. Ryönöy tïsin katït wölo melö ngötiyöy. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.8",
            "verseOrgIds": [
              "LEV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kwisö kisön pö töritwechay kamasu ato kïpelo amöros. Atolapay kïcheng kisönkö chinö köngötï akïmïlchï kelyo ato kïpelo amöros. Nyete kï ropöwonto ngokï. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.9",
            "verseOrgIds": [
              "LEV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïcheng tïsin tarite nyinö anka akutötö le amöros nyo kïpelöy kïrïp kegh nko kirurut. Ighöy tïsin lenyoni atö kulinyö nko ECHOTYON atö kelöstoghchï nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kïnyïl ato memïnye kïnyorï chepïrïmpen odeny anta kayuntun odeny, kwipï nyu pïsya cho pö kilö akonga le ropöwonto ngokï. Melö töni mwaghpa orolwö anta tïkwïn cho ngutoy cho onyïn, ompöwölo ropöwonto ngokï. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipchini nyinte tïsin nyo römöy römut akonga kïlïkwï machey nyo pö pïsyechay akïpel ompö ato kïpelo amöros le ropöwonto ngokï ompö ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ighöy nyu tïsin lenyoni atökulinyö nko ECHOTYON atökelöstöghchï nyinte ngokichi löwïr cho kegh. Atolapay kïpöyit tïsin cho köngötï löwïr le ompö pagh.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ropöw cho kïghoktegho ngokï",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï ECHOTYON Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.14",
            "verseOrgIds": [
              "LEV.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato lel chi kwigh ngokï amelö ompö kwötyin akïpeny ompö tïkwïn cho kikengotyï ECHOTYON kurechini ECHOTYON makal anta kwagha nyo lïpop le ropöwon nyo kïghoktegho ngokï. Kikipimo olyeto ropöwontononi ropïyeni osiswechoni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mïchini kïghakta nyinte tïpö ECHOTYON cho kitökeghoköy, akïtas akonga ompö mut. Ighöy tïsin lenyoni atökulinyö nko ECHOTYON atökelöstoghchï nyinte.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ato igh chi ngokï amelö ompö kwötyin, akwigh kïgh kïtïkon ompö kirurut pö ECHOTYON cho kïkïröy, kïrkegh melö kenkït, kï kinam nyinte ngokï, akwomöy ngalechoni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurechï nyu tïsin makal anta kwagha nyo lïpop le ropöwon nyo kïghoktegho ngokï. Kikipimo olyeto ropöwontononi ropïyeni osiswechoni. Ighöy tïsin lenyoni atökulinyö nko ECHOTYON atökelöstoghchï nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.18",
            "verseOrgIds": [
              "LEV.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lïku ropöwon nyo kïghoktegho ngokï cho kinam nyinte ompöwölo kipeny ECHOTYON.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        }
      ]
    }
