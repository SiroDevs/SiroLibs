    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tötoy chi pïsya ato pö ropöwechi pagh cho ropchini ECHOTYON. Mïlchini nyinte mwagh akutö tïkwïn cho ngutoy cho onyïn ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.1",
            "verseOrgIds": [
              "LEV.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akwipchï tïsï cho pö ara Aron. Chengöy nyu tïsin pïsya römut akonga nko mwada nko tïkuchay löwïr ngutoy cho onyïn, atolapay kïpel kïlïkwï machey nyo pö pïsyechay löwïr ompö ato kïpelo amöros le ropöwon nyo ngutoy nyo karam ompö ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.2",
            "verseOrgIds": [
              "LEV.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pöyitu tïsï chinö köngötï ompö ropöwo paghechay. Lïku ropöwon nyo tïlil tya, ompöwölo kakïchengunö omisyö nyo kakitö ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.3",
            "verseOrgIds": [
              "LEV.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.3",
            "verseOrgIds": [
              "LEV.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tötoy chi makatin cho puryö mumar ato pö ropöwechi makatin cho kakigha tör, akï makatina pïsya cho kakïtasa mwaghpa orolwö anta makatin cho töwörör cho kakiyila mwaghpa orolwö.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.4",
            "verseOrgIds": [
              "LEV.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.4",
            "verseOrgIds": [
              "LEV.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tötoy makatin cho puryö mumar, wölo kïtöstoy mwaghpa orolwö ato pö ropöwontenyi makatin cho kakigha kerony. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.5",
            "verseOrgIds": [
              "LEV.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imïnchïronenyi aimïlchï mwagh. Nyoni kï ropöwonto pagh nyoni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.6",
            "verseOrgIds": [
              "LEV.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.6",
            "verseOrgIds": [
              "LEV.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tötoy pïsya akïtasta mwaghpa orolwö ato pö ropöwontenyi makatin cho kakigha kerony. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.7",
            "verseOrgIds": [
              "LEV.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay ipchinyi ECHOTYON ropöwontengu aitö tïsin nyo ipöy ato kïpelo amöros. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.8",
            "verseOrgIds": [
              "LEV.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chengöy nyu tïsin kareranpa ropöwon, kïlïkwï machey nyo pö makatin löwïr ompö ato kïpelo amöros le ropöwon nyo ngutoy nyo karam nyo ompö ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.9",
            "verseOrgIds": [
              "LEV.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pöyitu tïsï chinö köngötï ompö ropöweko paghechay. Lïku ropöwon nyo tïlil tya, ompöwölo kakïchengunö omisyö nyo kakitö ECHOTYON.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.10",
            "verseOrgIds": [
              "LEV.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.10",
            "verseOrgIds": [
              "LEV.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mömicha ropöw walaka tïkwïl cho pö pagh cho itöninyi ECHOTYON cho mi mumar. Metöninye chi mumar anta kumat ropöwon nyo kitöni ECHOTYON. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.11",
            "verseOrgIds": [
              "LEV.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otönikwa poretayi pagh ECHOTYON, wölo melö kitötegho ato kïpelo amöros le ropöwon nyo ngutoy nyo karam. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.12",
            "verseOrgIds": [
              "LEV.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itöninenyi partin ropöwontengu anka tïkwïl nyo pö pagh. Kïlenyona mepïstö partin ompö ropöweku ompöwölo partin kï machey nyo pö mumengu nko Tororötïngu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.13",
            "verseOrgIds": [
              "LEV.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itötonyi yiti pagh cho kakïtïgh akekel ato itöninyi ECHOTYON ropöweku cho pö poretayi pagh. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.14",
            "verseOrgIds": [
              "LEV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay imïlchinyi mwaghpa orolwö aitö tïkwïn cho ngutoy cho onyïn. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.15",
            "verseOrgIds": [
              "LEV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelöy nyu tïsin kareranpa ropöwontononi le machey nyo pö tïkuchini löwïr le ropöwon nyo kakïpel ompö ECHOTYON.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.16",
            "verseOrgIds": [
              "LEV.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ropöwo pöghisyö",
          "type": "text"
        }
      ]
    }
  ],
