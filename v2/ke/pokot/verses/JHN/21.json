                "loc": "JHN.13.5"
              },
              "items": [
                {
                  "text": "Yna 13:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kïwaghaka Petro akïsöchï lötunyi kinetana Yeso nyanya anka kichömöy Yeso. Kinetananoni kï nyanya kidopöy Yeso nangat ato kyomisïyi akïtep nyinte lö, “Ngo nyini wïchtoninyi nya Echotyon?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.20",
            "verseOrgIds": [
              "JHN.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kisïwa Petro nyinte, kïlenchï Yeso, “Echotyon, achichï nya?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.21",
            "verseOrgIds": [
              "JHN.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
