        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.23",
            "verseOrgIds": [
              "JHN.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyete nyu kinetananoni kisöwintönchï ngalechï akukir. Akenkïtöcha lö man söwintönenyi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.24",
            "verseOrgIds": [
              "JHN.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngala söröm",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
