              "items": [
                {
                  "text": "Mat 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otini kiwany ngalechoni, kïwö Yeso kïröytö Kapernaum nko kame nko werkökwa nko kinetankachi akïpöghön wöloni osis cho ngörï.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.12",
            "verseOrgIds": [
              "JHN.2.12"
            ]
          }
        }
      ]
    },
    {
