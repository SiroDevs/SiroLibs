        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.20",
            "verseOrgIds": [
              "JHN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kingölono Yeso Kö pö Tororöt, nyoni kï portanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.21",
            "verseOrgIds": [
              "JHN.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kitutunö nyinte ngwen kunan nyu kinetankachi lö kökikïngalana nyinte ngalechoni, kughan nyu chane Kikirut akughan ngalechanye kökikïmwochï Yeso chane.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.22",
            "verseOrgIds": [
              "JHN.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkït Yeso mïkulis pö pich löwïr",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.22",
            "verseOrgIds": [
              "JHN.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwotini kimi Yeso Yerusalem, ompö omisyo Pasaka, kughan pich cho chang nyinte otini kisïwa ighisyewut cho chang cho kigh. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.23",
            "verseOrgIds": [
              "JHN.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo melö kighan Yeso chane, ompöwölo kinkït nyinte pich löwïr. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.24",
            "verseOrgIds": [
              "JHN.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akimötïngnye machat lö tömwowon chi ngaleko pikö walaka, ompöwölo kinkït ngal lapay cho kinonöy pich.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.25",
            "verseOrgIds": [
              "JHN.2.25"
            ]
          }
        }
      ]
