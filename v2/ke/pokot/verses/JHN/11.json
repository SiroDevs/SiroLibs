              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi chane kimöröy Yeso, otini kimi chane kïtuyegho Kö pö Tororöt, kïtep kegh lö, “Ononekwa lö ne nya? Metunye so otete kyomöy Pasaka?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.56",
            "verseOrgIds": [
              "JHN.11.56"
            ]
          }
        }
