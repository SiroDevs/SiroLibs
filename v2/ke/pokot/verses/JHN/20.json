  "copyright": "PUBLIC DOMAIN",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "JHN 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompö asispa Chumapili kiwasan, otini kitökïtuw, kïwö Marya Makdalena kutang pïrïmponay akïsïwa lö kikengeta koghay kukanay pö pïrïm. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.1",
            "verseOrgIds": [
              "JHN.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurïp wölo mi Simon Petro nko kinetane nyanya anka kichomöy Yeso akïlenchï, “Kikechenga Echotyon pïrïm amökinkïtöchanye wölo kipa chane kutö.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.2",
            "verseOrgIds": [
              "JHN.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.2",
            "verseOrgIds": [
              "JHN.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïnget nyu Petro nko kinetane nyanya anka kïpa kutang pïrïmpononi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.3",
            "verseOrgIds": [
              "JHN.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiryagh chane kwodeny, wölo kurïp tya kinetananay anka akïtïl Petro, kïnya kwitïta pïrïmpononi tagh. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.4",
            "verseOrgIds": [
              "JHN.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungïrukö akïsïwa anankischay pö katani, wölo kimölïtnye ori. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.5",
            "verseOrgIds": [
              "JHN.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi Simon Petro lötunyi kungwïnöy, kungwïn akïlït pïrïmpononi. Kïsïwa anankïschay pö katani kikighïtochï atoni ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.6",
            "verseOrgIds": [
              "JHN.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko ananka nyo kikïnonoghchï mötïnyi. Kimelö kikighïtö nko anankischay pö katani wölo kikïnanagh nyinte onkït. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.7",
            "verseOrgIds": [
              "JHN.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlït ori kinetananay anka kinya pïrïm tïkwïl, kïsïwa akughan. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.8",
            "verseOrgIds": [
              "JHN.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Kitomöcha kïpköchï ngala cho mi Kikirut cho mwoghöy lö, tutu nyinte nyo mötïny.) ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.9",
            "verseOrgIds": [
              "JHN.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kimïlonchö kinetanchay katangwa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.10",
            "verseOrgIds": [
              "JHN.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kechumchï Yeso Marya Makdalena",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.10",
            "verseOrgIds": [
              "JHN.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi Marya kughyongöy akïloko pïrïmpononi sany. Akwotini kitökïloköy, kungïrukö akuros pïrïmpononi, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.11",
            "verseOrgIds": [
              "JHN.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kïsöchï wöloni malayken odeny cho kiloköy sïro cho relach, kimi kumpuröy atanye kimi por pö Yeso, kimi anka möt kïmi nyo pö kelyön. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.12",
            "verseOrgIds": [
              "JHN.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep malaykenichoni nyinte lö, “Ilochonyi ne nya we yo?” Kuyokyï lö, “Kösït pich Echotyontenyan, amonkïtönye wölini ketö chane!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.13",
            "verseOrgIds": [
              "JHN.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.13",
            "verseOrgIds": [
              "JHN.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyini kiwany nyinte kïmwa ngalechoni, kïwaghaka akïsïwa Yeso mi kughyongo atoni, wölo kimenkïtnye lö ki Yeso nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.14",
            "verseOrgIds": [
              "JHN.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïtep Yeso lö, “Ilokonyi ne? Ngo nyini imörenyi?” Kunonchï kegh Marya lö töptoy ki ripinto paranoni, kïlenchï, “Ato nyi nyo kesït nyinte, we echotyon, iporwante wölini ketönönyi nyinte, towan osït.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.15",
            "verseOrgIds": [
              "JHN.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.15",
            "verseOrgIds": [
              "JHN.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yeso, “Marya!” Kïwaghaka Marya akïlenchï ompö Eprania, “Rapi!” (Ato kïwaghach kelentöy, “Konetin.”)",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.16",
            "verseOrgIds": [
              "JHN.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.16",
            "verseOrgIds": [
              "JHN.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yeso, “Menömanïn, ompöwölo tomönye owan wölo mi Paponyu.” Wölo wïyö wölo mi werköcha aimwochï chane lö, “Owetan yïm wölo mi Paponyu akï Paponkwa, Tororötïnyan akï Tororötïnkwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.17",
            "verseOrgIds": [
              "JHN.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.17",
            "verseOrgIds": [
              "JHN.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïwö nyu Marya Makdalena akïmwochï kinetankachi lö kakïsïwa nyinte Echotyon akï nyinte nyo kömwochï nyinte ngalechoni.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.18",
            "verseOrgIds": [
              "JHN.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kechumchï Yeso kinetankachi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.18",
            "verseOrgIds": [
              "JHN.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany kwimön asisoni pö Chumapili akimi kinetanchoni korïn ori cho kikelökön kukot, ompöwölo kiwagh chane kintöghoghi pipö Yaudi, kungwïn Yeso akughyongö kwenungwa akïlö, “Pöghisyö akwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.19",
            "verseOrgIds": [
              "JHN.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.19",
            "verseOrgIds": [
              "JHN.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otini kiwany kïmwa lenyoni, kuporchï chane ewunechi nko karastanyi. Kïngörekyö kinetanchay pö Yeso nyoman otini kisïwa chane Echotyon. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.20",
            "verseOrgIds": [
              "JHN.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchï Yeso chane ngat, “Nya kïtöpö kalya nko akwa. Kïle wölini kiyonwanïn Paponyan, oyontonokwa lenyoni.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.21",
            "verseOrgIds": [
              "JHN.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikany kïmwa lenyoni, kumunchï chane akïlö, “Atacha Mïkulögh nyo Tïlil. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.22",
            "verseOrgIds": [
              "JHN.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.19"
              },
              "items": [
                {
                  "text": "Mat 16:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.18"
              },
              "items": [
                {
                  "text": "18:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ato olöstoghchikwa pich ngokikwa, kelöstoghchini. Kwato molöstoghchikwanye chane, kïmelö kïlöstoghchini.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.23",
            "verseOrgIds": [
              "JHN.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeso nko Tomas",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.23",
            "verseOrgIds": [
              "JHN.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimöminye Tomas (nyo kïkuro Sölowö), nyo kile akonga ompö kinetankachi chay le taman nko odeny nko chane atoni kingwïn Yeso. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.24",
            "verseOrgIds": [
              "JHN.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïmwochï nyu kinetanka walaka lö, “Kakïsïwecha Echotyon!” Kilenchï Tomas chane, “Ato masïwanye perutöyi mïsumaris ompö morichi, atatapan morïchu perutöyichoni, atatap perut nyo mi karasunyi, kïmoghönanye.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.25",
            "verseOrgIds": [
              "JHN.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.25",
            "verseOrgIds": [
              "JHN.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïkany kuwonyö wiki akong, otini kimi kinetanpa Yeso korïn ori ngat akimi nyu Tomas nko chane. Ki lökönote kukotï, wölo kungwïn Yeso akughyongö kwenungwa akïlö, “Nya kïtöpo kalya nko akwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.26",
            "verseOrgIds": [
              "JHN.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atolapay kïlenchï Tomas, “Tönö morïku yi airos morichan aighïtö ewungu aitatap karasunyan. Pïstenö tomtomönöt, aighan!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.27",
            "verseOrgIds": [
              "JHN.20.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.27",
            "verseOrgIds": [
              "JHN.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyokyï Tomas nyinte lö, “Echotyontenyu aichï Tororötïnyu!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.28",
            "verseOrgIds": [
              "JHN.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.28",
            "verseOrgIds": [
              "JHN.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kïlenchï Yeso, “Keghananyi, so ompöwölo kesïwaninyi? Soyönote pich cho ghönöy akïtomöcha kïsïwa chane!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.29",
            "verseOrgIds": [
              "JHN.20.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Keröto kitapunï",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.29",
            "verseOrgIds": [
              "JHN.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigh Yeso kiporutkö walaka cho chang ompö tawuto kinetankachi cho melö kikikir kitapunï. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.30",
            "verseOrgIds": [
              "JHN.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wölo kakikir ngalechete atamukakwa aghana lö, Yeso kï Kristo* Wero Tororöt, akwoto aghanakwa, osïkekwa söpon ompö kaynenyi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.31",
            "verseOrgIds": [
              "JHN.20.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kechumchï Yeso kinetankachi cho le mut nko odeny",
          "type": "text"
        }
      ]
    }
