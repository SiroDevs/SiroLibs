              "JHN.13.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.27"
              },
              "items": [
                {
                  "text": "Luk 22:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Otini kiwany kuwun kelyekwa, kulach Yeso sïrokachi akïmïla ataye kötöpo le mesa. Kïtep chane lö, “Köpköchokwa kini kaghwakwa nya? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.12",
            "verseOrgIds": [
              "JHN.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okurenanïkwa konetin nko Echotyon akïmïchinokwa okuranïn lenyoni, ompöwölo ochan. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.13",
            "verseOrgIds": [
              "JHN.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwato ochan Echotyon, achï konetin, akwanyï kowunwokwa kelyön ye, kïmïchinokwa tïkwïl owunchinö kegh kelyön. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.14",
            "verseOrgIds": [
              "JHN.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompöwölo koporwokwa körkeyïn nyo orïpöy atagha kïyoni kaghwakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.15",
            "verseOrgIds": [
              "JHN.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.24"
              },
              "items": [
                {
                  "text": "Mat 10:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.40"
              },
              "items": [
                {
                  "text": "Luk 6:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.20"
              },
              "items": [
                {
                  "text": "Yna 15:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwowokwa nyoman lö, möminye sekeyontö nyo wow kïsir echotyontenyi, amöwownye nyo kïyontoy kïsir chichini kayonta nyinte. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.16",
            "verseOrgIds": [
              "JHN.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwato konkïtukwa ngalechoni, ochikwa soyönote ato arïpakwa!",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.17",
            "verseOrgIds": [
              "JHN.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
