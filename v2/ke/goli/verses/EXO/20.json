          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mutagina avatende vinyu mba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.16",
            "verseOrgIds": [
              "EXO.20.16"
            ]
