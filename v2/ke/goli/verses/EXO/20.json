          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.16",
            "verseOrgIds": [
              "EXO.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mundu ategomba inyumba yu mutende mba; atakayirwa mukali weve mba, anoho mutugwa muyaayi anoho mukaana weve mba, anoho eng'ombe, nisukili mba anoho kilala ku viosi viaveeye navio mba.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.17",
            "verseOrgIds": [
              "EXO.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vuti vwa Vandu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
