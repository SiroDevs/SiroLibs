          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa avandu va Isiraeli vamenya mukivala cha vandu va Amoriti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.31",
            "verseOrgIds": [
              "NUM.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Musa yatuma avasaza kuzia kuhenzeriza inzira indahi yu kwingilira lidaala lia Jazeri. Avandu va Isiraeli vaavugura lidaala harara na madaala ga likumberiza, kandi va kunga avandu va Amoriti avamenya mulio.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.32",
            "verseOrgIds": [
              "NUM.21.32"
            ]
          }
        }
      ]
