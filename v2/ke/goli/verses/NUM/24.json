          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalamu yavolera Balaki, “Kalunu nzirana ku vandu vange, navuzwa ningikiri kuzia, ngovolera ga vandu va Isiraeli valikolera vandu vovo mu zing'inga ziza.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.14",
            "verseOrgIds": [
              "NUM.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
