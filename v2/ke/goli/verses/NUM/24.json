          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalamu yativura navoora, “Ndaavoolera vatumwa vawatuma ku inzi ndi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.12",
            "verseOrgIds": [
              "NUM.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kali niiva ulamba ifeza kandi izahabu eveeye munyumba yooyo yu vwami, sindaali nyara kuhing'ana na malago ga Yahova no kokora kindu inzi mwene mba. Ndavoora cha Yahova amboleraa mbore.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Voporofeti vwa Baalamu vwo Kumaliriza",
          "type": "text"
        }
      ]
    },
    {
