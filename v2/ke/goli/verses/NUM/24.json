            }
          ]
        },
        {
          "text": "Kuduuka lwene yilwo Baalamu yamanya ndi Yahova yenya aduuki kugasiza vandu va Isiraeli, kunangwa si yazia kwenyeleriza vudamanu kuli yaali naakori maziambiri mba. Yagilung'ana nahenza lovega lwi changalangwi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.1",
            "verseOrgIds": [
              "NUM.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma nalora vandu va Isiraeli ni vasoosa mu viduma kolondekana ni zihiiri ziavo. Mwoyo gwa Nyasaye gwaza kuye, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.2",
            "verseOrgIds": [
              "NUM.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma naativula voporofeti yivu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
