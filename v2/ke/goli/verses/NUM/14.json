{
  "id": "NUM.14",
  "number": "14",
  "bookId": "NUM",
  "reference": "Livaliza 14",
  "verseCount": 45,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "NUM 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Avandu vililira kandi vibaara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku uvudiku vwosi avandu vaalira novovereri ligali. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.1",
            "verseOrgIds": [
              "NUM.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vililira ku Musa na Haruni nivavoora, “Vwali vove vulahi kunyi kukuzira mu Egebeti noho kukuzira hano mwigendinyama! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.2",
            "verseOrgIds": [
              "NUM.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira ki Yahova akuhilaa mu kivala yiki? Kunyi kulitilwa mu vulwani, avakali viitu na vana viitu valagumirwa. Si vwakaveeye vulahi kunyi kwirana Egebeti?” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.3",
            "verseOrgIds": [
              "NUM.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa vavolerana aveene na vene, “Gendi kotovole mwimiliri ma kwirane Egebeti!”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.4",
            "verseOrgIds": [
              "NUM.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.4",
            "verseOrgIds": [
              "NUM.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Musa na Haruni vinama hasi imbiri wa vandu vosi va Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.5",
            "verseOrgIds": [
              "NUM.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua muyaayi wa Nuni na Kalebu muyaayi wa Jefune, avaari valala ku vatunyirizi, vatandula zinguvu ziavo mu vovereri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.6",
            "verseOrgIds": [
              "NUM.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vavoolera avandu, “Kivala cha kwazia mu kutunyiriza keveeye kilahi ligali. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.7",
            "verseOrgIds": [
              "NUM.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva kulayaanziza Yahova alakuhila wene yeyo, alahaana kivala yiki ku kunyi, ekeveeye kigunamu kandi kenoru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.8",
            "verseOrgIds": [
              "NUM.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutahing'ana na Yahova mba, kandi mutatia vandu vamenyi mu kivala yiki mba. Kulavaguuta ligali. Yahova aveeye harara ni kunyi kandi amali kuguuta avanyasaye vaavo avavakingaa. Kunangwa mutatia mba.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.9",
            "verseOrgIds": [
              "NUM.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa vandu vosi vavolerana nivalohiza kuvalasa na magina nukuvita. Nonoho avandu valora uvukumi vwa Yahova vong'ereng'anaa ku Lihema.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.10",
            "verseOrgIds": [
              "NUM.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musa Yasaalira Vandu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.10",
            "verseOrgIds": [
              "NUM.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavolera Musa, “Avandu yava valasura kuduuka ing'inga ki? Valavula kusuvira kuduuka ing'inga ki, kali niiva mali kokora vilolekizu vinyingi hagati haavo? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.11",
            "verseOrgIds": [
              "NUM.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaleta uvulwaye vudamanu kuvo na ndavadiviza ligali. Navuzwa ndakora ivi kuva baba wihiiri enene ligali kandi yi zinguru kuvavita.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.12",
            "verseOrgIds": [
              "NUM.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.12",
            "verseOrgIds": [
              "NUM.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Musa yavolera Yahova, “Ivi waleeta vandu yava kutura Egebeti ni zinguru zizio. Lwa vandu va Egebeti vahulira ndi ivi umali kudiviza vandu vovo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.13",
            "verseOrgIds": [
              "NUM.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "valavoolera vandu vamenyi mu kivala yiki. Avandu yava vamali kuhulira ndi ivi, Yahova, oveeye harara ni kunyi; kandi ololekaa moni na moni lwa malesi googo gaveeye ku kunyi, kandi wimiraa imbiri wiitu mu munara gwi lilesi mung'inga yu muvasu kandi mu munara gwu muliru mu ing'inga yu vudiku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.14",
            "verseOrgIds": [
              "NUM.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalunu niiva uliita avandu vovo vosi, zihiiri zimali kuhulira luyali lulwo zilavoola ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.15",
            "verseOrgIds": [
              "NUM.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndi, ivi umali kwitira vandu vovo mu changalangwi kigira siwanyala ku valeta mu kivala cha walaga ulahaana kuvo mba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.16",
            "verseOrgIds": [
              "NUM.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa kalunu, O, Yahova, ngusaala nuyanza haana zinguru zizio ku kunyi kandi okole aguwalaga kunyi lwa wavoola, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.17",
            "verseOrgIds": [
              "NUM.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Inzi Yahova mbeeye wa galaha ku vutima: Manyia uvuyanzi vonene kandi vusuuvirifu vutaveeye ne keheri, kandi samiiha uvwoni kandi samiiha yavo vibaara. Navuzwa ndahaana mageri ku vana kandi aviisukulu kuduuka ku likula lia kavaga ni lia kane kigira uvwoni vwa vaguuga vaavo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.18",
            "verseOrgIds": [
              "NUM.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalunu Yahova, ngusaala nuyanza usamihi uvwoni vwa vandu yava, kolondekana nu vuyanzi vuvwo vutaveeye ne keheri, kuli wavasamiiha kutura ing'inga ya vaatura Egebeti.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.19",
            "verseOrgIds": [
              "NUM.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.19",
            "verseOrgIds": [
              "NUM.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yativura, “Inzi ndavasamiiha kuli umali koteeva. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.20",
            "verseOrgIds": [
              "NUM.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa ndagaa ndi, ligali kuli inzi mbeeye Yahova omenya, kandi ligali kuli uvukumi vwange vwizuyi mu lirova liosi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.21",
            "verseOrgIds": [
              "NUM.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "siaveeyeho mundu kali mulala ku vandu yava uliduuka mu kivala yiki mba. Vamali kolola uvukumi vwange kandi vilolekizu viange via ndaakola mu Egebeti kandi mu changalangwi, navuzwa vamali kogeliza liekuzira liange haali kanyingi kandi vasuyi kumbulira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.22",
            "verseOrgIds": [
              "NUM.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si valaduuka mu kivala cha ndisuuhira avaguuga vaavo mba. Siaveeye ho kali mulala ku vandu vamali kusuura yava uliduuka mu kivala yiki mba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.23",
            "verseOrgIds": [
              "NUM.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa mutumikiri wange Kalebu kigira aveeye ni liiva lugano kandi aveeye musuuvirifu ku inzi, ndamuleeta mu kivala chamali kuzia mu nu kutunyiriza, kandi visukululwi vivie vilavugula kivala yiki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.24",
            "verseOrgIds": [
              "NUM.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira Avamaleki na Vakanani avamenyi mu mavoona gi kivala yiki, mugirung'ane mugamba na muzie mu changalangwi kuvitira kunzira izizaa ku inyanza Inzakanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.25",
            "verseOrgIds": [
              "NUM.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yahova Yahaana Mageri ku Vandu va Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.25",
            "verseOrgIds": [
              "NUM.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavolera Musa na Haruni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.26",
            "verseOrgIds": [
              "NUM.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Avandu vachamu yava vililira ku inzi kuduuka ing'inga ki? Inzi mali kuhulira lilira linyingi lia vandu va Isiraeli vililira ku inzi! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.27",
            "verseOrgIds": [
              "NUM.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalunu uvavoolere, ‘Nzisuha ndi, ligali kuli inzi mbeeye omenya, ndakokolera kuli umali koteeva. Inzi Yahova mali kovora. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.28",
            "verseOrgIds": [
              "NUM.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi vosi mulakuza na miviri jinyu jilasalanywa mu changalangwi yiki. Kigira mumali komoloma makuva madamanu ku inzi, siaveeyeho kali mulala ku munyi kutura ku mihiga 20 kuzizagilira uliduuka mu kivala yiki; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.29",
            "verseOrgIds": [
              "NUM.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaamulaga komenya mucho, navuzwa siaveeyeho kali mulala ulimenya mucho nitali Kalebu muyaayi wa Jefune na Joshua muyaayi wa Nuni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.30",
            "verseOrgIds": [
              "NUM.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa vana vinyu avamwavoola valagumirwa, ndavaviika mu kivala cha mumali kusuura yiki, na kilava chavo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.31",
            "verseOrgIds": [
              "NUM.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi mulakuzira hano muchangalangwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.32",
            "verseOrgIds": [
              "NUM.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avana vinyu valagendagenda mwigendanyama ku mihiga 40. Valasalira kigira livula kusuvira liinyu, kuduuka lwa vosi mukuzira mwigendanyama. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.33",
            "verseOrgIds": [
              "NUM.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulanyola mageri ku mihiga 40 kigira uvwoni vwinyu. Muhiga mulala gulava kuvuli madiku 40 aga mwatunyiriza kivala. Nandio munyi mulamanya uvutima vwange ku munyi! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.34",
            "verseOrgIds": [
              "NUM.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzi mali kwisuuha ndi, ndakora yaga ku munyi avandu vaveeye avachamu, avamali kuvunga harara kovora makuva madamanu ku inzi. Munyi vosi mulakuzira hano mwigendanyama. Inzi Yahova mali kovora.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.35",
            "verseOrgIds": [
              "NUM.14.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.35",
            "verseOrgIds": [
              "NUM.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa avandu va Musa yaali natumi kuzia kutunyiriza kivala, valeta makuva madamanu kutura mucho ni vakora avandu vosi nivatanga limoloma vudamanu ku Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.36",
            "verseOrgIds": [
              "NUM.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu yava, avaleeta makuva madamanu kigira kivala yiki, Yahova yaviita vosi nu vulwaye uvudamanu ligali. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.37",
            "verseOrgIds": [
              "NUM.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Joshua muyaayi wa Nuni na Kalebu muyaayi wa Jefune vaahona ku yavo avaari avandu 12 avaazia kutunyiriza kivala.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.38",
            "verseOrgIds": [
              "NUM.14.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ligeriza liu Kutanga Kwingilira Kivala cha kanani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.38",
            "verseOrgIds": [
              "NUM.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Musa yavolera vandu va Isiraeli vosi amakuva ga Yahova yaali navooye, vasioma vululu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.39",
            "verseOrgIds": [
              "NUM.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugambazuri vazia kwingilira kivala chi kiguru, vavoola, “Kalunu kwetegeki kuzia havundu ha Yahova yakovolera. Kwiyama ndi kumali kokora uvwoni.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.40",
            "verseOrgIds": [
              "NUM.14.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.40",
            "verseOrgIds": [
              "NUM.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Musa yavoola, “Kigira ki si muvura kutia lilaga lia Yahova? Munyi si mulaguuta mba! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.41",
            "verseOrgIds": [
              "NUM.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutazia mba kigira Yahova siaveeye ni munyi mba. Avasigu vinyu valamuguuta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.42",
            "verseOrgIds": [
              "NUM.14.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa mutanga vulwani na vandu va Amaleki na Kanaani, munyi mulakuzira mu vulwani, kigira mwasuura kolonda lilaga lia Yahova. Yahova sialava harara ni munyi mba.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.43",
            "verseOrgIds": [
              "NUM.14.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.43",
            "verseOrgIds": [
              "NUM.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa vahindagiriza kuzia kondongozi kwi kivala chi kiguru, kalindio Lisandugu lie Lilagana lia Yahova noho Musa siyatula havundu ho kososa mba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.44",
            "verseOrgIds": [
              "NUM.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku avandu va Amaleki na vandu va Kanaani avamenyaa ku kiguru yiki vaza ni vavalwaana kandi nivavaguuta. Vavalondelera kali kuduuka Horima.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.45",
            "verseOrgIds": [
              "NUM.14.45"
            ]
          }
        }
      ]
    }
