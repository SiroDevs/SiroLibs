      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Liebaala lia Kora, Dazani na Abiramu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kora mwana wa Izihari kutura mu kiliango cha Kohazi wihiiri ya vandu va Levi, na vandu valala kutura muhiiri ya Rubeni kuli Dazani na Abiramu vana va Eliabu, na Oni muyaayi wa Pelezi, vibaara ni vahingila Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.1",
            "verseOrgIds": [
              "NUM.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harara navo vaaliho na vandu vandi va Isiraeli 250, vaali aviimiliri avatovolwa na vandu avamanyikana ligali, vazia nivasingira imbiri wa Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.2",
            "verseOrgIds": [
              "NUM.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vavugana harara kuhing'ana na Musa na Haruni, nivavavoolera, “Munyi muvitiliri! Avandu vosi vaveeye avatakatifu, vuli mulala kuvo kandi Yahova aveeye harara navo. Kigira ki munyi mwekora kuva avanene vu muganda gwa Yahova?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.3",
            "verseOrgIds": [
              "NUM.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.3",
            "verseOrgIds": [
              "NUM.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Musa yahulira yaga, yagwa hasi mamumama nasaara, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.4",
            "verseOrgIds": [
              "NUM.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi yavolera Kora harara nu muganda gwigwe gwosi ndi, “Lidiku lia mugamba, Yahova alamanyia mundu oveeye weve; kandi oveeye mutakatifu, wayatovola, na alamukola yisundi ahimbi naye ku vwali. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.5",
            "verseOrgIds": [
              "NUM.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukore yaga; muvuguli kiju chu muguva",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.6",
            "verseOrgIds": [
              "NUM.16.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:6",
              "type": "text"
            },
            {
              "text": "Muguva:",
              "type": "text"
            },
            {
              "text": "Kindu cha vatuli vatumikira kwakizira manda.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.6",
            "verseOrgIds": [
              "NUM.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mugamba muviiki kucho manda gu muliru kandi muviikiku kimuli kifunyaa umwayu imbiri wa Yahova. Mundu wa Yahova atovoraa, alava niye oveeye mutakatifu. Munyi avandu va Levi mukoli kuvita kegero.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.7",
            "verseOrgIds": [
              "NUM.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.7",
            "verseOrgIds": [
              "NUM.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaazizagilira komoloma ku Kora, “Muhuliri munyi avandu va Levi! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.8",
            "verseOrgIds": [
              "NUM.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muganaganaa ni kindu kekekeeke ku munyi Nyasaye wa Isiraeli Umali kumutovola kutura mu vandu vosi va Isiraeli, nu kumuleeta himbi kuye mwene kunangwa muduuki kokora miyinzi mu Lihema lilie, kandi kusingila imbiri wa vandu nu kuvatumikira? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.9",
            "verseOrgIds": [
              "NUM.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umali kumuleeta harara na vandu va Levi vandi vosi himbi naye, navuzwa kalunu mugerizaa kandi konyoora uvusaalisi! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.10",
            "verseOrgIds": [
              "NUM.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa wililiraa ku Haruni harara nu muganda gwugwo, gaveeye giligali ndi mwibaara ku yahova.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.11",
            "verseOrgIds": [
              "NUM.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.11",
            "verseOrgIds": [
              "NUM.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Musa yatumana Dazani na Abiramu avayaayi va Eliabu, navuzwa vavoola, “Kunyi si kulaaza mba! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.12",
            "verseOrgIds": [
              "NUM.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yivi wakutuliza mukivala cha malova magunamu mu Egebeti kukwitira hano mwigendanyama! Kalunu yivi wenya kukwamiha! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.13",
            "verseOrgIds": [
              "NUM.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivi siokoleeti mu kivala kigunamu noho kuhaana milimi kandi vizabibu kukunyi kuli miandu jitu mba. Kalunu ivi ogerizaa kukugaada sikulaza mba!”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.14",
            "verseOrgIds": [
              "NUM.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.14",
            "verseOrgIds": [
              "NUM.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaali nu vutima na yavolera Yahova, “Utavugilira vihaanwa via vandu yava valeta mba. Inzi ngikiri kwonelaku mundu woosi kuvo mba; kali ngikiri kuvugura ku kali ndala ku zibunda ziavo mba.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.15",
            "verseOrgIds": [
              "NUM.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.15",
            "verseOrgIds": [
              "NUM.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yavolera Kora “Mugamba ivi harara nu muganda gwugwo gwa vandu 250 gamuduukira muzie mu Lihema lia Yahova. Haruni alavayo kandi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.16",
            "verseOrgIds": [
              "NUM.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuli mulala ku munyi alavugula luju lwilwe lwu muliru, aviikiku kimuli maku avileete kuvwaali imbiri wa Yahova.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.17",
            "verseOrgIds": [
              "NUM.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa vuli mundu yavugula luju lwilwe, naviikaku manda gu muliru, kandi naviikaku kimuli. Vazia nivasingila havwingiliru vwi Lihema harara na Musa kandi Haruni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.18",
            "verseOrgIds": [
              "NUM.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Kora yavuganyia vandu vosi harara, kandi vasingira imbiri wa Musa na Haruni ha vwingiliru vwi Lihema. Nonoho uvukumi vwa Yahova vwaloleka ku vandu vosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.19",
            "verseOrgIds": [
              "NUM.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavolera Musa na Haruni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.20",
            "verseOrgIds": [
              "NUM.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwiyahuli kutura ku vandu yava, ninzi ndavadiviza vwangu ligali.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.21",
            "verseOrgIds": [
              "NUM.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.21",
            "verseOrgIds": [
              "NUM.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Musa na Haruni vinama vweni vwavo nivudiira kumalova nivavoora, “O, Nyasaye, Ivi oveeye vutangiliru vwi livamwoyo lia vandu vosi. Lwu mundu mulala akolaa uvwoni, ulava nu vutima na vandu vosi?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.22",
            "verseOrgIds": [
              "NUM.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.22",
            "verseOrgIds": [
              "NUM.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavolera Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.23",
            "verseOrgIds": [
              "NUM.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ovoolere avandu visundi ihale na mahema ga Kora, Dazani na Abiramu.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.24",
            "verseOrgIds": [
              "NUM.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.24",
            "verseOrgIds": [
              "NUM.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Musa harara na vimiliri va Isiraeli vazia ku Dazani na Abiramu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.25",
            "verseOrgIds": [
              "NUM.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yavolera vandu, “Musingiri ihale kutura ku mahema ga vandu vachamu yava, kandi mutadiiri ku kindu chavo mba. Nigataveeye ndio, mulitwa harara navo kigira vwoni vwavo vwosi.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.26",
            "verseOrgIds": [
              "NUM.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa visunda ihale kutura ku mahema ga Kora, Dazani, na Abiramu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.27",
            "verseOrgIds": [
              "NUM.16.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dazani na Abiramu vaali nivatuli ichova nivasingiyi ha vwingiliru ha mahema gaavo, harara na vakali na vana vaavo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.27",
            "verseOrgIds": [
              "NUM.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yavolera vandu, “Kugira yaga mulamanya ndi Yahova yamala kunduma kukola vindu yivi kandi sigaveeye kugira litovola liange kuvikola mba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.28",
            "verseOrgIds": [
              "NUM.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva vandu yava valakuza likuza lia kazozo vugira kuhevwa mageri kutura ku Nyasaye, ndavoora ndi Yahova siyanduma mba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.29",
            "verseOrgIds": [
              "NUM.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa niiva Yahova alakola kindu chokugenyia, ma lirova likunulwi no kuvamira harara ni viavaveeye navio, ma vingili mulirova nivaveeye mwoyo kuzia mukivala cha vakuzu, mulamanya ndi vandu yava vamali kusura Yahova.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.30",
            "verseOrgIds": [
              "NUM.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.30",
            "verseOrgIds": [
              "NUM.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonoho lwayamala kumoloma lirova lia Dazani na Abiramu vasingira ku liavukana ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.31",
            "verseOrgIds": [
              "NUM.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "nilivamila na vizinyumba ziavo harara na valondi vosi va Kora ni miandu jaavo josi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.32",
            "verseOrgIds": [
              "NUM.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa vazia mu malova mu kivala cha vakuzu nivaveeye mwoyo. Vamilwa harara ni miandu jaavo. Lirova liavakunika kandi nivagota. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.33",
            "verseOrgIds": [
              "NUM.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vosi va Isiraeli vaali ni vaveeye ho viiruka lwa vahulira lilira liavo. Vahanzuka nivavoora, “Yiruki! Lirova linyala kukumila kandi!”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.34",
            "verseOrgIds": [
              "NUM.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.34",
            "verseOrgIds": [
              "NUM.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Yahova yatuma muliru ma nigusamba vandu 250 avaari nivahaani kimuli ku vwali.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.35",
            "verseOrgIds": [
              "NUM.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zinju ziu Muliru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.35",
            "verseOrgIds": [
              "NUM.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Yahova yavolera Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.36",
            "verseOrgIds": [
              "NUM.16.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Volera Elieza, mwana wu musaalisi Haruni atulizi zinju ziu mugasa kutura mu muliru gwakaa; ma asalanyie manda ihale kigira yizi ni zinju zindakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.37",
            "verseOrgIds": [
              "NUM.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziagwa zindakatifu lwa zialetwa ku vwali vwa Yahova. Kunangwa vugula zinju yizi kutura ku vandu viitwa kigira vwoni vwavo aveene, uziduyi zive zisahani zing'erere ma uzilombe zive ziu kufuma ku vwali. Yili lilava lieganihiza ku vandu va Isiraeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.38",
            "verseOrgIds": [
              "NUM.16.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa musaalisi Elieza yavugula zinju naaziduya niziva zisahani zinyerere kulomba kifuumilu chu vwali. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.39",
            "verseOrgIds": [
              "NUM.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaga gaali lieganihiza ku vandu va Isiraeli ndi mundu woosi utaveeye wi chisukululwi cha Haruni atiisunda himbi kuvwaali nu kusambira Yahova kimuli mba. Niiva alakola ndio aladivizwa kuli Kora na vandu veve. Yaga goosi gekoleka kuli Yahova yaali nalagi Elieza kuvitira ku Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.40",
            "verseOrgIds": [
              "NUM.16.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Haruni Yahonyia Vandu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.40",
            "verseOrgIds": [
              "NUM.16.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 16:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lidiku lialondaku, avandu vosi vigaana kigira Musa na Haruni nivavoora, “Mumali kwita valala ku vandu va Yahova.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.41",
            "verseOrgIds": [
              "NUM.16.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 16:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa vaali ni vakivungikizana kugaya Musa na Haruni, viikivuka nivahenza wi Lihema lia Yahova liali na valora lilesi lifuumi lihema kandi valora vukumi vwaloleka kumanyia ndi Yahova yaali naveeye ho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.42",
            "verseOrgIds": [
              "NUM.16.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 16:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na Haruni vazia nivasingira imbiri wi Lihema, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.43",
            "verseOrgIds": [
              "NUM.16.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 16:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yahova yavolera Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.44",
            "verseOrgIds": [
              "NUM.16.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 16:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Singira ihale kutura ku vandu yava, na ndavadiviza lwene yilu!”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.45",
            "verseOrgIds": [
              "NUM.16.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 16:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vombi vinama hasi, nu vweni vwavo vwaduuka kumalova, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.45",
            "verseOrgIds": [
              "NUM.16.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 16:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yavolera Haruni, “Vugula zinju zizio ma uviiki ku manda mahiu kutura ku vwali kandi uviiki kimuli ku manda maku uzie vwangu nago mu vandu va Isiraeli ma uvakolere mwima gwu kwitakasa. Zia vwangu! Vutima vwa Yahova vumali koleta lidivizwa nu vulwaye vudamanu vumali kutanga.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.46",
            "verseOrgIds": [
              "NUM.16.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 16:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haruni yahulira, navugura zinju ziu muliru na zia hagati ha vandu vaali ni vaveeye. Lwa yalora ndi lukuzu lwali nilutangi yavika kimuli ku manda naakora mwima gwu kutakasa vandu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.47",
            "verseOrgIds": [
              "NUM.16.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 16:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukuzu lwalekela, na Haruni yaatigalanasingi hagati ha vandu vaveeye mwoyo na vakuzu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.48",
            "verseOrgIds": [
              "NUM.16.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 16:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vaakuza vaali 14,700, ni kutameedi ku vandu vaakuza kigira liebaala lia Kora. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.49",
            "verseOrgIds": [
              "NUM.16.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 16:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwu lukuzu lwali nilwakalekela, Haruni yirana ku Musa uwaali nasingiyi ha vwingiliru vwi Lihema.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.50",
            "verseOrgIds": [
              "NUM.16.50"
            ]
          }
        }
      ]
    }
