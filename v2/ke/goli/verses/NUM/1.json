        },
        {
          "text": "Navuzwa vandu vi ihiiri ya Levi si vavalizwa harara ni zihiiri zindi mba, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.47",
            "verseOrgIds": [
              "NUM.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
