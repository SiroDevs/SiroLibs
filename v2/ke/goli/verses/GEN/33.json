    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo Yavugana na Esau",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yalora Esau niyaza navasaza 400, kunangwa yaagavuranya avana hagati ha Lea, Raheli na vatumikiri veve vakali vaviri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.1",
            "verseOrgIds": [
              "GEN.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yavika imbiri vakali veve vatumikiri navana vaavo kutanga, maku Lea navana veve, kandi mulimaliriza yavika inyima Raheli na Josefu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.2",
            "verseOrgIds": [
              "GEN.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo mwene yazia imbiri kandi nasigama hasi haali saba lwa yisunda ahimbi ku amwavo weve. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.3",
            "verseOrgIds": [
              "GEN.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Esau yanyagula kuzia kumwaganira, namukumbela kandi naamuvusa. Vosi vaalira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.4",
            "verseOrgIds": [
              "GEN.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Esau yahenza muzimbega ziosi ma nalora avakali na vana, yateva, “Ni vandiki avaveeye navo yava?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.5",
            "verseOrgIds": [
              "GEN.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yativura, “Yava nivo avana va Nyasaye amali kuhaana ku mutumikiri woovo mu zimbavasi zizie.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.5",
            "verseOrgIds": [
              "GEN.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku vakali vatumikiri vaza harara na vana vaavo ma nivasigama hasi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.6",
            "verseOrgIds": [
              "GEN.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "maku Lea harara na vana veve vaza, kandi inyima Josefu na Raheli vaza kandi nivasigama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.7",
            "verseOrgIds": [
              "GEN.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.7",
            "verseOrgIds": [
              "GEN.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau yateeva Yakobo, “Nu muganda gwa mbugani nagwo kutanga gwaali guliha” Yakobo yativura, “Mwami wange, inzi ndaatuma muganda yigwo kunangwa ivi uduuki kumbugilira.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.8",
            "verseOrgIds": [
              "GEN.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.8",
            "verseOrgIds": [
              "GEN.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Esau yavoola, “Amwavo wange inzi mbeeye navio vinyingi; viika via oveeye navio.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.9",
            "verseOrgIds": [
              "GEN.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.9",
            "verseOrgIds": [
              "GEN.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yavoola, “Awa! Mwaza vugilira vihaanwa yivi kuli kelolero cho kombera zimbavasi. Lwa ivi waambugilira ma nendoraa mumoni mumwo, ndaali kuli ololi mumoni mwa Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.10",
            "verseOrgIds": [
              "GEN.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaza vugilira kihanwa cha inzi mali kokoletera. Nyasaye yaali ni zimbavasi ku inzi ni yamba vuli kindu choosi cha ndeenya.” Yakobo yaazizagilira kumugonya kuduuki navugilira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.11",
            "verseOrgIds": [
              "GEN.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.11",
            "verseOrgIds": [
              "GEN.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau yavoola, “Leka kwetegeke kuzia. Inzi manya nzie imbiri woovo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.12",
            "verseOrgIds": [
              "GEN.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.12",
            "verseOrgIds": [
              "GEN.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yativura, “Mwami wange ivi umanya ndi avana vaveeye vadedekere, kandi kuduuka ng'anagane viayo via magondi, zimburi harara nivimeme viazio. Niiva vilahirwa vwangu kulidiku lilala vuzwa, mitugu josi jilakuza. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.13",
            "verseOrgIds": [
              "GEN.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaza mwami wange zie imbiri wange mwami, kandi inzi ndakolonda galaha kuli nyara ni mitugu harara na vana kuduuka lwa inzi ngonyoola mu Edomu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.14",
            "verseOrgIds": [
              "GEN.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.14",
            "verseOrgIds": [
              "GEN.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau yativura, “Leka ndeke valala ku vatumikiri vange nivi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.15",
            "verseOrgIds": [
              "GEN.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yativura, “Ivi utakola ndio mba. Inzi mbeeye nuvuyanzi kigira inzi manyirizi ndi ivi umali kombera zimbavasi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.15",
            "verseOrgIds": [
              "GEN.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa lidiku yilio Esau yaatanga logendo lwukwirana Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.16",
            "verseOrgIds": [
              "GEN.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Yakobo yazia Sukozi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.17",
            "verseOrgIds": [
              "GEN.33.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "33:17",
              "type": "text"
            },
            {
              "text": "Sukozi:",
              "type": "text"
            },
            {
              "text": "Mu Luheburaina liveeye kovora mabooma.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", uwa yiyumbakira inyumba na hukuvika mitugu jije. Nicho chagira havundu yaho nihalangwa Sukozi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.17",
            "verseOrgIds": [
              "GEN.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo Aduukaa ha Shekemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.17",
            "verseOrgIds": [
              "GEN.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yakobo yirana kutura Mesopotamia, yaduuka mu mirembe mu lidaala linene lia Shekemu mukivala cha Kanaani. Yumbaka lihema mu mulimi himbi nilidaala linene. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.18",
            "verseOrgIds": [
              "GEN.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaagula kedonye chu mulimi yigwo kutura ku visukululwi va Hamori baba wa Shekemu vidonye vie ifeza 100. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.19",
            "verseOrgIds": [
              "GEN.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yumbaka hene yaho vwali ma naalanga havundu hene yaho Eli, Nyasaye wa Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.20",
            "verseOrgIds": [
              "GEN.33.20"
            ]
          }
        }
      ]
    }
  ],
