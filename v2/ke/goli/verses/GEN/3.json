            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:20",
              "type": "text"
            },
            {
              "text": "Adamu:",
              "type": "text"
            },
            {
              "text": "Yili ni lieta liu Luheburaina iliveeye kovora, “Umundu.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " yagulika mukali weve Hawa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
