            "sid": "HOS 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yambolera, “Zia umanyie kandi vuyanzi vwuvwo ku mukali woovo okolaa kali niiva yayanzwa nu mundu uwundi na akolaa ovoheyi. Ivi kuduuka umuyanze vuzwa kuli inzi Yahova nyanza avandu va Isiraeli, kali niiva vagirung'ana nukuzia kuvanyasaye vandi kandi vayanza kuhaana vihaanwa viumuzabibu gwuminywa ku vifananyi.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.1",
            "verseOrgIds": [
              "HOS.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
