        "style": "s1"
      },
      "items": [
        {
          "text": "Vuyanzi vwa Nyasaye ku Vandu Veve Avibaali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
