            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.27",
            "verseOrgIds": [
              "1JN.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1JN 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kalunu, avana vakekeeke vange, mumenye mu Kristo, kunangwa lwa alolekaa, kove nuvuluviliri, kandi kuvuli kwivisa mu zisoni imbiri weve ku lidiku lie liza lilie. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.28",
            "verseOrgIds": [
              "1JN.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1JN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi mumanyi vulahi ndi Kristo aveeye umulungi; kunangwa gamudukira mumanye ndi mundu woosi okolaa agaveeye malungi aveeye mwana wa Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.29",
            "verseOrgIds": [
              "1JN.2.29"
            ]
          }
        }
      ]
