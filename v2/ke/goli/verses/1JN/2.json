            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.25",
            "verseOrgIds": [
              "1JN.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1JN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vindu yivi mung'oderaa kigira yavo avagerizaa kumugaada. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.26",
            "verseOrgIds": [
              "1JN.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1JN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa ku munyi, Kristo yahaana Roho Mutakatifu weve ku munyi. Ku olohono lwa Roho weve azizagiliraa komenya mu munyi, umundu wundi sigamuduukira mundu wundi amwigizi mba. Navuzwa kuli Roho weve amwigizaa vindu viosi, kandi amigizu geege gaveeye agiligali, kandi sigaveeye gu vugadi mba. Ku mulonde aga Roho yamwigiza kandi mumenye muye mu vuhambani na Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.27",
            "verseOrgIds": [
              "1JN.2.27"
            ]
          }
        }
      ]
    },
