              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikura ya 5 yagwira Nezania, vayaayi veve na aviiko veve vosi vaali komi na mbiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.12",
