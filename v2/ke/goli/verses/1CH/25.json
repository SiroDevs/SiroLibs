              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumanyia kuli miyinzi gigavulanywa, vosi vaakuba zikuura, nivaveeye avasoleri anoho avakulundu, muke ku munene, mwigizi ku mwigizwi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.8",
            "verseOrgIds": [
              "1CH.25.8"
            ]
          }
        }
      ]
    },
    {
