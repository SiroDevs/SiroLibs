            "sid": "1CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vasaza yava vang'odwa kolondekana ni miyinzi ja vahevwa kuzia mu Litembeli nu kutumika ku miyinzi ijatangizwa na guuga wavo Haruni, kuli Yahova Nyasaye wa Isiraeli yamulaga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amita ga vandu va Levi vandi",
          "type": "text"
        }
      ]
    },
    {
