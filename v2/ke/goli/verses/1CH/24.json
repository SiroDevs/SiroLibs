            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.30",
            "verseOrgIds": [
              "1CH.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuli mwimiliri wi inyumba kandi mulala ku avamwavo veve avasoleri vaakuba zikuura ziavo, kuli avamwavo vaavo, avana va Haruni vaali ni vakoli. Yaga gekoleka imbiri wu mwami Daudi, Zadoku, Ahimeleki, harara na aviimiliri vi zinyumba zia vaguuga avasaalisi ni ihiiri ya Levi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.31",
            "verseOrgIds": [
              "1CH.24.31"
            ]
          }
        }
      ]
