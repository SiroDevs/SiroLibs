          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yili ni lilohizwa kuli zikuura ziakubwa ku viduma vie zinyumba 24:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.7",
            "verseOrgIds": [
              "1CH.24.7"
            ]
          }
        }
