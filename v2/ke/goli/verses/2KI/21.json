          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vindu vindi viosi via Amoni yakola, viang'odwa mu vitabu via makuva ga kale ga vami vi Ivuyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.25",
            "verseOrgIds": [
              "2KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni yayavirwa mu kirindwa mu mulimi gwa Uza, na muyaayi weve Josia yavugula vogono vwivwe kuli mwami.",
          "type": "text",
