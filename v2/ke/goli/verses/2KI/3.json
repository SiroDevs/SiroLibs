              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Moabu vahulira ndi avami vavaga yava vaali ni vazi kuvingilira, avasaza vosi vaali vanyara kuginga viuma viu vulwani, kutura ku musakulu ligali kuduuka ku muyaayi mukekeeke, valangwa harara kandi ni vasingirizwa ku lwako ni vetegeki kulwaana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.21",
            "verseOrgIds": [
              "2KI.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa vavuuka mugamba gwalonda ku, liuva liali ni liaka ku mazi, niligakola gave amakanyu kuli amasahi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.22",
            "verseOrgIds": [
              "2KI.3.22"
            ]
          }
        }
