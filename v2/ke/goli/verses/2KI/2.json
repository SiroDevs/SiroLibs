          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Elisha yativura, “Inzi nzisuha ku Yahova oveeye mwoyo kandi ku ivi ndi sindakoleka mba.” Kunangwa vazizagilira kuzia kuduuka Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
