              "type": "text"
            }
          ]
        },
        {
          "text": "Muganda gwa vaporofeti avamenyaa yo vazia ku Elisha ni vamuteeva, “Ukamanyi ku Yahova azizaa kuvugura munene woovo kutura ku ivi kalunu?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        }
