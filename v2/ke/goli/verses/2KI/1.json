            "sid": "2KI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Engelosi wa Yahova yavolera Elija, “Yika haasi uzie naye, na utatia mba.” Kunangwa Elija yazia nu munene oyo ku mwami ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
              "2KI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "namuvolera, “Yiki nicho cha Yahova avoora: ‘Kigira utumi avatumwa koteeva amakuva ku Baalizebubu, munyasaye wa Ekironi kuli sihali na Nyasaye mu Isiraeli wa uteeva makuva, siulahona ligali mba; ivi ligali ulakuza!’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        }
      ]
    },
