        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Elija yativura, “Niiva mbeeye mundu wa Nyasaye, leka muliru gwiiki kutura mwigulu na gukwiiti, ivi harara na avasaza vovo va oveeye navo!” Nonoho muliru gwiika haasi ma nigwiita munene zana na vasaza veve.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.12",
            "verseOrgIds": [
              "2KI.1.12"
            ]
          }
        }
      ]
