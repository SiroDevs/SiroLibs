            "number": "17",
            "style": "v",
            "sid": "2KI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa Ahazia yakuza kuli Yahova yaali navooye kuvitira ku Elija. Ahazia siyaali ku nu mwana muyaayi mba. Kunangwa Joramu amwavo weve yavugula ovogono vwivwe kuli mwami mu muhiga gwa kaviri gwi liamiiha lia Joramu, muyaayi wa Jahoshafati, mwami wi Ivuyuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        }
      ]
    },
