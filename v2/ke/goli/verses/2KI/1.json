              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elija yativulira munene oyo navoora, “Niiva inzi mbeeye mundu wa Nyasaye, leka muliru gwiki kutura mwigulu na gukwiiti harara na vasaza vovo va oveeye navo!” Nonoho muliru gwika nigwiita munene oyo na vasaza veve.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.10",
            "verseOrgIds": [
              "2KI.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.10",
            "verseOrgIds": [
              "2KI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami yatuma munene wundi na avasaza veve 50, avanigira nivavolera Elija, “Mundu wa Nyasaye, mwami alaangaa ivi wiki vwangu!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        }
      ]
