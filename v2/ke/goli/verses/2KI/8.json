              "type": "text"
            }
          ]
        },
        {
          "text": "Vindu vindi viosi via Jehoramu yakola viang'odwa mu kitabu cha makuva ga kale ga vami vi Ivuyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.23",
            "verseOrgIds": [
              "2KI.8.23"
            ]
          }
        },
        {
