          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoramu yakuza kandi yayavirwa mu vilindwa viu vwami mu lidaala linene lia Daudi, na muyaayi weve Ahazia yavugula ovogono vwivwe kuli mwami.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.24",
            "verseOrgIds": [
              "2KI.8.24"
            ]
          }
