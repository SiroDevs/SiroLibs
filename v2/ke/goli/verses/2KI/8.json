              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami Ahazia yahambana nu mwami Joramu wa Isiraeli kulwaana mwami Hazaeli wa Siria. Mahi galwaanira ha Ramozi mu Gileadi, na Joramu yatwa zing'oma mu liihi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
            "verseOrgIds": [
              "2KI.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
