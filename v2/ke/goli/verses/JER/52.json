            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 52:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu muhiga gwa Evili-Merodaki yagwa mwami wa Babiloni, yamanyia zimbavasi ku mwami Jehoyakini wi Ivuyuda ku limuvoholola kutura muvuhambe. Yaga gekoleka ku lidiku lia 25 liu mweli gwa 12 gwu muhiga wa 37 inyima wa Jehoyakini yaali navuguliywi kuli muhambe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Evili-Merodaki yamukolera vulahi, kandi naamuha uvwiyangu vwu luyali lonene ligali, kuvita vwa yaaha avami vandi avaari mu vuhambe harara naye mu Babiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa Jehoyakini yaavugilirwa kugirung'ana kutura mu zinguvu zizie ziu vuhambe kandi kuzia kulia harara nu mwami kazozo mu livamwoyo lilie liatigala liosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuli lidiku ku madiku goosi ga yaali mwoyo, yahevwa mabesa kigira uvutumiki vwa kazozo vwi lienya lilie.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
            "verseOrgIds": [
              "JER.52.34"
            ]
          }
        }
