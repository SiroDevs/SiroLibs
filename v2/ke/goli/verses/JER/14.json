            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yambolera makuva yaga kigira kemeyi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.1",
            "verseOrgIds": [
              "JER.14.1"
            ]
          }
        }
      ]
    },
    {
