          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavoola, “Kulidiku yilio avami kandi avanene sivalava nuvuluviliri mba;",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.9",
            "verseOrgIds": [
              "JER.4.9"
            ]
          }
        }
      ]
    },
    {
