          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.2",
            "verseOrgIds": [
              "JER.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova avooreraa avandu vi Ivuyuda na Jerusalemi, “Mulimi imirimi jinyu ijikikiri kulimwa; mutamiiza uvuguza vwinyu mumafa mba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.3",
            "verseOrgIds": [
              "JER.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vi Ivuyuda na Isiraeli mulindi lilagana lienyu ninzi Yahova winyu, kandi mwihaane munyi aveene ku inzi. Niiva simulakolandio mba, vutima vwange vulaaka kuli muliru kigira ivindu vidamanu viamumali kokora. Vulaaka na siaveeyeho na mulala ulisiminya mba.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.4",
            "verseOrgIds": [
              "JER.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ivuyuda itihizwa nilingilirwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.8",
            "verseOrgIds": [
              "JER.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
