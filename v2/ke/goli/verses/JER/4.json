            "sid": "JER 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vayuda munyi mumali kweletera yaga kolondekana nilimenya liamumali komenya kandi nivindu viamumali kokora. Uvwoni vwinyu vumali kumuletera uvusaaliri yivu; Gamali kusaliliza mioyo jinyu ligali.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.18",
            "verseOrgIds": [
              "JER.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ovovereri vwa Jeremia ku avandu veve",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Malola ga Jeremia Kigira Lidiviza lizaa",
          "type": "text"
        }
      ]
    },
