              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova avoora,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.18",
            "verseOrgIds": [
              "JER.30.18"
            ]
          }
        }
