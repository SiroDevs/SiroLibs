            "number": "8",
            "style": "v",
            "sid": "JER 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova Wuvunyali avoora: “Lwa lidiku yilio liliduuka, inzi ndakavunanye iniira eveeye kumagoti gaavo, kandi ndakatulizi minyororo jayo, sivaliva avatugwa vavageni kandi mba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvogono yivwo, valakatumikiri inzi, Yahova Nyasaye wavo, kandi chisukululwi cha Daudi, cha nangore mwami.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    },
