          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uvutima vwa Yahova voveeye kuli chihi, imbuzaa induru ligali ilahuuza ku mitwi ja vandu avuvuchamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.23",
            "verseOrgIds": [
              "JER.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uvutima vwa Yahova vululu sinavugirung'ane mba kuduuka lwa naduukizi ilienya liezing'anagani zizie. Mumadiku gaaza mulakamanye yaga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.24",
            "verseOrgIds": [
              "JER.30.24"
            ]
