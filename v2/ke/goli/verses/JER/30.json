        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.22",
            "verseOrgIds": [
              "JER.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
