              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukali waletwa siaveeye muvoholore kuzia lukali lundi ing'inga yoosi yu musaza weve aveeye mwoyo mba. Navuzwa niiva musaza weve alakuza, aveeye muvoholore koleetwa nu musaza wundi woosi wu mwene ayaanza; navuzwa niiva musaza zana aveeye Mukristayo ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.39",
            "verseOrgIds": [
              "1CO.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu likalaga liange inzi ndolaa ndi: alava nu vugasu ligali niiva alamenya kuli aveeye ndio. Yizi niziganagani ziange, na ng'anagana inzi kandi nzimilirwa na Roho wa Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.40",
            "verseOrgIds": [
              "1CO.7.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iliteeva kigira viukulia vihaanwa ku Vifananyi",
          "type": "text"
        }
      ]
    }
