          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miliango zana jasiafwa na mangirinya gi vilombe vie zimbaha, kandi misaala ja makindu kandi vimuli. Miliango, vilombe viezimbaha ni vimuli viafumwa ni zahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.32",
            "verseOrgIds": [
