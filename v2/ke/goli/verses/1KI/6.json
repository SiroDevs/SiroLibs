          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Viavikwa kukagatana na Havundu Hatakatifu ligali Hoosi, kunangwa zimbaha ziavio nizinyirika ziadirana hagati he keng'oze; niizisonga zie zimbaha zindi nazio nizidiira madigi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
