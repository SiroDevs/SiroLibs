          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madigi gu uvuhiilu kandi keng'oze chu mugati goosi gaali nigasiahiywi na mangirinya gi vilombe vie zimbaha, misaala ja makindu kandi na kimuli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.29",
            "verseOrgIds": [
              "1KI.6.29"
            ]
          }
        },
