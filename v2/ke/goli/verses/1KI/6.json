          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vwingiliru kuzia muhiilu vasigamira, ifuremu yu mukiliango zikona zine yalombwa kutura ku zimbaho zia muzeituni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
            "verseOrgIds": [
