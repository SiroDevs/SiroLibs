              "1KI.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hene yaho mwami Daudi yavoola, “Langa Bazisheba yirane.” Naye yaza nasingira imbiri weve. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.28",
            "verseOrgIds": [
              "1KI.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku yamuvolera, “Ngusuuvirizaa ligali ku Yahova oveeye mwoyo, wambonyia kutura muvudinyu vwange vwosi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.29",
            "verseOrgIds": [
              "1KI.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndi lidiku liakalunu ndatwekiza lisuuviriza lia ndakwisuuhira mu lieta lia Yahova, Nyasaye wa Isiraeli ndi, muyaayi woovo Solomoni alavugula ovogono vwange kuli mwami.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.30",
            "verseOrgIds": [
              "1KI.1.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.30",
            "verseOrgIds": [
              "1KI.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazisheba yinama hasi navoora, “Mwami wange ahindiri!”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.31",
            "verseOrgIds": [
              "1KI.1.31"
            ]
          }
        }
