          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami ukavugiliyi vindu yivi viosi viekoleke, kandi nuuvula kovoolera avanene vovo nivwaha uvugura vwiyangu vuvwo kuli mwami naho?”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.27",
            "verseOrgIds": [
              "1KI.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
