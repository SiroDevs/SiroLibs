            "style": "v",
            "sid": "ZEC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musangare, musangare, avandu va Ziyoni!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
