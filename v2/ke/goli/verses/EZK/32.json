        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mesheki na Tubali vaveeyeyo kandi, virindwa viavo viakumberizwa ni virindwa via vasikari vaavo, vosi si vaveeye avasuuvirifu mba, kandi viitirwa mu vulwani. Valeta litihiza mu kivala cha vandu vaveeye mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.26",
            "verseOrgIds": [
              "EZK.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si vaayavirwa nu luyali kuli avasaza vakale vi zinguru vu vulwani mba, avaazia mu kivala cha vakuzu niviyavali viugi viu vulwani. Yivavi viavo viavikwa isi wi mitwi jaavo, kandi zinguva ziavo ziakinga miviri jaavo. Avasaza avaluviriri yava vaali ni zinguru zinyingi ligali ziaduukanaa kutihiza vandu mu kivala cha avaveeye mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.27",
            "verseOrgIds": [
              "EZK.32.27"
            ]
          }
        }
      ]
    },
    {
