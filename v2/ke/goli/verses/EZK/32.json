              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nindio avandu va Egebeti valakaduvulanywe hagati ha vandu vataveeye avasuuvirifu, aviitirwa mu vulwani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
