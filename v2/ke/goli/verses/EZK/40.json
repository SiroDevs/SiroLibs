          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirivwa yiki chaali ni vika saba iviazizaa kucho, kandi keng'oze chacho chaali chu kumaliriza chahenzana nu mugizi. Madigi gu mugati gaali ni misaala ja makindu ijavazwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.26",
            "verseOrgIds": [
              "EZK.40.26"
            ]
          }
        },
