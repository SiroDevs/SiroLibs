          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu uyu yambolera ndi, keng'oze keveeye kolovega lwi Isavaalu ni cha vasaalisi avatumikaa mu Litembeli, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.45",
