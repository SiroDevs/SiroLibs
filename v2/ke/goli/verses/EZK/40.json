          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirivwa yiki chaali na madirisha mu ving'oze viacho kuli virivwa vie ving'oze vindi. Uvutambi vwosi vwi kirivwa yiki vwali zimita makomi gaviri na zitano, kandi uvuvambalaru vwacho vwali zimita likomi na ziviri ninusu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.25",
            "verseOrgIds": [
              "EZK.40.25"
            ]
          }
        },
        {
