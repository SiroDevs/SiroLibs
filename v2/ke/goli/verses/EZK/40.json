          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zinzari zimilimita 75 uvutambi ziavofwa kuzindulu zie zimesa yizi. Zinyama ziosi zievihaanwa ziavikwa komesa yiyi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.43",
            "verseOrgIds": [
              "EZK.40.43"
            ]
          }
        }
