          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukeng'oze chi chova, havwingiliru vwi kirivwa chi ivaale, zialiho zimesa ziviri, kandi kolovega lundi lwi keng'oze chi kirivwa, zialiho zimesa ziviri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.40",
            "verseOrgIds": [
