          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Vuli mundu gamuduukira atumikiri ligera lia giligali:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
