          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ligondi lilala lilahaanwa kutura ku vuli chayo cha magondi 200, munyumba ya Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.15",
            "verseOrgIds": [
              "EZK.45.15"
            ]
          }
        }
