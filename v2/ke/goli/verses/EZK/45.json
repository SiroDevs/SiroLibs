          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ligera lienyu lilava kuli ndi, zigera 20 lilava Shekeli 1, zichekeli 60 zilava mina 1",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
