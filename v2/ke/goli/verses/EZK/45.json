          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Efa na bazi vilava vie ligera lilala. Ihama indala ilava zibazi 10 ihama ilava kegero.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        }
