  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ROM 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzi Paolo, mutumikiri wa Kristo Yeso, mutumwa watovolwa kandi walangwa na Nyasaye kwilwaza Ivangeri ya makuva malahi kutura ku Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.1",
            "verseOrgIds": [
              "ROM.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.1",
            "verseOrgIds": [
              "ROM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye yalaga avandu Ivangeri kuvitira mu vaporofeti veve kuli gang'odwa kutura kale mu Mang'oda Matakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.2",
            "verseOrgIds": [
              "ROM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivangeri yiyi eveeye kigira Mwana wa Nyasaye, Mwami wiitu Yeso Kristo, uwaali kisukururwi cha Daudi ku liiva liu muviri; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.3",
            "verseOrgIds": [
              "ROM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku liiva liu vutakatifu vwu vunyasaye vwivwe, Yeso Kristo yalolekizwa ni zinguru zinene kuva Mwana wa Nyasaye kulwo kusimugukizwa kutura mu vakuzu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.4",
            "verseOrgIds": [
              "ROM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvitira muye, Nyasaye yahaana ku kunyi zimbavasi kuva avatumwa kigira Kristo, kuduuki kwimilira nukulanga avandu vi zihiiri ziosi vaduuki kusuuvira nukutia. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.5",
            "verseOrgIds": [
              "ROM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi avaveeye mu Rumi muveeye valala ku vandu yavo, ava Nyasaye amali kulanga muve ava Yeso Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.6",
            "verseOrgIds": [
              "ROM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.6",
            "verseOrgIds": [
              "ROM.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa ng'oderaa munyi vosi avamuveeye mu Rumi, ava Nyasaye yayanza kandi, navalanga vave vatakatifu veve.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimbavasi ni mirembe kutura ku Nyasaye Baba wiitu, kandi ku Mwami Yeso Kristo zive ni munyi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisaala liu kusandiza Nyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndanga kusandiza Nyasaye wange kuvitira mu Yeso Kristo kigira munyi mwosi, avandu vanyingi mu lirova liosi vamali kuhulira amakuva gi lisuuvira lienyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.8",
            "verseOrgIds": [
              "ROM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye wa inzi ndumikiraa numwoyo gwange gwosi mu Iilwaza Ivangeri yu Mwana weve, aveeye mulolekizi wange ku gambolaa kigira gaveeye giligali. Nyasaye amanyi vulahi ndi inzi nzizuliza munyi vuli kazozo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.9",
            "verseOrgIds": [
              "ROM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ing'inga yoosi mu lisaala liange, sala Nyasaye nayanza mu vulaliri vwivwe, yanombere vwiyangu vwu kuuza kumulora. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.10",
            "verseOrgIds": [
              "ROM.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira ngayilwa ligali kolola munyi, nduuki kusanga harara nimunyi mu kihanwa cha roho kunangwa muduuki kuva ni zinguru. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.11",
            "verseOrgIds": [
              "ROM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agambooraa gaveeye ndi, munyi ninzi kulakoonyana ku ing'inga ndala nzere, lisuuvira lienyu, kandi lisuuvira lienyu lilangonya.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.12",
            "verseOrgIds": [
              "ROM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.12",
            "verseOrgIds": [
              "ROM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avaamitu vange, nyenya munyi mumanye ndi, ndalohiza haali kanyingi kuuza kumuluta, navuzwa sindaanyaliza mba. Ndakayanzi konyoora avalondi valahi kigira Kristo hagati hinyu kuli ndanyoora mu vandu vi Zihiiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.13",
            "verseOrgIds": [
              "ROM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeeye ni ligovi ku vandu vosi, Avaguriki vamanya malago ga Nyasaye na vandu vataveeye Vaguriki avakikiri kumanya malago ga Nyasaye, avageri na vataveeye nilimanya. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.14",
            "verseOrgIds": [
              "ROM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulwayago mbeeye nuvuha vonene kwilwaza Ivangeri ku munyi avamenyaa mu Rumi",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.15",
            "verseOrgIds": [
              "ROM.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zinguru zie Ivangeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.15",
            "verseOrgIds": [
              "ROM.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simbeeye soni ni Ivangeri ya Kristo mba, kigira eveeye zinguru zia Nyasaye kohonyia vosi avasuuviraa; Avayuda kutanga, kandi Avizihiiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.16",
            "verseOrgIds": [
              "ROM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira Ivangeri ivuulaa kuli Nyasaye akolaa vandu kuva valungi naye mwene kuvitira mu lisuuvira kutura mu litanga kuduuka mu keheri. Ni kuli Amang'oda Matakatifu gavoora, “Umundu okolwaa mulingi na Nyasaye kuvitira mu lisuuvira, alava mwoyo.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vutima vwa Nyasaye ku vandu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye umali kololekiza vutima vwivwe kutura mwigulu ku vwoni vwosi, nu ku vudamanu vwosi vwa vandu, vi zinzira ziavo zindamanu zigaliraa agiligali gavuli kumanyikana. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.18",
            "verseOrgIds": [
              "ROM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye avaheezaa amageri goosi aganyala kumanyikana kigira gaveeye havulavu kuvo, kigira Nyasaye mwene yaagamanyia havulavu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.19",
            "verseOrgIds": [
              "ROM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kali kutura ing'inga ya Nyasaye yalomba lirova, liiva lilie litalolekaa ni zimoni, liveeye zinguru zizie zie mihiga ni mihiga, kandi liiva liuvunyasaye vwivwe, vumali kololeka vulahi ligali. Avandu vanyara kumanya makuva yaga kuturana ni vindu via Nyasaye yalomba. Ku lwa yago, sivaveeye ni chavativula mu liekinga liavo mba!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.20",
            "verseOrgIds": [
              "ROM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.20",
            "verseOrgIds": [
              "ROM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kali niiva vamanya Nyasaye aveeye ho, navuzwa sivamukuminyaa kuli aveeye Nyasaye, anoho sivamusandizaa mba. Mu vogono vwo kokora ndio, zing'anagani ziavo ziagirung'anywa kuva vuzwa, ni mioyo jaavo juvusiru jayizula kisundi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.21",
            "verseOrgIds": [
              "ROM.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kali niiva vavoola aveene ndi vaveeye vageri, na ng'ani navasiru; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.22",
            "verseOrgIds": [
              "ROM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu vogono vwu kusigamira Nyasaye uhindiraa mihiga ni mihiga, vasigamira nukukuminya vifananyi vialombwa vive mu liiva liu mundu ukuza anoho vifananyi via manyonyi, zinyama anoho zinzoka.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.23",
            "verseOrgIds": [
              "ROM.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
