            "number": "24",
            "style": "v",
            "sid": "LEV 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.24",
            "verseOrgIds": [
              "LEV.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva umundu wa Isiraeli alava mudaka, ma gamunigi kuguliza mulimi gwigwe, mwiko weve wa himbi ligali ave niye ugugula.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.25",
            "verseOrgIds": [
              "LEV.25.25"
            ]
          }
        }
      ]
    },
