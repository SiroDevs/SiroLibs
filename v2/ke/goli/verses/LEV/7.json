          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaga nigo malago gi vihaanwa viu kusambwa, vihaanwa viu vuswage, vihaanwa viu uvwoni, vihaanwa via mahiolo, vihaanwa viu kuvikilwa ku makono ni vihaanwa vie mirembe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
