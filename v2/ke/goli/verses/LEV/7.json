          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yiki nicho kedonye chi chukulia kihanwa ku Yahova chaali chahaanwa ku Haruni harara na vayaayi veve ku lidiku lia vavakwa maguta, vatumikiri Yahova kuli avasaalisi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lidiku lia vavakwa maguta, Yahova yalaga avandu va Isiraeli vahane ku avasaalisi kuli kidieli chavo cha vuli kazozo mu visukululwi viavo viosi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        }
      ]
