          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaga na malago ku musaza uva natura mahira muvusaza vwivwe kigira kisununu anoho uva nalotaa ndi aveeye harara nu mundu mukali, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.32",
            "verseOrgIds": [
              "LEV.15.32"
            ]
          }
        },
        {
