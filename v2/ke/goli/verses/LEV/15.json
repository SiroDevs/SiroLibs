          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavolera Musa yiganihizi avana va Isiraeli ku vudamanu vwavo; kunangwa vavuli kwonogonyia Lihema lilie liukuvuganira mu, liali hagati haavo. Nivakakoli ndio vaali valitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.31",
            "verseOrgIds": [
              "LEV.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
