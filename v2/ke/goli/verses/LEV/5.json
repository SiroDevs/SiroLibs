    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vikolwa Viduukana Kuhaanirwa ku Visiuviliru viu vwoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva mundu woosi alalaangwa ahaane lilolekiza mu kiyaalo navuzwa avuli kovora makuva ku kindu cha amali kolola anoho ahuliyi, alava muhioli na gamuduukira ahevwe mageri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.1",
            "verseOrgIds": [
              "LEV.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.1",
            "verseOrgIds": [
              "LEV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva mundu woosi aladiira ku kindu choosi kitaveeye kilungi vugira kumanya kolondekana nu muruka gwi idini kuli inyama yu muvulimu ikuzi anoho mutugu goveeye mudamanu, anoho vindu vidamanu vimolaa kumalova kali niiva siamanyi chakolaa ugwiyi muhioli lwa manyiriza chamali kokora.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva mundu woosi vugira kumanya adiira ku kindu choosi chu mundu, ekeveeye ikidamanu, kali keveki, aveeye na mahiolo lwa manyiriza cha mali kokora.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva mundu woosi alisuuha vugira kuganagana, kali live liesuuha lia luganoki aveeye na mahiolo lwa manyiriza chamali kokora.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwu mundu woosi anyoleka kuva muhioli, gamuduukira yiyame vwoni vwivwe vwa yakola, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi mutungu kigira uvwoni vwivwe vwa yakola, kuduuka aleete ku Yahova kememe kisuveni chi ligondi anoho imburi kuli kihanwa chu uvwoni. Musaalisi alahaana kisiuviriru zana yicho kwogiza uvwoni vwu mundu oyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva mundu sialanyala konyoora kememe chi ligondi anoho imburi, alaleeta ku Yahova kuli mutungu gwu vwoni vwivwe, makuulu gaviri matugi anoho makuulu gaviri gumuvulimu. Lilala lilava kisiuviriru chu uvwoni nilindi lilava kisiuviriru chu kusambwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alageleeta ku musaalisi, umanya ahaane linyonyi liu kutanga kuva kisiuviriru chu vwoni. Alalivotola ligoti vugira kutuliza ku mutwi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.8",
            "verseOrgIds": [
              "LEV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluuha malala ku masahi galio kundulu kwu uvwali. Alatahiza masahi gatigaye goosi mu lwaalo lwu uvwali. Yiki keveeye kihanwa chu kwogiza uvwoni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.9",
            "verseOrgIds": [
              "LEV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku alahaana linyonyi lia kaviri kuli kihanwa chu kusambwa kolondekana na malago. Munzira yiyi, musaalisi alahaana kisiuviriru chukwogiza vwoni vwu mundu oyo, naye alasaamifwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva mundu sialanyaliza koleta makuulu gaviri matugi anoho makuulu gaviri gu muvulimu alaleeta ikilo ndala yuvusie kuli kihanwa chu uvwoni. Sialazuganyia na maguta ga muzeituni anoho kimuli mba, kigira keveeye kihanwa chu uvwoni. Sikeveeye kihanwa chu vuswage mba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alavoleeta ku musaalisi umanya avuguli luhi lulala kuvwo kuli kihanwa kihaaniywi ku Yahova, na alavusambira ku vwali kuli kihanwa chi viukulia. Yiki keveeye kihanwa chu kutuliza vwoni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaalisi alahaana kisiuviriru chu uvwoni vwu mundu oyo yakola, kandi alasaamifwa. Uvusie vutigaye vwosi vulava vwu musaalisi, kuli gaveeye vuzwa mu ing'inga yu kuhaana vihaanwa viu vuswage.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kihanwa chi Mitungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yahaana malago yaga ku Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.14",
            "verseOrgIds": [
              "LEV.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva mundu woosi alakola uvwoni vugira kumanya ku livula kutunga vindu viveeye vitakatifu ku Yahova, alatungaa kihanwa chi ligondi likore anoho imburi ekore itaveeye nimbara. Vuguli vwayo vulamanyikana kolondekana nu vuguli vwavugilirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuduuka ahaane mitungu jayavula kuleeta ku Yahova kandi ameede kidieli cha sirini ku mia moja chi mitungu yijo. Alakihaana ku musaalisi umanya ahaane kuli kisiuviriru chu uvwoni vwu mundu oyo naye alasaamifwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva mundu woosi alakola uvwoni nukuvunaga lilala ku malago ga Yahova yalaga vugira kusaavira, aveeye nilihiolo, na kuduuka ahaane mutungu gwu kuvunanyia lilago. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gamuduukira aleete ku musaalisi ligondi limigu anoho imburi vugira imbara. Gaduukanaa vuguli vwayo vumanyekane kolondekana na malago gaviikwaho. Musaalisi alamulombera kisiuviriru chukwogiza uvwoni vwivwe vwa yakola natamanyi na alasaamifwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.18",
            "verseOrgIds": [
              "LEV.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yiki keveeye kihanwa chu kutuunga vwoni vwa yakolera Yahova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        }
      ]
    }
