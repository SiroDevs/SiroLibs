          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.36",
            "verseOrgIds": [
              "2SA.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa Hushai, mulina wa Daudi, yirana mu lidaala linene lwa Abisolomu yaali niyakaduka.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.37",
            "verseOrgIds": [
              "2SA.15.37"
            ]
          }
        }
