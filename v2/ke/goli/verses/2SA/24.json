              "type": "text"
            }
          ]
        },
        {
          "text": "Arauna yaaluhaana lwosi ku mwami namuvolera, “Yahova Nyasaye woovo avugiliri kihanwa chicho.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.23",
