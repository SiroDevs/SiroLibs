              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa Daudi yaagula oloze nizing'ombe kandi naatunga vidonye vie ifeza hamusini. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.24",
