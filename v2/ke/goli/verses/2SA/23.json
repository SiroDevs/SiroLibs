          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elifeleti muyaayi wa Ahasibai, kutura maaka, Eliamu muyaayi wa Ahizofeli kutura mu lidaala lia Gilo, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.34",
            "verseOrgIds": [
              "2SA.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezoroni kutura mu lidaala lia Karimeli, Paarai kutura Araba, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.35",
            "verseOrgIds": [
              "2SA.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igali, muyaayi wa Nazani kutura mu lidaala lia Zoba, Bani kutura mu lidaala lia Gadi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.36",
            "verseOrgIds": [
              "2SA.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zeleki kutura mu lidaala lia Amoni, naharai kutura mu lidaala llia Beerozi, mugiingi wi inguuva ya Joabu, muyaayi wa Zeruya, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.37",
            "verseOrgIds": [
              "2SA.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
