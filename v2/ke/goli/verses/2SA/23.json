          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Uria Umuhiti vosi vaali avandu salasini na saba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.39",
