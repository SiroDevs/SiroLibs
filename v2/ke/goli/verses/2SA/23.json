              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi Abialiboni kutura mu lidaala lia Araba Azimavezi kutura Bahurimu, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.31",
            "verseOrgIds": [
              "2SA.23.31"
            ]
          }
        },
        {
