          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shama kutura Harari, Ahiamu muyaayi wa Sharari, kutura Harari. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.33",
            "verseOrgIds": [
              "2SA.23.33"
            ]
          }
        },
