{
  "id": "RUT.1",
  "number": "1",
  "bookId": "RUT",
  "reference": "Ruzi 1",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
