          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira lisuuvira, Yakobo lwa yaali na kuzaa yagasiza avana va Josefu, nakikiri kukuza. Samulala yasigamira Nyasaye niyesedemi ku imbimbu yeeye.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.21",
            "verseOrgIds": [
              "HEB.11.21"
            ]
          }
        }
