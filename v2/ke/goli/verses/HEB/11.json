              "HEB.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvitira mu lisuuvira avakali vavugura aviiko vaavo vakuzu nivasimugukiziwi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.35",
            "verseOrgIds": [
              "HEB.11.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandi vasuuraa kuvugilira vovoholore, vakuzira mu lidambizwa kunangwa vaduuki konyoora lisimugukizwa mu livamwoyo lilahi ligali. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.35",
            "verseOrgIds": [
              "HEB.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "HEB 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avalala vakolerwa kehenyahenye kandi nivakuywa, na vandi vavofa niminyororo kandi nivaviikwa mu vuhambe; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.36",
            "verseOrgIds": [
              "HEB.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "HEB 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "valaswa na magina, vakalwa hagati numusumeno, viitwa nikivaavi. Vavodong'ana ni viviiki zinguvu ziamagondi nizie zimburi. Vaali vadaka kandi nivadambizwa, kandi vakolerwa vudamanu ligali. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.37",
            "verseOrgIds": [
              "HEB.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "HEB 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lirova si liali lilahi kuvo mba! Vavodong'ana kuli viruki mu changalangwi; kandi mu vigulu, nivamenyi mu zimbangaywa, nu mumalina.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.38",
            "verseOrgIds": [
              "HEB.11.38"
            ]
          }
        }
      ]
    },
