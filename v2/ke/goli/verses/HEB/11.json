          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira lisuuvira avandu va Isiraeli vaambuka mu Inyanza Inzakanyu kuli vaali ku marova amuumu. Lwa vandu Vaegebeti vageriza kokora ndio vakuzira mu mazi vosi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.29",
            "verseOrgIds": [
              "HEB.11.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.29",
            "verseOrgIds": [
              "HEB.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira lisuuvira amadigi ga Jeriko gaagwa, inyima wa vandu va Isiraeli vaali nivakalikumberiza ku madiku saba. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.30",
            "verseOrgIds": [
              "HEB.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira lisuuvira Rahabu mukali wa malaya siyiitwa harara nayavo avavura kuhulira, kigira yingiriza avaluuti nimirembe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.31",
            "verseOrgIds": [
              "HEB.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
