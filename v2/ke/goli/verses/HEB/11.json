        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "HEB 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yava vosi vayanziza Nyasaye kigira lisuuvira liavo, navuzwa vaakuza nivakikiri konyoora cha Nyasaye yavasuuviriza, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.39",
            "verseOrgIds": [
              "HEB.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "HEB 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kigira Nyasaye yavikira kunyi kindu keveeye kilahi ligali lienya lilie liali ndi kove harara naye kunangwa kuduuki kokolwa vaduukiru.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.40",
            "verseOrgIds": [
              "HEB.11.40"
            ]
          }
        }
