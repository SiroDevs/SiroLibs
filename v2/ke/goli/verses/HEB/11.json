          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.22",
            "verseOrgIds": [
              "HEB.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira lisuuvira lwa Musa yiivulwa, aviivuli veve vamuvisa ku mieli jivaga kigira valora aveeye Mwana mulahi; sivaatia kuvunaga malago gu Mwami wa Egebeti mba.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.23",
            "verseOrgIds": [
              "HEB.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.23",
            "verseOrgIds": [
              "HEB.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira lisuuvira, Musa yaviruka nava Mundu uduuki, yasura kulangwa Mwana wu mukaana wu mwami. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.24",
            "verseOrgIds": [
              "HEB.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yatovola kusanga mulikubizwa kivi lia vandu va Nyasaye, kuvita kuyanzilira vwoni ku ing'inga ngekeeke. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.25",
            "verseOrgIds": [
              "HEB.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yatovola linyegwa kigira Kristo kuva lilahi ligali kuvita vutugi vwa Egebeti; kigira yahenzerera madanyi gaaza imbiri.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.26",
            "verseOrgIds": [
              "HEB.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.26",
            "verseOrgIds": [
              "HEB.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira lisuuvira Musa yatura Egebeti vugira kutia vutima vwu mwami; siyirana inyima kigira yaali vuzwa mundu olola Nyasaye utalolekaa mba. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.27",
            "verseOrgIds": [
              "HEB.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira lisuuvira yatangiza lipasaka, nalaga amasahi guufwi ku viliango kunangwa Engelosi wi Likuza avuli kwita avayaayi viivulwa kutanga mu vandu va Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.28",
            "verseOrgIds": [
              "HEB.11.28"
            ]
          }
        }
      ]
    },
    {
