          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira lisuuvira Isaka yagasiza Yakobo na Esau, kali mu vindu viliza.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.20",
            "verseOrgIds": [
              "HEB.11.20"
            ]
          }
        }
