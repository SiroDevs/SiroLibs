        },
        {
          "text": "Kigira lisuuvira, lwi likuza lia Josefu liali ahimbi, yatala amakuva gi litula lia avana va Isiraeli mu Egebeti, kandi navaha amalago ku liyavirwa liu muviri gwigwe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.22",
            "verseOrgIds": [
              "HEB.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 11:22"
          },
          "items": [
            {
              "text": "22",
