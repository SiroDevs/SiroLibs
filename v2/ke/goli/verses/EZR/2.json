              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Livaliza lia vandu vosi aviranaa kutura mu kivala chu vuhambe vaali 42,360 ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.64",
            "verseOrgIds": [
              "EZR.2.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "EZR 2:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "komeeda kuveene yava, vaaliho kandi na vatumikiri vasaza kandi avakali 7,337; harara na vimbi vizinyimbu avasaza kandi avakali 200. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.65",
            "verseOrgIds": [
              "EZR.2.65"
            ]
          }
        },
