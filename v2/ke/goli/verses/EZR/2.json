          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Visukululwi yivi vienyeleriza mu vitabu viduuki konyoora amita ga vaguuga vaavo, navuzwa si vaali vanyara konyoora mba. Kunangwa, valekwa kutura mu vusaalisi kigira vaali avadamanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.62",
            "verseOrgIds": [
              "EZR.2.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "EZR 2:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwamihi wa Vayuda yavavolera ndi sivanyala kulia viukulia vihaanwa ku Nyasaye mba, kuduuka lwu musaalisi alivaho ulitumikira Urimu kandi Zumimu kuva kuli kelolekizu kumanyia niiva Nyasaye alavugilira uvutumwa vwa vasaalisi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.63",
            "verseOrgIds": [
              "EZR.2.63"
            ]
          }
        }
      ]
