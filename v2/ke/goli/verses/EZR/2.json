            "number": "66",
            "style": "v",
            "sid": "EZR 2:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaali ni zibarasi 736, kandi zisukiri 245, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.66",
            "verseOrgIds": [
              "EZR.2.66"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
            "style": "v",
            "sid": "EZR 2:67"
          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "vaali kandi ni zing'amia 435, kandi zibunda 6,720.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.67",
            "verseOrgIds": [
              "EZR.2.67"
            ]
          }
        }
