              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yava nivo avandu vi kivala avaatura mu lihaminywa, avu Mwami Nebukadineza yaali naahiri Babiloni mu kivala chi lihaminywa. Viirana Jerusalemi kandi Ivuyuda vuli mundu yazia mu kadaala keke. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.1",
            "verseOrgIds": [
              "EZR.2.1"
            ]
          }
        },
        {
