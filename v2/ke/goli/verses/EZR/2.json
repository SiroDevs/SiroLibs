              "text": "68",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa vandu vu muvuhambe vaduuka mu Litembeli lia Yahova mu Jerusalemi, aviimiliri valala vizihiiri vahaana vihaanwa viokokonya kwumbaka Litembeli uvuhia mu vogono vwalio vwakale. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.68",
            "verseOrgIds": [
              "EZR.2.68"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "69",
            "style": "v",
            "sid": "EZR 2:69"
          },
          "items": [
            {
              "text": "69",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vahaana kolondekana nuvuuyingi vwa mavikiru gaavo kokonyana ku miyinzi yiji. Liehaana liavo liali kuli ndi: Zikilo 500 ziezahabu, zikilo 2,800 zie ifeza kandi ziganza zia vasaalisi 100.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.69",
            "verseOrgIds": [
              "EZR.2.69"
            ]
          }
        }
