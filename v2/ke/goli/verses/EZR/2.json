            "style": "v",
            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aviimiliri vaavo vaali harara na: Zerubabeli, Joshua, Nehemia, Seraya, Reelaya, Modekai, Bilishani, Misipa, Bigivai, Rehumu na Baana.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.2",
            "verseOrgIds": [
              "EZR.2.2"
            ]
