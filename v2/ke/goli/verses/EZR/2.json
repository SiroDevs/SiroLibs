          "items": [
            {
              "text": "70",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avasaalisi, avandu va Levi, harara na vandu vandi vamenya mu Jerusalemi anoho ahimbi Jerusalemi. Avimbi vizinyimbu, avalindi vikirivwa chi Litembeli, avatumwa vi Litembeli, vamenya mu madaala gaali ahimbi. Avandu vandi vosi va Isiraeli vamenya mu madaala ga vaguuga vaavo vamenyamu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.70",
            "verseOrgIds": [
              "EZR.2.70"
            ]
          }
        }
