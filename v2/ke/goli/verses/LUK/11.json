          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "“O, vayaye kilaamo keveeye ku munyi avigizi vi Lilaga! Kigira muvuguyi nukuvisa ulufungu lwu muliango gwi inyumba yo vogeri vwi limanya. Navuzwa munyi aveene simwingiraa mu mba, kandi mwigalira avaari nivingira vavuli kwingira.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.52",
            "verseOrgIds": [
              "LUK.11.52"
            ]
          }
        }
      ]
