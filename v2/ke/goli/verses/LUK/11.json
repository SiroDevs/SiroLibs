          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yeso yaali naatuliho, Avigizi vi Lilaga kandi Avafarisayo vatanga kumugeriza nukumuteeveleriza mateeva kigira vindu vinyingi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.53",
            "verseOrgIds": [
              "LUK.11.53"
            ]
          }
