          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalunu kunyi kumanyi ndi ivi umanya vindu viosi kandi avula ho okoteeva amateeva. Kulwayago, kusuuviranga ndi waatura ku Nyasaye.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.30",
            "verseOrgIds": [
