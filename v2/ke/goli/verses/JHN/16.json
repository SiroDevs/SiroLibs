            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso yavativulira, “Musuuviyi kalunu? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
