              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa, aviigi veve vamuvolera, “Ah, kalunu ovola havulavu ligali vugira kutumikira zing'ano. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.29",
            "verseOrgIds": [
