            "number": "32",
            "style": "v",
            "sid": "JHN 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ing'inga yiza, kandi imali kuduuka, lwa munyi mwosi mulisalanywa sa mulala yengo weve, nainzi ndakatigale nzieng'ine. Navuzwa inzi simbeeye nzieng'ine mba, kigira Baba aveeye harara ninzi ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.32",
            "verseOrgIds": [
