{
  "id": "2CH.1",
  "number": "1",
  "bookId": "2CH",
  "reference": "2 Zing'Inga 1",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
