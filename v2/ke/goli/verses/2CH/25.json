        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoashi yagumira Amazia ma na muhiraa mu Jerusalemi. Hene yaho yaduya lidigi lie lidaala linene nilivunguguka kutura ku kirivwa cha Efuraimu kuduuka ku kirivwa cha Kona, ahimbi uvutambi vwi zimita 200. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yavugula vilaanye viosi vie zahabu, ifeza, harara ni viju viosi viali mu Litembeli lia Nyasaye viali mu vulindi vwa Obedi Edomu, kandi amaviikiru gi inyumba yu mwami, harara na vahambe ma niyirana navio mu Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
    },
