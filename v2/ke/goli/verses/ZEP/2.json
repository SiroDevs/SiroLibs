            "number": "1",
            "style": "v",
            "sid": "ZEP 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi avandu vi zihiiri zitaveeye ni zisoni, mwivungikizi harara ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.1",
            "verseOrgIds": [
              "ZEP.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni mukikiri kukungwa kuli mukuzi guhuuzwa ni imbuza, imbiri wu vutima vululu vwa Yahova vukikiri kuduuka ku munyi, imbiri wi lidiku lwa Yahova akikiri kumanyia uvutima vwivwe vululu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwilane ku Yahova, munyi avandu vosi vegehiza mu kivala, avatizaa malago geege. Mukore agaveeye amalungi kandi mwegehizi aveene imbiri wa Yahova. Hawundi mulahononoka kutura ku linyola mageri lidiku lia Yahova amanyia vutima vwivwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lidivizwa lie Zihiiri Zikumberizaa Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEP 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avulaho mundu kali mulala ulitigara mu lidaala lia Gaza. Lidaala lia Ashikeloni lilakatigale hazwa. Avandu vi lidaala lia Ashidodi valakakungwi mu ing'inga yi inusu yi lidiku, kandi avandu vi lidaala lia Ekironi valakakungwi mu lidaala liavo linene. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.4",
            "verseOrgIds": [
              "ZEP.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEP 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi avandu va Filisitia mwadiva! Munyi avandu vamumenyi ahimbi ni inyanza. Yahova umali ku mukalagiraa. Alakamudivizi kandi avulaho mundu kali mulala ku munyi ulitigara. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kivala chiinyu ekeveeye ahimbi ni inyanza kilakagwi viguuti viveeye mu na madiri ga vayi kandi zingala zia magondi gaya mucho. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.6",
            "verseOrgIds": [
              "ZEP.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vi Ivuyuda avalihononoka valakavuguli kivala chiinyu. Valakaye mu viayo viavo uwene yeyo kandi valakagone mu zinyumba zia vandu va Ashikeloni. Yahova Nyasaye wavo alakave harara navo kandi alakavilanyiri miandu jaavo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova Wuvunyali avoora, “Inzi mali kuhulira vandu vi kivala cha Moabu na Amoni, vagemehiza kandi vaageriza kokora vandu vange kuva vu vutima, kandi vigingira ndi vanyara kuvugura kivala chavo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.8",
            "verseOrgIds": [
              "ZEP.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEP 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuli Inzi mbeeye ligali Yahova omenya, Nyasaye wa vandu va Isiraeli ndaga ndi, kivala cha Moabu kandi Amoni vizizaa kudivizwa kuli kivala cha Sodoma na Gomora. Na vigwi havundu ha marina gi jumbi kandi mang'anye mihiga ni mihiga; indiva ilakizuli mucho. Valala ku vandu vange avalihononoka valakavingiliri nu kuvugura kivala chavo.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.9",
            "verseOrgIds": [
              "ZEP.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEP 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.9",
            "verseOrgIds": [
              "ZEP.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEP 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindio avandu vi kivala cha Moabu na Amoni valakanyore amageri kigira lielola kandi kilage harara ni ligemihiza lia vakolera vandu va Yahova Wuvunyali. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.10",
            "verseOrgIds": [
              "ZEP.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEP 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova alakavatiihizi. Alakalombe avanyasaye vaavo vi kivala kuva kindu vuzwa, maku zihiiri ziosi zilakamusigamiri muvivala viavo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.11",
            "verseOrgIds": [
              "ZEP.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEP 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.11",
            "verseOrgIds": [
              "ZEP.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEP 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova alakiti avandu va Ezopia ni kivavi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.12",
            "verseOrgIds": [
              "ZEP.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
