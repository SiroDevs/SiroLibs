            "number": "12",
            "style": "v",
            "sid": "ZEP 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.12",
            "verseOrgIds": [
              "ZEP.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEP 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova alakanyiiri mukono gwigwe kolovega lwi Ivaale nu kudiviza Asiria. Alakakole lidaala lia Nineve kuva mang'anye kandi changalangwe vugira mazi, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.13",
            "verseOrgIds": [
              "ZEP.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEP 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "halakave havundu hi viayo, hi zing'ombe kandi zinyama zing'ano ziosi zilakagone. Amakuure galakamenye mu mang'anye gacho kandi galakakubi liyoga lie zinguru kuvitira mu madirisha. Majikoro galakaliri vululu ku vika vie miliango. Misaala jaavo ji midaragwa javumbakila jilakatulizwi ho. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.14",
            "verseOrgIds": [
              "ZEP.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEP 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaga nigo galiekoleka ku lidaala liu kwigingira kigira zinguru zialio, niliganagana ndi liveeye mu mirembe. Avandu vi lidaala yili vagagana ndi lidaala liavo liveeye linene ligali mu kivala. Lidaala yili lilakave havundu haveeye vuzwa, havundu hi zinyama ziu muvulimu zilakasosere! Vuli mundu woosi ulivitira ahimbi nalio alakegose nuvuti.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.15",
            "verseOrgIds": [
              "ZEP.2.15"
            ]
          }
        }
      ]
