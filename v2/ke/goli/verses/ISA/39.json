        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami Hezekia yavolera Muporofeti Isaya ndi, “Likuva lia Yahova amali kovora liveeye lilahi!” Kunangwa, mwami Hezekia yamanya ndi, mirembe kandi likingwa vilavaho ing'inga ya akikiri mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
    }
