          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulaniala kuli musaala, kuli mulimi gwu mundu atasamaa na mazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.30",
            "verseOrgIds": [
              "ISA.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
