          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulava novovereri ndi mwasigamira misaala nukutaga misaala mu milimi mitakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.29",
            "verseOrgIds": [
              "ISA.1.29"
            ]
          }
        },
        {
          "name": "verse",
