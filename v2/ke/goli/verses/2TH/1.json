        "style": "s1"
      },
      "items": [
        {
          "text": "Lisandiza ni Lisaala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
