              "DEU.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mulindi lidiku lie Lisabato no kulikola live litakatifu. Kuli Inzi Yahova Nyasaye winyu mali kumulaga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oveeye namadiku sita aga okolera mu miyinzi jijo josi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.13",
            "verseOrgIds": [
              "DEU.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa lidiku lia saba liveeye lidiku lie lisosa, iliaviikwa ku halovega kigira Inzi Yahova Nyasaye winyu. Ku lidiku yilio, mutakoli muyinzi kali mulala mba; munyi vene, anoho vana vinyu vayaayi anoho vakana, avatugwa vinyu, zinyama zienyu zia mwatuga, anoho avageni vamenya mu kivala chiinyu. Avatugwa vinyu kuduuka navo vave nilisoosa kuli munyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwizurizi ndi mwaali vatugwa mu Egebeti, ma kandi, Inzi, Yahova Nyasaye winyu, ndaamuhonyia kutura yo ni zinguru ziange zinene. Yiki nicho kigira nimugulaga mulindi lidiku lie Lisabato.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        }
      ]
    },
