        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.31",
            "verseOrgIds": [
              "DEU.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Avandu va Isiraeli, mugelihi mulindi mukore goosi aga Yahova Nyasaye winyu amali kumulaga. Mutavula kuhulira lilago liosi ku malago geege mba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.32",
            "verseOrgIds": [
              "DEU.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugalonde goosi kunangwa vindu viosi viduuki kuva vulahi ku munyi kandi kunangwa muzizagiliri komenya madiku manyingi mu kivala cha muzizaa kuvugura.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.33",
            "verseOrgIds": [
              "DEU.5.33"
            ]
          }
        }
      ]
    }
