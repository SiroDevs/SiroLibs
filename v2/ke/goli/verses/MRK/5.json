{
  "id": "MRK.5",
  "number": "5",
  "bookId": "MRK",
  "reference": "Mariko 5",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "MRK 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeso yahonyia mundu waali na mademoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso harara na aviigi veve vaduuka lwangereka lundi lwinyanza ya Galilaya mu kivala cha Gerasa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.1",
            "verseOrgIds": [
              "MRK.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yeso yika kutura mu liato, yavugana nu mundu waatura mu vilindwa uwaali ni lidemoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.2",
            "verseOrgIds": [
              "MRK.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umundu oyo yaali ni yamenya mu vilindwa. Sihaali ho nu mundu ku vosi uwaali anyala kumuvoha kali ni minyororo mba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.3",
            "verseOrgIds": [
              "MRK.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaali ni yavofwa haali kanyingi ni vivia kandi minyororo, navuzwa yagadula iminyororo kandi akalanyia ivivia zana. Umundu si yaali ho ni zinguru ziu kumukiring'anyia mba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.4",
            "verseOrgIds": [
              "MRK.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zing'inga ziosi, uvudiku nu mbasu, yaali mu vilindwa nu mu vigulu, nahanzuka nu kwiduya na magina.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.5",
            "verseOrgIds": [
              "MRK.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.5",
            "verseOrgIds": [
              "MRK.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulwa yalora Yeso nakikiri ihale, yanyagura nazia kusigama imbiri weve, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.6",
            "verseOrgIds": [
              "MRK.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nahanzuka nu mwoyo munene navoora, “Onyenyaa ki ivi Yeso Mwana wa Nyasaye, oveeye igulu Ligali? Ngogonya, imbiri wa Nyasaye, utandambiza mba!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.7",
            "verseOrgIds": [
              "MRK.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.7",
            "verseOrgIds": [
              "MRK.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yavoola ndio kigira Yeso yaali namuvooleye, “Ivi lidemoni, tula mu mundu uyu!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.8",
            "verseOrgIds": [
              "MRK.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.8",
            "verseOrgIds": [
              "MRK.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso yamuteeva, “Ilieta liilio nivwaha?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.9",
            "verseOrgIds": [
              "MRK.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye yamutivulira, “Ilieta liange ni Legiona",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.9",
            "verseOrgIds": [
              "MRK.5.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:9",
              "type": "text"
            },
            {
              "text": "Legiona:",
              "type": "text"
            },
            {
              "text": "Liveeye kovora “Vanyingi”.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", kigira koveeye avanyingi!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.9",
            "verseOrgIds": [
              "MRK.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaazizagilira kogoonya Yeso avuli kukunga amademoni kutura mu kivala yicho mba.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.10",
            "verseOrgIds": [
              "MRK.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.10",
            "verseOrgIds": [
              "MRK.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaali ho ichayo chi zinguruvi ichaali nichayaa ha kiguru. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.11",
            "verseOrgIds": [
              "MRK.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amademoni yago gagoonya Yeso ni, gavoora “Ukutumi kuzie mu zinguruvi, kwingiri muzio.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.12",
            "verseOrgIds": [
              "MRK.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye yaavugilira. Maku mademoni yago gaturaa vwangu ni gikuba muzio. Ichayo choosi ikiduuka izielefu ziviri chasulunguta zimbiru ni zigwa munyanza, nizikuzira mu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.13",
            "verseOrgIds": [
              "MRK.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.13",
            "verseOrgIds": [
              "MRK.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yavo avaari avayi vi zinguruvi yizio viiruka nuvuti nivavoora amakuva yago mu lidaala nu mu kivala. Vandu vaatura ni vazia kolola agaali ni gekoleki.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.14",
            "verseOrgIds": [
              "MRK.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.14",
            "verseOrgIds": [
              "MRK.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa vazia ku Yeso, valora umundu waali na mademoni niyikaye makiriri, kandi niyiviiki zinguvu, vaali nu vuti. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.15",
            "verseOrgIds": [
              "MRK.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vaali nivaloli agaali ni gekoleki, vavoolera avandi amakuva gaali negekoleki ku mundu wa mademoni gaali nigaagumira, kandi agaakoleka ku zinguruvi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.16",
            "verseOrgIds": [
              "MRK.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.16",
            "verseOrgIds": [
              "MRK.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku vataanga kogoonya Yeso atuli mu kivala chavo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.17",
            "verseOrgIds": [
              "MRK.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.17",
            "verseOrgIds": [
              "MRK.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yeso yaali ni yingiraa mu liato, umundu wa mademoni gaali nigaagumira yamugoonya, “Leka nzie harara na ivi!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.18",
            "verseOrgIds": [
              "MRK.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.18",
            "verseOrgIds": [
              "MRK.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Yeso yamugaya, namuvolera, “Zia yengo woovo ku avandu vovo, uvavoolere ivindu vinene viu Mwami akokoleeye, kandi kuli amali kukovelerera.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.19",
            "verseOrgIds": [
              "MRK.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.19",
            "verseOrgIds": [
              "MRK.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa umundu oyo yatura nazia kuvitira mu Dekapolisi, navoora ivindu via Yeso yaali naamukoleye. Avandu vosi avahulira vagenya ligali.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.20",
            "verseOrgIds": [
              "MRK.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mukaana wa Yairo nu umukali wadira kunguvu ya Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.20",
            "verseOrgIds": [
              "MRK.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yeso yaali namali kwambuka kandi ni liato ku lwangereka lundi lwinyanza, ikiduma ekenene chavunga imbiri weve; naye yaali nasingiyi ahimbi ninyanza. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.21",
            "verseOrgIds": [
              "MRK.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaza mulala ku aviimiliri vi lisinagogi, ilieta lilie yalangwa Yairo. Lwa yalora Yeso, yagwa havirenge vivie ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.22",
            "verseOrgIds": [
              "MRK.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "namugoonya ligali, navoora, “Mukaana wange mukekeeke aveeye ahimbi kukuza. Mwaza ngogonya, nuyanza hamba uviiki kuye amakono googo, ahone, ave mwoyo!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.23",
            "verseOrgIds": [
              "MRK.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.23",
            "verseOrgIds": [
              "MRK.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso yazia harara naye. Ni kiduma cha avandu avanyingi ligali vamulonda, ni vamumiina kutura izimbega ziosi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.24",
            "verseOrgIds": [
              "MRK.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.24",
            "verseOrgIds": [
              "MRK.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaali ho mukali mulala umulwaye uwataaza amasahi ku lwi mihiga likomi na giviri, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.25",
            "verseOrgIds": [
              "MRK.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kali niiva yaali niyaazia ku avaahi vi zinyasi avanyingi, siyaahona mba. Yaali niyaatumikira mabese manyingi, navuzwa yaazizagilira kulwala kuvita lwambiri. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.26",
            "verseOrgIds": [
              "MRK.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa yahulira amakuva ga Yeso, yaza nang'unya mu kiduma inyima weve, nadiira kunguvu yeeye, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.27",
            "verseOrgIds": [
              "MRK.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyevolera umwene, “Nindiira kunguvu yeeye vuzwa, ndahona.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.28",
            "verseOrgIds": [
              "MRK.5.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.28",
            "verseOrgIds": [
              "MRK.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukali uyu yadira kunguvu ya Yeso, ahene yaho ilitaaza lia masahi geege liakalizira; kandi yahulira naahoni mu muviri gwigwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.29",
            "verseOrgIds": [
              "MRK.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahene yaho Yeso yamanya ndi izingulu ziituli kuye, yagirung'ana mu kiduma nateeva, “Nivwaha udiiyi kunguvu yange?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.30",
            "verseOrgIds": [
              "MRK.5.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.30",
            "verseOrgIds": [
              "MRK.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aviigi veve vaamutivulira, “Olola kuli ikiduma kiminanaa, na ivi oteeva, ‘Nivwaha undiiyi?’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.31",
            "verseOrgIds": [
              "MRK.5.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.31",
            "verseOrgIds": [
              "MRK.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Yeso yaazizagilira kohenza izimbega ziosi alore umundu okoli ndio. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.32",
            "verseOrgIds": [
              "MRK.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa umukali oyo kigira yamanya ichaali nikekoleki kuye, yagwa hasi imbiri wa Yeso novodegeri, namuvolera agiligali goosi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.33",
            "verseOrgIds": [
              "MRK.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso yamuvolera, “Mukaana wange, lisuuvira liilio likohonyi. Zia ni mirembe na ohone ligali.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.34",
            "verseOrgIds": [
              "MRK.5.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.34",
            "verseOrgIds": [
              "MRK.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa Yeso yaali nakevoola ndio, avandu valala vaza kutura munyumba ya Yairo, ni vamuvolera, “Mukaana woovo umali kukuza. Leka Umwigizi ave!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.35",
            "verseOrgIds": [
              "MRK.5.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.35",
            "verseOrgIds": [
              "MRK.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso siyavugula ikindu mu gavavoola mba, navuzwa yavolera munene wi lisinagogi, “Utatia mba, suuvira vuzwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.36",
            "verseOrgIds": [
              "MRK.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siyavugilira umundu woosi kumulonda mba natali Petero Yakobo na Yohana amwavo weve venyine.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.37",
            "verseOrgIds": [
              "MRK.5.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.37",
            "verseOrgIds": [
              "MRK.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa vaduuka hango hu munene wi lisinagogi, Yeso yahulira iliyoga, ililira ni lisioma ilinyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.38",
            "verseOrgIds": [
              "MRK.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yingira munyumba, navavoolera, “Kigira ki mukubaa zikwiri ni musiomaa? Mukaana uyu siakuzi mba, agonaa.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.39",
            "verseOrgIds": [
              "MRK.5.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.39",
            "verseOrgIds": [
              "MRK.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatanga limuhenyahenya. Yavavolera vatuli ichova vosi, ma navugura baba na mama wu mukaana oyo harara na aviigi veve, ni vingira ahu mwana yaali naagoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.40",
            "verseOrgIds": [
              "MRK.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yagumira umwana mukono namuvolera, “Talitakumi,” iliveeye kovora, “Mwana mukaana, ngovolera uvuki!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.41",
            "verseOrgIds": [
              "MRK.5.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.41",
            "verseOrgIds": [
              "MRK.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahene yaho umukana oyo yavuka nagenda. Yaali naveeye ni mihiga likomi na giviri. Lwayaga geekoleka, avandu vagenya ligali kuvita kegero.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.42",
            "verseOrgIds": [
              "MRK.5.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.42",
            "verseOrgIds": [
              "MRK.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa Yeso yaviganihiza ligali vatalandiza amakuva yaga ku mundu kali mulala mba. Yavavolera vahe mukaana oyo ichukulia.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.43",
            "verseOrgIds": [
              "MRK.5.43"
            ]
          }
        }
      ]
    }
