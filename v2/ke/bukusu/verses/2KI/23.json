              "2KI.23.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.3"
              },
              "items": [
                {
                  "text": "2 Bab. 21.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.3"
              },
              "items": [
                {
                  "text": "2 Ke Ch. 33.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yosia alaka Omusaayi Omukhulu Lukali Hilikia ne basaayi bayeeti bewe, ne baliindi baali khu mulimo e silibwa sie Lukaangu khurusia mu Lukaangu lwa Wele Omunyali Owa Bioosi, bibiindu bioosi bibiarumikhanga mu khusaaya Baali, Ashera, ne ching'enieesi. Omwami osiela bibiindu ebio bioosi enje we lukoba mwitooma lia Kiduroni. Asuta likokhe liabio aliyila e Beteli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arusiao basaayi nibo babaami ba Yuda barakho kamakhono. Barebwakho kamakhono khukhwosia bibiindu biiunya kumuuya kumulayi abuundu aesuta mungoba cha Yuda ne abuundu ali siimbi ne Yerusalemu. Abo babosielanga Baali, ne enyanga, kumwesi, sulwe ne ching'enieesi bibiindu biiunya kumuuya kumulayi, boosi arusiao. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.5",
            "verseOrgIds": [
              "2KI.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arusia mu Lukaangu sifwaani sia Ashera. Ayila sifwaani esio mwitooma lie luluuchi lwa Kiduroni. Asiosia mala abukula likokhe liasio alisalanisia abuundu niio basiikhanga babaandu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atechula chinju che balaaya be siseecha be mu lukaangu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23.7",
              "type": "text"
            },
            {
              "text": "balaaya be siseecha be mu lukaangu:",
              "type": "text"
            },
            {
              "text": "babaandu be siseecha ne siikhasi ba bakholelanga bueeyani mu lukaangu lwabwe mu khusaaya wele babwe be ngakha (namwe lisaaye).",
              "type": "text"
            }
          ]
        },
        {
          "text": ", chichaba munju eya Wele Omunyali Owa Bioosi. Abwenao niio bakhasi basonelanga chikutuusi chicharumikhanga mu khusikamila Ashera. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Areera mu Yerusalemu basaayi be bifwaani boosi ba baaba mu ngoba cha Yuda, ne mu sibala sioosi. Onakaka abuundu aesuta oosi niio boseelanga bibiindu biiunya kumuuya kumulayi khukhwama Keba khukhwola Beerisheba. Akhaba lundi atechula abuundu aesuta a aaba mu silibwa sia Yoshua omuruki we lukoba. Silibwa esio siaba kumukhono kumukhasi kwe silibwa siboofu sie khukhwingila mu lukoba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.8",
            "verseOrgIds": [
              "2KI.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakhaba kario basaayi be abuundu aesuta se bacha khu alutare eya Wele Omunyali Owa Bioosi e Yerusalemu tawe. Ne kakhali balia kumukaati kukhalimo limela tawe khukhwama khu basaayi basiaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        }
      ]
    },
