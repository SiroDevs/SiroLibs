              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono bikholwa bibiindi bioosi bia Pekahia, ne koosi niko akhola biaandikwa mu sitabu sie chingano che Babaami ba Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.26",
