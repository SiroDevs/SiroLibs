          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwiiko kukhola kamakhumi kabili kwe bubwami bwa Yotamu okhwa Asaria nga omwami owa Yuda, Hoshea okhwa Ela akholela omwami Peka ekwangwaani amwiira mala abukula bubweyaangu bwewe aba omwami. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.30",
            "verseOrgIds": [
              "2KI.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikholwa bibiindi bioosi bia Peka, ne koosi niko akhola biaandikwa mu sitabu sie chingano che babaami ba Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.31",
            "verseOrgIds": [
              "2KI.15.31"
            ]
          }
        }
      ]
    },
