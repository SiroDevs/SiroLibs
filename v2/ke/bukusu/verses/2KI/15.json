              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono bikholwa bibiindi bioosi bia Yotamu ne koosi niko akhola biaandikwa mu sitabu sie chingano che babaami ba Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.36",
            "verseOrgIds": [
              "2KI.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ndaalo echo Wele Omunyali Owa Bioosi arakikha khuruma omwami Resini owa Shamu no mwami Peka owa Isiraeli khukhwibwaakala Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotamu afwa mala asiikhwa mu biliindwa bie bubwami mu Lukoba lwa Daudi. Ne omusoleeli wewe Ahasi aba omwami mu bweyaangu bwewe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.38",
