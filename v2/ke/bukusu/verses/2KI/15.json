        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwiiko kukhola kamakhumi kataru na munaane kwe bubwami bwo mwami Asaria owa Yuda, Sakaria okhwa Yeroboamu owe Khabili amiisibwa aba omwami owa Isiraeli. Amiia ne ali mu Samaria khulwe kimieesi sita. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.8",
            "verseOrgIds": [
              "2KI.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akholela Wele Omunyali Owa Bioosi bumayaanu nga bakuuka bewe ne bakhola. Se alekha bumayaanu bwa Yeroboamu nibwo arangirira Isiraeli khukhola tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.9",
            "verseOrgIds": [
              "2KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumu okhwa Yabesi akholela omwami Sakaria ekwangwaani amwirira e Ibuleamu, mala akobola mu bweyaangu bwewe nga omwami.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.10",
            "verseOrgIds": [
              "2KI.15.10"
            ]
          }
        }
      ]
    },
