      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omwami Shalumu owa Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
