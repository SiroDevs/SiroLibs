        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami Ahasia aambana no mwami Yoramu owa Isiraeli mu liie khukhupana no mwami Hasaeli owa Shamu. Banamae bakaananila Ramoti-kileati bapana, mala banamae ba Shamu baumisia Yoramu lukali mwiie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
            "verseOrgIds": [
              "2KI.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Yoramu akobola mu lukoba lwa Yesireeli aone kamakoonjo niko anyoola nga ne apana ne Hasaeli e Rama. Ne Ahasia acha khubona Yoramu nga aaba ne alwala.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
        }
      ]
    }
