          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloonda chingila che babaami ba Isiraeli bulayi bwene nga enju eya Ahabu ne yakhola sikila akhwa omukhaana owa Ahabu. Akhola bumayaanu khu Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.18",
            "verseOrgIds": [
              "2KI.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.36"
              },
              "items": [
                {
                  "text": "1 Bab. 11.36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kakhaba kario, Wele Omunyali Owa Bioosi se onakaka Yuda tawe khulwa Daudi omukholi wewe. Wele Omunyali Owa Bioosi, aba alaka Daudi ali niye ne lisaaye liewe nibo balichiililila khukhwamiia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.19",
            "verseOrgIds": [
              "2KI.8.19"
            ]
          }
        }
