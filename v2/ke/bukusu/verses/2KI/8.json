        "style": "s1"
      },
      "items": [
        {
          "text": "Omukhasi khukhwama Shunemu akobola",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
