            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nebukadinesa abukula Yehoyakini amuyila Babiloni nga omuboe, alala ne maawe, bakhasi bewe, banamae bewe ne babemeelesi ba Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.15",
            "verseOrgIds": [
              "2KI.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi ayila Babiloni babaandu be kamaani boosi chielefu saba. Lundi abukula banabi ne baabasi e elefu ndala. Boosi baba babaandu be kamaani lundi baboolana mwiie.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.16",
            "verseOrgIds": [
              "2KI.24.16"
            ]
          }
        }
      ]
    },
