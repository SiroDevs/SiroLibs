              "type": "text"
            }
          ]
        },
        {
          "text": "Nono omwami Hasaeli owa Shamu anaania Baisiraeli mu bwami bwa Yehoahasi bwoosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.22",
