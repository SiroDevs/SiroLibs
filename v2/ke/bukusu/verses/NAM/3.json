              "NAM.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NAM 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninefe, ewe oli omulayi khukhila Tebesi, lukoba luboofu lwa Misiri ku? Nilwo lwosi lwaba ne luluuchi lulwalukhiinga nga lisiisi, luluuchi olwo lwaba Naili. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NAM 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tebesi lwaruka Sudani ne Misiri, bunyali bwalwo se bwaba ne sisiakamo tawe, ne lwaba ne busaale ne Libia. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.9",
            "verseOrgIds": [
              "NAM.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne babaandu ba Tebesi babukulwa khucha mu mbaambe. Buli khungila babaana babwe bapwangwa ne berwa. Banamae be basiku babara khu minyololo mala buli mundu acha ne babewe.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NAM 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninefe, akhaba ewe olakwa mu kimeesi eye khuloba khumanya liliekholekha. Ne lundi olakhaka khukhwefubarura khu basiku bowo. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.11",
            "verseOrgIds": [
              "NAM.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NAM 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chingoba chowo chisire choosi chilaba nga kimituli kiirobiisie chinduli chakio, sisiikha kimirongooro, ne lituunda lilakwa mukhanwa mwowo! ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.12",
            "verseOrgIds": [
              "NAM.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NAM 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banamae bowo balinga bakhasi, ne sibala siowo sili ao busa se sili ne oliinda busiku tawe. Kumulilo kulonaka kimitalaachi kikikala bilibwa biowo. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.13",
            "verseOrgIds": [
              "NAM.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NAM 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khemutae kameechi mwirekekhele liie ne khukhatatasia chingoba chenywe! Swala liloba mupe kamatifari, ne rekekha bibiipa kamatifari! ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.14",
            "verseOrgIds": [
              "NAM.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NAM 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakhakhola oriena, olosibwa namwe wirirwe mwiie. Olaba nga biakhulia biliibwa ne chisike. Mwasaalana nga buchunju.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.15",
            "verseOrgIds": [
              "NAM.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NAM 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.15",
            "verseOrgIds": [
              "NAM.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NAM 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwasaala baboofuli bakali khukhila ching'enieesi che khwikulu! Ne luno bachile, nga chisike chibambula chindaa chacho mala chipurukha. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.16",
            "verseOrgIds": [
              "NAM.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NAM 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babemeelesi benywe bali nga chisike chiili mu masiisi khu ndaalo eye kumunyiri. Ne nga kumuumu ne kwicha, chipurukha, ne se aliio omanya niio chiicha tawe!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.17",
            "verseOrgIds": [
              "NAM.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NAM 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.17",
            "verseOrgIds": [
              "NAM.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NAM 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruki owa Asiria ewe, baruki baali asi wowo bafwiile, ne babaandu bowo be lukoosi bali mwilo lia mindali! Babaandu bowo baasalaniile khu bikulu, ne se aliio onyala abakobosia engo lundi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.18",
            "verseOrgIds": [
              "NAM.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NAM 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se siliio sirusiao khuchuunwa khwenywe tawe, ne kamakoonjo kenywe se kasilikhwa kaona tawe. Abo boosi baulila kamakhuwa ke lilionakwa lienywe baapa chimbi ne khukhwekhoya. Alikhoo namulala owifubarura burafu bwowo buli bukali ku?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.19",
            "verseOrgIds": [
              "NAM.3.19"
            ]
          }
        }
      ]
    }
  ],
