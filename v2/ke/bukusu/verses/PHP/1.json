                {
                  "text": "Bikh. 16.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Khukhwama khu Paulo ne Timoteo bakholi ba Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khu baandu ba Wele boosi bali e Filipi bali mu buambaani ne Yesu Kristo, alala ne ba bishopu ne bayeeti be mu Kanisa.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lekha Paapa Wele wefwe no Mwami Yesu Kristo bamuelesie enywe kumwalaalo ne kumuleembe.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.2",
            "verseOrgIds": [
              "PHP.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo asabila basoma ebarwa yewe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.2",
            "verseOrgIds": [
              "PHP.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ese khupilanga Wele wase orio buli siise nisio mukhebulilanga enywe, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.3",
            "verseOrgIds": [
              "PHP.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne buli siise nisio musabilanga enywe mweesi sabanga ne liliekhoya ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.4",
            "verseOrgIds": [
              "PHP.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "sikila nga ne mwanjeeta mu milimo kie Elomo Endayi khukhwama khu ndaalo eye khunyoa khukhwola luno. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.5",
            "verseOrgIds": [
              "PHP.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako ndi nasuubi ndi Wele owarakikha kimilimo kimilayi kino mwinywe, alachiililila khu kikhola khukhwola nga akimala khu Ndaalo eya Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.6",
            "verseOrgIds": [
              "PHP.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli lwoosi enywe muli mu mwoyo kwase! Khwako buli bulayi ese khukhweulila ndio khwinywe. Sikila enywe mweesi mwasaanga nase mu mwalaalo nikwo Wele ambelesia ese, luno nga ne ndi mu siboe, lundi nga naba omulekhuule khu khuupanila Elomo Endayi ne khukiandalasia lukali. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.7",
            "verseOrgIds": [
              "PHP.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele ali omuloli wase ali ese ndikho ndoma bung'ali ndi busiime bwase khwinywe mweesi bwama mu mwoyo kwa Yesu Kristo omwene.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.8",
            "verseOrgIds": [
              "PHP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.8",
            "verseOrgIds": [
              "PHP.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ese saba ndi busiime bwenywe alala ne limanya lia ng'ali ne busicha bilachiililila khuba bikali mwinywe, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.9",
            "verseOrgIds": [
              "PHP.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nio munyale khurobora lili lilayi. Khwako mulaba balekhuule khukhwama khu bunyaalu bwoosi ne khubiiywa khu Ndaalo eya Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.10",
            "verseOrgIds": [
              "PHP.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Limenya lienywe lilaba ne kamatuunda ke buluungi niko Yesu Kristo yeng'ene anyala aana, khulwe luyali ne fuma eya Wele.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.11",
            "verseOrgIds": [
              "PHP.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Khumenya Kristo niye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.11",
            "verseOrgIds": [
              "PHP.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basaale, nenya enywe mumanye muli bibiindu bibianjikholeekhekho ng'ali biayeetile lichiililila lie Elomo Endayi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.12",
            "verseOrgIds": [
              "PHP.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.28.30"
              },
              "items": [
                {
                  "text": "Bikh. 28.30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Khwako, banamae be lichipi ne babaandi boosi ano, bamanyile bali ese ndi mu siboe sikila ndi omukholi owa Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.13",
            "verseOrgIds": [
              "PHP.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khuba khwase mu siboe khwakholile bawandaayefwe bakali khuba ne lilieyikina likali mu Mwami, khwako bachiililile khuba banyindaafu lukali, khukhwilwacha Elomo Endayi.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
              "PHP.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
              "PHP.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ali balala khu nibo belwacha Kristo sikila bali ne sikhalikhali lundi bali ne bulomani, ne kakhali babaandi belwacha khulwe lilienya lilayi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.15",
            "verseOrgIds": [
              "PHP.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babelwacha khulwe lilienya lilayi bakhola bario khukhwama mu busiime, sikila bamanyile bali Wele ambelesia ese kimilimo kie khu khupanila Elomo Endayi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.16",
            "verseOrgIds": [
              "PHP.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandi se bafumianga Kristo mu bung'ali tawe, ne kakhali bakholanga bario mu mwoyo kwe khukhwiyenyela babeene, bebaasianga bali banyala bakila ese napisibwa siibi lukali nga ne ndi mu siboe. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.17",
            "verseOrgIds": [
              "PHP.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se sili siindu khwise tawe, sikila akhaba ne khuli mu khwiyenyela namwe mu lienya lilayi, Kristo alikho elwachibwa. Khwako ese ndachiililila khuba omusangaafu, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.18",
            "verseOrgIds": [
              "PHP.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "sikila manyile ndi khubirira mu masaba kenywe ne buyeeti bubwamanga khu Roho owa Yesu Kristo ese khalekhuulwe. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.19",
            "verseOrgIds": [
              "PHP.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilienya liase liboofu ne lilieyikina lili mbo khakhilwa mu milimo kiase tawe, ne kakhali mu biise bioosi, ne lukali luno luri, mbe ne bunyindaafu bukali, nio ne kumwoyo kwase kwoosi ndeere efuma khu Kristo, nakhaba ne menya namwe nefwa. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.20",
            "verseOrgIds": [
              "PHP.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila khuloondekhana nase, khumenya ali Kristo ne khufwa buli bukhala. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.21",
            "verseOrgIds": [
              "PHP.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHP 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali kaaba bali ne njiililila khumenya nyala natasa khukhola kimilimo kie bukhala, aba nono se ndi nasuubi siina nisio nenyekha ndobore tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.22",
            "verseOrgIds": [
              "PHP.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHP 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chingila chibili changalikaanie. Nenya lukali ndure mu bulamu buno mala mbe ne Kristo, sikila liliene elio lili lilayi lukali, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.23",
            "verseOrgIds": [
              "PHP.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHP 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne kakhali sikila enywe, lili lie bukhala bukali ese khuba omulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.24",
            "verseOrgIds": [
              "PHP.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHP 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ese ndi nasuubi khu kano, khwako namanyile ndi ndamenya. Ndachiililila khumenya ne nanywe mweesi, khutasa khu lichiililila lienywe lilayi ne liliekhoya mwisuubila, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.25",
            "verseOrgIds": [
              "PHP.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PHP 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nio mbo ne ndi nanywe lundi mulaba ne sifuno siboofu sie khu khunjeboneseliakho mu limenya mu buambaani ne Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.26",
            "verseOrgIds": [
              "PHP.1.26"
            ]
          }
        }
