              "items": [
                {
                  "text": "17.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.11"
              },
              "items": [
                {
                  "text": "Mk. 1.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.35"
              },
              "items": [
                {
                  "text": "Lk. 9.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kumumilo kwama mwikulu ne kuloma kuli, “Yuno ali Omwana wase omusiime, ousiimisia lukali.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
            "verseOrgIds": [
              "MAT.3.17"
            ]
          }
        }
      ]
