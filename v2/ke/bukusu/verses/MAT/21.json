              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Khwako ese muboolela enywe ndi, mulinuulwa bubwami bwa Wele buebwe khu kholo ekhola bikholwa bibiolaana nabwo.” [ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.43",
            "verseOrgIds": [
              "MAT.21.43"
            ]
          }
        },
        {
