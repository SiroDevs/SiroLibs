          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako efuma yewe yoola mu sibala sia Siria sioosi, lundi bamureerera balwaale boosi, lufu lwa buli lukano ne buchuuni chingano choosi, be bisieeno, be chiteleng'i nende babafwokoya, mala Yesu abaonia boosi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.24",
            "verseOrgIds": [
              "MAT.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
