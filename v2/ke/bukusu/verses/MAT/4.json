          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu bakali bama Kalilaya ne Tekapoli ne Yerusalemu ne mu Buyuda, nende engelekha wa Yoritani, baloonda khu Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.25",
