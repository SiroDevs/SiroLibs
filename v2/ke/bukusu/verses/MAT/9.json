                  "text": "Mk. 6.34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nga abona babaandu bakali, abakholela siisa, sikila baba beendekheleele ne lundi buyeeti mbao, bali busa nga kamakheese kakhali no mwaayi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.36",
            "verseOrgIds": [
              "MAT.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 9:37"
          },
