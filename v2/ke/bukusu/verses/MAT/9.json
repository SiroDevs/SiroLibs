              "items": [
                {
                  "text": "Lk. 10.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio aboolela babeeka bewe ali, “Likesa lili likali, ne kakhali bakholi bali bakeekhe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
            "verseOrgIds": [
              "MAT.9.37"
            ]
