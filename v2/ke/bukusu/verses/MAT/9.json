          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga babaandu abo baba ne bali khabeecha, babaandu babaandi bamureerera omundu owaanda lulimi sikila aba ne sisieeno. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.32",
            "verseOrgIds": [
              "MAT.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne enyuma we khurusibwamo sisieeno omundu owaanda lulimi oyo aarakikha khulomaloma, mala babaandu bauka, ne baloma bali, “Sisiindu siosi siosi nga sino siri sikhabonekhakho mu Isiraeli tawe!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.33",
            "verseOrgIds": [
              "MAT.9.33"
            ]
          }
        }
      ]
    },
