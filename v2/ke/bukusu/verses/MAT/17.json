              "type": "text"
            }
          ]
        },
        {
          "text": "Sisieeno lukano luno se sinyala siarura ne mukhasabile ne khukhweyimana khulia tawe.]” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.21",
            "verseOrgIds": [
              "MAT.17.21"
            ]
          }
        },
        {
