              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga baba ne bebuusiisie mu Kalilaya, Yesu ababoolela ali, “Omwana wo Mundu ali siimbi khurebwa mu makhono ke babaandu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.22",
            "verseOrgIds": [
              "MAT.17.22"
            ]
          }
        },
        {
