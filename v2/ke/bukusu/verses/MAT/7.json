        },
        {
          "text": "“Nono buli mundu oulila kamakhuwa kase kano ne khukakhola alaba nga omukesi owombakha enju khu lwanda; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.24",
            "verseOrgIds": [
