              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siise siene esio basaangi be chikanisa mu Buyuda baba bakhamanya ese bulayi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.22",
            "verseOrgIds": [
              "GAL.1.22"
            ]
