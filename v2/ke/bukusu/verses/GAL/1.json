              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baulilanga busa niko babaandi balomanga bali, “Omundu owakhupianga efwe siibi luno alikho elwacha lisuubila nilio akhakanga khukhwonaka!” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.23",
