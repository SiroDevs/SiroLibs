              "type": "text"
            }
          ]
        },
        {
          "text": "Ekhumaliilikha namulekhwa omutaambi echa araamo bisimiri bia koopa bibili bitiiti, bibioola erupia ndala. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.42",
            "verseOrgIds": [
