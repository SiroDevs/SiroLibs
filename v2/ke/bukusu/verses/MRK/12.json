          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Yesi alaanga babeeka bewe alala mala aloma ali, “Ng'ali muboolela enywe ndi, namulekhwa yuno areere mwisanduku lie siianwa lino sikali khukhila omundu okundi yesi yesi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.43",
            "verseOrgIds": [
              "MRK.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila babaandi bareeremo nisio abeele babikhile khu buiinda bwabwe, ne kakhali namulekhwa yuno, mu mutaambo kwewe areeremo bioosi nibio abeele nabio, arusiisie sioosi nisio abeele nasio khulwe khumenya.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.44",
            "verseOrgIds": [
