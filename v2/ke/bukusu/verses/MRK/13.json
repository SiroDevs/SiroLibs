        "style": "s1"
      },
      "items": [
        {
          "text": "Sibiilisio sie Lilionaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
