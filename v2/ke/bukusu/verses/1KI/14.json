              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono buli sisiindu sisiindi siosi siosi nisio omwami Rehoboamu akhola siaandikwa mu sitabu sie chingano che Babaami ba Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne liabao liie akari wa Rehoboamu ne Yeroboamu mu biise bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
            "verseOrgIds": [
              "1KI.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamu afwa mala asiikhwa mu biliindwa bie babaami mu Lukoba lwa Daudi. (Lisina lia maawe liaba Nahama, Omuamoni). Omwana wewe Abichamu amiia mu bweyaangu bwewe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.31",
