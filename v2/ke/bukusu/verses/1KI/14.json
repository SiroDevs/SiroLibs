                "loc": "2CH.9.15+2CH.9.16"
              },
              "items": [
                {
                  "text": "2 Ke Ch. 9.15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ayaaya bibiindu bie libiikhilo lie mu Lukaangu lwa Wele Omunyali Owa Bioosi ne bibiindu bie mu libiikhilo lie lichipi lio mwami. Abukula buli siindu. Abukula lundi chingabo che esahabu nicho Solomoni akhola. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
              "1KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omwami Rehoboamu akhola chingabo chichiindi che kumukasa mu bweyaangu bwacho aelesia bakhulu be babemeelesi be bilibwa bie lichipi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buli siise omwami ne achichaanga mu Lukaangu, baliindi basutanga chingabo, mala bachikobosia mu lusiro lwe khuliinda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        }
      ]
