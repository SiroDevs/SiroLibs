        },
        {
          "text": " Mu mwiiko kwa kharaano kwe mu bwami bwa Rehoboamu, omwami Shishaki owa Misiri ebwaakala Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.25",
