          ]
        },
        {
          "text": "Kumwiiko kuloondakho Beni-hadadi alaanga banamae bewe mala acha mu lukoba lwa Afeki khukhupana ne Baisiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.26",
            "verseOrgIds": [
              "1KI.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baisiraeli balaangwa alala mala baeebwa bulwaani bacha khukhupana. Baisiraeli becha alala mala baba busa nga bipupu bibili bitiiti bie chimbusi. Ne Bashamu bachila buli abuundu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.27",
            "verseOrgIds": [
              "1KI.20.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.27",
            "verseOrgIds": [
              "1KI.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu owa Wele Omunyali Owa Bioosi acha khu mwami Ahabu mala amuboolela ali, “Kano niko Wele Omunyali Owa Bioosi aloma ali, ‘Sikila Bashamu balomile bali ese Wele Omunyali Owa Bioosi ndi wele owe mu bikulu ne sendi owe mu mweyeeywe tawe, nono ndara lituuli lino mu bunyali bwowo mala ewe olamanya oli ese ndi Wele Omunyali Owa Bioosi.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.28",
            "verseOrgIds": [
              "1KI.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.28",
            "verseOrgIds": [
              "1KI.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashamu ne Baisiraeli baba mu kambi sikelekha khu ndaalo saba. Khu ndaalo ekhola saba barakikha khukhupana. Baisiraeli beera banamae Bashamu chielefu emia ndala be khukeendela khu bikele. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.29",
            "verseOrgIds": [
              "1KI.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaoona belukhila mu lukoba lwa Afeki. Nio lisiisi lie lukoba nalio liakwiila babaandu chielefu kamakhumi kabili ne saba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.30",
            "verseOrgIds": [
              "1KI.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beni-hadadi yesi elukhila mu lukoba mala amulila mu lusiro lwe mukari mwe nju. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.30",
            "verseOrgIds": [
              "1KI.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakholi bamuboolela bali, “Khwaulila bali babaami ba Isiraeli bali be siisa. Lekha khufware kamakunia ne kimikoye khu mirwe kiefwe mala khuche khu mwami owa Isiraeli. Wakana akhola ario alekha khukhwira.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.31",
            "verseOrgIds": [
              "1KI.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio beboela kamakunia mu bibuno biabwe ne kimikoye mu mirwe mala bacha khu Ahabu baloma bali, “Omukholi wowo Beni-hadadi alikho akhwikoonjelela ali okhamwiira tawe.” Ahabu abakobosia ali, “Asilio omulamu? Ali wandaayase.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.32",
            "verseOrgIds": [
              "1KI.20.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.32",
            "verseOrgIds": [
              "1KI.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono babaandu abo baba baloleelela babone simanyisio. Ne nga Ahabu ne aloma ali, “Ali wandaayase” balibukula khangu mala baloma bali, “Ee, wandaayo Beni-hadadi.” Ahabu aloma ali, “Cha mumureere.” Beni-hadadi nga ne oola, Ahabu amwakaanila amwingisia mu likaari lie liie. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.33",
            "verseOrgIds": [
              "1KI.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beni-hadadi amuboolela ali, “Ndakhukobosiela chingoba nicho paapa wase anuula paapa wowo mala onyala warakikha abuundu e bubwofuli mu Damasika, bulayi bwene nga paapa wase ne akhola mu Samaria.” Ahabu amukobosia ali, “Khu bireng'amo bino ndakhulekha obe omulekhuule.” Ahabu akhola endakaano ne naye mala amulekha acha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.34",
            "verseOrgIds": [
              "1KI.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omung'oosi akhalakila Ahabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.34",
            "verseOrgIds": [
              "1KI.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omung'oosi mulala khukhwama mu sipupu sie bang'oosi aboolela omung'oosi owasie amupe. Ne omung'oosi oyo aloba khumupa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.35",
            "verseOrgIds": [
              "1KI.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.24"
              },
              "items": [
                {
                  "text": "1 Bab. 13.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio amuboolela ali, “Sikila ewe se wariire lilaka lia Wele Omunyali Owa Bioosi tawe nga ne olarekukha busa ori, etalang'i elakhwiira.” Ne khangu busa nga ne arekukha, etalang'i yecha mala yamwiira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.36",
            "verseOrgIds": [
              "1KI.20.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.36",
            "verseOrgIds": [
              "1KI.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omung'oosi oyo anyoola omundu okundi mala amuboolela ali, “Khupe” Omundu yuno amuupa burafu mala amuumisia. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.37",
            "verseOrgIds": [
              "1KI.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omung'oosi eboa chingubo mumoni khukhwekosaasia akhamanyikha tawe. Acha eema amuyila, aliinda omwami owa Isiraeli abire. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.38",
            "verseOrgIds": [
              "1KI.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga omwami ne aba ne alikho abira, omung'oosi amulaanga mala amuboolela ali, “Nabeele ndikho khupana mwiie mala omunamae mulala andeerera omunamae omusiku mala aloma ali, ‘Liinda omundu yuno. Kaaba bali elukha okherwe nga kumuruungo, namwe okharuunge kumuruungo kwe chikiilo kamakhumi kataru na chine bie efwesa.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.39",
            "verseOrgIds": [
              "1KI.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nga omukholi wowo ne abeele ne kimilimo kikiindi, omundu oyo elukha.” Omwami owa Isiraeli akobosia ali, “Wamwene wekhalakiile. Nono bukhalaki bulaba burio.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.40",
            "verseOrgIds": [
              "1KI.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omung'oosi atabula engubo niyo aba ne eboyile mu moni khangu, mala omwami amumanya ali ali mulala khu bang'oosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.41",
            "verseOrgIds": [
              "1KI.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omung'oosi oyo aboolela omwami ali, “Eyino eli elomo eya Wele Omunyali Owa Bioosi: ‘Sikila ewe walekhile omundu niye ese ndakile ndi erwe elukha, ewe olaliruunga ne bulamu bwowo ne ndiira babaandu bowo mu bweyaangu bwe babaandu banamae bewe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.42",
            "verseOrgIds": [
              "1KI.20.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.42",
            "verseOrgIds": [
              "1KI.20.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami owa Isiraeli akobola mu lichipi liewe e Samaria, ne asinyiikhe ne khukhalala.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.43",
            "verseOrgIds": [
              "1KI.20.43"
            ]
          }
        }
      ]
    }
