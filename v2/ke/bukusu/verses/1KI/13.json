  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "1KI 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu owa Wele echa e Beteli khukhwama Yuda ne arumiirwe ne elomo eya Wele Omunyali Owa Bioosi. Yeroboamu aaba amile a alutare khukhwosia bibiindu biiunya bulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.1",
            "verseOrgIds": [
              "1KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.15+2KI.23.16"
              },
              "items": [
                {
                  "text": "2 Bab. 23.15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omundu owa Wele Omunyali Owa Bioosi khulwe elomo eya Wele Omunyali Owa Bioosi, alilila a alutare ali, “Ee alutare, alutare, kano niko Wele Omunyali Owa Bioosi aloma: ‘Omwana alisaalwa munju eya Daudi. Lisina liewe liliba Yosia. Alikhwirirakho basaayi be abuundu aesuta, baana bibiindu biiunya bulayi khwiwe. Kamakuumba ke babaandu kaliosibwa khwiwe.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.2",
            "verseOrgIds": [
              "1KI.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu owa Wele Omunyali Owa Bioosi chana aana simanyisio endaalo eyo eng'ene ne aloma ali, “Esino nisio simanyisio nisio Wele Omunyali Owa Bioosi alomile, ‘Alutare yino echa khwatikhamo bitonyi. Likokhe likilikho likhachukhwe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.3",
            "verseOrgIds": [
              "1KI.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.3",
            "verseOrgIds": [
              "1KI.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga omwami Yeroboamu ne aulila ko omundu owa Wele Omunyali Owa Bioosi niko aalila sikila alutare eyaba e Beteli, amwekeselela kumukhono aloma ali, “Tiila omundu oyo!” Abwene ne abwene kumukhono nikwo okeselela kwooma mala akhilwa khukukobosiayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.4",
            "verseOrgIds": [
              "1KI.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alutare yatikhamo mala likokhe liachichukha asi nga omundu owa Wele Omunyali Owa Bioosi oyo ne aarusia simanyisio mu lisina lia Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.5",
            "verseOrgIds": [
              "1KI.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami aboolela omundu owa Wele ali, “Nosiima sabile kumwalaalo kwa Wele Omunyali Owa Bioosi, Wele wowo mala omusabe ambonie kumukhono kwase!” Nio omundu owa Wele asaba Wele Omunyali Owa Bioosi mala kumukhono kwo omwami kwaona. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.6",
            "verseOrgIds": [
              "1KI.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami aboolela omundu owa Wele ali, “yiicha khuche engo mala oliekho sisiindu ne endakhuelesia kumuruuru.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.7",
            "verseOrgIds": [
              "1KI.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.7",
            "verseOrgIds": [
              "1KI.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu owa Wele oyo amukobosia ali, “Wakhamba sitonyi sie enju yowo se ndacha nawe tawe. Se ndalia namwe nywe kameechi abuundu ano tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.8",
            "verseOrgIds": [
              "1KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila nalakwa ne elomo eya Wele Omunyali Owa Bioosi eyaloma eli, ‘Se olalia kumukaati namwe onywe kameechi namwe wileyo khu ngila niyo wichiilekho tawe.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.9",
            "verseOrgIds": [
              "1KI.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio achiila khu ngila ekiindi ne se achiila khu ngila niyo echelakho e Beteli tawe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.10",
            "verseOrgIds": [
              "1KI.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omung'oosi omusaakhulu owe e Beteli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.10",
            "verseOrgIds": [
              "1KI.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono abao omung'oosi omusaakhulu owamenyanga mu Beteli. Basoleeli bewe becha mala bamuboolela koosi niko omundu owa Wele Omunyali Owa Bioosi aaba ne akholile mu Beteli endaalo eyo. Ne lundi bamuboolela kamakhuwa niko aaba ne abooleele omwami Yeroboamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.11",
            "verseOrgIds": [
              "1KI.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paapa wabwe abareeba ali, “Achiliile khu ngila siina?” Babaana bewe bamwekesia engila niyo omundu owa Wele khukhwama Yuda aachilakho. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.12",
            "verseOrgIds": [
              "1KI.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala ababoolela ali, “Ndekekhere epunda.” Nio bamurekekhera epunda mala akiikhalakho. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.13",
            "verseOrgIds": [
              "1KI.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloonda khu mundu owa Wele amunyoola ekhaale asi we kumukhoonge. Amureeba ali, “Ewe niwe omundu owa Wele owamile e Yuda?”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.14",
            "verseOrgIds": [
              "1KI.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu oyo amukobosia ali, “Yee, niise.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.14",
            "verseOrgIds": [
              "1KI.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio amuboolela ali, “yiicha khuche engo khulie siakhulia fwembi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.15",
            "verseOrgIds": [
              "1KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali omundu owa Wele amukobosia ali, “Se enyala nakobola engo ne nawe namwe niche munju mwowo tawe. Lundi se nyala nalia namwe nanywa sisiindu siosi siosi abuundu ano ne nawe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.16",
            "verseOrgIds": [
              "1KI.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila Wele Omunyali Owa Bioosi andaka ali, ‘Okhalia namwe onywe sisiindu, namwe okhakobolela khu ngila nikhwo ochiliilekho tawe.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.17",
            "verseOrgIds": [
              "1KI.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omung'oosi omusaakhulu oyo amuboolela ali, “Ese, sesi ndi omung'oosi nga ewe, ne malaika amboleele elomo eya Wele Omunyali Owa Bioosi, ese khuyile munju mwase mala olie siakhulia ne khunywa kameechi.” Ne kakhali omung'oosi omusaakhulu oyo amubea. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.18",
            "verseOrgIds": [
              "1KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omung'oosi khukhwama Yuda akobola acha no mung'oosi omusaakhulu oyo mala alia siakhulia ne naye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.19",
            "verseOrgIds": [
              "1KI.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.19",
            "verseOrgIds": [
              "1KI.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga baba ne bekhaale a siaalwa, elomo eya Wele Omunyali Owa Bioosi yecha khu mung'oosi omusaakhulu ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.20",
            "verseOrgIds": [
              "1KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mala alilila omundu owa Wele khukhwama Yuda ali, “Wele Omunyali Owa Bioosi aloma ali se wariire likhuwa liewe tawe. Se waliindile lilaka nilio Wele Omunyali Owa Bioosi aakhulaka tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.21",
            "verseOrgIds": [
              "1KI.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali, okoboole mala waliila siakhulia abuundu niio akhulaka ali okhaliilao tawe. Sikila kano, kumubili kwowo se kulasiikhwa mu siliindwa sie enju yenywe tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.22",
            "verseOrgIds": [
              "1KI.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.22",
            "verseOrgIds": [
              "1KI.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyuma we khumala khulia ne khunywa, omung'oosi omusaakhulu oyo arekekhera omundu owa Wele khukhwama Yuda epunda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.23",
            "verseOrgIds": [
              "1KI.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga omundu oyo ne aaba ne alikho acha, etalang'i yamwakaanana khungila mala yamwiira. Afwa mala alambaala khu ngila. Epunda eyo ne etalang'i biamwimao. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.24",
            "verseOrgIds": [
              "1KI.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu babirao mala babona omufu khu ngila ne etalang'i yamwimileo. Bacha baboola niko babona mu lukoba nimwo omung'oosi omusaakhulu oyo amenya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.25",
            "verseOrgIds": [
              "1KI.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.25",
            "verseOrgIds": [
              "1KI.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga omung'oosi omusaakhulu oyo ne aaulila kano, aloma ali, “Oyo ali omundu owa Wele owaloba khuria lilaka lia Wele Omunyali Owa Bioosi. Khwako Wele Omunyali Owa Bioosi arumire etalang'i yamutabulamo mala yamwiira, khuloondekhana nga Wele Omunyali Owa Bioosi ne aamuboolela.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.26",
            "verseOrgIds": [
              "1KI.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Omung'oosi omusaakhulu aboolela babaana bewe be sisoleeli ali, “Ndekekhere epunda.” Bamurekekhera. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.27",
            "verseOrgIds": [
              "1KI.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala omusaakhulu acha anyoola omufu alambaalile khu ngila, mala epunda ne etalang'i biamwimileo. Etalang'i se yaba yaliile omufu namwe yatabulaake epunda tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.28",
            "verseOrgIds": [
              "1KI.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omung'oosi omusaakhulu oyo abukula omufu amura khu punda yewe mala amukobosia mu lukoba lwa Beteli, khumulila ne khumusiikha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.29",
            "verseOrgIds": [
              "1KI.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amusiikha mu ng'ani yewe eng'ene, mala niye ne babaana bewe bamulila ne baloma bali, “Ee, wandaayase!” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.30",
            "verseOrgIds": [
              "1KI.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyuma we khumusiikha, omung'oosi aboolela babaana bewe ali, “Ne efwa, mulisiikha mu ng'ani niio omundu owa Wele asiikhiilwemo. Ra kamakuumba kase embi ne kamakuumba kewe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.31",
            "verseOrgIds": [
              "1KI.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila kamakhuwa niko aloma khulwe lilaka lia Wele Omunyali Owa Bioosi khu alutare mu Beteli ne abuundu aesuta e khusaayilao mu ngoba cha Samaria, ng'ali kaliba kario.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.32",
            "verseOrgIds": [
              "1KI.13.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bumayaanu bwa Yeroboamu buboofu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.32",
            "verseOrgIds": [
              "1KI.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyuma we likhuwa lino Yeroboamu se alekha chingila chewe chimayaanu tawe. Ne kakhali achiililila khurobora basaayi khukhwama mu chinju chosi chosi chikhali che busaayi tawe, khukhola khu alutare nicho ombaakhe. Arobora omundu yesi yesi owenya khuba nga omusaayi owe abuundu aesuta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.33",
            "verseOrgIds": [
              "1KI.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa lino liaba bumayaanu khunju eya Yeroboamu. Areera libunia ne lilionaka likali khunju yewe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.34",
            "verseOrgIds": [
              "1KI.13.34"
            ]
          }
        }
      ]
    }
