            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.33+LEV.23.34"
              },
              "items": [
                {
                  "text": "Bal. 23.33-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yeroboamu arakikha naikara khu ndaalo eye ekhumi ne chiraano eye kumwesi kwa munane, nga naikara eye mu Yuda. Aana chimbosio khu alutare. Lundi aana chimbosio mu Beteli khu moosi che esahabu nicho akhola. Mala ara basaayi mu Beteli abuundu aesuta niio akhola. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acha khu alutare niyo akhola e Beteli khu ndaalo eye ekhumi ne chiraano eye kumwesi kwa munane, endaalo niyo niye omwene aba ne ereereo. Arao naikara khu baandu ba Isiraeli, mala acha khu alutare osia bibiindu biiunya bulayi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.33",
            "verseOrgIds": [
              "1KI.12.33"
            ]
          }
        }
