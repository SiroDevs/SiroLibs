        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natabu okhwa Yeroboamu arakikha khukhwamiia Isiraeli, mu mwiiko kwe khabili kwe khukhwamiia khwa Asa omwami owa Yuda. Amiia Isiraeli khu miiko kibili. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akhola kaali kamamayaanu ebweeni wa Wele Omunyali Owa Bioosi nga raraawe owakila Baisiraeli bakhola bumayaanu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        }
      ]
    },
    {
