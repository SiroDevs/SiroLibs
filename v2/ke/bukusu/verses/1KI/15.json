        "style": "s1"
      },
      "items": [
        {
          "text": "Omwami Natabu owa Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
