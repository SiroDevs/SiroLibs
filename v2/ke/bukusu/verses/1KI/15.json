          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono buli bikholwa bibiindi bioosi nibio Natabu akhola biaandikwa mu sitabu sie chingano che babaami ba Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne liie liabao akari wa Yuda ne omwami Baasha owa Isiraeli mu bulamu bwabwe bwosi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
