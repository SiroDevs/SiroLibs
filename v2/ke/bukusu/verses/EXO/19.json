            "number": "22",
            "style": "v",
            "sid": "EXO 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lundi lekha basaayi babeecha niio ese Wele Omunyali Owa Bioosi ndi betakaase ne busa nja khubaelesia kumunaanio.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
              "EXO.19.22"
            ]
          }
        }
