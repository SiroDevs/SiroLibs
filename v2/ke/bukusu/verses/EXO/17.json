                "loc": "DEU.25.17+DEU.25.18+DEU.25.19"
              },
              "items": [
                {
                  "text": "Likh. 25.17-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.2+1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1 Sam. 15.2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio Wele Omunyali Owa Bioosi aaboolela Musa ali, “Andika kano mu sitabu nga likhebulila. Ne boolela Yoshua kamakhuwa kano oli, ndabunisilia elala Baamaleki khukhwama khu sibala.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.14",
            "verseOrgIds": [
              "EXO.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Musa ombakha alutare mala akilaanga ali, “Wele Omunyali Owa Bioosi ali ependera yase.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaloma ali, “Suta angaaki ependera eya Wele Omunyali Owa Bioosi! Wele Omunyali Owa Bioosi acha khuchiililila khu khupana ne Baamaleki mindali na mindali.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        }
      ]
    }
