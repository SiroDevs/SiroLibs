            "sid": "EXO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali Wele Omunyali Owa Bioosi aboolela Musa ali, “Luno olabona niko ndakhola khu Farao. Enja khurumikhira kamaani kaase kamakali khu niye. Lino lilakila atimanie babaandu bano barure mu sibala siewe khangu.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wele alaanga Musa",
          "type": "text"
        }
      ]
    },
