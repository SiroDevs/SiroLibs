              "EXO.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali Musa amukobosia ali, “Okhoya okhulekhele bibiaayo nibio khunyala khwaanila Wele Omunyali Owa Bioosi, Wele wefwe chimbosio ne biianwa bie khukhwosia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.25",
            "verseOrgIds": [
              "EXO.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhoya khwacha ne chikhaafu chefwe. Se khulalekhakho akhaba ndala enyuma tawe. Khukharumikhire bilala khu biaayo bino khusaaya Wele Omunyali Owa Bioosi, Wele wefwe. Ne ne khusiili khwolayo, se khumanya biaayo siina nibio khumurusilia nga embosio tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.26",
            "verseOrgIds": [
              "EXO.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 10:26"
          },
          "items": [
