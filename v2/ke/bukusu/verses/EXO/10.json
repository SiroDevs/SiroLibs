            "verseId": "EXO.10.23",
            "verseOrgIds": [
              "EXO.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Farao alaanga Musa mala amuboolela ali, “Khemuche musaaye Wele Omunyali Owa Bioosi. Munyala mwacha akhaba ne bakhasi ne babaana benywe. Ne kakhali mulekhe bibiaayo bibe ano.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.24",
            "verseOrgIds": [
              "EXO.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 10:24"
          },
          "items": [
