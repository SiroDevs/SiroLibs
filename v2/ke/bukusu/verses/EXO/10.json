          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali Wele Omunyali Owa Bioosi aalumia Farao kumwoyo mala khubafukiilila bache tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
              "EXO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao aaboolela Musa ali, “Ndureo! Khaka nga ne onyala khakhubonakho lundi tawe! Endaalo niyo ndikhubonelakho, olifwa!”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.28",
            "verseOrgIds": [
              "EXO.10.28"
            ]
          }
        }
