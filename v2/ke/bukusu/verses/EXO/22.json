                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Omundu aaba ne areeba omukhaana owe yabwana okhaselelwa tawe mala acha naye, akhoya amukhwe mala abe omukhasi wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne paapa wo mukhaana aaba ne alobela elala khuelesia omundu oyo omukhaana, akhoya aruunge paapa wo mukhaana chirupia chicholaana ne bukhwe bwe be eyabwaana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        }
      ]
    },
