        },
        {
          "text": " “Se mukhoyeele mwakholela omukwa kamabi namwe mwamunaania tawe sikila enywe mwesi mwaba baakwa mu sibala sia Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
            "verseOrgIds": [
              "EXO.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhapia siibi namulekhwa yesi yesi namwe omufuubi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.22",
            "verseOrgIds": [
              "EXO.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaba ne mubakholela murio mala bandilila ese, ng'ali khaulile bililo biabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.23",
            "verseOrgIds": [
              "EXO.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakhola murio lirima liase likhabe likali mala mwiire enywe. Bakhasi benywe baliba banamulekhwa ne babaana benywe baliba bafuubi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.24",
            "verseOrgIds": [
              "EXO.22.24"
            ]
          }
        }
