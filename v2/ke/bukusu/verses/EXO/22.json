          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okhaayilila khuaana biianwa khukhwama mu likesa liowo ne khukhwama mu ndali yowo ne bilabile tawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
