          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhole orio akhaba ne chikhaafu chowo chimbele ne kamakheese. Lekha esaliilwe embele ebe ne maawe khulwe chindaalo saba, mala umbelesie khu ndaalo ekhola munaane.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        }
