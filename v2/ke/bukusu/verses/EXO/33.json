          "type": "text",
          "attrs": {
            "verseId": "EXO.33.1",
            "verseOrgIds": [
              "EXO.33.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
