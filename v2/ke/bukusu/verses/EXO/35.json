            "sid": "EXO 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa abuusia libuusiana lie babaandu ba Isiraeli lioosi alala. Ne ababoolela ali, “Ebino bili bibiindu nibio Wele Omunyali Owa Bioosi amulakile enywe khukhola. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.1",
            "verseOrgIds": [
              "EXO.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.8+EXO.20.9+EXO.20.10+EXO.20.11"
              },
              "items": [
                {
                  "text": "Khur. 20.8-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
