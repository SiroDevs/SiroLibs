                "loc": "EXO.34.21"
              },
              "items": [
                {
                  "text": "34.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.3"
              },
              "items": [
                {
                  "text": "Bal. 23.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.12+DEU.15.13+DEU.15.14"
              },
              "items": [
                {
                  "text": "Likh. 15.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Muli ne chindaalo sita che khukholelamo kimilimo, ne endaalo eya saba eli endakatifu, eye sabato, eye liola lia Wele Omunyali Owa Bioosi. Omundu yesi yesi okhola kimilimo khu ndaalo ng'eneyo eerwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.2",
            "verseOrgIds": [
              "EXO.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhabwaanakho kumulilo mu chingo chenywe mu sabato tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.3",
            "verseOrgIds": [
              "EXO.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Biianwa khulwe liiema Litakatifu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.3",
            "verseOrgIds": [
              "EXO.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa aboolela libuusiana lioosi lie babaandu ba Isiraeli ali, “Elino nilio Wele Omunyali Owa Bioosi alakile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.4",
            "verseOrgIds": [
              "EXO.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli mulala mwinywe aanile Wele Omunyali Owa Bioosi siianwa. Lekha omundu yesi yesi owe kumwoyo kwe khuaana areere siianwa sia Wele Omunyali Owa Bioosi sie esahabu, efwesa ne kumukasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.5",
            "verseOrgIds": [
              "EXO.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi areere buusi bubuusi, bunapeenda, bubesemu, engubo eya katani eyanabwa bulayi ne bufuumbo bwe chimbusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.6",
            "verseOrgIds": [
              "EXO.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyekha lundi areere akhaba engubo eye bufuumbo bwe kamamiiku nibwo baakhile erangi embesemu, kamasieelo ke chimbusi, chimbao che chinyaali. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.7",
            "verseOrgIds": [
              "EXO.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi areere kamafura ke chitaa, bibiindu bing'ayilisia khulwe mumafura ke khuchukha khu barobore ne khulwe bibiindu biiunya bulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.8",
            "verseOrgIds": [
              "EXO.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi areere kamabaale ke bukusi ne kamabaale kakaandi ke khurekekha mu efodi ne khulwe engubo eye musifuba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.9",
            "verseOrgIds": [
              "EXO.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bibiindu khulwe liiema lie kumuse",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.9",
            "verseOrgIds": [
              "EXO.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lekha buli mundu mwinywe oli omusicha eeche mala akhole koosi niko Wele Omunyali Owa Bioosi alakile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.10",
            "verseOrgIds": [
              "EXO.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lekha bakhole liiema litakatifu, liiema lialio lie enje ne sifunikho sialio. Lundi bakhole chingaki ne kimitalaachi kialio kimilapa kialio, chinjeko chalio ne bibale bialwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.11",
            "verseOrgIds": [
              "EXO.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lekha bakhole akhaba lisanduku lie Ndakaano, chinguulo chalio, endebe eye siisa ne lububi lukikhiinga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.12",
            "verseOrgIds": [
              "EXO.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhole emesa, chinguulo chayo ne bibiindu biayo bioosi, ne kumukaati kwe khubao khwa Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.13",
            "verseOrgIds": [
              "EXO.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi siteetwe sie taa khulwe buwaanga ne bibiindu biasio, chitaa chasio ne kamafura khulwe buwaanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.14",
            "verseOrgIds": [
              "EXO.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhole alutare eye biiunya bulayi ne chinguulo chayo ne kamafura ke khuchukha khu barobore, biiunya bulayi ne epasia khulwe kumuliango kwe liiema litakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.15",
            "verseOrgIds": [
              "EXO.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alutare eye biianwa bie khukhwosia alala ne bitiila bie kumukasa, chinguulo chayo, bibiindu biayo bioosi, enjikha ne sibale siayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.16",
            "verseOrgIds": [
              "EXO.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipasia che luuya chinjeko chacho ne bibale, ne epasia khulwe silibwa sie luuya bioosi bikholwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.17",
            "verseOrgIds": [
              "EXO.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bitiila liiema litakatifu ne bitiila luuya ne kimikoye kiabio, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.18",
            "verseOrgIds": [
              "EXO.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne chingubo chichanabwa bulayi nicho basaayi befwara ne balikho bakhola Abuundu Atakatifu, chingubo chindakatifu khulwo Omusaayi Aruni ne khulwe babaana bewe khulwe kimilimo kiabwe nga basaayi.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.19",
            "verseOrgIds": [
              "EXO.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Babaandu bareera biianwa biabwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.19",
            "verseOrgIds": [
              "EXO.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio libuusiana lie babaandu ba Isiraeli lioosi liarekukha liarura niio Musa aba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.20",
            "verseOrgIds": [
              "EXO.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli owaba ne lilienya ne kumwoyo kwe khukhola ario areera siianwa sia Wele Omunyali Owa Bioosi khulwe liiema lie kumuse nende khulwe kimilimo kioosi ne chingubo chindakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.21",
            "verseOrgIds": [
              "EXO.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono babaandu boosi ba baaba ne kumwoyo becha, be siseecha nende be siikhasi. Bareera bipiini, chindeekwe, bipalakasa bie khu maru, chimbete, ne bibiindu bioosi bibiang'oonwa khu sahabu. Buli mundu aana siianwa sie esahabu khu Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.22",
            "verseOrgIds": [
              "EXO.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli yesi yesi owaba ne buusi bubuusi, bunapeenda, namwe bubesemu bwe engubo eya katani eyanabwa bulayi namwe bufuumbo bwe chimbusi, namwe kamasieelo ke kamamiiku namwe kamasieelo ke chimbusi abireera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.23",
            "verseOrgIds": [
              "EXO.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boosi babanyala khuaana siianwa sie efwesa namwe kumukasa basireera nga siianwa khu Wele Omunyali Owa Bioosi. Ne buli mundu owaba ne kumurongooro kumunyaali kukwanyala khukhola kumulimo kwosi kwosi akureera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.24",
            "verseOrgIds": [
              "EXO.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bakhasi boosi ba baaba ne banyala khukhwokusa ne kamakhono kabwe bareera nibio baba ne bokuuse bie buusi bubuusi, bunapeenda, bubesemu ne bwe engubo eya katani eyanabwa bulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.25",
            "verseOrgIds": [
              "EXO.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi bakhasi boosi ba baaba ne kumwoyo kwe khukhola kimilimo bakhola buusi bwe bufuumbo bwe chimbusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.26",
            "verseOrgIds": [
              "EXO.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babemeelesi bareera kamabaale kamelamela ne kamabaale kakaandi ke khurekekha khulwe efodi ne khulwe engubo eye mu sifuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.27",
            "verseOrgIds": [
              "EXO.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bareera akhaba bing'ayisia bulayi ne kamafura khulwe chitaa, khulwe khuchukha khu barobore ne khulwe bibiindu biiunya kumuuya kumulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.28",
            "verseOrgIds": [
              "EXO.35.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu boosi ba Isiraeli, be siseecha nende be siikhasi babeenya khureera sisiindu siosi siosi khulwe kimilimo nikio Wele Omunyali Owa Bioosi alaka Musa kiekholekhe, babireera nga biianwa bie khukhwerusia khu Wele Omunyali Owa Bioosi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.29",
            "verseOrgIds": [
              "EXO.35.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bakholi khulwe khukhola liiema lie khubao khwa Wele Omunyali Owa Bioosi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.29",
            "verseOrgIds": [
              "EXO.35.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa aboolela Baisiraeli ali, “Lola Wele Omunyali Owa Bioosi aroboore Besaleli, okhwa Uri lundi omwichukhulu owa Huri, khukhwama mu kholo eya Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amwichuusie ne Roho",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "35.31",
              "type": "text"
            },
            {
              "text": "Roho:",
              "type": "text"
            },
            {
              "text": "kamaani, namwe Roho.",
              "type": "text"
            }
          ]
        },
        {
          "text": " owa Wele, ne sinani, ne bukesi ne limanya khulwe bukholi bwe kimilimo chingano choosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyala akhola bibiindu mu busicha khukhwama khu sahabu, efwesa ne kumukasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.32",
            "verseOrgIds": [
              "EXO.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyala akhala kamabaale khulwe khurekekha, ne khubeecha kimirongooro, ne khulwe kimilimo chingano choosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.33",
            "verseOrgIds": [
              "EXO.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi Wele Omunyali Owa Bioosi aelesiisie Besaleli ne Oholiabu okhwa Ahisamaki, khukhwama mu kholo eya Dani, kumukabwa kwe khukhwikisia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 35:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaelesie bukesi bwe khukhola kimilimo chingano choosi nga khuchoonga, khuchoora, khunaba bie buusi bubuusi, buufwaana buseemwa, bubesemu nende bwe engubo eya katani endayi. Banyala khukhola bibiindu bie khurukwa ne kamakhono ne bibiindu bie bufundi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.35",
            "verseOrgIds": [
              "EXO.35.35"
            ]
          }
        }
      ]
    }
