                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ne kakhali ndaruma omung'oosi Elicha khwinywe endaalo ya Wele Omunyali Owa Bioosi emboofu eye khuriisia eyo ne khoola tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alireera alala babaana ne baraarawabwe lundi, busa aba ndecha nonakake sibala sienywe.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.6",
            "verseOrgIds": [
              "MAL.4.6"
            ]
