        },
        {
          "text": "Obuno buli burume nibwo Wele Omunyali Owa Bioosi aelesia Malaki aboolele babaandu ba Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.1",
            "verseOrgIds": [
