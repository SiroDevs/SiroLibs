              "type": "text"
            }
          ]
        },
        {
          "text": "Mala omwami Dario aandikila babaandu boosi, chikholo ne chinimi khu liloba ali, “Kimileembe khwinywe! ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
