          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ese khalaka ndi mu bwami bwase bwoosi, babaandu barie ne khuelesia luyali Wele owa Danieli.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.26",
