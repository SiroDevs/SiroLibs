              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.15"
              },
              "items": [
                {
                  "text": "Mat. 24.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.14"
              },
              "items": [
                {
                  "text": "Mk. 13.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Khukhwama khu siise sie khukhwakamia khuaana biianwa bie chimbosio cha buli ndaalo ne khukhwimikha Sibiilisio sie Lilionaka, chindaalo e elefu ndala ne chimia chibili ne kamakhumi tisa chikhabire. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.11",
            "verseOrgIds": [
              "DAN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali ne khabi abo baliekhaliilikha khukhwola chindaalo e elefu ndala ne chimia chitaru ne kamakhumi kataru na chiraano ne chiwa!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.12",
            "verseOrgIds": [
              "DAN.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.12",
            "verseOrgIds": [
              "DAN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ne ewe Danieli, ba omusuubilwa khukhwola khu siakamo. Mala olifwa ne olilamukha khunyoola kumuruuru kwowo mu siise simaliilisi.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.13",
            "verseOrgIds": [
              "DAN.12.13"
            ]
          }
        }
      ]
