        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.10"
              },
              "items": [
                {
                  "text": "Lif. 22.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nio malaika amboolela ali, “Ne ewe Danieli, fuunikha sitabu, mala orekho kumuuri khukhwola khumaliilikha khwe sibala. Mu siise esio babaandu bakali bakhayiiye eyi ne neyi khukhwenya khutasa bukesi.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Ese Danieli nalola mala nabona babaandu babili bemile khulukuku lwe luluuchi mulala eyi ne okundi eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.5",
            "verseOrgIds": [
              "DAN.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulala khwaabo areeba malaika owaba ne efwarire engubo eya katani ne emile a luuchi angaaki ali, “bilabukula siise siina nio bibiindu bie liukia bino bikholekhe?”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.6",
            "verseOrgIds": [
              "DAN.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
