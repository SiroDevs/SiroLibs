          "type": "text",
          "attrs": {
            "verseId": "DAN.12.6",
            "verseOrgIds": [
              "DAN.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
